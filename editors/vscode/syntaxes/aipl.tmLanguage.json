{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "comment": "Generated from crates/aipl-codegen/src/highlight_aipl.aipl, which\nderives it from the lexer's own rule table. Do not edit by hand:\nregenerate with `cargo test --test compiler -- --ignored\nhighlighting::fill_tmlanguage`.",
  "name": "AIPL",
  "scopeName": "source.aipl",
  "fileTypes": ["aipl"],
  "patterns": [
    { "include": "#section-tail" },
    { "include": "#main" }
  ],
  "repository": {
    "main": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.aipl" },
            "2": { "name": "entity.name.function.aipl" }
          }
        },
        {
          "match": "\\b(struct)\\s+([abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789]*)",
          "captures": {
            "1": { "name": "keyword.declaration.struct.aipl" },
            "2": { "name": "entity.name.type.struct.aipl" }
          }
        },
        {
          "match": "(!)(prints)\\b",
          "captures": {
            "1": { "name": "keyword.operator.effect.aipl" },
            "2": { "name": "entity.name.tag.effect.aipl" }
          }
        },
        {
          "match": "\\bi8\\b|\\bi16\\b|\\bi32\\b|\\bi64\\b|\\bu8\\b|\\bu16\\b|\\bu32\\b|\\bu64\\b|\\bbool\\b|\\bchar\\b|\\bstr\\b|\\bany\\b",
          "name": "support.type.builtin.aipl"
        },
        {
          "match": "//.*$",
          "name": "comment.line.double-slash.aipl"
        },
        { "include": "#comment-block" },
        {
          "match": "#\\[allow\\]",
          "name": "comment.line.allow.aipl"
        },
        {
          "match": "#(?:[^{\\[<>].*)?$",
          "name": "comment.line.documentation.aipl"
        },
        {
          "match": "\\bfn\\b|\\blet\\b|\\bmut\\b|\\bset\\b|\\bpub\\b",
          "name": "keyword.control.aipl"
        },
        {
          "match": "\\bimport\\b|\\bfrom\\b|\\bas\\b",
          "name": "keyword.control.import.aipl"
        },
        {
          "match": "\\bfor\\b|\\bwhile\\b|\\bmatch\\b|\\breturn\\b|\\bshim\\b|\\bstruct\\b|\\bvariant\\b|\\bif\\b|\\belse\\b|\\bbuiltins\\b",
          "name": "keyword.control.aipl"
        },
        {
          "match": "\\btrue\\b|\\bfalse\\b|\\bnone\\b",
          "name": "constant.language.aipl"
        },
        {
          "match": "[abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_][abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789]*",
          "name": "variable.other.aipl"
        },
        {
          "match": "-?[0-9]+",
          "name": "constant.numeric.integer.aipl"
        },
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.double.aipl"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.aipl",
          "patterns": [
            {
              "match": "\\\\[ntr\\\\\"]",
              "name": "constant.character.escape.aipl"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.aipl",
          "patterns": [
            {
              "match": "\\\\[ntr\\\\'\"]",
              "name": "constant.character.escape.aipl"
            }
          ]
        },
        {
          "begin": "```",
          "end": "```",
          "name": "string.quoted.double.aipl",
          "patterns": [
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#brace-group" },
                { "include": "#main" }
              ]
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.double.aipl",
          "patterns": [
            {
              "match": "\\\\[\\\\`{ntr]",
              "name": "constant.character.escape.aipl"
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#brace-group" },
                { "include": "#main" }
              ]
            }
          ]
        },
        {
          "match": "\\+\\+\\+|==|!=|->|=>|&&|\\|\\||\\.\\.|\\+\\+|--|\\+=|-=|\\*=|/=|<=|>=|=|<|>|!|\\+|-|\\*|/|%|\\|",
          "name": "keyword.operator.aipl"
        },
        {
          "match": "\\.|,|:|;|\\?|#|\\(|\\)|\\{|\\}|\\[|\\]",
          "name": "punctuation.aipl"
        }
      ]
    },
    "section-tail": {
      "patterns": [
        {
          "begin": "^[ \\t]*---[ \\t]+\\S.*?\\S[ \\t]+---[ \\t]*\\r?$",
          "end": "\\z",
          "beginCaptures": {
            "0": { "name": "comment.line.section-marker.aipl" }
          },
          "contentName": "meta.section-content.aipl",
          "patterns": [
            {
              "match": "^[ \\t]*---[ \\t]+\\S.*?\\S[ \\t]+---[ \\t]*\\r?$",
              "name": "comment.line.section-marker.aipl"
            }
          ]
        }
      ]
    },
    "brace-group": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "punctuation.aipl",
          "patterns": [
            { "include": "#brace-group" },
            { "include": "#main" }
          ]
        }
      ]
    },
    "comment-block": {
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.aipl",
          "patterns": [
            { "include": "#comment-block" }
          ]
        }
      ]
    }
  }
}
