# The items and declarations of AIPL's syntax tree — functions, structs,
# variants, imports, and the program that holds them — with the source-like
# dump the item lowering's tests assert against. One of the files the AST is
# declared across; see `ast.aipl`.

import { Span, equal as ==, is_empty, join, map, split, value_or } from builtins;
import { Bound, show_bound } from "./bound.aipl";
import { Unresolved } from "./builtin_table.aipl";
import {
    Alias,
    ArrayLit,
    Assign,
    Binding,
    Bool,
    ByCase,
    ByPattern,
    ByStruct,
    ByTuple,
    Call,
    Char,
    DictLit,
    Expr,
    ExprKind,
    Field,
    FieldInit,
    FloatLit,
    For,
    ForPattern,
    Ident,
    If,
    IfLet,
    Index,
    KwArg,
    Lambda,
    Let,
    LetMut,
    LetPattern,
    Match,
    Name,
    Neg,
    Num,
    ProviderShim,
    Read,
    Return,
    Seq,
    SetLit,
    Shim,
    Slice,
    Spread,
    Str,
    Try,
    TupleLit,
    TypeArgs,
    While,
    WrittenNames,
    expr,
    ident,
    name_at,
    reads_off,
    show_expr,
    subexprs,
} from "./expr.aipl";
import { SpanStr, span_str } from "./lexer.aipl";
import { Pat } from "./pat.aipl";
import { I64 } from "./prim.aipl";
import {
    Any,
    Array as TyArray,
    Case,
    Dict,
    Fn as TyFn,
    Generic,
    Named,
    NamedCase,
    Optional,
    Primitive,
    Result,
    Set as TySet,
    Tuple as TyTuple,
    Ty,
    TypeVar,
    Unit as TyUnit,
    Without,
    show_ty,
} from "./ty.aipl";
import { to_set, union_all } from sets;

# `name_span` is where the parameter's name is written in the `<..>` list.
struct TypeParam { name: str, bound: Bound, default: Ty?, name_span: Span = 0..0 }

# Where an import takes its names from: another file, the main builtin library (`from
# builtins`), or one of the other builtin libraries (`from json`).
variant ImportSource = Path(path: str) | Builtins | Library(name: str)

struct ImportName { name: str, alias: str?, span: Span }

# The name an import binds in the importing file: the alias if given, else the
# exported name.
pub fn local(self: ImportName) -> str { self.alias.value_or(self.name) }.test({
    let plain = ImportName { name: "map", alias: none, span: 0..3 };
    assert(plain.local() == "map");
    assert(ImportName { ..plain, alias: some("each") }.local() == "each");
})

struct ImportDecl { names: ImportName[], source: ImportSource, source_span: Span }

# One declared parameter. `ty` is the type the *body* sees, which is not always
# the one written: a variadic `x: T*` / `x: T+` stores the sequence type, and a
# `k?: T` stores `T?` with `implicit_some` recording that the call site passes
# a bare `T`.
struct Param {
    // What the parameter binds: a name, or a destructuring (`fn f(Point { x, y })`),
    // which is a parameter of the pattern's type with no name of its own. The names
    // are bound off it at the top of the body when `desugar.aipl` lowers it, after
    // which the binding is always a `Name`.
    binding: Binding,
    ty: Ty,
    mutable: bool,
    arity: Arity,
    default: Expr?,
    implicit_some: bool,
    // The names a destructuring spells and where, for the language server.
    written: WrittenNames? = none,
    // Where the binding is written; empty for one a pass made up.
    name_span: Span = 0..0,
}

# The name of the variable the parameter is, see `name_at`.
pub fn synthesized_name(self: Param) -> str { self.binding.name_at(self.name_span) }

# The fields a destructured parameter reads off itself, none for an ordinary one.
pub fn pattern_reads(self: Param) -> Read[] {
    self.binding.reads_off(self.synthesized_name())
}.test({
    let plain = Param {
        binding: Name("p"),
        ty: Named("P"),
        mutable: false,
        arity: One,
        default: none,
        implicit_some: false,
    };
    assert(plain.pattern_reads() == []);
    assert(Param { ..plain, binding: ByStruct("P", ["x"], ["x"], false) }.pattern_reads() == [
        Read { field: "x", base: "__spat$0" },
    ]);
    assert(Param {
        ..plain,
        binding: Alias("p", ByStruct("P", ["x"], ["x"], false)),
    }.pattern_reads() == [Read { field: "x", base: "p" }]);
})

# How many arguments a parameter takes at a call site: one, or — for a
# variadic — zero or more (`T*`) or one or more (`T+`). Mirrors
# `aipl_syntax::ast::Arity`.
variant Arity = One | ZeroOrMore | OneOrMore

# The marker written after a parameter's type: nothing, `*` or `+`.
pub fn arity_marker(self: Arity) -> str {
    match (self) {
        One => "",
        ZeroOrMore => "*",
        OneOrMore => "+",
    }
}.test({
    assert(One.arity_marker() == "");
    assert(ZeroOrMore.arity_marker() == "*");
    assert(OneOrMore.arity_marker() == "+");
})

struct Signature {
    type_vars: TypeParam[],
    params: Param[],
    effects: str[],
    return_ty: Ty?,
    // Whether the first parameter is named `self`, which is what makes `recv.f(..)` a call of it.
    is_method: bool,
}

# How a function is reached. `Public` is written `pub` and may be imported; `EntryPoint` is
# reached by whatever runs the file, as `main` is, without being importable; `Test` and
# `Benchmark` are the functions a `.test` and a `.benchmark` block become, run by `check`;
# `Private` is reached only by a call from inside the file.
variant Visibility = Public | Private | EntryPoint | Test | Benchmark

# A function with nothing attached: what hoisting leaves, and every helper declared inside
# a block. Its `.test` and `.benchmark` attributes, as written, are an [`Attributes`].
#
# `shorthand_body` records that `body` was written as the `{ field: value }`
# shorthand rather than a literal naming its type; the two parse to the same
# `Construct`.
struct Function {
    name: SpanStr,
    visibility: Visibility,
    sig: Signature,
    body: Expr,
    shorthand_body: bool = false,
    doc: str?,
}

# What a function carries as written: its `.test({ .. })` block, the functions declared
# inside it — helpers private to the test, never `pub` — and its `.benchmark({ .. })`
# attribute. The helpers are plain `Function`s, so a block cannot hold another. The
# parser hands them over here and `hoist_test_fns` moves each to a top-level function
# under a name only the test can reach.
struct Attributes { test_body: Expr?, test_fns: Function[] = [], benchmark: BenchmarkBlock? = none }

# One `.benchmark({ .. })` attribute: its block, the functions declared inside
# the block (helpers private to it, as in a `.test` block), and the span of the
# attribute name, which is where a diagnostic about the attribute points.
struct BenchmarkBlock { body: Expr, fns: Function[], span: Span }

struct FieldDecl { name: SpanStr, ty: Ty, default: Expr? }

struct StructDecl { name: SpanStr, doc: str?, type_vars: TypeParam[], fields: FieldDecl[] }

# One payload slot of a variant case. A positional slot has no name; the three
# named forms differ only in whether they carry a default and whether the `?`
# moved onto the name.
struct CaseParam { name: str?, ty: Ty, default: Expr?, implicit_some: bool, doc: str? }

struct VariantCase { name: SpanStr, doc: str?, payload: CaseParam[] }

struct VariantDecl { name: SpanStr, doc: str?, type_vars: TypeParam[], cases: VariantCase[] }

# `variant Name = V without C`: a variant refined by leaving cases out, named.
# `target` is always the `Without` it spells. The loader substitutes it for every
# mention of the name and drops the declaration, so nothing past it sees one.
struct RefinementDecl { name: SpanStr, doc: str?, type_vars: TypeParam[], target: Ty }

# A top-level `pub let NAME: T = <literal>;`. The loader substitutes each use
# with the literal and drops the declaration, so nothing past it sees a
# constant. `name` carries its own span, which is what the diagnostics checking
# a constant's two rules point at — ALL_CAPS, and a literal value.
struct ConstDecl { name: SpanStr, is_pub: bool, ty: Ty?, value: Expr, doc: str? }

# A top-level item, at either stage. It is used directly only by what works at both;
# everything else takes the refinement for its stage. The cases are named apart from every
# other variant's because a refinement leaves out a case by name, anywhere it can be.
variant SuperItem =
    | WrittenFn(Function, Attributes)
    | LoweredFn(Function)
    | Struct(StructDecl)
    | Variant(VariantDecl)
    | Refinement(RefinementDecl)
    | Import(ImportDecl)
    | Const(ConstDecl)

# An item as the parser writes it: a function carries its attributes.
variant WrittenItem = SuperItem without LoweredFn

# An item once the attributes are functions of their own: what hoisting produces and
# every pass after it reads.
variant Item = SuperItem without WrittenFn

# `aipl_syntax::ast::Program`, less its `sources` map: a single parsed file has
# none, and the loader fills one in when it flattens several files together.
#
# `doc` is the file's own documentation — the `# ..` block at the top that a
# blank line detaches from whatever follows, so it documents no declaration.
# `none` for a file that opens with anything else, and for every program a pass
# builds or the loader flattens, neither of which is one file.
struct SuperProgram { items: SuperItem[], doc: str? }

# A program as the parser writes it: every function carries its attributes.
variant WrittenProgram = SuperProgram without LoweredFn throughout

# A program once the attributes are functions of their own, which is what every pass after
# hoisting reads.
variant Program = SuperProgram without WrittenFn throughout

# A parsed function body, before the return type is in scope to name the struct
# the shorthand constructs. Parser-local: by the time a `Function` is built the
# sugar is gone.
variant ParsedBody = Block(Expr) | Construct(FieldInit[], Span)

# A parameter as written, before the destructuring form is taken apart.
# `fields` is empty for every ordinary parameter and holds the pattern's field
# names for `Point { x, y }`, whose `Param` is the synthetic scrutinee the
# function's own lowering then binds those fields off. `names` is what each field
# is bound *as*, one per field: the field's own name, or the one written after
# `as` in `Point { x as px, y }`.
struct ParsedParam { param: Param, fields: str[], names: str[], span: Span }

# One `.test({ .. })` attribute: its block, and the span of the attribute name,
# which is where a duplicate is reported.
struct FnAttr { body: Expr, span: Span }

# A whole program as text, one item per line — the oracle the item lowering's
# tests assert against. Near the source it came from rather than structural,
# because an item's shape is its declaration and a dump that hid that would be
# harder to read than the thing it describes.
pub fn show_program(self: SuperProgram) -> str { self.items$show_item().join(sep="\n") }

pub fn show_item(self: SuperItem) -> str {
    match (self) {
        WrittenFn(f, attributes) => `{show_fn(f)}{show_attributes(attributes)}`,
        LoweredFn(f) => show_fn(f),
        Struct(s) => `{show_doc(s.doc)}struct {s.name.text}{show_type_params(s.type_vars)}({s.fields$show_field_decl().join(sep=", ")})`,
        Variant(v) => `{show_doc(v.doc)}variant {v.name.text}{show_type_params(v.type_vars)}({v.cases$show_case().join(sep=" | ")})`,
        Refinement(r) => `{show_doc(r.doc)}variant {r.name.text}{show_type_params(r.type_vars)} = {r.target.show_ty()}`,
        Import(d) => `import [{d.names$show_import_name().join(sep=", ")}] from {show_import_source(d.source)}`,
        Const(c) => `{show_doc(c.doc)}let {c.name.text}{show_const_ty(c.ty)} = {show_expr(c.value)}`,
    }
}.test({
    let d = ImportDecl {
        names: [ImportName { name: "a", alias: some("b"), span: 0..0 }],
        source: Builtins,
        source_span: 0..0,
    };
    assert(Import(d).show_item() == "import [a as b] from builtins");
    let no_params: TypeParam[] = [];
    let s = StructDecl {
        name: span_str("struct P { x: i64 }", 7..8),
        doc: none,
        type_vars: no_params,
        fields: [
            FieldDecl {
                name: span_str("struct P { x: i64 }", 11..12),
                ty: Primitive(I64),
                default: none,
            },
        ],
    };
    assert(Struct(s).show_item() == "struct P(x: i64)");
    let r = RefinementDecl {
        name: span_str("variant W = V without C", 8..9),
        doc: none,
        type_vars: no_params,
        target: Without(Named("V"), NamedCase("C")),
    };
    assert(Refinement(r).show_item() == "variant W = Without(V, C)");
})

fn show_fn(self: Function) -> str {
    let vis = match (self.visibility) {
        Public => "pub ",
        Private | EntryPoint | Test | Benchmark => "",
    };
    let sig = self.sig;
    let ret = sig.return_ty.map(|t| ` -> {t.show_ty()}`).value_or("");
    let effects = sig.effects$effect_marker().join();
    `{show_doc(self.doc)}{vis}fn {self.name.text}{show_type_params(sig.type_vars)}({sig.params$show_param().join(sep=", ")}){effects}{ret} = {self.body.show_expr()}`
}

# The attributes after the function they hang from: ` .test(block helper..) .benchmark(..)`.
fn show_attributes(self: Attributes) -> str {
    let helpers = self.test_fns.map(|h| ` {h.show_fn()}`).join();
    let test = self.test_body.map(|b| ` .test({b.show_expr()}{helpers})`).value_or("");
    `{test}{self.benchmark$show_benchmark().value_or("")}`
}

fn show_benchmark(self: BenchmarkBlock) -> str {
    ` .benchmark({self.body.show_expr()}{self.fns.map(|h| ` {h.show_fn()}`).join()})`
}

fn effect_marker(self: str) -> str { ` !{self}` }

fn show_doc(self: str?) -> str { self.map(|d| `doc({d}) `).value_or("") }

# A constant's annotation, or nothing when it was not written.
fn show_const_ty(self: Ty?) -> str { self.map(|t| `: {show_ty(t)}`).value_or("") }

fn show_type_params(self: TypeParam[]) -> str {
    if (self.is_empty()) { return ""; };
    `<{self$show_type_param().join(sep=", ")}>`
}

fn show_type_param(self: TypeParam) -> str {
    `{self.name}: {self.bound.show_bound()}{self.default.map(|d| ` = {show_ty(d)}`).value_or("")}`
}

fn show_param(self: Param) -> str {
    let prefix = if (self.mutable) { "mut " } else { "" };
    let opt = if (self.implicit_some) { "?" } else { "" };
    `{prefix}{self.synthesized_name()}{opt}: {self.ty.show_ty()}{self.arity.arity_marker()}{show_default(self.default)}`
}

fn show_default(self: Expr?) -> str { self.map(|e| ` = {e.show_expr()}`).value_or("") }

fn show_field_decl(self: FieldDecl) -> str {
    `{self.name.text}: {self.ty.show_ty()}{show_default(self.default)}`
}

fn show_case(self: VariantCase) -> str {
    let head = `{show_doc(self.doc)}{self.name.text}`;
    if (self.payload.is_empty()) { return head; };
    `{head}({self.payload$show_case_param().join(sep=", ")})`
}

fn show_case_param(self: CaseParam) -> str {
    let slot = match (self.name) {
        some(n) => `{n}{opt_marker(self.implicit_some)}: {self.ty.show_ty()}{show_default(self.default)}`,
        none => self.ty.show_ty(),
    };
    `{show_doc(self.doc)}{slot}`
}

fn opt_marker(self: bool) -> str {
    if (self) { return "?"; };
    ""
}

fn show_import_name(self: ImportName) -> str {
    self.alias.map(|a| `{self.name} as {a}`).value_or(self.name)
}

fn show_import_source(self: ImportSource) -> str {
    match (self) {
        Path(path) => `"{path}"`,
        Builtins => "builtins",
        Library(name) => name,
    }
}

# The names a field's declared type and default mention.
pub fn names(self: FieldDecl) -> #{str} { ty_and_default_names(self.ty, self.default) }

# The names a declared type and an optional default expression mention.
pub fn ty_and_default_names(ty: Ty, default: Expr?) -> #{str} {
    #{..ty.ty_names(), ..default$names_in().value_or(#{})}
}

# The names `self` and every expression under it mention.
pub fn names_in(self: Expr) -> #{str} {
    #{..self.own_names(), ..self.subexprs()$names_in().union_all()}
}.test({
    assert(expr(Call("f", [ident("x")], false, Unresolved)).names_in() == #{"f", "x"});
    assert(expr(Neg(ident("x"))).names_in() == #{"-", "x"});
    assert(expr(TypeArgs(ident("f"), [Named("Circle")])).names_in() == #{"f", "Circle"});
    assert(expr(LetPattern(
        ByStruct("P", ["x"], ["x"], false),
        ident("v"),
        ident("x"),
    )).names_in() == #{"P", "v", "x"});
})

# The names `e` itself mentions, not those of its sub-expressions.
pub fn own_names(self: Expr) -> #{str} {
    match (self.kind) {
        Ident(name, _) | ExprKind.Construct(name, _) | Call(name, _, _, _) => #{name},
        // Unary `-` is the one operator with no named builtin behind it, so it
        // stays a node; every other operator use is a `Call` on its spelling.
        Neg(..) => #{"-"},
        // A shim's name and bindings all name functions.
        Shim(effect, bindings, _) => #{effect, ..bindings$to_set().union_all()},
        // A provider shim names the provider function it calls.
        ProviderShim(provider, _, _) => #{provider},
        // A projection's method is a call of it.
        MethodProjection(_, name, _) => #{name},
        Let(_, ty, _, _) | LetMut(_, ty, _, _) => ty.optional_ty_names(),
        Lambda(params, _) => #{
            ..params$ty$optional_ty_names().union_all(),
            ..params$binding$destructure_names().union_all(),
        },
        Match(_, arms) => arms$pattern$ctor_names().union_all(),
        // `if (let P = e)` is one arm without the `match`; its pattern names a
        // constructor just as an arm's does.
        IfLet(arm, _, _) => arm.pattern.ctor_names(),
        // A destructuring `let` or `for` names the struct or case it takes apart.
        LetPattern(binding, _, _) | ForPattern(binding, _, _, _) => binding.destructure_names(),
        Num(..)
        | FloatLit(..)
        | Bool(..)
        | Str(..)
        | Char(..)
        | None
        | Unit
        | If(..)
        | Field(..)
        | FieldProjection(..)
        | Interpolation(..)
        | Assign(..)
        | For(..)
        | While(..)
        | ArrayLit(..)
        | Spread(..)
        | SetLit(..)
        | DictLit(..)
        | Index(..)
        | Slice(..)
        | Try(..)
        | Seq(..)
        | Return(..)
        | TupleLit(..)
        | KwArg(..) => #{},
        // `f::<Circle>()` names the type it writes.
        TypeArgs(_, types) => types$ty_names().union_all(),
    }
}

# The type or case a binding names: a plain name or a tuple names none.
pub fn destructure_names(self: Binding) -> #{str} {
    match (self) {
        Name(..) | ByTuple(..) => #{},
        ByCase(case_name, _) => path_names(case_name),
        ByStruct(struct_name, _, _, _) => #{struct_name},
        ByPattern(pattern) => pattern.ctor_names(),
        Alias(_, inner) => inner.destructure_names(),
    }
}.test({
    assert(Name("x").destructure_names() == #{});
    assert(ByTuple(["a", "b"]).destructure_names() == #{});
    assert(ByCase("V.A", ["x"]).destructure_names() == #{"V", "V.A"});
    assert(ByStruct("P", ["x"], ["x"], false).destructure_names() == #{"P"});
    assert(Alias("p", ByStruct("P", ["x"], ["x"], false)).destructure_names() == #{"P"});
})

# The constructors a pattern names, at any depth. A `V.A` path names the variant
# as well as the case. Written with the variant's name because `Str` and `Char`
# are also expression cases here.
pub fn ctor_names(self: Pat) -> #{str} {
    match (self) {
        Pat.Ctor(name, _, _) => path_names(name),
        Pat.Nested(name, args) => #{..path_names(name), ..args$ctor_names().union_all()},
        Pat.Struct(name, _, _) => #{name},
        Pat.ArrayNested(patterns) | Pat.Tuple(patterns) => patterns$ctor_names().union_all(),
        Pat.Str(..)
        | Pat.Char(..)
        | Pat.Array(..)
        | Pat.ArrayRest(..)
        | Pat.Wildcard
        | Pat.Int(..) => #{},
    }
}.test({
    assert(Pat.Ctor("V.A", bindings=["x"]).ctor_names() == #{"V", "V.A"});
    assert(Pat.Nested("some", [Pat.Struct("P", ["x"], ["x"])]).ctor_names() == #{"some", "P"});
    assert(Pat.Wildcard.ctor_names() == #{});
})

# The names a constructor written `name` mentions: the name, and the variant too
# when it is qualified.
pub fn path_names(name: str) -> #{str} {
    match (name.split(".")) {
        [part, ..] => #{part, name},
        _ => #{name},
    }
}.test({
    assert(path_names("A") == #{"A"});
    assert(path_names("V.A") == #{"V", "V.A"});
})

# The names an annotation mentions, none when it was not written.
pub fn optional_ty_names(self: Ty?) -> #{str} { self$ty_names().value_or(#{}) }.test({
    assert(some(Named("A")).optional_ty_names() == #{"A"});
    let unwritten: Ty? = none;
    assert(unwritten.optional_ty_names() == #{});
})

# Every name `self` mentions, so an import used only in a type position still
# counts as used. Variants are spelled out rather than wildcarded so a new `Ty`
# forces a decision here.
pub fn ty_names(self: Ty) -> #{str} {
    match (self) {
        Named(name) => #{name},
        // `Case<V>` mentions `V`, so importing a variant to name one of its cases
        // counts as using the import.
        Case(inner)
        | Optional(inner)
        | TyArray(inner)
        | TySet(inner, _)
        | Without(inner, _) => inner.ty_names(),
        // A type parameter is bound by the signature, not imported.
        TypeVar(..) | TyUnit | Primitive(..) | Any => #{},
        Generic(base, args) => #{base, ..args$ty_names().union_all()},
        Dict(a, b) | Result(a, b) => #{..a.ty_names(), ..b.ty_names()},
        TyFn(params, ret) => #{..params$ty_names().union_all(), ..ret.ty_names()},
        TyTuple(elements) => elements$ty_names().union_all(),
    }
}.test({
    assert(Named("A").ty_names() == #{"A"});
    assert(Optional(Generic("Box", [Named("A")])).ty_names() == #{"Box", "A"});
    assert(Dict(Named("K"), Named("V")).ty_names() == #{"K", "V"});
    assert(TypeVar("T").ty_names() == #{});
})

# The names a parameter mentions: its type, its default, and what its binding names.
pub fn param_names(self: Param) -> #{str} {
    #{..ty_and_default_names(self.ty, self.default), ..self.binding.destructure_names()}
}.test({
    let param = Param {
        binding: ByStruct("P", ["x"], ["x"], false),
        ty: Named("T"),
        mutable: false,
        arity: One,
        default: none,
        implicit_some: false,
    };
    assert(param.param_names() == #{"T", "P"});
})

# The names a payload slot of a variant case mentions: its type and its default.
pub fn case_param_names(self: CaseParam) -> #{str} { ty_and_default_names(self.ty, self.default) }

# The names a function mentions: in its signature and its body.
pub fn function_names(self: Function) -> #{str} {
    #{
        ..self.sig.params$param_names().union_all(),
        ..self.sig.return_ty.optional_ty_names(),
        ..self.body.names_in(),
    }
}

# The names an item mentions outside an import list. An import mentions none.
pub fn item_names(self: Item) -> #{str} {
    match (self) {
        LoweredFn(f) => f.function_names(),
        Struct(s) => s.fields$names().union_all(),
        Variant(v) => v.cases$payload.join()$case_param_names().union_all(),
        // A constant's annotation may name an imported type; its value is a literal, so
        // it names nothing.
        Const(c) => #{..c.ty.optional_ty_names(), ..c.value.names_in()},
        Refinement(r) => r.target.ty_names(),
        Import(..) => #{},
    }
}
