# The rewrites that turn a function's `.test` and `.benchmark` attributes into ordinary
# top-level functions, so that everything after the parse — the loader's rewrites included,
# which is how they recognize test code — sees only functions.
#
# - A `.test({ .. })` block becomes `__test$<f>`: public, no parameters, the block as its
#   body, declaring no effect (so `aipl check` runs it, `assert` works in it, and a test
#   shims whatever it uses). It sits right after `f`.
# - A `.benchmark({ .. })` attribute becomes `__benchmark$<f>`: private, no parameters, a
#   unit body — the block itself is `__test$__benchmark$<f>`, which declares `measure` and
#   nothing else. They sit right after `f` and the helpers `f`'s own `.test` block declared.
# - A function declared inside a `.test` block moves out to the top level under
#   `test_helper_name`, reachable only from where it was declared: its uses in
#   the test body and in the block's other helpers (a helper may call itself and
#   its siblings) are renamed with it, and nothing else in the file can spell the
#   hoisted name. The helpers of one test land right after the function that
#   carries it, in declaration order.
# - A top-level `test({ .. })` is carried by a function that exists only for it; the block
#   becomes `__test$<carrier>` and the carrier goes.
#
# Renaming is by name, not by scope: a `let` in the test body that shadows a
# helper's name is not tracked, the same way a call's name resolves in the
# loader.

import { equal as ==, get, is_empty, join, map, to_dict, value_or } from builtins;
import { Call, Expr, Ident, Unit, at, expr, ident, map_subexprs, show_expr } from "./expr.aipl";
import {
    Benchmark,
    benchmark_fn_name,
    fn_role,
    is_unattached_test,
    test_fn_name,
    test_helper_name,
} from "./fn_names.aipl";
import { BenchmarkBlock, Fn, Function, Item, Program, Signature } from "./item.aipl";
import { SpanStr } from "./lexer.aipl";

# `program` with every `.test` block and its helpers, and every `.benchmark` block, moved out
# to top-level functions of their own.
pub fn hoist_test_fns(self: Program) -> Program { ..self, items: self.items$hoisted_items().join() }

fn hoisted_items(self: Item) -> Item[] {
    match (self) {
        Fn(f) => f.function_items(),
        _ => [self],
    }
}

# `f`, then its helpers, then the function standing for its `.benchmark` block and that
# block's helpers, each followed by the function its own `.test` block is.
fn function_items(self: Function) -> Item[] {
    let own = Function { ..self, benchmark: none }.hoisted();
    let stand_in = self.benchmark
        .map(|block| self.benchmark_function(block).hoisted())
        .value_or([]);
    [..own, ..stand_in]$with_test_function().join().map(Fn)
}

# The function standing for `self`'s `.benchmark` block. Named at the
# attribute, which is where a diagnostic about the function itself points.
fn benchmark_function(self: Function, BenchmarkBlock { body, fns, span }) -> Function {
    name: SpanStr { text: benchmark_fn_name(self.name.text), span },
    is_pub: false,
    sig: Signature { type_vars: [], params: [], effects: [], return_ty: none },
    body: at(Unit, span),
    test_body: some(body),
    test_fns: fns,
    benchmark: none,
    doc: none,
}

# `self` followed by the functions declared in its `.test` block, renamed. A
# function with no helpers is itself.
fn hoisted(self: Function) -> Function[] {
    if (self.test_fns.is_empty()) { return [self]; };
    let renames = self.test_fns
        .map(|h| (h.name.text, test_helper_name(self.name.text, h.name.text)))
        .to_dict();
    let owner = Function { ..self, test_body: self.test_body$rename_uses(renames), test_fns: [] };

    // The hoisted name is one this pass invented, so it keeps the span of the
    // name the author *did* write — the helper's own, which is where a
    // diagnostic about it should point.
    let helpers = self.test_fns.map(|h| Function {
        ..h,
        name: SpanStr { ..h.name, text: h.name.text.renamed(renames) },
        body: h.body.rename_uses(renames),
    });
    [owner, ..helpers]
}

# `self`, and the function its `.test` block is: `__test$<self>`, public, with no
# parameters and the block as its body, which declares `measure` when it is a `.benchmark`
# block and no effect otherwise. The function is `self` less the block, and not there at all
# for a top-level `test({ .. })`, whose carrier has nothing else to say.
fn with_test_function(self: Function) -> Function[] {
    let some(block) = self.test_body else { return [self]; };
    let effects = match (fn_role(self.name.text)) {
        Benchmark(..) => ["measure"],
        _ => [],
    };
    let test = Function {
        name: SpanStr { ..self.name, text: test_fn_name(self.name.text) },
        is_pub: true,
        sig: Signature { type_vars: [], params: [], effects, return_ty: none },
        body: block,
        test_body: none,
        test_fns: [],
        benchmark: none,
        doc: none,
    };
    if (self.name.text.is_unattached_test()) {
        [test]
    } else {
        [Function { ..self, test_body: none }, test]
    }
}

# What `name` is renamed to by `renames`, or `name` itself.
fn renamed(self: str, renames: #{str: str}) -> str { renames.get(self).value_or(self) }.test({
    assert("a".renamed(#{"a": "b", "c": "d"}) == "b");
    assert("c".renamed(#{"a": "b", "c": "d"}) == "d");
    assert("e".renamed(#{"a": "b"}) == "e");
    assert("a".renamed(#{}) == "a");
})

# `self` with every call to, and every value use of, a name in `renames`
# renamed.
fn rename_uses(self: Expr, renames: #{str: str}) -> Expr {
    let kind = match (self.kind) {
        Ident(name) => Ident(name.renamed(renames)),
        Call(name, args, method_style) => Call(name.renamed(renames), args, method_style),
        _ => self.kind,
    };
    Expr { ..self, kind }.map_subexprs(|child| child.rename_uses(renames))
}.test({
    let renames = #{"four": "__test$f$four"};
    // A call, a value use, and a use nested in both.
    let used = expr(Call("four", [ident("four"), expr(Call("g", [ident("four")], false))], false));
    assert(
        used.rename_uses(renames).show_expr() == "__test$f$four(__test$f$four, g(__test$f$four))",
    );
    // A name that is not renamed, and a method-style call's receiver.
    assert(ident("other").rename_uses(renames).show_expr() == "other");
    assert(
        expr(Call("four", [ident("x")], true))
            .rename_uses(renames)
            .show_expr() == "x.__test$f$four()",
    );
})
