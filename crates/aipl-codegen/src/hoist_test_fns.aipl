# The two rewrites that turn a function's `.test` and `.performance` attributes
# into ordinary top-level functions, so that everything after the parse — the
# loader's rewrites included, which is how they recognize test code — sees only
# functions.
#
# - A `.performance({ .. })` attribute becomes `__performance$<f>`: private, no
#   parameters, a unit body, and the block as its `.test` body (so `aipl check`
#   runs it, `assert` works in it, and an imported file's is dropped, all by the
#   machinery `.test` already has). It sits right after `f` and the helpers `f`'s
#   own `.test` block declared.
# - A function declared inside a `.test` block moves out to the top level under
#   `test_helper_name`, reachable only from where it was declared: its uses in
#   the test body and in the block's other helpers (a helper may call itself and
#   its siblings) are renamed with it, and nothing else in the file can spell the
#   hoisted name. The helpers of one test land right after the function that
#   carries it, in declaration order.
#
# Renaming is by name, not by scope: a `let` in the test body that shadows a
# helper's name is not tracked, the same way a call's name resolves in the
# loader.

import { equal as ==, find_if, is_empty, join, map, value_or } from builtins;
import { Call, Expr, Ident, Unit, at, expr, ident, map_subexprs, show_expr } from "./expr.aipl";
import { performance_fn_name, test_helper_name } from "./fn_names.aipl";
import { Fn, Function, Item, PerformanceBlock, Program, Signature } from "./item.aipl";
import { SpanStr } from "./lexer.aipl";

# `program` with every `.test` helper and `.performance` block moved out to a
# top-level function of its own.
pub fn hoist_test_fns(self: Program) -> Program {
    ..self,
    items: self.items.map(hoisted_items).join(),
}

fn hoisted_items(self: Item) -> Item[] {
    match (self) {
        Fn(f) => f.function_items(),
        _ => [self],
    }
}

# `f`, then its helpers, then the function standing for its `.performance` block
# and that block's helpers.
fn function_items(self: Function) -> Item[] {
    let own = Function { ..self, performance: none }.hoisted();
    let stand_in = self.performance
        .map(|block| self.performance_function(block).hoisted())
        .value_or([]);
    [..own, ..stand_in].map(Fn)
}

# The function standing for `self`'s `.performance` block. Named at the
# attribute, which is where a diagnostic about the function itself points.
fn performance_function(self: Function, block: PerformanceBlock) -> Function {
    let PerformanceBlock { body, fns, span } = block;
    Function {
        name: SpanStr { text: performance_fn_name(self.name.text), span },
        is_pub: false,
        sig: Signature { type_vars: [], params: [], effects: [], return_ty: none },
        body: at(Unit, span),
        test_body: some(body),
        test_fns: fns,
        performance: none,
        doc: none,
    }
}

# `self` followed by the functions declared in its `.test` block, renamed. A
# function with no helpers is itself.
fn hoisted(self: Function) -> Function[] {
    if (self.test_fns.is_empty()) {
        return [self];
    };
    let renames = self.test_fns.map(|h| (
        h.name.text,
        test_helper_name(self.name.text, h.name.text),
    ));
    let owner = Function { ..self, test_body: self.test_body$rename_uses(renames), test_fns: [] };

    // The hoisted name is one this pass invented, so it keeps the span of the
    // name the author *did* write — the helper's own, which is where a
    // diagnostic about it should point.
    let helpers = self.test_fns.map(|h| Function {
        ..h,
        name: SpanStr { ..h.name, text: h.name.text.renamed(renames) },
        body: h.body.rename_uses(renames),
    });
    [owner, ..helpers]
}

# What `name` is renamed to by `renames`, or `name` itself.
fn renamed(self: str, renames: (str, str)[]) -> str {
    renames.find_if(|r| r.0 == self)$1.value_or(self)
}.test({
    assert("a".renamed([("a", "b"), ("c", "d")]) == "b");
    assert("c".renamed([("a", "b"), ("c", "d")]) == "d");
    assert("e".renamed([("a", "b")]) == "e");
    assert("a".renamed([]) == "a");
})

# `self` with every call to, and every value use of, a name in `renames`
# renamed.
fn rename_uses(self: Expr, renames: (str, str)[]) -> Expr {
    let kind = match (self.kind) {
        Ident(name) => Ident(name.renamed(renames)),
        Call(name, args, method_style) => Call(name.renamed(renames), args, method_style),
        _ => self.kind,
    };
    Expr { ..self, kind }.map_subexprs(|child| child.rename_uses(renames))
}.test({
    let renames = [("four", "__test$f$four")];
    // A call, a value use, and a use nested in both.
    let used = expr(Call("four", [ident("four"), expr(Call("g", [ident("four")], false))], false));
    assert(
        used.rename_uses(renames).show_expr() == "__test$f$four(__test$f$four, g(__test$f$four))",
    );
    // A name that is not renamed, and a method-style call's receiver.
    assert(ident("other").rename_uses(renames).show_expr() == "other");
    assert(
        expr(Call("four", [ident("x")], true))
            .rename_uses(renames)
            .show_expr() == "x.__test$f$four()",
    );
})
