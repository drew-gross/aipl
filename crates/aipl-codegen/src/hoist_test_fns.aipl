# The rewrites that turn a function's `.test` and `.benchmark` attributes into ordinary
# top-level functions, so that everything after the parse — the loader's rewrites included,
# which is how they recognize test code — sees only functions.
#
# - A `.test({ .. })` block becomes `__test$<f>`: no parameters, the block as its
#   body, declaring no effect (so `aipl check` runs it, `assert` works in it, and a test
#   shims whatever it uses). It sits right after `f`.
# - A `.benchmark({ .. })` attribute becomes `__benchmark$<f>`: no parameters, a
#   unit body — the block itself is `__test$__benchmark$<f>`, which declares `measure` and
#   nothing else. They sit right after `f` and the helpers `f`'s own `.test` block declared.
# - A function declared inside a `.test` block moves out to the top level under
#   `test_helper_name`, reachable only from where it was declared: its uses in
#   the test body and in the block's other helpers (a helper may call itself and
#   its siblings) are renamed with it, and nothing else in the file can spell the
#   hoisted name. The helpers of one test land right after the function that
#   carries it, in declaration order.
# - A top-level `test({ .. })` is carried by a function that exists only for it; the block
#   becomes `__test$<carrier>` and the carrier goes.
#
# The functions this makes are the ones given the `Test` and `Benchmark` visibilities: a block's
# function is `Test`, or `Benchmark` when it is a `.benchmark` block, and so is the function a
# `.benchmark` hangs from.
#
# Renaming is by name, not by scope: a `let` in the test body that shadows a
# helper's name is not tracked, the same way a call's name resolves in the
# loader.

import { Span, equal as ==, get, is_empty, join, map, to_dict, value_or } from builtins;
import { Unresolved } from "./builtin_table.aipl";
import { Call, Expr, Ident, Unit, at, expr, ident, map_subexprs, show_expr } from "./expr.aipl";
import {
    Benchmark,
    benchmark_fn_name,
    fn_role,
    is_unattached_benchmark,
    is_unattached_test,
    test_fn_name,
    test_helper_name,
} from "./fn_names.aipl";
import {
    Attributes,
    Benchmark as BenchmarkFn,
    Function,
    Item,
    LoweredFn,
    Program,
    Signature,
    SuperProgram,
    Test,
    WrittenFn,
    WrittenItem,
    WrittenProgram,
} from "./item.aipl";
import { SpanStr } from "./lexer.aipl";

# `program` with every `.test` block and its helpers, and every `.benchmark` block, moved out
# to top-level functions of their own.
pub fn hoist_test_fns(self: WrittenProgram) -> Program {
    SuperProgram { items: self.items$hoisted_items().join(), doc: self.doc }
}

fn hoisted_items(self: WrittenItem) -> Item[] {
    match (self) {
        WrittenFn(f, attributes) => f.function_items(attributes)$lowered(),
        _ => [self],
    }
}

fn lowered(self: Function) -> Item { LoweredFn(self) }

# `f`, then its helpers, then the function standing for its `.benchmark` block and that
# block's helpers, each followed by the function its own `.test` block is.
fn function_items(self: Function, Attributes { test_body, test_fns, benchmark }) -> Function[] {
    let stand_in = benchmark
        .map(|block| self.benchmark_function(block.span).hoisted(some(block.body), block.fns))
        .value_or([]);
    // A top-level `benchmark({ .. })`'s carrier is the benchmark's own function.
    let carrier = if (self.name.text.is_unattached_benchmark()) {
        Function { ..self, visibility: BenchmarkFn }
    } else {
        self
    };
    [..carrier.hoisted(test_body, test_fns), ..stand_in]
}

# The function standing for a `.benchmark` block on `self`, with an empty body: the block
# itself is its `.test` body. Named at the attribute, which is where a diagnostic about the
# function itself points.
fn benchmark_function(self: Function, span: Span) -> Function {
    name: SpanStr { text: benchmark_fn_name(self.name.text), span },
    visibility: BenchmarkFn,
    sig: Signature { type_vars: [], params: [], effects: [], return_ty: none, is_method: false },
    body: at(Unit, span),
    doc: none,
}

# `self` followed by the functions declared in its `.test` block, renamed, each with the
# function its own block is. A function with no helpers is itself.
fn hoisted(self: Function, test_body: Expr?, test_fns: Function[]) -> Function[] {
    if (test_fns.is_empty()) { return self.with_test_function(test_body); };
    let renames = test_fns
        .map(|h| (h.name.text, test_helper_name(self.name.text, h.name.text)))
        .to_dict();

    // The hoisted name is one this pass invented, so it keeps the span of the
    // name the author *did* write — the helper's own, which is where a
    // diagnostic about it should point.
    let helpers = test_fns.map(|h| Function {
        ..h,
        name: SpanStr { ..h.name, text: h.name.text.renamed(renames) },
        body: h.body.rename_uses(renames),
    });
    [..self.with_test_function(test_body$rename_uses(renames)), ..helpers]
}

# `self`, and the function its `.test` block is: `__test$<self>`, with no
# parameters and the block as its body, which declares `measure` when it is a `.benchmark`
# block and no effect otherwise. For a top-level `test({ .. })`, whose carrier has nothing
# else to say, it is only that function.
fn with_test_function(self: Function, test_body: Expr?) -> Function[] {
    let some(block) = test_body else { return [self]; };
    let effects = match (fn_role(self.name.text)) {
        Benchmark(..) => ["measure"],
        _ => [],
    };
    let visibility = match (fn_role(self.name.text)) {
        Benchmark(..) => BenchmarkFn,
        _ => Test,
    };
    let test = Function {
        name: SpanStr { ..self.name, text: test_fn_name(self.name.text) },
        visibility,
        sig: Signature { type_vars: [], params: [], effects, return_ty: none, is_method: false },
        body: block,
        doc: none,
    };
    if (self.name.text.is_unattached_test()) { [test] } else { [self, test] }
}

# What `name` is renamed to by `renames`, or `name` itself.
fn renamed(self: str, renames: #{str: str}) -> str { renames.get(self).value_or(self) }.test({
    assert("a".renamed(#{"a": "b", "c": "d"}) == "b");
    assert("c".renamed(#{"a": "b", "c": "d"}) == "d");
    assert("e".renamed(#{"a": "b"}) == "e");
    assert("a".renamed(#{}) == "a");
})

# `self` with every call to, and every value use of, a name in `renames`
# renamed.
fn rename_uses(self: Expr, renames: #{str: str}) -> Expr {
    let kind = match (self.kind) {
        Ident(name) => Ident(name.renamed(renames)),
        Call(name, args, method_style, _) => Call(
            name.renamed(renames),
            args,
            method_style,
            Unresolved,
        ),
        _ => self.kind,
    };
    Expr { ..self, kind }.map_subexprs(|child| child.rename_uses(renames))
}.test({
    let renames = #{"four": "__test$f$four"};
    // A call, a value use, and a use nested in both.
    let used = expr(Call(
        "four",
        [ident("four"), expr(Call("g", [ident("four")], false, Unresolved))],
        false,
        Unresolved,
    ));
    assert(
        used.rename_uses(renames).show_expr() == "__test$f$four(__test$f$four, g(__test$f$four))",
    );
    // A name that is not renamed, and a method-style call's receiver.
    assert(ident("other").rename_uses(renames).show_expr() == "other");
    assert(
        expr(Call("four", [ident("x")], true, Unresolved))
            .rename_uses(renames)
            .show_expr() == "x.__test$f$four()",
    );
})
