import { equal as ==, read_file_to_string, write_string_to_file } from builtins;
import { Fill, fill_or_add_sections } from "./fill_or_add_sections.aipl";

# Reads the file at `path`, splices every fill in `fills` into (or appends it
# to) its `--- section ---` blocks via `fill_or_add_sections`, and writes the
# result back to `path`. One read and one write for the whole batch.
pub fn fill_or_add_sections_file(path: str, fills: Fill[]) !read_files !write_files -> !Error {
    let contents = read_file_to_string(path)?;
    write_string_to_file(path, fill_or_add_sections(contents, fills))
}.test({
    // This file is loaded in place by `aipl check` (some callers run it with
    // cwd at the repo root, not a staged throwaway dir like `tests/cases/
    // files/` fixtures get), so only the read-failure path — which touches
    // nothing on disk — is safe to exercise directly here. The write-failure
    // branch mirrors it exactly, and `write_string_to_file`'s own error
    // behavior is covered in `tests/cases/files/write_file.aipl`.
    assert(fill_or_add_sections_file(
        "no_such_file_xyz_12345.aipl",
        [Fill { section: "foo", body: "bar" }],
    ) == err("could not read file"));
})
