import { equal as ==, push, read_file_to_string, write_string_to_file } from builtins;
import { fill_or_add_sections } from "./fill_or_add_sections.aipl";

# Reads the file at `path`, splices every fill in `fills` into (or appends it
# to) its `--- section ---` blocks via `fill_or_add_sections`, and writes the
# result back to `path`. One read and one write for the whole batch.
pub fn fill_or_add_sections_file(path: str, fills: #{str: str}) !read_files !write_files -> !Error {
    let contents = read_file_to_string(path)?;
    write_string_to_file(path, fill_or_add_sections(contents, fills))
}.test({
    // Stand-in files: a read that fails, and a read-then-write round trip.
    shim read_files { read_file_to_string = |path| err("could not read file") } {
        shim write_files { write_string_to_file = |path, contents| ok() } {
            assert(fill_or_add_sections_file("no_such_file_xyz_12345.aipl", #{"foo": "bar"}) == err(
                "could not read file",
            ));
        };
    };
    mut written: str[] = [];
    shim write_files {
        write_string_to_file = |path, contents| {
            set written.push(contents);
            ok()
        },
    } {
        shim read_files { read_file_to_string = |path| ok("fn f() {}\n") } {
            assert(fill_or_add_sections_file("x.aipl", #{"stdout": "hi"}) == ok());
        };
    };
    assert(written == [fill_or_add_sections("fn f() {}\n", #{"stdout": "hi"})]);
})
