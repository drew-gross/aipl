// ---------- the grammar ----------

# AIPL's grammar: the productions the driver in `parse.aipl` parses AIPL with,
# starting at `program`.
#
# Split across five builder functions purely for reading — the array they
# concatenate to is one flat production list, and position in it is identity
# (a linked `NamedIdx` and a `Tree` both name a production by its index).
pub fn aipl_grammar() -> Grammar<AiplTok, Ast> {
    prods: [..items(), ..types(), ..statements(), ..expressions(), ..patterns()],
}

// ---------- items ----------

fn items() -> Production<AiplTok, Ast>[] {
    // `program = item*`, and every byte of the file has to be one: `parse_cst`
    // refuses input left over after the start rule.
    let program: Rule<AiplTok> = Many(Named("item"));

    // `# text` lines in front of a declaration. They are also accepted on a
    // variant case (see `variant_case` below); the two never compete, because
    // a case's docs are followed by `|` and a name where an item's are
    // followed by a keyword, and ordered choice backtracks out of the one that
    // does not fit.
    let item: Rule<AiplTok> = Then([
        Many(Term(DocComment)),
        OneOf([
            Named("function"),
            Named("struct_decl"),
            // Before `variant_decl`: `variant W = V without C` opens the way a
            // one-case variant does, and only the `without` after the first
            // name tells them apart. Ordered choice backtracks to the cases.
            Named("refinement_decl"),
            Named("variant_decl"),
            Named("import_decl"),
            Named("const_decl"),
            // `mut NAME = ..;` at the top level: not a form, but one a reader
            // plausibly writes, so it is refused by name rather than as an
            // unexpected token. The error underlines the `mut`.
            Then([Lit("mut"), Refuse(Msg("aipl does not allow mutable global variables"))]),
        ]),
    ]);

    // `import { a, b as c, equal as == } from "./x.aipl";` — or `from builtins`.
    //
    // The names are `sorted`: the formatter prints them in `str` order of the
    // name each one leads with — the *imported* name, so `wrapping_add as +`
    // sorts under `w`, beside the function it actually imports, rather than
    // among the operator spellings. This one word is the whole of that rule;
    // `walker.aipl` hands an import to the grammar-driven formatter and reads
    // the order back rather than knowing it.
    let import_decl: Rule<AiplTok> = Then([
        Lit("import"),
        Many(Named("import_name"), sep=Lit(","), nested_in=braces(), spaced=true, sorted=true),
        Expect(Lit("from")),
        OneOf([Term(StrLit), Lit("builtins")]),
        Expect(Lit(";")),
    ]);

    // A name, or an aliased name. The aliased form is first: it starts with
    // the same `IDENT` the plain form is.
    //
    // The third alternative is the bare operator the language used to accept
    // (`import { == }`), kept as a shape the parser recognises only to refuse:
    // an operator is imported under the name of the builtin it stands for,
    // and a reader who writes the old form gets told that, rather than
    // "expected an import name, found `==`". The refusal is handed the
    // operator it matched, so the message names the aliases to write for
    // *that* operator — see `bare_operator_import`.
    let import_name: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit("as"), OneOf([Term(Name), Named("operator")])]),
        Term(Name),
        Then([Named("operator"), Refuse(Fn(bare_operator_import))]),
    ]);

    // Every operator spelling that may be imported — as an alias, after `as`.
    // `=`, `?` and `..` are absent because they are not operators you can
    // import — the loader's own gate (`is_operator_name`) is the list this
    // mirrors. Order is immaterial: the lexer already took the longest munch,
    // so each spelling is one token.
    let operator: Rule<AiplTok> = OneOf([
        Lit("+++"),
        Lit("=="),
        Lit("!="),
        Lit("<="),
        Lit(">="),
        Lit("&&"),
        Lit("||"),
        Lit("++"),
        Lit("--"),
        Lit("+="),
        Lit("-="),
        Lit("*="),
        Lit("/="),
        Lit("+"),
        Lit("-"),
        Lit("*"),
        Lit("/"),
        Lit("%"),
        Lit("<"),
        Lit(">"),
        Lit("!"),
    ]);

    let function: Rule<AiplTok> = Then([
        Maybe(Lit("pub")),
        Lit("fn"),
        Term(Name),
        Named("type_params"),
        Many(Named("param"), sep=Lit(","), nested_in=parens()),
        Many(Named("effect")),
        Maybe(Then([Lit("->"), Named("ty")])),
        Named("fn_body"),
        Many(Named("fn_attr")),
    ]);
    let effect: Rule<AiplTok> = Then([Lit("!"), Term(Name)]);

    // `pub let NAME: T = <literal>;` — a top-level constant. The value is an
    // `expr` here rather than a literal rule: `let NAME = f();` then parses and
    // is refused by the loader, which can say *why* a constant takes a literal,
    // where a parse error could only say what it expected instead.
    let const_decl: Rule<AiplTok> = Then([
        Maybe(Lit("pub")),
        Lit("let"),
        Term(Name),
        Maybe(Then([Lit(":"), Named("ty")])),
        Lit("="),
        Named("expr"),
        Expect(Lit(";")),
    ]);

    // `<T, U: ord>`. At least one parameter — `<>` is a syntax error, which is
    // why this list has `min=1`.
    let type_params: Rule<AiplTok> = Maybe(Many(
        Named("type_param"),
        min=1,
        sep=Lit(","),
        trailing_sep=false,
        nested_in=angles(),
    ));

    // `T`, `T: bound`, and either with a default type after `=`: `T = i64`,
    // `T: ord = u8`. Longest first.
    let type_param: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit(":"), OneOf([Term(Name), Lit("variant")]), Lit("="), Named("ty")]),
        Then([Term(Name), Lit(":"), OneOf([Term(Name), Lit("variant")])]),
        Then([Term(Name), Lit("="), Named("ty")]),
        Term(Name),
    ]);

    // The parameter shapes, longest first. `mut self: T` takes no default
    // and no variadic marker. The variadic marker is `*` (zero or more) or `+`
    // (one or more).
    let variadic: Rule<AiplTok> = OneOf([Lit("*"), Lit("+")]);
    let param: Rule<AiplTok> = OneOf([
        Then([Lit("mut"), Term(Name), Lit(":"), Named("ty")]),
        // `self: Span { start, end }` — a named parameter destructured as well.
        // Ahead of `name: T`, which would otherwise take `self: Span` and leave
        // the `{` unparsed. The same goes for `self: Import(decl)`, which takes
        // apart a value that can only be the one case.
        Then([Term(Name), Lit(":"), Term(Name), field_binders()]),
        Then([Term(Name), Lit(":"), Term(Name), case_payload()]),
        Then([Term(Name), Lit(":"), Named("ty"), variadic, Lit("="), Named("expr")]),
        // `k?: T = none` — a parameter that may be *omitted*, as against `k: T?`
        // whose type is optional. Ordered choice makes this an ordinary
        // alternative: the parser backtracks over the `?` when the `:` does not
        // follow, so `?:` needs no terminal of its own.
        Then([Term(Name), Lit("?"), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty"), variadic]),
        Then([Term(Name), Lit(":"), Named("ty")]),
        // `Point { x, y }` — the argument destructured in place of being named,
        // the same pattern `let Point { x, y } = v;` writes. It names no
        // parameter, so there is no `: T` to follow.
        Then([Term(Name), field_binders()]),
        // `Import(decl)` — the same for a parameter that can only be one case. Its
        // slots are patterns, so `Import(ImportDecl { names })` nests.
        Then([Term(Name), case_payload()]),
    ]);

    // A body is a block, or the struct-literal shorthand. The shorthand is tried
    // first and can only match when a `:` or `,` follows the first name (or the
    // body opens with `..`), so `{ x }` still reads as a block returning `x`.
    let fn_body: Rule<AiplTok> = OneOf([
        nest("{", Named("construct_fields"), "}", braced()),
        Named("block"),
    ]);
    let construct_fields: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr"), Lit(","), Many(Named("field_init"), sep=Lit(","))]),
        Then([
            Term(Name),
            Lit(":"),
            Named("expr"),
            Lit(","),
            Many(Named("field_init"), sep=Lit(",")),
        ]),
        Then([Term(Name), Lit(":"), Named("expr")]),
        Then([Term(Name), Lit(","), Many(Named("field_init"), sep=Lit(","))]),
    ]);

    // `.test({ .. })` and `.performance({ .. })`, the only attributes. The
    // string-argument form parses so that the retired `.doc("..")` can be
    // refused by name, with the migration to `# ..` lines in the message.
    let fn_attr: Rule<AiplTok> = Then([
        Lit("."),
        Term(Name),
        nest("(", OneOf([Named("test_block"), Term(StrLit)]), ")", strict()),
    ]);

    // A `.test` block is a block that may also declare functions — helpers
    // private to the test — anywhere a statement could go. `fn` opens none of
    // the statement or expression forms, so the choice stays one token.
    let test_block: Rule<AiplTok> = one(Named("test_body"), nested_in=braces());
    let test_body: Rule<AiplTok> = Maybe(OneOf([
        Then([Named("function"), Named("test_body")]),
        Then([Named("kw_stmt"), Named("test_body")]),
        Then([Named("expr"), Named("test_tail")]),
    ]));
    let test_tail: Rule<AiplTok> = Maybe(Then([Lit(";"), Named("test_body")]));

    let struct_decl: Rule<AiplTok> = Then([
        Lit("struct"),
        Term(Name),
        Named("type_params"),
        Many(Named("field_decl"), sep=Lit(","), nested_in=braces(), spaced=true),
    ]);
    let field_decl: Rule<AiplTok> = Then([
        Term(Name),
        Lit(":"),
        Named("ty"),
        Maybe(Then([Lit("="), Named("expr")])),
    ]);

    // `variant V = | A | B(i64)` — a leading `|` is allowed and means nothing,
    // which is what lets the formatter align every case under one column.
    // The cases are a `|`-separated list that may open with a `|` — the shape
    // the formatter gives it once it breaks one case per line. A case's `# ..`
    // lines sit above its `|`, so they ride with the separator rather than
    // with the case: the separator is "doc lines, then `|`", and
    // `lower_variant_decl` hands each run of lines to the case that follows
    // it. A documented first case therefore has a `|`, as the formatter writes
    // it; doc lines after the last case are the next item's, since no `|`
    // follows them.
    let variant_decl: Rule<AiplTok> = Then([
        Lit("variant"),
        Term(Name),
        Named("type_params"),
        Lit("="),
        Many(
            Named("variant_case"),
            min=1,
            sep=Then([Many(Term(DocComment)), Lit("|")]),
            trailing_sep=false,
            leading_sep=true,
        ),
    ]);

    // `variant W = V without C` — a variant with cases left out, named. The
    // type is a `ty_core` (a name, with its type arguments) and the `without`
    // is spelled here rather than through `ty`: `ty` would also take a lone
    // `A`, and a one-case variant must stay one. The core rather than a whole
    // `ty_head` keeps `variant V = A B` from also expecting every suffix a type
    // can take.
    let refinement_decl: Rule<AiplTok> = Then([
        Lit("variant"),
        Term(Name),
        Named("type_params"),
        Lit("="),
        Named("ty_core"),
        Lit("without"),
        Named("exclusion"),
    ]);
    let variant_case: Rule<AiplTok> = OneOf([
        Then([
            Term(Name),
            Many(Named("case_param"), min=1, sep=Lit(","), trailing_sep=false, nested_in=parens()),
        ]),
        Term(Name),
    ]);

    // A payload slot takes `# ..` lines of its own, above it inside the
    // parentheses — `Many(rule, min, max, ..)` has ten slots, and what each
    // means is the slot's business rather than the case's. Then the three
    // slot shapes, and the bare type last: a type *is* an `IDENT`, so the
    // named forms have to be given their chance first.
    let case_param: Rule<AiplTok> = Then([
        Many(Term(DocComment)),
        OneOf([
            // Before the bare `ty` alternative, which would otherwise take the
            // `Name` and leave the `?` — `Circle(i64?)` against
            // `Many(max?: u64 = none)` is the ordering this rule exists to settle.
            Then([Term(Name), Lit("?"), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
            Then([Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
            Then([Term(Name), Lit(":"), Named("ty")]),
            Named("ty"),
        ]),
    ]);

    [
        p("program", program, TryMk(lower_program)),
        pl("item", item, "an item", TryMk(lower_item)),
        p("import_decl", import_decl, TryMk(lower_import_decl)),
        p("const_decl", const_decl, TryMk(lower_const_decl)),
        pl("import_name", import_name, "an import name", TryMk(lower_import_name)),
        p("operator", operator, Text(AName)),
        p("function", function, TryMk(lower_function)),
        pl("effect", effect, "an effect", Mk(lower_effect)),
        p("type_params", type_params, TryMk(lower_type_params)),
        p("type_param", type_param, TryMk(lower_type_param)),
        pl("param", param, "a parameter", TryMk(lower_param)),
        p("fn_body", fn_body, TryMk(lower_fn_body)),
        pl("construct_fields", construct_fields, "a field", TryMk(lower_construct_fields)),
        p("fn_attr", fn_attr, TryMk(lower_fn_attr)),
        p("test_block", test_block, TryMk(lower_test_block)),
        p("test_body", test_body, TryMk(lower_test_body)),
        p("test_tail", test_tail, TryMk(lower_test_tail)),
        p("struct_decl", struct_decl, TryMk(lower_struct_decl)),
        p("field_decl", field_decl, TryMk(lower_field_decl)),
        p("refinement_decl", refinement_decl, TryMk(lower_refinement_decl)),
        p("variant_decl", variant_decl, TryMk(lower_variant_decl)),
        p("variant_case", variant_case, TryMk(lower_variant_case)),
        p("case_param", case_param, TryMk(lower_case_param)),
    ]
}

// ---------- types ----------

fn types() -> Production<AiplTok, Ast>[] {
    // The parenthesized list the four `(`-led forms share, given a production of
    // its own. It removes the duplication — which is worth keeping on its own
    // merits, and is what wanting to format the grammar first turned up.
    //
    // It no longer has to be its own production to be formattable: a group
    // carries its own style, so four bracketed alternatives in one production
    // are four groups rather than a shape with no single pair to describe.
    let ty_parens: Rule<AiplTok> = Many(
        Named("ty"),
        sep=Lit(","),
        trailing_sep=false,
        nested_in=parens(),
    );

    // A type is a head — one of the forms below — optionally refined by a
    // trailing `without X`. The clause binds looser than every suffix, so
    // `T[] without []` refines the array and a refined optional is written
    // `(T[] without [])?`; a one-element paren list is that grouping.
    let ty: Rule<AiplTok> = Then([
        Named("ty_head"),
        Maybe(Then([Lit("without"), Named("exclusion")])),
    ]);

    // What a `without` clause excludes: the empty array, or the name of a case.
    // A further kind of exclusion is another alternative here and another
    // `Exclusion` case, not a change to `ty`.
    let exclusion: Rule<AiplTok> = OneOf([Then([Lit("["), Lit("]")]), Term(Name)]);

    // The `(`-led forms are ordered longest-first, since every one of them
    // opens the same way: `(A, B) -> R` over `(A, B)[]` over `(A, B)!E` over
    // `(A, B)`.
    let ty_head: Rule<AiplTok> = OneOf([
        Then([Named("ty_parens"), Lit("->"), Named("ty")]),
        Then([Named("ty_parens"), Lit("["), Lit("]")]),
        // A result: `A!E`, `(A, B)!E`, or the void `!E`. One alternative, with
        // the ok side optional — `lower_ty` reads a lone kid after a `!` as
        // the unit ok side. Ahead of the bare forms because a `!` after a
        // type is the longer match, and the optional ok side simply fails to
        // find its `!` on a type that has none.
        Then([Maybe(OneOf([Named("ty_parens"), Named("base_ty")])), Lit("!"), Named("base_ty")]),
        // `(A, B)?` — an optional tuple. Before the bare `ty_parens` for the
        // same reason the other suffixed forms are: ordered choice takes the
        // first match, so the longer form has to be tried first.
        Then([Named("ty_parens"), Lit("?")]),
        Named("ty_parens"),
        Named("base_ty"),
    ]);
    // Left-recursive postfix under LR; here a core followed by its suffixes.
    let base_ty: Rule<AiplTok> = Then([
        Named("ty_core"),
        Many(OneOf([Lit("?"), Then([Lit("["), Lit(","), Lit("]")]), Then([Lit("["), Lit("]")])])),
    ]);

    // `#{T}` a set, `#{K: V}` a dict, `#>{T}` / `#<{T}` an ordered set —
    // largest first / smallest first.
    let ty_core: Rule<AiplTok> = OneOf([
        nest2("#", "{", Then([Named("ty"), Lit(":"), Named("ty")]), "}", strict()),
        nest2("#", "{", Named("ty"), "}", strict()),
        nest3("#", ">", "{", Named("ty"), "}", strict()),
        nest3("#", "<", "{", Named("ty"), "}", strict()),
        Then([
            Term(Name),
            Many(Named("ty"), min=1, sep=Lit(","), trailing_sep=false, nested_in=angles()),
        ]),
        Term(Name),
    ]);

    [
        pl("ty", ty, "a type", TryMk(lower_ty)),
        p("ty_head", ty_head, TryMk(lower_ty_head)),
        // The excluded `[]` is written against itself, like an array suffix.
        pt("exclusion", exclusion, TryMk(lower_exclusion)),
        // Type position takes no trailing comma even when a list breaks — the
        // grammar says so twice, once with `trailing_sep: false` to the parser
        // and once with `strict()` to the printer.
        p("ty_parens", ty_parens, TryMk(lower_ty_parens)),
        // A core and its `?`/`[]` suffixes are written against each other.
        pt("base_ty", base_ty, TryMk(lower_base_ty)),
        // Three bracket pairs across three alternatives — `#{k: v}`, `#{k}` and
        // `Name<A, B>` — and the fourth alternative has none. Each pair carries
        // its own style, so nothing here has to hold for the production as a
        // whole, and the bare-`Name` alternative simply has no group in it.
        p("ty_core", ty_core, TryMk(lower_ty_core)),
    ]
}

// ---------- statements ----------

fn statements() -> Production<AiplTok, Ast>[] {
    // Right-recursive on purpose: after one expression the parser decides
    // whether a `;` made it a statement or its absence made it the block's
    // value, so the expression is parsed exactly once.
    let block: Rule<AiplTok> = one(Named("block_body"), nested_in=braces());
    let block_body: Rule<AiplTok> = Maybe(OneOf([
        Then([Named("kw_stmt"), Named("block_body")]),
        Then([Named("expr"), Named("block_tail")]),
    ]));

    //
    // The second alternative of `semicolon` is the one failure this position has
    // a better word for than "expected `;`, `}`, or an operator": a token that
    // opens a new statement, straight after an expression. The expression is
    // nearly always an `if` or `match` used for its effect, whose closing `}`
    // reads as the end of a statement in every language with a block form.
    let semicolon: Rule<AiplTok> = OneOf([
        Lit(";"),
        Then([Named("statement_start"), Refuse(Fn(missing_semicolon))]),
    ]);
    let block_tail: Rule<AiplTok> = Maybe(Then([semicolon, Named("block_body")]));

    // Only a token that can *only* begin a statement. `(`, `[`, `-`, `!` and `|`
    // also continue the expression before them (a call, an index, a binary
    // minus), so they stay the expression's and are not diagnosed here.
    let statement_start: Rule<AiplTok> = OneOf([
        Term(Name),
        Term(IntLit),
        Term(StrLit),
        Term(CharTok),
        Lit("let"),
        Lit("mut"),
        Lit("set"),
        Lit("for"),
        Lit("while"),
        Lit("return"),
        Lit("if"),
        Lit("match"),
        Lit("shim"),
        Lit("true"),
        Lit("false"),
        Lit("none"),
    ]);

    // A loop body admits no trailing expression: its value could never be
    // observed, so every expression in it must be an `expr;` statement.
    let loop_body: Rule<AiplTok> = one(Named("loop_inner"), nested_in=braces());
    let loop_inner: Rule<AiplTok> = Maybe(OneOf([
        Then([Named("kw_stmt"), Named("loop_inner")]),
        Then([Named("expr"), Expect(semicolon), Named("loop_inner")]),
    ]));

    // Keyword-led statements, so their first tokens stay disjoint from `expr`'s
    // and the block's choice above is a single-token decision.
    let kw_stmt: Rule<AiplTok> = OneOf([
        Named("let_stmt"),
        Named("mut_stmt"),
        Named("assign_stmt"),
        Named("for_stmt"),
        Named("while_stmt"),
        Named("return_stmt"),
    ]);
    let tuple_binders: Rule<AiplTok> = Many(
        Term(Name),
        min=1,
        sep=Lit(","),
        trailing_sep=false,
        nested_in=parens(),
    );
    let bind_target: Rule<AiplTok> = OneOf([
        tuple_binders,
        Then([Term(Name), field_binders()]),
        Then([Term(Name), arm_binders()]),
        Term(Name),
    ]);
    let let_stmt: Rule<AiplTok> = OneOf([
        Then([
            Lit("let"),
            OneOf([tuple_binders, Then([Term(Name), field_binders()]), Term(Name)]),
            Lit("="),
            Named("expr"),
            Maybe(Then([Lit("else"), Named("block")])),
            Expect(Lit(";")),
        ]),
        // A case pattern, whose slots are patterns: `let Import(decl) = e;`,
        // `let Some(Point { x, y }) = e else { .. };`.
        Then([
            Lit("let"),
            Term(Name),
            case_payload(),
            Lit("="),
            Named("expr"),
            Maybe(Then([Lit("else"), Named("block")])),
            Expect(Lit(";")),
        ]),
        Then([
            Lit("let"),
            Term(Name),
            Lit(":"),
            Named("ty"),
            Lit("="),
            Named("expr"),
            Expect(Lit(";")),
        ]),
        // An array pattern, as a `match` arm writes one.
        Then([
            Lit("let"),
            Many(Named("pattern"), sep=Lit(","), nested_in=brackets(), style=loose()),
            Lit("="),
            Named("expr"),
            Lit("else"),
            Named("block"),
            Expect(Lit(";")),
        ]),
        // Any other pattern a `match` arm takes, for the forms above that do not:
        // `let (some(a), b) = e else { .. };`, `let (Point { x }, n) = e;`. Reached
        // only when those alternatives failed on the pattern, before any
        // expression was read.
        Then([
            Lit("let"),
            Named("pattern"),
            Lit("="),
            Named("expr"),
            Maybe(Then([Lit("else"), Named("block")])),
            Expect(Lit(";")),
        ]),
    ]);
    let mut_stmt: Rule<AiplTok> = OneOf([
        Then([Lit("mut"), Term(Name), field_binders(), Lit("="), Named("expr"), Expect(Lit(";"))]),
        Then([
            Lit("mut"),
            Term(Name),
            Lit(":"),
            Named("ty"),
            Lit("="),
            Named("expr"),
            Expect(Lit(";")),
        ]),
        Then([Lit("mut"), Term(Name), Lit("="), Named("expr"), Expect(Lit(";"))]),
    ]);

    // `set t = e;`, the increment/decrement sugar, the four compound
    // assignments, and the mutating-method writeback — each on a target that is
    // a name or a `.`-led field path through one (`set p.n++`, `set p.xs.push(x)`).
    // The path is one greedy run of names, so the method form's member is the
    // path's last segment and the `(` after it is what tells the forms apart;
    // `lower_assign_stmt` splits it back off.
    let assign_target: Rule<AiplTok> = Many(Term(Name), min=1, sep=Lit("."), trailing_sep=false);
    let assign_stmt: Rule<AiplTok> = OneOf([
        Then([Lit("set"), assign_target, Lit("++"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("--"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("+="), Named("expr"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("-="), Named("expr"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("*="), Named("expr"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("/="), Named("expr"), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, nest("(", Named("args"), ")", loose()), Expect(Lit(";"))]),
        Then([Lit("set"), assign_target, Lit("="), Named("expr"), Expect(Lit(";"))]),
        Then([
            Lit("set"),
            assign_target,
            one(
                OneOf([Then([Named("expr"), Lit(","), Named("expr")]), Named("expr")]),
                nested_in=brackets(),
            ),
            Lit("="),
            Named("expr"),
            OneOf([
                Then([Lit("else"), Named("block"), Expect(Lit(";"))]),
                Refuse(Msg(unhandled_index_write())),
            ]),
        ]),
    ]);

    // The four `for` shapes, told apart after `for ( let` by one token: `(` is
    // the tuple form, a `,` after the name the indexed form — and after that
    // comma, `(` again is the indexed tuple form.
    let for_stmt: Rule<AiplTok> = OneOf([
        Then([
            Lit("for"),
            one(Then([Lit("let"), bind_target, Lit(":"), Named("expr")]), nested_in=parens()),
            Named("loop_body"),
        ]),
        Then([
            Lit("for"),
            one(
                Then([Lit("let"), Term(Name), Lit(","), bind_target, Lit(":"), Named("expr")]),
                nested_in=parens(),
            ),
            Named("loop_body"),
        ]),
    ]);
    let while_stmt: Rule<AiplTok> = Then([
        Lit("while"),
        one(Named("expr"), nested_in=parens()),
        Named("loop_body"),
    ]);
    let return_stmt: Rule<AiplTok> = Then([Lit("return"), Named("expr"), Expect(Lit(";"))]);

    [
        p("block", block, TryMk(lower_block)),
        p("block_body", block_body, TryMk(lower_block_body)),
        p("block_tail", block_tail, TryMk(lower_block_tail)),
        // Labelled "`;`" so a token that is no statement's start leaves the
        // "expected" list as it was: `semicolon` already expects exactly that, and
        // the label dedups against it. The node is never built; its only use is
        // to be followed by the refusal.
        pl("statement_start", statement_start, "`;`", Kid),
        // `loop_body` passes its `loop_inner` through, and is deliberately
        // *not* repaired the way `block` is. A loop body's value is discarded,
        // so no diagnostic ever points at the synthetic `0` an empty one
        // lowers to; and that `0`'s empty span is load-bearing elsewhere: the
        // loop lints recognize the body's tail by exactly it (`is_block_tail`
        // in `aipl-syntax`'s lint driver), which is how they know a body holds
        // one statement and nothing after it. Giving the `0` a location
        // switched every one of them off.
        p("loop_body", loop_body, Kid),
        p("loop_inner", loop_inner, TryMk(lower_loop_inner)),
        // `kw_stmt` is the six statement productions behind one name, so a
        // block's choice between a statement and an expression stays a
        // single-token decision. Every alternative is a reference, so the node
        // is exactly the statement that matched.
        pl("kw_stmt", kw_stmt, "a statement", Kid),
        p("let_stmt", let_stmt, TryMk(lower_let_stmt)),
        p("mut_stmt", mut_stmt, TryMk(lower_mut_stmt)),
        p("assign_stmt", assign_stmt, TryMk(lower_assign_stmt)),
        p("for_stmt", for_stmt, TryMk(lower_for_stmt)),
        p("while_stmt", while_stmt, TryMk(lower_while_stmt)),
        p("return_stmt", return_stmt, TryMk(lower_return_stmt)),
    ]
}

// ---------- expressions ----------

fn expressions() -> Production<AiplTok, Ast>[] {
    // `op_precedence`'s table, `..` included at level 4 — tighter than `==`,
    // looser than `<` and the arithmetic. Every level is left-associative.
    let expr: Rule<AiplTok> = Climb(
        Named("unary"),
        [
            Prec { power: 1, right: false, ops: ["||"] },
            Prec { power: 2, right: false, ops: ["&&"] },
            Prec { power: 3, right: false, ops: ["==", "!="] },
            Prec { power: 4, right: false, ops: [".."] },
            Prec { power: 5, right: false, ops: ["<", ">", "<=", ">="] },
            Prec { power: 6, right: false, ops: ["+", "+++", "-"] },
            Prec { power: 7, right: false, ops: ["*", "/", "%"] },
        ],
    );
    let unary: Rule<AiplTok> = OneOf([
        Then([Lit("-"), Named("unary")]),
        Then([Lit("!"), Named("unary")]),
        Named("postfix"),
    ]);
    let postfix: Rule<AiplTok> = Then([Named("atom"), Many(Named("suffix"))]);

    // The method call comes before the field access — both open `. IDENT` — and
    // the two open-ended slices before the plain index.
    let suffix: Rule<AiplTok> = OneOf([
        // The type arguments of `.name::<A, B>(args)`: written between the angles
        // as they are in a generic type, and then the call's own arguments.
        Then([
            Lit("."),
            Term(Name),
            Lit("::"),
            Many(Named("ty"), min=1, sep=Lit(","), trailing_sep=false, nested_in=angles()),
            nest("(", Named("args"), ")", loose()),
        ]),
        Then([Lit("."), Term(Name), nest("(", Named("args"), ")", loose())]),
        Then([Lit("."), Term(Name)]),
        Then([Lit("."), Term(IntLit)]),
        // The four index forms are bracket pairs, not lists: `a[..b]` holds one
        // expression and a `..`, and there is nothing in it to break at.
        Then([one(Then([Lit(".."), Named("expr")]), nested_in=brackets())]),
        Then([one(Then([Named("expr"), Lit("..")]), nested_in=brackets())]),
        Then([one(Then([Named("expr"), Lit(","), Named("expr")]), nested_in=brackets())]),
        Then([one(Named("expr"), nested_in=brackets())]),
        // `$` maps the step after it over the receiver — `v$name`, `v$0`,
        // `v$name(args)` — as the three member forms above do for a single value.
        Then([Lit("$"), Term(Name), nest("(", Named("args"), ")", loose())]),
        Then([Lit("$"), Term(Name)]),
        Then([Lit("$"), Term(IntLit)]),
        Lit("?"),
    ]);

    let atom: Rule<AiplTok> = OneOf([
        Then([
            Lit("if"),
            one(Then([Lit("let"), Named("pattern"), Lit("="), Named("expr")]), nested_in=parens()),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Then([
            Lit("if"),
            one(Named("expr"), nested_in=parens()),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        // Two bracket pairs in one alternative, with different styles: the
        // scrutinee's parentheses are a pair and nothing more, the arms are a
        // comma-separated list that breaks. A single layout on the production
        // could not have said both, which is the shape that made a production
        // the wrong place to say it.
        // The scrutinee may be several expressions — `match (min, max)` — which
        // is a tuple scrutinee without the tuple's own parentheses.
        Then([
            Lit("match"),
            one(Many(Named("expr"), min=1, sep=Lit(","), trailing_sep=false), nested_in=parens()),
            Many(Named("match_arm"), sep=Lit(","), nested_in=braces(), spaced=true),
        ]),
        // A bracketed list that is neither the start nor the end of its
        // alternative — the shape a leading/trailing token scan cannot see at
        // all, since this one ends in a block.
        Then([
            Lit("shim"),
            Term(Name),
            Many(Named("shim_binding"), sep=Lit(","), nested_in=braces(), spaced=true),
            Named("block"),
        ]),
        // `shim <effect> { provider } { body }`: the same shim, with the
        // bindings supplied by whatever provider the first block evaluates to.
        // Tried after the bindings form, which a block cannot be mistaken for:
        // a binding is `name = name` and no statement begins that way.
        Then([Lit("shim"), Term(Name), Named("block"), Named("block")]),
        // `shim <effect> <provider>(args) { body }`: the same shim, with the
        // bindings supplied by a named provider. The token after the effect is
        // what tells the two forms apart.
        Then([
            Lit("shim"),
            Term(Name),
            Term(Name),
            nest("(", Named("args"), ")", loose()),
            Named("block"),
        ]),
        Term(IntLit),
        Term(StrLit),
        Term(CharTok),
        Lit("true"),
        Lit("false"),
        Lit("none"),
        // `name::<A, B>(args)` — a call with its type arguments written out.
        Then([
            Term(Name),
            Lit("::"),
            Many(Named("ty"), min=1, sep=Lit(","), trailing_sep=false, nested_in=angles()),
            nest("(", Named("args"), ")", loose()),
        ]),
        Then([Term(Name), nest("(", Named("args"), ")", loose())]),
        Then([
            Term(Name),
            Many(Named("field_init"), sep=Lit(","), nested_in=braces(), spaced=true),
        ]),
        Term(Name),
        // A tuple literal takes a trailing comma like every other comma list,
        // and prints one when it breaks — `loose()`, not `strict()`. The two
        // have to agree: the printer writing a separator the parser refuses is
        // a formatter that emits source it cannot read back.
        nest(
            "(",
            Then([Named("expr"), Lit(","), Many(Named("expr"), min=1, sep=Lit(","))]),
            ")",
            loose(),
        ),
        // A grouping paren holds one expression, so there is no list in it.
        one(Named("expr"), nested_in=parens()),
        nest("[", Named("args"), "]", loose()),
        nest2("#", "{", Named("brace_body"), "}", loose()),
        nest3("#", ">", "{", Named("brace_body"), "}", loose()),
        nest3("#", "<", "{", Named("brace_body"), "}", loose()),
        Named("template"),
        // The same token opens and closes this one, which is the case a scan for
        // a leading and a trailing run of tokens could never tell from a list.
        Then([
            Many(Named("lambda_param"), sep=Lit(","), trailing_sep=false, nested_in=pipes()),
            Named("block"),
        ]),
    ]);

    // `else` takes a block or another `if` — never an arbitrary expression, so
    // an if/else-if ladder is the only brace-less `else` form.
    let else_branch: Rule<AiplTok> = OneOf([
        Then([
            Lit("if"),
            one(Then([Lit("let"), Named("pattern"), Lit("="), Named("expr")]), nested_in=parens()),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Then([
            Lit("if"),
            one(Named("expr"), nested_in=parens()),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Named("block"),
    ]);

    // `` `text {expr} text` `` — the delimiters, the braces and each run of
    // text are their own tokens, so this is the literal read straight off.
    //
    // Every text is optional because the lexer emits none for an empty one: its
    // `UpToAny` declines at a stop, and the brace or delimiter there wins. So
    // `` `{x}` `` is open, brace, expr, brace, close — and the lowering fills the
    // two empty slots back in.
    //
    // One rule covers both flavours: `TemplateOpen` carries which one it is, and the
    // mode stack already guaranteed the close matches the open.
    let template: Rule<AiplTok> = Then([
        Term(TemplateOpen),
        Maybe(Term(TemplateText)),
        Many(Then([Lit("{"), Named("expr"), Lit("}"), Maybe(Term(TemplateText))])),
        Term(TplClose),
    ]);

    // What an operation is bound to is a function's name, which lowers to a plain
    // binding, or a closure: the lambda forms an argument can be.
    let shim_binding: Rule<AiplTok> = Then([
        Term(Name),
        Lit("="),
        OneOf([Named("expr"), Named("lambda")]),
    ]);
    let args: Rule<AiplTok> = Many(Named("arg"), sep=Lit(","));

    // The spread and the keyword argument lead with tokens no expression can, so
    // both must be tried before `expr` — after which a bare operator value and a
    // lambda are unambiguous too.
    let arg: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr")]),
        // `k?=v` — forwarding an optional into a `k?: T` parameter, which is
        // otherwise supplied as a bare `T`. Tried before the plain keyword
        // argument, whose `=` would not match the `?`.
        Then([Term(Name), Lit("?"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit("="), Named("expr")]),
        Named("lambda"),
        Named("op_value"),
        Named("expr"),
    ]);

    // The operators that may be passed as values. Narrower than the importable
    // set: `-` and `!` are unary too, and a value has no operand to tell which
    // spelling was meant.
    let op_value: Rule<AiplTok> = OneOf([
        Lit("+++"),
        Lit("=="),
        Lit("!="),
        Lit("<="),
        Lit(">="),
        Lit("&&"),
        Lit("+"),
        Lit("*"),
        Lit("/"),
        Lit("%"),
    ]);
    let lambda: Rule<AiplTok> = OneOf([
        Then([
            Many(Named("lambda_param"), sep=Lit(","), trailing_sep=false, nested_in=pipes()),
            Named("expr"),
        ]),
        Then([Lit("||"), Named("block")]),
        Then([Lit("||"), Named("expr")]),
    ]);
    let lambda_param: Rule<AiplTok> = Then([Term(Name), Maybe(Then([Lit(":"), Named("ty")]))]);

    let field_init: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("expr")]),
        Term(Name),
    ]);

    // `#{a, b}` a set, `#{k: v}` a dict, `#{}` either — an empty brace pair says
    // nothing about which it is, so it takes its type from the use site. One
    // rule for all three, so `expr` is reachable from a single place under the
    // brace.
    let brace_body: Rule<AiplTok> = Maybe(Many(Named("entry"), min=1, sep=Lit(",")));

    // A `..` entry spreads a set into a set literal; `brace_literal` refuses one in
    // a dict.
    let entry: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr")]),
        Then([Named("expr"), Maybe(Then([Lit(":"), Named("expr")]))]),
    ]);

    [
        pl("expr", expr, "an expression", TryMk(lower_expr)),
        p("unary", unary, TryMk(lower_unary)),
        p("postfix", postfix, TryMk(lower_postfix)),
        p("suffix", suffix, TryMk(lower_suffix)),
        p("atom", atom, TryMk(lower_atom)),
        p("else_branch", else_branch, TryMk(lower_else_branch)),
        p("template", template, TryMk(lower_template)),
        p("shim_binding", shim_binding, TryMk(lower_shim_binding)),
        p("args", args, TryMk(lower_args)),
        p("arg", arg, TryMk(lower_arg)),
        p("op_value", op_value, Mk(lower_op_value)),
        p("lambda", lambda, TryMk(lower_lambda)),
        p("lambda_param", lambda_param, TryMk(lower_lambda_param)),
        p("field_init", field_init, TryMk(lower_field_init)),
        p("brace_body", brace_body, TryMk(lower_brace_body)),
        p("entry", entry, TryMk(lower_entry)),
    ]
}

// ---------- patterns ----------

fn patterns() -> Production<AiplTok, Ast>[] {
    // An alternation of two or more patterns comes first: a single pattern is
    // the standalone arm, and after one pattern the next token (`=>` or `|`) is
    // what tells them apart.
    let match_arm: Rule<AiplTok> = OneOf([
        Then([
            Many(Named("pattern"), min=2, sep=Lit("|"), trailing_sep=false),
            Lit("=>"),
            Named("arm_body"),
        ]),
        Then([
            Many(Named("pattern"), sep=Lit(","), nested_in=brackets(), style=loose()),
            Lit("=>"),
            Named("arm_body"),
        ]),
        Then([Named("pattern"), Lit("=>"), Named("arm_body")]),
    ]);
    let arm_body: Rule<AiplTok> = OneOf([Named("block"), Named("expr")]);

    // A pattern nests: a constructor's slots and a tuple's elements are
    // patterns themselves, so `(1, some(x))` reads as it is written.
    let pattern: Rule<AiplTok> = OneOf([
        Then([
            Term(Name),
            Lit("."),
            Term(Name),
            Maybe(nest("(", Named("ctor_payload"), ")", strict())),
        ]),
        Then([Term(Name), nest("(", Named("ctor_payload"), ")", strict())]),
        // A struct pattern, which always matches: `T { a, b as c }`.
        Then([Term(Name), field_binders()]),
        Term(Name),
        Lit("none"),
        Term(StrLit),
        // A backtick literal is a run of tokens, so a pattern spells one out
        // rather than naming a kind. With no braces in it there is nothing to
        // interpolate — which is the only form a pattern can hold, since a
        // pattern matches a value and an interpolation computes one.
        Then([Term(TemplateOpen), Maybe(Term(TemplateText)), Term(TplClose)]),
        Term(CharTok),
        Term(IntLit),
        nest("(", Many(Named("pattern"), min=2, sep=Lit(","), trailing_sep=false), ")", strict()),
        // `..` is only a pattern at the end of an array arm's elements — `[a, ..]`
        // — where it says "and more". It is a pattern here so the elements are one
        // list, and `as_pat` refuses it everywhere that is not that end.
        Lit(".."),
    ]);

    // `Ctor(p, q)` matches each slot against a pattern; `Ctor(..)` says the
    // case carries a payload this arm does not read.
    let ctor_payload: Rule<AiplTok> = OneOf([
        Lit(".."),
        Many(Named("pattern"), min=1, sep=Lit(","), trailing_sep=false),
    ]);

    [
        p("match_arm", match_arm, TryMk(lower_match_arm)),
        p("arm_body", arm_body, Kid),
        pl("pattern", pattern, "a pattern", TryMk(lower_pattern)),
        p("ctor_payload", ctor_payload, TryMk(lower_ctor_payload)),
    ]
}

// ---------- lowering: expressions ----------
//
// The third slice, and the one the rest of the grammar waits on: statements
// lower to expressions too, and every item that carries a default holds one.
//
// Three things here are *desugarings* rather than translations — the AST has no
// node for them, because the language stops having them at this point:
//
//   - **An operator is a call on its spelling.** `a + b` is `+(a, b)`, `!x` is
//     `!(x)`, and an operator passed as a value is a two-parameter lambda whose
//     body is that call. Nothing downstream can tell an operator was written.
//   - **A range is a construct.** `a..b` builds the builtin `Span`. No name is
//     written, so no import is needed — which is why the desugar has to happen
//     here rather than in the loader.
//   - **A template is a concat chain.** Each interpolation goes through
//     `__template_interp` and the pieces through `__aipl_concat`, folded from
//     the tail backwards so the tree matches the one the right-recursive
//     `template_rest` produces.
//
// A `suffix` and a `#{ .. }` entry get `Ast` cases of their own (`ASuffix`,
// `AEntry`) because neither is an expression on its own: a suffix has no
// receiver yet, and an entry is not known to be a set element or a dict pair
// until the whole body is in scope.

# The span a lowered node takes: this node's *tokens*, with the trivia in front
# of the first one left out. `span` reaches back over that trivia, which is what
# losslessness needs and the opposite of what a diagnostic wants.
# The tight token span of an interior child, which a lowering holds as a bare
# `Cst` rather than as the `Parts` its own node arrives as. The counterpart of
# `tok_span`, which answers the same question about the node itself.
fn child_span(self: Cst) -> Span {
    match (self.token_span()) {
        some(sp) => sp,
        none => self.extent(),
    }
}

# The token span of interior child `i`, for the nodes whose parts want their own
# spans — a match arm's pattern, one step of a postfix chain.
fn sub_span(subs: Cst[], i: u64, fallback: Span) -> Span { subs[i]$child_span().value_or(fallback) }

fn as_expr(v: Ast, span: Span) -> Expr!ParseError {
    if (let AExpr(e) = v) {
        return ok(e);
    };
    err(wrong_kind("an expression", v, span))
}

fn as_exprs(v: Ast, span: Span) -> Expr[]!ParseError {
    if (let AExprs(es) = v) {
        return ok(es);
    };
    err(wrong_kind("a list of expressions", v, span))
}

fn as_suffix(v: Ast, span: Span) -> Suffix!ParseError {
    if (let ASuffix(suf) = v) {
        return ok(suf);
    };
    err(wrong_kind("a postfix suffix", v, span))
}

fn as_field_init(v: Ast, span: Span) -> FieldInit!ParseError {
    if (let AFieldInit(fi) = v) {
        return ok(fi);
    };
    err(wrong_kind("a field initializer", v, span))
}

fn as_lambda_param(v: Ast, span: Span) -> LambdaParam!ParseError {
    if (let ALambdaParam(lp) = v) {
        return ok(lp);
    };
    err(wrong_kind("a lambda parameter", v, span))
}

fn as_entry(v: Ast, span: Span) -> BraceEntry!ParseError {
    if (let AEntry(e) = v) {
        return ok(e);
    };
    err(wrong_kind("a brace-literal entry", v, span))
}

fn as_entries(v: Ast, span: Span) -> BraceEntry[]!ParseError {
    if (let AEntries(es) = v) {
        return ok(es);
    };
    err(wrong_kind("a list of brace-literal entries", v, span))
}

fn as_arms(v: Ast, span: Span) -> MatchArm[]!ParseError {
    if (let AArms(arms) = v) {
        return ok(arms);
    };
    err(wrong_kind("a list of match arms", v, span))
}

# A shim binding: the operation, the name of the function it is bound to, and the
# closure that function is made of, when it is bound to one. A closure is bound
# under a name of its own, so everything after the parser sees every binding as the
# name of a function.
struct ShimTarget { op: str, name: str, closure: Expr? }

fn as_bind(v: Ast, span: Span) -> ShimTarget!ParseError {
    if (let AShimBind(op, f) = v) {
        return ok(ShimTarget { op, name: f, closure: none });
    };
    if (let AShimClosure(op, closure) = v) {
        return ok(ShimTarget {
            op,
            name: `$shimfn${op}${closure.span.start}`,
            closure: some(closure),
        });
    };
    err(wrong_kind("a shim binding", v, span))
}

# Child `i` as an expression, which most of this file wants.
fn kid_expr(kids: Ast[], i: u64, span: Span) -> Expr!ParseError {
    as_expr(kid(kids, i, span)?, span)
}

# `expr` — the `Climb` node. A bare operand climbed to itself has one interior
# child and no token of its own; an application has two children with its
# operator as a direct leaf between them.
fn lower_expr(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let lhs = kid_expr(kids, 0, sp)?;
    if (kids.len() != 2) {
        return ok(AExpr(lhs));
    };
    let rhs = kid_expr(kids, 1, sp)?;
    let tsp = node.tok_span();
    let op = node.own_token_text(src);
    if (op == "..") {
        return ok(AExpr(at(
            Construct(
                "__builtin_Span",
                [FieldInit { name: "start", value: lhs }, FieldInit { name: "end", value: rhs }],
            ),
            tsp,
        )));
    };
    ok(AExpr(at(Call(op, [lhs, rhs], false), tsp)))
}

# `unary` — `-x`, `!x`, or the postfix it wraps. Unary `-` is the one operator
# with no named builtin to resolve to, so it stays a node of its own; `!` is an
# ordinary call like every other operator.
fn lower_unary(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let inner = kid_expr(kids, 0, sp)?;
    let tsp = node.tok_span();
    let op = node.own_token_text(src);
    if (op == "-") {
        return ok(AExpr(at(Neg(inner), tsp)));
    };
    if (op == "!") {
        return ok(AExpr(at(Call("!", [inner], false), tsp)));
    };
    ok(AExpr(inner))
}

# `postfix` — an atom and the run of suffixes applied to it, left to right, each
# step spanning from the atom's start to that suffix's end.
fn lower_postfix(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let subs = node.children;
    mut e = kid_expr(kids, 0, sp)?;
    for (let i, k : kids[1..]) {
        let suf = as_suffix(k, sp)?;
        let end = sub_span(subs, i + 1, e.span);
        set e = apply_suffix(e, suf, join_spans(e.span, end));
    }
    ok(AExpr(e))
}

# What follows a callee's name in `name::<A, B>(args)`: the types between the
# angles and then the argument list. They arrive as the call's children in that
# order, the arguments last.
struct TypedCall { tys: Ty[], args: Expr[] }

fn typed_call(kids: Ast[], sp: Span) -> TypedCall!ParseError {
    let last = kids
        .last()
        .value_or_err(ParseError { message: "a typed call has no argument list", span: sp })?;
    ok(TypedCall {
        tys: kids[..kids.len() - 1].try_map(|k| as_ty(k, sp))?,
        args: no_spread(as_exprs(last, sp)?, "a call argument list")?,
    })
}

# `suffix` — the seven postfix steps. `.` opens the three member forms, `[` the
# three bracket forms, and `?` is the whole of the seventh.
fn lower_suffix(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();

    // The seven steps are seven distinct runs of positions, brackets included,
    // so the shape alone says which one matched. That settles the two slice
    // forms in particular: `a[..b]` puts its operand third and `a[b..]` second,
    // where reading it off the source meant comparing the `..`'s start against
    // the operand's to find which side it sat on.
    // `.name::<A, B>(args)` has as many type children as it was given types, so
    // no slot pattern can name its shape; the `::` after the name does.
    match (node.own_texts(src)) {
        ["$", ..] => ok(ASuffix(map_step(src, node, kids, sp)?)),
        [_, _, "::", ..] => {
            let TypedCall { tys, args } = typed_call(kids, sp)?;
            ok(ASuffix(SufMethodTyped(span_str(src, node.second_tok(sp)), tys, args)))
        },
        _ => suffix_by_shape(src, node, kids, sp),
    }
}

# The suffix forms that carry no token of their own to tell them apart: `?`, a
# field, `.name(args)` and the bracket forms, by the shape of the positions.
fn suffix_by_shape(src: str, node: Parts, kids: Ast[], sp: Span) -> Ast!ParseError {
    match (node.slots()) {
        // `?`
        [Tok(_)] => ok(ASuffix(SufTry)),
        // `.name`, and `.0` — a tuple slot, which `field_name` spells `_0`.
        [Tok(_), name] => ok(ASuffix(SufField(field_name(slot_name(name, src, sp), sp)?))),
        // `[row, column]`
        [Tok(_), Sub(_), Tok(_), Sub(_), Tok(_)] => ok(ASuffix(SufIndex2(
            kid_expr(kids, 0, sp)?,
            kid_expr(kids, 1, sp)?,
        ))),
        // `.name(args)`
        [Tok(_), name, Tok(_), Sub(_), Tok(_)] => {
            let args = no_spread(as_exprs(kid(kids, 0, sp)?, sp)?, "a method call")?;
            ok(ASuffix(SufMethod(slot_name(name, src, sp), args)))
        },
        // `[i]`
        [Tok(_), Sub(_), Tok(_)] => ok(ASuffix(SufIndex(kid_expr(kids, 0, sp)?))),
        // `[..e]` — the open end is the left one.
        [Tok(_), Tok(_), Sub(_), Tok(_)] => ok(ASuffix(SufSliceTo(kid_expr(kids, 0, sp)?))),
        // `[e..]`
        [Tok(_), Sub(_), Tok(_), Tok(_)] => ok(ASuffix(SufSliceFrom(kid_expr(kids, 0, sp)?))),
        _ => err(ParseError { message: "a suffix matched no alternative", span: sp }),
    }
}

# `$name`, `$0` and `$name(args)` — the three member forms, each mapped over the
# receiver. The shapes are the `.` forms', so the slots say which one matched.
fn map_step(src: str, node: Parts, kids: Ast[], sp: Span) -> Suffix!ParseError {
    match (node.slots()) {
        [Tok(_), name] => ok(SufMapField(field_name(slot_name(name, src, sp), sp)?)),
        [Tok(_), name, Tok(_), Sub(_), Tok(_)] => {
            let args = no_spread(as_exprs(kid(kids, 0, sp)?, sp)?, "a mapped call")?;
            ok(SufMapMethod(slot_name(name, src, sp), args))
        },
        _ => err(ParseError { message: "a mapped step matched no alternative", span: sp }),
    }
}

# `.name` names a field and `.0` a tuple slot, which the AST spells as the field
# `_0` — so the two syntaxes become one here and nothing downstream knows tuples
# have a second way to name their fields. A negative index is refused here rather
# than in the lexer: the `Int` matcher claims the sign, so `p.-1` does lex.
fn field_name(name: SpanStr, span: Span) -> SpanStr!ParseError {
    if (name.text.starts_with('-')) {
        return err(ParseError { message: "tuple index must be a non-negative integer", span });
    };
    match (name.text.int_parse()) {
        some(..) => ok(SpanStr { ..name, text: `_{name.text}` }),
        none => ok(name),
    }
}

# The name a slot holds, with where it was written; `fallback` when the slot is a
# child position, which has no token of its own.
fn slot_name(self: Slot, src: str, fallback: Span) -> SpanStr {
    span_str(src, self.slot_span().value_or(fallback))
}

# `atom` — the twenty alternatives, dispatched on the first token each matched.
# The template is the one alternative that matches no token of its own, which is
# what identifies it without a comparison.
fn lower_atom(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let tsp = node.tok_span();
    match (toks) {
        [head, ..] => {
            if (head == "if") {
                return ok(AExpr(lower_if(src, node, kids)?));
            };
            if (head == "match") {
                return ok(AExpr(match_expr(kids, tsp, sp)?));
            };
            if (head == "shim") {
                return ok(AExpr(shim_expr(src, node, kids, sp)?));
            };
            if (head == "true") {
                return ok(AExpr(at(Bool(true), tsp)));
            };
            if (head == "false") {
                return ok(AExpr(at(Bool(false), tsp)));
            };
            if (head == "none") {
                return ok(AExpr(at(None, tsp)));
            };

            // A grouping paren holds one expression; a tuple holds two or more, which
            // is what the comma after the first bought.
            if (head == "(") {
                if (kids.len() == 1) {
                    return ok(AExpr(kid_expr(kids, 0, sp)?));
                };
                return ok(AExpr(at(TupleLit(kids.try_map(|k| as_expr(k, sp))?), tsp)));
            };
            // The array literal and the set literal are the places a `..` spread survives.
            if (head == "[") {
                return ok(AExpr(at(ArrayLit(as_exprs(kid(kids, 0, sp)?, sp)?), tsp)));
            };
            if (head == "#") {
                let order = order_after_hash(toks);
                return ok(AExpr(brace_literal(as_entries(kid(kids, 0, sp)?, sp)?, order, tsp)?));
            };
            if (head == "|") {
                return ok(AExpr(lambda_of(kids, tsp, sp)?));
            };
            if (head.starts_with('"') || head.starts_with('`')) {
                return ok(AExpr(at(Str(str_lit_value(head)), tsp)));
            };
            if (head.starts_with('\'')) {
                let c = char_lit_value(head).value_or_err(ParseError {
                    message: "a char literal holds exactly one character",
                    span: sp,
                })?;
                return ok(AExpr(at(Char(c), tsp)));
            };
            if (let some(n) = head.int_parse()) {
                return ok(AExpr(at(Num(n), tsp)));
            };

            // What is left opens with an identifier, and the token after it says which
            // of the three name forms was written.

            // What is left opens with an identifier, and the token after it says which
            // of the three name forms was written.
            match (toks) {
                [_, "::", ..] => {
                    let TypedCall { tys, args } = typed_call(kids, sp)?;
                    ok(AExpr(at(TypeArgs(at(Call(head, args, false), tsp).named_at(tsp), tys), sp)))
                },
                [_, "(", ..] => {
                    let args = no_spread(as_exprs(kid(kids, 0, sp)?, sp)?, "a call argument list")?;
                    ok(AExpr(at(Call(head, args, false), tsp).named_at(tsp)))
                },
                [_, "{", ..] => {
                    ok(AExpr(at(
                        Construct(head, kids.try_map(|k| as_field_init(k, sp))?),
                        tsp,
                    ).named_at(tsp)))
                },
                _ => ok(AExpr(at(Ident(head), tsp).named_at(tsp))),
            }
        },
        // A rule that matched no token of its own is a single pass-through child.
        _ => ok(AExpr(kid_expr(kids, 0, sp)?)),
    }
}

# `match (e) { .. }` — every arm child is already a *list* of arms, since an
# alternation expands to one arm per pattern, so they concatenate.
# The scrutinee is every leading expression child: one is matched as it is,
# several are the tuple `match (a, b)` spells without its own parentheses.
fn match_expr(kids: Ast[], tsp: Span, sp: Span) -> Expr!ParseError {
    mut parts: Expr[] = [];
    mut arms: MatchArm[] = [];
    for (let k : kids) {
        if (let AExpr(e) = k) {
            set parts.push(e);
        } else {
            set arms.extend(as_arms(k, sp)?);
        };
    }
    match (parts) {
        [only] => ok(at(Match(only, arms), tsp)),
        [first, ..] => {
            let last = parts.last().value_or(first);
            let scrutinee = at(TupleLit(parts), join_spans(first.span, last.span));
            ok(at(Match(scrutinee, arms), tsp))
        },
        _ => err(ParseError { message: "a match needs a scrutinee", span: sp }),
    }
}

# Whether `kid` is an expression, as the first block of `shim <effect> { provider } { body }`
# is, rather than a `name = name` binding.
fn is_block_kid(kid: Ast?, sp: Span) -> bool {
    kid.is_some_and(|k| match (as_expr(k, sp)) {
        ok(..) => true,
        err(..) => false,
    })
}

# `shim <effect> { op = f, .. } { body }`. Spanned over `shim <effect>` rather
# than over the whole form: the body's span is empty when it ends in a `;`.
fn shim_expr(src: str, node: Parts, kids: Ast[], sp: Span) -> Expr!ParseError {
    if (kids.len() == 2 && is_block_kid(kids[0], sp)) {
        return provider_block_shim_expr(src, node, kids, sp);
    };
    match (node.own_texts(src)) {
        [_, _, "{", ..] => {
            let ShimHead { effect, span } = shim_head(src, node, sp)?;
            let last = kids.len() - 1;
            let body = kid_expr(kids, last, sp)?;
            let named = kids[..last].try_map(|k| as_bind(k, sp))?;
            let binds = named.map(|b| (b.op, b.name));
            mut wrapped = at(Shim(effect, binds, body), span);
            // Each closure is a `let` around the shim, named by the binding that uses it.
            for (let bind : named) {
                if (let some(closure) = bind.closure) {
                    set wrapped = at(Let(bind.name, none, closure, wrapped), span);
                };
            }
            ok(wrapped)
        },
        _ => provider_shim_expr(src, node, kids, sp),
    }
}

# `shim <effect>`: the effect's name, and the span over both tokens, which is
# where a diagnostic about the form points.
struct ShimHead { effect: str, span: Span }

fn shim_head(src: str, Parts { tokens }, sp: Span) -> ShimHead!ParseError {
    match (tokens) {
        [opener, effect, ..] => ok(ShimHead {
            effect: src[effect],
            span: join_spans(opener, effect),
        }),
        _ => err(ParseError { message: "a shim matched no token", span: sp }),
    }
}

# The head of a shim that names a provider rather than listing bindings. Only
# `random` has providers, so any other effect is refused here.
fn provider_head(src: str, node: Parts, sp: Span) -> ShimHead!ParseError {
    let ShimHead { effect, span } = shim_head(src, node, sp)?;
    if (effect != "random") {
        return err(ParseError {
            message: `effect "!{effect}" has no providers; \`shim {effect}\` takes a list of bindings`,
            span,
        });
    };
    ok(ShimHead { effect, span })
}

# `shim <effect> <provider>(args) { body }`, lowered to the shim it stands for.
#
# A provider is a named way to fill in every operation of an effect, for effects
# whose operations need state that a function cannot hold. `random` is the one:
# `random_u64` is bound to the runtime's generator, and the first thing the body
# does is seed it —
#
#     shim random seeded_with_int(n) { body }
#       => shim random { random_u64 = __random_next } { __random_seed(n); body }
#     shim random seeded_with_clock() { body }
#       => shim random { random_u64 = __random_next } { __random_seed_from_clock(); body }
#
# The seed is read inside the shim's body, so the clock a `seeded_with_clock`
# reads is an ordinary `now_nanos` call: the enclosing function declares `!clock`
# for it, and a `shim clock` around the whole thing makes the seed repeatable.
fn provider_shim_expr(src: str, node: Parts, kids: Ast[], sp: Span) -> Expr!ParseError {
    let span = provider_head(src, node, sp)?.span;
    let args = no_spread(as_exprs(kid(kids, 0, sp)?, sp)?, "a shim provider's arguments")?;
    let body = kid_expr(kids, 1, sp)?;
    match (node.own_texts(src)) {
        [_, _, provider, ..] => match ((provider, args.len())) {
            ("seeded_with_int", 1) => ok(random_shim(
                at(Call("__random_seed", args, false), span),
                body,
                span,
            )),
            ("seeded_with_clock", 0) => ok(random_shim(
                at(Call("__random_seed_from_clock", [], false), span),
                body,
                span,
            )),
            _ => err(ParseError {
                message: `\`shim random\` has providers \`seeded_with_int(seed)\` and \`seeded_with_clock()\`; \`{provider}\` with {args.len()} argument(s) is neither`,
                span,
            }),
        },
        _ => err(ParseError { message: "a shim provider matched no token", span }),
    }
}

# `shim random { provider } { body }`: the first block is any expression of type
# `RandomProvider`, so which provider to use can be decided at run time. A provider
# holds the seed to start from, `none` for the clock, and the seeding reads it:
#
#     shim random { p } { body }
#       => shim random { random_u64 = __random_next } {
#              if (let some(seed) = p.seed) { __random_seed(seed) } else { __random_seed_from_clock() };
#              body
#          }
fn provider_block_shim_expr(src: str, node: Parts, kids: Ast[], sp: Span) -> Expr!ParseError {
    let at_head = provider_head(src, node, sp)?.span;
    let provider = kid_expr(kids, 0, sp)?;
    let body = kid_expr(kids, 1, sp)?;
    let arm = MatchArm {
        pattern: PatCtor("some", bindings=["seed$provider"]),
        body: at(Call("__random_seed", [at(Ident("seed$provider"), at_head)], false), at_head),
        span: at_head,
    };
    let seeding = at(
        IfLet(
            arm,
            at(Field(provider, "seed"), at_head),
            at(Call("__random_seed_from_clock", [], false), at_head),
        ),
        at_head,
    );
    ok(random_shim(seeding, body, at_head))
}

# The shim a `random` provider stands for: `random_u64` is the runtime's
# generator, and `seeding` runs before the body.
fn random_shim(seeding: Expr, body: Expr, head: Span) -> Expr {
    at(Shim("random", [("random_u64", "__random_next")], at(Seq(seeding, body), body.span)), head)
}

# `if (..) { .. }` and `if (let p = e) { .. }`, with or without an `else`. Both
# are written in two places — an atom, and the tail of an `else` — and build
# identically wherever they appear, so one lowering serves both.
fn lower_if(src: str, node: Parts, kids: Ast[]) -> Expr!ParseError {
    let sp = node.span();
    let tsp = node.tok_span();
    let subs = node.children;
    if (node.own_texts(src).contains("let")) {
        let arm = MatchArm {
            pattern: as_pat(kid(kids, 0, sp)?, sp)?,
            body: kid_expr(kids, 2, sp)?,
            span: sub_span(subs, 0, tsp),
        };
        return ok(at(IfLet(arm, kid_expr(kids, 1, sp)?, else_or_unit(kids, 3, tsp, sp)?), tsp));
    };
    let cond = kid_expr(kids, 0, sp)?;
    let then_branch = kid_expr(kids, 1, sp)?;
    ok(at(If(cond, then_branch, else_or_unit(kids, 2, tsp, sp)?), tsp))
}

# The `else` branch, or the synthetic unit an else-less `if` gets — so it is
# typed and lowered exactly like `if (..) { .. } else {}`.
fn else_or_unit(kids: Ast[], i: u64, tsp: Span, sp: Span) -> Expr!ParseError {
    match (kids[i]) {
        some(k) => as_expr(k, sp),
        none => ok(at(Unit, tsp)),
    }
}

# `else_branch` — a block, or another `if` in the else position. The block form
# is the one with no token of its own.
fn lower_else_branch(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    if (node.tokens.is_empty()) {
        return ok(AExpr(kid_expr(kids, 0, sp)?));
    };
    ok(AExpr(lower_if(src, node, kids)?))
}

# `template` — the delimiters, the text runs and the braces, as one concat
# chain. The segments are decoded here, together: a raw template is de-dented
# across the whole literal, so no segment can be read on its own — which is why
# the lexer leaves them as written (see `raw_tpl_text` in `lex_aipl.aipl`).
fn lower_template(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let raw = match (toks) {
        [open, ..] => open.starts_with("```"),
        _ => false,
    };
    let segs = template_segments(raw, template_slots(toks));
    let exprs = kids.try_map(|k| as_expr(k, sp))?;
    ok(AExpr(at(template_chain(segs, exprs, sp).kind, node.tok_span())))
}

# A template's text slots, as written: one per gap, with an empty string where
# the source had no text there at all. A template alternates text and
# interpolation and begins and ends with text, so there is always one more slot
# than interpolation — which is the shape `template_chain` folds.
#
# `toks` is every token this production matched: the two delimiters at the ends,
# and between them the text runs and the braces (the interpolated expressions are
# children, not tokens, so a `{` is always followed by its `}`).
#
# An opening brace is told from text by its spelling — an unescaped `{` always
# lexes as a brace, and a literal one is written `\{`, two characters long. A
# *closing* brace is not: `}` needs no escape in template text, so a text run
# holding exactly `}` reads the same as the token. It is found by pairing
# instead — the token after a `{` is its `}` — which is what `` `\{{x}}` `` needs
# to keep its trailing `}` as text.
fn template_slots(toks: str[]) -> str[] {
    mut slots: str[] = [];
    mut current = "";
    mut closing = false;
    for (let t : toks[1..max(1, toks.len() - 1)]) {
        if (closing) {
            set closing = false;
        } else if (t == "{") {
            set slots.push(current);
            set current = "";
            set closing = true;
        } else {
            set current = t;
        };
    }
    set slots.push(current);
    slots
}

# The concat chain a template lowers to. A template alternates segments and
# interpolations and always begins and ends with a segment, so there is exactly
# one more segment than interpolation: `zip_with` pairs each interpolation with
# the segment in front of it (stopping at the shorter side, which is `exprs`),
# and the one segment left over is the tail the fold starts from.
#
# Right-associated — `(s0 +++ i0) +++ ((s1 +++ i1) +++ (.. +++ sN))` — because
# that is the tree the parser's right-recursive `template_rest` produces, and
# the concat chain has to agree with it.
fn template_chain(segs: str[], exprs: Expr[], sp: Span) -> Expr {
    let tail = at(Str(segs[exprs.len()].value_or("")), sp);
    let pieces = zip_with(segs, exprs, |s: str, e: Expr| interpolation_piece(s, e, sp));
    pieces.right_fold(tail, concat_call)
}

# One link of the chain: the segment in front of an interpolation, joined to
# the interpolation itself.
fn interpolation_piece(segment: str, e: Expr, sp: Span) -> Expr {
    concat_call(at(Str(segment), sp), interp_call(e))
}

# `__template_interp` is `to_str` under another name — a `str` passes through
# unchanged, a `char` widens to its one-character `str`, anything else renders
# by its type — kept distinct so a lowered template is recognizable as one.
fn interp_call(e: Expr) -> Expr {
    let span = e.span;
    at(Call("__template_interp", [e], false), span)
}

fn concat_call(a: Expr, b: Expr) -> Expr {
    let span = join_spans(a.span, b.span);
    at(Call("__aipl_concat", [a, b], false), span)
}

# `args` — the comma-separated list every call, array literal and array pattern
# is built on.
fn lower_args(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(AExprs(kids.try_map(|k| as_expr(k, sp))?))
}

# A `..` spread that is not a direct element of an array literal. `args` is
# shared by calls, the mutating writeback and array patterns, so the grammar
# admits one everywhere and only the array literal leaves it in place.
fn no_spread(args: Expr[], context: str) -> Expr[]!ParseError {
    if (let some(a) = args.find_if(is_spread)) {
        return err(ParseError {
            message: `\`..\` spread is only allowed in an array or set literal, not in {context}`,
            span: a.span,
        });
    };
    ok(args)
}

# `arg` — a spread, a keyword argument, or an ordinary expression. The three
# pass-through alternatives (an expression, a lambda, a bare operator) match no
# token of their own.
fn lower_arg(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    match (node.slots()) {
        // The three pass-through alternatives — an expression, a lambda, a bare
        // operator — are each a lone `Named`, so each is one position.
        [x] => ok(AExpr(slot_expr(x, kids, sp)?)),
        // `..xs`. The `..` carries no meaning of its own, so the node takes the
        // operand's span and an error points at what is being spread.
        [_, x] => {
            let value = slot_expr(x, kids, sp)?;
            let span = value.span;
            ok(AExpr(at(Spread(value), span)))
        },
        // `k = v`, and `k?= v` forwarding an optional into a `k?: T` parameter.
        // The `?` is a position of its own, so its presence is the arity — where
        // reading the second own token asks the same thing by hand.
        [n, _, x] => kw_arg(src, kids, n, x, false, sp),
        [n, _, _, x] => kw_arg(src, kids, n, x, true, sp),
        _ => err(ParseError { message: "an argument matched no alternative", span: sp }),
    }
}

fn kw_arg(
    src: str,
    kids: Ast[],
    name: Slot,
    value: Slot,
    implicit_some: bool,
    sp: Span,
) -> Ast!ParseError {
    let v = slot_expr(value, kids, sp)?;
    let name_span = name
        .slot_span()
        .value_or_err(ParseError { message: "a keyword argument has no name", span: sp })?;
    let span = join_spans(name_span, v.span);
    ok(AExpr(at(KwArg(name.slot_text(src), v, implicit_some), span)))
}

# `op_value` — an operator passed as a value (`apply(2, 3, +)`) is a binary
# lambda whose body is that operator's call, which reuses every lambda mechanism
# and leaves the operator gated like any other use.
fn lower_op_value(src: str, node: Parts, kids: Ast[]) -> Ast {
    let tsp = node.tok_span();
    let body = at(
        Call(node.own_token_text(src), [at(Ident("lhs"), tsp), at(Ident("rhs"), tsp)], false),
        tsp,
    );
    let params = [
        LambdaParam { name: "lhs", ty: none, span: tsp },
        LambdaParam { name: "rhs", ty: none, span: tsp },
    ];
    AExpr(at(Lambda(params, body), tsp))
}

# `lambda` — `|a, b| body`, or the no-parameter `|| body`. The `||` is one
# token, so its presence is what says the parameter list is empty.
fn lower_lambda(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();

    // The *first* token, not the run of them: `|x|` matches two `|` tokens, and
    // their texts run together are indistinguishable from the one `||` token
    // the no-parameter form is.
    match (node.own_texts(src)) {
        ["||", ..] => {
            let body = kid_expr(kids, 0, sp)?;
            let span = body.span;
            let no_params: LambdaParam[] = [];
            ok(AExpr(at(Lambda(no_params, body), span)))
        },
        _ => ok(AExpr(lambda_of(kids, node.tok_span(), sp)?)),
    }
}

# `|a, b| body` — the parameters are every child but the last, which is the
# body. Shared with the value-position lambda in `atom`, which is the same shape
# with a block for a body.
fn lambda_of(kids: Ast[], span: Span, sp: Span) -> Expr!ParseError {
    let last = kids.len() - 1;
    let body = kid_expr(kids, last, sp)?;
    ok(at(Lambda(kids[..last].try_map(|k| as_lambda_param(k, sp))?, body), span))
}

fn lower_lambda_param(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let name_span = node.first_tok(node.tok_span());
    match (node.own_texts(src)) {
        [name, ..] => {
            if (kids.is_empty()) {
                return ok(ALambdaParam(LambdaParam { name, ty: none, span: name_span }));
            };
            let ty = as_ty(kid(kids, 0, sp)?, sp)?;
            ok(ALambdaParam(LambdaParam { name, ty: some(ty), span: name_span }))
        },
        _ => err(ParseError { message: "a lambda parameter matched no token", span: sp }),
    }
}

# `field_init` — `name: value`, the shorthand `name`, or a `..base` spread. A
# spread names no field, so it rides as an init with an empty name whose *value*
# is the spread. The three alternatives are three, two and one position, so the
# shape is what identifies each.
fn lower_field_init(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    match (node.slots()) {
        // `..base` — a spread names no field, so it rides as an init with an
        // empty name whose *value* is the spread.
        [_, b] => {
            let base = slot_expr(b, kids, sp)?;
            let span = base.span;
            ok(AFieldInit(FieldInit { name: "", value: at(Spread(base), span) }))
        },
        [n, _, v] => ok(AFieldInit(FieldInit {
            name: n.slot_text(src),
            value: slot_expr(v, kids, sp)?,
            name_span: n.slot_span().value_or(sp),
        })),
        // `x` is `x: x`, spanned at the field name.
        [n] => {
            let name = n.slot_text(src);
            let span = n.slot_span().value_or(node.tok_span());
            ok(AFieldInit(FieldInit {
                name,
                value: at(Ident(name), span).named_at(span),
                name_span: span,
            }))
        },
        _ => err(ParseError { message: "a field initialiser matched no alternative", span: sp }),
    }
}

fn lower_brace_body(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(AEntries(kids.try_map(|k| as_entry(k, sp))?))
}

fn lower_entry(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();

    // The rule's alternatives are `Then([expr, ":", expr])`, a bare `expr`, and
    // `Then(["..", expr])` — three positions, one and two — so the arm that binds
    // three is the pair. Nothing counts children or looks for the `:`.
    match (node.slots()) {
        [k, _, v] => ok(AEntry(Pair(slot_expr(k, kids, sp)?, slot_expr(v, kids, sp)?))),
        // `..xs`. The `..` carries no meaning of its own, so the node takes the
        // operand's span, as an array literal's spread does.
        [_, x] => {
            let value = slot_expr(x, kids, sp)?;
            let span = value.span;
            ok(AEntry(Key(at(Spread(value), span))))
        },
        [k] => ok(AEntry(Key(slot_expr(k, kids, sp)?))),
        _ => err(ParseError { message: "an entry matched no alternative", span: sp }),
    }
}

fn lower_shim_binding(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let value = kid_expr(kids, 0, sp)?;
    match (node.own_texts(src)) {
        [op, ..] => match (value.kind) {
            Ident(f) => ok(AShimBind(op, f)),
            Lambda(..) => ok(AShimClosure(op, value)),
            _ => err(ParseError {
                message: `"{op}" is bound to a function's name or to a closure \`|args| body\``,
                span: value.span,
            }),
        },
        _ => err(ParseError { message: "a shim binding matched no token", span: sp }),
    }
}

// ---------- lowering: blocks ----------
//
// A block is not a node in the AST: it is the right-nested chain its statements
// fold to, which is why `block` and its two body productions lower to an
// ordinary `Expr` like everything else here. The fold itself is `wrap_stmt`,
// which lives with the statements below.

fn lower_block(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let brace = node.first_tok(node.tok_span());
    let repaired = repair_block_value(kid_expr(kids, 0, sp)?, brace);
    ok(AExpr(Expr { ..repaired.0, value_span: repaired.1 }))
}

# A block's chain with its *value* located, and that location — the two halves
# of `with_block_span` in `aipl-parser`, which does both in one walk for the
# same reason.
#
# **Repairing it.** A block with no trailing expression — `{}`, or one ending in
# `f();` — has a unit value the parser cannot locate: the empty production it
# comes from matches no text. Left at the empty span, every diagnostic about
# that value reports at line 1 of the file. The block's `{` is the honest
# location, and this is the first place it is in scope.
#
# **Recording it.** `fn f() -> str { let a = 1; a }` returns the `a`, but the
# body's span starts at the `let`, so a return-type error would underline the
# binding. The tail is in hand here, so it is stored once rather than re-walked
# at every diagnostic.
#
# The value can sit arbitrarily deep in the chain a block is, so this walks the
# four kinds that pass a value along and rebuilds the spine. Depth is one frame
# per statement in *this* block — nested blocks repair their own, so the total
# work is one pass over the program rather than one per nesting level.
fn repair_block_value(e: Expr, brace: Span) -> (Expr, Span) {
    match (e.kind) {
        Seq(head, tail) => {
            let inner = repair_block_value(tail, brace);
            (Expr { ..e, kind: Seq(head, inner.0) }, inner.1)
        },
        Let(name, ty, value, body) => {
            let inner = repair_block_value(body, brace);
            (Expr { ..e, kind: Let(name, ty, value, inner.0) }, inner.1)
        },
        LetMut(name, ty, value, body) => {
            let inner = repair_block_value(body, brace);
            (Expr { ..e, kind: LetMut(name, ty, value, inner.0) }, inner.1)
        },
        Assign(lhs, value, body) => {
            let inner = repair_block_value(body, brace);
            (Expr { ..e, kind: Assign(lhs, value, inner.0) }, inner.1)
        },
        // Everything else is the block's tail, so the walk stops here.
        _ => block_tail(e, brace),
    }
}

# The block's value, once the walk above has found it. An empty span is the unit
# value of a block with no trailing expression — the empty production it comes
# from matched no text — and the block's `{` is the honest location for it.
# Anything else already knows where it is.
fn block_tail(e: Expr, brace: Span) -> (Expr, Span) {
    if (e.span.start == e.span.end) { (Expr { ..e, span: brace }, brace) } else { (e, e.span) }
}

# `block_body` — a statement and the rest of the block, an expression and
# whatever the `;` after it decided, or nothing at all.
fn lower_block_body(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();

    // Empty: the block's value is unit. Its span is empty too; `block_tail`
    // repairs that from the block's own `{`.
    if (kids.is_empty()) {
        return ok(AExpr(at(Unit, 0..0)));
    };

    // A keyword statement and the rest of the block, folded into the chain the
    // block is.
    if (let AStmt(st) = kid(kids, 0, sp)?) {
        return ok(AExpr(wrap_stmt(st, kid_expr(kids, 1, sp)?)));
    };
    let value = kid_expr(kids, 0, sp)?;

    // `block_tail` hands back what followed the `;`: nothing when the
    // expression was the block's value, and the rest of the block when it was a
    // statement.
    match (as_exprs(kid(kids, 1, sp)?, sp)?) {
        [rest, ..] => {
            let span = join_spans(value.span, rest.span);
            ok(AExpr(at(Seq(value, rest), span)))
        },
        _ => ok(AExpr(value)),
    }
}

# `block_tail` — the `; rest` that turns the expression before it into a
# statement, as a list so that "nothing followed" and "this followed" are the
# empty and one-element cases of one shape.
fn lower_block_tail(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(AExprs(kids.try_map(|k| as_expr(k, sp))?))
}

// ---------- lowering: statements ----------
//
// AIPL has no statement node. A block is a right-nested chain of the four
// expression kinds that carry a "rest" — `Let`, `LetMut`, `Assign` and
// `Seq` — so a statement is only meaningful once the rest of the block is in
// scope. `Stmt` is the shape in between, and `wrap_stmt` is the fold.
//
// Four statements are *several* nodes rather than one, and that is the whole
// reason this slice is not mechanical:
//
//   - `let (a, b) = e;` binds a temporary and then reads `._0`/`._1` off it.
//   - `let T { x, y } = e;` does the same by field name, with the pattern's
//     type as the temporary's annotation — which is what makes the type name
//     mean something rather than decorate the line.
//   - `for (let i, x : xs)` is a plain loop over a counter declared just
//     outside it, so the counter resets when the loop is nested inside another.
//   - `set n++;` and `set n += e;` are ordinary operator calls on the binding,
//     each gated on importing the operator that was actually written.
//
// All four are desugarings: the AST has no node for any of them.

# The identifier tokens of a binder-led statement: everything this production
# matched directly, less the fixed spellings around them. A `let` statement's
# type is a child node rather than a token, so what is left is exactly the names
# — one for `let x`, two or more for `let (a, b)`, and the struct name followed
# by its fields for `let T { x, y }`.
fn binder_names(toks: str[]) -> str[] { toks.filter(|w| !binder_punct().contains(w)) }

# The names between a case pattern's parentheses, ending at the `)` — the tokens
# after it (a `let`'s `=`, `else`) are not binders.
fn case_binders(toks: str[]) -> str[] {
    let close = toks.find_index(|t| t == ")").value_or(toks.len());
    binder_names(toks[..close])
}

# The fields a struct pattern reads and the names it binds them as, in order —
# read off the tokens of its braces, which start at `first`. `x` binds `x` and
# `x as px` binds `px`; either way the field is the one written first.
#
# Told apart by the `as` after a field rather than by counting: a field may
# itself be called `as` (`{ as }` and `{ as as a }` both read as written), because
# what decides is the token that *follows* it.
struct FieldBinders { fields: str[], names: str[] }

fn field_binders_of(toks: str[], first: u64) -> FieldBinders {
    mut fields: str[] = [];
    mut names: str[] = [];
    mut rest = toks[first..];
    while (rest.first() != some("}") && rest.is_nonempty()) {
        match (rest) {
            [field, "as", name, ..] => {
                set fields.push(field);
                set names.push(name);
                set rest = rest[3..];
            },
            [field, ..] => {
                set fields.push(field);
                set names.push(field);
                set rest = rest[1..];
            },
            _ => {},
        };
        if (rest.first() == some(",")) {
            set rest = rest[1..];
        };
    }
    FieldBinders { fields, names }
}.test({
    fn binders(src: str) -> (str[], str[]) {
        let FieldBinders { fields, names } = field_binders_of(src.split(" "), 0);
        (fields, names)
    }
    assert(binders("x , y }") == (["x", "y"], ["x", "y"]));
    assert(binders("x as a , y }") == (["x", "y"], ["a", "y"]));
    assert(binders("x , y as b }") == (["x", "y"], ["x", "b"]));
    // A field called `as` is told from the keyword by what follows it.
    assert(binders("as , y }") == (["as", "y"], ["as", "y"]));
    assert(binders("as as a }") == (["as"], ["a"]));
    assert(binders("x as as }") == (["x"], ["as"]));
    // Nothing past the closing brace is read.
    assert(binders("x } = v ;") == (["x"], ["x"]));
})

fn binder_punct() -> str[] { ["let", "mut", "for", "(", ")", "{", "}", ",", "=", ";", ":"] }

fn as_stmt(v: Ast, span: Span) -> Stmt!ParseError {
    if (let AStmt(st) = v) {
        return ok(st);
    };
    err(wrong_kind("a statement", v, span))
}

# `let_stmt` — the plain binding, the annotated one, and the three destructuring
# forms. The token after `let` says which: `(` opens a tuple pattern; after a
# name, `(` opens a case pattern, `{` a struct pattern, `:` an annotation.
fn lower_let_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    lower_binding(src, node, kids, false)
}

# `mut_stmt` — the same three shapes a `let` has, less the tuple pattern, which
# `mut` does not take.
fn lower_mut_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    lower_binding(src, node, kids, true)
}

fn lower_binding(src: str, node: Parts, kids: Ast[], mutable: bool) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let name_span = node.second_tok(node.tok_span());
    let has_else = toks.contains("else");
    let refutable = match (toks) {
        [_, "=", ..] => true,
        [_, "[", ..] => true,
        [_, _, "(", ..] => true,
        _ => false,
    };
    if (has_else && !refutable) {
        return err(ParseError {
            message: "`else` follows a pattern that can fail to match, like `Some(x)`; a name, a tuple or a struct pattern always matches",
            span: node.tok_span(),
        });
    };
    match (toks) {
        // `let [a, b] = e else { .. };` — an array pattern, its elements children
        // ahead of the value and the block.
        [_, "[", ..] => {
            let last = kids.len() - 2;
            let rest = last > 0 && kids[last - 1].is_some_and(is_rest);
            let written = if (rest) { kids[..last - 1] } else { kids[..last] };
            let elems = written.try_map(|k| as_pat(k, sp))?;
            let pattern = array_pattern(elems, node.children, rest, node.tok_span())?;
            let_else(pattern, kid_expr(kids, last, sp)?, kid_expr(kids, last + 1, sp)?, sp)
        },
        // `let PATTERN = e else { .. };` — a pattern the binding forms below do not
        // take, so it is a child of its own.
        [_, "=", ..] => {
            let pattern = as_pat(kid(kids, 0, sp)?, sp)?;
            if (has_else) {
                return let_else(pattern, kid_expr(kids, 1, sp)?, kid_expr(kids, 2, sp)?, sp);
            };
            let value = kid_expr(kids, 1, sp)?;
            ok(AStmt(SLetDestructure(ByPattern(pattern), value, value.span)))
        },
        // `let (a, b) = e;` — a tuple pattern, spanned at its value like the struct
        // form, since the names are not one run of text.
        [_, "(", ..] => {
            let names = binder_names(toks);
            if (names.len() < 2) {
                return err(ParseError {
                    message: "a tuple pattern needs at least 2 names, e.g. let (a, b) = expr;",
                    span: sp,
                });
            };
            let value = kid_expr(kids, 0, sp)?;
            ok(AStmt(SLetDestructure(ByTuple(names), value, value.span)))
        },
        // `let Import(decl) = e;` — the case name, then its payload's binders.
        [_, case_name, "(", ..] => {
            let pattern = case_pattern(case_name, kid(kids, 0, sp)?, sp)?;
            let value = kid_expr(kids, 1, sp)?;
            if (has_else) {
                return let_else(pattern, value, kid_expr(kids, 2, sp)?, sp);
            };
            ok(AStmt(SLetDestructure(pattern.destructure(), value, value.span)))
        },
        // `let T { x, y as py } = e;` — the struct name, then the braces.
        [_, struct_name, "{", ..] => {
            let value = kid_expr(kids, 0, sp)?;
            let FieldBinders { fields, names } = field_binders_of(toks, 3);
            let pattern = ByStruct(struct_name, fields, names, mutable);
            ok(AStmt(SLetDestructure(pattern, value, value.span)))
        },
        // `let x: T = e;` — the annotation is a child, so it comes before the value.
        [_, name, ":", ..] => {
            let ty = as_ty(kid(kids, 0, sp)?, sp)?;
            let value = kid_expr(kids, 1, sp)?;
            ok(AStmt(named_binding(mutable, name, name_span, some(ty), value)))
        },
        [_, name, ..] => {
            let value = kid_expr(kids, 0, sp)?;
            ok(AStmt(named_binding(mutable, name, name_span, none, value)))
        },
        _ => err(ParseError { message: "a binding matched no alternative", span: sp }),
    }
}

# `let PATTERN = value else { .. };`. The block is what runs when the pattern does
# not match, and the rest of the block cannot be reached from it, so it has to
# leave the function: otherwise the binding the pattern makes would be missing
# below it.
fn let_else(pattern: Pat, value: Expr, otherwise: Expr, sp: Span) -> Ast!ParseError {
    if (!otherwise.diverges()) {
        return err(ParseError {
            message: "the `else` of a `let .. else` has to leave the function, as in `else { return none; }`",
            span: otherwise.span,
        });
    };
    ok(AStmt(SLetElse(pattern, value, otherwise, join_spans(sp, value.span))))
}

# Whether running `self` always ends in a `return`: it is one, or a sequence one of
# whose steps is, or a branching form each of whose branches is.
fn diverges(self: Expr) -> bool {
    match (self.kind) {
        Return(..) => true,
        Seq(first, rest) => first.diverges() || rest.diverges(),
        Let(_, _, _, rest) | LetMut(_, _, _, rest) | Assign(_, _, rest) => rest.diverges(),
        If(_, then, otherwise) => then.diverges() && otherwise.diverges(),
        IfLet(arm, _, otherwise) => arm.body.diverges() && otherwise.diverges(),
        Match(_, arms) => arms.is_nonempty() && arms.all(|a| a.body.diverges()),
        _ => false,
    }
}

# `let name = e;` and `mut name = e;`, with the annotation when one was written.
fn named_binding(mutable: bool, name: str, name_span: Span, ty: Ty?, value: Expr) -> Stmt {
    if (mutable) {
        return SMut(name, name_span, ty, value);
    };
    SLet(name, name_span, ty, value)
}

# `assign_stmt` — eight alternatives on one target, told apart by the token
# after it. The target is a name or a `.`-led field path (`p`, `p.a.b`), read
# off the token run as a `Field` chain exactly as `p.a.b` parses in expression
# position; every form then desugars around that chain the way it does around
# a bare name, so `set p.n++` is `set p.n = p.n ++ 1` and `set p.xs.push(x)` is
# `set p.xs = p.xs.push(x)`. The field-path store itself is not desugared here:
# the rewrite into nested constructs needs the structs' field lists, which only
# mono's `infer` knows.
fn lower_assign_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let spans = node.tokens;
    let name = toks[1].value_or("");
    let name_span = node.second_tok(node.tok_span());

    // The target: `set` then names joined by `.`. `at` ends on the first token
    // that is neither, which is the form's own operator.
    mut target = at(Ident(name), name_span);
    mut at_op = 2;
    while (toks[at_op] == some(".")) {
        let member = toks[at_op + 1].value_or("");
        let member_span = spans[at_op + 1].value_or(name_span);
        set target = at(Field(target, member), join_spans(name_span, member_span));
        set at_op += 2;
    }
    let op = toks[at_op].value_or("");
    let op_span = spans[at_op].value_or(name_span);

    // `set target[i] = value else { .. };` — see `indexed_write`.
    if (op == "[") {
        let two = toks.contains(",");
        let first = kid_expr(kids, 0, sp)?;
        let indexes = if (two) { [first, kid_expr(kids, 1, sp)?] } else { [first] };
        let at_value: u64 = indexes.len();
        let value = kid_expr(kids, at_value, sp)?;
        let handler = kid_expr(kids, at_value + 1, sp)?;
        return ok(AStmt(indexed_write(target, indexes, value, handler, name_span)));
    };

    // `set n++;` is `set n = n ++ 1;`, and `set n--;` its twin. The `1` and the
    // operator carry the operator's own span, so a missing import points at it.
    if (op == "++" || op == "--") {
        let span = join_spans(name_span, op_span);
        let value = at(Call(op, [target, at(Num(1), op_span)], false), span);
        return ok(AStmt(SAssign(target, value, span)));
    };

    // `set n += e;` is `set n = n += e;`, where `+=` is its own operator (gated
    // on importing `+=`, not `+`) that the loader collapses once gating has run.
    if (compound_ops().contains(op)) {
        let rhs = kid_expr(kids, 0, sp)?;
        let span = join_spans(name_span, rhs.span);
        let value = at(Call(op, [target, rhs], false), op_span);
        return ok(AStmt(SAssign(target, value, span)));
    };

    // `set recv.method(args);` is `set recv = recv.method(args)`: the receiver
    // folds in as `args[0]` and the call is flagged method-style, exactly as it
    // parses in expression position. The enclosing `set` is what writes the
    // mutated result back. The method is the target's last segment, so the
    // receiver is everything before it — and a bare `set f(x);` has none.
    if (op == "(") {
        if (let Field(recv, method) = target.kind) {
            let args = no_spread(as_exprs(kid(kids, 0, sp)?, sp)?, "a method call")?;
            let end = args.last()$span.value_or(target.span);
            let span = join_spans(name_span, end);
            let value = at(Call(method, [recv, ..args], true), span);
            return ok(AStmt(SAssign(recv, value, span)));
        };
        return err(ParseError {
            message: "set: a mutating method call needs a receiver to write back to, as in `set xs.push(x);`",
            span: join_spans(name_span, op_span),
        });
    };
    let value = kid_expr(kids, 0, sp)?;
    let span = join_spans(name_span, value.span);
    ok(AStmt(SAssign(target, value, span)))
}

fn compound_ops() -> str[] { ["+=", "-=", "*=", "/="] }

fn unhandled_index_write() -> str {
    "an indexed write can miss, because the index may be off the end: say what happens then, as in `set xs[i] = x else { return none; };`, or `else {}` to do nothing"
}

# `set target[i] = value else { handler };` writes the element when there is one
# and runs the handler when there is not:
#
#     let __iset$N = i;
#     if (let some(..) = target[__iset$N]) {
#         set target = __with_or_self(target, __iset$N, value);
#     } else { handler }
#
# A grid takes two indexes, `target[row, column]`, and `grid_get` / `grid_try_set`.
# The value is evaluated only when the element exists. An index that is not a
# literal, a name or a field is bound first so that it is evaluated once; those
# three are read twice, which costs nothing and keeps a literal's type open to
# the index it is used as (`let` would have made it an `i64`).
fn indexed_write(
    target: Expr,
    indexes: Expr[],
    value: Expr,
    handler: Expr,
    name_span: Span,
) -> Stmt {
    let sp = join_spans(name_span, handler.span);
    let tag = name_span.start;
    let names = indexes.range().map(|i| `__iset{i}${tag}`);
    let reads = indexes
        .range()
        .map(|i| {
            let index = indexes[i].value_or(target);
            if (is_plain_index(index)) { index } else { at(Ident(names[i].value_or("")), sp) }
        });
    let grid = indexes.len() == 2;
    let read = if (grid) {
        at(Call("__builtin_grid_get", [target, ..reads], false), sp)
    } else {
        at(Index(target, reads[0].value_or(target)), sp)
    };
    let write_name = if (grid) { "__builtin_grid_try_set" } else { "__with_or_self" };
    let write = at(Call(write_name, [target, ..reads, value], false), sp);
    let arm = MatchArm {
        pattern: PatCtor("some", ignore_payload=true),
        body: at(Assign(target, write, at(Unit, sp)), sp),
        span: sp,
    };
    mut head = at(IfLet(arm, read, handler), sp);
    mut i = indexes.len();
    while (i > 0) {
        set i--;
        let index = indexes[i].value_or(target);
        if (!is_plain_index(index)) {
            set head = at(Let(names[i].value_or(""), none, index, head), sp);
        };
    }
    SEffect(head, sp)
}

# Whether `e` is cheap and pure enough to read more than once.
fn is_plain_index(Expr { kind }) -> bool {
    match (kind) {
        Num(..) | Ident(..) | Field(..) => true,
        _ => false,
    }
}

# `for_stmt` — the plain loop and the two patterns a `let` takes apart a value
# with, tuple and struct, each with or without an index in front: `for (let x`,
# `for (let (a, b)`, `for (let T { a, b }`, and `for (let i, ` before any of the
# three. A comma after the first name says an index was written; the pattern
# then starts after it, and what follows the pattern's first token — a `(`, or a
# name and then `{` — says which it is.
fn lower_for_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let names = binder_names(toks);
    let iterable = kid_expr(kids, 0, sp)?;
    let body = kid_expr(kids, 1, sp)?;

    // The index, when one was written, is the name in front of the comma. Its span
    // is what a plain loop is spanned from.
    let name_span = node.tokens[3].value_or(node.tok_span());
    let span = join_spans(name_span, body.span);
    match (toks) {
        // `for (let i, (a, b) : xs)`
        [_, _, _, index, ",", "(", ..] => {
            ok(AStmt(for_tuple(names[1..], some(index), iterable, body, sp)?))
        },
        // `for (let (a, b) : xs)`
        [_, _, _, "(", ..] => ok(AStmt(for_tuple(names, none, iterable, body, sp)?)),
        // `for (let i, Import(decl) : xs)` — the case name and then its binders.
        [_, _, _, index, ",", case_name, "(", ..] => {
            ok(AStmt(for_arm(case_name, binder_names(toks[6..]), some(index), iterable, body)))
        },
        // `for (let Import(decl) : xs)`
        [_, _, _, case_name, "(", ..] => {
            ok(AStmt(for_arm(case_name, binder_names(toks[4..]), none, iterable, body)))
        },
        // `for (let i, T { x, y as b } : xs)` — the struct name and then its braces.
        [_, _, _, index, ",", struct_name, "{", ..] => {
            let FieldBinders { fields, names as bound } = field_binders_of(toks, 7);
            ok(AStmt(for_struct(struct_name, fields, bound, some(index), iterable, body)))
        },
        // `for (let T { x, y as b } : xs)`
        [_, _, _, struct_name, "{", ..] => {
            let FieldBinders { fields, names as bound } = field_binders_of(toks, 5);
            ok(AStmt(for_struct(struct_name, fields, bound, none, iterable, body)))
        },
        // `for (let i, x : xs)` — two names, the first of which is the index.
        [_, _, _, index, ",", name, ..] => {
            ok(AStmt(SFor(name, name_span, some(index), iterable, body, span)))
        },
        [_, _, _, name, ..] => ok(AStmt(SFor(name, name_span, none, iterable, body, span))),
        _ => err(ParseError { message: "a for loop matched no alternative", span: sp }),
    }
}

# `for (let (a, b) : xs) { body }`, and its struct and case twins, with an optional
# index in front: the pattern as written, for `desugar.aipl` to lower. A tuple
# pattern needs two names or more, which is checked here, where the span of the
# written pattern is at hand.
fn for_tuple(names: str[], index: str?, iterable: Expr, body: Expr, sp: Span) -> Stmt!ParseError {
    if (names.len() < 2) {
        return err(ParseError {
            message: "a tuple pattern needs at least 2 names, e.g. for (let (a, b) : expr) { ... }",
            span: sp,
        });
    };
    ok(for_destructure(ByTuple(names), index, iterable, body))
}

fn for_struct(
    struct_name: str,
    fields: str[],
    names: str[],
    index: str?,
    iterable: Expr,
    body: Expr,
) -> Stmt { for_destructure(ByStruct(struct_name, fields, names, false), index, iterable, body) }

fn for_arm(case_name: str, names: str[], index: str?, iterable: Expr, body: Expr) -> Stmt {
    for_destructure(ByCase(case_name, names), index, iterable, body)
}

fn for_destructure(pattern: Destructure, index: str?, iterable: Expr, body: Expr) -> Stmt {
    SForDestructure(pattern, index, iterable, body, join_spans(iterable.span, body.span))
}

# `wrap_stmt` — one statement and the rest of the block, folded into the chain
# the block is. Every arm here is a node whose last slot is that rest, or a
# `Seq` in front of it for the statements that produce no binding.
fn wrap_stmt(stmt: Stmt, acc: Expr) -> Expr {
    match (stmt) {
        SLet(name, name_span, ty, value) => {
            let span = join_spans(name_span, acc.span);
            at(Let(name, ty, value, acc), span).named_at(name_span)
        },
        SMut(name, name_span, ty, value) => {
            let span = join_spans(name_span, acc.span);
            at(LetMut(name, ty, value, acc), span).named_at(name_span)
        },
        // The statement's own span, not the usual join with the rest of the
        // block: an error against this node (an immutable target, an unknown
        // field) should point at the statement, not at whatever follows it.
        SAssign(lhs, value, span) => at(Assign(lhs, value, acc), span),
        SWhile(cond, body, while_span) => {
            let span = join_spans(while_span, acc.span);
            seq(at(While(cond, body), while_span), acc, span)
        },
        // The rest of the block is unreachable after a `return`, but it stays in
        // the tree so the checker and codegen see a well-formed block.
        SEffect(head, span) => seq(head, acc, join_spans(span, acc.span)),
        SReturn(value, ret_span) => {
            let span = join_spans(ret_span, acc.span);
            seq(at(Return(value), ret_span), acc, span)
        },
        SFor(name, name_span, index, iterable, body, for_span) => for_chain(
            name,
            name_span,
            index,
            iterable,
            body,
            for_span,
            acc,
        ),
        SForDestructure(pattern, index, iterable, body, span) => seq(
            at(ForPattern(pattern, iterable, body, index=index), span),
            acc,
            join_spans(iterable.span, acc.span),
        ),
        SLetDestructure(pattern, value, span) => at(
            LetPattern(pattern, value, acc),
            join_spans(span, acc.span),
        ),
        SLetElse(pattern, value, otherwise, span) => {
            let arm = MatchArm { pattern, body: acc, span };
            at(IfLet(arm, value, otherwise), join_spans(span, acc.span))
        },
    }
}

fn seq(head: Expr, rest: Expr, span: Span) -> Expr { at(Seq(head, rest), span) }

# The `for` loop and the rest of the block. Both binders are carried on the node
# — the element one and, for `for (let i, x : xs)`, the index one — and nothing
# is desugared here: what an index *is* depends on what is being iterated (a
# position over an array or a `str`, the key over a dict, which is indexed by its
# key exactly as an array is by its position), and the parser has no types. Mono
# is the first pass that knows, and `lower_for` there is where the index becomes
# whatever it is.
fn for_chain(
    name: str,
    name_span: Span,
    index: str?,
    iterable: Expr,
    body: Expr,
    for_span: Span,
    acc: Expr,
) -> Expr {
    let span = join_spans(name_span, acc.span);
    seq(at(For(name, iterable, body, index=index), for_span).named_at(name_span), acc, span)
}

# `while (cond) { body }`. No keyword or paren token carries a span of its own,
# so the statement is spanned from its condition through its body — the same
# choice `for` makes with its loop variable.
fn lower_while_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let cond = kid_expr(kids, 0, sp)?;
    let body = kid_expr(kids, 1, sp)?;
    let span = join_spans(cond.span, body.span);
    ok(AStmt(SWhile(cond, body, span)))
}

fn lower_return_stmt(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let value = kid_expr(kids, 0, sp)?;
    let span = value.span;
    ok(AStmt(SReturn(value, span)))
}

# `loop_inner` — a loop body admits no trailing expression, so every expression
# in it is an `expr;` statement and the body's own value is never read. An
# at-end body is a synthetic `0`, matching the loop expression's own result.
fn lower_loop_inner(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    if (kids.is_empty()) {
        return ok(AExpr(at(Num(0), 0..0)));
    };
    let head = kid(kids, 0, sp)?;
    let rest = kid_expr(kids, 1, sp)?;
    if (let AStmt(st) = head) {
        return ok(AExpr(wrap_stmt(st, rest)));
    };
    let value = as_expr(head, sp)?;
    let span = join_spans(value.span, rest.span);
    ok(AExpr(seq(value, rest, span)))
}

// ---------- lowering: match arms ----------

# `match_arm` — one written arm becomes one *or more* arms: an alternation
# `A | B => body` expands here into one arm per pattern, so no later stage ever
# sees an or-pattern. The body is shared, which is what makes the
# same-bindings check below necessary.
fn lower_match_arm(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let tsp = node.tok_span();
    let last = kids.len() - 1;
    let body = kid_expr(kids, last, sp)?;

    let subs = node.children;

    // `[p0, p1] => body` — an array-destructuring arm. Its own first token is
    // the `[`, which is what tells it from the `|`-separated alternation and
    // from the single-pattern arm; the elements are ordinary patterns, so the
    // grammar reaches them through `pattern` like every other slot.
    match (node.own_texts(src)) {
        ["[", ..] => {
            // A trailing `..` is not an element: it says the elements are only the
            // first ones.
            let rest = last > 0 && kids[last - 1].is_some_and(is_rest);
            let written = if (rest) { kids[..last - 1] } else { kids[..last] };
            let elems = written.try_map(|k| as_pat(k, sp))?;
            let pattern = array_pattern(elems, subs, rest, tsp)?;
            ok(AArms([MatchArm { pattern, body, span: tsp }]))
        },
        _ => {
            let heads = same_bindings(kids[..last].try_map(|k| as_pat(k, sp))?, subs, tsp)?;
            mut arms: MatchArm[] = [];
            for (let i, pat : heads) {
                let span = arm_span(pat, subs, i, tsp, heads.len() == 1);
                set arms.push(MatchArm { pattern: pat, body, span });
            }
            ok(AArms(arms))
        },
    }
}

# An array-destructuring arm's pattern: the simple `Array` when every element is
# a plain binder or a literal — the form codegen compiles directly, and the one
# that carries a span per element — and the nested `ArrayNested` otherwise. The
# same split `nested_or_ctor` makes between `Ctor` and `Nested`, for the same
# reason: an arm written the old way lowers exactly as it always did.
#
# With a trailing `..` the elements must be plain: the length test of "at least"
# is the simple form's, and the decision tree that compiles the nested form
# dispatches on exact lengths.
fn array_pattern(elems: Pat[], subs: Cst[], rest: bool, span: Span) -> Pat!ParseError {
    if (!elems.all(is_plain_elem)) {
        if (rest) {
            return err(ParseError {
                message: "an array pattern ending in `..` holds only names, `_` and literals",
                span,
            });
        };
        return ok(PatArrayNested(elems));
    };
    mut exprs: Expr[] = [];
    for (let i, p : elems) {
        set exprs.push(plain_elem_expr(p, sub_span(subs, i, 0..0)));
    }
    if (rest) {
        return ok(PatArrayRest(exprs));
    };
    ok(PatArray(exprs))
}

fn is_rest(v: Ast) -> bool { if (let ARest(..) = v) { true } else { false } }

# Whether an element needs no sub-pattern machinery: a binder name, `_`, or a
# literal. A bare name that is *not* a binder — `none`, or a capitalised case —
# is a constructor, so it is not plain and forces the nested form, where it
# means the case rather than a name to bind.
fn is_plain_elem(self: Pat) -> bool {
    match (self) {
        Ctor(name, bindings, ignore) => bindings.is_empty() && !ignore && name.is_binder_name(),
        Wildcard | Str(..) | Char(..) | Int(..) => true,
        Array(..) | ArrayRest(..) | ArrayNested(..) | Tuple(..) | Nested(..) | Struct(..) => false,
    }
}

# A plain element as the expression the simple `Array` form holds, spanned where
# it was written. Total over what `is_plain_elem` admits; anything else has
# already taken the nested path.
fn plain_elem_expr(self: Pat, span: Span) -> Expr {
    match (self) {
        Ctor(name, _, _) => at(Ident(name), span),
        Wildcard => at(Ident("_"), span),
        Str(s) => at(Str(s), span),
        Char(c) => at(Char(c), span),
        Int(n) => at(Num(n), span),
        Array(..) | ArrayRest(..) | ArrayNested(..) | Tuple(..) | Nested(..) | Struct(..) => at(
            Ident("_"),
            span,
        ),
    }
}

# An arm's span is its *pattern's*, so a diagnostic points at what selected the
# arm rather than at everything it does. The one exception is a char pattern,
# whose span is a single quoted byte — too narrow to read — so it takes the
# whole arm.
fn arm_span(pat: Pat, subs: Cst[], i: u64, tsp: Span, alone: bool) -> Span {
    if (let PatChar(..) = pat) {
        if (alone) {
            return tsp;
        };
    };
    sub_span(subs, i, tsp)
}

# Every alternative of one arm must bind the same names in the same order, so
# the shared body means the same thing whichever matched. Two cases whose
# payloads line up may therefore group by naming them alike; alternatives that
# disagree are refused here rather than left to fail as an unbound name
# somewhere in the body.
fn same_bindings(heads: Pat[], subs: Cst[], tsp: Span) -> Pat[]!ParseError {
    match (heads) {
        [first_pat, ..] => {
            let want = first_pat.pat_bindings();
            for (let i, pat : heads) {
                let got = pat.pat_bindings();
                if (got != want) {
                    return err(ParseError {
                        message: `alternatives of one arm must bind the same names: {first_pat.pat_label()} binds {want.binder_list()}, but {pat.pat_label()} binds {got.binder_list()}`,
                        span: join_spans(sub_span(subs, 0, tsp), sub_span(subs, i, tsp)),
                    });
                };
            }
            ok(heads)
        },
        _ => ok(heads),
    }
}

// ---------- lowering: patterns ----------
//
// The second slice, and the first that reads a literal's *value* rather than
// its spelling. `str_lit_value`/`char_lit_value` live beside the lexer rules
// that decode the same bytes on the way in, because a `build` is handed the
// source and a span and has to strip the delimiters for itself.

# Whether a declaration's own tokens open with `pub`.
fn starts_pub(toks: str[]) -> bool {
    match (toks) {
        ["pub", ..] => true,
        _ => false,
    }
}

# The span of a node's first own token, or `fallback` for a node that matched none.
fn first_tok(self: Parts, fallback: Span) -> Span {
    match (self.tokens) {
        [first, ..] => first,
        _ => fallback,
    }
}

# The span of a node's second own token — the name after a declaration's keyword.
fn second_tok(self: Parts, fallback: Span) -> Span {
    match (self.tokens) {
        [_, second, ..] => second,
        _ => fallback,
    }
}

fn as_pat(v: Ast, span: Span) -> Pat!ParseError {
    if (let APat(pat) = v) {
        return ok(pat);
    };
    if (let ARest(at) = v) {
        return err(ParseError {
            message: "`..` is only allowed as the last element of an array pattern, as in `[a, ..]`",
            span: at,
        });
    };
    err(wrong_kind("a pattern", v, span))
}

# `V.A` is one name with a dot in it — the qualification is not a separate field
# on the AST, so a qualified case and a bare one are the same shape from here on. Anything but a `.` in second
# position means this pattern was not qualified.
fn qualified_name(toks: str[], head: str) -> str {
    match (toks) {
        [_, ".", tail, ..] => `{head}.{tail}`,
        _ => head,
    }
}

# `ctor_payload` — `Ctor(p, q)` matches each slot against a pattern, `Ctor(..)`
# says the case carries a payload this arm does not read. The `..` alternative
# has no child and is read off this node's own token; the other's slots are its
# `pattern` children.
fn lower_ctor_payload(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let no_slots: Pat[] = [];
    match (node.own_texts(src)) {
        ["..", ..] => ok(APayload(no_slots, true)),
        _ => ok(APayload(kids.try_map(|k| as_pat(k, sp))?, false)),
    }
}

# `pattern` — the seven alternatives, told apart by the first token they matched.
#
# A literal is what its delimiter says it is; everything else opens with an
# identifier or `none`, after which the payload child (present or not) and the
# `.` (present or not) settle the rest. `_` lexes as an ordinary identifier, so
# the wildcard arrives here as a nullary name and is recognised by spelling —
# and only when nullary, since `_(x)` is a constructor named `_`.
fn lower_pattern(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    match (toks) {
        [head, ..] => {
            if (head.starts_with('"')) {
                return ok(APat(PatStr(str_lit_value(head))));
            };

            // A backtick literal is a run of tokens — the delimiters and the text
            // between them — so its value comes from the whole run's source rather than
            // from the first token, which is only the opening delimiter.
            if (head.starts_with('`')) {
                return ok(APat(PatStr(str_lit_value(src[node.tok_span()]))));
            };
            if (head.starts_with('\'')) {
                let c = char_lit_value(head).value_or_err(ParseError {
                    message: "a char pattern holds exactly one character",
                    span: sp,
                })?;
                return ok(APat(PatChar(c)));
            };
            // A tuple pattern: the parenthesized run of two or more patterns.
            if (head == "..") {
                return ok(ARest(sp));
            };
            if (head == "(") {
                return ok(APat(PatTuple(kids.try_map(|k| as_pat(k, sp))?)));
            };
            if (let some(n) = head.int_parse()) {
                return ok(APat(PatInt(n)));
            };
            if (toks[1] == some("{")) {
                let FieldBinders { fields, names } = field_binders_of(toks, 2);
                return ok(APat(PatStruct(head, fields, names)));
            };
            let name = qualified_name(toks, head);
            if (kids.is_empty()) {
                if (name == "_") {
                    return ok(APat(PatWildcard));
                };
                return ok(APat(PatCtor(name)));
            };
            let payload = kid(kids, 0, sp)?;
            if (let APayload(slots, ignore_payload) = payload) {
                if (ignore_payload) {
                    return ok(APat(PatCtor(name, ignore_payload=true)));
                };
                return ok(APat(nested_or_ctor(name, slots)));
            };
            err(wrong_kind("a constructor payload", payload, sp))
        },
        _ => err(ParseError { message: "a pattern matched no token", span: sp }),
    }
}

// ---------- lowering: items ----------
//
// The last slice, and the most mechanical: an item production reads its own
// tokens for a name and its children for everything else. Two things here are
// not mechanical, and both are places where a declaration's halves only meet at
// the top:
//
//   - **Documentation attaches at `item`**, not at the declaration, because the
//     `# ..` lines are in front of it. That is also where an import is refused
//     documentation, since it brings a name in rather than declaring one.
//   - **The `{ field: value }` body shorthand resolves at `function`**, which
//     is the first place the return type and the field list are both in scope.
//     What it builds is exactly the `Construct` the long form parses to, so
//     nothing downstream sees the sugar.

fn as_name(v: Ast, span: Span) -> str!ParseError {
    if (let AName(n) = v) {
        return ok(n);
    };
    err(wrong_kind("a name", v, span))
}

fn as_item(v: Ast, span: Span) -> Item!ParseError {
    if (let AItem(it) = v) {
        return ok(it);
    };
    err(wrong_kind("an item", v, span))
}

fn as_import(v: Ast, span: Span) -> ImportDecl!ParseError {
    if (let AImport(d) = v) {
        return ok(d);
    };
    err(wrong_kind("an import", v, span))
}

fn as_import_name(v: Ast, span: Span) -> ImportName!ParseError {
    if (let AImportName(n) = v) {
        return ok(n);
    };
    err(wrong_kind("an imported name", v, span))
}

fn as_type_params(v: Ast, span: Span) -> TypeParam[]!ParseError {
    if (let ATypeParams(tps) = v) {
        return ok(tps);
    };
    err(wrong_kind("a type parameter list", v, span))
}

fn as_type_param(v: Ast, span: Span) -> TypeParam!ParseError {
    if (let ATypeParam(tp) = v) {
        return ok(tp);
    };
    err(wrong_kind("a type parameter", v, span))
}

fn as_field_decl(v: Ast, span: Span) -> FieldDecl!ParseError {
    if (let AFieldDecl(f) = v) {
        return ok(f);
    };
    err(wrong_kind("a field declaration", v, span))
}

fn as_variant_case(v: Ast, span: Span) -> VariantCase!ParseError {
    if (let AVariantCase(c) = v) {
        return ok(c);
    };
    err(wrong_kind("a variant case", v, span))
}

fn as_case_param(v: Ast, span: Span) -> CaseParam!ParseError {
    if (let ACaseParam(cp) = v) {
        return ok(cp);
    };
    err(wrong_kind("a case parameter", v, span))
}

# `program` — every item in the file, and the file's own documentation.
#
# The module doc block arrives here rather than being matched here: `item` is
# what holds the `# ..` lines, and it hands up any block a blank line detached
# from its declaration (see `lower_item`). This is where that block can be
# judged, because documenting the *file* is only open to the block at the top of
# it; a detached block anywhere below documents nothing and is refused.
#
# A single parsed file has no merged-source map; the loader fills one in when it
# flattens several files together.
fn lower_program(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    mut items: Item[] = [];
    mut doc: str? = none;
    for (let i, k : kids) {
        if (let ADetachedDoc(text, at, it) = k) {
            if (0 < i) {
                return err(ParseError {
                    message: "this `# ..` block documents nothing — a blank line detaches it from the declaration below, and only the block at the top of a file, which documents the file, may stand apart",
                    span: at,
                });
            };
            set doc = some(text);
            set items.push(it);
        } else {
            set items.push(as_item(k, sp)?);
        };
    }
    ok(AProgram(Program { items, doc }))
}

# `item` — a declaration and the `# ..` lines in front of it. The lines are this
# production's own tokens, which is what makes documentation attach here rather
# than in each declaration.
#
# Attachment is adjacency: a blank line under a block detaches it, and a
# detached block documents the file rather than the declaration below it. So the
# lines are split at the last blank line — the run written directly above the
# declaration documents it, and anything in front of that goes up to `program`,
# the only production that can see whether it sits at the top of the file.
fn lower_item(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let decl_at = node.children.first()$child_span().value_or(sp);
    let DocSplit { detached, attached } = split_doc_lines(src, node.tokens, decl_at.start);
    let item = lower_decl(src, kid(kids, 0, sp)?, attached, sp)?;
    match (detached) {
        [first, ..] => {
            let end = detached.last().value_or(first).end;
            ok(ADetachedDoc(module_doc_block(src, detached), first.start..end, item))
        },
        _ => ok(AItem(item)),
    }
}

# The declaration under an `item`, carrying the `# ..` lines written directly
# above it. Every kind but an `import` has somewhere to put them; an `import`
# declares nothing, so a block adjacent to one documents nothing — and the fix
# is the blank line that would make it the file's own documentation, which is
# what the message says.
fn lower_decl(src: str, decl: Ast, lines: Span[], sp: Span) -> Item!ParseError {
    let docs = doc_block(lines.map(|t| src[t]));
    if (let AFunction(f) = decl) {
        return ok(ItemFn(Function { ..f, doc: docs }));
    };
    if (let AStruct(st) = decl) {
        return ok(ItemStruct(StructDecl { ..st, doc: docs }));
    };
    if (let AVariant(v) = decl) {
        return ok(ItemVariant(VariantDecl { ..v, doc: docs }));
    };
    if (let ARefinement(r) = decl) {
        return ok(ItemRefinement(RefinementDecl { ..r, doc: docs }));
    };
    if (let AConst(c) = decl) {
        return ok(ItemConst(ConstDecl { ..c, doc: docs }));
    };
    let d = as_import(decl, sp)?;
    if (docs.is_some()) {
        return err(ParseError {
            message: "an import cannot be documented — `# ..` lines attach to the declaration below them and an `import` declares nothing; a blank line under the block makes it the file's documentation instead",
            span: lines.first().value_or(sp),
        });
    };
    ok(ItemImport(d))
}

# A run of `# ..` lines split at the last blank line in it: the part written
# directly above the declaration, and everything detached from it.
struct DocSplit { detached: Span[], attached: Span[] }

# Split the `# ..` lines an `item` matched against the declaration starting at
# `decl_at`. Read from the back, since it is the *last* blank line that decides:
# one between the block and the declaration leaves nothing attached, which is
# how a file's leading block comes to document the file rather than its first
# declaration.
fn split_doc_lines(src: str, lines: Span[], decl_at: u64) -> DocSplit {
    mut cut = lines.len();
    while (0 < cut) {
        let after = lines[cut - 1]$end.value_or(decl_at);
        if (blank_line_follows(src, after)) {
            return DocSplit { detached: lines[..cut], attached: lines[cut..] };
        };
        set cut--;
    }
    DocSplit { detached: [], attached: lines }
}

# Whether a blank line follows byte `at`: two newlines before any other
# character. This is the whole of what detaches a `# ..` block from what follows
# it — and it reads *whitespace only*, so a `//` comment written in the gap
# neither makes a blank line nor hides one.
fn blank_line_follows(src: str, at: u64) -> bool {
    let rest = src[at..];
    1 < rest[..rest.count_while(is_space)].count('\n')
}

# The detached lines as one doc block. Like `doc_block`, but the blank lines
# that separated its runs are kept as empty lines: two runs above a file's first
# item read as two paragraphs, exactly as a bare `#` line inside one run does.
fn module_doc_block(src: str, lines: Span[]) -> str {
    mut out: str[] = [];
    for (let i, l : lines) {
        set out.push(doc_line_value(src[l]));
        if (i + 1 < lines.len() && blank_line_follows(src, l.end)) {
            set out.push("");
        };
    }
    out.join(sep="\n")
}

# A run of `# text` lines, joined by newline and nothing else — so a blank `#`
# line contributes an empty line, which is what lets a doc block have
# paragraphs. `doc_line_value` strips the marker, beside the lexer rule that
# strips it on the way in.
fn doc_block(lines: str[]) -> str? {
    if (lines.is_empty()) {
        return none;
    };
    some(lines.map(doc_line_value).join(sep="\n"))
}

# `import_decl` — the names, and where they come from. The source is the token
# after `from`, which is the second-to-last this production matched.
# `const_decl` — `pub let NAME: T = <literal>;`. The annotation is a child when
# one was written, so the value is the last child either way; `pub` and the name
# are read off this production's own tokens. The two rules a constant has —
# ALL_CAPS, and a literal value — are the loader's, which is where a name is
# resolved and where the substitution that makes them matter happens.
fn lower_const_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let spans = node.tokens;
    let is_pub = starts_pub(node.own_texts(src));
    let at_name: u64 = if (is_pub) { 2 } else { 1 };
    let annotated = kids.len() == 2;
    let ty = if (annotated) { some(as_ty(kid(kids, 0, sp)?, sp)?) } else { none };
    let value = kid_expr(kids, if (annotated) { 1 } else { 0 }, sp)?;
    ok(AConst(ConstDecl {
        // The name carries its own span — what the diagnostics checking a
        // constant's ALL_CAPS and literal-value rules point at.
        name: span_str(src, spans[at_name].value_or(node.tok_span())),
        is_pub,
        ty,
        value,
        // The `# ..` lines above the declaration belong to `item`, which fills
        // this in; this production never sees them.
        doc: none,
    }))
}

fn lower_import_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let toks = node.own_texts(src);
    let spans = node.tokens;
    let names = kids.try_map(|k| as_import_name(k, sp))?;
    let i = toks.len() - 2;
    let text = toks[i].value_or("");
    let span = spans[i].value_or(node.tok_span());
    if (text == "builtins") {
        return ok(AImport(ImportDecl { names, source: Builtins, source_span: span }));
    };
    ok(AImport(ImportDecl { names, source: Path(str_lit_value(text)), source_span: span }))
}

# What refusing a bare operator import says: the operator, and the aliased
# import to write instead — every flavor where there is a choice to make
# (`wrapping_add as +` or `saturating_add as +`), the one form where there is
# not (`equal as ==`). The alternatives come from `operator_named_forms`, so a
# new operator or flavor keeps its own diagnostic correct without touching
# this.
fn bare_operator_import(op: str) -> str {
    let forms = op.operator_named_forms();
    let options = forms.map(|f| `\`{f} as {op}\``).join(sep=" or ");
    let pick = if (1 < forms.len()) {
        "pick a semantics and import it aliased, e.g. "
    } else {
        "import it aliased: "
    };
    `the "{op}" operator has no bare form; {pick}{options} from builtins`
}.test({
    assert(
        bare_operator_import(
            "+",
        ) == """the "+" operator has no bare form; pick a semantics and import it aliased, e.g. `wrapping_add as +` or `saturating_add as +` from builtins""",
    );
    assert(
        bare_operator_import(
            "==",
        ) == """the "==" operator has no bare form; import it aliased: `equal as ==` from builtins""",
    );
})

# What a statement-opening token straight after an expression means: the `;`
# between them is missing. `next` is that token, which the error underlines.
fn missing_semicolon(next: str) -> str {
    `missing \`;\` before \`{next}\`: every statement ends with one, even an \`if\` or \`match\` whose value is unused`
}.test({
    assert(
        missing_semicolon(
            "print",
        ) == "missing `;` before `print`: every statement ends with one, even an `if` or `match` whose value is unused",
    );
})

# `import_name` — a name, or an aliased name. The span covers the *exported*
# name, which is where an "is not exported" error points. A bare operator never
# gets here: the grammar refuses it before lowering.
fn lower_import_name(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let name_span = node.first_tok(node.tok_span());
    match (node.own_texts(src)) {
        // `a as b` spells the alias as a token...
        [name, "as", alias, ..] => {
            ok(AImportName(ImportName { name, alias: some(alias), span: name_span }))
        },
        // ...and `a as +` as the `operator` production, which is a child.
        [name, "as"] => {
            let alias = as_name(kid(kids, 0, sp)?, sp)?;
            ok(AImportName(ImportName { name, alias: some(alias), span: name_span }))
        },
        [name, ..] => ok(AImportName(ImportName { name, alias: none, span: name_span })),
        _ => err(ParseError { message: "an import name matched no token", span: sp }),
    }
}

fn lower_effect(src: str, node: Parts, kids: Ast[]) -> Ast {
    match (node.own_texts(src)) {
        [_, effect, ..] => AName(effect),
        _ => AName(""),
    }
}

fn lower_type_params(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(ATypeParams(kids.try_map(|k| as_type_param(k, sp))?))
}

# `type_param` — `name`, `name: bound`, or `name: variant`, with a default type after
# `=` for any of them. A bare name takes the `any` bound, which almost every
# generic uses.
fn lower_type_param(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    // The default is the one child the rule has: a type.
    let default: Ty? = match (kids) {
        [written, ..] => some(as_ty(written, sp)?),
        _ => none,
    };
    match (node.own_texts(src)) {
        [name, ":", "variant", ..] => {
            ok(ATypeParam(TypeParam { name, bound: BoundVariant, default }))
        },
        [name, ":", bound_name, ..] => {
            let bound = bound_from_name(bound_name).value_or_err(ParseError {
                message: `unknown type parameter bound "{bound_name}"; expected "any" or "ord"`,
                span: node.tokens[2].value_or(node.tok_span()),
            })?;
            ok(ATypeParam(TypeParam { name, bound, default }))
        },
        // `name`, or `name = ty`: no bound was written.
        [name, ..] => ok(ATypeParam(TypeParam { name, bound: BoundAny, default })),
        _ => err(ParseError { message: "a type parameter matched no token", span: sp }),
    }
}

# `param` — the eight shapes. The two destructuring ones carry a field list for
# the body to bind off the argument, and the unnamed one also introduces a
# scrutinee the caller never named.
fn lower_param(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let name_span = node.first_tok(node.tok_span());

    // `Point { x, y }` and `p: Point { x, y }` — the destructuring forms. They
    // are the alternatives holding a repetition, so their positions do not line
    // up one per sub-rule and they are recognised by their `{` rather than by
    // their shape.
    let toks = node.own_texts(src);
    match (toks) {
        [struct_name, "{", ..] => ok(destructured_param(
            `__spat${name_span.start}`,
            struct_name,
            field_binders_of(toks, 2),
            name_span,
        )),
        [name, ":", struct_name, "{", ..] => ok(destructured_param(
            name,
            struct_name,
            field_binders_of(toks, 4),
            name_span,
        )),
        [case_name, "(", ..] => ok(arm_param(
            `__cpat${name_span.start}`,
            case_name,
            case_pattern(case_name, kid(kids, 0, sp)?, sp)?,
            name_span,
        )),
        [name, ":", case_name, "(", ..] => ok(arm_param(
            name,
            case_name,
            case_pattern(case_name, kid(kids, 0, sp)?, sp)?,
            name_span,
        )),
        _ => named_param_by_shape(src, node, kids, sp),
    }
}

# A parameter named `name`, of the type `case_name` — the case of its variant and
# no other — whose payload is bound to `names` at the top of the body.
fn arm_param(name: str, case_name: str, pattern: Pat, span: Span) -> Ast {
    let param = Param {
        name,
        ty: TyNamed(case_name),
        mutable: false,
        arity: One,
        default: none,
        implicit_some: false,
    };
    AParam(Param { ..param, pattern: some(ParamPattern { pattern: pattern.destructure(), span }) })
}

# The pattern `case_name(..slots..)` writes: its `payload` child holds the slots, or
# says they are ignored.
fn case_pattern(case_name: str, payload: Ast, span: Span) -> Pat!ParseError {
    let APayload(slots, ignore_payload) = payload else {
        return err(wrong_kind("a constructor payload", payload, span));
    };
    if (ignore_payload) {
        return ok(PatCtor(case_name, ignore_payload=true));
    };
    ok(nested_or_ctor(case_name, slots))
}

# A pattern as the binding it makes: a case whose slots are all plain names is the
# `ByCase` form, and anything else is taken as the pattern it is.
fn destructure(self: Pat) -> Destructure {
    if (let Ctor(case_name, bindings, ignore_payload) = self) {
        if (bindings.is_nonempty() && !ignore_payload) {
            return ByCase(case_name, bindings);
        };
    };
    ByPattern(self)
}

# A parameter named `name`, of the struct `struct_name`, whose `fields` are bound
# to `names` at the top of the body.
fn destructured_param(
    name: str,
    struct_name: str,
    FieldBinders { fields, names },
    span: Span,
) -> Ast {
    let param = Param {
        name,
        ty: TyNamed(struct_name),
        mutable: false,
        arity: One,
        default: none,
        implicit_some: false,
    };
    let pattern = ByStruct(struct_name, fields, names, false);
    AParam(Param { ..param, pattern: some(ParamPattern { pattern, span }) })
}

# The six named shapes. Every sub-rule is one position, and *which*
# positions hold a lowered child is what tells them apart — `name: T*` puts
# its type third and `mut name: T` fourth, `name?: T = d` puts its type
# fourth where `name: T* = d` puts it third. So no arm counts tokens, hunts
# for a `*` or an `=`, or shifts an index past an optional `mut`.
fn named_param_by_shape(src: str, node: Parts, kids: Ast[], sp: Span) -> Ast!ParseError {
    match (node.slots()) {
        // `mut name: T` — leads with the keyword, and takes neither a default
        // nor a variadic marker.
        [Tok(_), n, Tok(_), Sub(_)] => named_param(src, kids, n, sp, mutable=true),
        // `name: T* = d`, `name: T+ = d`
        [n, Tok(_), Sub(_), v, Tok(_), Sub(_)] => named_param(
            src,
            kids,
            n,
            sp,
            marker=v.slot_text(src),
            has_default=true,
        ),
        // `name?: T = d`
        [n, Tok(_), Tok(_), Sub(_), Tok(_), Sub(_)] => named_param(
            src,
            kids,
            n,
            sp,
            implicit_some=true,
            has_default=true,
        ),
        // `name: T = d`
        [n, Tok(_), Sub(_), Tok(_), Sub(_)] => named_param(src, kids, n, sp, has_default=true),
        // `name: T*`, `name: T+`
        [n, Tok(_), Sub(_), v] => named_param(src, kids, n, sp, marker=v.slot_text(src)),
        // `name: T`
        [n, Tok(_), Sub(_)] => named_param(src, kids, n, sp),
        _ => err(ParseError { message: "a parameter matched no alternative", span: sp }),
    }
}

# A named parameter, from the pieces its shape supplied: the name token, whether
# a `mut` or a `?` preceded it, the variadic marker if one was written, and
# whether a default followed. The type is always the first interior child and a
# default the second, in every one of the six shapes.
#
# The stored type is what the *body* sees: a variadic stores the sequence its
# elements arrive in, and a `k?: T` stores the `T?` a caller's bare `T` is
# wrapped into.
fn named_param(
    src: str,
    kids: Ast[],
    name: Slot,
    sp: Span,
    mutable: bool = false,
    implicit_some: bool = false,
    has_default: bool = false,
    marker: str = "",
) -> Ast!ParseError {
    let arity = match (marker) {
        "*" => ZeroOrMore,
        "+" => OneOrMore,
        _ => One,
    };
    let written = as_ty(kid(kids, 0, sp)?, sp)?;
    let ty = match (arity) {
        ZeroOrMore => variadic_seq_ty(written),
        OneOrMore => nonempty_seq_ty(written),
        One => if (implicit_some) { TyOptional(written) } else { written },
    };
    let default = if (has_default) { some(kid_expr(kids, 1, sp)?) } else { none };
    ok(AParam(Param {
        name: name.slot_text(src),
        ty,
        mutable,
        arity,
        default,
        implicit_some,
        name_span: name.slot_span().value_or(sp),
    }))
}

# `x: T*` stores the sequence type: `str` when the element is `char` (an AIPL
# string *is* the char sequence), otherwise `T[]`. The element type stays
# recoverable from it.
fn variadic_seq_ty(elem: Ty) -> Ty {
    if (let TyPrimitive(p) = elem) {
        if (p == CharPrim) {
            return TyPrimitive(StrPrim);
        };
    };
    TyArray(elem)
}

# `x: T+` stores the sequence type refined to what the body may rely on:
# `T[] without []`. A `char+` stays `str`, since a `str` has no refinement to
# take yet — the call site is still held to one element or more.
fn nonempty_seq_ty(elem: Ty) -> Ty {
    let seq = variadic_seq_ty(elem);
    if (let TyArray(..) = seq) { TyWithout(seq, EmptyArray) } else { seq }
}

# `fn_body` — a value block, or the struct-literal shorthand, whose type name
# comes from the declared return type rather than from the source.
fn lower_fn_body(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let child = kid(kids, 0, sp)?;
    if (let AFieldInits(fields) = child) {
        return ok(ABody(PConstruct(fields, sub_span(node.children, 0, node.tok_span()))));
    };
    ok(ABody(PBlock(as_expr(child, sp)?)))
}

# `construct_fields` — the shorthand body's field list. Its first field is
# spelled by the alternative that matched; the rest are ordinary `field_init`s.
fn lower_construct_fields(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let name_span = node.first_tok(node.tok_span());
    match (node.own_texts(src)) {
        // `{ ..base, rest.. }` — the spread rides as a nameless init holding an
        // `Spread`, exactly as in a written struct literal, so the loader expands
        // it with no knowledge that it came from the shorthand.
        ["..", ..] => {
            let base = kid_expr(kids, 0, sp)?;
            let span = base.span;
            let first = FieldInit { name: "", value: at(Spread(base), span) };
            ok(AFieldInits([first, ..kids[1..].try_map(|k| as_field_init(k, sp))?]))
        },
        // `{ name, rest.. }` — a leading shorthand field, which is also how the
        // trailing-comma form `{ x, }` spells a lone one.
        [head, ",", ..] => {
            let first = FieldInit {
                name: head,
                value: at(Ident(head), name_span).named_at(name_span),
                name_span,
            };
            ok(AFieldInits([first, ..kids.try_map(|k| as_field_init(k, sp))?]))
        },
        [head, ..] => {
            let first = FieldInit { name: head, value: kid_expr(kids, 0, sp)?, name_span };
            ok(AFieldInits([first, ..kids[1..].try_map(|k| as_field_init(k, sp))?]))
        },
        _ => err(ParseError { message: "a body shorthand matched no token", span: sp }),
    }
}

# `fn_attr` — `.test({ .. })` or `.performance({ .. })`, the only two. The
# argument shape is fixed by the production; what is checked here is that the
# name matches it. Every string-argument attribute is refused, which is the
# whole reason that alternative parses: so each can be refused *by name*.
fn lower_fn_attr(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    match (node.own_texts(src)) {
        [_, name, ..] => {
            let name_span = node.second_tok(node.tok_span());
            if (kids.is_empty()) {
                if (name == "doc") {
                    return err(ParseError {
                        message: """`.doc("..")` is no longer a function attribute — write the documentation as `# ..` lines above the declaration, which also documents structs and variants""",
                        span: name_span,
                    });
                };
                if (name == "test" || name == "performance") {
                    return err(ParseError {
                        message: `\`.{name}\` takes a \`\{ .. }\` block, not a string argument`,
                        span: name_span,
                    });
                };
                return err(ParseError { message: unknown_attr(name), span: name_span });
            };
            if (name != "test" && name != "performance") {
                return err(ParseError { message: unknown_attr(name), span: name_span });
            };
            let TestBlock { fns, body } = as_test_block(kid(kids, 0, sp)?, sp)?;

            // Two helpers of one name would hoist to one name; refuse it here, where
            // the names are still the ones written.
            for (let i, f : fns) {
                if (fns[..i].any(|g| g.name.text == f.name.text)) {
                    return err(ParseError {
                        message: `duplicate function "{f.name.text}" in this \`.{name}\` block`,
                        span: name_span,
                    });
                };
            }
            ok(AAttr(FnAttr { name, body: body.value_or(at(Unit, 0..0)), fns, span: name_span }))
        },
        _ => err(ParseError { message: "a function attribute matched no token", span: sp }),
    }
}

# `test_block` — the braces around a `test_body`: the chain's value is located
# the way `block` does it, and the functions ride along.
fn lower_test_block(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let brace = node.first_tok(node.tok_span());
    let TestBlock { fns, body } = as_test_block(kid(kids, 0, sp)?, sp)?;
    let repaired = repair_block_value(body.value_or(at(Unit, 0..0)), brace);
    ok(ATestBlock(TestBlock { fns, body: some(Expr { ..repaired.0, value_span: repaired.1 }) }))
}

# `test_body` — `block_body` with one more alternative: a function declaration,
# which is set aside rather than folded into the chain. A `pub` helper, or one
# carrying a `.test` of its own, is refused: the block is the only place the
# function exists, so neither could mean anything.
fn lower_test_body(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    if (kids.is_empty()) {
        return ok(ATestBlock(TestBlock { fns: [], body: none }));
    };
    if (let AFunction(f) = kid(kids, 0, sp)?) {
        // The refusals point at the declaration — the first child node.
        let fn_span = node.children.first()$child_span().value_or(sp);
        if (f.is_pub) {
            return err(ParseError {
                message: `a function inside a \`.test\` block cannot be \`pub\`: "{f.name.text}" exists only for that test`,
                span: fn_span,
            });
        };
        if (f.test_body.is_some()) {
            return err(ParseError {
                message: `a function inside a \`.test\` block cannot carry a \`.test\` of its own: "{f.name.text}" is test code already`,
                span: fn_span,
            });
        };
        if (f.performance.is_some()) {
            return err(ParseError {
                message: `a function inside a \`.test\` block cannot carry a \`.performance\` of its own: "{f.name.text}" is test code already`,
                span: fn_span,
            });
        };
        let rest = as_test_block(kid(kids, 1, sp)?, sp)?;
        return ok(ATestBlock(TestBlock { ..rest, fns: [f, ..rest.fns] }));
    };
    if (let AStmt(st) = kid(kids, 0, sp)?) {
        let rest = as_test_block(kid(kids, 1, sp)?, sp)?;
        return ok(ATestBlock(TestBlock {
            ..rest,
            body: some(wrap_stmt(st, rest.body.value_or(at(Unit, 0..0)))),
        }));
    };
    let value = kid_expr(kids, 0, sp)?;
    let tail = as_test_block(kid(kids, 1, sp)?, sp)?;
    let body = tail.body
        .map(|rest| at(Seq(value, rest), join_spans(value.span, rest.span)))
        .value_or(value);
    ok(ATestBlock(TestBlock { ..tail, body: some(body) }))
}

# `test_tail` — `block_tail`'s twin: nothing followed (the expression before it
# was the value), or the rest of the block, which is a chain even when empty.
fn lower_test_tail(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    if (kids.is_empty()) {
        return ok(ATestBlock(TestBlock { fns: [], body: none }));
    };
    let rest = as_test_block(kid(kids, 0, sp)?, sp)?;
    ok(ATestBlock(TestBlock { ..rest, body: some(rest.body.value_or(at(Unit, 0..0))) }))
}

fn as_test_block(v: Ast, span: Span) -> TestBlock!ParseError {
    if (let ATestBlock(b) = v) {
        return ok(b);
    };
    err(wrong_kind("a test block", v, span))
}

fn unknown_attr(name: str) -> str {
    `unknown function attribute "{name}"; only \`.test(\{ .. })\` and \`.performance(\{ .. })\` are supported`
}

fn lower_struct_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(AStruct(StructDecl {
        name: span_str(src, node.second_tok(sp)),
        // The `item` production is what has the docs; this one is reached
        // through it, so the slot is filled in there.
        doc: none,
        type_vars: as_type_params(kid(kids, 0, sp)?, sp)?,
        fields: kids[1..].try_map(|k| as_field_decl(k, sp))?,
    }))
}

fn lower_field_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();

    // Five positions is `name: T = default`, three is `name: T` — the rule's
    // two alternatives, told apart by their own shape. Counting interior
    // children and reading the first own token are the same question asked
    // sideways, and an arm per alternative is the rule read back.
    match (node.slots()) {
        [n, _, t, _, d] => ok(AFieldDecl(FieldDecl {
            name: n.slot_name(src, sp),
            ty: as_ty(slot_kid(t, kids, sp)?, sp)?,
            default: some(slot_expr(d, kids, sp)?),
        })),
        [n, _, t] => ok(AFieldDecl(FieldDecl {
            name: n.slot_name(src, sp),
            ty: as_ty(slot_kid(t, kids, sp)?, sp)?,
            default: none,
        })),
        _ => err(ParseError { message: "a field declaration matched no alternative", span: sp }),
    }
}

# The lowered child a slot names, or a refusal — `kid`'s counterpart for a
# positional match, where a slot that should name a `Named` reference holds a
# token instead. A slot carries the child's *index*, so this is `kid` with the
# index read off the position rather than written out by hand.
fn slot_kid(self: Slot, kids: Ast[], span: Span) -> Ast!ParseError {
    let at = self
        .slot_child()
        .value_or_err(ParseError {
            message: "this position holds a token, not a lowered child",
            span,
        })?;
    kid(kids, at, span)
}

# `slot_kid` as an expression, the way `kid_expr` is `kid` as one.
fn slot_expr(self: Slot, kids: Ast[], span: Span) -> Expr!ParseError {
    as_expr(slot_kid(self, kids, span)?, span)
}

# `variant_decl` — the name, the type parameters, and the cases. The cases'
# `# ..` lines are this node's own tokens (they ride with the `|` separator, see
# the rule), so each case is given the lines written between the previous case
# and itself here, where both are in hand.
fn lower_variant_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let case_nodes = node.children[1..];
    mut cases: VariantCase[] = [];
    mut after = sp.start;
    for (let i, k : kids[1..]) {
        let c = as_variant_case(k, sp)?;
        let at = case_nodes[i]$child_span().value_or(sp);
        for (let case : cases) {
            if (c.name.text == case.name.text) {
                return err(ParseError {
                    message: `duplicate case "{c.name.text}"`,
                    span: c.name.span,
                });
            };
        }
        set cases.push(VariantCase {
            ..c,
            doc: doc_block(doc_lines_between(src, node, after, at.start)),
        });
        set after = at.end;
    }
    ok(AVariant(VariantDecl {
        name: span_str(src, node.second_tok(sp)),
        doc: none,
        type_vars: as_type_params(kid(kids, 0, sp)?, sp)?,
        cases,
    }))
}

# `refinement_decl` — the name, the type parameters, the refined head and what
# it leaves out. The name is the second token, as in `variant_decl`; the type
# is rebuilt as the `Without` the clause spells, which is the whole of what the
# declaration stands for.
fn lower_refinement_decl(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let head = as_ty(kid(kids, 1, sp)?, sp)?;
    let x = as_exclusion(kid(kids, 2, sp)?, sp)?;
    ok(ARefinement(RefinementDecl {
        name: span_str(src, node.second_tok(sp)),
        doc: none,
        type_vars: as_type_params(kid(kids, 0, sp)?, sp)?,
        target: TyWithout(head, x),
    }))
}

# The `# ..` lines among `node`'s own tokens that start in `lo..hi` — the run
# written above the case starting at `hi`, since between two cases there is
# nothing but those lines and the `|`.
fn doc_lines_between(src: str, Parts { tokens }, lo: u64, hi: u64) -> str[] {
    tokens.filter(|t| lo <= t.start && t.start < hi).map(|t| src[t]).filter(|t| t.starts_with('#'))
}

# `variant_case` — the name and the payload slots as children. Its docs are
# filled in by `lower_variant_decl`, which holds them.
fn lower_variant_case(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(AVariantCase(VariantCase {
        name: span_str(src, node.first_tok(sp)),
        doc: none,
        payload: kids.try_map(|k| as_case_param(k, sp))?,
    }))
}

# `case_param` — a bare type, or a named slot with an optional default, under
# any `# ..` lines of its own. `k?: T` stores the `T?` a match arm binds, with
# the `none` that was written as its default. The doc lines are the node's own
# tokens too, in front of the slot's; they are told apart by their marker.
fn lower_case_param(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let own = node.own_texts(src);
    let doc = doc_block(own.filter(|t| t.starts_with('#')));
    let toks = own.filter(|t| !t.starts_with('#'));
    let written = as_ty(kid(kids, 0, sp)?, sp)?;
    match (toks) {
        // `name: T`, `name?: T`, and either with a default.
        [name, ..] => {
            let implicit_some = toks.contains("?");
            let default = if (kids.len() == 2) { some(kid_expr(kids, 1, sp)?) } else { none };
            let ty = if (implicit_some) { TyOptional(written) } else { written };
            ok(ACaseParam(CaseParam { name: some(name), ty, default, implicit_some, doc }))
        },
        // A bare type.
        _ => ok(ACaseParam(CaseParam {
            name: none,
            ty: written,
            default: none,
            implicit_some: false,
            doc,
        })),
    }
}

# `function` — the one production whose children are told apart by what they
# lowered to rather than by position: a type parameter list, some parameters,
# some effects, a return type, a body and some attributes all arrive in one
# list, and each is a different `Ast` case.
fn lower_function(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let is_pub = starts_pub(node.own_texts(src));
    let at_name: u64 = if (is_pub) { 2 } else { 1 };
    let name = span_str(src, node.tokens[at_name].value_or(node.tok_span()));
    mut type_vars: TypeParam[] = [];
    mut params: Param[] = [];
    mut effects: str[] = [];
    mut return_ty: Ty? = none;
    mut body: ParsedBody = PBlock(at(Unit, sp));
    mut test_body: Expr? = none;
    mut test_fns: Function[] = [];
    mut performance: PerformanceBlock? = none;
    for (let k : kids) {
        if (let ATypeParams(tps) = k) {
            set type_vars = tps;
        };
        if (let AParam(p) = k) {
            set params.push(p);
        };
        if (let AName(e) = k) {
            set effects.push(e);
        };
        if (let ATy(t) = k) {
            set return_ty = some(t);
        };
        if (let ABody(b) = k) {
            set body = b;
        };

        // One slot per attribute, so a repeated one is refused: which would
        // silently win?
        if (let AAttr(a) = k) {
            if (a.name == "performance") {
                if (performance.is_some()) {
                    return err(ParseError {
                        message: "duplicate `.performance` attribute",
                        span: a.span,
                    });
                };
                set performance = some(PerformanceBlock { body: a.body, fns: a.fns, span: a.span });
            } else {
                if (test_body.is_some()) {
                    return err(ParseError { message: "duplicate `.test` attribute", span: a.span });
                };
                set test_body = some(a.body);
                set test_fns = a.fns;
            };
        };
    }
    let resolved = resolve_body(name.text, body, return_ty)?;
    ok(AFunction(Function {
        name,
        is_pub,
        sig: Signature { type_vars, params, effects, return_ty },
        body: resolved,
        shorthand_body: body.is_shorthand(),
        test_body,
        test_fns,
        performance,
        // Documentation comes from the `# ..` lines in front of the
        // declaration, which `item` holds; this never sees them.
        doc: none,
    }))
}

# Whether the body was written as the `{ field: value }` shorthand, which resolves
# to the same literal as the long form.
fn is_shorthand(self: ParsedBody) -> bool {
    match (self) {
        PConstruct(..) => true,
        PBlock(..) => false,
    }
}

// ---------- entry points ----------

# The part of `src` that is AIPL: everything before the first
# `--- section ---` marker, which is where a test-case file stops being source
# and starts being expected output. `aipl_parser::parse` strips exactly this,
# and `aipl_parse_cst` parses exactly this — so a losslessness assertion is
# against this string, not the whole file.
pub fn aipl_source(src: str) -> str { strip_test_sections(src) }

# The lossless concrete syntax tree for AIPL source `src`, parsed by the
# library against `aipl_grammar()`.
#
# Every byte of `aipl_source(src)` is under exactly one leaf. That needs the
# lexer's rule set read *losslessly* (`keep_skipped`): the compiler's own
# lexing skips whitespace outright, having no use for it, and a concrete tree
# has to be able to put it back. Nothing else needs putting back — every other
# byte, the braces around a template interpolation included, already sits
# inside some token's span.
pub fn aipl_parse_cst(src: str) -> Cst!ParseError {
    let text = aipl_source(src);
    parse_cst(text, lex_lossless(text)?, aipl_grammar(), "program")
}.test({
    // Losslessness, on something small enough to read: the leaves tile the
    // source, so concatenating them returns it whole.
    let src = "fn f() -> i64 { 1 }";
    assert(aipl_parse_cst(src)?.text(src) == src);

    // Comments and blank lines are covered too — they are the bytes a token
    // stream throws away, and the ones a formatter would have to put back.
    let commented = "// lead\nfn f() {\n    // inner\n}\n";
    assert(aipl_parse_cst(commented)?.text(commented) == commented);

    // And a file whose tail is expected output rather than source: the tree
    // covers what was parsed, which is everything before the first marker.
    let cased = "fn main() { }\n\n--- stdout ---\nhi\n";
    assert(aipl_parse_cst(cased)?.text(aipl_source(cased)) == aipl_source(cased));
    assert(aipl_source(cased) == "fn main() { }\n\n");
})

# One AIPL **type**, laid out by the generated formatter.
#
# This is the stage-4 claim, stated where it can be checked. `walker.aipl` lays
# out a type with six hand-written functions — `ty`, `paren_ty`, `ty_list`,
# `base_ty`, `set_or_dict_ty`, `dict_value_ty`, `named_ty`, `type_suffixes`,
# `array_suffixes` — about ninety lines of cursor-walking that mirror, by hand,
# productions this file already describes. Here the same layouts are four
# annotations on those productions plus `aipl_space` below, and the assertions
# under this function are `walker.aipl`'s own type assertions copied verbatim:
# same inputs, same expected strings, including the broken-list case. Both sides
# lex with `lex_aipl`, so the inputs mean the same thing to both.
#
# What that does *not* say: the rest of AIPL is not this tractable. Statements
# want a hard-broken block layout that `format.aipl` does not have an arm for
# yet, and expressions want call hugging and chain breaking, which are not
# layout at all. The types are the honest measure of the mechanical part — and
# the mechanical part is most of the grammar-shaped half of the walker.
pub fn format_aipl_ty(src: str, width: u64) -> str!ParseError {
    let g = aipl_grammar();
    render_cst(g, src, parse_cst(src, lex_lossless(src)?, g, "ty")?, aipl_space, width)
}.test({
    // A bare name, and the `?` / `[]` suffix runs, in source order.
    assert(format_aipl_ty("i64", 100)? == "i64");
    assert(format_aipl_ty("i64 ?", 100)? == "i64?");
    assert(format_aipl_ty("i64 [ ]", 100)? == "i64[]");
    assert(format_aipl_ty("i64 [ ] [ ]", 100)? == "i64[][]");
    assert(format_aipl_ty("i64 ? [ ]", 100)? == "i64?[]");
    assert(format_aipl_ty("i64 [ ] ?", 100)? == "i64[]?");

    // Set and dict types.
    assert(format_aipl_ty("#{ str }", 100)? == "#{str}");
    assert(format_aipl_ty("#>{ str }", 100)? == "#>{str}");
    assert(format_aipl_ty("#<{ i64 } [ ]", 100)? == "#<{i64}[]");
    assert(format_aipl_ty("#{ str : i64 }", 100)? == "#{str: i64}");
    assert(format_aipl_ty("#{ str : i64 } [ ]", 100)? == "#{str: i64}[]");

    // Generic application — `<`/`>` are unambiguously argument brackets here.
    assert(format_aipl_ty("Box < i64 >", 100)? == "Box<i64>");
    assert(format_aipl_ty("Map < str , i64 >", 100)? == "Map<str, i64>");
    // No trailing comma in type position, even broken.
    assert(format_aipl_ty("Map < str , i64 >", 1)? == "Map<\n    str,\n    i64\n>\n");

    // Results: `T!E`, and the void-ok `!E`.
    assert(format_aipl_ty("i64 ! str", 100)? == "i64!str");
    assert(format_aipl_ty("! Error", 100)? == "!Error");

    // Parenthesized: function type, tuple, tuple array.
    assert(format_aipl_ty("( i64 , str ) -> bool", 100)? == "(i64, str) -> bool");
    assert(format_aipl_ty("( i64 , str )", 100)? == "(i64, str)");
    // An optional tuple: one `?`, written against the closing paren.
    assert(format_aipl_ty("( i64 , str ) ?", 100)? == "(i64, str)?");
    assert(format_aipl_ty("( i64 , str ) [ ]", 100)? == "(i64, str)[]");
    // A function type nests on the right.
    assert(format_aipl_ty("( i64 ) -> ( str ) -> bool", 100)? == "(i64) -> (str) -> bool");

    // A refinement: `without` and its excluded value take a space each side.
    assert(format_aipl_ty("i64 [ ] without [ ]", 100)? == "i64[] without []");
    assert(format_aipl_ty("( i64 [ ] without [ ] ) ?", 100)? == "(i64[] without [])?");

    // A comment inside a type is not layout, so it survives.
    assert(format_aipl_ty("Map < str , /* k */ i64 >", 100)? == "Map<str, /* k */ i64>");
})

# One AIPL **import statement**, laid out by the generated formatter — the
# `Doc` rather than the text, because the caller is `walker.aipl`, which splices
# it into the file's layout and prints the whole thing once.
#
# This is the first piece of AIPL's own formatter to move from the walker to the
# grammar, and it moved for the sake of one rule: the names sort. That used to be
# a comparator and a sort in the walker; it is now `sorted=true` on the
# `import_decl` production's `Many`, and the walker calls this instead of
# knowing. Everything else about an import's layout — the spaced braces, the
# trailing comma once it breaks, the `from` and the `;` — was already a fact the
# grammar stated, read back here through `format_cst` as it is for a type.
#
# `src` is the statement alone, `import` through `;`. Comments inside it are
# trivia the concrete tree keeps, so they come out inside the statement, beside
# the name they were written against; the walker skips past them so they are not
# emitted a second time.
pub fn import_decl_doc(src: str) -> Doc!ParseError {
    let g = aipl_grammar();
    format_cst(g, src, parse_cst(src, lex_lossless(src)?, g, "import_decl")?, aipl_space)
}.test({
    // `import_decl_doc` printed at `width`, for the assertions above.
    fn import_doc(src: str, width: u64) -> str!ParseError { ok(import_decl_doc(src)?.print(width)) }

    // The names sort, the braces take inner spaces, the source is verbatim.
    assert(
        import_doc("import { b , a } from builtins ;", 100)? == "import { a, b } from builtins;",
    );
    assert(
        import_doc(
            """import { x } from "./m.aipl" ;""",
            100,
        )? == """import { x } from "./m.aipl";""",
    );

    // A renamed import sorts under the name it *imports*, and an aliased operator
    // keeps its spelling with a space either side of `as`.
    assert(
        import_doc(
            "import { wrapping_add as + , len , equal as == } from builtins ;",
            100,
        )? == "import { equal as ==, len, wrapping_add as + } from builtins;",
    );
    // A prefix sorts before the longer name extending it.
    assert(
        import_doc("import { ab , a } from builtins ;", 100)? == "import { a, ab } from builtins;",
    );

    // Too wide: one name per line with a trailing comma.
    assert(
        import_doc(
            "import { b , a } from builtins ;",
            5,
        )? == "import {\n    a,\n    b,\n} from builtins;\n",
    );

    // A comment inside the list stays inside it, riding with the name it was
    // written in front of — and it forces the list to break, since a line
    // comment cannot share a line with what follows it.
    assert(
        import_doc(
            "import { b,\n    // why a\n    a } from builtins;",
            100,
        )? == "import {\n    // why a\n    a,\n    b,\n} from builtins;\n",
    );

    // Malformed input fails with the parser's message.
    assert(
        match (import_decl_doc("import { len from builtins ;")) {
            ok(..) => "formatted",
            err(e) => e.message,
        } == "expected `,`, `as`, or `}`, found `from`",
    );
})

# One AIPL **type**, lowered to the AST — the stage-5d claim for the slice that
# is finished, stated where it can be checked.
#
# `parse` is `parse_cst` followed by `lower`, so this is the whole pipeline: the
# concrete tree is built and discarded, and what comes back is a `Ty` that means
# the same thing `aipl_parser`'s build actions mean by it. The assertions below
# are written against `show_ty`'s structural dump rather than against a
# re-rendering of the source, because the question a lowering has to answer is
# which way `i64?[]` nested, and a re-rendering gives that back either way.
pub fn lower_aipl_ty(src: str) -> Ty!ParseError {
    as_ty(parse(src, lex_lossless(src)?, aipl_grammar(), "ty")?, 0..src.len())
}.test({
    // A lowered type as text, or the refusal that stopped it — so an assertion above
    // reads as one line whichever it is.
    fn ty_dump(src: str) -> str {
        match (lower_aipl_ty(src)) {
            ok(t) => t.show_ty(),
            err(e) => `error: {e.message}`,
        }
    }

    // Bare names: a primitive, the anonymous bound, and a declared name.
    assert(ty_dump("i64") == "i64");
    assert(ty_dump("str") == "str");
    assert(ty_dump("any") == "any");
    assert(ty_dump("Point") == "Point");
    assert(ty_dump("T") == "T");

    // The suffix run, in source order — this is the assertion that says the
    // fold goes left to right and not the other way.
    assert(ty_dump("i64?") == "Optional(i64)");
    assert(ty_dump("i64[]") == "Array(i64)");
    assert(ty_dump("i64?[]") == "Array(Optional(i64))");
    assert(ty_dump("i64[]?") == "Optional(Array(i64))");
    assert(ty_dump("i64[][]") == "Array(Array(i64))");

    // Sets and dicts, and a suffix on one.
    assert(ty_dump("#{str}") == "Set(str)");
    assert(ty_dump("#>{u64}") == "Set(u64, Desc)");
    assert(ty_dump("#<{str}[]") == "Array(Set(str, Asc))");
    assert(ty_dump("#{str: i64}") == "Dict(str, i64)");
    assert(ty_dump("#{str: i64}[]") == "Array(Dict(str, i64))");
    assert(ty_dump("#{i64}?") == "Optional(Set(i64))");
    assert(ty_dump("#{str: i64[]}") == "Dict(str, Array(i64))");

    // Generic application, and `Case<V>` — the one base name that is not one.
    assert(ty_dump("Box<i64>") == "Generic(Box, i64)");
    assert(ty_dump("Map<str, i64>") == "Generic(Map, str, i64)");
    assert(ty_dump("Box<T>[]") == "Array(Generic(Box, T))");

    // A grid is the builtin generic `__builtin_Grid`; `[,]` composes with the
    // other suffixes in the order written.
    assert(ty_dump("i64[,]") == "Generic(__builtin_Grid, i64)");
    assert(ty_dump("i64[,][]") == "Array(Generic(__builtin_Grid, i64))");
    assert(ty_dump("i64[][,]") == "Generic(__builtin_Grid, Array(i64))");
    assert(ty_dump("i64[,]?") == "Optional(Generic(__builtin_Grid, i64))");
    assert(ty_dump("Case<V>") == "Case(V)");
    assert(ty_dump("Case<A, B>") == "error: Case<V> takes one type argument, got 2");

    // Results, including the void-ok form, whose ok side is unit.
    assert(ty_dump("i64!str") == "Result(i64, str)");
    assert(ty_dump("str[]!Error") == "Result(Array(str), Error)");
    assert(ty_dump("!Error") == "Result((), Error)");

    // The parenthesized forms. A function type takes any arity, a tuple needs
    // two — so the same parenthesized list is fine on the left of `->` and a
    // refusal on its own.
    assert(ty_dump("(i64, str) -> bool") == "Fn([i64, str], bool)");
    assert(ty_dump("(i64) -> str") == "Fn([i64], str)");
    assert(ty_dump("() -> bool") == "Fn([], bool)");
    assert(ty_dump("(i64) -> (str) -> bool") == "Fn([i64], Fn([str], bool))");
    assert(ty_dump("(i64, str)") == "Tuple(i64, str)");
    assert(ty_dump("(i64, str)[]") == "Array(Tuple(i64, str))");
    assert(ty_dump("(i64, str)?") == "Optional(Tuple(i64, str))");
    assert(ty_dump("(i64, str)!Error") == "Result(Tuple(i64, str), Error)");
    assert(ty_dump("(Box<T>, i64[])") == "Tuple(Generic(Box, T), Array(i64))");

    // One element in parens is a grouping, not a tuple.
    assert(ty_dump("(i64)") == "i64");
    assert(ty_dump("(i64)[]") == "Array(i64)");
    assert(ty_dump("(i64)?") == "Optional(i64)");
    assert(ty_dump("(i64)!Error") == "Result(i64, Error)");

    // The arity refusal names the suffix that was actually written, which is
    // what makes the advice runnable rather than generic.
    assert(ty_dump("()") == "error: a tuple type needs at least 2 elements, e.g. (i64, str)");
    assert(ty_dump("()[]") == "error: a tuple type needs at least 2 elements, e.g. (i64, str)[]");
    assert(ty_dump("()?") == "error: a tuple type needs at least 2 elements, e.g. (i64, str)?");
    assert(
        ty_dump(
            "()!Error",
        ) == "error: a tuple type needs at least 2 elements, e.g. (i64, str)!Error",
    );

    // A refinement: `without` applies to the whole type on its left, binds
    // looser than every suffix, and takes a grouping to sit under one.
    assert(ty_dump("i64[] without []") == "Without(Array(i64), [])");
    assert(ty_dump("(i64[] without [])?") == "Optional(Without(Array(i64), []))");
    assert(ty_dump("(T[] without [])[]") == "Array(Without(Array(T), []))");
    assert(ty_dump("Box<T[] without []>") == "Generic(Box, Without(Array(T), []))");
    assert(ty_dump("(i64[] without []) -> bool") == "Fn([Without(Array(i64), [])], bool)");
    assert(ty_dump("i64[]!Error without []") == "Without(Result(Array(i64), Error), [])");

    // What is excluded may be a case, by name; the base is then a variant.
    assert(ty_dump("V without C") == "Without(V, C)");
    assert(ty_dump("Tree<T> without Leaf") == "Without(Generic(Tree, T), Leaf)");
    assert(ty_dump("(V without C)?") == "Optional(Without(V, C))");
    assert(ty_dump("(V without C) without D") == "Without(Without(V, C), D)");
})

# One AIPL **pattern**, lowered to the AST.
#
# Patterns are the second slice that closes over itself: nothing under `pattern`
# reaches an expression, which is why the destructuring `[a, b]` arm — the one
# pattern shape that holds expressions — belongs to `match_arm` rather than here.
pub fn lower_aipl_pattern(src: str) -> Pat!ParseError {
    as_pat(parse(src, lex_lossless(src)?, aipl_grammar(), "pattern")?, 0..src.len())
}.test({
    // A lowered pattern as text, or the refusal that stopped it.
    fn pat_dump(src: str) -> str {
        match (lower_aipl_pattern(src)) {
            ok(pat) => pat.show_pat(),
            err(e) => `error: {e.message}`,
        }
    }

    // A struct pattern, anywhere a pattern goes.
    assert(pat_dump("P { x, y as b }") == "P { x, y as b }");
    assert(pat_dump("(P { x }, n)") == "(P { x }, n)");
    assert(pat_dump("some(P { x })") == "some(P { x })");

    // The nullary forms, and the one identifier that is not a constructor.
    assert(pat_dump("none") == "none");
    assert(pat_dump("Circle") == "Circle");
    assert(pat_dump("_") == "_");

    // A payload, named slot by slot or ignored whole. The two are deliberately
    // different patterns: `Circle` asserts the case carries nothing.
    assert(pat_dump("some(v)") == "some(v)");
    assert(pat_dump("Pair(a, b)") == "Pair(a, b)");
    assert(pat_dump("Circle(..)") == "Circle(..)");
    // `_` is a constructor name once it takes a payload.
    assert(pat_dump("_(x)") == "_(x)");

    // `V.A` — the qualification is part of the name, not a field of its own.
    assert(pat_dump("V.A") == "V.A");
    assert(pat_dump("V.A(x)") == "V.A(x)");
    assert(pat_dump("V.A(..)") == "V.A(..)");

    // Nested: a tuple of patterns, an integer, and a constructor over patterns
    // — which is the plain `Ctor` when every slot is a bare binder name, and
    // `Nested` (dumped the same way) otherwise. A capitalised bare name in a
    // slot is a case, not a binder, so `Pair(Nil, x)` nests.
    assert(pat_dump("(1, some(1))") == "(1, some(1))");
    assert(pat_dump("(lo, some(hi))") == "(lo, some(hi))");
    assert(pat_dump("(0, none)") == "(0, none)");
    assert(pat_dump("-5") == "-5");
    assert(pat_dump("ok((a, b))") == "ok((a, b))");
    assert(pat_dump("Pair(Nil, x)") == "Pair(Nil, x)");
    assert(pat_dump("(a, (b, c))") == "(a, (b, c))");
    assert(pat_dump(`some("s")`) == "some(Str(s))");
    // The same-bindings check reads the binders of a nested pattern.
    assert(
        expr_dump(
            "match (p) { (1, x) | (x, 1) => x, _ => 0 }",
        ) == "Match(p, [(1, x) => x, (x, 1) => x, _ => 0])",
    );
    assert(
        expr_dump(
            "match (p) { (1, x) | (y, 1) => x }",
        ) == `error: alternatives of one arm must bind the same names: a tuple pattern binds "x", but a tuple pattern binds "y"`,
    );

    // Literal patterns carry their *value*, so the escape is decoded and the
    // delimiters are gone — which is the whole difference between a pattern
    // that matches `a`-newline-`b` and one that matches a backslash.
    assert(pat_dump(`"s"`) == "Str(s)");
    assert(pat_dump(`"a\\nb"`) == "Str(a\nb)");
    assert(pat_dump("'x'") == "Char(x)");
    assert(pat_dump("""'\n'""") == "Char(\n)");

    // A template with no interpolation lexes as a string literal, so it is one
    // here too.
    assert(pat_dump("`t`") == "Str(t)");
})

# One AIPL **expression**, lowered to the AST.
#
# This is most of the language: statements lower to expressions too, and the
# `atom` production reaches blocks, match arms and patterns, so what parses here
# is nearly everything but a declaration. The one thing it cannot do yet is a
# block holding a keyword statement — that slice is next, and a block that holds
# one refuses rather than dropping it.
pub fn lower_aipl_expr(src: str) -> Expr!ParseError {
    ok(as_expr(parse(src, lex_lossless(src)?, aipl_grammar(), "expr")?, 0..src.len())?.desugared())
}.test({
    // Literals, and the identifier that is not one.
    assert(expr_dump("1") == "1");

    // Type arguments follow the callee's name, in a free call and a method call.
    assert(expr_dump("f::<u8>(x)") == "TypeArgs(f(x), [u8])");
    assert(expr_dump("xs.g::<u8, str>(1)") == "TypeArgs(xs.g(1), [u8, str])");
    assert(expr_dump("f::<u8[]>()") == "TypeArgs(f(), [Array(u8)])");
    // A comparison is still a comparison.
    assert(expr_dump("a < b") == "<(a, b)");
    assert(expr_dump("true") == "true");
    assert(expr_dump("false") == "false");
    assert(expr_dump("none") == "none");
    assert(expr_dump(`"s"`) == "Str(s)");
    assert(expr_dump("'c'") == "Char(c)");
    assert(expr_dump("x") == "x");

    // `-1` is one token: the lexer claims the sign when a digit follows it, so
    // only a *spaced* minus is the unary operator.
    assert(expr_dump("-1") == "-1");
    assert(expr_dump("- 1") == "Neg(1)");
    assert(expr_dump("-x") == "Neg(x)");

    // Every operator is a call on its spelling — there is no operator node, and
    // nothing downstream can tell one was written.
    assert(expr_dump("a + b") == "+(a, b)");
    assert(expr_dump("!x") == "!(x)");
    // Precedence and associativity, which is what the `Climb` table encodes.
    assert(expr_dump("1 + 2 * 3") == "+(1, *(2, 3))");
    assert(expr_dump("1 * 2 + 3") == "+(*(1, 2), 3)");
    assert(expr_dump("a - b - c") == "-(-(a, b), c)");
    assert(expr_dump("a == b && c") == "&&(==(a, b), c)");
    assert(expr_dump("a || b && c") == "||(a, &&(b, c))");

    // A range is sugar for constructing the builtin `Span`, which is why it
    // needs no import.
    assert(expr_dump("a..b") == "Construct(__builtin_Span, [start: a, end: b])");
    // ...except written *as* an index, where it folds straight into a slice.
    assert(expr_dump("s[1..2]") == "Slice(s, 1, 2)");
    assert(expr_dump("s[1..]") == "Slice(s, 1, )");
    assert(expr_dump("s[..2]") == "Slice(s, 0, 2)");
    assert(expr_dump("s[i]") == "Index(s, i)");

    // Postfix chains, left to right. A tuple slot is the field `_0`.
    assert(expr_dump("p.x") == "p.x");
    assert(expr_dump("p.0") == "p._0");
    assert(expr_dump("p.-1") == "error: tuple index must be a non-negative integer");
    assert(expr_dump("x?") == "Try(x)");
    assert(expr_dump("a.b.c") == "a.b.c");

    // `$` maps a member over the receiver: a field, a tuple slot, or a call.
    assert(expr_dump("v$f") == "v.__builtin_map(Lambda([__map$0_3], __map$0_3.f))");
    assert(expr_dump("v$0") == "v.__builtin_map(Lambda([__map$0_3], __map$0_3._0))");
    assert(expr_dump("v$f(1, w)") == "v.__builtin_map(Lambda([__map$0_9], __map$0_9.f(1, w)))");
    assert(
        expr_dump(
            "v$f$g",
        ) == "v.__builtin_map(Lambda([__map$0_3], __map$0_3.f)).__builtin_map(Lambda([__map$0_5], __map$0_5.g))",
    );
    assert(
        expr_dump(
            "v$f(w$g)",
        ) == "v.__builtin_map(Lambda([__map$0_8], __map$0_8.f(w.__builtin_map(Lambda([__map$4_7], __map$4_7.g)))))",
    );
    assert(expr_dump("v$f.len()") == "v.__builtin_map(Lambda([__map$0_3], __map$0_3.f)).len()");
    assert(expr_dump("v$-1") == "error: tuple index must be a non-negative integer");

    // A method call folds its receiver in as the first argument, so `xs.f(1)`
    // and `f(xs, 1)` are the same call with one bit between them.
    assert(expr_dump("xs.push(1)") == "xs.push(1)");
    assert(expr_dump("xs.len()") == "xs.len()");
    assert(
        expr_dump(
            "xs.f(..ys)",
        ) == "error: `..` spread is only allowed in an array or set literal, not in a method call",
    );
    assert(expr_dump("push(xs, 1)") == "push(xs, 1)");
    assert(expr_dump("f()") == "f()");
    assert(expr_dump("a.b(1).c[2]?") == "Try(Index(a.b(1).c, 2))");

    // Struct literals, including the shorthand and the spread.
    assert(expr_dump("P { x: 1, y }") == "Construct(P, [x: 1, y: y])");
    assert(expr_dump("P { ..base, x: 1 }") == "Construct(P, [..base, x: 1])");
    assert(expr_dump("P {}") == "Construct(P, [])");

    // Array, tuple and paren. A tuple needs the comma; one expression in
    // parentheses is just that expression.
    assert(expr_dump("[1, 2]") == "[1, 2]");
    assert(expr_dump("[1, ..rest]") == "[1, ..rest]");
    assert(expr_dump("(1, 2)") == "Tuple(1, 2)");
    assert(expr_dump("(1, 2,)") == "Tuple(1, 2)");
    assert(expr_dump("(1)") == "1");
    assert(expr_dump("(1 + 2) * 3") == "*(+(1, 2), 3)");
    // A spread survives only in an array literal.
    assert(
        expr_dump(
            "f(..xs)",
        ) == "error: `..` spread is only allowed in an array or set literal, not in a call argument list",
    );

    // `#{ .. }` is a set, a dict, or an empty of either — and never a mix.
    assert(expr_dump("#{1, 2}") == "Set([1, 2])");
    assert(expr_dump("#>{1, 2}") == "Set([1, 2], Desc)");
    assert(expr_dump("#<{}") == "Set([], Asc)");
    assert(expr_dump("#{1: 2}") == "Dict([1: 2])");
    assert(expr_dump("#{}") == "Set([])");
    assert(expr_dump("#{1, 2: 3}").starts_with("""error: a "#{ .. }" literal can't mix"""));

    // A set literal takes `..` spreads, among its elements or alone; a dict does not.
    assert(expr_dump("#{..a, 1}") == "Set([..a, 1])");
    assert(expr_dump("#>{1, ..a, ..b}") == "Set([1, ..a, ..b], Desc)");
    assert(expr_dump("#{1: 2, ..a}").starts_with("error: a `..` spread is only allowed in a set"));

    // A template is a concat chain over `__template_interp` of each
    // interpolation, folded from the tail backwards.
    assert(
        expr_dump(
            "`a{x}b`",
        ) == "__aipl_concat(__aipl_concat(Str(a), __template_interp(x)), Str(b))",
    );

    // Arguments: lambdas, bare operators, keyword arguments.
    assert(expr_dump("f(|x| x)") == "f(Lambda([x], x))");
    assert(expr_dump("f(|x: i64| x)") == "f(Lambda([x: i64], x))");
    assert(expr_dump("f(|| 1)") == "f(Lambda([], 1))");
    assert(expr_dump("f(+)") == "f(Lambda([lhs, rhs], +(lhs, rhs)))");
    assert(expr_dump("f(k = 1)") == "f(Kw(k, 1))");
    assert(expr_dump("f(k?= o)") == "f(KwFwd(k, o))");
    // A lambda in value position takes a block body; it builds the same node.
    assert(expr_dump("|x| { x }") == "Lambda([x], x)");

    // `if`, with and without an `else`, and the ladder. An else-less `if` gets
    // a synthetic unit, so it is typed exactly like `if (..) { .. } else {}`.
    assert(expr_dump("if (a) { 1 } else { 2 }") == "If(a, 1, 2)");
    assert(expr_dump("if (a) { 1 }") == "If(a, 1, ())");
    assert(expr_dump("if (a) { }") == "If(a, (), ())");
    assert(expr_dump("if (a) { 1 } else if (b) { 2 } else { 3 }") == "If(a, 1, If(b, 2, 3))");
    assert(expr_dump("if (let some(v) = o) { v } else { 0 }") == "IfLet(some(v) => v, o, 0)");
    assert(expr_dump("if (let some(v) = o) { v }") == "IfLet(some(v) => v, o, ())");

    // A block is a right-nested `Seq`, and an `expr;` is what puts one there.
    assert(expr_dump("if (a) { f(); 1 }") == "If(a, Seq(f(), 1), ())");
    assert(expr_dump("if (a) { f(); }") == "If(a, Seq(f(), ()), ())");

    // `match`, and the alternation that expands to one arm per pattern.
    assert(expr_dump("match (v) { A(x) => x, _ => 0 }") == "Match(v, [A(x) => x, _ => 0])");
    // Several scrutinees are the tuple `match (a, b)` spells.
    assert(
        expr_dump(
            "match (a, b) { (1, x) => x, _ => 0 }",
        ) == "Match(Tuple(a, b), [(1, x) => x, _ => 0])",
    );
    assert(
        expr_dump(
            "match (v) { A(x) | B(x) => x, _ => 0 }",
        ) == "Match(v, [A(x) => x, B(x) => x, _ => 0])",
    );
    assert(expr_dump("match (v) { A(..) => 1, _ => 0 }") == "Match(v, [A(..) => 1, _ => 0])");
    assert(expr_dump("match (xs) { [a, b] => a, _ => 0 }") == "Match(xs, [[a, b] => a, _ => 0])");

    // A trailing `..` makes the array pattern "at least these", and is only that.
    assert(expr_dump("match (xs) { [a, ..] => a, _ => 0 }") == "Match(xs, [[a, ..] => a, _ => 0])");
    assert(expr_dump("match (xs) { [..] => 0 }") == "Match(xs, [[..] => 0])");
    assert(
        expr_dump(
            "match (xs) { [a, .., b] => a, _ => 0 }",
        ) == "error: `..` is only allowed as the last element of an array pattern, as in `[a, ..]`",
    );
    assert(
        expr_dump(
            "match (xs) { [some(a), ..] => a, _ => 0 }",
        ) == "error: an array pattern ending in `..` holds only names, `_` and literals",
    );
    assert(
        expr_dump(
            "match (v) { A(x, ..) => x, _ => 0 }",
        ) == "error: `..` is only allowed as the last element of an array pattern, as in `[a, ..]`",
    );
    assert(expr_dump("""match (s) { "a" => 1, _ => 0 }""") == "Match(s, [Str(a) => 1, _ => 0])");

    // Alternatives that disagree about what they bind are refused here rather
    // than left to fail as an unbound name somewhere in the shared body.
    assert(
        expr_dump(
            "match (v) { A(x) | B(y) => x, _ => 0 }",
        ) == `error: alternatives of one arm must bind the same names: "A" binds "x", but "B" binds "y"`,
    );
    assert(
        expr_dump(
            "match (v) { A(x) | B => x, _ => 0 }",
        ) == `error: alternatives of one arm must bind the same names: "A" binds "x", but "B" binds nothing`,
    );

    // `shim`, whose bindings are a list and whose body is a block.
    assert(expr_dump("shim prints { print = p } { g() }") == "Shim(prints, [print = p], g())");

    // A closure is bound under a name of its own and lowers to a `let` around the shim.
    assert(
        expr_dump(
            "shim prints { print = |s| { g(s); } } { h() }",
        ) == "Let($shimfn$print$22, Lambda([s], Seq(g(s), ())), Shim(prints, [print = $shimfn$print$22], h()))",
    );
    assert(
        expr_dump(
            "shim clock { now_nanos = || 5, monotonic_now = f } { h() }",
        ) == "Let($shimfn$now_nanos$28, Lambda([], 5), Shim(clock, [now_nanos = $shimfn$now_nanos$28, monotonic_now = f], h()))",
    );
    assert(expr_dump("shim prints { print = 1 } { g() }").starts_with(
        `error: "print" is bound to a function's name or to a closure`,
    ));

    // A provider lowers to the shim it stands for, seeding as its body's first step.
    assert(
        expr_dump(
            "shim random seeded_with_int(7) { g() }",
        ) == "Shim(random, [random_u64 = __random_next], Seq(__random_seed(7), g()))",
    );
    assert(
        expr_dump(
            "shim random seeded_with_clock() { g() }",
        ) == "Shim(random, [random_u64 = __random_next], Seq(__random_seed_from_clock(), g()))",
    );
    assert(expr_dump("shim random { p() } { g() }").contains("__random_seed_from_clock()"));
    assert(expr_dump("shim prints { p() } { g() }").starts_with(
        `error: effect "!prints" has no providers`,
    ));
    assert(expr_dump("shim random seeded_with_int() { g() }").starts_with(
        "error: `shim random` has providers",
    ));
    assert(expr_dump("shim random nonsense(1) { g() }").starts_with(
        "error: `shim random` has providers",
    ));
    assert(expr_dump("shim prints seeded_with_int(1) { g() }").starts_with(
        `error: effect "!prints" has no providers`,
    ));

    // And a block with a statement in it, which the statement slice completes.
    assert(expr_dump("if (a) { let x = 1; x }") == "If(a, Let(x, 1, x), ())");
})

# One AIPL **block**, lowered to the AST — the statement slice's entry point.
#
# A block is not a node: it is the right-nested chain its statements fold to,
# so what comes back is an ordinary expression and the assertions read as the
# desugarings they are.
pub fn lower_aipl_block(src: str) -> Expr!ParseError {
    ok(lower_aipl_block_surface(src)?.desugared())
}

# `lower_aipl_block`, before the destructuring forms are lowered: the tree the
# lints read.
pub fn lower_aipl_block_surface(src: str) -> Expr!ParseError {
    as_expr(parse(src, lex_lossless(src)?, aipl_grammar(), "block")?, 0..src.len())
}.test({
    // A lowered block as text, or the refusal that stopped it.
    fn block_dump(src: str) -> str {
        match (lower_aipl_block(src)) {
            ok(e) => e.show_expr(),
            err(e) => `error: {e.message}`,
        }
    }

    assert(
        block_dump(
            "{ let Wrap(P { x, y }) = v; x }",
        ) == "Let(__cpat$25, v, Let(x, Match(__cpat$25, [Wrap(__npat$25_0) => Let(__spat$25_0: P, __npat$25_0, Let(x, __spat$25_0.x, x))]), Let(y, Match(__cpat$25, [Wrap(__npat$25_0) => Let(__spat$25_0: P, __npat$25_0, Let(y, __spat$25_0.y, y))]), x)))",
    );
    assert(
        block_dump(
            "{ let (P { x }, n) = v; x }",
        ) == "Let(__cpat$21, v, Let(x, Match(__cpat$21, [(__npat$21_0, _) => Let(__spat$21_0: P, __npat$21_0, Let(x, __spat$21_0.x, x))]), Let(n, Match(__cpat$21, [(_, n) => n]), x)))",
    );
    assert(
        block_dump(
            "{ let Some(P { x }) = v else { return 0; }; x }",
        ) == "IfLet(Some(__npat$1_0) => Let(__spat$1_0: P, __npat$1_0, Let(x, __spat$1_0.x, x)), v, Seq(Return(0), ()))",
    );

    // The two bindings, with and without an annotation. Each wraps the rest of
    // the block, which is what makes a block a chain rather than a list.
    assert(block_dump("{ let x = 1; x }") == "Let(x, 1, x)");
    assert(block_dump("{ let x: i64 = 1; x }") == "Let(x: i64, 1, x)");
    assert(block_dump("{ mut x = 1; x }") == "Mut(x, 1, x)");
    assert(block_dump("{ mut x: u8 = 1; x }") == "Mut(x: u8, 1, x)");
    assert(block_dump("{ let x = 1; let y = 2; x }") == "Let(x, 1, Let(y, 2, x))");

    // A block with no trailing expression is unit-valued; one with statements
    // after the value is a `Seq`.
    assert(block_dump("{ }") == "()");
    assert(block_dump("{ f(); }") == "Seq(f(), ())");
    assert(block_dump("{ f(); 1 }") == "Seq(f(), 1)");

    // `set` in its nine spellings. The step and compound forms are ordinary
    // operator calls on the binding, each gated on the operator written rather
    // than on the one it collapses to.
    assert(block_dump("{ set x = 1; }") == "Assign(x, 1, ())");
    assert(block_dump("{ set x++; }") == "Assign(x, ++(x, 1), ())");
    assert(block_dump("{ set x--; }") == "Assign(x, --(x, 1), ())");
    assert(block_dump("{ set x += 2; }") == "Assign(x, +=(x, 2), ())");
    assert(block_dump("{ set x -= 2; }") == "Assign(x, -=(x, 2), ())");
    assert(block_dump("{ set x *= 2; }") == "Assign(x, *=(x, 2), ())");
    assert(block_dump("{ set x /= 2; }") == "Assign(x, /=(x, 2), ())");

    // The writeback of a mutating method call: the receiver folds in as the
    // first argument, and the `set` is what writes the result back.
    assert(block_dump("{ set x.push(1); }") == "Assign(x, x.push(1), ())");
    assert(block_dump("{ set a.b = 1; }") == "Assign(a.b, 1, ())");
    assert(block_dump("{ set a.b.c = 1; }") == "Assign(a.b.c, 1, ())");

    // Every form takes a field path as its target, desugared around the path
    // the way it is around a name; the method's receiver is the path minus the
    // method, and a call with nothing before it has nothing to write back to.
    assert(block_dump("{ set a.b++; }") == "Assign(a.b, ++(a.b, 1), ())");
    assert(block_dump("{ set a.b.c--; }") == "Assign(a.b.c, --(a.b.c, 1), ())");
    assert(block_dump("{ set a.b += 2; }") == "Assign(a.b, +=(a.b, 2), ())");
    assert(block_dump("{ set a.b.xs.push(1); }") == "Assign(a.b.xs, a.b.xs.push(1), ())");

    // An indexed write is a guarded `try_set`; a plain index is read twice, any
    // other is bound first.
    assert(
        block_dump(
            "{ set xs[i] = 1 else { return none; }; }",
        ) == "Seq(IfLet(some(..) => Assign(xs, __with_or_self(xs, i, 1), ()), Index(xs, i), Seq(Return(none), ())), ())",
    );
    assert(
        block_dump(
            "{ set g[r, c + 1] = 1 else {}; }",
        ) == "Seq(Let(__iset1$6, +(c, 1), IfLet(some(..) => Assign(g, __builtin_grid_try_set(g, r, __iset1$6, 1), ()), __builtin_grid_get(g, r, __iset1$6), ())), ())",
    );
    // The `else` is not optional.
    assert(
        block_dump(
            "{ set xs[i] = 1; }",
        ) == "error: an indexed write can miss, because the index may be off the end: say what happens then, as in `set xs[i] = x else { return none; };`, or `else {}` to do nothing",
    );
    assert(
        block_dump(
            "{ set f(1); }",
        ) == "error: set: a mutating method call needs a receiver to write back to, as in `set xs.push(x);`",
    );

    // The statements that produce no binding sit in front of the rest as a
    // `Seq`. A loop body takes no trailing expression, so its own value is a
    // synthetic `0` — the loop expression's result.
    assert(block_dump("{ return 1; }") == "Seq(Return(1), ())");
    assert(block_dump("{ while (b) { } }") == "Seq(While(b, 0), ())");
    assert(block_dump("{ while (b) { f(); } }") == "Seq(While(b, Seq(f(), 0)), ())");
    assert(block_dump("{ for (let x : xs) { f(x); } }") == "Seq(For(x, xs, Seq(f(x), 0)), ())");

    // `let (a, b) = p;` binds a temporary and reads the tuple slots off it.
    // The temporary is named after the value's start, so nesting cannot collide.
    assert(
        block_dump(
            "{ let (a, b) = p; a }",
        ) == "Let(__tpat$15, p, Let(a, __tpat$15._0, Let(b, __tpat$15._1, a)))",
    );
    assert(
        block_dump(
            "{ let (a) = p; a }",
        ) == "error: a tuple pattern needs at least 2 names, e.g. let (a, b) = expr;",
    );

    // `let T { x, y } = p;` does the same by field name. The scrutinee carries
    // the pattern's type as its annotation — which is what makes the type name
    // mean something — and stays an immutable `let` even in the `mut` form,
    // where only the fields are rebound mutably.
    assert(
        block_dump(
            "{ let P { x, y } = p; x }",
        ) == "Let(__spat$19: P, p, Let(x, __spat$19.x, Let(y, __spat$19.y, x)))",
    );
    assert(block_dump("{ mut P { x } = p; x }") == "Let(__spat$16: P, p, Mut(x, __spat$16.x, x))");

    // `let Case(a, b) = e;` reads each name with a `match` of its own, so the rest
    // of the block stays outside any arm.
    assert(
        block_dump(
            "{ let Pair(a, b) = p; a }",
        ) == "Let(__cpat$19, p, Let(a, Match(__cpat$19, [Pair(a, _) => a]), Let(b, Match(__cpat$19, [Pair(_, b) => b]), a)))",
    );

    // A destructuring `let` or `for` is kept as written until it is lowered, which
    // is what the lints read; `block_dump` above has the lowered form.
    fn surface_dump(src: str) -> str {
        match (lower_aipl_block_surface(src)) {
            ok(e) => e.show_expr(),
            err(e) => `error: {e.message}`,
        }
    }
    assert(surface_dump("{ let (a, b) = t; a }") == "LetPattern((a, b), t, a)");
    assert(surface_dump("{ let P { x, y as b } = p; b }") == "LetPattern(P { x, y as b }, p, b)");
    assert(surface_dump("{ mut P { x } = p; x }") == "LetPattern(mut P { x }, p, x)");
    assert(surface_dump("{ let Pair(a, b) = p; a }") == "LetPattern(Pair(a, b), p, a)");
    assert(
        surface_dump(
            "{ for (let (a, b) : xs) { f(a); } 0 }",
        ) == "Seq(ForPattern((a, b), xs, Seq(f(a), 0)), 0)",
    );
    assert(
        surface_dump(
            "{ for (let i, P { x } : xs) { f(x); } 0 }",
        ) == "Seq(ForPattern([i], P { x }, xs, Seq(f(x), 0)), 0)",
    );

    // `let PATTERN = e else { .. };` binds the pattern's names in the rest of the
    // block, and runs its block when the pattern does not match — so the rest is
    // the arm of an `if let`, and the block its `else`.
    assert(
        block_dump(
            "{ let some(v) = o else { return none; }; v }",
        ) == "IfLet(some(v) => v, o, Seq(Return(none), ()))",
    );
    assert(
        block_dump(
            "{ let Pair(a, b) = p else { return 0; }; a }",
        ) == "IfLet(Pair(a, b) => a, p, Seq(Return(0), ()))",
    );
    // Any pattern a `match` arm takes: an array, a nested constructor, a literal.
    assert(
        block_dump(
            "{ let [a, ..] = xs else { return 0; }; a }",
        ) == "IfLet([a, ..] => a, xs, Seq(Return(0), ()))",
    );
    assert(
        block_dump(
            "{ let (some(a), b) = t else { return 0; }; a }",
        ) == "IfLet((some(a), b) => a, t, Seq(Return(0), ()))",
    );
    assert(
        block_dump("{ let 5 = n else { return 0; }; 1 }") == "IfLet(5 => 1, n, Seq(Return(0), ()))",
    );
    // The block returns on every path through it.
    assert(
        block_dump(
            "{ let some(v) = o else { if (c) { return 1; } else { return 2; } }; v }",
        ) == "IfLet(some(v) => v, o, If(c, Seq(Return(1), ()), Seq(Return(2), ())))",
    );

    // A block that can fall out would leave the names unbound below it, and a
    // pattern that cannot fail has no use for one.
    assert(
        block_dump(
            "{ let some(v) = o else { 1 }; v }",
        ) == "error: the `else` of a `let .. else` has to leave the function, as in `else { return none; }`",
    );
    assert(
        block_dump(
            "{ let (a, b) = t else { return 0; }; a }",
        ) == "error: `else` follows a pattern that can fail to match, like `Some(x)`; a name, a tuple or a struct pattern always matches",
    );
    assert(
        block_dump(
            "{ let x = 1 else { return 0; }; x }",
        ) == "error: `else` follows a pattern that can fail to match, like `Some(x)`; a name, a tuple or a struct pattern always matches",
    );

    // A field is bound under another name with `as`: the field is the one read
    // off the scrutinee, the name the one bound. Renamed and plain mix freely, in
    // either form, and the order the fields are written is the order they bind.
    assert(
        block_dump(
            "{ let P { x as a, y } = p; a }",
        ) == "Let(__spat$24: P, p, Let(a, __spat$24.x, Let(y, __spat$24.y, a)))",
    );
    assert(
        block_dump("{ mut P { x as a } = p; a }") == "Let(__spat$21: P, p, Mut(a, __spat$21.x, a))",
    );
    assert(
        block_dump(
            "{ let P { x, y as b, z } = p; b }",
        ) == "Let(__spat$27: P, p, Let(x, __spat$27.x, Let(b, __spat$27.y, Let(z, __spat$27.z, b))))",
    );

    // `for (let (a, b) : ps)` is a plain loop over a temporary with the field
    // reads prepended to the body.
    assert(
        block_dump(
            "{ for (let (a, b) : ps) { f(a); } }",
        ) == "Seq(For(__fpat$20, ps, Let(a, __fpat$20._0, Let(b, __fpat$20._1, Seq(f(a), 0)))), ())",
    );
    assert(
        block_dump(
            "{ for (let (a) : ps) { f(a); } }",
        ) == "error: a tuple pattern needs at least 2 names, e.g. for (let (a, b) : expr) { ... }",
    );

    // `for (let T { a, b } : ps)` is the same loop over a temporary, with the
    // struct pattern's own desugaring in front of the body — including the
    // temporary rebound under the struct's name, which is what checks it.
    assert(
        block_dump(
            "{ for (let P { x, y as b } : ps) { f(x); } }",
        ) == "Seq(For(__fpat$29, ps, Let(__spat$29: P, __fpat$29, Let(x, __spat$29.x, Let(b, __spat$29.y, Seq(f(x), 0))))), ())",
    );

    // A case pattern in the header reads the payload in front of the body, as the
    // `let` does — each name by a `match` of its own over the loop's temporary.
    assert(
        block_dump(
            "{ for (let Wrap(x) : ps) { f(x); } }",
        ) == "Seq(For(__fpat$21, ps, Let(x, Match(__fpat$21, [Wrap(x) => x]), Seq(f(x), 0))), ())",
    );
    assert(
        block_dump(
            "{ for (let i, Wrap(x) : ps) { f(x); } }",
        ) == "Seq(For([i], __fpat$24, ps, Let(x, Match(__fpat$24, [Wrap(x) => x]), Seq(f(x), 0))), ())",
    );

    // With an index, which stays on the loop and leads the pattern.
    assert(
        block_dump(
            "{ for (let i, P { x } : ps) { f(x); } }",
        ) == "Seq(For([i], __fpat$24, ps, Let(__spat$24: P, __fpat$24, Let(x, __spat$24.x, Seq(f(x), 0)))), ())",
    );

    // `for (let i, x : xs)` keeps both binders on the node — the index is
    // printed in brackets — and is lowered no further here: what an index is
    // depends on what is iterated, and only mono knows that.
    assert(
        block_dump("{ for (let i, x : xs) { f(x); } }") == "Seq(For([i], x, xs, Seq(f(x), 0)), ())",
    );

    // `for (let i, (a, b) : ps)` composes the two: the index on the node, the
    // tuple's field reads prepended to the body.
    assert(
        block_dump(
            "{ for (let i, (a, b) : ps) { f(a); } }",
        ) == "Seq(For([i], __fpat$23, ps, Let(a, __fpat$23._0, Let(b, __fpat$23._1, Seq(f(a), 0)))), ())",
    );
    assert(
        block_dump(
            "{ for (let i, (a) : ps) { f(a); } }",
        ) == "error: a tuple pattern needs at least 2 names, e.g. for (let (a, b) : expr) { ... }",
    );
})

# A whole AIPL **program**, lowered to the AST — the end of the road for stage
# 5d's AIPL half. `parse` is `parse_cst` followed by `lower`, so this builds the
# concrete tree, lowers it and throws the tree away.
pub fn lower_aipl_program(src: str) -> Program!ParseError {
    let text = aipl_source(src);
    ok(
        as_program(
            parse(text, lex_lossless(text)?, aipl_grammar(), "program")?,
            0..text.len(),
        )?.desugar(),
    )
}.test({
    // A lowered program as text, one item per line, or the refusal that stopped it.
    fn program_dump(src: str) -> str {
        match (lower_aipl_program(src)) {
            ok(pr) => pr.show_program(),
            err(e) => `error: {e.message}`,
        }
    }

    assert(
        program_dump(
            "fn f(self: Wrap(P { x, y }), n: i64) -> i64 { x }",
        ) == "fn f(self: Wrap, n: i64) -> i64 = Let(x, Match(self, [Wrap(__npat$5_0) => Let(__spat$5_0: P, __npat$5_0, Let(x, __spat$5_0.x, x))]), Let(y, Match(self, [Wrap(__npat$5_0) => Let(__spat$5_0: P, __npat$5_0, Let(y, __spat$5_0.y, y))]), x))",
    );
    assert(
        program_dump(
            "fn f(Wrap(P { x })) -> i64 { x }",
        ) == "fn f(__cpat$5: Wrap) -> i64 = Let(x, Match(__cpat$5, [Wrap(__npat$5_0) => Let(__spat$5_0: P, __npat$5_0, Let(x, __spat$5_0.x, x))]), x)",
    );

    // A function: its visibility, type parameters, effects, return type, body
    // and attribute all arrive as one list of children, told apart by what each
    // lowered to rather than by position.
    assert(program_dump("fn f() { }") == "fn f() = ()");
    assert(program_dump("pub fn f(x: i64) -> i64 { x }") == "pub fn f(x: i64) -> i64 = x");
    assert(
        program_dump(
            "fn f<T: any, U: variant>(a: T) -> U { g(a) }",
        ) == "fn f<T: any, U: variant>(a: T) -> U = g(a)",
    );
    assert(
        program_dump("fn f() !prints !reads { g(); }") == "fn f() !prints !reads = Seq(g(), ())",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ assert(f() == 1); })",
        ) == "fn f() -> i64 = 1 .test(Seq(assert(==(f(), 1)), ()))",
    );

    // Functions declared inside a `.test` block ride along with it, wherever
    // in the block they sit; the chain is what the statements around them make.
    // A `pub` helper, or one with its own `.test`, is refused.
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ fn g() -> i64 { 1 } assert(f() == g()); fn h() { } })",
        ) == "fn f() -> i64 = 1 .test(Seq(assert(==(f(), g())), ()) fn g() -> i64 = 1 fn h() = ())",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ pub fn g() -> i64 { 1 } })",
        ) == """error: a function inside a `.test` block cannot be `pub`: "g" exists only for that test""",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ fn g() { } fn g() { } })",
        ) == """error: duplicate function "g" in this `.test` block""",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ fn g() -> i64 { 1 }.test({ }) })",
        ) == """error: a function inside a `.test` block cannot carry a `.test` of its own: "g" is test code already""",
    );

    // `.performance({ .. })` is a second attribute with a block of its own: it
    // takes helpers like a `.test` block does, and the two coexist in either
    // order. Helpers are refused the same things a `.test` block refuses them.
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ assert(f() == 1); })",
        ) == "fn f() -> i64 = 1 .performance(Seq(assert(==(f(), 1)), ()))",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ fn g() -> i64 { 1 } assert(f() == g()); })",
        ) == "fn f() -> i64 = 1 .performance(Seq(assert(==(f(), g())), ()) fn g() -> i64 = 1)",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ 1 }).performance({ 2 })",
        ) == "fn f() -> i64 = 1 .test(1) .performance(2)",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ 2 }).test({ 1 })",
        ) == "fn f() -> i64 = 1 .test(1) .performance(2)",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ pub fn g() -> i64 { 1 } })",
        ) == """error: a function inside a `.test` block cannot be `pub`: "g" exists only for that test""",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ fn g() { } fn g() { } })",
        ) == """error: duplicate function "g" in this `.performance` block""",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ fn g() -> i64 { 1 }.performance({ }) })",
        ) == """error: a function inside a `.test` block cannot carry a `.performance` of its own: "g" is test code already""",
    );

    // A bare type parameter takes the `any` bound, which is what almost every
    // generic uses.
    assert(program_dump("fn f<T>(a: T) { }") == "fn f<T: any>(a: T) = ()");
    // A type parameter may carry a default, with or without a bound.
    assert(
        program_dump("fn f<T: any = i64>(a: T[]) { }") == "fn f<T: any = i64>(a: Array(T)) = ()",
    );
    assert(program_dump("fn f<T = str>(a: T) { }") == "fn f<T: any = str>(a: T) = ()");
    assert(
        program_dump(
            "fn f<T: ord = u8, U>(a: T, b: U) { }",
        ) == "fn f<T: ord = u8, U: any>(a: T, b: U) = ()",
    );
    assert(
        program_dump(
            "fn f<T: eq>(a: T) { }",
        ) == `error: unknown type parameter bound "eq"; expected "any" or "ord"`,
    );

    // The parameter shapes. What is stored is the type the *body* sees: a
    // variadic keeps the sequence its elements arrive in (`str` for `char`,
    // since an AIPL string is the char sequence), and a `k?: T` keeps `T?`.
    assert(
        program_dump(
            "fn f(mut xs: i64[], z: i64*, k?: u64 = none) { }",
        ) == "fn f(mut xs: Array(i64), z: Array(i64)*, k?: Optional(u64) = none) = ()",
    );
    assert(program_dump("fn f(c: char*) { }") == "fn f(c: str*) = ()");
    // `T+` is the non-empty sequence: the body may take its first element.
    assert(
        program_dump(
            """fn f(z: i64+, k: str+ = ["a"]) { }""",
        ) == "fn f(z: Without(Array(i64), [])+, k: Without(Array(str), [])+ = [Str(a)]) = ()",
    );
    assert(program_dump("fn f(c: char+) { }") == "fn f(c: str+) = ()");

    // `Point { x, y }` in parameter position is a scrutinee the caller never
    // named, with its fields bound off it at the top of the body.
    assert(
        program_dump(
            "fn f(Point { x, y }) -> i64 { x }",
        ) == "fn f(__spat$5: Point) -> i64 = Let(x, __spat$5.x, Let(y, __spat$5.y, x))",
    );

    // `self: Span { start, end }` is the same, with the parameter named: the
    // fields are bound off it and it stays readable whole.
    assert(
        program_dump(
            "fn f(self: Span { start, end as e }) -> Span { self }",
        ) == "fn f(self: Span) -> Span = Let(start, self.start, Let(e, self.end, self))",
    );

    // `Import(decl)` is the same for a parameter that can only be one case: its
    // type is the case's name, and the payload is read by a one-arm `match`.
    assert(
        program_dump(
            "fn f(Import(decl)) -> i64 { decl }",
        ) == "fn f(__cpat$5: Import) -> i64 = Let(decl, Match(__cpat$5, [Import(decl) => decl]), decl)",
    );
    assert(
        program_dump(
            "fn f(self: Pair(a, b)) -> i64 { b }",
        ) == "fn f(self: Pair) -> i64 = Let(a, Match(self, [Pair(a, _) => a]), Let(b, Match(self, [Pair(_, b) => b]), b))",
    );

    // The `{ field: value }` body shorthand, which resolves against the return
    // type into exactly the `Construct` the long form parses to.
    assert(
        program_dump(
            "fn f(v: i64) -> P { v, next: none }",
        ) == "fn f(v: i64) -> P = Construct(P, [v: v, next: none])",
    );
    assert(
        program_dump(
            "fn f(v: P) -> P { ..v, x: 1 }",
        ) == "fn f(v: P) -> P = Construct(P, [..v, x: 1])",
    );
    assert(program_dump("fn f(v: i64) -> P { v, }") == "fn f(v: i64) -> P = Construct(P, [v: v])");
    // The shorthand names no type, so the return type has to.
    assert(
        program_dump(
            "fn f(v: i64) { v, next: none }",
        ) == """error: fn "f": a `{ field: value, .. }` body needs a struct return type to name, but this function declares no return type; add `-> Struct`, or give the literal its type""",
    );
    assert(
        program_dump(
            "fn f(v: i64) -> i64 { v, next: none }",
        ) == """error: fn "f": a `{ field: value, .. }` body needs a struct return type to name, but this function returns i64; give the literal its type, or return a struct""",
    );

    // Declarations.
    assert(program_dump("struct P { x: i64, y: i64 = 0 }") == "struct P(x: i64, y: i64 = 0)");
    assert(
        program_dump(
            "struct B<T: any, U: variant> { v: T, w: U }",
        ) == "struct B<T: any, U: variant>(v: T, w: U)",
    );
    assert(
        program_dump(
            "variant V = A | B(i64) | C(x: i64, y: i64 = 1) | D(max?: u64 = none)",
        ) == "variant V(A | B(i64) | C(x: i64, y: i64 = 1) | D(max?: Optional(u64) = none))",
    );

    // A case takes `# ..` lines of its own, above its `|`. The variant's docs
    // and a case's are separate slots, and a documented case does not need
    // every case documented.
    assert(program_dump("""
        # A shape.
        variant V =
            # Round.
            # Has a radius.
            | Circle(i64)
            | Empty
            # Cornered.
            | Rect(i64, i64)
    """) == """
        doc(A shape.) variant V(doc(Round.
        Has a radius.) Circle(i64) | Empty | doc(Cornered.) Rect(i64, i64))
    """);

    // A payload slot takes `# ..` lines too, inside the parentheses: a bare
    // type, a named slot, and a keyword slot alike, and a documented slot
    // needs no company.
    assert(
        program_dump("""
            variant V =
                | Many(
                    # The repeated rule.
                    str,
                    # Fewest accepted.
                    min: u64 = 0,
                    max?: u64 = none
                )
        """) == "variant V(Many(doc(The repeated rule.) str, doc(Fewest accepted.) min: u64 = 0, max?: Optional(u64) = none))",
    );
    // The first case's `|` is optional; every later one is required.
    assert(program_dump("variant V = A\n| B") == "variant V(A | B)");

    // A variant refined by leaving a case out. It opens as a one-case variant
    // does, and the `without` is what makes it the other thing.
    assert(program_dump("variant W = V without C") == "variant W = Without(V, C)");
    assert(
        program_dump(
            "variant W<T> = Tree<T> without Leaf",
        ) == "variant W<T: any> = Without(Generic(Tree, T), Leaf)",
    );
    assert(
        program_dump("# Docs.\nvariant W = V without C") == "doc(Docs.) variant W = Without(V, C)",
    );
    assert(program_dump("variant V = A") == "variant V(A)");
    assert(program_dump("variant V = | A | B") == "variant V(A | B)");
    assert(
        program_dump(
            "variant V = A B",
        ) == "error: expected DocComment, `(`, `<`, `without`, `|`, an item, or end of input, found `B`",
    );
    // A documented first case has the `|` its docs sit above.
    assert(
        program_dump(
            "variant V =\n    # d\n    A | B",
        ) == "error: expected DocComment or `|`, found `A`",
    );
    // Doc lines after the last case belong to the next item, not to a case.
    assert(program_dump("variant V = A | B\n# Docs f.\nfn f() { }") == """
        variant V(A | B)
        doc(Docs f.) fn f() = ()
    """);

    // Imports. An operator is imported aliased; a bare spelling is refused by
    // the grammar itself, with the message saying what to write instead.
    assert(
        program_dump(
            "import { a, b as c, equal as == } from builtins;",
        ) == "import [a, b as c, equal as ==] from builtins",
    );
    assert(
        program_dump(
            "import { a, - } from builtins;",
        ) == """error: the "-" operator has no bare form; pick a semantics and import it aliased, e.g. `wrapping_sub as -` or `saturating_sub as -` from builtins""",
    );
    assert(program_dump("""import { x } from "./p.aipl";""") == `import [x] from "./p.aipl"`);

    // Documentation attaches at `item`, in front of the declaration — and an
    // import brings a name in rather than declaring one, so it takes none.
    assert(program_dump("# a doc\nfn f() { }") == "doc(a doc) fn f() = ()");
    assert(program_dump("# a doc\nstruct P { x: i64 }") == "doc(a doc) struct P(x: i64)");
    assert(
        program_dump(
            "# a doc\nimport { x } from builtins;",
        ) == "error: an import cannot be documented — `# ..` lines attach to the declaration below them and an `import` declares nothing; a blank line under the block makes it the file's documentation instead",
    );

    // Attachment is adjacency: a blank line under a block detaches it, and a
    // detached block at the top of a file documents the file. So the same two
    // lines are one declaration's docs or the file's, depending on one newline.
    fn module_doc(src: str) -> str {
        match (lower_aipl_program(src)) {
            ok(pr) => pr.doc.value_or("(none)"),
            err(e) => `error: {e.message}`,
        }
    }

    assert(module_doc("# a doc\nfn f() { }") == "(none)");
    assert(module_doc("# a doc\n\nfn f() { }") == "a doc");
    // Detached, so the declaration below it keeps none of it.
    assert(program_dump("# a doc\n\nfn f() { }") == "fn f() = ()");

    // The position an import makes impossible to document is the one that makes
    // a file's own documentation read naturally.
    assert(module_doc("# a doc\n\nimport { x } from builtins;\nfn f() { }") == "a doc");

    // Two runs, and the blank line between them survives as the paragraph break
    // it is — the same text a bare `#` line inside one run would produce.
    assert(module_doc("# a\n\n# b\n\nfn f() { }") == "a\n\nb");
    assert(module_doc("# a\n#\n# b\n\nfn f() { }") == "a\n\nb");

    // A block split by a blank line above a declaration: the far side documents
    // the file, the near side the declaration.
    assert(module_doc("# the file\n\n# the fn\nfn f() { }") == "the file");
    assert(program_dump("# the file\n\n# the fn\nfn f() { }") == "doc(the fn) fn f() = ()");

    // Whitespace only: a comment written in the gap neither detaches a block
    // nor hides the blank line that does.
    assert(module_doc("# a doc\n// note\nfn f() { }") == "(none)");
    assert(module_doc("# a doc\n\n// note\nfn f() { }") == "a doc");

    // Below the top of the file there is nothing for a detached block to
    // document, and it is refused rather than quietly dropped.
    assert(
        module_doc(
            "fn f() { }\n\n# stray\n\nfn g() { }",
        ) == "error: this `# ..` block documents nothing — a blank line detaches it from the declaration below, and only the block at the top of a file, which documents the file, may stand apart",
    );

    // One slot per attribute, filled by `.test({ .. })` and `.performance({ .. })`.
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.test({ 1 }).test({ 2 })",
        ) == "error: duplicate `.test` attribute",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.performance({ 1 }).performance({ 2 })",
        ) == "error: duplicate `.performance` attribute",
    );
    assert(
        program_dump(
            """fn f() -> i64 { 1 }.performance("x")""",
        ) == "error: `.performance` takes a `{ .. }` block, not a string argument",
    );
    assert(
        program_dump(
            """fn f() -> i64 { 1 }.doc("d")""",
        ) == """error: `.doc("..")` is no longer a function attribute — write the documentation as `# ..` lines above the declaration, which also documents structs and variants""",
    );
    assert(
        program_dump(
            "fn f() -> i64 { 1 }.bogus({ 1 })",
        ) == """error: unknown function attribute "bogus"; only `.test({ .. })` and `.performance({ .. })` are supported""",
    );

    // And a whole small file, which is the shape everything above is a piece of.
    assert(program_dump("""
        import { equal as == } from builtins;

        # A point.
        struct P { x: i64, y: i64 }

        pub fn same(a: P, b: P) -> bool { a.x == b.x }
    """) == """
        import [equal as ==] from builtins
        doc(A point.) struct P(x: i64, y: i64)
        pub fn same(a: P, b: P) -> bool = ==(a.x, b.x)
    """);
})

fn as_program(v: Ast, span: Span) -> Program!ParseError {
    if (let AProgram(pr) = v) {
        return ok(pr);
    };
    err(wrong_kind("a program", v, span))
}

# A lowered expression as text, or the refusal that stopped it.
fn expr_dump(src: str) -> str {
    match (lower_aipl_expr(src)) {
        ok(e) => e.show_expr(),
        err(e) => `error: {e.message}`,
    }
}

# The spacing rule for the productions the generated formatter lays out so far
# — types and imports: spaces around `->`, a space after the `:` of a dict type,
# and in an import a space after `import` and `from` and either side of `as`.
# Nothing anywhere else.
#
# Everything else a reader would call spacing is a list separating its items,
# which the group layouts do, or a suffix written against its core, which
# `Tight` does. That is the shape the rule takes in a real language: a handful
# of tokens that want air, and silence for the rest. It is asked about the
# spellings on either side of a gap, so `import` then `{` is one question
# (yes) and `#` then `{` in a set type is another (no).
fn aipl_space(l: str, r: str) -> bool {
    l == "->" || r == "->" || l == ":" || l == "import" || l == "from" || l == "as" || r == "as" || r == "from" || l == "without" || r == "without"
}

# The whole rule set, read losslessly — every byte accounted for by a token or a
# trivia record. Lexing and parsing report failure in the same shape but not the
# same type, so the conversion happens once, here.
#
# Public because the two halves are worth having apart: a caller parsing many
# sources prepares the grammar once (`prepare`) and then pays only this and
# `parse_prepared` per file. `aipl_parse_cst` is the one-shot convenience.
pub fn lex_lossless(text: str) -> LexResult<AiplTok>!ParseError {
    text
        .lex(aipl_rules().keep_skipped())
        .map_err(|e| ParseError { message: e.message, span: e.span })
}

# `src` lowered to the AST, as the AST — the FFI entry the Rust side rebuilds an
# `aipl_syntax::ast::Program` from. This is the bridge stage 5a chose: lower in
# AIPL, marshal the result, reconstruct on the other side.
pub fn aipl_program(src: str) -> Program!ParseError { lower_aipl_program(src) }.test({
    assert(aipl_program("fn f() { }")?.show_program() == "fn f() = ()");
    assert(match (aipl_program("fn f( {")) {
        ok(..) => false,
        err(..) => true,
    });
})

# What a source file parses to: its program, and the spans of every `#[allow]`
# lint-squelch marker in it.
#
# The markers are the parser's one *side-channel* — they are trivia, so no
# production ever sees one, and the loader's lint pass still needs them to drop
# a hit squelched on the same line. They ride out on the return value rather
# than through a sink the caller has to arm first.
struct ParsedFile { program: Program, allows: Span[] }

# Why a source file has no program: every syntax error in it, in source order — the
# ones the grammar recovered from (a missing `;` after a statement, say; see
# `Expect`) and the one it could not. Never empty. A file with several slips
# reports all of them, where `aipl_parse_cst` stops at the first.
#
# Only syntax errors recover. A lexing failure, trailing whitespace, a build that
# refuses (a duplicate `.test`) and a `Refuse` each end the parse where they are,
# and are the last error, after those met before them.
struct ParseFailure { errors: ParseError[] }

# `e` as the failure it is by itself.
fn failure(e: ParseError) -> ParseFailure { errors: [e] }

# The grammar of AIPL, built the first time a file is parsed and shared by every
# parse after it.
let GRAMMAR: Grammar<AiplTok, Ast> = aipl_grammar();

# The grammar linked and analysed (`prepare`), likewise built once. Both are a
# function of the grammar alone, so a process that parses many files — the
# compiler parses the program, everything it imports and every builtin it
# reaches — does the work once instead of per file.
let PREPARED_GRAMMAR: Prepared<AiplTok, Ast>!ParseError = prepare(aipl_grammar());

# The whole of `aipl_parser::parse_with_allows`, on this side: strip the
# expected-output sections, refuse trailing whitespace, lex losslessly, keep the
# `#[allow]` spans, parse and lower.
#
# What it deliberately does *not* do is what follows a parse but is no part of
# one: `parse_and_partial_load` hoists test functions and promotes type
# variables, and the loader bakes the locations of `assert` and `trace`.
#
# A tree that recovered from a missing token is a tree of broken input, and is
# never lowered: the errors come back instead.
pub fn aipl_parse_file(src: str) -> ParsedFile!ParseFailure {
    let ParsedFile { program, allows } = aipl_parse_surface_file(src)?;
    ok(ParsedFile { program: program.desugar(), allows })
}

# `aipl_parse_file`, stopping before the destructuring forms are lowered: the
# program as written, which is what the lints read. Everything else wants the
# lowered one.
pub fn aipl_parse_surface_file(src: str) -> ParsedFile!ParseFailure {
    let text = reject_trailing_whitespace(aipl_source(src)).map_err(failure)?;
    let lexed = lex_lossless(text).map_err(failure)?;
    let allows = allow_spans(lexed);
    let prep = PREPARED_GRAMMAR.map_err(failure)?;
    let Recovered { cst, errors } = parse_prepared_recovering(text, lexed, prep, "program").map_err(
        failure,
    )?;
    if (errors.is_nonempty()) {
        return err(ParseFailure { errors });
    };
    let tree = cst.value_or_err(failure(ParseError {
        message: "the start rule built no node",
        span: 0..0,
    }))?;
    let ast = lower(text, tree, GRAMMAR).map_err(failure)?;
    let program = as_program(ast, 0..text.len()).map_err(failure)?;
    ok(ParsedFile { program, allows })
}.test({
    let ParsedFile { program, allows } = aipl_parse_file("fn f() { g(); } #[allow]\n")?;
    assert(program.show_program() == "fn f() = Seq(g(), ())");

    // Every named parameter shape, lowered. The six are six distinct runs of
    // positions — which position holds the lowered type, and whether one holds
    // a default — so this is what proves `lower_param` tells them apart by
    // shape rather than by searching the tokens for a `mut`, a `?` or an `=`.
    let named = aipl_parse_file(
        "fn f(a: i64, mut b: i64, c: i64 = 1, d?: i64 = none, e: i64*, g: i64+) { }",
    )?;
    let want = "fn f(a: i64, mut b: i64, c: i64 = 1, d?: Optional(i64) = none, e: Array(i64)*, g: Without(Array(i64), [])+) = ()";
    assert(named.program.show_program() == want);

    // Every postfix step, lowered. The seven are seven distinct runs of
    // positions, brackets included — in particular `v[..3]` and `v[4..]`, which
    // differ only in which position holds the operand.
    let suffixes = aipl_parse_file("fn h(v: i64) { v.a; v.0; v.m(1); v[2]; v[..3]; v[4..]; v?; }")?;
    // Two indexes read one cell of a grid, and are the builtin call that answers it.
    assert(
        aipl_parse_file(
            "fn h(g: i64[,]) { g[1, 2]; }",
        )?.program.show_program() == "fn h(g: Generic(__builtin_Grid, i64)) = Seq(__builtin_grid_get(g, 1, 2), ())",
    );
    let want_suffixes = "fn h(v: i64) = Seq(v.a, Seq(v._0, Seq(v.m(1), Seq(Index(v, 2), Seq(Slice(v, 0, 3), Seq(Slice(v, 4, ), Seq(Try(v), ())))))))";
    assert(suffixes.program.show_program() == want_suffixes);

    // The seventh shape, the destructuring one, which holds a repetition and so
    // is the one alternative whose positions do not line up.
    let destructured = aipl_parse_file("fn g(Point { x, y }) { }")?;
    let renamed = aipl_parse_file("fn g(Point { x as px, y }) { }")?;
    assert(
        renamed.program.show_program() == "fn g(__spat$5: Point) = Let(px, __spat$5.x, Let(y, __spat$5.y, ()))",
    );
    assert(
        destructured.program.show_program() == "fn g(__spat$5: Point) = Let(x, __spat$5.x, Let(y, __spat$5.y, ()))",
    );
    assert(allows == [16..24]);

    // No markers is an empty list, not an absence.
    let none_marked: Span[] = [];
    assert(aipl_parse_file("fn f() { }")?.allows == none_marked);

    // Trailing whitespace is refused before the parse, as a property of the
    // source text rather than of its syntax — so a file that would parse fine
    // still does not.
    assert(
        match (aipl_parse_file("fn f() { } \n")) {
            ok(..) => "parsed",
            err(f) => f.errors$message.join(sep="; "),
        } == "trailing whitespace is not allowed",
    );

    // Every syntax error in the file, not the first: a statement missing its `;` is
    // committed to and recovered from, so the parse reads on and finds the next.
    fn messages(src: str) -> str[] {
        match (aipl_parse_file(src)) {
            ok(..) => [],
            err(f) => f.errors$message,
        }
    }

    // A program that parses has no errors.
    assert(messages("fn f() { let x = 1; x }") == []);

    // Each statement's `;` is committed to, so a missing one is reported where it
    // is and the parse reads on — which is why the second slip is found at all.
    let semi = "expected `;`";
    assert(messages("fn f() { let x = 1 let y = 2 y }") == [
        `{semi}, found \`let\``,
        `{semi}, found \`y\``,
    ]);

    // Across items, and across statement kinds: a missing `from`, then the `;`
    // of an import, a constant, a `set` and a `return` — five errors, one parse.
    let src = "import { a } builtins\nlet X: i64 = 1\nfn f() { set x++ return 1 }";
    assert(messages(src) == [
        "expected `from`, found `builtins`",
        "expected `;`, found `let`",
        `{semi}, found \`fn\``,
        "expected `;`, found `return`",
        `{semi}, found \`}\``,
    ]);

    // Where they are is part of the answer: each error points at the token found.
    let spans = match (aipl_parse_file("fn f() { let x = 1 let y = 2; }")) {
        ok(..) => [],
        err(f) => f.errors$span,
    };
    assert(spans == [19..22]);

    // A `Refuse` is not recovered from: the statement-start check has a better word
    // for a missing `;` inside a loop than "expected", and ends the parse with it.
    let loop_slip = "missing `;` before `h`: every statement ends with one, even an `if` or `match` whose value is unused";
    assert(messages("fn f() { while (c) { g() h(); } }") == [loop_slip]);

    // But it comes last, and what was met before it is not lost: the slip in the
    // first statement is reported, then the refusal that stopped the parse.
    assert(messages("fn f() { let x = 1 let y = 2; while (c) { g() h(); } }") == [
        `{semi}, found \`let\``,
        loop_slip,
    ]);

    // The same for a parse that simply cannot go on. The brace never closes, so
    // the function is given up on whole — and the slip inside it is still reported,
    // ahead of the failure.
    assert(messages("fn f() { let x = 1 let y = 2;") == [
        `{semi}, found \`let\``,
        "expected `}`, a statement, or an expression, found end of input (`{` at line 1 is never closed)",
    ]);
})

# `src` unchanged, or a refusal locating its first run of trailing whitespace.
# The locator is `find_trailing_whitespace.aipl`, which is the same function
# `aipl_parser::reject_trailing_whitespace` reaches through the FFI — so the two
# parsers do not merely agree here, they run the same code.
fn reject_trailing_whitespace(src: str) -> str!ParseError {
    match (find_trailing_whitespace(src)) {
        some(span) => err(ParseError { message: "trailing whitespace is not allowed", span }),
        none => ok(src),
    }
}

# Every `#[allow]` marker's span, in source order. The lexer records them as
# trivia under a kind of their own, so this is a filter rather than a re-scan.
fn allow_spans(lexed: LexResult<AiplTok>) -> Span[] {
    lexed.trivia.filter(|t| t.kind == AllowMarker)$text$span
}

# Why `src` does not parse, or `none` when it does — the FFI entry the
# error-message comparison reads. A refusal from a `build` (a mixed `#{ .. }`,
# a duplicate `.test`) comes back the same way a syntax error does, since both
# are reasons a source has no AST.
pub fn aipl_parse_error(src: str) -> ParseError? {
    match (aipl_program(src)) {
        ok(..) => none,
        err(e) => some(e),
    }
}.test({
    assert(aipl_parse_error("fn f() { }") == none);
    assert(aipl_parse_error("fn f( {").is_some());

    // A build action's refusal, which is not a syntax error and is still a
    // reason there is no program.
    assert(aipl_parse_error("fn f() { let s = #{1, 2: 3}; }").is_some());
})

# Every interior node's token span under `t`, itself included, depth first.
fn node_spans(t: Cst) -> u64[] {
    let own: u64[] = t.token_span().map(|sp| [sp.start, sp.end]).value_or([]);
    [..own, ..t.parts().children.map(node_spans).join()]
}

# What this grammar makes of `src`, in one string: empty when it parses *and*
# its concrete tree reconstructs the source byte for byte, and otherwise a line
# beginning `error:` (it did not parse, with the message) or `lossless:` (it did,
# but the tree lost bytes).
#
# The FFI entry the corpus test calls — one crossing and one parse per file,
# checking both properties at once. Rejection is half of it: a grammar that
# accepts everything says nothing about what the language is.
pub fn aipl_parse_report(src: str) -> str {
    let text = aipl_source(src);
    match (aipl_parse_cst(src)) {
        ok(tree) => if (tree.text(text) == text) {
            ""
        } else {
            "lossless: the tree does not reconstruct the source"
        },
        err(e) => `error: {e.message}`,
    }
}.test({
    // Empty means both properties held.
    assert(aipl_parse_report("fn f() { }") == "");

    // Losslessness, over the byte-losing shapes: the bytes a token stream drops
    // are comments, whitespace and blank lines...
    assert(aipl_parse_report("// lead\nfn f() {\n\n    // inner\n}\n") == "");
    assert(aipl_parse_report("import {\n    a,\n    b,\n} from builtins;\n") == "");

    // ... and the braces around a template interpolation, which the segment
    // tokens on either side of it span between them.
    assert(aipl_parse_report("fn f() { let s = `a{b}c{d}e`; }\n") == "");
    assert(aipl_parse_report("fn f() { let s = ```a{b}c```; }\n") == "");

    assert(aipl_parse_report("fn main() { }") == "");
    assert(aipl_parse_report("fn f() { let x = ; }") == "error: expected an expression, found `;`");
    // A file whose tail is expected output still reports on the source half.
    assert(aipl_parse_report("fn main() { }\n--- stdout ---\nx\n") == "");
})

# Whether `src` parses as AIPL. The FFI entry the corpus differential test
# calls: it compares this against `aipl_parser::parse` succeeding, file by
# file, over every `.aipl` in the repository.
pub fn aipl_parses(src: str) -> bool {
    match (aipl_parse_cst(src)) {
        ok(..) => true,
        err(..) => false,
    }
}.test({
    // The same, against an analysed grammar — the path that prunes on FIRST sets.
    // `parse.aipl` proves pruning is invisible against toy grammars; this asks the
    // same question of the real one, where the sets are large and nearly every
    // production reference is a candidate to skip.
    fn why_prepared(src: str) -> str {
        let text = aipl_source(src);
        let parsed = match (lex_lossless(text)) {
            ok(lexed) => match (prepare(aipl_grammar())) {
                ok(prep) => parse_prepared(text, lexed, prep, "program"),
                err(e) => err(e),
            },
            err(e) => err(e),
        };
        match (parsed) {
            ok(..) => "parsed",
            err(e) => e.message,
        }
    }

    // ---- Unclosed brackets ----
    //
    // Every bracketed form in the grammar is a group, so running out of input
    // inside one names the bracket that opened it. This is the message a flat
    // `Then` cannot produce: by the time the close fails, a sequence has no idea
    // an open ever matched.
    assert(
        why(
            "fn f() {\n    g();\n",
        ) == "expected `}`, a statement, or an expression, found end of input (`{` at line 1 is never closed)",
    );
    assert(
        why(
            "struct P {\n    x: i64,\n",
        ) == "expected Name or `}`, found end of input (`{` at line 1 is never closed)",
    );

    // The innermost open bracket is the one named, and its own line is the one
    // reported — which is the whole value of this, the two being pages apart in
    // the source that actually provokes it.
    assert(
        why(
            "fn f() {\n    g(1,\n    2",
        ) == "expected `$`, `)`, `,`, `.`, `?`, `[`, or an operator, found end of input (`(` at line 2 is never closed)",
    );

    // A bracket that *is* closed is never blamed. Both of these fail with a real
    // token sitting where a close would go, so the plain message is the true one
    // and inventing a hanging bracket would send the reader the wrong way.
    assert(!why("fn f() {\n    g(1, 2\n}").contains("never closed"));
    assert(!why("fn f() { }}").contains("never closed"));
    assert(why("fn f() { g(1,) }") == "parsed");

    // ---- Pruning the real grammar changes nothing ----
    //
    // Every message above, asked again of an analysed grammar. AIPL's `atom` is
    // twenty alternatives behind one production reference each, so this is where
    // pruning does the most work and where losing an expectation would be most
    // visible.
    assert(why_prepared("fn f() {\n    g();\n") == why("fn f() {\n    g();\n"));
    assert(why_prepared("struct P {\n    x: i64,\n") == why("struct P {\n    x: i64,\n"));
    assert(why_prepared("fn f() {\n    g(1,\n    2") == why("fn f() {\n    g(1,\n    2"));
    assert(why_prepared("fn f() {\n    g(1, 2\n}") == why("fn f() {\n    g(1, 2\n}"));
    assert(why_prepared("fn f() { }}") == why("fn f() { }}"));
    assert(why_prepared("fn f() { g(1,) }") == "parsed");
    assert(why_prepared("let x = 1;") == why("let x = 1;"));
    assert(why_prepared("fn f(a: ) { }") == why("fn f(a: ) { }"));
    assert(why_prepared("match") == why("match"));

    // Doc comments in front of a declaration, and only there.
    assert(parses("# One line.\nfn f() { }"));
    assert(parses("# One.\n#\n# Two, after a blank line.\nstruct P { x: i64 }"));
    assert(parses("# Docs.\nvariant V = A | B"));
    assert(parses("#\nfn f() { }")); // a bare `#` is an empty doc line
    // Not inside a body, where a `//` banner lives instead.
    assert(!parses("fn f() {\n    # nope\n    g();\n}"));
    assert(!parses("fn f(\n    # nope\n    a: i64,\n) { }"));
    // `(A, B)?` — an optional tuple, alongside the other `(`-led type forms.
    assert(parses("fn f() -> (i64, str)? { none }"));
    assert(parses("fn f(p: (i64, str)?) { }"));
    assert(parses("fn f() -> (i64, str, bool)? { none }"));
    // A tuple is not a `base_ty`, so its `?` does not chain into `[]`.
    assert(!parses("fn f() -> (i64, str)?[] { none }"));

    // `#{..}` is still a set literal, and `#[allow]` still a lint marker.
    assert(parses("fn f() -> #{i64} { #{1, 2} }"));

    // Items.
    assert(parses("import { map, equal as == } from builtins;"));
    assert(parses("""import { Cst } from "./cst.aipl";"""));
    assert(parses("struct P { x: i64, y: i64 = 0 }"));
    assert(parses("struct B<T: any, U: variant> { v: T, w: U }"));
    assert(parses("variant V = A | B(i64) | C(x: i64, y: i64 = 1)"));
    assert(parses("variant V = | A | B"));
    assert(parses("variant V =\n    # doc\n    | A\n    # doc\n    | B"));

    // Types, including every postfix and bracket form.
    assert(parses("fn f(a: str[], b: i64?, c: (i64, str), d: (i64) -> str) -> i64!str { 0 }"));
    assert(parses("fn f(a: #{i64}, b: #{str: i64}, c: Box<T>[]) { }"));
    assert(parses("fn f() -> !Error { ok(0) }"));

    // Statements.
    assert(parses("fn f() { let x = 1; mut y: i64 = 2; set y = x; set y++; set y += 1; }"));
    assert(parses("fn f() { let (a, b) = p; let P { x, y } = p; mut P { x } = p; }"));
    assert(parses("fn f() { for (let x : xs) { g(x); } for (let i, x : xs) { } }"));
    assert(parses("fn f() { while (b) { set n--; } return 1; }"));
    assert(parses("fn f() { set a.b.c = 1; set a.push(1); }"));

    // Expressions: precedence, postfix chains, and every atom shape.
    assert(parses("fn f() -> i64 { 1 + 2 * 3 == 4 && x }"));
    assert(parses("fn f() -> i64 { a.b.c(1).d[2][3..4][..5][6..]? }"));
    assert(parses("fn f() { let s = `a{b}c{d}e`; }"));
    assert(parses("fn f() { let t = (1, 2, 3); let u = [1, 2, ..rest]; }"));
    assert(parses("fn f() { let s = #{1, 2}; let d = #{1: 2}; let e = #{}; }"));
    // `#{:}` was the old empty-dict spelling; `#{}` covers both now.
    assert(!parses("fn f() { let g = #{:}; }"));
    assert(parses("fn f() { g(|x| x, || 1, ||{ 2 }, +, k = 3); }"));
    assert(parses("fn f() { let h = |x: i64| { x }; }"));
    assert(parses("fn f() -> i64 { if (a) { 1 } else if (b) { 2 } else { 3 } }"));
    assert(parses("fn f() { if (let some(v) = o) { g(v); } }"));
    assert(parses("fn f() { shim prints { print = p } { g(); } }"));

    // Patterns, including alternation and the ignored payload.
    assert(parses("fn f(v: V) -> i64 { match (v) { A(x) | B(x) => x, C(..) => 1, _ => 0 } }"));
    assert(parses(
        """fn f(v: V) -> i64 { match (v) { V.A => 1, V.B(x) => x, "s" => 2, _ => 0 } }""",
    ));
    assert(parses("fn f(v: V) { match (v) { none => { g(); }, some(x) => { h(x); } }; }"));

    // A parameter destructured in place of being named.
    assert(parses("fn f(Point { x, y }) -> i64 { x }"));
    assert(parses("fn f(Point { x, }, n: i64) -> i64 { x }"));
    assert(!parses("fn f(Point { }) -> i64 { 0 }"));
    assert(parses("fn f(Point { x as px, y }) -> i64 { px }"));
    assert(parses("fn f(Point { x as px, }, n: i64) -> i64 { px }"));
    assert(!parses("fn f(Point { x as }) -> i64 { 0 }"));
    assert(!parses("fn f(Point { as x }) -> i64 { 0 }"));
    assert(!parses("fn f() { let P { x as } = p; }"));

    // Attributes and the struct-literal body shorthand.
    // The string-argument attribute parses; refusing `.doc` by name is the
    // build action's job, not the grammar's.
    assert(parses("""fn f() -> i64 { 1 }.doc("d").test({ assert(f() == 1); })"""));
    assert(parses("fn f(v: i64) -> P { v, next: none }"));
    assert(parses("fn f(v: P) -> P { ..v, x: 1 }"));
    assert(parses("fn f(v: i64) -> P { v, }"));
    // `{ x }` is a block returning `x`, not a one-field shorthand.
    assert(parses("fn f(x: i64) -> i64 { x }"));

    // Things that must *not* parse.
    assert(!parses("fn f() { let x = ; }"));
    assert(!parses("fn f( { }"));
    assert(!parses("fn f<>() { }"));
    assert(!parses("fn f() { 1 }}"));
    assert(!parses("variant V = "));
    // A loop body takes no trailing expression: its value could never be read.
    assert(!parses("fn f() { while (b) { 1 } }"));
})

// ---------- production helpers ----------

# One production, laid out `Inline`. `build` takes the wrapped `Build`, not the
# function — a function value may be *called* through a parameter but not
# stored into a field or a constructor from one, so `Mk` has to be written at
# the call site where the name is still a name.
#
# `Inline` is the default in the same sense `expect_as: ""` is: it is what a
# production says when it has nothing particular to say. A production whose
# layout matters names it through `pt` below.
fn p(name: str, rule: Rule<AiplTok>, build: Build<Ast>) -> Production<AiplTok, Ast> {
    name,
    rule,
    build,
    layout: Inline,
}

# The same, labelled: what an error blames when this production fails having
# matched nothing. The reified form of the LR parser's `SYMBOL_DISPLAY_NAMES`,
# which is why only the handful of rules a reader would name are labelled and
# every plumbing rule stays transparent.
fn pl(name: str, rule: Rule<AiplTok>, expect_as: str, build: Build<Ast>) -> Production<
    AiplTok,
    Ast
> { name, rule, build, expect_as, layout: Inline }

# The bracket pairs, for `Many`'s `nested_in`. A pair rather than two arguments
# because that is what a bracket is, and naming them here keeps the lists below
# reading as lists: `Many(param, sep=comma, nested_in=parens())`.
fn parens() -> (Rule<AiplTok>, Rule<AiplTok>) {
    let open: Rule<AiplTok> = Lit("(");
    let close: Rule<AiplTok> = Lit(")");
    (open, close)
}

fn braces() -> (Rule<AiplTok>, Rule<AiplTok>) {
    let open: Rule<AiplTok> = Lit("{");
    let close: Rule<AiplTok> = Lit("}");
    (open, close)
}

fn brackets() -> (Rule<AiplTok>, Rule<AiplTok>) {
    let open: Rule<AiplTok> = Lit("[");
    let close: Rule<AiplTok> = Lit("]");
    (open, close)
}

fn angles() -> (Rule<AiplTok>, Rule<AiplTok>) {
    let open: Rule<AiplTok> = Lit("<");
    let close: Rule<AiplTok> = Lit(">");
    (open, close)
}

# The same token both ends, which a lambda's parameter list is.
fn pipes() -> (Rule<AiplTok>, Rule<AiplTok>) {
    let open: Rule<AiplTok> = Lit("|");
    let close: Rule<AiplTok> = Lit("|");
    (open, close)
}

# A bracketed group: `open`, whatever it holds, `close`, and how that lays out.
# Shorter than the `Many` it builds, because a grammar this size writes a lot of
# them and the four arguments matter more than the spelling.
#
# `min=1, max=1` is "exactly one thing in brackets" — the body is a single rule,
# not a list. The layout still is a list's, and `style` says so outright: what
# these groups hold is usually a production that is itself a list (`(args)`), and
# the `Many` holding it has no separator of its own to read one off.
fn nest(open: str, body: Rule<AiplTok>, close: str, style: ListStyle) -> Rule<AiplTok> {
    let open_rule: Rule<AiplTok> = Lit(open);
    let close_rule: Rule<AiplTok> = Lit(close);
    Many(body, min=1, max=1, nested_in=(open_rule, close_rule), style=style)
}

# The same for a bracket written as two tokens (`#{`), which is a bracket like
# any other — the group says where it ends, so nothing downstream counts tokens
# to find out.
fn nest2(open1: str, open2: str, body: Rule<AiplTok>, close: str, style: ListStyle) -> Rule<
    AiplTok
> {
    let open_rule: Rule<AiplTok> = Then([Lit(open1), Lit(open2)]);
    let close_rule: Rule<AiplTok> = Lit(close);
    Many(body, min=1, max=1, nested_in=(open_rule, close_rule), style=style)
}

# And for one written as three (`#>{`, `#<{` — the ordered-set brackets).
fn nest3(
    open1: str,
    open2: str,
    open3: str,
    body: Rule<AiplTok>,
    close: str,
    style: ListStyle,
) -> Rule<AiplTok> {
    let open_rule: Rule<AiplTok> = Then([Lit(open1), Lit(open2), Lit(open3)]);
    let close_rule: Rule<AiplTok> = Lit(close);
    Many(body, min=1, max=1, nested_in=(open_rule, close_rule), style=style)
}

# The braces of a struct pattern: the fields it reads, each optionally bound
# under another name — `Point { x, y as py }`. The field leads and the name it is
# bound as follows `as`, so the pattern reads like the import that renames
# (`wrapping_add as +`) and a reader can tell which side is the struct's.
# `(a, b)` after a case's name: one binder per payload slot, `_` for a slot not
# wanted. Only a `let`, a `for` and a parameter take one, and only over a value
# that can be nothing but that case.
fn case_payload() -> Rule<AiplTok> {
    // A case pattern's parenthesized slots, each a pattern of its own.
    nest("(", Named("ctor_payload"), ")", strict())
}

fn arm_binders() -> Rule<AiplTok> {
    Many(Term(Name), min=1, sep=Lit(","), trailing_sep=false, nested_in=parens())
}

fn field_binders() -> Rule<AiplTok> {
    let binder: Rule<AiplTok> = Then([Term(Name), Maybe(Then([Lit("as"), Term(Name)]))]);
    Many(binder, min=1, sep=Lit(","), nested_in=braces(), spaced=true)
}

# The order a `#`-led bracket names, from the token after the `#`: `>` is
# largest first, `<` smallest first, and the plain `{` promises none.
fn order_after_hash(toks: str[]) -> SetOrder {
    match (toks) {
        [_, after, ..] => set_order(after),
        _ => Unordered,
    }
}

fn set_order(after_hash: str) -> SetOrder {
    match (after_hash) {
        ">" => Desc,
        "<" => Asc,
        _ => Unordered,
    }
}.test({
    assert(set_order(">").same_case(Desc));
    assert(set_order("<").same_case(Asc));
    assert(set_order("{").same_case(Unordered));
})

# Exactly one thing, in a bracket pair — a condition's parentheses, a block's
# braces, an index's brackets. `Many` bounded at one, and spelled like one:
# `one(body, nested_in=parens())`, `nested_in` declared exactly as `Many`
# declares its own. `min=1, max=1` is what says it is not a list, and `desugar`
# reads that back as a group laid out inline rather than broken at a width. It
# is still a group, so an unclosed one is reported against the token that
# opened it.
fn one(body: Rule<AiplTok>, nested_in?: (Rule<AiplTok>, Rule<AiplTok>) = none) -> Rule<AiplTok> {
    Many(body, min=1, max=1, nested_in?=nested_in)
}

# A comma-separated list that takes no trailing comma when it breaks, which most
# of AIPL's bracketed positions want.
fn strict() -> ListStyle { trailing: false }

# A comma-separated list that gains a trailing comma once it breaks — argument
# lists, array literals, struct literals.
fn loose() -> ListStyle { ListStyle {} }

# The same, in braces that read as words and so take inner spaces while flat:
# `{ a, b }` against `(a, b)`.
fn braced() -> ListStyle { spaced: true }

# A production whose parts are written against each other with no space between
# them, whatever the spacing rule would otherwise say: `i64?[]`, `#{`.
fn pt(name: str, rule: Rule<AiplTok>, build: Build<Ast>) -> Production<AiplTok, Ast> {
    name,
    rule,
    build,
    layout: Tight,
}

// ---------- lowering: types ----------
//
// The first slice of stage 5d. Types are the one part of the grammar that
// closes over itself — nothing under `ty` reaches an expression — so they are
// where the lowering can be written and judged whole.
//
// Two things do the work that a `match` on the alternative would do in an LR
// build action, since a `Tree` records which *production* matched and not
// which of its alternatives:
//
//   - **The `Ast` case a child lowered to.** `ty_parens` lowers to `ATys`, a
//     *list* of types, and every other type production to `ATy`. So `(A, B)!E`
//     and `A!E` arrive at `ty` distinguishable without looking at a token: one
//     has a list on the left and the other a type.
//   - **The node's own tokens.** `own_token_text` is the tokens this production
//     matched directly, with its children's left out — `->`, `!`, `?`, `[]` for
//     `ty`, and the suffix run for `base_ty`. A production that matched none is
//     the pass-through alternative.

# What a production lowered, where something else was wanted. Every one of these
# is a lowering bug rather than a bad program — the grammar guarantees the shape
# — so the message names both sides and leaves it there.
fn wrong_kind(want: str, got: Ast, span: Span) -> ParseError {
    message: `a production lowered {got.ast_case_name()} where {want} was expected`,
    span,
}

# The projections out of `Ast`, one per case a `build` reads. Each is an `if let`
# rather than a `match`: a `match` on a fourteen-case variant has to spell every
# other case out, once per projection, and what they all do is the same refusal.
fn as_ty(v: Ast, span: Span) -> Ty!ParseError {
    if (let ATy(t) = v) {
        return ok(t);
    };
    err(wrong_kind("a type", v, span))
}

fn as_exclusion(v: Ast, span: Span) -> Exclusion!ParseError {
    if (let AExclusion(x) = v) {
        return ok(x);
    };
    err(wrong_kind("a `without` exclusion", v, span))
}

# Child `i`, or a refusal. A `build` reads its children positionally, and a
# missing one means the rule and the lowering disagree about the production's
# shape — the failure mode this exists to name.
fn kid(kids: Ast[], i: u64, span: Span) -> Ast!ParseError {
    kids[i].value_or_err(ParseError { message: `a production has no child {i}`, span })
}

# A parenthesized list used as a tuple — or, with one element, as a grouping:
# `(T[] without [])?` is how a refined type takes a suffix, since `without`
# binds looser than any. The arity is validated in the lowering rather than in
# the grammar: `(A)` and `()` are parenthesized lists that parse, and only what
# follows them says whether they
# were meant as a tuple or as a function type's parameters. `example` completes
# the advice with the suffix that was actually written.
fn tuple_ty(ts: Ty[], example: str, span: Span) -> Ty!ParseError {
    match (ts) {
        [] => err(ParseError {
            message: `a tuple type needs at least 2 elements, e.g. (i64, str){example}`,
            span,
        }),
        [t] => ok(t),
        _ => ok(TyTuple(ts)),
    }
}

# What a bare type identifier names: a primitive, the anonymous bound `any`, or
# something declared elsewhere — a struct, a variant, a type parameter, `Error`.
# The same three-way decision `BaseTy::Named`'s action makes, in the same order.
fn named_ty(name: str) -> Ty {
    match (prim_from_name(name)) {
        some(p) => TyPrimitive(p),
        none => if (name == "any") { TyAny } else { TyNamed(name) },
    }
}

# `ty` — a head, refined by the `without` clause when one followed it. The
# clause's child count is what says whether it did: the head alone, or the head
# and what it excludes.
fn lower_ty(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    match (kids) {
        [head, x] => ok(ATy(TyWithout(as_ty(head, sp)?, as_exclusion(x, sp)?))),
        [head] => ok(ATy(as_ty(head, sp)?)),
        _ => err(ParseError { message: "a type matched no alternative", span: sp }),
    }
}

# `exclusion` — what a `without` clause leaves out: `[]`, or a case by name. The
# first token tells them apart, since the name is the only form that starts with
# one.
fn lower_exclusion(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    match (node.own_texts(src)) {
        ["[", ..] => ok(AExclusion(EmptyArray)),
        [name, ..] => ok(AExclusion(NamedCase(name))),
        _ => err(ParseError { message: "an exclusion matched no token", span: node.span() }),
    }
}

# `ty_head` — the eight alternatives, told apart by their left child's `Ast` case
# and by the tokens this node matched itself.
#
# `!E` is the one alternative with no left operand at all: a result whose ok side
# is unit, which is why a single child under a `!` lowers to `TyResult(TyUnit, ..)`.
fn lower_ty_head(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    let ops = node.own_token_text(src);
    let head = kid(kids, 0, sp)?;
    if (kids.len() == 2) {
        let rhs = as_ty(kid(kids, 1, sp)?, sp)?;

        // `(A, B) -> R` and `(A, B)!E`: a list on the left, and the token
        // between says which. Anything else on the left is `A!E`.
        if (let ATys(ts) = head) {
            if (ops == "->") {
                return ok(ATy(TyFn(ts, rhs)));
            };
            return ok(ATy(TyResult(tuple_ty(ts, "!Error", sp)?, rhs)));
        };
        return ok(ATy(TyResult(as_ty(head, sp)?, rhs)));
    };
    if (let ATys(ts) = head) {
        return match (ops) {
            "[]" => ok(ATy(TyArray(tuple_ty(ts, "[]", sp)?))),
            "?" => ok(ATy(TyOptional(tuple_ty(ts, "?", sp)?))),
            _ => ok(ATy(tuple_ty(ts, "", sp)?)),
        };
    };
    let t = as_ty(head, sp)?;
    if (ops == "!") {
        return ok(ATy(TyResult(TyUnit, t)));
    };
    ok(ATy(t))
}

# `ty_parens` — the parenthesized list every `(`-led type form opens with. It is
# the one production whose value is a list rather than a type, and that is what
# `lower_ty` reads to tell those forms from the unparenthesized ones.
fn lower_ty_parens(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    ok(ATys(kids.try_map(|k| as_ty(k, sp))?))
}

# `base_ty` — a core and its `?`/`[]` suffix run, applied in source order, so
# `i64?[]` is an array of optionals and `i64[]?` an optional array. The suffixes
# are literals inside a `Many` and so are this node's own tokens; `[` contributes
# nothing and `]` is what closes an array suffix.
fn lower_base_ty(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    mut ty = as_ty(kid(kids, 0, sp)?, sp)?;

    // `[,]` is three tokens and `[]` is two, so a `]` is an array only when the
    // `,` that would have made it a grid has not just been seen.
    mut in_grid = false;
    for (let tok : node.tokens) {
        match (src[tok]) {
            "?" => {
                set ty = TyOptional(ty);
            },
            "," => {
                set ty = TyGeneric("__builtin_Grid", [ty]);
                set in_grid = true;
            },
            "]" => {
                if (in_grid) {
                    set in_grid = false;
                } else {
                    set ty = TyArray(ty);
                };
            },
            _ => {},
        };
    }
    ok(ATy(ty))
}

# `ty_core` — `#{K: V}`, `#{T}`, `Name<A, B>` and a bare `Name`. The `#` is what
# separates the two brace forms from the two name forms, and after that the
# child count says which of each pair matched.
#
# `Case<V>` borrows the generic-application syntax but is a type of its own: one
# case of a variant, carrying no payload. Spelled out here so nothing downstream
# has to know that one base name is special.
fn lower_ty_core(src: str, node: Parts, kids: Ast[]) -> Ast!ParseError {
    let sp = node.span();
    match (node.tokens) {
        [head_tok, ..] => {
            let head = src[head_tok];
            if (head == "#") {
                let inner = as_ty(kid(kids, 0, sp)?, sp)?;
                if (kids.len() == 2) {
                    return ok(ATy(TyDict(inner, as_ty(kid(kids, 1, sp)?, sp)?)));
                };
                return ok(ATy(TySet(inner, order_after_hash(node.own_texts(src)))));
            };
            if (kids.is_empty()) {
                return ok(ATy(named_ty(head)));
            };
            let args = kids.try_map(|k| as_ty(k, sp))?;
            if (head == "Case") {
                if (args.len() != 1) {
                    return err(ParseError {
                        message: `Case<V> takes one type argument, got {args.len()}`,
                        span: sp,
                    });
                };
                return ok(ATy(TyCase(as_ty(kid(kids, 0, sp)?, sp)?)));
            };
            ok(ATy(TyGeneric(head, args)))
        },
        _ => err(ParseError { message: "a type core matched no token", span: sp }),
    }
}

# Test shorthand, so an assertion reads as the source it is about.
fn parses(src: str) -> bool { aipl_parses(src) }

# Why a source failed to parse, for the diagnostic assertions.
fn why(src: str) -> str {
    match (aipl_parse_cst(src)) {
        ok(..) => "parsed",
        err(e) => e.message,
    }
}
