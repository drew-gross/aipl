// AIPL's own syntax, as a `Grammar` value — the third and largest consumer of
// the parser library, and the one the whole thing was built for. It describes
// the same language as the gazelle LR(1) grammar in `crates/aipl-parser/src/lib.rs`,
// against the same token stream (`lex_aipl.aipl`), and is differential-tested
// against it over the entire corpus.
//
// **LR to PEG: what had to change.** Gazelle is LR(1) with left recursion and a
// runtime precedence table; this driver is a PEG with ordered choice. Three
// mechanical translations cover almost all of it:
//
//   - *Left-recursive list rules* (`param_list = param | param_list COMMA param`)
//     become one `Many` with a separator. What varies between them is whether
//     the list may be empty and whether a trailing separator is allowed, and
//     those are `min` and `trailing_sep` — so the four wrapper productions an LR
//     grammar spells out by hand are two arguments here.
//   - *Left-recursive postfix rules* (`postfix`, `base_ty`) become an atom
//     followed by `Many(suffix)`.
//   - *`expr binop expr` with a precedence table* becomes `Climb`, whose levels
//     are `op_precedence`'s, `..` included (level 4, between `==` and `<`).
//
// What is *not* mechanical is **alternative order**. LR picks a production with
// a token of lookahead; a PEG commits to the first alternative that matches, so
// every choice here is written longest-first — `IDENT "(" args ")"` before
// `IDENT "{" fields "}"` before a bare `IDENT`, `let (a, b) = ..` before
// `let x = ..`. Where gazelle's comments say "one token of lookahead picks the
// production", that token is what the ordering below encodes.
//
// Two shapes are deliberately copied verbatim rather than simplified:
//
//   - `block_body`/`block_tail` keep gazelle's right recursion. Written as
//     `Many(stmt)` followed by an optional trailing expression, a PEG parses the
//     trailing expression *twice* — once inside the statement alternative that
//     then fails on its missing `;` — and that doubling compounds through nested
//     blocks. Deciding after the expression, as gazelle does, parses it once.
//   - `loop_body` likewise. A loop body admits no trailing expression at all,
//     which is why it is a separate rule and not `block` with a flag.
//
// The lowering is trivial: every production shares one `build` that returns a
// placeholder, because nothing here builds an AST. That is Stage 5's job. What
// this file has to be right about is *what parses* and *the shape of the tree*,
// which is what the `.test` blocks and the corpus differential test check.
//
// The rules are written in the library's own vocabulary — `Then`, `OneOf`,
// `Many`, `Maybe`, `Term`, `Named`, and `Literal` under the
// conventional `Lit` alias — so a reader who knows `grammar.aipl` knows this
// file. Each rule is an *annotated* binding (`let x: Rule<AiplTok> = ..`) for
// the reason `grammar.aipl` documents: `Literal` and `Named` mention no `K`, so
// a rule made only of them has nothing to pin the type parameter, and the
// annotation is what every constructor inside resolves from.
import { equal as ==, logical_not as !, map_err } from builtins;
import { Cst, text } from "./cst.aipl";
import {
    Climb,
    Grammar,
    Literal as Lit,
    Many,
    Maybe,
    Mk,
    Named,
    OneOf,
    ParseError,
    Prec,
    Production,
    Rule,
    Term,
    Then,
} from "./grammar.aipl";
import {
    AiplTok,
    CharTok,
    DocComment,
    IntLit,
    Name,
    RawTemplateHead,
    RawTemplateMid,
    RawTemplateTail,
    StrLit,
    TemplateHead,
    TemplateMid,
    TemplateTail,
    aipl_rules,
} from "./lex_aipl.aipl";
import { LexResult, keep_skipped, lex } from "./lexer.aipl";
import { parse_cst } from "./parse.aipl";
import { strip_test_sections } from "./strip_test_sections.aipl";

// ---------- the grammar ----------

pub fn aipl_grammar() -> Grammar<AiplTok, Ast> {
    prods: [..items(), ..types(), ..statements(), ..expressions(), ..patterns()],
}.doc("""
    AIPL's grammar: the productions the driver in `parse.aipl` parses AIPL with,
    starting at `program`.

    Split across five builder functions purely for reading — the array they
    concatenate to is one flat production list, and position in it is identity
    (a linked `NamedIdx` and a `CTree` both name a production by its index).
""")

// ---------- items ----------

fn items() -> Production<AiplTok, Ast>[] {
    // `program = item*`, and every byte of the file has to be one: `parse_cst`
    // refuses input left over after the start rule.
    let program: Rule<AiplTok> = Many(Named("item"));

    // `# text` lines in front of a declaration. This grammar has to *agree*
    // with gazelle, so it accepts them exactly where gazelle does: before an
    // item, and not on a variant case, where LR(1) cannot take them (see the
    // `variant_case` production in `aipl-parser`). A PEG could — ordered choice
    // backtracks, so "docs then a case" and "docs then the next item" are just
    // two alternatives to try — which is one more thing retiring gazelle buys.
    let item: Rule<AiplTok> = Then([
        Many(Term(DocComment)),
        OneOf([
            Named("function"),
            Named("struct_decl"),
            Named("variant_decl"),
            Named("import_decl"),
        ]),
    ]);

    // `import { a, b as c, equal as == } from "./x.aipl";` — or `from builtins`.
    let import_decl: Rule<AiplTok> = Then([
        Lit("import"),
        Lit("{"),
        Many(Named("import_name"), sep=some(Lit(","))),
        Lit("}"),
        Lit("from"),
        OneOf([Term(StrLit), Lit("builtins")]),
        Lit(";"),
    ]);

    // A name, an aliased name, or a bare operator spelling. The aliased form is
    // first: it starts with the same `IDENT` the plain form is.
    let import_name: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit("as"), OneOf([Term(Name), Named("operator")])]),
        Term(Name),
        Named("operator"),
    ]);

    // Every operator spelling that may be imported. `=`, `?` and `..` are absent
    // because they are not operators you can import — the loader's own gate
    // (`is_operator_name`) is the list this mirrors. Order is immaterial: the
    // lexer already took the longest munch, so each spelling is one token.
    let operator: Rule<AiplTok> = OneOf([
        Lit("+++"),
        Lit("=="),
        Lit("!="),
        Lit("<="),
        Lit(">="),
        Lit("&&"),
        Lit("||"),
        Lit("++"),
        Lit("--"),
        Lit("+="),
        Lit("-="),
        Lit("*="),
        Lit("/="),
        Lit("+"),
        Lit("-"),
        Lit("*"),
        Lit("/"),
        Lit("%"),
        Lit("<"),
        Lit(">"),
        Lit("!"),
    ]);

    let function: Rule<AiplTok> = Then([
        Maybe(Lit("pub")),
        Lit("fn"),
        Term(Name),
        Named("type_params"),
        Lit("("),
        Many(Named("param"), sep=some(Lit(","))),
        Lit(")"),
        Many(Named("effect")),
        Maybe(Then([Lit("->"), Named("ty")])),
        Named("fn_body"),
        Many(Named("fn_attr")),
    ]);
    let effect: Rule<AiplTok> = Then([Lit("!"), Term(Name)]);

    // `<T, U: ord>`. At least one parameter — `<>` is a syntax error, as it is
    // under gazelle, which is why this list has `min=1`.
    let type_params: Rule<AiplTok> = Maybe(Then([
        Lit("<"),
        Many(Named("type_param"), min=1, sep=some(Lit(",")), trailing_sep=false),
        Lit(">"),
    ]));
    let type_param: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit(":"), OneOf([Term(Name), Lit("variant")])]),
        Term(Name),
    ]);

    // The five parameter shapes, longest first. `mut self: T` takes no default
    // and no variadic marker, exactly as gazelle spells it.
    let param: Rule<AiplTok> = OneOf([
        Then([Lit("mut"), Term(Name), Lit(":"), Named("ty")]),
        Then([Term(Name), Lit(":"), Named("ty"), Lit("*"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty"), Lit("*")]),
        Then([Term(Name), Lit(":"), Named("ty")]),
    ]);

    // A body is a block, or the struct-literal shorthand. The shorthand is tried
    // first and can only match when a `:` or `,` follows the first name (or the
    // body opens with `..`), so `{ x }` still reads as a block returning `x`.
    let fn_body: Rule<AiplTok> = OneOf([
        Then([Lit("{"), Named("construct_fields"), Lit("}")]),
        Named("block"),
    ]);
    let construct_fields: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr"), Lit(","), Many(Named("field_init"), sep=some(Lit(",")))]),
        Then([
            Term(Name),
            Lit(":"),
            Named("expr"),
            Lit(","),
            Many(Named("field_init"), sep=some(Lit(","))),
        ]),
        Then([Term(Name), Lit(":"), Named("expr")]),
        Then([Term(Name), Lit(","), Many(Named("field_init"), sep=some(Lit(",")))]),
    ]);
    // `.test({ .. })` and `.doc("..")`, told apart by their argument.
    let fn_attr: Rule<AiplTok> = Then([
        Lit("."),
        Term(Name),
        Lit("("),
        OneOf([Named("block"), Term(StrLit)]),
        Lit(")"),
    ]);

    let struct_decl: Rule<AiplTok> = Then([
        Lit("struct"),
        Term(Name),
        Named("type_params"),
        Lit("{"),
        Many(Named("field_decl"), sep=some(Lit(","))),
        Lit("}"),
    ]);
    let field_decl: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty")]),
    ]);

    // `variant V = | A | B(i64)` — a leading `|` is allowed and means nothing,
    // which is what lets `aipl fmt` align every case under one column.
    let variant_decl: Rule<AiplTok> = Then([
        Lit("variant"),
        Term(Name),
        Named("type_params"),
        Lit("="),
        Maybe(Lit("|")),
        Many(Named("variant_case"), min=1, sep=some(Lit("|")), trailing_sep=false),
    ]);
    let variant_case: Rule<AiplTok> = OneOf([
        Then([
            Term(Name),
            Lit("("),
            Many(Named("case_param"), min=1, sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
        ]),
        Term(Name),
    ]);

    // The three payload-slot shapes, and the bare type last: a type *is* an
    // `IDENT`, so the named forms have to be given their chance first.
    let case_param: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("ty")]),
        Named("ty"),
    ]);

    [
        p("program", program),
        pl("item", item, "an item"),
        p("import_decl", import_decl),
        pl("import_name", import_name, "an import name"),
        p("operator", operator),
        p("function", function),
        p("effect", effect),
        p("type_params", type_params),
        p("type_param", type_param),
        pl("param", param, "a parameter"),
        p("fn_body", fn_body),
        p("construct_fields", construct_fields),
        p("fn_attr", fn_attr),
        p("struct_decl", struct_decl),
        p("field_decl", field_decl),
        p("variant_decl", variant_decl),
        p("variant_case", variant_case),
        p("case_param", case_param),
    ]
}

// ---------- types ----------

fn types() -> Production<AiplTok, Ast>[] {
    // The `(`-led forms are ordered longest-first, which is exactly the shift
    // decision gazelle's comments describe: `(A, B) -> R` over `(A, B)[]` over
    // `(A, B)!E` over `(A, B)`.
    let ty: Rule<AiplTok> = OneOf([
        Then([
            Lit("("),
            Many(Named("ty"), sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
            Lit("->"),
            Named("ty"),
        ]),
        Then([
            Lit("("),
            Many(Named("ty"), sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
            Lit("["),
            Lit("]"),
        ]),
        Then([
            Lit("("),
            Many(Named("ty"), sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
            Lit("!"),
            Named("base_ty"),
        ]),
        Then([Lit("("), Many(Named("ty"), sep=some(Lit(",")), trailing_sep=false), Lit(")")]),
        Then([Lit("!"), Named("base_ty")]),
        Then([Named("base_ty"), Lit("!"), Named("base_ty")]),
        Named("base_ty"),
    ]);
    // Left-recursive postfix under LR; here a core followed by its suffixes.
    let base_ty: Rule<AiplTok> = Then([
        Named("ty_core"),
        Many(OneOf([Lit("?"), Then([Lit("["), Lit("]")])])),
    ]);
    let ty_core: Rule<AiplTok> = OneOf([
        Then([Lit("#"), Lit("{"), Named("ty"), Lit(":"), Named("ty"), Lit("}")]),
        Then([Lit("#"), Lit("{"), Named("ty"), Lit("}")]),
        Then([
            Term(Name),
            Lit("<"),
            Many(Named("ty"), min=1, sep=some(Lit(",")), trailing_sep=false),
            Lit(">"),
        ]),
        Term(Name),
    ]);

    [pl("ty", ty, "a type"), p("base_ty", base_ty), p("ty_core", ty_core)]
}

// ---------- statements ----------

fn statements() -> Production<AiplTok, Ast>[] {
    // Gazelle's right recursion, kept: after one expression the parser decides
    // whether a `;` made it a statement or its absence made it the block's
    // value, so the expression is parsed exactly once.
    let block: Rule<AiplTok> = Then([Lit("{"), Named("block_body"), Lit("}")]);
    let block_body: Rule<AiplTok> = Maybe(OneOf([
        Then([Named("kw_stmt"), Named("block_body")]),
        Then([Named("expr"), Named("block_tail")]),
    ]));
    let block_tail: Rule<AiplTok> = Maybe(Then([Lit(";"), Named("block_body")]));

    // A loop body admits no trailing expression: its value could never be
    // observed, so every expression in it must be an `expr;` statement.
    let loop_body: Rule<AiplTok> = Then([Lit("{"), Named("loop_inner"), Lit("}")]);
    let loop_inner: Rule<AiplTok> = Maybe(OneOf([
        Then([Named("kw_stmt"), Named("loop_inner")]),
        Then([Named("expr"), Lit(";"), Named("loop_inner")]),
    ]));

    // Keyword-led statements, so their first tokens stay disjoint from `expr`'s
    // and the block's choice above is a single-token decision.
    let kw_stmt: Rule<AiplTok> = OneOf([
        Named("let_stmt"),
        Named("mut_stmt"),
        Named("assign_stmt"),
        Named("for_stmt"),
        Named("while_stmt"),
        Named("return_stmt"),
    ]);
    let let_stmt: Rule<AiplTok> = OneOf([
        Then([
            Lit("let"),
            Lit("("),
            Many(Term(Name), min=1, sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
            Lit("="),
            Named("expr"),
            Lit(";"),
        ]),
        Then([
            Lit("let"),
            Term(Name),
            Lit("{"),
            Many(Term(Name), min=1, sep=some(Lit(","))),
            Lit("}"),
            Lit("="),
            Named("expr"),
            Lit(";"),
        ]),
        Then([Lit("let"), Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr"), Lit(";")]),
        Then([Lit("let"), Term(Name), Lit("="), Named("expr"), Lit(";")]),
    ]);
    let mut_stmt: Rule<AiplTok> = OneOf([
        Then([
            Lit("mut"),
            Term(Name),
            Lit("{"),
            Many(Term(Name), min=1, sep=some(Lit(","))),
            Lit("}"),
            Lit("="),
            Named("expr"),
            Lit(";"),
        ]),
        Then([Lit("mut"), Term(Name), Lit(":"), Named("ty"), Lit("="), Named("expr"), Lit(";")]),
        Then([Lit("mut"), Term(Name), Lit("="), Named("expr"), Lit(";")]),
    ]);

    // `set n = e;`, the increment/decrement sugar, the four compound
    // assignments, the mutating-method writeback, and the nested-field store.
    // The method form comes before the field-path form: both open
    // `set IDENT . IDENT`, and only the next token tells them apart.
    let assign_stmt: Rule<AiplTok> = OneOf([
        Then([Lit("set"), Term(Name), Lit("++"), Lit(";")]),
        Then([Lit("set"), Term(Name), Lit("--"), Lit(";")]),
        Then([Lit("set"), Term(Name), Lit("+="), Named("expr"), Lit(";")]),
        Then([Lit("set"), Term(Name), Lit("-="), Named("expr"), Lit(";")]),
        Then([Lit("set"), Term(Name), Lit("*="), Named("expr"), Lit(";")]),
        Then([Lit("set"), Term(Name), Lit("/="), Named("expr"), Lit(";")]),
        Then([
            Lit("set"),
            Term(Name),
            Lit("."),
            Term(Name),
            Lit("("),
            Named("args"),
            Lit(")"),
            Lit(";"),
        ]),
        Then([
            Lit("set"),
            Term(Name),
            Lit("."),
            Many(Term(Name), min=1, sep=some(Lit(".")), trailing_sep=false),
            Lit("="),
            Named("expr"),
            Lit(";"),
        ]),
        Then([Lit("set"), Term(Name), Lit("="), Named("expr"), Lit(";")]),
    ]);

    // The three `for` shapes, told apart after `for ( let` by one token: `(` is
    // the tuple form, a `,` after the name the indexed form.
    let for_stmt: Rule<AiplTok> = OneOf([
        Then([
            Lit("for"),
            Lit("("),
            Lit("let"),
            Lit("("),
            Many(Term(Name), min=1, sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
            Lit(":"),
            Named("expr"),
            Lit(")"),
            Named("loop_body"),
        ]),
        Then([
            Lit("for"),
            Lit("("),
            Lit("let"),
            Term(Name),
            Lit(","),
            Term(Name),
            Lit(":"),
            Named("expr"),
            Lit(")"),
            Named("loop_body"),
        ]),
        Then([
            Lit("for"),
            Lit("("),
            Lit("let"),
            Term(Name),
            Lit(":"),
            Named("expr"),
            Lit(")"),
            Named("loop_body"),
        ]),
    ]);
    let while_stmt: Rule<AiplTok> = Then([
        Lit("while"),
        Lit("("),
        Named("expr"),
        Lit(")"),
        Named("loop_body"),
    ]);
    let return_stmt: Rule<AiplTok> = Then([Lit("return"), Named("expr"), Lit(";")]);

    [
        p("block", block),
        p("block_body", block_body),
        p("block_tail", block_tail),
        p("loop_body", loop_body),
        p("loop_inner", loop_inner),
        pl("kw_stmt", kw_stmt, "a statement"),
        p("let_stmt", let_stmt),
        p("mut_stmt", mut_stmt),
        p("assign_stmt", assign_stmt),
        p("for_stmt", for_stmt),
        p("while_stmt", while_stmt),
        p("return_stmt", return_stmt),
    ]
}

// ---------- expressions ----------

fn expressions() -> Production<AiplTok, Ast>[] {
    // `op_precedence`'s table, `..` included at level 4 — tighter than `==`,
    // looser than `<` and the arithmetic. Every level is left-associative.
    let expr: Rule<AiplTok> = Climb(
        Named("unary"),
        [
            Prec { power: 1, right: false, ops: ["||"] },
            Prec { power: 2, right: false, ops: ["&&"] },
            Prec { power: 3, right: false, ops: ["==", "!="] },
            Prec { power: 4, right: false, ops: [".."] },
            Prec { power: 5, right: false, ops: ["<", ">", "<=", ">="] },
            Prec { power: 6, right: false, ops: ["+", "+++", "-"] },
            Prec { power: 7, right: false, ops: ["*", "/", "%"] },
        ],
    );
    let unary: Rule<AiplTok> = OneOf([
        Then([Lit("-"), Named("unary")]),
        Then([Lit("!"), Named("unary")]),
        Named("postfix"),
    ]);
    let postfix: Rule<AiplTok> = Then([Named("atom"), Many(Named("suffix"))]);

    // The method call comes before the field access — both open `. IDENT` — and
    // the two open-ended slices before the plain index.
    let suffix: Rule<AiplTok> = OneOf([
        Then([Lit("."), Term(Name), Lit("("), Named("args"), Lit(")")]),
        Then([Lit("."), Term(Name)]),
        Then([Lit("."), Term(IntLit)]),
        Then([Lit("["), Lit(".."), Named("expr"), Lit("]")]),
        Then([Lit("["), Named("expr"), Lit(".."), Lit("]")]),
        Then([Lit("["), Named("expr"), Lit("]")]),
        Lit("?"),
    ]);

    let atom: Rule<AiplTok> = OneOf([
        Then([
            Lit("if"),
            Lit("("),
            Lit("let"),
            Named("pattern"),
            Lit("="),
            Named("expr"),
            Lit(")"),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Then([
            Lit("if"),
            Lit("("),
            Named("expr"),
            Lit(")"),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Then([
            Lit("match"),
            Lit("("),
            Named("expr"),
            Lit(")"),
            Lit("{"),
            Many(Named("match_arm"), sep=some(Lit(","))),
            Lit("}"),
        ]),
        Then([
            Lit("shim"),
            Term(Name),
            Lit("{"),
            Many(Named("shim_binding"), sep=some(Lit(","))),
            Lit("}"),
            Named("block"),
        ]),
        Term(IntLit),
        Term(StrLit),
        Term(CharTok),
        Lit("true"),
        Lit("false"),
        Lit("none"),
        Then([Term(Name), Lit("("), Named("args"), Lit(")")]),
        Then([Term(Name), Lit("{"), Many(Named("field_init"), sep=some(Lit(","))), Lit("}")]),
        Term(Name),
        Then([
            Lit("("),
            Named("expr"),
            Lit(","),
            Many(Named("expr"), min=1, sep=some(Lit(",")), trailing_sep=false),
            Lit(")"),
        ]),
        Then([Lit("("), Named("expr"), Lit(")")]),
        Then([Lit("["), Named("args"), Lit("]")]),
        Then([Lit("#"), Lit("{"), Named("brace_body"), Lit("}")]),
        Named("template"),
        Then([
            Lit("|"),
            Many(Named("lambda_param"), sep=some(Lit(",")), trailing_sep=false),
            Lit("|"),
            Named("block"),
        ]),
    ]);

    // `else` takes a block or another `if` — never an arbitrary expression, so
    // an if/else-if ladder is the only brace-less `else` form.
    let else_branch: Rule<AiplTok> = OneOf([
        Then([
            Lit("if"),
            Lit("("),
            Lit("let"),
            Named("pattern"),
            Lit("="),
            Named("expr"),
            Lit(")"),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Then([
            Lit("if"),
            Lit("("),
            Named("expr"),
            Lit(")"),
            Named("block"),
            Maybe(Then([Lit("else"), Named("else_branch")])),
        ]),
        Named("block"),
    ]);

    // `` `text {expr} text` `` — the raw and cooked forms produce different
    // token kinds but the same shape, and the lexer guarantees a head pairs with
    // a tail of its own flavour.
    let template: Rule<AiplTok> = Then([
        OneOf([Term(TemplateHead), Term(RawTemplateHead)]),
        Named("expr"),
        Many(Then([OneOf([Term(TemplateMid), Term(RawTemplateMid)]), Named("expr")])),
        OneOf([Term(TemplateTail), Term(RawTemplateTail)]),
    ]);

    let shim_binding: Rule<AiplTok> = Then([Term(Name), Lit("="), Term(Name)]);
    let args: Rule<AiplTok> = Many(Named("arg"), sep=some(Lit(",")));

    // The spread and the keyword argument lead with tokens no expression can, so
    // both must be tried before `expr` — after which a bare operator value and a
    // lambda are unambiguous too.
    let arg: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr")]),
        Then([Term(Name), Lit("="), Named("expr")]),
        Named("lambda"),
        Named("op_value"),
        Named("expr"),
    ]);

    // The operators that may be passed as values. Narrower than the importable
    // set: `-` and `!` are unary too, and gazelle gives them their own terminals.
    let op_value: Rule<AiplTok> = OneOf([
        Lit("+++"),
        Lit("=="),
        Lit("!="),
        Lit("<="),
        Lit(">="),
        Lit("&&"),
        Lit("+"),
        Lit("*"),
        Lit("/"),
        Lit("%"),
    ]);
    let lambda: Rule<AiplTok> = OneOf([
        Then([
            Lit("|"),
            Many(Named("lambda_param"), sep=some(Lit(",")), trailing_sep=false),
            Lit("|"),
            Named("expr"),
        ]),
        Then([Lit("||"), Named("block")]),
        Then([Lit("||"), Named("expr")]),
    ]);
    let lambda_param: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit(":"), Named("ty")]),
        Term(Name),
    ]);

    let field_init: Rule<AiplTok> = OneOf([
        Then([Lit(".."), Named("expr")]),
        Then([Term(Name), Lit(":"), Named("expr")]),
        Term(Name),
    ]);

    // `#{a, b}` a set, `#{k: v}` a dict, `#{}` an empty set, `#{:}` an empty
    // dict. One rule for all four, so `expr` is reachable from a single place
    // under the brace.
    let brace_body: Rule<AiplTok> = Maybe(OneOf([
        Many(Named("entry"), min=1, sep=some(Lit(","))),
        Lit(":"),
    ]));
    let entry: Rule<AiplTok> = OneOf([
        Then([Named("expr"), Lit(":"), Named("expr")]),
        Named("expr"),
    ]);

    [
        pl("expr", expr, "an expression"),
        p("unary", expr_unary(unary)),
        p("postfix", postfix),
        p("suffix", suffix),
        p("atom", atom),
        p("else_branch", else_branch),
        p("template", template),
        p("shim_binding", shim_binding),
        p("args", args),
        p("arg", arg),
        p("op_value", op_value),
        p("lambda", lambda),
        p("lambda_param", lambda_param),
        p("field_init", field_init),
        p("brace_body", brace_body),
        p("entry", entry),
    ]
}

// `unary` needs no transformation; the wrapper exists only so the `expressions`
// list above reads as one column of `p(name, rule)` calls.
fn expr_unary(x: Rule<AiplTok>) -> Rule<AiplTok> { x }

// ---------- patterns ----------

fn patterns() -> Production<AiplTok, Ast>[] {
    // An alternation of two or more patterns comes first: a single pattern is
    // the standalone arm, and after one pattern the next token (`=>` or `|`) is
    // what tells them apart.
    let match_arm: Rule<AiplTok> = OneOf([
        Then([
            Many(Named("pattern"), min=2, sep=some(Lit("|")), trailing_sep=false),
            Lit("=>"),
            Named("arm_body"),
        ]),
        Then([Lit("["), Named("args"), Lit("]"), Lit("=>"), Named("arm_body")]),
        Then([Named("pattern"), Lit("=>"), Named("arm_body")]),
    ]);
    let arm_body: Rule<AiplTok> = OneOf([Named("block"), Named("expr")]);
    let pattern: Rule<AiplTok> = OneOf([
        Then([Term(Name), Lit("."), Term(Name), Lit("("), Named("ctor_payload"), Lit(")")]),
        Then([Term(Name), Lit("."), Term(Name)]),
        Then([Term(Name), Lit("("), Named("ctor_payload"), Lit(")")]),
        Term(Name),
        Lit("none"),
        Term(StrLit),
        Term(CharTok),
    ]);

    // `Ctor(a, b)` names each slot; `Ctor(..)` says the case carries a payload
    // this arm does not read.
    let ctor_payload: Rule<AiplTok> = OneOf([
        Lit(".."),
        Many(Term(Name), min=1, sep=some(Lit(",")), trailing_sep=false),
    ]);

    [
        p("match_arm", match_arm),
        p("arm_body", arm_body),
        pl("pattern", pattern, "a pattern"),
        p("ctor_payload", ctor_payload),
    ]
}

// ---------- entry points ----------

pub fn aipl_source(src: str) -> str { strip_test_sections(src) }.doc("""
    The part of `src` that is AIPL: everything before the first
    `--- section ---` marker, which is where a test-case file stops being source
    and starts being expected output. `aipl_parser::parse` strips exactly this,
    and `aipl_parse_cst` parses exactly this — so a losslessness assertion is
    against this string, not the whole file.
""")

pub fn aipl_parse_cst(src: str) -> Cst!ParseError {
    let text = aipl_source(src);
    parse_cst(text, lex_lossless(text)?, aipl_grammar(), "program")
}.doc("""
    The lossless concrete syntax tree for AIPL source `src`, parsed by the
    library against `aipl_grammar()`.

    Every byte of `aipl_source(src)` is under exactly one leaf. That needs the
    lexer's rule set read *losslessly* (`keep_skipped`): the compiler's own
    lexing skips whitespace outright, having no use for it, and a concrete tree
    has to be able to put it back. Nothing else needs putting back — every other
    byte, the braces around a template interpolation included, already sits
    inside some token's span.
""").test({
    // Losslessness, on something small enough to read: the leaves tile the
    // source, so concatenating them returns it whole.
    let src = "fn f() -> i64 { 1 }";
    assert(aipl_parse_cst(src)?.text(src) == src);

    // Comments and blank lines are covered too — they are the bytes a token
    // stream throws away, and the ones a formatter would have to put back.
    let commented = "// lead\nfn f() {\n    // inner\n}\n";
    assert(aipl_parse_cst(commented)?.text(commented) == commented);

    // And a file whose tail is expected output rather than source: the tree
    // covers what was parsed, which is everything before the first marker.
    let cased = "fn main() { }\n\n--- stdout ---\nhi\n";
    assert(aipl_parse_cst(cased)?.text(aipl_source(cased)) == aipl_source(cased));
    assert(aipl_source(cased) == "fn main() { }\n\n");
})

// The whole rule set, read losslessly — every byte accounted for by a token or a
// trivia record. Lexing and parsing report failure in the same shape but not the
// same type, so the conversion happens once, here.
fn lex_lossless(text: str) -> LexResult<AiplTok>!ParseError {
    text
        .lex(aipl_rules().keep_skipped())
        .map_err(|e| ParseError { message: e.message, span: e.span })
}

pub fn aipl_parse_report(src: str) -> str {
    let text = aipl_source(src);
    match (aipl_parse_cst(src)) {
        ok(tree) => if (tree.text(text) == text) {
            ""
        } else {
            "lossless: the tree does not reconstruct the source"
        },
        err(e) => `error: {e.message}`,
    }
}.doc("""
    What this grammar makes of `src`, in one string: empty when it parses *and*
    its concrete tree reconstructs the source byte for byte, and otherwise a
    line beginning `error:` (it did not parse, with the message) or `lossless:`
    (it did, but the tree lost bytes).

    The FFI entry the corpus differential test calls — one crossing and one
    parse per file, checking both properties at once. Rejection is half the
    comparison: a grammar that accepts everything agrees with nothing.
""").test({
    // Empty means both properties held.
    assert(aipl_parse_report("fn f() { }") == "");

    // Losslessness, over the byte-losing shapes: the bytes a token stream drops
    // are comments, whitespace and blank lines...
    assert(aipl_parse_report("// lead\nfn f() {\n\n    // inner\n}\n") == "");
    assert(aipl_parse_report("import {\n    a,\n    b,\n} from builtins;\n") == "");

    // ... and the braces around a template interpolation, which the segment
    // tokens on either side of it span between them.
    assert(aipl_parse_report("fn f() { let s = `a{b}c{d}e`; }\n") == "");
    assert(aipl_parse_report("fn f() { let s = ```a{b}c```; }\n") == "");

    assert(aipl_parse_report("fn main() { }") == "");
    assert(aipl_parse_report("fn f() { let x = ; }") == "error: expected an expression, found `;`");
    // A file whose tail is expected output still reports on the source half.
    assert(aipl_parse_report("fn main() { }\n--- stdout ---\nx\n") == "");
})

pub fn aipl_parses(src: str) -> bool {
    match (aipl_parse_cst(src)) {
        ok(..) => true,
        err(..) => false,
    }
}.doc("""
    Whether `src` parses as AIPL. The FFI entry the corpus differential test
    calls: it compares this against `aipl_parser::parse` succeeding, file by
    file, over every `.aipl` in the repository.
""").test({
    // Doc comments in front of a declaration, and only there.
    assert(parses("# One line.\nfn f() { }"));
    assert(parses("# One.\n#\n# Two, after a blank line.\nstruct P { x: i64 }"));
    assert(parses("# Docs.\nvariant V = A | B"));
    assert(parses("#\nfn f() { }")); // a bare `#` is an empty doc line
    // Not inside a body, where a `//` banner lives instead.
    assert(!parses("fn f() {\n    # nope\n    g();\n}"));
    assert(!parses("fn f(\n    # nope\n    a: i64,\n) { }"));
    // `#{..}` is still a set literal, and `#[allow]` still a lint marker.
    assert(parses("fn f() -> #{i64} { #{1, 2} }"));

    // Items.
    assert(parses("import { map, equal as == } from builtins;"));
    assert(parses("import { Cst } from \"./cst.aipl\";"));
    assert(parses("struct P { x: i64, y: i64 = 0 }"));
    assert(parses("struct B<T: any, U: variant> { v: T, w: U }"));
    assert(parses("variant V = A | B(i64) | C(x: i64, y: i64 = 1)"));
    assert(parses("variant V = | A | B"));

    // Types, including every postfix and bracket form.
    assert(parses("fn f(a: str[], b: i64?, c: (i64, str), d: (i64) -> str) -> i64!str { 0 }"));
    assert(parses("fn f(a: #{i64}, b: #{str: i64}, c: Box<T>[]) { }"));
    assert(parses("fn f() -> !Error { ok(0) }"));

    // Statements.
    assert(parses("fn f() { let x = 1; mut y: i64 = 2; set y = x; set y++; set y += 1; }"));
    assert(parses("fn f() { let (a, b) = p; let P { x, y } = p; mut P { x } = p; }"));
    assert(parses("fn f() { for (let x : xs) { g(x); } for (let i, x : xs) { } }"));
    assert(parses("fn f() { while (b) { set n--; } return 1; }"));
    assert(parses("fn f() { set a.b.c = 1; set a.push(1); }"));

    // Expressions: precedence, postfix chains, and every atom shape.
    assert(parses("fn f() -> i64 { 1 + 2 * 3 == 4 && x }"));
    assert(parses("fn f() -> i64 { a.b.c(1).d[2][3..4][..5][6..]? }"));
    assert(parses("fn f() { let s = `a{b}c{d}e`; }"));
    assert(parses("fn f() { let t = (1, 2, 3); let u = [1, 2, ..rest]; }"));
    assert(parses("fn f() { let s = #{1, 2}; let d = #{1: 2}; let e = #{}; let g = #{:}; }"));
    assert(parses("fn f() { g(|x| x, || 1, ||{ 2 }, +, k = 3); }"));
    assert(parses("fn f() { let h = |x: i64| { x }; }"));
    assert(parses("fn f() -> i64 { if (a) { 1 } else if (b) { 2 } else { 3 } }"));
    assert(parses("fn f() { if (let some(v) = o) { g(v); } }"));
    assert(parses("fn f() { shim prints { print = p } { g(); } }"));

    // Patterns, including alternation and the ignored payload.
    assert(parses("fn f(v: V) -> i64 { match (v) { A(x) | B(x) => x, C(..) => 1, _ => 0 } }"));
    assert(parses("fn f(v: V) -> i64 { match (v) { V.A => 1, V.B(x) => x, \"s\" => 2, _ => 0 } }"));
    assert(parses("fn f(v: V) { match (v) { none => { g(); }, some(x) => { h(x); } }; }"));

    // Attributes and the struct-literal body shorthand.
    assert(parses("fn f() -> i64 { 1 }.doc(\"d\").test({ assert(f() == 1); })"));
    assert(parses("fn f(v: i64) -> P { v, next: none }"));
    assert(parses("fn f(v: P) -> P { ..v, x: 1 }"));
    assert(parses("fn f(v: i64) -> P { v, }"));
    // `{ x }` is a block returning `x`, not a one-field shorthand.
    assert(parses("fn f(x: i64) -> i64 { x }"));

    // Things that must *not* parse.
    assert(!parses("fn f() { let x = ; }"));
    assert(!parses("fn f( { }"));
    assert(!parses("fn f<>() { }"));
    assert(!parses("fn f() { 1 }}"));
    assert(!parses("variant V = "));
    // A loop body takes no trailing expression: its value could never be read.
    assert(!parses("fn f() { while (b) { 1 } }"));
})

// ---------- production helpers ----------

// One production with the trivial lowering. Nothing here builds an AST — the
// tree is the product — so every production shares one `build`.
fn p(name: str, rule: Rule<AiplTok>) -> Production<AiplTok, Ast> { name, rule, build: Mk(keep) }

// The same, labelled: what an error blames when this production fails having
// matched nothing. The reified form of the LR parser's `SYMBOL_DISPLAY_NAMES`,
// which is why only the handful of rules a reader would name are labelled and
// every plumbing rule stays transparent.
fn pl(name: str, rule: Rule<AiplTok>, expect_as: str) -> Production<AiplTok, Ast> {
    name,
    rule,
    build: Mk(keep),
    expect_as,
}

// The placeholder an AST would be. `Build` has no payload-free arm to mean
// "nothing to lower", so a production with nothing to lower passes this.
variant Ast = Ignored

fn keep(src: str, node: Cst, kids: Ast[]) -> Ast!ParseError { ok(Ignored) }

// Test shorthand, so an assertion reads as the source it is about.
fn parses(src: str) -> bool { aipl_parses(src) }
