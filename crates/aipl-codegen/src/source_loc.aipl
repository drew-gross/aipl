# Where an expression is and what was written there — `12 v + 2` — which is the
# one thing the compiler's two source-text rewrites both need. The loader calls
# this through the FFI (see `install_parser_hooks`) while baking `assert(cond)`
# into `__assert(cond, loc)` and `trace(expr)` into `__trace(msg)`, and prefixes
# the file's own name to what comes back: `sub/lib.aipl:12 v + 2`.
#
# The file is *not* a parameter. A line and a span are properties of one text, so
# this takes the text and the span and nothing else; which file that text came
# from is the caller's to know, and the caller — unlike this — holds the path.
#
# `span` is the expression's half-open byte range within `src`; both bounds clamp
# to `[0, len]` (and an out-of-order range collapses to "") via ordinary
# string-slicing semantics, so no manual clamping is needed here.

import { Span, equal as ==, len, trim } from builtins;
import { lines } from "./lines.aipl";

pub fn source_loc(src: str, span: Span) -> str {
    // Splitting on "\n" always yields (newline count + 1) parts, so the
    // prefix's line count is just its number of lines. No array is built for
    // it: the fusion pass collapses `lines().len()` into `split_len`, the
    // counting pass alone — this runs once per rewritten call over the whole
    // prefix.
    let line = src[..span.start].lines().len();
    let text = src[span].trim();
    `{line} {text}`
}.test({
    assert(source_loc("assert(x == 1)", Span { start: 7, end: 13 }) == "1 x == 1");
    // Line number counts newlines strictly before the span's start.
    assert(source_loc("a\nassert(y)", Span { start: 9, end: 10 }) == "2 y");
    assert(source_loc("a\nb\nassert(z)", Span { start: 11, end: 12 }) == "3 z");
    // The expression's text is trimmed of surrounding whitespace.
    assert(source_loc("assert(  x  )", Span { start: 7, end: 12 }) == "1 x");
    // A span past the end of `src` clamps to the whole remainder (empty here).
    assert(source_loc("short", Span { start: 5, end: 10 }) == "1 ");
    // An empty source with a zero-width span at 0.
    assert(source_loc("", Span { start: 0, end: 0 }) == "1 ");
})
