# `aipl_syntax::ast::Pattern` as AIPL declares it. One of the files the AST is
# declared across; see `ast.aipl`.

import {
    all,
    contains,
    equal as ==,
    filter_map,
    is_empty,
    is_some_and,
    join,
    logical_and as &&,
    logical_not as !,
    map,
    not_equal as !=,
    zip_with,
} from builtins;
import { Expr, Ident, ident, num, show_exprs } from "./expr.aipl";

# `aipl_syntax::ast::Pattern`, less its `Bind` case. Its `Ctor` case is a
# struct variant there and a named payload here, which is as close as the two
# declarations get: the slot names are the same three, in the same order.
#
# `Ctor` and `Nested` split one source shape between them: a constructor whose
# slots are all plain names is the `Ctor` it always was, so an arm written the
# old way lowers as it always did, and only a constructor over real
# sub-patterns is `Nested` — `nested_or_ctor` makes that choice. Whether a bare
# name in a nested slot binds or names a case is decided on the Rust side
# (`Pattern::normalized`, the `Bind` case this declaration lacks), by the same
# rule `is_binder_name` states here.
variant Pat =
    # A constructor whose slots are all plain binder names — `some(v)`,
    # `Pair(a, b)` — or a bare name (`none`, `Nil`), or the `Ctor(..)` form that
    # matches a case and ignores what it carries. The two optional slots are
    # both "nothing" for a bare name, which is the common construction.
    | Ctor(
        # The case name, as written — qualified (`V.A`) or not.
        name: str,
        # One binder per payload slot, in slot order; empty for a bare name.
        bindings: str[] = [],
        # Whether the arm was written `name(..)`: the case's payload is matched
        # but nothing is bound. Never true alongside bindings.
        ignore_payload: bool = false
    )
    # A string literal pattern (`"lit" => ..`), against a `str` scrutinee.
    | Str(str)
    # A char literal pattern (`'c' => ..`), against a `char` scrutinee.
    | Char(char)
    # The destructuring `[a, b] => ..` arm, every element of which is a plain
    # binder name or a literal. The elements are *expressions* rather than
    # patterns because that is the shape codegen compiles directly, and because
    # an expression carries the span a diagnostic about one element wants.
    | Array(Expr[])
    # The same, of an array of *at least* that many elements, written with a
    # trailing `..` — `[first, ..]`. The elements are the first ones; the rest are
    # not looked at. Only the plain elements `Array` takes are allowed, so it is
    # compiled the way `Array` is, with a length test of `>=` in place of `==`.
    | ArrayRest(Expr[])
    # The same arm where at least one element is a real sub-pattern —
    # `[n, Tok("?"), _, ty]`, `[some(v), none]`. The counterpart of `Array`
    # exactly as `Nested` is of `Ctor`, and chosen by the same kind of test:
    # `array_pattern` in `grammar_aipl.aipl` keeps the simple form whenever
    # every element is plain.
    | ArrayNested(Pat[])
    # `_` — matches anything, binds nothing.
    | Wildcard
    # `(p, q)` — a tuple of sub-patterns, one per element.
    | Tuple(Pat[])
    # A constructor whose slots are patterns rather than plain names —
    # `some(1)`, `Pair(x, none)`. A slot that is a bare name is a nullary `Ctor`
    # here; whether it binds or names a case is decided on the Rust side.
    | Nested(
        # The case name, as written.
        name: str,
        # One sub-pattern per payload slot, in slot order.
        args: Pat[]
    )
    # An integer literal pattern (`1 => ..`).
    | Int(i64)
    # A struct pattern, `T { a, b as c }`: the fields read and the name each is
    # bound to, in step. It always matches, so it binds where a plain name would,
    # and `desugar.aipl` replaces it with one — a temporary the arm's body takes
    # the fields off. Nothing past that sees it.
    | Struct(name: str, fields: str[], names: str[])

# Whether a bare name in a nested pattern slot is a binder rather than a case:
# everything but `none` and a capitalised name. The one rule that needs no type,
# stated once here and once in `aipl_syntax::ast::is_binder_name`.
pub fn is_binder_name(self: str) -> bool {
    self != "none" && !self[0].is_some_and(|c| "ABCDEFGHIJKLMNOPQRSTUVWXYZ".contains(c))
}.test({
    assert("lo".is_binder_name());
    assert("_x".is_binder_name());
    assert(!"none".is_binder_name());
    assert(!"Nil".is_binder_name());
    assert(!"Pair".is_binder_name());
})

# A constructor over sub-patterns, as the simplest `Pat` that spells it: the
# plain `Ctor` when every slot is a bare binder name, else `Nested`. A nullary
# sub-pattern arrives as a nullary `Ctor` (the parser cannot tell a binder from
# a case by shape alone), which is what the binder test reads.
pub fn nested_or_ctor(name: str, args: Pat[]) -> Pat {
    if (args.all(is_plain_binder)) { return Ctor(name, bindings=args$binder_name()); };
    Nested(name, args)
}.test({
    let plain: Pat[] = [Ctor("a"), Ctor("b")];
    assert(nested_or_ctor("Pair", plain).show_pat() == "Pair(a, b)");
    assert(nested_or_ctor("some", [Int(1)]).show_pat() == "some(1)");
    // A capitalised name is a case, so the constructor over it nests.
    assert(nested_or_ctor("Pair", [Ctor("Nil"), Ctor("x")]).show_pat() == "Pair(Nil, x)");
    // `..` and no slots keep the plain shape.
    let no_args: Pat[] = [];
    assert(nested_or_ctor("Empty", no_args).show_pat() == "Empty");
})

fn is_plain_binder(self: Pat) -> bool {
    if (let Ctor(name, bindings, ignore) = self) {
        return bindings.is_empty() && !ignore && name.is_binder_name();
    };
    false
}

fn binder_name(self: Pat) -> str {
    if (let Ctor(name, _, _) = self) { return name; };
    ""
}

# A pattern as a one-line dump, in the spelling that produced it: `Ctor(a, b)`,
# `Ctor(..)`, a bare name, `_`. The two literal forms are tagged, because their
# whole point is that they are values rather than names and `"1"` against `1`
# would otherwise read the same.
pub fn show_pat(self: Pat) -> str {
    match (self) {
        Wildcard => "_",
        Str(s) => `Str({s})`,
        Char(c) => `Char({c})`,
        Array(elems) => `[{show_exprs(elems)}]`,
        ArrayRest(elems) => if (elems.is_empty()) { "[..]" } else { `[{show_exprs(elems)}, ..]` },
        ArrayNested(ps) => `[{show_pats(ps)}]`,
        Ctor(name, bindings, ignore_payload) => if (ignore_payload) {
            `{name}(..)`
        } else {
            if (bindings.is_empty()) { name } else { `{name}({bindings.join(sep=", ")})` }
        },
        Tuple(ps) => `({show_pats(ps)})`,
        Nested(name, args) => `{name}({show_pats(args)})`,
        Int(n) => `{n}`,
        Struct(name, fields, names) => `{name} \{ {zip_with(fields, names, show_field_binder).join(sep=", ")} }`,
    }
}.test({
    assert(Wildcard.show_pat() == "_");
    assert(Struct("P", ["x", "y"], ["x", "b"]).show_pat() == "P { x, y as b }");
    assert(Ctor("none").show_pat() == "none");
    assert(Ctor("some", bindings=["v"]).show_pat() == "some(v)");
    assert(Ctor("Pair", bindings=["a", "b"]).show_pat() == "Pair(a, b)");
    assert(Ctor("Circle", ignore_payload=true).show_pat() == "Circle(..)");
    assert(Str("hi").show_pat() == "Str(hi)");
    assert(Char('x').show_pat() == "Char(x)");
    assert(Array([num(1), ident("x")]).show_pat() == "[1, x]");
    assert(ArrayRest([ident("x")]).show_pat() == "[x, ..]");
    assert(ArrayRest([]).show_pat() == "[..]");
    assert(Tuple([Int(1), Nested("some", [Int(1)])]).show_pat() == "(1, some(1))");
    assert(Nested("Pair", [Ctor("lo"), Wildcard]).show_pat() == "Pair(lo, _)");
})

# A struct pattern's field as written: `x`, or `x as name` when it is bound
# under another name.
fn show_field_binder(field: str, name: str) -> str {
    if (field == name) { field } else { `{field} as {name}` }
}

# The elements of a pattern list, comma-separated.
fn show_pats(self: Pat[]) -> str { self$show_pat().join(sep=", ") }

# The names a pattern binds, in order — `Pattern::bindings` in Rust. It is what
# an arm's alternatives must agree on, so that a shared body means the same
# thing whichever alternative matched.
#
# An array pattern binds its `Ident` elements and nothing else: a literal
# element is a value to match, not a name to bind.
pub fn pat_bindings(self: Pat) -> str[] {
    match (self) {
        Ctor(_, bindings, _) => bindings,
        Array(elems) | ArrayRest(elems) => elems.filter_map(is_ident, ident_name),
        ArrayNested(ps) => ps$nested_bindings().join(),
        Str(..) | Char(..) | Wildcard | Int(..) => no_names(),
        // A nested slot binds where a bare binder name sits, at any depth.
        Tuple(ps) => ps$nested_bindings().join(),
        Nested(_, args) => args$nested_bindings().join(),
        Struct(_, _, names) => names,
    }
}.test({
    let none_bound: str[] = [];
    assert(Ctor("Pair", bindings=["a", "b"]).pat_bindings() == ["a", "b"]);
    assert(Ctor("Circle", ignore_payload=true).pat_bindings() == none_bound);
    assert(Wildcard.pat_bindings() == none_bound);
    assert(Str("s").pat_bindings() == none_bound);
    // A literal element of an array pattern is matched, not bound.
    assert(Array([ident("a"), num(1), ident("b")]).pat_bindings() == ["a", "b"]);
    assert(ArrayRest([ident("a"), num(1)]).pat_bindings() == ["a"]);
    // Nested: every binder, depth first, left to right; a case name is not one.
    assert(Tuple([Ctor("lo"), Nested("some", [Ctor("hi")])]).pat_bindings() == ["lo", "hi"]);
    assert(Nested("Pair", [Ctor("Nil"), Int(1)]).pat_bindings() == none_bound);
    // A struct pattern binds its names, wherever it sits.
    assert(Struct("P", ["x", "y"], ["x", "b"]).pat_bindings() == ["x", "b"]);
    assert(ArrayNested([Struct("P", ["x"], ["x"]), Ctor("n")]).pat_bindings() == ["x", "n"]);
})

# The binders of one nested slot: a bare binder name is itself, a case or a
# literal nothing, and a deeper pattern its own binders.
fn nested_bindings(self: Pat) -> str[] {
    if (let Ctor(name, bindings, ignore) = self) {
        if (bindings.is_empty() && !ignore) {
            return if (name.is_binder_name()) { [name] } else { no_names() };
        };
    };
    self.pat_bindings()
}

# The empty binding list, which `#{}`'s sibling problem makes worth naming: an
# empty array literal does not flex through a generic parameter, so a `[]`
# written in argument or return position needs somewhere to be annotated.
fn no_names() -> str[] { [] }

fn is_ident(self: Expr) -> bool {
    if (let Ident(..) = self.kind) { return true; };
    false
}

fn ident_name(self: Expr) -> str {
    if (let Ident(name) = self.kind) { return name; };
    ""
}

# How a pattern is named in the "alternatives must bind the same names"
# diagnostic: the constructor for a constructor pattern, and a description for
# the literal forms, which bind nothing and so only ever appear on the side that
# binds nothing.
pub fn pat_label(self: Pat) -> str {
    match (self) {
        Ctor(name, _, _) => `"{name}"`,
        Nested(name, _) => `"{name}"`,
        Str(..) => "a string pattern",
        Char(..) => "a char pattern",
        Array(..) | ArrayRest(..) | ArrayNested(..) => "an array pattern",
        Wildcard => `"_"`,
        Tuple(..) => "a tuple pattern",
        Int(..) => "an integer pattern",
        Struct(name, _, _) => `"{name}"`,
    }
}.test({
    assert(Ctor("some", bindings=["v"]).pat_label() == `"some"`);
    assert(Wildcard.pat_label() == `"_"`);
    assert(Str("s").pat_label() == "a string pattern");
    assert(Array([ident("a")]).pat_label() == "an array pattern");
    assert(Char('c').pat_label() == "a char pattern");
    assert(Ctor("none").pat_label() == `"none"`);
})

# The binder list as the same diagnostic writes it: each name quoted, or the
# word "nothing" when there are none.
pub fn binder_list(self: str[]) -> str {
    if (self.is_empty()) { return "nothing"; };
    self.map(|x| `"{x}"`).join(sep=", ")
}.test({
    let none_bound: str[] = [];
    assert(none_bound.binder_list() == "nothing");
    assert(["v"].binder_list() == `"v"`);
    assert(["a", "b"].binder_list() == `"a", "b"`);
})
