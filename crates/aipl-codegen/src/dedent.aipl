import {
    Measurement,
    count_while,
    equal as ==,
    filter,
    is_all_whitespace,
    join,
    logical_not as !,
    map,
    measure,
    minimum,
    repeat,
    value_or,
} from builtins;
import { lines } from "./lines.aipl";

# Strips the common leading-space indentation shared by every non-blank line — the
# de-denting the parser applies to raw-string contents. Blank lines (empty or
# all-whitespace) don't constrain the common indent and are emitted empty; the
# original line count is preserved.
pub fn dedent(self: str) -> str {
    let ls = self.lines();

    // The common indent `n` is the smallest leading-space run over the non-blank
    // lines: count each non-blank line's leading spaces, then take the minimum.
    // With no non-blank lines there's nothing to strip, so `value_or(0)`.
    let n = ls.filter(|l| !l.is_all_whitespace())$count_while(|c| c == ' ').minimum().value_or(0);

    // Rebuild: strip the first `n` bytes from each non-blank line (blank lines
    // become empty), rejoined with `\n` so the original line count is preserved.
    ls.map(|line| if (!line.is_all_whitespace()) { line[n..] } else { "" }).join(sep="\n")
}.test({
    // No common indent: unchanged.
    assert(dedent("a\nb") == "a\nb");
    // A uniform 4-space indent is stripped from every line.
    assert(dedent("    a\n    b") == "a\nb");
    // The smallest indent wins; deeper lines keep the extra.
    assert(dedent("  a\n    b") == "a\n  b");

    // Blank lines don't constrain the indent and are emitted empty (here the
    // middle line is all spaces).
    assert(dedent("    a\n  \n    b") == "a\n\nb");
    // A truly empty middle line is preserved.
    assert(dedent("    a\n\n    b") == "a\n\nb");
    // A leading tab is not a space, so it bounds the common indent at 0.
    assert(dedent("\ta\n\tb") == "\ta\n\tb");
    // Spaces before a tab count; the tab and beyond are kept.
    assert(dedent("  \tx\n   y") == "\tx\n y");
    // Trailing newline (an empty final line) is preserved.
    assert(dedent("    a\n") == "a\n");
    // Empty input.
    assert(dedent("") == "");
    // Long (heap) lines exercise the view/concat paths.
    assert(
        dedent(
            "        first long line\n        second long line",
        ) == "first long line\nsecond long line",
    );
}).performance({
    // `dedent` is the parser's raw-string de-denter, run on every `"""` block it
    // reads, and a pipeline: `lines`, a `filter`, a `map` and a `minimum` to find
    // the indent, then a `map` and a `join` to strip it. Each stage is a pass
    // over every line, and a stage's result is an array the next one walks once.
    // These pin what that costs today, for the fusions that are meant to cut it.
    //
    // Input built here, outside the call, so what is counted is `dedent`.
    let hundred = "        line of text\n".repeat(100);

    // The number of allocations does not grow with the number of lines, so this
    // is a comparison, which survives whatever the stages are built from. The
    // exact count is the part a fusion changes.
    let few = measure("three lines", "    a\n    b\n    c", dedent).allocations;
    let Measurement { allocations, bytes_allocated, peak_live_bytes } = measure(
        "a hundred lines",
        hundred,
        dedent,
    );
    assert(few == allocations);
    assert(allocations == 2);

    // What does grow with the input is the bytes allocated and the bytes live at
    // once. These are exact because the stages that build them are what the
    // fusions replace. The instruction count is not pinned here:
    // `tests/performance_metrics.md` holds it for this file, exactly, and
    // refreshes it with the code.
    assert(bytes_allocated == 2774);
    assert(peak_live_bytes == 3780);
})
