# A case file's `--- section ---` layout, parsed. The corpus harness (and
# `aipl check`) drive every expectation in `tests/cases/**/*.aipl` off this:
# the entry-point source is whatever precedes the first marker, and each marker
# opens a section whose body runs to the next marker or EOF.

import {
    any,
    contains,
    drop_n,
    equal as ==,
    extend,
    filter,
    int_parse,
    is_empty,
    is_err_and,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
    push,
    starts_with,
    trim,
    value_or,
    value_or_err,
    words,
} from builtins;
import { lines as split_lines } from "./lines.aipl";
import { parse_test_section_header } from "./parse_test_section_header.aipl";
import { trim_end_while } from "./trim_end_while.aipl";

# One `--- file: p ---` / `--- expect file: p ---` companion: a path and the
# body that follows it.
struct Entry { path: str, contents: str }

# One `check` expectation: the part of `aipl check`'s output a section pins (the canonical
# flags that select it, `--compile` or `--compile --tests`, or none for all of it) and the body it
# must equal.
struct Check { projection: str, body: str }

struct Spec {
    source: str,
    extra_files: Entry[],
    expect_files: Entry[],
    stdout: str?,
    stderr: str?,
    exit_code: i64?,
    report: str?,
    cli: str[],
    checks: Check[],
}

# Parses a case file into its `Spec`: the entry-point source (everything before
# the first `--- name ---` marker) plus one field per section. Section bodies
# have their trailing newlines stripped. Unknown section names, a malformed
# `exit code`, and an invalid companion path are errors rather than silent
# omissions — a mistyped marker would otherwise drop an expectation and the
# case would pass for the wrong reason.
pub fn parse_spec(src: str) -> Spec!str {
    mut spec = Spec {
        source: "",
        extra_files: [],
        expect_files: [],
        stdout: none,
        stderr: none,
        exit_code: none,
        report: none,
        cli: [],
        checks: [],
    };

    // The section currently being collected, or `""` for the entry-point source
    // before the first marker. A validated section name is never empty, so this
    // doubles as the "still in the preamble" flag.
    mut current = "";
    mut buf = "";
    for (let line : src.split_lines()) {
        let header = parse_test_section_header(line).value_or("");
        if (header == "") {
            set buf.extend(line);
            set buf.extend("\n");
        } else {
            set spec = finalize(spec, current, buf)?;
            set current = header;
            set buf = "";
        };
    }
    finalize(spec, current, buf)
}.test({
    // The preamble is the source; sections fill their fields.
    let s = parse_spec("fn main() {}\n--- stdout ---\nhi\n")?;
    assert(s.source == "fn main() {}");
    assert(s.stdout == some("hi"));
    assert(s.stderr == none);

    // Trailing newlines are stripped from a body, interior ones kept.
    let two = parse_spec("x\n--- stdout ---\na\nb\n\n\n")?;
    assert(two.stdout == some("a\nb"));

    // No markers at all: everything is source.
    let bare = parse_spec("just source\n")?;
    assert(bare.source == "just source");
    assert(bare.stdout == none);

    // `report` is a section like any other text one: the body, trailing newlines
    // stripped.
    assert(parse_spec("x\n--- report ---\nallocations 0\n")?.report == some("allocations 0"));
    assert(parse_spec("x\n--- stdout ---\nallocations: 0\n")?.report == none);

    // `performance` was a section once; a file that still has one is told where
    // its job went, rather than that the name is unknown.
    assert(parse_spec("x\n--- performance ---\nallocations: 0\n").is_err_and(|m| m.contains(
        "`.benchmark` block",
    )));

    // `exit code` is parsed, and must be an integer.
    assert(parse_spec("x\n--- exit code ---\n3\n")?.exit_code == some(3));
    assert(parse_spec("x\n--- exit code ---\n-1\n")?.exit_code == some(-1));
    assert(parse_spec("x\n--- exit code ---\nnope\n").is_err_and(|e| e.contains("integer")));

    // `check` with flags pins a projection of `aipl check`'s output, and a bare `check` pins all of
    // it (no flags). They are one list, in file order.
    let flagged = parse_spec("x\n--- check --compile --tests ---\nbody\n")?;
    assert(flagged.checks == [Check { projection: "--compile --tests", body: "body" }]);
    let compile = parse_spec("x\n--- check --compile ---\ne\n--- check --tests ---\nt\n")?;
    assert(compile.checks == [
        Check { projection: "--compile", body: "e" },
        Check { projection: "--tests", body: "t" },
    ]);
    assert(parse_spec("x\n--- check ---\nall\n")?.checks == [
        Check { projection: "", body: "all" },
    ]);
    assert(parse_spec("x\n--- stdout ---\nhi\n")?.checks.is_empty());
    let both = parse_spec("x\n--- check --format ---\nf\n--- check --benchmarks ---\nb\n")?;
    assert(both.checks$projection == ["--format", "--benchmarks"]);

    // The old names are gone, and the error says what replaced each.
    assert(parse_spec("x\n--- errors ---\ne\n").is_err_and(|m| m.contains(
        "`--- check --compile ---`",
    )));
    assert(parse_spec("x\n--- check exit code ---\n1\n").is_err_and(|m| m.contains(
        "follows from the body",
    )));
    assert(parse_spec("x\n--- formatted ---\ny\n").is_err_and(|m| m.contains("is gone")));

    // A header is the one spelling of its projection, and a mistake in it is the file's error.
    assert(parse_spec("x\n--- check --run ---\n").is_err_and(|m| m.contains(
        `unknown flag "--run"`,
    )));
    assert(parse_spec("x\n--- check --tests --tests ---\n").is_err_and(|m| m.contains(
        "given twice",
    )));
    assert(parse_spec("x\n--- check --tests --compile ---\n").is_err_and(|m| m.contains(
        `as "--- check --compile --tests ---"`,
    )));
    assert(parse_spec("x\n--- check  --tests ---\n").is_err_and(|m| m.contains(
        "one spelling per projection",
    )));
    // The same projection twice, however it is spelled.
    assert(parse_spec(
        "x\n--- check --tests ---\na\n--- check --tests ---\nb\n",
    ).is_err_and(|m| m.contains("same part")));
    assert(parse_spec("x\n--- check ---\na\n--- check ---\nb\n").is_err_and(|m| m.contains(
        "same part",
    )));
    // Flags belong to `check` alone.
    assert(parse_spec("x\n--- stdout --tests ---\n").is_err_and(|m| m.contains("unknown section")));
    assert(parse_spec("x\n--- check exit code --tests ---\n").is_err_and(|m| m.contains(
        "unknown flag",
    )));

    // `cli` is one argument per line — and an *empty* section is no arguments,
    // not one empty argument (`lines("")` is `[""]`, unlike Rust's `str::lines`).
    assert(parse_spec("x\n--- cli ---\na\nb\n")?.cli == ["a", "b"]);
    assert(parse_spec("x\n--- cli ---\n")?.cli.is_empty());

    // Companions, both flavors.
    let Spec { extra_files } = parse_spec("x\n--- file: m.aipl ---\nbody\n")?;
    assert(extra_files.len() == 1);
    assert(extra_files[0]$path == some("m.aipl"));
    let Spec { expect_files } = parse_spec("x\n--- expect file: out.txt ---\nwritten\n")?;
    assert(expect_files.len() == 1);
    assert(expect_files[0]$contents == some("written"));

    // Rejections: a mistyped marker, and unusable companion paths.
    assert(parse_spec("x\n--- stdou ---\n").is_err_and(|m| m.contains("unknown section")));
    assert(parse_spec("x\n--- file: ---\n").is_err_and(|m| m.contains("needs a path")));
    assert(parse_spec("x\n--- file: a\\b ---\n").is_err_and(|m| m.contains(`use "/"`)));
})

# Fold one finished section into the spec. `name` is `""` for the preamble.
fn finalize(spec: Spec, name: str, buf: str) -> Spec!str {
    let body = buf.trim_end_while(|c| c == '\n' || c == '\r');
    if (name == "") { return ok(Spec { ..spec, source: body }); };

    // Checked before the literal names because these carry a path after the
    // prefix; `expect file:` first, though the two prefixes can't both match.
    if (name.starts_with("expect file:")) {
        let path = companion_path(name, "expect file:")?;
        mut out = spec.expect_files;
        set out.push(Entry { path, contents: body });
        return ok(Spec { ..spec, expect_files: out });
    };
    if (name.starts_with("file:")) {
        let path = companion_path(name, "file:")?;
        mut out = spec.extra_files;
        set out.push(Entry { path, contents: body });
        return ok(Spec { ..spec, extra_files: out });
    };

    // `check` with flags pins one projection of `aipl check`'s output; bare `check` pins all of it.
    if (name.starts_with("check ") && name != "check exit code") {
        return with_check(spec, check_projection(name)?, body);
    };
    match (name) {
        "stdout" => ok(Spec { ..spec, stdout: some(body) }),
        "stderr" => ok(Spec { ..spec, stderr: some(body) }),
        "errors" => err(
            "the `errors` section is gone: write the same body under `--- check --compile ---`",
        ),
        "formatted" => err(
            "the `formatted` section is gone: formatting is held by every `.aipl` file being canonical",
        ),
        "performance" => err(
            "the `performance` section is gone: a case's counts are its row in tests/performance_metrics.md, and a property is stated by a `.benchmark` block or a `--- report ---` section",
        ),
        "report" => ok(Spec { ..spec, report: some(body) }),
        "check" => with_check(spec, "", body),
        // One argument per line. An empty section is *no* arguments: `lines("")`
        // yields a single empty element, which would become one empty argument.
        "cli" => ok(Spec { ..spec, cli: if (body == "") { [] } else { body.split_lines() } }),
        "exit code" => ok(Spec { ..spec, exit_code: some(whole_number(name, body)?) }),
        "check exit code" => err(
            "the `check exit code` section is gone: the status of `check` follows from the body of the `check` section that records it",
        ),
        _ => err(`unknown section name "{name}"`),
    }
}

# The single integer an exit-code section's body must be, named by its own section in the error.
fn whole_number(section: str, body: str) -> i64!str {
    body.trim().int_parse().value_or_err(`{section} section must contain a single integer`)
}

# The path a `file:`-style marker carries, validated. `\` is a path-separator
# nuisance in this markup, so the source side is held to `/` and the harness
# canonicalizes on disk.
fn companion_path(name: str, prefix: str) -> str!str {
    let path = name.drop_n(prefix.len()).trim();
    if (path == "") {
        return err(`"{prefix}" section needs a path: "--- {prefix} path/to/it ---"`);
    };
    if (path.contains("""\""")) {
        return err(```use "/" (not "\") in "{prefix}" section paths: "{path}"```);
    };
    ok(path)
}

# The parts of `aipl check` a section can pin, in the one order they are written.
fn check_parts() -> str[] { ["--format", "--compile", "--tests", "--benchmarks"] }

# The projection a `check <flags>` header names, as its canonical flags
# (`--compile --tests`). A header is one spelling of its projection: the flags are the
# command line's own, each at most once, in the command line's order, single-spaced — so
# a section is found by its header and no two spell the same projection differently.
fn check_projection(name: str) -> str!str {
    let flags = name.words().drop_n(1);
    for (let flag : flags) {
        if (!check_parts().any(|part| part == flag)) {
            return err(
                `unknown flag "{flag}" in "--- {name} ---": a check section names the parts of \`aipl check\` it pins, {check_parts().join(sep=", ")}`,
            );
        };
    }
    let canonical = check_parts().filter(|part| flags.any(|flag| flag == part));
    if (canonical.len() != flags.len()) {
        return err(`a flag is given twice in "--- {name} ---"`);
    };
    let projection = canonical.join(sep=" ");
    if (name != `check {projection}`) {
        return err(
            `write "--- {name} ---" as "--- check {projection} ---": one spelling per projection`,
        );
    };
    ok(projection)
}

# `spec` with the expectation that `projection` of `check`'s output is `body`. Two sections cannot
# pin the same projection, however they are spelled.
fn with_check(spec: Spec, projection: str, body: str) -> Spec!str {
    if (spec.checks.any(|existing| existing.projection == projection)) {
        return err(`two sections pin the same part of \`aipl check\`'s output ("{projection}")`);
    };
    mut checks = spec.checks;
    set checks.push(Check { projection, body });
    ok(Spec { ..spec, checks })
}
