// `format_source`, the formatter's top-level pipeline, in the two halves the
// Rust side calls around the checks that stay there.
//
// The whole sequence is: split off the trailing `--- section ---` blocks, strip
// trailing whitespace from what's left, **parse it with the real parser**, lay
// it out, normalize to exactly one trailing newline, **verify the output has the
// same tokens as the input**, then re-attach the sections verbatim.
//
// The two bold steps are Rust's and stay there — the parser and the token
// comparison are not dogfooded — and one of them sits in the *middle*, which is
// why this is two entries rather than one. Parsing has to come before layout:
// the parser's errors are the good ones, and anything it accepts the walker must
// handle, so a malformed program should fail with the parser's message rather
// than whatever the walker makes of it.
import { concat as +++, equal as == } from builtins;
import { clean_trailing_whitespace } from "./clean_trailing_whitespace.aipl";
import { split_test_sections } from "./split_test_sections.aipl";
import { trim_end_while } from "./trim_end_while.aipl";
import { FmtError, format_program } from "./walker.aipl";

// The formatter's input, split into the part it lays out and the part it copies.
struct FmtInput { cleaned: str, sections: str }

pub fn fmt_prepare(src: str) -> FmtInput {
    let (code, sections) = split_test_sections(src);
    FmtInput { cleaned: clean_trailing_whitespace(code), sections }
}.doc("""
    The first half of `format_source`: `src` split into the code to format
    (trailing whitespace already stripped) and its trailing `--- section ---`
    blocks, which are copied to the output verbatim rather than laid out.

    The caller parses `cleaned` before handing it to `fmt_layout`.
""").test({
    // No sections: everything is code, and the cleanup has run.
    let plain = fmt_prepare("fn main() {}  \n");
    assert(plain.cleaned == "fn main() {}\n");
    assert(plain.sections == "");

    // Sections split off, and are *not* whitespace-cleaned — an expected-output
    // body may contain trailing whitespace that is part of what it asserts.
    let with_sections = fmt_prepare("fn main() {}  \n--- stdout ---\nhi  \n");
    assert(with_sections.cleaned == "fn main() {}\n");
    assert(with_sections.sections == "--- stdout ---\nhi  \n");

    // Empty input stays empty on both sides.
    let empty = fmt_prepare("");
    assert(empty.cleaned == "");
    assert(empty.sections == "");
})

pub fn fmt_layout(cleaned: str, width: u64) -> str!FmtError {
    let laid_out = format_program(cleaned, width)?;
    ok(laid_out.trim_end_while(|c| c == '\n') +++ "\n")
}.doc("""
    The second half of `format_source`: lay `cleaned` out at `width`, then
    normalize to exactly one trailing newline — including for an empty program,
    which formats to just that. The printer only keeps a trailing newline when
    the layout happens to end with one, so the guarantee is made here rather
    than there.

    The caller verifies the result carries the same tokens as `cleaned`, then
    appends the sections `fmt_prepare` set aside.
""").test({
    assert(fmt_layout("fn main() {}", 100) == ok("fn main() {}\n")); // newline added
    assert(fmt_layout("fn main() {}\n\n\n", 100) == ok("fn main() {}\n")); // run collapsed
    assert(fmt_layout("", 100) == ok("\n")); // empty program is just the newline

    // The layout itself still happens — this is the real formatter, not a
    // passthrough — and a malformed program still surfaces the walker's error.
    assert(fmt_layout("fn  main( )  {  }", 100) == ok("fn main() {}\n"));
})
