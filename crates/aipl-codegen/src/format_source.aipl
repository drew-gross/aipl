# `format_source`, the formatter's top-level pipeline.
#
# The sequence is: split off the trailing `--- section ---` blocks, strip
# trailing whitespace from what's left, parse it with the real parser, lay it
# out, normalize to exactly one trailing newline, verify the output holds the
# same tokens as the input, then re-attach the sections verbatim.
#
# Parsing comes before layout on purpose: the parser's errors are the good
# ones, and anything it accepts the walker must handle, so a malformed program
# fails with the parser's message rather than whatever the walker makes of it.
# The token check comes *after* and is the safety net: the output must carry
# exactly the input's tokens and comments, or it is refused rather than
# emitted — a formatter bug must never corrupt code.
#
# This used to be two AIPL entries with the parse and the token check between
# them in Rust, from before the parser was itself dogfooded. Now the whole
# pipeline runs in-engine and Rust's `format_source` is one FFI call.

import {
    concat as +++,
    equal as ==,
    filter,
    first,
    is_nonempty,
    is_space,
    join,
    len,
    less_than as <,
    logical_and as &&,
    logical_not as !,
    map,
    map_err,
    not_equal as !=,
    push,
    sort,
    split,
    starts_with,
    to_str,
    trim_while,
    value_or,
    wrapping_add as +,
    wrapping_add_assign as +=,
    wrapping_increment as ++,
} from builtins;
import { clean_trailing_whitespace } from "./clean_trailing_whitespace.aipl";
import { ParseError } from "./grammar.aipl";
import { ParseFailure, aipl_parse_file } from "./grammar_aipl.aipl";
import {
    AiplTok,
    Backtick,
    Comma,
    Import,
    Pipe,
    Quoted,
    Semi,
    StrLit,
    TemplateOpen,
    TemplateText,
    TripleBacktick,
    TripleQuoted,
    lex_aipl,
} from "./lex_aipl.aipl";
import { LexResult } from "./lexer.aipl";
import { split_test_sections } from "./split_test_sections.aipl";
import { trim_end_while } from "./trim_end_while.aipl";
import { FmtError, format_program } from "./walker.aipl";

# Format AIPL source to the canonical style, at `width`. The output always ends
# in exactly one newline (an empty program formats to just that). The input's
# trailing `--- section ---` blocks are preserved byte-for-byte — they follow
# that newline, and whatever they end with is theirs; trailing whitespace in the
# source portion is removed (the language rejects it, so fixing it can't change
# an accepted program's meaning).
pub fn format_source(src: str, width: u64) -> str!FmtError {
    let FmtInput { cleaned, sections } = fmt_prepare(src);
    aipl_parse_file(cleaned).map_err(first_error)?;
    let laid_out = fmt_layout(cleaned, width)?;
    verify_same_tokens(cleaned, laid_out)?;
    ok(laid_out +++ sections)
}.test({
    // The whole pipeline: whitespace cleaned, laid out, newline normalized, and
    // the sections re-attached exactly as they were.
    assert(format_source("fn  main( )  {  }  \n\n", 100) == ok("fn main() {}\n"));
    assert(format_source("fn  main( ) {}\n--- stdout ---\nhi  \n", 100) == ok(
        "fn main() {}\n--- stdout ---\nhi  \n",
    ));
    assert(format_source("", 100) == ok("\n"));

    // A malformed program fails with the *parser's* message, not the walker's.
    assert(
        match (format_source("fn f( {", 100)) {
            ok(..) => "formatted",
            err(e) => e.message,
        } == "expected `)` or a parameter, found `{`",
    );
})

# The first error of a failed parse as the formatter's own. A formatter reports
# one: it has nothing to say about a file it could not read, and the rest of a
# parse's errors are `aipl check`'s to show.
fn first_error(ParseFailure { errors }) -> FmtError {
    errors
        .first()
        .map(|e| FmtError { message: e.message, span: e.span })
        .value_or(FmtError { message: "the file does not parse", span: 0..0 })
}.test({
    assert(first_error(ParseFailure {
        errors: [
            ParseError { message: "one", span: 1..2 },
            ParseError { message: "two", span: 3..4 },
        ],
    }) == FmtError { message: "one", span: 1..2 });
})

# The formatter's input, split into the part it lays out and the part it copies.
struct FmtInput { cleaned: str, sections: str }

# `src` split into the code to format (trailing whitespace already stripped)
# and its trailing `--- section ---` blocks, which are copied to the output
# verbatim rather than laid out.
fn fmt_prepare(src: str) -> FmtInput {
    let (code, sections) = split_test_sections(src);
    FmtInput { cleaned: clean_trailing_whitespace(code), sections }
}.test({
    // No sections: everything is code, and the cleanup has run.
    let plain = fmt_prepare("fn main() {}  \n");
    assert(plain.cleaned == "fn main() {}\n");
    assert(plain.sections == "");

    // Sections split off, and are *not* whitespace-cleaned — an expected-output
    // body may contain trailing whitespace that is part of what it asserts.
    let with_sections = fmt_prepare("fn main() {}  \n--- stdout ---\nhi  \n");
    assert(with_sections.cleaned == "fn main() {}\n");
    assert(with_sections.sections == "--- stdout ---\nhi  \n");

    // Empty input stays empty on both sides.
    let empty = fmt_prepare("");
    assert(empty.cleaned == "");
    assert(empty.sections == "");
})

# `cleaned` laid out at `width`, then normalized to exactly one trailing
# newline — including for an empty program, which formats to just that. The
# printer only keeps a trailing newline when the layout happens to end with
# one, so the guarantee is made here rather than there.
fn fmt_layout(cleaned: str, width: u64) -> str!FmtError {
    let laid_out = format_program(cleaned, width)?;
    ok(laid_out.trim_end_while(|c| c == '\n') +++ "\n")
}.test({
    assert(fmt_layout("fn main() {}", 100) == ok("fn main() {}\n")); // newline added
    assert(fmt_layout("fn main() {}\n\n\n", 100) == ok("fn main() {}\n")); // run collapsed
    assert(fmt_layout("", 100) == ok("\n")); // empty program is just the newline

    // The layout itself still happens — this is the real formatter, not a
    // passthrough — and a malformed program still surfaces the walker's error.
    assert(fmt_layout("fn  main( )  {  }", 100) == ok("fn main() {}\n"));
})

# Refuse unless `output` holds exactly `input`'s tokens and comments — exactly
# as `TokenFingerprint` defines it, which is where the three things a reformat
# is allowed to change are spelled out.
#
# The three parts are reported separately so the message names what moved: a
# reordered statement is an import-hoisting bug, a reordered token is a layout
# bug, and they want different reading.
fn verify_same_tokens(input: str, output: str) -> !FmtError {
    let before = lex_aipl(input).map_err(|e| FmtError { message: e.message, span: e.span })?;
    let after = lex_aipl(output).map_err(|e| FmtError {
        message: `formatter produced unlexable output: {e.message}`,
        span: e.span,
    })?;
    let was = token_fingerprint(before);
    let now = token_fingerprint(after);
    if (was.rest != now.rest) {
        // Name the first token that differs — the two lists agree up to it —
        // so the bug report says which literal moved rather than only that one
        // did.
        let differ = first_difference(was.rest, now.rest);
        return err(FmtError {
            message: `formatter would not preserve the token stream (formatter bug): {differ}; no output written`,
            span: 0..0,
        });
    };
    if (was.imports != now.imports) {
        let differ = first_difference(was.imports, now.imports);
        return err(FmtError {
            message: `formatter would not preserve the imports (formatter bug): {differ}; no output written`,
            span: 0..0,
        });
    };
    if (was.comments != now.comments) {
        return err(FmtError {
            message: "formatter would not preserve comments (formatter bug); no output written",
            span: 0..0,
        });
    };
    ok()
}.test({
    // The same tokens in a different layout pass; reordered imports pass.
    assert(verify_same_tokens("fn f() { 1 }", "fn f() {\n    1\n}\n") == ok());
    assert(
        verify_same_tokens(
            "import { b } from \"./b.aipl\";\nimport { a } from builtins;",
            "import { a } from builtins;\nimport { b } from \"./b.aipl\";",
        ) == ok(),
    );
    // Trailing commas and leading `|`s are layout, not content.
    assert(verify_same_tokens("f(a, b)", "f(\n    a,\n    b,\n)") == ok());
    assert(verify_same_tokens("variant V = A | B", "variant V =\n    | A\n    | B") == ok());
    // A `\"\"\"` block re-indented keeps its value.
    assert(verify_same_tokens(`"""\n  x\n  """`, `"""\n    x\n    """`) == ok());
    // A single-line string re-delimited (`requote`) keeps its value.
    assert(verify_same_tokens("""let s = "say \"hi\"";""", """let s = `say "hi"`;""") == ok());
    assert(verify_same_tokens("""let s = `\{a\}`;""", """let s = "{a}";""") == ok());

    // A lost, changed, or gained token is refused, and so is a lost comment.
    assert(verify_same_tokens("fn f() { 1 }", "fn f() { }") != ok());
    assert(verify_same_tokens(`let s = "a";`, `let s = "b";`) != ok());
    assert(verify_same_tokens("fn f() {}", "fn f() { 1 }") != ok());
    assert(verify_same_tokens("// c\nfn f() {}", "fn f() {}") != ok());

    // Outside the imports the check is positional, so a token the layout moved
    // is refused even though nothing was lost — a reordering the multiset
    // comparison this replaced could not see.
    assert(verify_same_tokens("f(a, b)", "f(b, a)") != ok());
    assert(verify_same_tokens("let x = 1;\nlet y = 2;", "let y = 2;\nlet x = 1;") != ok());
    // Reordering *inside* the imports stays invisible, one statement or several.
    assert(
        verify_same_tokens(
            "import { b, a } from builtins;",
            "import { a, b } from builtins;",
        ) == ok(),
    );
    // Losing an imported name is not.
    assert(
        verify_same_tokens("import { a, b } from builtins;", "import { a } from builtins;") != ok(),
    );
})

# A token's value for the preservation check: `to_str` of its kind, except that
# a string's delimiter is not part of it — `"a"`, `` `a` `` and a `"""` block
# holding `a` are the same token, and respelling one as another (the walker's
# `requote`) is the one edit the formatter makes inside a literal.
fn token_value(kind: AiplTok) -> str {
    if (let StrLit(v, _) = kind) {
        return `str {v}`;
    };

    // A template's opener likewise: which delimiter it was written with is not
    // part of the token, since `retemplate` moves a literal between the two.
    // Its text segments need no such arm — both forms lex to one `TemplateText`.
    if (let TemplateOpen(_) = kind) {
        return TPL_OPEN;
    };
    if (let TplClose = kind) {
        return TPL_CLOSE;
    };

    // A text segment reads as the string it is, so a literal respelled across
    // the string/template line compares equal — see `collapse_templates`.
    //
    // Each line's leading indent comes off first. A raw template is de-dented
    // across the whole literal, which no lexer reading one token at a time can
    // do — so the segments arrive as written and the *parser* de-dents them
    // (`template_segments`). Re-indenting the literal is therefore a change the
    // formatter is allowed to make to these tokens, exactly as it may re-indent
    // a `"""` block, and this is where that latitude is spelled out.
    if (let TemplateText(v) = kind) {
        return `str {v.strip_line_indent()}`;
    };
    to_str(kind)
}.test({
    assert(token_value(StrLit("a", Quoted)) == token_value(StrLit("a", Backtick)));
    assert(token_value(StrLit("a", Quoted)) == token_value(StrLit("a", TripleQuoted)));
    assert(token_value(StrLit("a", Quoted)) != token_value(StrLit("b", Quoted)));
    assert(token_value(TemplateOpen(Backtick)) == token_value(TemplateOpen(TripleBacktick)));
    assert(token_value(TemplateText("a")) != token_value(TemplateText("b")));
})

# Every line of `self` with its leading spaces and tabs removed — the shape of a
# raw template's text that survives re-indentation.
fn strip_line_indent(self: str) -> str {
    self.split("\n").map(|line: str| line.trim_while(is_space)).join(sep="\n")
}.test({
    assert("a".strip_line_indent() == "a");
    assert("  a".strip_line_indent() == "a");
    assert("  a\n    b".strip_line_indent() == "a\nb");
    // Only the *leading* run goes: what a line says is untouched.
    assert("  a  b  ".strip_line_indent() == "a  b  ");
})

# The fingerprint spellings of a template's delimiters. Named because
# `collapse_templates` matches on them, and a spelling matched in two places is
# a spelling to write once.
let TPL_OPEN = "tpl-open";

let TPL_CLOSE = "tpl-close";

# An interpolation-free template folded to the one string value it is.
#
# `` `a` `` and `"a"` are the same program — the parser lowers a template with
# no interpolations to a plain string, and `requote` moves a literal between the
# two spellings to save escapes. They are not the same *tokens*, though: one is
# a run of three and the other is one, so a token-by-token comparison would call
# a legal respelling a formatter bug. Folding the run is what lets the check
# stay token-based everywhere else.
fn collapse_templates(values: str[]) -> str[] {
    mut out: str[] = [];
    mut i: u64 = 0;
    while (i < values.len()) {
        let v = values[i].value_or("");
        let next = values[i + 1].value_or("");
        let closes = values[i + 2].value_or("") == TPL_CLOSE;
        if (v == TPL_OPEN && next == TPL_CLOSE) {
            set out.push("str ");
            set i += 2;
        } else if (v == TPL_OPEN && closes && next.starts_with("str ")) {
            set out.push(next);
            set i += 3;
        } else {
            set out.push(v);
            set i++;
        };
    }
    out
}.test({
    // An interpolation-free template collapses to the one string it is; the
    // empty one to the empty string.
    assert(collapse_templates([TPL_OPEN, "str a", TPL_CLOSE]) == ["str a"]);
    assert(collapse_templates([TPL_OPEN, TPL_CLOSE]) == ["str "]);
    assert(collapse_templates(["x", TPL_OPEN, "str a", TPL_CLOSE, "y"]) == ["x", "str a", "y"]);

    // One with an interpolation keeps every piece — there is no string it is.
    let interpolated = [TPL_OPEN, "str a", "{", "Name(x)", "}", TPL_CLOSE];
    assert(collapse_templates(interpolated) == interpolated);
})

# Where two token lists first disagree, as `<before> became <after>`
# (`nothing` for a side that ran out) — the detail a preservation failure
# reports.
fn first_difference(was: str[], now: str[]) -> str {
    for (let i, w : was) {
        if (now[i] != some(w)) {
            return `{w} became {now[i].value_or("nothing")}`;
        };
    }
    `nothing became {now[was.len()].value_or("nothing")}`
}.test({
    assert(first_difference(["a", "b"], ["a", "c"]) == "b became c");
    assert(first_difference(["a"], ["a", "b"]) == "nothing became b");
    assert(first_difference(["a", "b"], ["a"]) == "b became nothing");
})

# A lexed source reduced to what a reformat must preserve: every non-import
# token **in order**, the import statements as a sorted multiset, and the
# comments as one too. Two sources with equal fingerprints hold the same code.
#
# A token counts as its *value* (`token_value`), so the formatter's
# value-preserving whitespace edits inside a `"""` block are not flagged while
# any change to a literal's value is.
#
# Three things a reformat is allowed to change, and each is why a part is shaped
# the way it is:
#
# - **Imports are hoisted and sorted**, both the statements and the names inside
#   one. So each statement collapses to its own tokens sorted and joined
#   (`import_signature`) and the statements are then sorted among themselves —
#   reordering is invisible, losing or changing a name is not.
# - **A trailing comma is normalized** (dropped when a list renders flat, added
#   when it breaks), and a variant's **leading `|`** is the same normalization at
#   the other end. Both are layout, so `is_layout` drops them before anything
#   else — which also excludes the `|` between match-pattern alternatives.
# - **Comments move with the construct they are glued to**, which can reorder
#   them against the tokens, so they are their own sorted multiset rather than
#   part of `rest`.
#
# Everything else is positional: `rest` catches a token the layout moved, not
# just one it lost.
struct TokenFingerprint { imports: str[], rest: str[], comments: str[] }

fn token_fingerprint(lexed: LexResult<AiplTok>) -> TokenFingerprint {
    mut imports: str[] = [];
    mut rest: str[] = [];
    mut statement: str[] = [];
    mut in_import = false;
    for (let t : lexed.tokens.filter(|t| !t.kind.is_layout())) {
        let value = token_value(t.kind);
        if (in_import) {
            set statement.push(value);
            if (let Semi = t.kind) {
                set imports.push(import_signature(statement));
                set statement = [];
                set in_import = false;
            };
        } else {
            if (let Import = t.kind) {
                set in_import = true;
                set statement = [value];
            } else {
                set rest.push(value);
            };
        };
    }
    if (statement.is_nonempty()) {
        // An `import` with no `;`. A parsed program has none, and both sides of
        // the check are parsed — but dropping it would hide a lost name, which
        // is the one thing this function exists to catch.
        set imports.push(import_signature(statement));
    };
    TokenFingerprint {
        imports: imports.sort(),
        rest: collapse_templates(rest),
        comments: lexed.trivia$text$text.sort(),
    }
}

# One import statement's tokens as a single comparable unit: sorted, so the
# names reordering inside the list doesn't show, then joined so the statement
# compares as a whole rather than mixing into its neighbours.
fn import_signature(statement: str[]) -> str { statement.sort().join(sep=" ") }.test({
    assert(import_signature(["import", "b", "a", ";"]) == "; a b import");
    assert(import_signature(["import", "a", "b", ";"]) == import_signature([
        "import",
        "b",
        "a",
        ";",
    ]));
})

# Whether a token is pure layout — a comma or a `|` the formatter adds and drops
# as a list renders flat or broken (see `TokenFingerprint`) — and so takes no
# part in the preservation check.
fn is_layout(self: AiplTok) -> bool {
    match (self) {
        Comma | Pipe => true,
        _ => false,
    }
}.test({
    assert(Comma.is_layout());
    assert(Pipe.is_layout());
    assert(!Semi.is_layout());
    assert(!StrLit(",", Quoted).is_layout());
})
