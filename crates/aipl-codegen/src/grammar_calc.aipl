# A four-operator calculator: the library's third end-to-end target, and the one
# that exercises `Climb`. Neither earlier toy has an infix operator at all —
# S-expressions put the operator first and JSON has none — so precedence
# climbing was proven only by `parse.aipl`'s own unit tests, which stop at the
# concrete tree. This one lowers through that tree and then *evaluates* the
# result, which is the assertion that a wrong shape cannot survive.
#
#     expr  -> Climb(unary, [+ -  |  * / %  |  ^ right])
#     unary -> "-" unary | atom
#     atom  -> Num | "(" expr ")"
#
# Three things it pins down that a tree-shape assertion alone would not:
#
#   - **Precedence and associativity, as arithmetic.** `2 + 3 * 4` is 14 and not
#     20; `2 ^ 3 ^ 2` is 512 (right-associative) and not 64; `10 - 3 - 2` is 5
#     (left-associative) and not 9.
#   - **What `Climb` hands a lowering function.** Each operand nests under the
#     *enclosing* production's index, so a binary node arrives as two interior
#     children with the operator between them as a direct leaf — read with
#     `own_token_text`, which exists for exactly this (see `cst.aipl`).
#   - **A `build` that legitimately fails.** An integer literal too big for an
#     `i64` is a lowering error, not a parse error, and it propagates out of
#     `parse` unchanged. That is the case the two-pass design was chosen for: run
#     during the parse it would have aborted alternatives that should simply have
#     been retried.
#
# Unary minus is *not* a `Climb` operator — `Climb` is binary — so it lives in
# the atom rule, which is what makes it bind tighter than every infix operator:
# `-2 ^ 2` is `(-2) ^ 2`.

import {
    equal as ==,
    first,
    int_parse,
    is_nonempty,
    last,
    len,
    less_than as <,
    logical_or as ||,
    map_err,
    map_ok,
    saturating_divide as /,
    saturating_remainder as %,
    to_set,
    to_str,
    value_or_err,
    wrapping_add as +,
    wrapping_increment as ++,
    wrapping_mul as *,
    wrapping_mul_assign as *=,
    wrapping_sub as -,
} from builtins;
import { Cst, Parts, own_token_text, show, span, text } from "./cst.aipl";
import { ebnf, show_first_sets } from "./ebnf.aipl";
import { render_cst } from "./format.aipl";
import {
    Climb,
    Grammar,
    Inline,
    Literal,
    Named,
    OneOf,
    ParseError,
    Prec,
    Production,
    Rule,
    Term,
    Then,
    Tight,
    TryMk,
    failure_message,
    prod_names,
} from "./grammar.aipl";
import { Bare, CharRun, Int, LexResult, OneChar, TokenRule, lex } from "./lexer.aipl";
import { parse, parse_cst } from "./parse.aipl";

# Two token kinds: digit runs, and every one-character operator or bracket. The
# grammar tells the operators apart by `Literal`, so their kind never has to.
# (Imported unaliased, against the usual `Literal as Lit`: this grammar's own
# AST already calls a case `Lit`, and an import colliding with a local is a hard
# error. The alias is a convention, not a requirement.)
variant CalcTok = Num | Punct

# The AST. `Bin` carries the operator's spelling rather than a case per
# operator — the grammar already lists them in its `Prec` table, and one arm in
# `eval_calc` per spelling keeps the two in step without a third enumeration.
variant Calc = Lit(i64) | Neg(Calc) | Bin(str, Calc, Calc)

# Whitespace is trivia rather than skipped, so the concrete tree covers every
# byte and reconstructs the source exactly.
#
# The punctuation rule sits *ahead* of `Int`, which makes every `-` its own
# token and `Int` unsigned. That is the ordering this grammar needs: negation is
# a rule (`unary`), so a `-` the lexer had swallowed into the literal would be
# invisible to it — `1 -2` would lex as two numbers and parse as nothing.
fn calc_rules() -> TokenRule<CalcTok>[] {
    [
        TokenRule { matcher: CharRun(" \t\r\n".to_set()), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: OneChar("+-*/%^()".to_set()), emit: Bare(Punct) },
        TokenRule { matcher: Int, emit: Bare(Num) },
    ]
}

// ---------- lowering ----------

# A `Climb` node is either a bare atom that climbed to itself — one interior
# child, no operator — or an application: two interior children with the
# operator as a direct leaf between them.
fn lower_expr(src: str, node: Parts, kids: Calc[]) -> Calc!ParseError {
    let lhs = kids
        .first()
        .value_or_err(ParseError { message: "an expression matched nothing", span: node.span() })?;
    match (kids.last()) {
        some(rhs) => if (kids.len() == 2) {
            ok(Bin(node.own_token_text(src), lhs, rhs))
        } else {
            ok(lhs)
        },
        none => ok(lhs),
    }
}

# `-` then a unary, or a bare atom. The two are told apart by whether this node
# matched a `-` of its own: the atom branch matches no token directly at all.
fn lower_unary(src: str, node: Parts, kids: Calc[]) -> Calc!ParseError {
    let inner = kids
        .first()
        .value_or_err(ParseError {
            message: "a unary expression has no operand",
            span: node.span(),
        })?;
    if (node.own_token_text(src).is_nonempty()) { return ok(Neg(inner)); };
    ok(inner)
}

# A parenthesized expression lowered one interior child, and a literal lowered
# none — so the absence of a child is what says "this is a number", and its text
# is the node's own.
#
# The one `build` here that can fail: a literal too big for an `i64`. It is a
# lowering error, not a parse error, and `parse` hands it back unchanged.
fn lower_atom(src: str, node: Parts, kids: Calc[]) -> Calc!ParseError {
    match (kids.first()) {
        some(inner) => ok(inner),
        none => {
            let text = node.own_token_text(src);
            let v = text
                .int_parse()
                .value_or_err(ParseError {
                    message: `integer literal "{text}" overflows i64`,
                    span: node.span(),
                })?;
            ok(Lit(v))
        },
    }
}

# The calculator grammar: `+ - * / % ^` over integer literals, with `^`
# right-associative and unary `-` binding tighter than any of them.
#
# Only `atom` is labelled, so a failure deep in an expression reports as "an
# expression" rather than as the three productions it is made of.
pub fn calc_grammar() -> Grammar<CalcTok, Calc> {
    // Higher `power` binds tighter. `^` is the one right-associative level, which
    // is what makes `2 ^ 3 ^ 2` nest to the right where `-` nests to the left.
    let r_expr: Rule<CalcTok> = Climb(
        Named("unary"),
        [
            Prec { power: 1, right: false, ops: ["+", "-"] },
            Prec { power: 2, right: false, ops: ["*", "/", "%"] },
            Prec { power: 3, right: true, ops: ["^"] },
        ],
    );
    let r_unary: Rule<CalcTok> = OneOf([Then([Literal("-"), Named("unary")]), Named("atom")]);
    let r_atom: Rule<CalcTok> = OneOf([
        Term(Num),
        Then([Literal("("), Named("expr"), Literal(")")]),
    ]);
    Grammar {
        prods: [
            // `unary` and `atom` share one label, which is the whole point of
            // `expect_as`: unlabelled, a failure at the start of an operand
            // reports "expected `-` or an expression" — the `-` being the first
            // alternative of `unary` leaking out, when a unary minus *is* an
            // expression. One label on both collapses them to the word a reader
            // wants, exactly as the LR parser's `SYMBOL_DISPLAY_NAMES` collapses
            // `expr`/`term`/`unary`/`atom`. `expr` stays transparent so a
            // half-matched expression still reports what it was really missing.
            //
            // The layouts are the same three lines of reasoning: a `Climb`
            // application is an operand, an operator and an operand, which
            // `Inline` spaces by the rule below; a unary minus is written
            // against what it negates, which is `Tight`; and a parenthesized
            // atom hugs its parentheses, which the rule already says.
            Production { name: "expr", rule: r_expr, build: TryMk(lower_expr), layout: Inline },
            Production {
                name: "unary",
                rule: r_unary,
                build: TryMk(lower_unary),
                expect_as: "an expression",
                layout: Tight,
            },
            Production {
                name: "atom",
                rule: r_atom,
                build: TryMk(lower_atom),
                expect_as: "an expression",
                layout: Inline,
            },
        ],
    }
}.test({
    // The grammar as a reader would write it, derived from the same value the
    // driver parses with — so the description and the parser cannot drift.
    // `Climb` has no EBNF operator, so it renders flat with its binding powers
    // stated alongside; everything else is the grammar verbatim.
    assert(ebnf(calc_grammar()) == """
        expr = unary (("+" | "-" | "*" | "/" | "%" | "^") unary)* ; (* precedence: "^" (right) > "*" "/" "%" > "+" "-" *)
        unary = "-" unary | atom ;
        atom = Num | "(" expr ")" ;
    """);

    // Two of the three begin identically, which is the grammar saying that a
    // unary minus is an expression: nothing here can be told apart by its first
    // token alone, so `unary`'s two alternatives are ordered, not disjoint.
    assert(show_first_sets(calc_grammar())? == """
        expr = Num "-" "("
        unary = Num "-" "("
        atom = Num "("
    """);
})

fn lex_calc(src: str) -> LexResult<CalcTok>!ParseError {
    src.lex(calc_rules()).map_err(|e| ParseError { message: e.message, span: e.span })
}

# The lossless concrete tree for `src`. Use this when the tree is the point;
# `parse_calc` when only the `Calc` is.
pub fn calc_cst(src: str) -> Cst!ParseError {
    parse_cst(src, lex_calc(src)?, calc_grammar(), "expr")
}.test({
    fn shown(src: str) -> str!ParseError {
        ok(calc_cst(src)?.show(src, prod_names(calc_grammar())))
    }

    // How deeply a parsed expression nests — the cheap shape check for a `Climb`
    // that grouped its operands wrongly: a flat run would come back shallower.
    fn depth_of(src: str) -> u64!ParseError { ok(depth(parse_calc(src)?)) }

    fn depth(self: Calc) -> u64 {
        match (self) {
            Lit(..) => 1,
            Neg(x) => 1 + x.depth(),
            Bin(_, l, r) => {
                let a = l.depth();
                let b = r.depth();
                if (a < b) { 1 + b } else { 1 + a }
            },
        }
    }

    // What `Climb` actually builds: one node per operand, nested by binding
    // power, with the operator a direct leaf of the node that applies it. The
    // outermost application is flat because `match_prod`'s own wrap completes it.
    // Trivia attaches in front of the token that follows it, which is why the
    // space before `+` is a leaf of the outer node and the one before `2` is a
    // leaf of the atom.
    assert(shown("1 + 2")? == "(expr (expr (unary (atom 1))) ~  + (expr (unary (atom ~  2))))");

    // `*` binds tighter, so it nests inside the `+` — and the other order proves
    // it is precedence and not source order.
    assert(depth_of("1 + 2 * 3")? == 3);
    assert(depth_of("1 * 2 + 3")? == 3);

    // Losslessness: every byte under exactly one leaf, so the leaves concatenate
    // back to the source.
    let src = " -( 1 + 2 ) * 3 ";
    assert(calc_cst(src)?.text(src) == src);
})

# The `Calc` `src` denotes: lex, parse to a concrete tree, lower it through
# the grammar's `build` functions.
#
# Fails with a `ParseError` from either half of the front end, or from a
# lowering that refused — an integer literal too big for an `i64`.
pub fn parse_calc(src: str) -> Calc!ParseError {
    parse(src, lex_calc(src)?, calc_grammar(), "expr")
}.test({
    fn msg_of(src: str) -> str { parse_calc(src).map_ok(render_calc).failure_message() }

    // ---- atoms ----
    assert(parse_calc("7")? == Lit(7));
    assert(parse_calc("(7)")? == Lit(7));
    assert(parse_calc("-7")? == Neg(Lit(7)));
    // Unary is its own rule, so it stacks.
    assert(parse_calc("--7")? == Neg(Neg(Lit(7))));

    // ---- precedence, as a shape ----
    assert(parse_calc("1 + 2")? == Bin("+", Lit(1), Lit(2)));
    assert(parse_calc("1 + 2 * 3")? == Bin("+", Lit(1), Bin("*", Lit(2), Lit(3))));
    assert(parse_calc("1 * 2 + 3")? == Bin("+", Bin("*", Lit(1), Lit(2)), Lit(3)));

    // ---- a `build` that refuses ----
    //
    // Too big for an `i64`: a *lowering* error, raised after the parse
    // succeeded, and propagated out unchanged.
    let too_big = `integer literal "99999999999999999999" overflows i64`;
    assert(msg_of("99999999999999999999") == too_big);
    // ... and it is the whole parse that fails, not just that operand.
    assert(msg_of("1 + 99999999999999999999") == too_big);

    // ---- errors ----
    assert(msg_of("") == "expected an expression, found end of input");
    assert(msg_of("1 +") == "expected an expression, found end of input");

    // A `Climb` that stops because the next token is no operator of its says so:
    // after `1` an operator is one of the things that could have come next, and
    // a message that listed only the bracket would be telling a reader `1 + 2`
    // is invalid.
    assert(msg_of("(1") == "expected `)` or an operator, found end of input");
    assert(msg_of("1 2") == "expected an operator or end of input, found `2`");
    assert(msg_of("@") == "unexpected character");
})

// Fully parenthesized, so the rendering *is* the tree shape — which is what
// makes the precedence assertions below readable, and what makes the round trip
// exact rather than approximate.
# `self` printed back as source, fully parenthesized — every application gets
# brackets, so the text shows the tree and needs no precedence rules to read.
#
# Round-trips with `parse_calc`: `parse_calc(render_calc(v)) == v`.
pub fn render_calc(self: Calc) -> str {
    match (self) {
        Lit(v) => v.to_str(),
        Neg(x) => `-{x.render_calc()}`,
        Bin(op, l, r) => `({l.render_calc()} {op} {r.render_calc()})`,
    }
}.test({
    // ---- precedence and associativity, made visible ----
    assert(render_calc(parse_calc("1 + 2 * 3")?) == "(1 + (2 * 3))");
    assert(render_calc(parse_calc("1 * 2 + 3")?) == "((1 * 2) + 3)");
    // Equal power, left-associative.
    assert(render_calc(parse_calc("1 - 2 - 3")?) == "((1 - 2) - 3)");
    assert(render_calc(parse_calc("1 + 2 + 3")?) == "((1 + 2) + 3)");
    // The one right-associative level nests the other way.
    assert(render_calc(parse_calc("2 ^ 3 ^ 2")?) == "(2 ^ (3 ^ 2))");
    // Unary is tighter than every infix operator, since it is in the atom rule.
    assert(render_calc(parse_calc("-2 ^ 2")?) == "(-2 ^ 2)");
    assert(render_calc(parse_calc("-2 * 3")?) == "(-2 * 3)");
    // Parentheses override, and disappear into the shape.
    assert(render_calc(parse_calc("(1 + 2) * 3")?) == "((1 + 2) * 3)");

    // ---- round trip ----
    let v = parse_calc("1 + 2 * 3 - 4 ^ 2 ^ 1 / -5 % 6")?;
    assert(parse_calc(v.render_calc())? == v);
    assert(parse_calc(render_calc(Neg(Neg(Lit(3)))))? == Neg(Neg(Lit(3))));
})

// The value of `self`. Integer arithmetic throughout, with the saturating
// division the language provides (so a zero divisor yields a value rather than a
// trap) — a calculator's semantics are its own, and this one's are deliberately
// total.
# `self` evaluated as integer arithmetic. Division is saturating and `^` is
# integer exponentiation with a negative exponent yielding 0, so evaluation is
# total — a calculator's arithmetic policy is its own, not the parser's.
pub fn eval_calc(self: Calc) -> i64 {
    match (self) {
        Lit(v) => v,
        Neg(x) => 0 - x.eval_calc(),
        Bin(op, l, r) => {
            let a = l.eval_calc();
            let b = r.eval_calc();
            match (op) {
                "+" => a + b,
                "-" => a - b,
                "*" => a * b,
                "/" => a / b,
                "%" => a % b,
                "^" => pow(a, b),
                _ => 0,
            }
        },
    }
}.test({
    fn eval(src: str) -> i64!ParseError { ok(parse_calc(src)?.eval_calc()) }

    // The assertion a wrong tree cannot survive: precedence as arithmetic.
    assert(eval("2 + 3 * 4")? == 14);
    assert(eval("2 * 3 + 4")? == 10);
    assert(eval("(2 + 3) * 4")? == 20);
    // Left-associative: `10 - 3 - 2` is 5, not 9.
    assert(eval("10 - 3 - 2")? == 5);
    assert(eval("100 / 10 / 2")? == 5);
    // Right-associative: `2 ^ 3 ^ 2` is 2^9, not 8^2.
    assert(eval("2 ^ 3 ^ 2")? == 512);
    assert(eval("(2 ^ 3) ^ 2")? == 64);
    // Unary minus, and the mixed expression that needs all three levels.
    assert(eval("-3 * -4")? == 12);
    assert(eval("1 + 2 * 3 ^ 2")? == 19);
    assert(eval("7 % 3 + 1")? == 2);
    // Total, not trapping.
    assert(eval("1 / 0")? == 9223372036854775807);
    assert(eval("2 ^ -1")? == 0);
})

# Integer exponentiation by repeated multiplication. A negative exponent has no
# integer value, so it yields 0 rather than failing — see `eval_calc`'s doc.
fn pow(base: i64, exp: i64) -> i64 {
    if (exp < 0) { return 0; };
    mut acc: i64 = 1;
    mut i: i64 = 0;
    while (i < exp) {
        set acc *= base;
        set i++;
    }
    acc
}

// ---------- test-only helpers ----------

# `src` reformatted: parse it to the concrete tree, then lay that out at `width`.
#
# The counterpart of `render_calc`, and the interesting half of the pair.
# `render_calc` prints the *value*, fully parenthesized, so it can only ever
# produce the tree's own shape; this prints the *source*, so the parentheses the
# author wrote survive and the ones they left out are not invented. Both round
# trip, and they are round trips of different things.
#
# This grammar's lexer records no comments — it has none — so what a comment
# does to a layout is `grammar_sexp.aipl`'s to show.
pub fn format_calc(src: str, width: u64) -> str!ParseError {
    render_cst(calc_grammar(), src, calc_cst(src)?, calc_space, width)
}.test({
    // Binary operators take a space; unary minus does not.
    assert(format_calc("1+2*3", 80)? == "1 + 2 * 3");
    assert(format_calc("-3", 80)? == "-3");
    assert(format_calc("1 - -2", 80)? == "1 - -2");
    assert(format_calc("  7  ", 80)? == "7");

    // The author's parentheses are in the tree, so they survive — including the
    // ones precedence made redundant, which is not the formatter's call.
    assert(format_calc("(1+2)*3", 80)? == "(1 + 2) * 3");
    assert(format_calc("1+(2*3)", 80)? == "1 + (2 * 3)");

    // ---- the two properties, plus the one this toy can also state ----
    let messy = "(  1+2 )*-3";
    assert(parse_calc(format_calc(messy, 80)?)? == parse_calc(messy)?);
    let once = format_calc(messy, 80)?;
    assert(format_calc(once, 80)? == once);

    // Formatting cannot change an arithmetic expression's value — the strongest
    // check available here, and the reason this grammar evaluates.
    assert(eval_calc(parse_calc(once)?) == eval_calc(parse_calc(messy)?));
})

# A space beside every binary operator and nowhere else. Unary minus is spelled
# with the same character, which the rule cannot tell apart — and does not have
# to: `unary` is `Tight`, so the rule is never asked about it.
fn calc_space(l: str, r: str) -> bool { l.is_calc_op() || r.is_calc_op() }

fn is_calc_op(self: str) -> bool {
    self == "+" || self == "-" || self == "*" || self == "/" || self == "%" || self == "^"
}
