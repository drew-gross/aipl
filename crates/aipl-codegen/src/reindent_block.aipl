// The formatter's raw-block re-layout: `aipl-fmt`'s `print` calls this through the
// FFI (see `install_parser_hooks`) when emitting a verbatim `"""..."""` raw string
// or triple-backtick template atom, to align its closing delimiter (and, for a
// bare-delimiter block, its content) around the column the atom opened at. `base`
// is that column (the opening line's indent).
import {
    !,
    !=,
    &&,
    wrapping_add as +,
    +++,
    wrapping_sub as -,
    <,
    ==,
    ||,
    count_while,
    filter,
    is_all_whitespace,
    len,
    map,
    minimum,
    repeat,
    trim,
    value_or,
} from builtins;
import { lines } from "./lines.aipl";

pub fn reindent_block(self: str, base: i64) -> str {
    let ls = self.lines();
    let n = ls.len();
    // A single-line atom (no interior newline) has nothing to re-lay-out.
    if (n < 2) {
        return self;
    };

    // Only a semantically-inert blank closing line — leading whitespace then a
    // bare triple-quote / triple-backtick delimiter — is touched; anything else
    // (a content-bearing final line) leaves the atom byte-for-byte.
    let closing = ls[n - 1].value_or("").trim();
    if (closing != "\"\"\"" && closing != "```") {
        return self;
    };

    let opening = ls[0].value_or("");
    let content = ls[1..n - 1];

    // Content re-indentation applies only to a bare-delimiter block (the opening
    // line is exactly the delimiter). The common indent is the smallest
    // leading-space run over the non-blank content lines; with no non-blank
    // content lines there is nothing to shift (`none`, matching the `else`).
    let common = if (opening == "\"\"\"" || opening == "```") {
        content.filter(|l| !l.is_all_whitespace()).map(|l| l.count_while(|c| c == ' ')).minimum()
    } else {
        none
    };
    // One indentation level (INDENT = 4) deeper than the delimiters.
    let target = base + 4;

    // Rebuild line by line, mirroring the closing/content rules: a blank content
    // line is emitted empty (its whitespace would be trailing, and de-denting
    // renders it empty anyway); under a common indent each non-blank line is
    // shifted so the common base becomes `target`, keeping its relative extra
    // indent; otherwise the line is verbatim. Finally the closing re-indented to
    // `base`. Empty content collapses to just opening + closing.
    mut out = opening;
    for (let line : content) {
        let piece = if (line.is_all_whitespace()) {
            ""
        } else {
            match (common) {
                some(c) => " ".repeat(target) +++ line[c..],
                none => line,
            }
        };
        set out = out +++ "\n" +++ piece;
    }
    out +++ "\n" +++ " ".repeat(base) +++ closing
}.doc("""
    Re-lays-out a multi-line raw-string / template atom around `base` columns. The
    closing-delimiter line is re-indented to `base` — but only when it is whitespace
    followed by a bare triple-quote / triple-backtick delimiter (the inert blank
    closing line); otherwise the atom is returned unchanged. For a bare-opening block
    (its opening line is exactly the delimiter), every non-blank content line is
    shifted so the block's common indent becomes `base + 4` — one level deeper than
    the delimiters — while each line keeps its indentation relative to that common
    base. Content shifting is value-safe: the de-denter strips the common leading
    space, so moving every non-blank line by the same amount leaves the value
    unchanged; blank lines stay empty.
""").test({
    // Fewer than two lines: nothing to re-lay-out.
    assert("only".reindent_block(0) == "only");
    // Closing line is not a bare delimiter: unchanged.
    assert("a\nb".reindent_block(0) == "a\nb");

    // Bare-opening triple-quote: content shifted to base + 4 (here 4), closing to
    // base (here 0). A 2-space content indent becomes 4.
    assert("\"\"\"\n  x\n\"\"\"".reindent_block(0) == "\"\"\"\n    x\n\"\"\"");
    // Relative indent is preserved: the deeper line keeps its extra 2 spaces.
    assert("\"\"\"\n  a\n    b\n\"\"\"".reindent_block(0) == "\"\"\"\n    a\n      b\n\"\"\"");
    // A blank content line is emitted empty (no trailing whitespace).
    assert(
        "\"\"\"\n  a\n   \n    b\n\"\"\"".reindent_block(0) == "\"\"\"\n    a\n\n      b\n\"\"\"",
    );

    // A non-zero base offsets both content (base + 4) and the closing delimiter.
    assert("\"\"\"\nx\n\"\"\"".reindent_block(4) == "\"\"\"\n        x\n    \"\"\"");
    // Empty content (only opening + closing) collapses cleanly.
    assert("\"\"\"\n\"\"\"".reindent_block(0) == "\"\"\"\n\"\"\"");

    // Triple-backtick template, bare opening: same content re-indentation.
    assert("```\n      y\n```".reindent_block(0) == "```\n    y\n```");

    // Content-bearing opening line (not a bare delimiter): content is left
    // byte-for-byte; only the closing delimiter moves to `base`.
    assert("\"\"\"hi\n  x\n      \"\"\"".reindent_block(2) == "\"\"\"hi\n  x\n  \"\"\"");
})
