# The shapes that exist only between a production and the fold that consumes
# it: a keyword statement before the rest of its block is in scope, a function
# body before its return type is, a parameter before its destructuring is
# taken apart, and a `.test` attribute. None is a node of the AST proper. One
# of the files the AST is declared across; see `ast.aipl`.

import { Span, equal as ==, is_err_and, value_or_err } from builtins;
import {
    Construct as ConstructExpr,
    Destructure,
    Expr,
    FieldInit,
    WrittenNames,
    at,
    num,
    show_expr,
} from "./expr.aipl";
import { ParseError } from "./grammar.aipl";
import { Function } from "./item.aipl";
import { Pat } from "./pat.aipl";
import { Generic, Named, Ty, Unit, show_ty } from "./ty.aipl";

# One keyword statement, after its own production has read it and before the
# rest of the block is in scope. `wrap_stmt` is what folds it together with that
# rest, and several of these fold into *several* nodes — which is why a
# statement cannot simply lower to an `Expr` the way an expression does.
#
# Parser-local: the AST has no statement node, so this shape exists only between
# the production and the fold.
variant Stmt =
    | Let(name: str, name_span: Span, ty: Ty?, value: Expr)
    | Mut(name: str, name_span: Span, ty: Ty?, value: Expr)
    # `let (a, b) = v;`, `let Case(a) = v;`, `let T { x } = v;` and the `mut` struct
    # form: the pattern as written, kept for `desugar.aipl` to lower, and where its
    # names are written. `span` is the value's.
    | LetDestructure(pattern: Destructure, value: Expr, span: Span, written: WrittenNames)
    # `let PATTERN = value else { .. };` — the rest of the block runs with the
    # pattern's names bound when `value` matches, and `otherwise` (which returns)
    # when it does not.
    | LetElse(pattern: Pat, value: Expr, otherwise: Expr, span: Span, written: WrittenNames)
    | Assign(lhs: Expr, value: Expr, span: Span)
    | For(name: str, name_span: Span, index: str?, iterable: Expr, body: Expr, span: Span)
    # A loop that takes each element apart with a pattern, as written; `span` runs
    # from the iterable through the body.
    | ForDestructure(
        pattern: Destructure,
        index: str?,
        iterable: Expr,
        body: Expr,
        span: Span,
        written: WrittenNames
    )
    | While(cond: Expr, body: Expr, span: Span)
    | Return(value: Expr, span: Span)
    # A statement already built as one expression, run for its effect before the
    # rest of the block.
    | Effect(head: Expr, span: Span)

# A parsed function body, before the return type is in scope to name the struct
# the shorthand constructs. Parser-local: by the time a `Function` is built the
# sugar is gone.
variant ParsedBody = Block(Expr) | Construct(FieldInit[], Span)

# One function attribute, `.test({ .. })` or `.performance({ .. })`: which one
# (`name`), its block, the functions declared inside the block, and the span of
# the attribute name, which is where a duplicate is reported.
struct FnAttr { name: str, body: Expr, fns: Function[], span: Span }

# A `.test` block's contents as its production hands them up: the functions
# declared in it, and the statement chain — `none` while nothing has followed
# yet, which is how `test_tail` tells "the expression before the `;` was the
# block's value" from "the rest of the block follows".
struct TestBlock { fns: Function[], body: Expr? }

# The body, with the struct-literal shorthand resolved. What it builds is
# exactly the `EConstruct` the long form parses to, so nothing downstream of the
# parser sees the sugar at all.
pub fn resolve_body(name: str, body: ParsedBody, return_ty: Ty?) -> Expr!ParseError {
    match (body) {
        Block(e) => ok(e),
        Construct(fields, span) => {
            let ty_name = construct_ty_name(name, return_ty, span)?;
            ok(at(ConstructExpr(ty_name, fields), span))
        },
    }
}.test({
    assert(resolve_body("f", Block(num(1)), none)?.show_expr() == "1");
    let fields = [FieldInit { name: "x", value: num(1) }];
    let shorthand = Construct(fields, 0..0);
    assert(resolve_body("f", shorthand, some(Named("P")))?.show_expr() == "Construct(P, [x: 1])");
    // A generic return contributes its base name.
    assert(
        resolve_body(
            "f",
            shorthand,
            some(Generic("Pair", [Named("T")])),
        )?.show_expr() == "Construct(Pair, [x: 1])",
    );
    // No return type, or one that is not a struct, has nothing to name.
    assert(resolve_body("f", shorthand, none).is_err_and(|e| e.span == 0..0));
    assert(resolve_body("f", shorthand, some(Unit)).is_err_and(|e| e.span == 0..0));
})

# The shorthand names no type, so the return type has to. A generic return
# (`-> Pair<i64>`) contributes its base name and infers its arguments, exactly
# as writing `Pair { .. }` would.
fn construct_ty_name(name: str, return_ty: Ty?, span: Span) -> str!ParseError {
    let declared = return_ty.value_or_err(ParseError {
        message: `fn "{name}": a \`\{ field: value, .. }\` body needs a struct return type to name, but this function declares no return type; add \`-> Struct\`, or give the literal its type`,
        span,
    })?;
    if (let Named(n) = declared) {
        return ok(n);
    };
    if (let Generic(base, _) = declared) {
        return ok(base);
    };
    err(ParseError {
        message: `fn "{name}": a \`\{ field: value, .. }\` body needs a struct return type to name, but this function returns {declared.show_ty()}; give the literal its type, or return a struct`,
        span,
    })
}
