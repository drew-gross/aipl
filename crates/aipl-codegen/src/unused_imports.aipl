# The `unused_imports` lint: an imported name nothing in the file references.
# Legal — an unused import changes no behavior — but it misstates what the file
# depends on and outlives whatever once used it; the better spelling is to drop
# the name.
#
# "Referenced" is deliberately syntactic and *generous*: any expression, pattern,
# operator, or type position mentioning the local name counts, including one a
# local definition or type parameter shadows. That is the safe direction — a lint
# is a hard error here, so a missed dead import costs one stale line, while a
# false hit costs a build that cannot be made to pass except by `#[allow]`.

import {
    Span,
    collect_arms,
    equal as ==,
    filter,
    has,
    join,
    logical_not as !,
    map,
    not_equal as !=,
    split,
    to_set,
    union_all,
    value_or,
} from builtins;
import {
    ArrayLit,
    Assign,
    Bool,
    Call,
    Char,
    Construct,
    DictLit,
    Expr,
    Field,
    For,
    Ident,
    If,
    IfLet,
    Index,
    KwArg,
    Lambda,
    Let,
    LetMut,
    Match,
    Neg,
    Num,
    Return,
    Seq,
    SetLit,
    Shim,
    Slice,
    Spread,
    Str,
    Try,
    TupleLit,
    TypeArgs,
    While,
    subexprs,
} from "./expr.aipl";
import { ParseFailure, aipl_parse_file } from "./grammar_aipl.aipl";
import {
    Builtins,
    Const,
    Fn,
    Import,
    ImportDecl,
    ImportName,
    ImportSource,
    Item,
    Param,
    Path,
    Program,
    Refinement,
    Struct,
    Variant,
} from "./item.aipl";
import { LintHit, hit } from "./lint_hit.aipl";
import { Pat } from "./pat.aipl";
import {
    Any,
    Array as TyArray,
    Case,
    Dict,
    Fn as TyFn,
    Generic,
    Named,
    Optional,
    Primitive,
    Result,
    Set as TySet,
    Tuple as TyTuple,
    Ty,
    TypeVar,
    Unit as TyUnit,
    Without,
} from "./ty.aipl";

# A hit for each name `program` imports and nothing in it references.
pub fn unused_imports(program: Program) -> LintHit[] {
    let used = referenced_names(program);
    program.items.collect_arms(Import)$unused_in(used).join()
}

# A hit for each name `self` imports that is not in `used`.
fn unused_in(self: Import(decl), used: #{str}) -> LintHit[] {
    let ImportDecl { names, source } = decl;
    names
        .filter(|name| !used.has(name.local()))
        .map(|name| hit(unused_message(name.local()), name.hit_span(source)))
}

# What is said of the import `name`.
fn unused_message(name: str) -> str {
    `unused import "{name}": nothing in this file references it; drop it from the import list`
}

# The name an import binds in the importing file: the alias if given, else the
# exported name.
fn local(self: ImportName) -> str { self.alias.value_or(self.name) }

# Where an unused import's caret goes. The bare `-`/`<`/`>`/`||`/`!` operator
# tokens carry no span of their own, so the import statement is pointed at
# instead — an empty span would put the caret on the file's first line, nowhere
# near the import.
fn hit_span(self: ImportName, source: ImportSource) -> Span {
    if (self.span.start != self.span.end) {
        return self.span;
    };
    match (source) {
        Path(_, span) | Builtins(span) => span,
    }
}

# Every name the file mentions outside its own import lists: called and
# referenced idents, constructed structs, match constructors, operator spellings,
# and every name appearing in a type — signatures, struct fields, variant
# payloads, and inline `let`/lambda annotations.
fn referenced_names(Program { items }) -> #{str} { items$item_names().union_all() }

# The names an item mentions: the type positions that belong to it rather than to
# any expression, and the expressions it holds.
fn item_names(self: Item) -> #{str} {
    match (self) {
        Fn(f) => #{
            ..f.sig.params$param_names().union_all(),
            ..f.sig.return_ty.optional_ty_names(),
            ..f.body.names_in(),
            ..f.test_body$names_in().value_or(#{}),
        },
        Struct(s) => s.fields.map(|field| field_names(field.ty, field.default)).union_all(),
        Variant(v) => v.cases$payload
            $map(|slot| field_names(slot.ty, slot.default))
            $union_all()
            .union_all(),
        // A constant's annotation may name an imported type; its value is a
        // literal, so it names nothing.
        Const(c) => #{..c.ty.optional_ty_names(), ..c.value.names_in()},
        Refinement(r) => r.target.ty_names(),
        Import(..) => #{},
    }
}

# The names a parameter mentions: its type, and its default.
fn param_names(self: Param) -> #{str} { field_names(self.ty, self.default) }

# The names a declared type and an optional default expression mention.
fn field_names(ty: Ty, default: Expr?) -> #{str} {
    #{..ty.ty_names(), ..default$names_in().value_or(#{})}
}

# The names `self` and every expression under it mention.
fn names_in(self: Expr) -> #{str} {
    #{..self.own_names(), ..self.subexprs()$names_in().union_all()}
}

# The names `e` itself mentions, not those of its sub-expressions.
fn own_names(self: Expr) -> #{str} {
    match (self.kind) {
        Ident(name) | Construct(name, _) | Call(name, _, _) => #{name},
        // Unary `-` is the one operator with no named builtin behind it, so it
        // stays a node; every other operator use is a `Call` on its spelling.
        Neg(..) => #{"-"},
        // A shim's name and bindings all name functions.
        Shim(effect, bindings, _) => #{effect, ..bindings$to_set().union_all()},
        Let(_, ty, _, _) | LetMut(_, ty, _, _) => ty.optional_ty_names(),
        Lambda(params, _) => params$ty$optional_ty_names().union_all(),
        Match(_, arms) => arms$pattern$ctor_names().union_all(),
        // `if (let P = e)` is one arm without the `match`; its pattern names a
        // constructor just as an arm's does.
        IfLet(arm, _, _) => arm.pattern.ctor_names(),
        Num(..)
        | Bool(..)
        | Str(..)
        | Char(..)
        | None
        | Unit
        | If(..)
        | Field(..)
        | Assign(..)
        | For(..)
        | While(..)
        | ArrayLit(..)
        | Spread(..)
        | SetLit(..)
        | DictLit(..)
        | Index(..)
        | Slice(..)
        | Try(..)
        | Seq(..)
        | Return(..)
        | TupleLit(..)
        | KwArg(..)
        | TypeArgs(..) => #{},
    }
}

# The constructors a pattern names, at any depth. A `V.A` path names the variant
# as well as the case. Written with the variant's name because `Str` and `Char`
# are also expression cases here.
fn ctor_names(self: Pat) -> #{str} {
    match (self) {
        Pat.Ctor(name, _, _) => path_names(name),
        Pat.Nested(name, args) => #{..path_names(name), ..args$ctor_names().union_all()},
        Pat.ArrayNested(patterns) | Pat.Tuple(patterns) => patterns$ctor_names().union_all(),
        Pat.Str(..)
        | Pat.Char(..)
        | Pat.Array(..)
        | Pat.ArrayRest(..)
        | Pat.Wildcard
        | Pat.Int(..) => #{},
    }
}

# The names a constructor written `name` mentions: the name, and the variant too
# when it is qualified.
fn path_names(name: str) -> #{str} {
    match (name.split(".")) {
        [part, ..] => #{part, name},
        _ => #{name},
    }
}

# The names an annotation mentions, none when it was not written.
fn optional_ty_names(self: Ty?) -> #{str} { self$ty_names().value_or(#{}) }

# Every name `self` mentions, so an import used only in a type position still
# counts as used. Variants are spelled out rather than wildcarded so a new `Ty`
# forces a decision here.
fn ty_names(self: Ty) -> #{str} {
    match (self) {
        Named(name) => #{name},
        // `Case<V>` mentions `V`, so importing a variant to name one of its cases
        // counts as using the import.
        Case(inner)
        | Optional(inner)
        | TyArray(inner)
        | TySet(inner, _)
        | Without(inner, _) => inner.ty_names(),
        // A type parameter is bound by the signature, not imported.
        TypeVar(..) | TyUnit | Primitive(..) | Any => #{},
        Generic(base, args) => #{base, ..args$ty_names().union_all()},
        Dict(a, b) | Result(a, b) => #{..a.ty_names(), ..b.ty_names()},
        TyFn(params, ret) => #{..params$ty_names().union_all(), ..ret.ty_names()},
        TyTuple(elements) => elements$ty_names().union_all(),
    }
}

fn dead_names(src: str) -> str[]!ParseFailure {
    ok(unused_imports(aipl_parse_file(src)?.program)$message)
}.test({
    // Each unused name is reported, and a used one is not.
    assert(dead_names("""
        import { filter, len, map } from builtins;
        fn f(xs: i64[]) -> i64 { xs.map(|x| x).len() }
    """)? == [unused_message("filter")]);

    // The caret goes under the name in the import list.
    let src = "import { map, filter } from builtins;\nfn f() { }";
    assert(unused_imports(aipl_parse_file(src)?.program)$span == [9..12, 14..20]);

    // An alias is the local name: the operator is used, the exported name is not.
    assert(dead_names("""
        import { equal as ==, less_than as < } from builtins;
        fn f(a: i64) -> bool { a == 1 }
    """)? == [unused_message("<")]);

    // A type position counts, in a signature, a field, a variant payload, an
    // annotation and a nested type.
    assert(dead_names("""
        import { Span } from builtins;
        import { A, B, C, D, E } from "./other.aipl";
        struct S { a: A[] }
        variant V = X(B?)
        fn f(s: S) -> (C, Span) { let d: D = g(); s }
    """)? == [unused_message("E")]);

    // A match arm's constructor, qualified or not, and a pattern in `if let`.
    assert(dead_names("""
        import { Q, R, some } from "./other.aipl";
        fn f(x: i64) -> i64 {
            if (let some(v) = x) { v } else { match (x) { Q.Z => 1, _ => 2 } }
        }
    """)? == [unused_message("R")]);

    // A constructor inside another pattern counts, however deep.
    assert(dead_names("""
        import { A, B, C, D } from "./other.aipl";
        fn f(x: i64) -> i64 { match (x) { A(B(_), C(_)) => 1, _ => 2 } }
    """)? == [unused_message("D")]);

    // A shim names the functions it binds, and a struct literal the struct.
    assert(dead_names("""
        import { P, hook, other } from "./other.aipl";
        fn f() { shim prints { print = hook } { P { x: 1 } }; }
    """)? == [unused_message("other")]);
})
