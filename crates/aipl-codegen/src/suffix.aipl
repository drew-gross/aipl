# One postfix step of AIPL's syntax tree and what applying it to a receiver
# means. One of the files the AST is declared across; see `ast.aipl`.

import { Span, equal as == } from builtins;
import {
    Call,
    Construct,
    Expr,
    Field as FieldExpr,
    FieldInit,
    Index as IndexExpr,
    Slice,
    Try as TryExpr,
    TypeArgs,
    at,
    ident,
    num,
    show_expr,
} from "./expr.aipl";
import { Ty, Unit as UnitTy } from "./ty.aipl";

# One postfix step, before it has a receiver to apply to. `postfix` is an atom
# followed by a run of these, and a `suffix` on its own is not an expression —
# which is why it needs a shape of its own rather than an `Expr`.
#
# A tuple index is a `Field`: `p.0` is the field named `_0`, which is how the
# AST spells it and why nothing downstream has to know tuples have a second
# syntax for their fields.
variant Suffix =
    | Field(str)
    | Method(name: str, args: Expr[])
    | MethodTyped(name: str, tys: Ty[], args: Expr[])
    | Index(Expr)
    | Index2(Expr, Expr)
    | SliceFrom(Expr)
    | SliceTo(Expr)
    | Try

# One postfix step, given the receiver it applies to. A method call folds the
# receiver in as `args[0]` and flags the method form, so `recv.f(a)` is stored
# exactly as the free call `f(recv, a)`.
pub fn apply_suffix(recv: Expr, suf: Suffix, span: Span) -> Expr {
    match (suf) {
        Field(name) => at(FieldExpr(recv, name), span),
        Method(name, args) => at(Call(name, [recv, ..args], true), span),
        MethodTyped(name, tys, args) => at(
            TypeArgs(at(Call(name, [recv, ..args], true), span), tys),
            span,
        ),
        Index(index) => index_or_slice(recv, index, span),
        // `recv[row, column]` reads one cell of a grid; the builtin answers `none` off the grid.
        Index2(row, column) => at(Call("__builtin_grid_get", [recv, row, column], false), span),
        SliceFrom(lo) => at(Slice(recv, lo, none), span),
        // `recv[..end]` is `recv[0..end]`: the start clamps to `[0, len]`
        // regardless, so a synthetic `0` is the whole difference.
        SliceTo(hi) => at(Slice(recv, num(0), some(hi)), span),
        Try => at(TryExpr(recv), span),
    }
}.test({
    let p = ident("p");
    assert(apply_suffix(p, Field("x"), 0..0).show_expr() == "p.x");
    assert(apply_suffix(p, Method("f", [num(1)]), 0..0).show_expr() == "p.f(1)");
    assert(
        apply_suffix(
            p,
            MethodTyped("f", [UnitTy], [num(1)]),
            0..0,
        ).show_expr() == "TypeArgs(p.f(1), [()])",
    );
    assert(apply_suffix(p, Index(num(1)), 0..0).show_expr() == "Index(p, 1)");
    assert(
        apply_suffix(p, Index2(num(1), num(2)), 0..0).show_expr() == "__builtin_grid_get(p, 1, 2)",
    );
    assert(apply_suffix(p, SliceFrom(num(1)), 0..0).show_expr() == "Slice(p, 1, )");
    assert(apply_suffix(p, SliceTo(num(2)), 0..0).show_expr() == "Slice(p, 0, 2)");
    assert(apply_suffix(p, Try, 0..0).show_expr() == "Try(p)");
    // A range literal written as an index is the closed slice form.
    let range = at(
        Construct(
            "__builtin_Span",
            [FieldInit { name: "start", value: num(1) }, FieldInit { name: "end", value: num(2) }],
        ),
        0..0,
    );
    assert(apply_suffix(p, Index(range), 0..0).show_expr() == "Slice(p, 1, 2)");
})

# `recv[a..b]` — a range literal written *as* an index is the closed slice form,
# folded straight into a `Slice` rather than constructing a `Span` only to
# unpack it at runtime. A range that arrives as a *value* (`recv[s]`, a call
# result) stays an index and takes the `Span`-index sugar path instead.
fn index_or_slice(recv: Expr, index: Expr, span: Span) -> Expr {
    match (index.range_bounds()) {
        some(b) => at(Slice(recv, b.0, some(b.1)), span),
        none => at(IndexExpr(recv, index), span),
    }
}

# The two ends of `self`, if it is the `Span` construct a range desugars to.
fn range_bounds(self: Expr) -> (Expr, Expr)? {
    if (let Construct(name, inits) = self.kind) {
        if (name == "__builtin_Span") {
            return two_values(inits);
        };
    };
    none
}

fn two_values(self: FieldInit[]) -> (Expr, Expr)? {
    match (self) {
        [a, b] => some((a.value, b.value)),
        _ => none,
    }
}
