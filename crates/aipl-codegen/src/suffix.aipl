# One postfix step of AIPL's syntax tree and what applying it to a receiver
# means. One of the files the AST is declared across; see `ast.aipl`.

import { Span, equal as == } from builtins;
import { Unresolved } from "./builtin_table.aipl";
import {
    Call,
    Expr,
    Field as FieldExpr,
    FieldProjection,
    Index as IndexExpr,
    MethodProjection,
    Range,
    Slice,
    Try as TryExpr,
    TypeArgs,
    at,
    ident,
    named_at,
    num,
    show_expr,
} from "./expr.aipl";
import { SpanStr } from "./lexer.aipl";
import { Ty, Unit as UnitTy } from "./ty.aipl";

# One postfix step, before it has a receiver to apply to. `postfix` is an atom
# followed by a run of these, and a `suffix` on its own is not an expression —
# which is why it needs a shape of its own rather than an `Expr`.
#
# A tuple index is a `Field`: `p.0` is the field named `_0`, which is how the
# AST spells it and why nothing downstream has to know tuples have a second
# syntax for their fields.
variant Suffix =
    | Field(SpanStr)
    | Method(name: SpanStr, args: Expr[])
    | MethodTyped(name: SpanStr, tys: Ty[], args: Expr[])
    | Index(Expr)
    | Index2(Expr, Expr)
    | SliceFrom(Expr)
    | SliceTo(Expr)
    | Try
    | MapField(SpanStr)
    | MapMethod(name: SpanStr, args: Expr[])

# One postfix step, given the receiver it applies to. A method call folds the
# receiver in as `args[0]` and flags the method form, so `recv.f(a)` is stored
# exactly as the free call `f(recv, a)`.
pub fn apply_suffix(recv: Expr, suf: Suffix, span: Span) -> Expr {
    match (suf) {
        Field(name) => at(FieldExpr(recv, name.text), span).named_at(name.span),
        Method(name, args) => at(Call(name.text, [recv, ..args], true, Unresolved), span).named_at(
            name.span,
        ),
        MethodTyped(name, tys, args) => at(
            TypeArgs(
                at(Call(name.text, [recv, ..args], true, Unresolved), span).named_at(name.span),
                tys,
            ),
            span,
        ),
        Index(index) => index_or_slice(recv, index, span),
        // `recv[row, column]` reads one cell of a grid; the builtin answers `none` off the grid.
        Index2(row, column) => at(
            Call("__builtin_grid_get", [recv, row, column], false, Unresolved),
            span,
        ),
        SliceFrom(lo) => at(Slice(recv, some(lo), none), span),
        SliceTo(hi) => at(Slice(recv, none, some(hi)), span),
        Try => at(TryExpr(recv), span),
        MapField(name) => at(FieldProjection(recv, name.text), span).named_at(name.span),
        MapMethod(name, args) => at(MethodProjection(recv, name.text, args), span).named_at(
            name.span,
        ),
    }
}.test({
    let p = ident("p");
    assert(apply_suffix(p, Field(spelled("x")), 0..0).show_expr() == "p.x");
    assert(apply_suffix(p, Method(spelled("f"), [num(1)]), 0..0).show_expr() == "p.f(1)");
    assert(
        apply_suffix(
            p,
            MethodTyped(spelled("f"), [UnitTy], [num(1)]),
            0..0,
        ).show_expr() == "TypeArgs(p.f(1), [()])",
    );
    assert(apply_suffix(p, Index(num(1)), 0..0).show_expr() == "Index(p, 1)");
    assert(
        apply_suffix(p, Index2(num(1), num(2)), 0..0).show_expr() == "__builtin_grid_get(p, 1, 2)",
    );
    assert(apply_suffix(p, SliceFrom(num(1)), 0..0).show_expr() == "Slice(p, 1, )");
    assert(apply_suffix(p, SliceTo(num(2)), 0..0).show_expr() == "Slice(p, , 2)");
    assert(apply_suffix(p, Try, 0..0).show_expr() == "Try(p)");

    // `$` maps the step over the receiver: `p$x` is `p.map(|x| x.x)`, with the
    // element named by something no source can spell.
    assert(apply_suffix(p, MapField(spelled("x")), 0..0).show_expr() == "p$x");
    assert(apply_suffix(p, MapMethod(spelled("f"), [num(1)]), 0..0).show_expr() == "p$f(1)");

    // The name's own span rides on the node it names: the field in `p.x` and in
    // `p$x`, the callee in `p.f(1)`.
    let at_5 = SpanStr { text: "x", span: 5..6 };
    assert(apply_suffix(p, Field(at_5), 0..6).name_span == 5..6);
    assert(apply_suffix(p, Method(at_5, []), 0..8).name_span == 5..6);
    assert(apply_suffix(p, MapField(at_5), 0..6).name_span == 5..6);
    assert(apply_suffix(p, MapMethod(at_5, []), 0..8).name_span == 5..6);
    // A range literal written as an index is the closed slice form.
    let range = at(Range(num(1), num(2)), 0..0);
    assert(apply_suffix(p, Index(range), 0..0).show_expr() == "Slice(p, 1, 2)");
})

# A name as it would be written at no particular place — the tests' spelling.
fn spelled(text: str) -> SpanStr { text, span: 0..0 }

# `recv[a..b]` — a range literal written *as* an index is the closed slice form,
# folded straight into a `Slice` rather than constructing a `Span` only to
# unpack it at runtime. A range that arrives as a *value* (`recv[s]`, a call
# result) stays an index and takes the `Span`-index sugar path instead.
fn index_or_slice(recv: Expr, index: Expr, span: Span) -> Expr {
    match (index.range_bounds()) {
        some(b) => at(Slice(recv, some(b.0), some(b.1)), span),
        none => at(IndexExpr(recv, index), span),
    }
}

# The two ends of `self`, if it is a range.
fn range_bounds(self: Expr) -> (Expr, Expr)? {
    if (let Range(start, end) = self.kind) { some((start, end)) } else { none }
}
