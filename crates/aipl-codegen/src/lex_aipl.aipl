# A lexer for AIPL itself, built on the `lexer.aipl` library: it pins the
# library's generic `Token<K>`/`TokenRule<K>`/`lex<K>` to AIPL's own token-kind
# variant `AiplTok` and describes AIPL's tokens as a plain `TokenRule` list.

import {
    Span,
    equal as ==,
    int_parse,
    join,
    len,
    map,
    split,
    starts_with,
    to_set,
    value_or,
    value_or_err,
    wrapping_sub as -,
} from builtins;
import {
    Bare,
    Between,
    CharRun,
    Delimited,
    Exact,
    Int,
    Keyword,
    LexError,
    LexResult,
    Nested,
    Of,
    ScopeSpan,
    ToEol,
    ToEolUnless,
    Token,
    TokenRule,
    Try,
    UpToAny,
    lex,
    lex_kinds,
    lex_scoped,
    span_str,
} from "./lexer.aipl";
import { process_raw_string } from "./process_raw_string.aipl";
import { strip_test_sections } from "./strip_test_sections.aipl";
import { trim_prefix } from "./trim_prefix.aipl";
import { unescape, unescape_braces } from "./unescape.aipl";

// AIPL's token kinds — each arm is a kind, carrying that kind's content
// (`Name` its text, `IntLit` its value) or nothing. Every keyword and every
// operator/punctuation spelling is its *own* bare arm (`Fn`, `Return`, `Eq`,
// `Gt`, …) rather than a stringly-typed `Kwd(str)`/`Sym(str)` — so a consumer
// pattern-matches on the token it means, not on its text. Each spelling has its
// own one-line `TokenRule` whose `Bare` emit names that arm directly (via the
// `kw`/`op` helpers in `aipl_rules`) — so a spelling and its kind sit together
// in one rule, not split across a spelling list and a separate `match`.
//
// Note: these names deliberately avoid the library's own variant constructors
// (`Matcher`/`Emit`/`Seg`/`TokenValue`/the test `Kind`), because AIPL variant
// constructors currently share one global namespace across imported files, so a
// consumer's kinds can't reuse a library constructor's name. That's why `.` is
// `Period` here, not `Dot` (the test `Kind`'s float-dot arm already claims it),
// and why a string literal's delimiter style is `Backtick`, not the library
// `Matcher`'s `Template`.

# Every string literal — `"..."`, `"""..."""`, and an interpolation-free
# `` `...` `` / ```` ```...``` ```` template — lexes to one `StrLit` (below)
# carrying its *decoded* value and the delimiter it was written with, this
# `StrStyle`. A `Triple`/`TripleBacktick` literal's value is de-dented in the
# emit; a `Quoted`/`Backtick` one is single-line and only escape-decoded. The
# style lets the autoformatter recover the original spelling from the value.
variant StrStyle = Quoted | TripleQuoted | Backtick | TripleBacktick

variant AiplTok =
    | Space
    | LineComment
    | BlockComment
    | AllowMarker
    | DocComment(str)
    | Name(str)
    | IntLit(i64)
    | StrLit(str, StrStyle)
    | CharTok(char)
    | TplOpen(StrStyle)
    | TplText(str)
    | TplClose
    | True
    | False
    | None
    | Fn
    | Let
    | Mut
    | Set
    | Pub
    | Import
    | From
    | As
    | For
    | While
    | Match
    | Return
    | Shim
    | Struct
    | Variant
    | If
    | Else
    | Builtins
    | Without
    | EqEq
    | Ne
    | Arrow
    | FatArrow
    | AndAnd
    | OrOr
    | Pipe
    | DotDot
    | PlusPlusPlus
    | PlusPlus
    | MinusMinus
    | PlusEq
    | MinusEq
    | StarEq
    | SlashEq
    | Eq
    | Lt
    | Le
    | Gt
    | Ge
    | Bang
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Period
    | Comma
    | Colon
    | Semi
    | Question
    | Hash
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBracket
    | RBracket

# Identifier character classes: the chars that may start an identifier (letters
# and `_`) and those that may continue one (adds digits). A keyword rule uses
# the continue class as its boundary, so `if` doesn't bite the front off `iffy`
# (see `kw`), and the identifier rule uses both (see `aipl_rules`).
# A doc comment's text: the line past its `#`, with one optional space of
# separation removed. `# text` and `#text` carry the same `text`, and a bare
# `#` an empty line — so a doc block's blank lines survive as blank lines.
fn doc_text(line: str) -> AiplTok { DocComment(doc_line_value(line)) }

# The same, as a function a consumer can reach. A parser `build` is handed the
# source and a span rather than the token, so it has to strip the marker for
# itself — and it strips it here, beside the rule, so the two answers cannot
# drift. Same arrangement as `str_lit_value`.
pub fn doc_line_value(line: str) -> str { line.trim_prefix('#').trim_prefix(' ') }.test({
    assert(doc_line_value("# text") == "text");
    assert(doc_line_value("#text") == "text");

    // A bare `#` is an empty line, which is what lets a doc block have
    // paragraphs.
    assert(doc_line_value("#") == "");

    // Only *one* space of separation is removed, so an indented continuation
    // keeps its indent.
    assert(doc_line_value("#   indented") == "  indented");
    // And it is the answer the lexer's own rule gives.
    let src = "# hi";
    assert(lex_aipl_kinds(src)? == [DocComment(doc_line_value(src))]);
})

# The identifier character classes. Constants rather than functions: a literal
# `to_set()` folds to the four words of the `#{char}` bitfield, and a constant is
# spliced into each use already built — so asking for one costs four immediate
# stores wherever it appears, and the class is built once per program rather than
# once per `lex` (let alone once per keyword rule, which is what it cost when
# `kw` asked for its own).
pub let IDENT_START: #{char} = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".to_set();

pub let IDENT_CONT: #{char} = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".to_set();

# One keyword/constant rule: match the exact `spelling` at an identifier
# boundary (so `fn`/`true` don't split `fnord`/`trueish`) and emit the fixed
# `kind`. Every keyword and constant is a single `kw` call in `aipl_rules`, so
# the spelling and its `AiplTok` arm are named together — no spelling→arm
# `match` to keep in sync with a separate spelling list.
fn kw(spelling: str, kind: AiplTok, scope: str) -> TokenRule<AiplTok> {
    matcher: Keyword(spelling, IDENT_CONT),
    emit: Bare(kind),
    scope,
}

# One operator/punctuation rule: match the exact `spelling` (no identifier
# boundary) and emit the fixed `kind`. Each `op` is one rule matching one
# spelling, and rules are first-match-wins — so `aipl_rules` lists the `op`
# rules longest spelling first (`==` before `=`) to keep maximal munch.
fn op(spelling: str, kind: AiplTok, scope: str) -> TokenRule<AiplTok> {
    matcher: Exact(spelling),
    emit: Bare(kind),
    scope,
}

# The text emit for a `` `...` `` template's segments: the `UpToAny` matcher
# hands the segment's *raw* text, and this decodes its escapes (`` \` ``/`\n`/…
# as in the `escapes` set below, plus the template's own `\{`/`\}`) with
# `unescape`, exactly as the `"..."` emit does.
fn tpl_text(text: str) -> AiplTok { TplText(text.unescape()) }

# The same for a ```` ```...``` ```` template's segments, whose delimiter scans
# verbatim: a lone `` ` `` or any other backslash inside is content, so only the
# template's own `\{`/`\}` are decoded.
#
# **The text is not de-dented here.** A raw template's indent is common to the
# whole literal, so de-denting is a operation over every segment at once — and a
# lexer reading one token at a time never holds them all. The parser's lowering
# does it, over the segments it has just collected, which is also where the CST
# path already did it (`template_segments`): one implementation instead of two.
fn raw_tpl_text(text: str) -> AiplTok { TplText(text.unescape_braces()) }

# Build an `IntLit` from a matched integer run (an optional leading `-` then
# digits). The `Int` matcher only claims the run; parsing is the caller's job, so
# this parses it — sign and all — with the `int_parse` builtin and, as a fallible
# `Try` emit, reports an i64 overflow as an error message — the library attaches
# the literal's span. Parsing policy lives here, in the consumer, not the library.
# `int_parse`'s `none` becomes that message via `value_or_err`, and `?` hands it
# straight back as this emit's `err`.
fn int_lit(text: str) -> AiplTok!str {
    ok(IntLit(text.int_parse().value_or_err("integer literal overflows i64")?))
}

# Decode and validate a single-quote literal. This is where AIPL *defines* what
# a char literal is: the `Delimited("'", ..)` matcher (the same escape-aware
# scan `"..."` strings use) just hands over the un-decoded text between the
# quotes, and this emit unescapes it and requires exactly one char — so an empty
# (`''`) or multi-char (`'ab'`, `'multiple'`) literal is a hard error. As a
# `Try` emit the library pairs the message with the *whole* literal's span,
# so the caret underlines the entire bad token. Unknown escapes and unterminated
# literals are caught earlier, by the matcher's own scan (its `escapes` set).
fn char_lit_emit(text: str) -> AiplTok!str {
    match (text.unescape()) {
        [] => err("empty char literal"),
        [c] => ok(CharTok(c)),
        _ => err("char literal must contain exactly one character"),
    }
}

# The value of a string literal written exactly as it sits in the source,
# delimiters included — `"a\nb"`, `"""..."""`, `` `hi` ``, ```` ```hi``` ````.
#
# The rules above never need this: their matchers hand the emit the text
# *between* the delimiters, already stripped. A parser `build` does, because all
# it is given is the source and a span — so this is where stripping and decoding
# are stated for a consumer that has the whole literal.
#
# It lives here, beside the rules, rather than in the parser, so the two answers
# cannot drift; the assertions below feed this function's answer straight into
# the token the lexer is expected to produce, which is what makes them one claim
# rather than two.
pub fn str_lit_value(text: str) -> str {
    if (text.starts_with("```")) {
        // A raw template: de-dented like a raw string, then the one escape a
        // template always has, its braces, decoded — the order the rule's
        // `finalize` and emit take.
        return process_raw_string(text[3..text.len() - 3]).unescape_braces();
    };
    if (text.starts_with(`"""`)) {
        return process_raw_string(text[3..text.len() - 3]);
    };
    text[1..text.len() - 1].unescape()
}.test({
    // A `"..."` literal: escapes decoded, nothing else.
    let q = `"a\\nb"`;
    assert(str_lit_value(q) == "a\nb");
    assert(lex_aipl_kinds(q)? == [StrLit(str_lit_value(q), Quoted)]);

    // A `"""..."""` literal: verbatim contents, de-dented as a block.
    let raw = `"""a"b"""`;
    assert(str_lit_value(raw) == `a"b`);
    assert(lex_aipl_kinds(raw)? == [StrLit(str_lit_value(raw), TripleQuoted)]);

    // A backtick literal, whose value this still answers for — the *whole*
    // literal, delimiters and all, which is what a parser holds when it has a
    // template's span. It no longer lexes to a `StrLit`: a template is a run of
    // tokens now, however few interpolations it has (see `aipl_rules`).
    let tpl = "`hi`";
    assert(str_lit_value(tpl) == "hi");

    let raw_tpl = "```a`b```";
    assert(str_lit_value(raw_tpl) == "a`b");

    // A raw template decodes exactly `\{` and `\}`; every other backslash is
    // content. A `"""` string decodes nothing at all.
    let braced = """```a\{b\}\n```""";
    assert(str_lit_value(braced) == """a{b}\n""");
    assert(str_lit_value(`"""a\\\{b"""`) == """a\{b""");
    assert(str_lit_value("""`\{\}`""") == "{}");

    // The empty literal, where the strip has nothing left to take.
    assert(str_lit_value(`""`) == "");
})

# The `char` a char literal written as `text` denotes, delimiters included, or
# `none` when it holds anything but exactly one character. The `none` is
# unreachable from a lexed source — `char_lit_emit` refuses `''` and `'ab'` at
# lex time — and is here so a consumer never has to assume that.
pub fn char_lit_value(text: str) -> char? {
    match (text[1..text.len() - 1].unescape()) {
        [c] => some(c),
        _ => none,
    }
}.test({
    assert(char_lit_value("'x'") == some('x'));
    assert(char_lit_value("""'\n'""") == some('\n'));
    assert(char_lit_value("""'\''""") == some('\''));
    let c = "'q'";
    assert(lex_aipl_kinds(c)? == [CharTok(char_lit_value(c).value_or('?'))]);

    // The shapes the lexer refuses, which is why this returns an optional.
    assert(char_lit_value("''") == none);
    assert(char_lit_value("'ab'") == none);
})

# A template's text segments, as written, decoded into their values.
#
# The cooked `` `...` `` form decodes each segment's escapes on its own. The raw
# ```` ```...``` ```` form decodes only the braces — every other backslash is
# content — and is then de-dented across *all* its segments at once: the common
# indent is a property of the whole literal, not of any one piece, so no segment
# can be read on its own. They are joined by a `{` (which cannot occur in a raw
# segment unescaped — it would have opened an interpolation), de-dented as one
# block by the dogfooded `process_raw_string`, split back, and only then
# brace-decoded. The join uses the literal's own delimiter, which is the one
# string a raw segment provably cannot hold — it would have closed the
# literal — where a `{` would split an escaped `\{` down the middle.
#
# That whole-literal step is why the lexer leaves raw segments as written and
# this runs in the parser's lowering, the one place a whole template is in hand.
# It used to run in both: once here off the token texts, and once in the lexer's
# `finalize` hook off the segments — two implementations of one rule.
pub fn template_segments(raw: bool, texts: str[]) -> str[] {
    if (raw) {
        return process_raw_string(texts.join(sep="```")).split("```").map(unescape_braces);
    };
    texts.map(unescape)
}.test({
    // The cooked form decodes each segment's own escapes.
    assert(template_segments(false, ["a\nb", "c"]) == ["a\nb", "c"]);
    assert(template_segments(false, ["""a\nb"""]) == ["a\nb"]);

    // The raw form decodes exactly `\{` and `\}`; every other backslash stays.
    assert(template_segments(true, ["""a\nb""", """c\{d\}"""]) == ["""a\nb""", "c{d}"]);

    // The shared indent comes off the literal's lines *together*, which is the
    // whole reason this is one call over every segment rather than one per
    // segment: the second segment's indent is shed because the *first*
    // segment's line established it.
    assert(template_segments(true, ["\n    a", "\n    b\n"]) == ["a", "\nb"]);
    // Segments sharing a line are one line: only its leading indent goes.
    assert(template_segments(true, ["  a", "  b"]) == ["a", "  b"]);
    // Nothing to shed, and the single-segment case.
    assert(template_segments(true, ["a", "b"]) == ["a", "b"]);
    assert(template_segments(true, ["one"]) == ["one"]);
})

# The AIPL rule set. Order is priority (the first matching rule wins): skipped
# whitespace and recorded comments/markers first; then every keyword and
# constant (each its own `kw` rule) before the identifier rule, so `fn` isn't
# swallowed as a `Name`; then numbers, strings, char literals, and templates;
# and finally the operator/punctuation rules — each spelling its own `op` rule,
# listed longest first so first-match-wins still yields maximal munch (`==`
# before `=`), since separate rules don't get `Exact`'s automatic longest-match.
# The TextMate scopes AIPL's tokens are painted with, named once here so the
# rule table below reads as spelling/kind/scope triples and
# `editors/vscode/syntaxes/aipl.tmLanguage.json` — generated from this table by
# `highlight_aipl.aipl` — cannot disagree with it. These are TextMate's
# conventional names, which is what lets an editor theme colour AIPL without
# knowing anything about AIPL.
let S_KEYWORD = "keyword.control.aipl";

let S_CONSTANT = "constant.language.aipl";

# `import`/`from`/`as` are keywords like any other, but scoped as the
# import-statement family so a theme can colour a module header on its own.
# They are consecutive in the table below, so they come out of the highlighter
# generator as one alternation between the two halves of the keyword run.
let S_IMPORT = "keyword.control.import.aipl";

let S_NAME = "variable.other.aipl";

let S_NUMBER = "constant.numeric.integer.aipl";

# The lexer modes AIPL needs, as the `i64` tags `TokenRule.mode`/`push` take.
# `M_BASE` is the mode a lex starts in — ordinary AIPL — and is named rather than
# written as `0` because a template's `{` *pushes* it, which is how an
# interpolation gets the whole language back.
let M_BASE: i64 = 0;

# Inside a `` `...` `` template, between its delimiters and around its
# interpolations.
let M_TEMPLATE: i64 = 1;

# The same for a ```` ```...``` ```` template, whose text scans verbatim.
let M_RAW_TEMPLATE: i64 = 2;

pub let S_STRING = "string.quoted.double.aipl";

let S_CHAR = "string.quoted.single.aipl";

let S_OPERATOR = "keyword.operator.aipl";

pub let S_PUNCT = "punctuation.aipl";

# A doc comment is documentation, not an aside — a highlighter paints it like a
# doc string rather than like a `//` comment, which is what every editor theme
# already distinguishes.
let S_DOC = "comment.line.documentation.aipl";

pub fn aipl_rules() -> TokenRule<AiplTok>[] {
    [
        TokenRule { matcher: CharRun(" \t\n\r".to_set()), emit: Bare(Space), skip: true },
        TokenRule {
            matcher: ToEol("//"),
            emit: Bare(LineComment),
            trivia: true,
            scope: "comment.line.double-slash.aipl",
        },
        // Block comments `/* ... */`, recorded as trivia like line comments.
        // `Nested` is depth-tracked (an inner `/* */` doesn't close the outer),
        // matching the Rust lexer, and reports an unterminated comment as a hard
        // error spanning the open `/*` to EOF. Must precede the `/` operator, or
        // `op("/", …)` would bite off the leading slash as a `Slash`.
        TokenRule {
            matcher: Nested("/*", "*/"),
            emit: Bare(BlockComment),
            trivia: true,
            unterminated: "unterminated block comment",
            scope: "comment.block.aipl",
        },
        // `#[allow]` is the lint-squelch marker: like the Rust lexer, it's
        // recorded as trivia and kept out of the token stream, not lexed as a
        // `#` (`Hash`) token. It must precede the `#` operator (whose one-char
        // spelling would otherwise claim the lead); the exact-8-char match means
        // a `#{` dict prefix or a `#[` that isn't `#[allow]` still falls through
        // to `Hash` + `LBracket`, matching the real lexer.
        TokenRule {
            matcher: Exact("#[allow]"),
            emit: Bare(AllowMarker),
            trivia: true,
            scope: "comment.line.allow.aipl",
        },
        // `# text` — a doc comment, and a real token rather than trivia: the
        // grammar accepts one only in front of a declaration, so a `#` anywhere
        // else is a syntax error rather than something silently ignored. That
        // is what keeps the `////////` section banners people write inside a
        // function working — those are `//` comments and stay trivia.
        //
        // `#` also leads a set/dict literal (`#{..}`), an ordered set's
        // `#>{..}` / `#<{..}`, and the `#[allow]` marker above, so the matcher
        // declines those leads and they fall through to the rules that want them.
        TokenRule { matcher: ToEolUnless("#", "{[<>".to_set()), emit: Of(doc_text), scope: S_DOC },
        // Keywords and constants, each its own `kw` rule (identifier-boundary
        // matched, so `iffy`/`noneish` stay `Name`s). Order among them is
        // immaterial — the spellings are disjoint — but all must precede the
        // identifier rule. Constants (`true`/`false`/`none`) get their own kinds,
        // a distinct category from keywords, mirroring the Rust lexer.
        kw("fn", Fn, S_KEYWORD),
        kw("let", Let, S_KEYWORD),
        kw("mut", Mut, S_KEYWORD),
        kw("set", Set, S_KEYWORD),
        kw("pub", Pub, S_KEYWORD),
        kw("import", Import, S_IMPORT),
        kw("from", From, S_IMPORT),
        kw("as", As, S_IMPORT),
        kw("for", For, S_KEYWORD),
        kw("while", While, S_KEYWORD),
        kw("match", Match, S_KEYWORD),
        kw("return", Return, S_KEYWORD),
        kw("shim", Shim, S_KEYWORD),
        kw("struct", Struct, S_KEYWORD),
        kw("variant", Variant, S_KEYWORD),
        kw("if", If, S_KEYWORD),
        kw("else", Else, S_KEYWORD),
        kw("builtins", Builtins, S_KEYWORD),
        kw("without", Without, S_KEYWORD),
        kw("true", True, S_CONSTANT),
        kw("false", False, S_CONSTANT),
        kw("none", None, S_CONSTANT),
        TokenRule {
            matcher: CharRun(IDENT_CONT, first=IDENT_START),
            emit: Of(Name),
            scope: S_NAME,
        },
        // Integer literals, signed or unsigned: `Int` matches a digit run with an
        // optional leading `-`, and `int_lit` parses the whole thing (so `-123` is
        // one token and the full i64 range is reachable — i64::MIN's magnitude a
        // bare digit run can't spell as a positive literal). The `-` is consumed
        // only when a digit *immediately* follows, so `Int` declines on `- ` and
        // `-x` and `op("-", Minus, ..)` below claims those (subtraction / unary minus).
        // Placing `Int` before that operator rule is the whole disambiguation.
        // Consequence: a value minus a number must be spaced (`a - 5`); `a-5` lexes
        // `a` then the literal `-5`.
        TokenRule { matcher: Int, emit: Try(int_lit), scope: S_NUMBER },
        // Raw strings before the plain string rule: `Between` declines (length 0)
        // unless the source opens with `"""`, so a single `"` still falls through
        // to `Delimited` — but a `"""` is claimed here as one raw token rather
        // than an empty `""` plus a stray `"`. Its contents are verbatim (no
        // escapes), but a `"""` literal *is* de-dented — done here in the emit via
        // the dogfooded `process_raw_string`, so the token carries its final value.
        TokenRule {
            matcher: Between(`"""`, `"""`),
            emit: Of(|text: str| StrLit(process_raw_string(text), TripleQuoted)),
            unterminated: "unterminated raw string literal",
            scope: S_STRING,
        },
        TokenRule {
            matcher: Delimited(`"`.to_set(), escaped=`ntr\\"`.to_set()),
            emit: Of(|text: str| StrLit(text.unescape(), Quoted)),
            unterminated: "unterminated string literal",
            scope: S_STRING,
        },
        // Char literals `'x'`/`'\n'`: lexed exactly like a `"..."` string but
        // single-quoted — a `Delimited("'", ..)` scan (escape-aware, so `'\''`
        // and `'\n'` work and an escaped quote doesn't close early) hands the
        // un-decoded inner text to `char_lit_emit`, which decodes it and enforces
        // the one-char shape. Defining "what a char literal is" thus lives here in
        // the consumer, not in a dedicated library matcher; the kind is `CharTok`
        // (not `Char`) to avoid the library test `Kind`'s arm (shared constructor
        // namespace). The escape set matches the string rule plus `\'`.
        TokenRule {
            matcher: Delimited("'".to_set(), escaped=`ntr\\'"`.to_set()),
            emit: Try(char_lit_emit),
            unterminated: "unterminated char literal",
            scope: S_CHAR,
        },
        // Template literals, as ordinary rules over the lexer's mode stack —
        // an opener that pushes a template mode, a closer that pops it, a `{`
        // that re-enters the *base* rules for the interpolation, and a text run
        // up to whichever of those comes first. Nothing here knows what a
        // template is; `lexer.aipl` has no idea either.
        //
        // Triple-backtick before single, so ``` ``` ``` is claimed whole before
        // the single ``` ` ``` rule bites off its first backtick — the same
        // longest-delimiter-first ordering the raw/plain string rules use. The
        // raw form's text scans verbatim; the single form decodes the same
        // escapes as a string plus `` \` ``. Both recognise `\{` and `\}`,
        // which every template has of its own — the one escape a raw template
        // decodes.
        //
        // The text rules come last of each mode's three: `UpToAny` declines at a
        // stop, so an empty segment emits no token at all and the rule matching
        // the terminator wins there.
        // None of the six carries a `scope`. A TextMate grammar nests with
        // begin/end regions rather than with a mode stack, so these rules have
        // no faithful translation — a bare backtick painted as a string would be
        // wrong wherever one is content. `highlight_aipl.aipl` writes the
        // template region by hand instead, which is where that policy belongs.
        TokenRule {
            matcher: Exact("```"),
            emit: Bare(TplOpen(TripleBacktick)),
            unterminated: "unterminated triple-backtick template literal",
            push: M_RAW_TEMPLATE,
        },
        TokenRule {
            matcher: Exact("`"),
            emit: Bare(TplOpen(Backtick)),
            unterminated: "unterminated template literal",
            push: M_TEMPLATE,
        },
        TokenRule { matcher: Exact("```"), emit: Bare(TplClose), mode: M_RAW_TEMPLATE, pop: true },
        TokenRule { matcher: Exact("{"), emit: Bare(LBrace), mode: M_RAW_TEMPLATE, push: M_BASE },
        TokenRule {
            matcher: UpToAny(["```", "{"], "{}".to_set(), refuse_unknown_escape=false),
            emit: Of(raw_tpl_text),
            mode: M_RAW_TEMPLATE,
        },
        TokenRule { matcher: Exact("`"), emit: Bare(TplClose), mode: M_TEMPLATE, pop: true },
        TokenRule { matcher: Exact("{"), emit: Bare(LBrace), mode: M_TEMPLATE, push: M_BASE },
        TokenRule {
            matcher: UpToAny(["`", "{"], """\`ntr{}""".to_set()),
            emit: Of(tpl_text),
            mode: M_TEMPLATE,
        },
        // Operators and punctuation, one `op` rule per spelling, longest first so
        // first-match-wins is maximal munch: the three-char `+++`, then the
        // two-char forms (`==`/`=>` before `=`, `<=`/`>=` before `<`/`>`, `++`
        // before `+`, `||` before `|`, `..` before `.`), then the one-char rest.
        op("+++", PlusPlusPlus, S_OPERATOR),
        op("==", EqEq, S_OPERATOR),
        op("!=", Ne, S_OPERATOR),
        op("->", Arrow, S_OPERATOR),
        op("=>", FatArrow, S_OPERATOR),
        op("&&", AndAnd, S_OPERATOR),
        op("||", OrOr, S_OPERATOR),
        op("..", DotDot, S_OPERATOR),
        op("++", PlusPlus, S_OPERATOR),
        // `--` sits with `++` and, like `-=`, needs no care against `Int`: that
        // matcher takes a `-` only when a *digit* follows it, and here the next
        // character is another `-`. It does mean `a--5` lexes `a`, `--`, `5`
        // where it once lexed `a` then the literal `-5` — the same spacing rule
        // `a - 5` already had.
        op("--", MinusMinus, S_OPERATOR),
        // The compound assignments, each before both the plain operator it
        // accumulates with and the `=` that follows it: `+=` would otherwise
        // lex as `+` then `=`. `-=` needs no such care against `Int` — that
        // matcher takes a `-` only when a *digit* follows it.
        op("+=", PlusEq, S_OPERATOR),
        op("-=", MinusEq, S_OPERATOR),
        op("*=", StarEq, S_OPERATOR),
        op("/=", SlashEq, S_OPERATOR),
        op("<=", Le, S_OPERATOR),
        op(">=", Ge, S_OPERATOR),
        op("=", Eq, S_OPERATOR),
        op("<", Lt, S_OPERATOR),
        op(">", Gt, S_OPERATOR),
        op("!", Bang, S_OPERATOR),
        op("+", Plus, S_OPERATOR),
        op("-", Minus, S_OPERATOR),
        op("*", Star, S_OPERATOR),
        op("/", Slash, S_OPERATOR),
        op("%", Percent, S_OPERATOR),
        op("|", Pipe, S_OPERATOR),
        op(".", Period, S_PUNCT),
        op(",", Comma, S_PUNCT),
        op(":", Colon, S_PUNCT),
        op(";", Semi, S_PUNCT),
        op("?", Question, S_PUNCT),
        op("#", Hash, S_PUNCT),
        op("(", LParen, S_PUNCT),
        op(")", RParen, S_PUNCT),
        // A brace pushes and pops the base mode wherever it appears, not just in
        // a template. That is what makes a block, a set literal or a struct
        // *inside* an interpolation close itself rather than the interpolation:
        // the `}` that pops back into the template mode is the one whose `{`
        // pushed from it. A push/pop pair at the base is otherwise inert.
        TokenRule { matcher: Exact("{"), emit: Bare(LBrace), scope: S_PUNCT, push: M_BASE },
        TokenRule { matcher: Exact("}"), emit: Bare(RBrace), scope: S_PUNCT, pop: true },
        op("[", LBracket, S_PUNCT),
        op("]", RBracket, S_PUNCT),
    ]
}

# Lex AIPL source into typed `AiplTok` tokens (plus the trivia side-channel:
# comments and `#[allow]` markers; whitespace is skipped outright). This is the
# compiler's dogfood entry (see `DOGFOOD_ENTRIES`): the Rust side calls it via
# the FFI and mirrors the result into its own token types.
# Test shorthand: the expected token at `span` in `src`. Like `lexer.aipl`'s
# `tok`, the text is sliced from the same source the lexer was given, so an
# expectation cannot claim text the source does not hold at that span.
fn atok(src: str, kind: AiplTok, span: Span) -> Token<AiplTok> { kind, text: span_str(src, span) }

# `lex_aipl` without the spans or the trivia — every token's kind, and a bare
# message on failure. Most of this file's assertions are about *which tokens* a
# snippet lexes to, and this is that question asked directly; the ones that are
# about spans, or about the trivia side-channel, still use `lex_aipl`.
#
# Not `pub`: a consumer wanting it writes `lex_kinds(src, aipl_rules())`, which
# is what this is. It exists so the tests below read as what they check.
fn lex_aipl_kinds(src: str) -> AiplTok[]!str { lex_kinds(src, aipl_rules()) }

pub fn lex_aipl(src: str) -> LexResult<AiplTok>!LexError { lex(src, aipl_rules()) }.test({
    // A small snippet exercising several kinds; a fuller suite comes with the
    // real grammar. `let x = 42;` plus a trailing line comment (trivia).
    let src = "let x = 42; // note";
    assert(lex_aipl(src)? == LexResult {
        tokens: [
            atok(src, Let, 0..3),
            atok(src, Name("x"), 4..5),
            atok(src, Eq, 6..7),
            atok(src, IntLit(42), 8..10),
            atok(src, Semi, 10..11),
        ],
        trivia: [atok(src, LineComment, 12..19)],
    });

    // The trivia side-channel carries every comment and `#[allow]` marker, in
    // source order, and keeps them out of the token stream; whitespace appears
    // in neither. Ported from the Rust `dogfood_lex_hook_returns_trivia` — the
    // production hook's agreement with *this* source is what
    // `dogfood_lex_hook_matches_fresh_compile_on_corpus` checks, so the claim
    // belongs beside the rules that make it true.
    let mixed = "x // c\n#[allow] /* b */ y";
    assert(lex_aipl(mixed)? == LexResult {
        tokens: [atok(mixed, Name("x"), 0..1), atok(mixed, Name("y"), 24..25)],
        trivia: [
            atok(mixed, LineComment, 2..6),
            atok(mixed, AllowMarker, 7..15),
            atok(mixed, BlockComment, 16..23),
        ],
    });

    // Keywords beyond the starter set. `builtins` is a keyword everywhere (as in
    // the Rust lexer), not just in a `from builtins;` import; `iffy` still lexes
    // as a `Name`, since the `Keyword` matcher stops at an identifier boundary.
    assert(lex_aipl_kinds("if else builtins iffy")? == [If, Else, Builtins, Name("iffy")]);

    // `without` is the type-refinement keyword (`T[] without []`); like the
    // rest it stops at an identifier boundary.
    assert(lex_aipl_kinds("i64[] without [] withoutx")? == [
        Name("i64"),
        LBracket,
        RBracket,
        Without,
        LBracket,
        RBracket,
        Name("withoutx"),
    ]);

    // The constant literals get their own kinds, distinct from keywords and from
    // identifiers. `some`/`ok`/`err` are ordinary `Name`s (constructors, not
    // constants); `noneish` stays a `Name` (identifier-boundary matched).
    assert(lex_aipl_kinds("true false none some noneish")? == [
        True,
        False,
        None,
        Name("some"),
        Name("noneish"),
    ]);

    // The rest of the operator/punctuation table: `<=`/`>=` beat `<`/`>`, `++`
    // beats `+` (but not `+++`), and `|` is the lambda delimiter. `Exact` always
    // takes the longest spelling, so the two-char forms win over their one-char
    // prefixes.
    assert(lex_aipl_kinds("a <= b >= |x| ++")? == [
        Name("a"),
        Le,
        Name("b"),
        Ge,
        Pipe,
        Name("x"),
        Pipe,
        PlusPlus,
    ]);

    // `#` disambiguation: a bare `#` (the `#{...}` dict prefix) is a `Hash` token,
    // but `#[allow]` is the lint-squelch marker — recorded as trivia and kept out
    // of the token stream, matching the Rust lexer.
    assert(lex_aipl("#{ #[allow]")? == LexResult {
        tokens: [atok("#{ #[allow]", Hash, 0..1), atok("#{ #[allow]", LBrace, 1..2)],
        trivia: [atok("#{ #[allow]", AllowMarker, 3..11)],
    });
    // The ordered-set brackets are three tokens each, not a doc comment.
    assert(lex_aipl_kinds("#>{")? == [Hash, Gt, LBrace]);
    assert(lex_aipl_kinds("#<{")? == [Hash, Lt, LBrace]);

    // Block comments are trivia, and `Nested` depth-tracks them, so the inner
    // `/* */` doesn't close the outer — the whole `/* a /* b */ c */` is one
    // comment, out of the token stream.
    assert(lex_aipl("x /* a /* b */ c */ y")? == LexResult {
        tokens: [
            atok("x /* a /* b */ c */ y", Name("x"), 0..1),
            atok("x /* a /* b */ c */ y", Name("y"), 20..21),
        ],
        trivia: [atok("x /* a /* b */ c */ y", BlockComment, 2..19)],
    });

    // An unterminated block comment is a hard error spanning the open `/*` to the
    // end of source, matching the Rust lexer.
    assert(lex_aipl("a /* never closed") == err(LexError {
        message: "unterminated block comment",
        span: 2..17,
    }));

    // A string literal with escapes: the source is `s = "a\nb"` (a literal
    // backslash-`n`, not a newline). The `StrLit` emit decodes it (with `Quoted`
    // style), so the token's
    // value carries an actual newline — escape handling lives in `str_lit`, not in
    // the lexer library.
    let esc = `s = "a\\nb"`;
    assert(lex_aipl_kinds(esc)? == [Name("s"), Eq, StrLit("a\nb", Quoted)]);

    // A raw string `"""a"b"""` (the AIPL source here is written with escaped
    // quotes). `Between` scans to the balancing `"""`, so the lone `"` inside is
    // content and no escapes are decoded; it lexes to `StrLit` with `TripleQuoted`
    // style. De-denting a single-line literal is a no-op, so the value is `a"b`.
    let raw = `"""a"b"""`;
    assert(lex_aipl(raw)? == LexResult {
        tokens: [atok(raw, StrLit(`a"b`, TripleQuoted), 0..9)],
        trivia: [],
    });

    // The empty raw string is six quotes: the opening `"""` closed at once,
    // not a `""` and a stray `""""`. (The formatter respells it `""`, so no
    // formatted source keeps this spelling — it is covered here.)
    let empty_raw = `""""""`;
    assert(lex_aipl_kinds(empty_raw)? == [StrLit("", TripleQuoted)]);

    // Char literals: an ordinary `'x'` and an escaped `'\n'` (the AIPL source
    // writes the escape as a literal backslash-`n`), each decoded to its byte.
    assert(lex_aipl_kinds("""'x' '\n'""")? == [CharTok('x'), CharTok('\n')]);

    // The one-char shape is enforced: an empty `''` is a hard error whose span
    // (the two quotes) matches the Rust lexer's `empty char literal` error.
    assert(lex_aipl("''") == err(LexError { message: "empty char literal", span: 0..2 }));

    // A multi-char literal (someone reaching for a string but typing `'...'`) is
    // rejected in `char_lit_emit`, after the `Delimited` scan grabs the whole
    // `'multiple'` between the quotes. Because the verdict comes from the emit,
    // the error spans the *entire* literal (7..17 here) — the caret underlines
    // the whole mistake, not just the opening quote and first char.
    assert(lex_aipl("oops = 'multiple'") == err(LexError {
        message: "char literal must contain exactly one character",
        span: 7..17,
    }));

    // A template with an interpolation `` `a{x}b` ``: every piece is its own
    // token, and they tile the literal. The braces are `LBrace`/`RBrace` — the
    // same tokens a block is made of — and inside them the base rules apply, so
    // `x` is an ordinary `Name`.
    let interp = "`a{x}b`";
    assert(lex_aipl_kinds(interp)? == [
        TplOpen(Backtick),
        TplText("a"),
        LBrace,
        Name("x"),
        RBrace,
        TplText("b"),
        TplClose,
    ]);

    // A template with no interpolation is the same shape with nothing between
    // the braces to have — one text token. Folding it into a `StrLit` would take
    // a matcher that declines on a `{` it has not reached yet; the parser folds
    // it instead, where the whole literal is in hand.
    let bare = "`hi`";
    assert(lex_aipl_kinds(bare)? == [TplOpen(Backtick), TplText("hi"), TplClose]);

    // A triple-backtick raw template scans verbatim, and wins over the
    // single-backtick rule (longest delimiter first).
    let raw = "```hi```";
    assert(lex_aipl_kinds(raw)? == [TplOpen(TripleBacktick), TplText("hi"), TplClose]);

    // A brace inside an interpolation closes itself, not the interpolation: its
    // `{` pushed the base mode and its `}` pops that, leaving the template mode
    // where it was. This is the depth tracking the mode stack does for free.
    assert(lex_aipl("`a{ #{1} }b`")?.tokens.len() == 10);

    // An integer that overflows i64: the `Try` emit (`int_lit`) reports it,
    // and the library attaches the literal's span. Overflow policy is the
    // consumer's — the lexer library never parses ints itself.
    assert(lex_aipl("99999999999999999999") == err(LexError {
        message: "integer literal overflows i64",
        span: 0..20,
    }));
})

# Every token's span paired with the scope AIPL's own rule set declares for it,
# with the trailing `--- section ---` harness blocks stripped first — the oracle
# the generated TextMate grammar is checked against.
#
# The grammar is derived from `aipl_rules()` (see `highlight_aipl.aipl`), so this
# asks the *same* table what each token should be painted, rather than restating
# the mapping a second time somewhere else. A test that compares the two is
# checking the generator, which is the only thing that can be wrong.
pub fn aipl_token_scopes(src: str) -> ScopeSpan[]!LexError {
    lex_scoped(strip_test_sections(src), aipl_rules())
}.test({
    // A keyword, an identifier and punctuation, each painted as its rule says.
    assert(aipl_token_scopes("fn f()")? == [
        ScopeSpan { span: 0..2, scope: S_KEYWORD },
        ScopeSpan { span: 3..4, scope: S_NAME },
        ScopeSpan { span: 4..5, scope: S_PUNCT },
        ScopeSpan { span: 5..6, scope: S_PUNCT },
    ]);

    // The harness sections go first, so a case file reports only its AIPL — and
    // the spans still index the original source.
    assert(aipl_token_scopes("fn\n--- stdout ---\nx")? == [
        ScopeSpan { span: 0..2, scope: S_KEYWORD },
    ]);
})
