// A lexer for AIPL itself, built on the `lexer.aipl` library: it pins the
// library's generic `Token<K>`/`TokenRule<K>`/`lex<K>` to AIPL's own token-kind
// variant `AiplTok` and describes AIPL's tokens as a plain `TokenRule` list.
import { &&, wrapping_add as +, +++, <, ==, int_parse, len } from builtins;
import { Emit, LexError, LexResult, Matcher, Seg, Token, TokenRule, lex } from "./lexer.aipl";
import { strip_test_sections } from "./strip_test_sections.aipl";

// AIPL's token kinds — each arm is a kind, carrying that kind's content
// (`Name` its text, `IntLit` its value) or nothing. Every keyword and every
// operator/punctuation spelling is its *own* bare arm (`Fn`, `Return`, `Eq`,
// `Gt`, …) rather than a stringly-typed `Kwd(str)`/`Sym(str)` — so a consumer
// pattern-matches on the token it means, not on its text. Each spelling has its
// own one-line `TokenRule` whose `Bare` emit names that arm directly (via the
// `kw`/`op` helpers in `aipl_rules`) — so a spelling and its kind sit together
// in one rule, not split across a spelling list and a separate `match`.
//
// Note: these names deliberately avoid the library's own variant constructors
// (`Matcher`/`Emit`/`Seg`/`TokenValue`/the test `Kind`), because AIPL variant
// constructors currently share one global namespace across imported files, so a
// consumer's kinds can't reuse a library constructor's name. That's why `.` is
// `Period` here, not `Dot` (the test `Kind`'s float-dot arm already claims it).
variant AiplTok =
    Space
    | LineComment
    | BlockComment
    | AllowMarker
    | Name(str)
    | IntLit(i64)
    | StrLit(str)
    | RawStrLit(str)
    | CharTok(char)
    | TemplateStr(str)
    | TemplateHead(str)
    | TemplateMid(str)
    | TemplateTail(str)
    | RawTemplateStr(str)
    | RawTemplateHead(str)
    | RawTemplateMid(str)
    | RawTemplateTail(str)
    | True
    | False
    | None
    | Fn
    | Let
    | Mut
    | Set
    | Pub
    | Import
    | From
    | As
    | For
    | While
    | Match
    | Return
    | Struct
    | Variant
    | If
    | Else
    | Builtins
    | EqEq
    | Ne
    | Arrow
    | FatArrow
    | AndAnd
    | OrOr
    | Pipe
    | DotDot
    | PlusPlusPlus
    | PlusPlus
    | Eq
    | Lt
    | Le
    | Gt
    | Ge
    | Bang
    | Plus
    | Minus
    | Star
    | Slash
    | Percent
    | Period
    | Comma
    | Colon
    | Semi
    | Question
    | Hash
    | LParen
    | RParen
    | LBrace
    | RBrace
    | LBracket
    | RBracket

// Identifier character classes: the chars that may start an identifier (letters
// and `_`) and those that may continue one (adds digits). A keyword rule uses
// the continue class as its boundary, so `if` doesn't bite the front off `iffy`
// (see `kw`), and the identifier rule uses both (see `aipl_rules`).
fn ident_start() -> str { "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_" }

fn ident_cont() -> str { "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789" }

// One keyword/constant rule: match the exact `spelling` at an identifier
// boundary (so `fn`/`true` don't split `fnord`/`trueish`) and emit the fixed
// `kind`. Every keyword and constant is a single `kw` call in `aipl_rules`, so
// the spelling and its `AiplTok` arm are named together — no spelling→arm
// `match` to keep in sync with a separate spelling list.
fn kw(spelling: str, kind: AiplTok) -> TokenRule<AiplTok> {
    TokenRule { matcher: Keyword(spelling, ident_cont()), emit: Bare(kind) }
}

// One operator/punctuation rule: match the exact `spelling` (no identifier
// boundary) and emit the fixed `kind`. Each `op` is one rule matching one
// spelling, and rules are first-match-wins — so `aipl_rules` lists the `op`
// rules longest spelling first (`==` before `=`) to keep maximal munch.
fn op(spelling: str, kind: AiplTok) -> TokenRule<AiplTok> {
    TokenRule { matcher: Exact(spelling), emit: Bare(kind) }
}

// AIPL's string-escape decoder. `escape_text` maps a `\X` pair's X to its meaning
// (`\n`/`\t`/`\r` to the control chars, any other `\X` — `\"`, `\\`, `` \` ``,
// `\{` — to X itself); `unescape` walks a token's raw, delimiter-stripped contents
// applying it and copying everything else verbatim in whole runs (via slicing). A
// trailing lone backslash can't reach here — the matcher already rejected the token
// as unterminated. Used by the `str_lit` and `tpl_kind` emits below.
fn escape_text(self: str) -> str {
    if (self == "n") {
        "\n"
    } else {
        if (self == "t") { "\t" } else { if (self == "r") { "\r" } else { self } }
    }
}

fn unescape(self: str) -> str {
    mut out = "";
    mut run_start = 0;
    mut i = 0;
    while (i < self.len()) {
        if (self[i] == some('\\') && i + 1 < self.len()) {
            set out = out +++ self[run_start..i] +++ self[i + 1..i + 2].escape_text();
            set i = i + 2;
            set run_start = i;
        } else {
            set i = i + 1;
        };
    }
    out +++ self[run_start..]
}

// A raw string `"""..."""` is a `Between` token, so its contents are verbatim —
// no escape decoding — and a lone `"` or `""` inside is content, not a close.
// That's why it gets its own `RawStrLit` kind rather than reusing `StrLit`: the
// two decode differently (`str_lit` unescapes, this doesn't). The value here is
// the exact bytes between the delimiters; AIPL's de-denting of a raw string
// (trimming the surrounding line breaks, stripping the common indent) is a later
// consumer pass, not part of lexing — so the emit is the bare constructor and no
// helper is needed (see `aipl_rules`).

// The `OfSeg` emit for the `` `...` `` template rule: the `Template` matcher hands
// each text segment's *raw* text plus its position (`Plain` for an
// interpolation-free literal, else `Head`/`Middle`/`Tail`), and this maps each to
// its own `AiplTok` arm — decoding the segment's escapes (`` \` ``/`\{`/`\n`/… as in
// the `escapes` set below) with `unescape`, exactly as `str_lit` does for a plain
// string. A `Plain` template folds to the same category as a string (the Rust
// lexer emits a bare `Str` for an interpolation-free template), but keeps a
// distinct kind so a consumer still sees it was written as a template.
fn tpl_kind(text: str, seg: Seg) -> AiplTok {
    let t = text.unescape();
    match (seg) {
        Plain => TemplateStr(t),
        Head => TemplateHead(t),
        Middle => TemplateMid(t),
        Tail => TemplateTail(t),
    }
}

// The `OfSeg` emit for the ```` ```...``` ```` raw-template rule: like `tpl_kind`,
// but the delimiter scans verbatim (empty `escapes`), so the segment text is not
// decoded — a lone `` ` ``/` `` ` inside is content. AIPL's de-denting of a raw
// template's combined text (as for a `"""` raw string) is a later consumer pass,
// not part of lexing, so the value here is the exact bytes.
fn raw_tpl_kind(text: str, seg: Seg) -> AiplTok {
    match (seg) {
        Plain => RawTemplateStr(text),
        Head => RawTemplateHead(text),
        Middle => RawTemplateMid(text),
        Tail => RawTemplateTail(text),
    }
}

// Build an `IntLit` from a matched digit run. The `Int` matcher only claims the
// run; parsing is the caller's job, so this parses it with the `int_parse`
// builtin and, as a fallible `TryText` emit, reports an i64 overflow as an error
// message — the library attaches the literal's span. Parsing policy lives here,
// in the consumer, not in the lexer library.
fn int_lit(text: str) -> AiplTok!str {
    match (text.int_parse()) {
        some(v) => ok(IntLit(v)),
        none => err("integer literal overflows i64"),
    }
}

// The AIPL rule set. Order is priority (the first matching rule wins): skipped
// whitespace and recorded comments/markers first; then every keyword and
// constant (each its own `kw` rule) before the identifier rule, so `fn` isn't
// swallowed as a `Name`; then numbers, strings, char literals, and templates;
// and finally the operator/punctuation rules — each spelling its own `op` rule,
// listed longest first so first-match-wins still yields maximal munch (`==`
// before `=`), since separate rules don't get `Exact`'s automatic longest-match.
fn aipl_rules() -> TokenRule<AiplTok>[] {
    let three_quotes = "\"\"\"";
    [
        TokenRule { matcher: CharRun(" \t\n\r", " \t\n\r"), emit: Bare(Space), skip: true },
        TokenRule { matcher: ToEol("//"), emit: Bare(LineComment), trivia: true },
        // Block comments `/* ... */`, recorded as trivia like line comments.
        // `Nested` is depth-tracked (an inner `/* */` doesn't close the outer),
        // matching the Rust lexer, and reports an unterminated comment as a hard
        // error spanning the open `/*` to EOF. Must precede the `/` operator, or
        // `op("/", …)` would bite off the leading slash as a `Slash`.
        TokenRule { matcher: Nested("/*", "*/"), emit: Bare(BlockComment), trivia: true },
        // `#[allow]` is the lint-squelch marker: like the Rust lexer, it's
        // recorded as trivia and kept out of the token stream, not lexed as a
        // `#` (`Hash`) token. It must precede the `#` operator (whose one-char
        // spelling would otherwise claim the lead); the exact-8-char match means
        // a `#{` dict prefix or a `#[` that isn't `#[allow]` still falls through
        // to `Hash` + `LBracket`, matching the real lexer.
        TokenRule { matcher: Exact("#[allow]"), emit: Bare(AllowMarker), trivia: true },
        // Keywords and constants, each its own `kw` rule (identifier-boundary
        // matched, so `iffy`/`noneish` stay `Name`s). Order among them is
        // immaterial — the spellings are disjoint — but all must precede the
        // identifier rule. Constants (`true`/`false`/`none`) get their own kinds,
        // a distinct category from keywords, mirroring the Rust lexer.
        kw("fn", Fn),
        kw("let", Let),
        kw("mut", Mut),
        kw("set", Set),
        kw("pub", Pub),
        kw("import", Import),
        kw("from", From),
        kw("as", As),
        kw("for", For),
        kw("while", While),
        kw("match", Match),
        kw("return", Return),
        kw("struct", Struct),
        kw("variant", Variant),
        kw("if", If),
        kw("else", Else),
        kw("builtins", Builtins),
        kw("true", True),
        kw("false", False),
        kw("none", None),
        TokenRule { matcher: CharRun(ident_start(), ident_cont()), emit: OfText(Name) },
        TokenRule { matcher: Int, emit: TryText(int_lit) },
        // Raw strings before the plain string rule: `Between` declines (length 0)
        // unless the source opens with `"""`, so a single `"` still falls through
        // to `Delimited` — but a `"""` is claimed here as one raw token rather
        // than an empty `""` plus a stray `"`.
        TokenRule { matcher: Between(three_quotes, three_quotes), emit: OfStr(RawStrLit) },
        TokenRule {
            matcher: Delimited("\"", "ntr\\\""),
            emit: OfStr(|text: str| StrLit(text.unescape())),
        },
        // Char literals `'x'`/`'\n'`: the `CharLit` matcher enforces the one-char
        // shape and decodes the byte itself (the same escape set as a string,
        // plus `\'`), so `OfChar` applies the bare `CharTok` constructor to it. The
        // kind is `CharTok`, not `CharLit`/`Char`, because those names are already
        // the library's `Matcher` constructor and its test `Kind`'s arm (shared
        // constructor namespace). Its hard errors (empty `''`, `'ab'`, unknown
        // escape, unterminated) carry byte-precise spans matching the Rust lexer's.
        TokenRule { matcher: CharLit("'", "ntr\\'\""), emit: OfChar(CharTok) },
        // Template literals. Triple-backtick before single (`Template` declines
        // unless the source opens with its delim, so ``` ``` ``` must be claimed
        // whole before the single ``` ` ``` rule bites off the first backtick —
        // the same longest-delim-first ordering as the raw/plain string rules,
        // and matching the Rust lexer's triple-before-single check). The raw form
        // scans verbatim (empty `escapes`); the single form decodes the same
        // escapes as a string plus `` \` ``/`\{`. Each interpolation re-lexes with
        // this whole rule set, so templates nest.
        TokenRule { matcher: Template("```", ""), emit: OfSeg(raw_tpl_kind) },
        TokenRule { matcher: Template("`", "\\`{ntr"), emit: OfSeg(tpl_kind) },
        // Operators and punctuation, one `op` rule per spelling, longest first so
        // first-match-wins is maximal munch: the three-char `+++`, then the
        // two-char forms (`==`/`=>` before `=`, `<=`/`>=` before `<`/`>`, `++`
        // before `+`, `||` before `|`, `..` before `.`), then the one-char rest.
        op("+++", PlusPlusPlus),
        op("==", EqEq),
        op("!=", Ne),
        op("->", Arrow),
        op("=>", FatArrow),
        op("&&", AndAnd),
        op("||", OrOr),
        op("..", DotDot),
        op("++", PlusPlus),
        op("<=", Le),
        op(">=", Ge),
        op("=", Eq),
        op("<", Lt),
        op(">", Gt),
        op("!", Bang),
        op("+", Plus),
        op("-", Minus),
        op("*", Star),
        op("/", Slash),
        op("%", Percent),
        op("|", Pipe),
        op(".", Period),
        op(",", Comma),
        op(":", Colon),
        op(";", Semi),
        op("?", Question),
        op("#", Hash),
        op("(", LParen),
        op(")", RParen),
        op("{", LBrace),
        op("}", RBrace),
        op("[", LBracket),
        op("]", RBracket),
    ]
}

// Lex AIPL source into typed `AiplTok` tokens (plus the trivia side-channel:
// comments and `#[allow]` markers; whitespace is skipped outright). This is the
// compiler's dogfood entry (see `DOGFOOD_ENTRIES`): the Rust side calls it via
// the FFI and mirrors the result into its own token types.
pub fn lex_aipl(src: str) -> LexResult<AiplTok>!LexError { lex(src, aipl_rules()) }.test({
    // A small snippet exercising several kinds; a fuller suite comes with the
    // real grammar. `let x = 42;` plus a trailing line comment (trivia).
    let src = "let x = 42; // note";
    assert(
        lex_aipl(src) == ok(
            LexResult {
                tokens: [
                    Token { kind: Let, span: 0..3 },
                    Token { kind: Name("x"), span: 4..5 },
                    Token { kind: Eq, span: 6..7 },
                    Token { kind: IntLit(42), span: 8..10 },
                    Token { kind: Semi, span: 10..11 },
                ],
                trivia: [Token { kind: LineComment, span: 12..19 }],
            },
        ),
    );

    // Keywords beyond the starter set. `builtins` is a keyword everywhere (as in
    // the Rust lexer), not just in a `from builtins;` import; `iffy` still lexes
    // as a `Name`, since the `Keyword` matcher stops at an identifier boundary.
    assert(
        lex_aipl("if else builtins iffy") == ok(
            LexResult {
                tokens: [
                    Token { kind: If, span: 0..2 },
                    Token { kind: Else, span: 3..7 },
                    Token { kind: Builtins, span: 8..16 },
                    Token { kind: Name("iffy"), span: 17..21 },
                ],
                trivia: [],
            },
        ),
    );

    // The constant literals get their own kinds, distinct from keywords and from
    // identifiers. `some`/`ok`/`err` are ordinary `Name`s (constructors, not
    // constants); `noneish` stays a `Name` (identifier-boundary matched).
    assert(
        lex_aipl("true false none some noneish") == ok(
            LexResult {
                tokens: [
                    Token { kind: True, span: 0..4 },
                    Token { kind: False, span: 5..10 },
                    Token { kind: None, span: 11..15 },
                    Token { kind: Name("some"), span: 16..20 },
                    Token { kind: Name("noneish"), span: 21..28 },
                ],
                trivia: [],
            },
        ),
    );

    // The rest of the operator/punctuation table: `<=`/`>=` beat `<`/`>`, `++`
    // beats `+` (but not `+++`), and `|` is the lambda delimiter. `Exact` always
    // takes the longest spelling, so the two-char forms win over their one-char
    // prefixes.
    assert(
        lex_aipl("a <= b >= |x| ++") == ok(
            LexResult {
                tokens: [
                    Token { kind: Name("a"), span: 0..1 },
                    Token { kind: Le, span: 2..4 },
                    Token { kind: Name("b"), span: 5..6 },
                    Token { kind: Ge, span: 7..9 },
                    Token { kind: Pipe, span: 10..11 },
                    Token { kind: Name("x"), span: 11..12 },
                    Token { kind: Pipe, span: 12..13 },
                    Token { kind: PlusPlus, span: 14..16 },
                ],
                trivia: [],
            },
        ),
    );

    // `#` disambiguation: a bare `#` (the `#{...}` dict prefix) is a `Hash` token,
    // but `#[allow]` is the lint-squelch marker — recorded as trivia and kept out
    // of the token stream, matching the Rust lexer.
    assert(
        lex_aipl("#{ #[allow]") == ok(
            LexResult {
                tokens: [Token { kind: Hash, span: 0..1 }, Token { kind: LBrace, span: 1..2 }],
                trivia: [Token { kind: AllowMarker, span: 3..11 }],
            },
        ),
    );

    // Block comments are trivia, and `Nested` depth-tracks them, so the inner
    // `/* */` doesn't close the outer — the whole `/* a /* b */ c */` is one
    // comment, out of the token stream.
    assert(
        lex_aipl("x /* a /* b */ c */ y") == ok(
            LexResult {
                tokens: [
                    Token { kind: Name("x"), span: 0..1 },
                    Token { kind: Name("y"), span: 20..21 },
                ],
                trivia: [Token { kind: BlockComment, span: 2..19 }],
            },
        ),
    );

    // An unterminated block comment is a hard error spanning the open `/*` to the
    // end of source, matching the Rust lexer.
    assert(
        lex_aipl("a /* never closed") == err(
            LexError { message: "unterminated delimited token", span: 2..17 },
        ),
    );

    // A string literal with escapes: the source is `s = "a\nb"` (a literal
    // backslash-`n`, not a newline). The `StrLit` emit decodes it, so the token's
    // value carries an actual newline — escape handling lives in `str_lit`, not in
    // the lexer library.
    let esc = "s = \"a\\nb\"";
    assert(
        lex_aipl(esc) == ok(
            LexResult {
                tokens: [
                    Token { kind: Name("s"), span: 0..1 },
                    Token { kind: Eq, span: 2..3 },
                    Token { kind: StrLit("a\nb"), span: 4..10 },
                ],
                trivia: [],
            },
        ),
    );

    // A raw string `"""a"b"""` (the AIPL source here is written with escaped
    // quotes). `Between` scans to the balancing `"""`, so the lone `"` inside is
    // content and the value is verbatim — no escape decoding, unlike `StrLit`.
    let raw = "\"\"\"a\"b\"\"\"";
    assert(
        lex_aipl(raw) == ok(
            LexResult { tokens: [Token { kind: RawStrLit("a\"b"), span: 0..9 }], trivia: [] },
        ),
    );

    // Char literals: an ordinary `'x'` and an escaped `'\n'` (the AIPL source
    // writes the escape as a literal backslash-`n`), each decoded to its byte.
    assert(
        lex_aipl("'x' '\\n'") == ok(
            LexResult {
                tokens: [
                    Token { kind: CharTok('x'), span: 0..3 },
                    Token { kind: CharTok('\n'), span: 4..8 },
                ],
                trivia: [],
            },
        ),
    );

    // The one-char shape is enforced: an empty `''` is a hard error whose span
    // (the two quotes) matches the Rust lexer's `empty char literal` error.
    assert(lex_aipl("''") == err(LexError { message: "empty char literal", span: 0..2 }));

    // A multi-char literal (someone reaching for a string but typing `'...'`) is
    // rejected. NOTE the span: the lexer takes the first char as the content,
    // then finds a non-quote where the close should be, so the reported span is
    // just the opening quote + that first char (`'m`, here 7..9) — *not* the
    // whole `'multiple'` literal. This narrow caret is arguably surprising (the
    // mistake spans the whole literal), which is why it's called out here.
    assert(
        lex_aipl("oops = 'multiple'") == err(
            LexError { message: "char literal must contain exactly one character", span: 7..9 },
        ),
    );

    // A template literal with no interpolation lexes as one `TemplateStr` (the
    // Rust lexer folds it to a plain string) — the whole literal, backticks
    // included, is its span.
    assert(
        lex_aipl("`hi`") == ok(
            LexResult { tokens: [Token { kind: TemplateStr("hi"), span: 0..4 }], trivia: [] },
        ),
    );

    // A template with an interpolation `` `a{x}b` ``: the head runs from the
    // opening backtick through the first `{`, the `{x}` re-lexes with the full
    // rule set (a lone `Name`), and the tail runs from just past the `}` through
    // the closing backtick. Head/tail spans include their braces/delimiters.
    assert(
        lex_aipl("`a{x}b`") == ok(
            LexResult {
                tokens: [
                    Token { kind: TemplateHead("a"), span: 0..3 },
                    Token { kind: Name("x"), span: 3..4 },
                    Token { kind: TemplateTail("b"), span: 5..7 },
                ],
                trivia: [],
            },
        ),
    );

    // A triple-backtick raw template scans verbatim, so its value is the exact
    // bytes and it wins over the single-backtick rule (longest delim first).
    assert(
        lex_aipl("```hi```") == ok(
            LexResult { tokens: [Token { kind: RawTemplateStr("hi"), span: 0..8 }], trivia: [] },
        ),
    );

    // An integer that overflows i64: the `TryText` emit (`int_lit`) reports it,
    // and the library attaches the literal's span. Overflow policy is the
    // consumer's — the lexer library never parses ints itself.
    assert(
        lex_aipl("99999999999999999999") == err(
            LexError { message: "integer literal overflows i64", span: 0..20 },
        ),
    );
})

// --- Differential-testing bridge (dogfooding) ------------------------------
//
// `lex_aipl_tokens` is the FFI entry the Rust `tests/lexer_dogfood.rs` calls to
// compare this AIPL lexer against the compiler's hand-written Rust lexer over the
// test corpus. It hands back the *actual* token array — `Token<AiplTok>[]`, each
// token carrying its typed `kind` and `span` — which crosses the embedding FFI
// directly (an array of structs whose fields are themselves a variant and a
// struct). The Rust side coarsens each `kind` to a category and diffs spans,
// building a burn-down list of the remaining divergences; nothing here is used to
// compile. `trivia` is dropped: the differential dump compares only the emitted
// token stream (the Rust lexer's dump has no comment/marker lines to compare the
// side-channel against).
pub fn lex_aipl_tokens(src: str) -> Token<AiplTok>[]!LexError {
    match (lex_aipl(src)) {
        ok(res) => ok(res.tokens),
        err(e) => err(e),
    }
}.test({
    assert(
        lex_aipl_tokens("let x = 42;") == ok(
            [
                Token { kind: Let, span: 0..3 },
                Token { kind: Name("x"), span: 4..5 },
                Token { kind: Eq, span: 6..7 },
                Token { kind: IntLit(42), span: 8..10 },
                Token { kind: Semi, span: 10..11 },
            ],
        ),
    );
    // A byte no rule matches makes the whole lex an error, carrying its span.
    assert(lex_aipl_tokens("@") == err(LexError { message: "unexpected character", span: 0..1 }));
})

// Strip trailing `--- section ---` cases-harness blocks, then lex. The
// highlighter and the parser both want AIPL source with those blocks removed,
// and both `strip_test_sections` and `lex_aipl` are dogfooded — composing them
// here keeps the whole strip-then-lex a single FFI crossing instead of one per
// step. Spans are unchanged: `strip_test_sections` returns a byte-prefix of
// `src`, so every kept token's span still indexes the original source.
pub fn lex_aipl_stripped(src: str) -> LexResult<AiplTok>!LexError {
    lex_aipl(strip_test_sections(src))
}.test({
    // The `--- stdout ---` marker and everything after it is dropped before
    // lexing; the tokens before it keep their original spans.
    assert(
        lex_aipl_stripped("let x = 1\n--- stdout ---\nfoo") == ok(
            LexResult {
                tokens: [
                    Token { kind: Let, span: 0..3 },
                    Token { kind: Name("x"), span: 4..5 },
                    Token { kind: Eq, span: 6..7 },
                    Token { kind: IntLit(1), span: 8..9 },
                ],
                trivia: [],
            },
        ),
    );
    // No marker: identical to lexing `src` directly (comments still trivia).
    assert(
        lex_aipl_stripped("y // c") == ok(
            LexResult {
                tokens: [Token { kind: Name("y"), span: 0..1 }],
                trivia: [Token { kind: LineComment, span: 2..6 }],
            },
        ),
    );
})
