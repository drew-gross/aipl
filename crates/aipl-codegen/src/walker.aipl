// The formatter's token-stream walker, dogfooded in AIPL: the port of the Rust
// `aipl-fmt` `Walker` (`crates/aipl-fmt/src/lib.rs`). It walks the token stream
// `lex_aipl` produces — not the AST, since the parser desugars as it builds
// (template literals, `set n++`, destructuring), so an AST can't be printed back
// faithfully — and builds a `Doc` layout tree for `print_doc` to lay out.
//
// The Rust walker is a `&mut self` cursor over `(toks, pos, comments, last_end)`.
// AIPL values have no references, so the cursor travels as a `W` *value* that
// every step returns alongside its result — the `W…` carrier structs below, the
// same shape `lexer.aipl`'s `StepResult` uses for its `end`. Reading the cursor
// (`peek`, `at_end`, …) takes `W` by value and returns just the answer; advancing
// it (`bump`, `expect`, `lead`, …) returns a carrier holding the moved-on `W`.
import {
    Span,
    contains,
    count,
    equal as ==,
    first,
    intersperse,
    is_err_and,
    is_some_and,
    join,
    len,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    map_err,
    max,
    min,
    not_equal as !=,
    push,
    saturating_sub as -,
    sort_by,
    starts_with,
    value_or,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;
import {
    BlankLine,
    BreakParent,
    Concat,
    Doc,
    Group,
    HardLine,
    IfBroken,
    Indent,
    Line,
    RawBlock,
    SoftLine,
    Text,
    group,
    print_doc,
} from "./doc.aipl";
import { is_operator_name } from "./is_operator_name.aipl";
import { AiplTok, lex_aipl } from "./lex_aipl.aipl";

// What the walker dispatches on. Mirrors the Rust `FmtTokenKind`: the parser's
// `TokenKind` for an ordinary token, plus the three interpolated-template pieces,
// which token *text* alone cannot distinguish — an empty segment's `TplMid` is
// the single character `{`, identical to a brace.
variant FmtKind =
    Keyword
    | Constant
    | BuiltinType
    | Ident
    | Num
    | StrTok
    | CharTok
    | Op
    | Punct
    | TplHead
    | TplMid
    | TplTail

// One token: what it is, and where it sits in the source. The text is recovered
// from the span (`src[span]`) rather than stored, exactly as the Rust walker
// slices `&self.src[sp]` — so every literal, comment and paren stays verbatim.
struct FmtTok { kind: FmtKind, span: Span }

// The walker's whole state. `src`/`toks`/`comments` are the immutable inputs;
// `pos`/`cpos`/`last_end` are the cursor the Rust version mutates in place.
struct W {
    src: str,
    toks: FmtTok[],
    comments: Span[],
    pos: u64,
    // Index of the next undrained comment. The Rust walker pops from a
    // `VecDeque`; an index needs no queue (and AIPL arrays have no `pop`).
    cpos: u64,
    // End offset of the last consumed token or comment — what the blank-line and
    // same-line (trailing comment) decisions measure from.
    last_end: u64,
}

// Cursor-advancing steps return the moved-on `W` beside their result.
struct WDoc { w: W, doc: Doc }

struct WStr { w: W, text: str }

// A step that produces *several* docs (a comma list's items, a run of type
// suffixes) rather than one.
struct WDocs { w: W, docs: Doc[] }

// A formatter failure. Mirrors `lexer.aipl`'s `LexError`; the Rust walker's
// span-less `Error::msg` case (past the last token) becomes a message carrying
// "(at end of input)" with an empty span at EOF — see `err_here`.
struct FmtError { message: str, span: Span }

fn new_walker(src: str, toks: FmtTok[], comments: Span[]) -> W {
    src,
    toks,
    comments,
    pos: 0,
    cpos: 0,
    last_end: 0,
}.test({
    // --- fixtures -------------------------------------------------------
    // `fn f() {}` with a leading line comment and a trailing one, so the
    // primitives below have real spans to walk. Offsets are byte-exact:
    //
    //   0         1         2         3
    //   0123456789012345678901234567890123456789
    //   // hi\nfn f() {} // tail\n
    let src = "// hi\nfn f() {} // tail\n";
    let toks = [
        FmtTok { kind: Keyword, span: 6..8 },
        // fn
        FmtTok { kind: Ident, span: 9..10 },
        // f
        FmtTok { kind: Punct, span: 10..11 },
        // (
        FmtTok { kind: Punct, span: 11..12 },
        // )
        FmtTok { kind: Punct, span: 13..14 },
        // {
        FmtTok { kind: Punct, span: 14..15 },
    ];
    // }

    let comments = [0..5, 16..23];
    let w = new_walker(src, toks, comments);

    // --- token primitives -----------------------------------------------
    assert(w.peek_text() == "fn");
    assert(w.peek_text_n(1) == "f");
    assert(w.peek()?.kind == Keyword);
    assert(!w.at_end());

    // `bump` advances and hands back the consumed text.
    let b = w.bump();
    assert(b.text == "fn");
    assert(b.w.peek_text() == "f");
    assert(b.w.last_end == 8);
    // The original `w` is untouched — the cursor is a value, not a mutation.
    assert(w.peek_text() == "fn");

    // Walking off the end is inert rather than a panic, and `at_end` reports it.
    mut end = w;
    for (let _ : "123456") {
        set end = end.bump().w;
    }
    assert(end.at_end());
    assert(end.peek_text() == "");
    assert(end.peek() == none);
    assert(end.bump().text == "");

    // --- expect ----------------------------------------------------------
    assert(w.expect("fn")?.text == "fn");
    // A mismatch names both sides, quoted, like the Rust `{:?}`.
    assert(
        w.expect("struct").is_err_and(|e| e.message == `formatter: expected "struct", found "fn"`),
    );
    // The span points at the offending token.
    assert(w.expect("struct").is_err_and(|e| e.span == 6..8));
    // Past the end the message picks up the span-less marker.
    assert(
        end
            .expect("}")
            .is_err_and(|e| e.message == `formatter: expected "}", found "" (at end of input)`),
    );

    // --- source gaps -------------------------------------------------------
    // The first comment starts at 0, before the first token at 6.
    assert(w.next_start() == 0);
    // Once it is drained, the next entity is the `fn` token.
    assert(w.take_comment(0..5).next_start() == 6);
    assert(w.same_line(6..8));
    assert(!w.same_line(0..8)); // spans the newline after `// hi`
    assert(!w.gap_has_blank(0..8)); // one newline is not a blank line

    // --- lead --------------------------------------------------------------
    // The leading `// hi` is drained and emitted with a hard line after it (the
    // gap to `fn` holds a single newline, so no blank line).
    let l = w.lead();
    assert(l.doc == Concat([Text("// hi"), HardLine]));
    assert(l.w.cpos == 1);
    assert(l.w.last_end == 5);
    // At the `fn` token there is no *leading* comment left, so `lead` is empty.
    assert(l.w.lead().doc == Concat([]));

    // A blank line after a comment is preserved as a `BlankLine` separator.
    let blank_src = "// hi\n\nfn f() {}";
    let bw = new_walker(blank_src, [FmtTok { kind: Keyword, span: 7..9 }], [0..5]);
    // Two newlines in the gap after `// hi` — that *is* a blank line.
    assert(bw.gap_has_blank(5..7));
    assert(bw.lead().doc == Concat([Text("// hi"), BlankLine]));

    // --- trailing_comment ---------------------------------------------------
    // With the leading comment drained the cursor sits at `fn` (offset 6), and
    // `// tail` (16) comes *after* that still-unconsumed token — so it belongs to
    // a later flush point, not this one.
    assert(l.w.trailing_comment().doc == Concat([]));
    // After consuming through `}` (end 15), `// tail` at 16 is on that line.
    mut through = w.lead().w;
    for (let _ : "123456") {
        set through = through.bump().w;
    }
    assert(through.last_end == 15);
    let tc = through.trailing_comment();
    assert(tc.doc == Concat([Text(" "), Text("// tail"), BreakParent]));
    assert(tc.w.cpos == 2);
    // Drained exactly once — a second call finds nothing left.
    assert(tc.w.trailing_comment().doc == Concat([]));
})

// ---------- token primitives ----------

// The token at the cursor, or `none` past the end.
fn peek(self: W) -> FmtTok? { self.toks[self.pos] }

// Source text of the token `n` past the cursor; `""` past the end. A `Span`
// index is slice sugar, so `src[span]` is the token's verbatim text.
fn peek_text_n(self: W, n: u64) -> str { self.tok_text(self.pos + n) }

fn peek_text(self: W) -> str { self.peek_text_n(0) }

fn at_end(self: W) -> bool { self.toks.len() <= self.pos }

// Is there another item to read before the closing `end` token?
//
// **Use this for every "scan until a closing token" loop.** The bare form
//
//     while (w.peek_text() != "}") { .. }        // WRONG
//
// spins forever on truncated input: past the last token `peek_text()` is `""`,
// which never equals `"}"`, and `bump()` deliberately does not advance at the
// end (see its comment) — so the loop makes no progress and never exits. That
// is not hypothetical; it hung `aipl check` on a truncated import with no
// output and no diagnostic, which is indistinguishable from a compiler hang.
//
// Folding the `at_end` check in here means a caller cannot forget it. The
// `expect(end)` that follows the loop then reports the missing token properly.
fn more_before(self: W, end: str) -> bool { !self.at_end() && self.peek_text() != end }

// Consume the token at the cursor, returning its text. The caller has already
// dispatched on it; comments before it must have been drained (else the final
// not-carried check in the driver fails).
fn bump(self: W) -> WStr {
    match (self.peek()) {
        some(t) => WStr {
            w: W { ..self, pos: self.pos + 1, last_end: t.span.end },
            text: self.src[t.span],
        },
        // Past the end there is nothing to consume: the cursor stays put and the
        // text is empty, matching `peek_text`. The Rust version indexes and would
        // panic; every caller dispatches on `peek_text` first, so neither runs.
        none => WStr { w: self, text: "" },
    }
}

// Consume the next token, which must read exactly `want`.
fn expect(self: W, want: str) -> WStr!FmtError {
    if (self.peek_text() == want) {
        ok(self.bump())
    } else {
        err(self.err_here(`formatter: expected "{want}", found "{self.peek_text()}"`))
    }
}

// An error at the cursor. Past the last token there is no span to point at, so
// the message says so and the span collapses to EOF — the AIPL stand-in for the
// Rust `Error::msg` (span-less) case.
fn err_here(self: W, msg: str) -> FmtError {
    match (self.peek()) {
        some(t) => FmtError { message: msg, span: t.span },
        none => FmtError {
            message: `{msg} (at end of input)`,
            span: self.src.len()..self.src.len(),
        },
    }
}

// ---------- source gaps ----------

// Where the next syntactic entity begins: the next comment or token, whichever
// comes first. Past both, the end of the source.
fn next_start(self: W) -> u64 {
    let tok = match (self.peek()) {
        some(t) => t.span.start,
        none => self.src.len(),
    };
    match (self.comments[self.cpos]) {
        some(c) => min(c.start, tok),
        none => tok,
    }
}

// Whether the source across a span holds a blank line (two newlines).
fn gap_has_blank(self: W, span: Span) -> bool { 2 <= self.src[span].count('\n') }

// Whether a span's endpoints sit on the same source line.
fn same_line(self: W, span: Span) -> bool { !self.src[span].contains("\n") }

// ---------- comments ----------

// Drain the comments before the next token, each on its own line — so a
// mid-list line comment forces the enclosing group to break (a comment can never
// be flattened onto one line). A blank line *after* a comment is preserved: it
// marks the comment as standalone rather than attached to what follows.
fn lead(self: W) -> WDoc {
    // Past the last token every remaining comment is "before" it, which is what
    // flushes a file's trailing comments; `next_start` still bounds each gap.
    let limit = match (self.peek()) {
        some(t) => t.span.start,
        none => self.src.len() + 1,
    };
    lead_loop(self, limit, [])
}

fn lead_loop(w0: W, limit: u64, acc0: Doc[]) -> WDoc {
    mut w = w0;
    mut acc = acc0;
    while (w.comment_starts_before(limit)) {
        let c = w.cur_comment();
        let stepped = w.take_comment(c);
        let next = stepped.next_start();

        // `next` can precede `c.end` only if a later entity started inside this
        // comment, which the lexer cannot produce; `max` in the Rust version
        // guards the same impossible case.
        let gap_end = max(next, c.end);
        let sep = if (stepped.gap_has_blank(c.end..gap_end)) { BlankLine } else { HardLine };
        set acc.push(Text(w.src[c]));
        set acc.push(sep);
        set w = stepped;
    }
    WDoc { w, doc: Concat(acc) }
}

// A trailing comment on the same line as whatever just ended, rendered as
// ` // ...` glued to the current line plus a `BreakParent`, so no group flattens
// anything after it onto the comment's line. It must also come *before* the next
// unconsumed token: a comment ending a source line whose earlier tokens are still
// pending (e.g. after the `}` closing an inline block) belongs to a later flush
// point, not this one.
fn trailing_comment(self: W) -> WDoc {
    let next_tok = match (self.peek()) {
        some(t) => t.span.start,
        none => self.src.len() + 1,
    };
    match (self.comments[self.cpos]) {
        none => WDoc { w: self, doc: Concat([]) },
        some(c) => if (c.start < next_tok && self.same_line(self.last_end..c.start)) {
            WDoc {
                w: self.take_comment(c),
                doc: Concat([Text(" "), Text(self.src[c]), BreakParent]),
            }
        } else {
            WDoc { w: self, doc: Concat([]) }
        },
    }
}

// Consume comment `c`: step past it and mark it as the last thing emitted. The
// Rust `pop_front` + `last_end` update, as one move.
fn take_comment(self: W, c: Span) -> W { ..self, cpos: self.cpos + 1, last_end: c.end }

// ---------- comma lists ----------

// The bracket pair (and flat-mode edge spacing) of a comma list. Braces that read
// as words get inner spaces when flat (`{ a, b }`); the rest hug their contents
// (`(a, b)`, `[a]`, `#{a}`, `<T: any>`). Type-position lists (`TyParens`,
// `Angles`) take no trailing comma when broken — the grammar doesn't allow one
// there.
variant ListStyle =
    Parens
    | Brackets
    | HashBraces
    | SpacedBraces
    | Angles
    | TyParens
    | SpacedBracesNoTrailing

// A style's brackets and the two layout bits, unpacked. The Rust version returns
// a 4-tuple from a `match`; a struct names the bits at the use site.
struct ListShape { open: str, close: str, spaced: bool, trailing: bool }

fn shape(self: ListStyle) -> ListShape {
    match (self) {
        Parens => ListShape { open: "(", close: ")", spaced: false, trailing: true },
        Brackets => ListShape { open: "[", close: "]", spaced: false, trailing: true },
        HashBraces => ListShape { open: "#{", close: "}", spaced: false, trailing: true },
        SpacedBraces => ListShape { open: "{", close: "}", spaced: true, trailing: true },
        // `SpacedBraces` for a caller that has already written the trailing
        // comma into the last item, so this must not add a second one when the
        // list breaks. See `construct_body`.
        SpacedBracesNoTrailing => ListShape {
            open: "{",
            close: "}",
            spaced: true,
            trailing: false,
        },
        Angles => ListShape { open: "<", close: ">", spaced: false, trailing: false },
        TyParens => ListShape { open: "(", close: ")", spaced: false, trailing: false },
    }
}

// A bracketed comma list that either fits on one line or breaks to one item per
// indented line with a trailing comma. Width decisions happen at print time, so
// this only describes both layouts.
fn comma_list_docs(items: Doc[], style: ListStyle) -> Doc {
    let s = style.shape();
    if (items.len() == 0) {
        return Text(`{s.open}{s.close}`);
    };
    let edge = if (s.spaced) { Line } else { SoftLine };
    let inner = [edge, ..items.intersperse(Concat([Text(","), Line]))];
    mut parts = [Text(s.open), Indent(Concat(inner))];
    if (s.trailing) {
        set parts.push(IfBroken(","));
    };
    set parts.push(edge);
    set parts.push(Text(s.close));
    group(Concat(parts))
}

// ---------- entry point ----------

// Format `src` at `width`, from source text to laid-out source text: lex it,
// walk the tokens into a `Doc`, then print. This is the whole formatter as far
// as the Rust side is concerned — arrays cannot cross the FFI as arguments, so
// the token stream is produced here rather than marshalled in.
//
// The caller still owns the surrounding steps that are not layout: splitting off
// trailing `--- section ---` blocks, stripping trailing whitespace, validating
// with the real parser, and the token-preservation check.
pub fn format_program(src: str, width: u64) -> str!FmtError {
    let lexed = lex_aipl(src).map_err(|e| FmtError { message: e.message, span: e.span })?;

    // The lexer's tokens as the walker's own `(kind, span)` pairs. Trivia is
    // comments and `#[allow]` markers only — whitespace is a `skip` rule, so it
    // never reaches the trivia stream, and only its spans are kept.
    let toks = lexed.tokens.map(|t| FmtTok { kind: fmt_kind(t.kind), span: t.span });
    let w = new_walker(src, toks, lexed.trivia.map(|t| t.span));
    let d = w.program()?;

    // Every comment must have been carried into the output; one left behind
    // would silently vanish from the formatted source.
    match (d.w.comments[d.w.cpos]) {
        none => ok(print_doc(d.doc, width)),
        some(c) => err(FmtError {
            message: "formatter: comment was not carried into the output (formatter bug)",
            span: c,
        }),
    }
}

// A lexer token kind as the kind the walker dispatches on. The interpolated
// template pieces (regular *or* raw) keep their head/middle/tail position, which
// token text alone cannot recover; everything else folds to its syntactic class.
fn fmt_kind(k: AiplTok) -> FmtKind {
    match (k) {
        TemplateHead(_) => TplHead,
        RawTemplateHead(_) => TplHead,
        TemplateMid(_) => TplMid,
        RawTemplateMid(_) => TplMid,
        TemplateTail(_) => TplTail,
        RawTemplateTail(_) => TplTail,
        Fn | If | Else | Struct | Variant | Import | From | As => Keyword,
        Pub | Let | For | While | Mut | Set | Match | Return | Shim | Builtins => Keyword,
        True | False | None => Constant,
        Name(n) => if (is_builtin_type_name(n)) { BuiltinType } else { Ident },
        IntLit(_) => Num,
        StrLit(_, _) => StrTok,
        CharTok(_) => CharTok,
        EqEq | Ne | Arrow | FatArrow | AndAnd | OrOr | Pipe | DotDot => Op,
        PlusPlusPlus | PlusPlus | Eq | Lt | Le | Gt | Ge | Bang => Op,
        Plus | Minus | Star | Slash | Percent => Op,
        Period | Comma | Colon | Semi | Question | Hash => Punct,
        LParen | RParen | LBrace | RBrace | LBracket | RBracket => Punct,
        // Trivia never reaches the token stream (whitespace is skipped, comments
        // go to the trivia sink); classify them harmlessly rather than diverge.
        Space | LineComment | BlockComment | AllowMarker => Punct,
    }
}

// The lexically-identifier names the highlighter scopes as types.
fn is_builtin_type_name(n: str) -> bool {
    n == "bool" || n == "char" || n == "str" || n == "any" || n.is_int_type_name()
}

fn is_int_type_name(self: str) -> bool {
    self == "i8" || self == "i16" || self == "i32" || self == "i64" || self == "u8" || self == "u16" || self == "u32" || self == "u64"
}

// ---------- small shared helpers ----------

// Source text of token `i`; `""` past the end.
fn tok_text(self: W, i: u64) -> str {
    match (self.toks[i]) {
        some(t) => self.src[t.span],
        none => "",
    }
}

// Whether the token at the cursor has kind `k`.
fn peek_is(self: W, k: FmtKind) -> bool { self.peek_is_n(0, k) }

// Whether the token `n` past the cursor has kind `k`.
fn peek_is_n(self: W, n: u64, k: FmtKind) -> bool {
    self.toks[self.pos + n].is_some_and(|t| t.kind == k)
}

// Whether an undrained comment sits before the token at the cursor.
fn comment_before_cursor(self: W) -> bool {
    self.comments[self.cpos].is_some_and(|c| self.peek().is_some_and(|t| c.start < t.span.start))
}

// Step past one token, recording where it ended. `bump` without the text.
fn advance(self: W, end: u64) -> W { ..self, pos: self.pos + 1, last_end: end }

fn skip_comment(self: W) -> W { ..self, cpos: self.cpos + 1 }

// Whether `d` is the empty `Concat` that `lead`/`trailing_comment` hand back when
// there was no comment — the "nothing here" doc.
fn is_empty_doc(self: Doc) -> bool {
    match (self) {
        Concat(ds) => ds.len() == 0,
        Text(_) => false,
        RawBlock(_) => false,
        IfBroken(_) => false,
        Indent(_) => false,
        Group(_, _) => false,
        Line | SoftLine | HardLine | BlankLine | BreakParent => false,
    }
}

// Separator between block entries: nothing before the first, otherwise a hard
// line — doubled when the source had a blank line there.
fn sep_entry(blank: bool, not_first: bool) -> Doc {
    if (!not_first) { Concat([]) } else { if (blank) { BlankLine } else { HardLine } }
}

// Drop a trailing `HardLine`/`BlankLine` from a `Concat` — the line break `lead`
// leaves dangling when the closing `}` follows and supplies its own.
fn without_trailing_break(self: Doc) -> Doc {
    match (self) {
        Concat(ds) => Concat(ds.drop_trailing_break()),
        Text(_) => self,
        RawBlock(_) => self,
        IfBroken(_) => self,
        Indent(_) => self,
        Group(_, _) => self,
        Line | SoftLine | HardLine | BlankLine | BreakParent => self,
    }
}

fn drop_trailing_break(self: Doc[]) -> Doc[] {
    let n = self.len();
    if (n == 0) {
        return self;
    };
    if (self[n - 1].value_or(Concat([])).is_line_break()) { self[..n - 1] } else { self }
}

// A break `lead` may have left at the end of its docs.
fn is_line_break(self: Doc) -> bool {
    match (self) {
        HardLine | BlankLine => true,
        Concat(_) => false,
        Text(_) => false,
        RawBlock(_) => false,
        IfBroken(_) => false,
        Indent(_) => false,
        Group(_, _) => false,
        Line | SoftLine | BreakParent => false,
    }
}

// Replace the last element of `self` — how the block builder rewrites the entry
// it just pushed (AIPL has no `last_mut`).
fn with_last(self: Doc[], d: Doc) -> Doc[] {
    let n = self.len();
    if (n == 0) {
        return self.push(d);
    };
    self[..n - 1].push(d)
}

// ---------- imports ----------

// One import, plus the key `program` will order it by.
struct WImport { w: W, source: str, doc: Doc }

// One imported name: what it sorts by, and how it is spelled in the output.
struct ImportName { name: str, rendered: str }

struct WKeys { w: W, names: ImportName[] }

// `import { a, b as c } from "path";` — the imported names sorted, the statement
// rendered, and the hoist key.
fn import_item(self: W) -> WImport!FmtError {
    let names = self.expect("import")?.w.expect("{")?.w.import_names([])?;
    let src = names.w.expect("}")?.w.expect("from")?.w.bump();
    let done = src.w.expect(";")?.w;
    let list = comma_list_docs(sorted_import_names(names.names), SpacedBraces);
    ok(WImport {
        w: done,
        source: src.text,
        doc: Concat([Text("import "), list, Text(" from "), Text(src.text), Text(";")]),
    })
}

fn import_names(self: W, acc0: ImportName[]) -> WKeys!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let first = w.bump();
        let r = if (first.w.peek_text() == "as") {
            first.w.import_alias(first.text)
        } else {
            WStr { w: first.w, text: first.text }
        };
        set acc.push(ImportName { name: first.text, rendered: r.text });
        set w = if (r.w.peek_text() == ",") { r.w.bump().w } else { r.w };
    }
    ok(WKeys { w, names: acc })
}

// `name as alias` — the spelling written when an import is renamed.
fn import_alias(self: W, first: str) -> WStr {
    let a = self.bump().w.bump();
    WStr { w: a.w, text: `{first} as {a.text}` }
}

// Plain names first, operators last; within each group, ordinary `str` order on
// the *imported* name — the one to the left of an `as` — so `wrapping_add as +`
// sorts under `w`, next to the function it actually imports, rather than among
// the operator spellings. A comparator states that directly, so nothing has to
// be packed into a sort key.
fn import_name_precedes(a: str, b: str) -> bool {
    let a_op = a.is_operator_name();
    if (a_op != b.is_operator_name()) { !a_op } else { a < b }
}

fn sorted_import_names(names: ImportName[]) -> Doc[] {
    names.sort_by(|a, b| import_name_precedes(a.name, b.name)).map(|n| Text(n.rendered))
}

// What `program` orders imports by: `builtins` ahead of every path import, then
// paths in ordinary `str` order. Like the name ordering above, a comparator
// states this directly rather than packing a bucket digit into a sort key.
fn import_source_precedes(a: str, b: str) -> bool {
    let a_builtins = a == "builtins";
    if (a_builtins != (b == "builtins")) { a_builtins } else { a < b }
}

// ---------- types ----------

// A type. Handles the three shapes the grammar allows at this level: a bare `!E`
// void-ok result, a parenthesized function/tuple type, and a base type optionally
// followed by `!E`.
fn ty(self: W) -> WDoc!FmtError {
    if (self.peek_text() == "!") {
        let inner = self.bump().w.base_ty()?;
        return ok(WDoc { w: inner.w, doc: Concat([Text("!"), inner.doc]) });
    };
    if (self.peek_text() == "(") {
        return self.paren_ty();
    };
    let base = self.base_ty()?;
    if (base.w.peek_text() == "!") {
        let e = base.w.bump().w.base_ty()?;
        return ok(WDoc { w: e.w, doc: Concat([base.doc, Text("!"), e.doc]) });
    };
    ok(base)
}

// `(A, B) -> R` (function type), `(A, B)` (tuple), `(A, B)[]` (tuple array), or
// `(A, B)!E` (a result with a tuple Ok payload). Which one is only known after
// the closing paren.
fn paren_ty(self: W) -> WDoc!FmtError {
    let args = self.bump().w.ty_list(")", [])?;
    let closed = args.w.expect(")")?.w;
    let list = comma_list_docs(args.docs, TyParens);
    if (closed.peek_text() == "->") {
        let r = closed.bump().w.ty()?;
        return ok(WDoc { w: r.w, doc: Concat([list, Text(" -> "), r.doc]) });
    };

    // Mirrors the grammar's `LPAREN ty_args RPAREN BANG base_ty`: the `!` binds
    // to the tuple directly, so no array suffix can precede it.
    if (closed.peek_text() == "!") {
        let e = closed.bump().w.base_ty()?;
        return ok(WDoc { w: e.w, doc: Concat([list, Text("!"), e.doc]) });
    };
    let arrs = closed.array_suffixes([]);
    ok(WDoc { w: arrs.w, doc: Concat([list, ..arrs.docs]) })
}

// Comma-separated types up to (not consuming) `end`.
fn ty_list(self: W, end: str, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before(end)) {
        let t = w.ty()?;
        set acc.push(t.doc);
        set w = if (t.w.peek_text() == ",") { t.w.bump().w } else { t.w };
    }
    ok(WDocs { w, docs: acc })
}

// A base type — a set/dict `#{..}` or a (possibly generic) name — plus any run of
// `?` / `[]` suffixes.
fn base_ty(self: W) -> WDoc!FmtError {
    let head = if (self.peek_text() == "#") { self.set_or_dict_ty()? } else { self.named_ty()? };
    let suf = head.w.type_suffixes([]);
    ok(WDoc { w: suf.w, doc: Concat([head.doc, ..suf.docs]) })
}

// `#{T}` (set) or `#{K: V}` (dict) — the `:` decides which.
fn set_or_dict_ty(self: W) -> WDoc!FmtError {
    let k = self.bump().w.expect("{")?.w.ty()?;
    let rest = if (k.w.peek_text() == ":") {
        k.w.dict_value_ty()?
    } else {
        WDocs { w: k.w, docs: [] }
    };
    let closed = rest.w.expect("}")?.w;
    ok(WDoc { w: closed, doc: Concat([Text("#{"), k.doc, ..rest.docs, Text("}")]) })
}

// The `: V` half of a dict type.
fn dict_value_ty(self: W) -> WDocs!FmtError {
    let v = self.bump().w.ty()?;
    ok(WDocs { w: v.w, docs: [Text(": "), v.doc] })
}

// A type name, plus `<A, B>` type arguments when applied. In type position `<`/`>`
// are unambiguously the argument brackets.
fn named_ty(self: W) -> WDoc!FmtError {
    let n = self.bump();
    if (n.w.peek_text() != "<") {
        return ok(WDoc { w: n.w, doc: Text(n.text) });
    };
    let args = n.w.bump().w.ty_list(">", [])?;
    let closed = args.w.expect(">")?.w;
    ok(WDoc { w: closed, doc: Concat([Text(n.text), comma_list_docs(args.docs, Angles)]) })
}

// A run of `?` (optional) and `[]` (array) suffixes, in source order.
fn type_suffixes(self: W, acc0: Doc[]) -> WDocs {
    mut w = self;
    mut acc = acc0;
    mut more = true;
    while (more) {
        if (w.peek_text() == "?") {
            set acc.push(Text("?"));
            set w = w.bump().w;
        } else {
            if (w.peek_text() == "[" && w.peek_text_n(1) == "]") {
                set acc.push(Text("[]"));
                set w = w.bump().w.bump().w;
            } else {
                set more = false;
            };
        };
    }
    WDocs { w, docs: acc }
}

// A run of `[]` alone — what may follow a parenthesized tuple type.
fn array_suffixes(self: W, acc0: Doc[]) -> WDocs {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == "[" && w.peek_text_n(1) == "]") {
        set acc.push(Text("[]"));
        set w = w.bump().w.bump().w;
    }
    WDocs { w, docs: acc }
}

// ---------- type parameters ----------

// A `<T, U: ord>` type-parameter list, or an empty `Text` when the declaration has
// none. (The Rust version returns `Option<Doc>` and every caller unwraps it to an
// empty text, so this collapses the two.) A bound is optional — bare `T` prints
// as-is, `T: ord` keeps its bound. Shared by `fn`, `struct` and `variant`.
fn type_params(self: W) -> WDoc!FmtError {
    if (self.peek_text() != "<") {
        return ok(WDoc { w: self, doc: Text("") });
    };
    let tps = self.bump().w.type_param_list([]);
    let closed = tps.w.expect(">")?.w;
    ok(WDoc { w: closed, doc: comma_list_docs(tps.docs, Angles) })
}

fn type_param_list(self: W, acc0: Doc[]) -> WDocs {
    mut w = self;
    mut acc = acc0;
    while (w.more_before(">")) {
        let n = w.bump();
        let p = if (n.w.peek_text() == ":") {
            n.w.param_bound(n.text)
        } else {
            WDoc { w: n.w, doc: Text(n.text) }
        };
        set acc.push(p.doc);
        set w = if (p.w.peek_text() == ",") { p.w.bump().w } else { p.w };
    }
    WDocs { w, docs: acc }
}

// `T: ord` — the `: bound` half of a type parameter.
fn param_bound(self: W, name: str) -> WDoc {
    let b = self.bump().w.bump();
    WDoc { w: b.w, doc: Text(`{name}: {b.text}`) }
}

// ---------- variant ----------

// One variant case: its leading comments (rendered above it) and the case itself.
struct VCase { lead: Doc, body: Doc }

struct WCases { w: W, cases: VCase[] }

// `variant V = A | B(i64)`. Flat when it fits; broken to one case per line with a
// leading `| `. A case's leading comment sits above it and, being a hard line,
// forces the broken layout.
fn variant_item(self: W) -> WDoc!FmtError {
    let n = self.expect("variant")?.w.bump();
    let tps = n.w.type_params()?;
    let cs = tps.w.expect("=")?.w.variant_cases([])?;
    ok(WDoc {
        w: cs.w,
        doc: group(Concat([
            Text(`variant {n.text}`),
            tps.doc,
            Text(" ="),
            Indent(Concat([Line, Concat(variant_body(cs.cases))])),
        ])),
    })
}

// Each case carries its own leading comments and any same-line trailing comment,
// so a comment written between two arms stays between them.
fn variant_cases(self: W, acc0: VCase[]) -> WCases!FmtError {
    mut w = self;
    mut acc = acc0;
    mut more = true;
    while (more) {
        let l = w.lead();
        let n = l.w.bump();
        let payload = if (n.w.peek_text() == "(") {
            n.w.variant_payload()?
        } else {
            WDoc { w: n.w, doc: Text("") }
        };
        let tc = payload.w.trailing_comment();
        set acc.push(VCase { lead: l.doc, body: Concat([Text(n.text), payload.doc, tc.doc]) });
        if (tc.w.peek_text() == "|") {
            set w = tc.w.bump().w;
        } else {
            set w = tc.w;
            set more = false;
        };
    }
    ok(WCases { w, cases: acc })
}

// A case's `(A, B)` payload types.
fn variant_payload(self: W) -> WDoc!FmtError {
    let tys = self.bump().w.ty_list(")", [])?;
    let closed = tys.w.expect(")")?.w;
    ok(WDoc { w: closed, doc: comma_list_docs(tys.docs, TyParens) })
}

// The cases laid out: the first sits inline after `=`; each later one is preceded
// by a `Line` and its `| ` separator, with its leading comments above it.
fn variant_body(cases: VCase[]) -> Doc[] {
    mut out = [];
    for (let i, c : cases) {
        if (0 < i) {
            set out.push(Line);
        };
        set out.push(c.lead);
        if (0 < i) {
            set out.push(Text("| "));
        };
        set out.push(c.body);
    }
    out
}

// ---------- program & items ----------

// One hoisted import: the statement, and the key `program` orders it by.
struct ImportEntry { source: str, doc: Doc }

struct WProgram { w: W, imports: ImportEntry[], items: Doc[] }

// A whole file: header comments, then the hoisted imports, then the items.
fn program(self: W) -> WDoc!FmtError {
    // File-header comments (before the first item) stay at the very top, even
    // though the imports below may be reordered. That is exactly what `lead`
    // does — drain every comment before the first token — so it runs up front,
    // before any import can claim them.
    let h = self.lead();
    let p = h.w.program_items([], [])?;
    mut out = [h.doc, ..sorted_imports(p.imports).intersperse(HardLine)];
    let had_imports = 0 < p.imports.len();
    for (let i, d : p.items) {
        if (0 < i || had_imports) {
            set out.push(BlankLine);
        };
        set out.push(d);
    }
    ok(WDoc { w: p.w, doc: Concat(out) })
}

fn program_items(self: W, imports0: ImportEntry[], items0: Doc[]) -> WProgram!FmtError {
    mut w = self;
    mut imports = imports0;
    mut items = items0;
    while (!w.at_end()) {
        let l = w.lead();
        set w = l.w;
        if (w.at_end()) {
            // Comments after the last item.
            set items.push(l.doc);
        } else {
            if (w.peek_text() == "import") {
                let im = w.import_item()?;
                let tc = im.w.trailing_comment();
                set imports.push(ImportEntry {
                    source: im.source,
                    doc: Concat([l.doc, im.doc, tc.doc]),
                });
                set w = tc.w;
            } else {
                let it = w.item()?;
                let tc = it.w.trailing_comment();
                set items.push(Concat([l.doc, it.doc, tc.doc]));
                set w = tc.w;
            };
        };
    }
    ok(WProgram { w, imports, items })
}

// The imports in hoist order. Two imports from the same source share a key;
// `sort_by` is stable, so they stay in source order.
fn sorted_imports(entries: ImportEntry[]) -> Doc[] {
    entries.sort_by(|a, b| import_source_precedes(a.source, b.source)).map(|e| e.doc)
}

fn item(self: W) -> WDoc!FmtError {
    let t = self.peek_text();
    if (t == "pub" || t == "fn") {
        return self.fn_item();
    };
    if (t == "struct") {
        return self.struct_item();
    };
    if (t == "variant") {
        return self.variant_item();
    };
    err(self.err_here(`formatter: expected an item (fn/struct/variant/import), found "{t}"`))
}

fn fn_item(self: W) -> WDoc!FmtError {
    let head = if (self.peek_text() == "pub") {
        WDocs { w: self.bump().w, docs: [Text("pub ")] }
    } else {
        WDocs { w: self, docs: [] }
    };
    let n = head.w.expect("fn")?.w.bump();
    let tps = n.w.type_params()?;
    let params = tps.w.expect("(")?.w.params_until(")", [])?;
    let closed = params.w.expect(")")?.w;
    let sig = [
        ..head.docs,
        Text("fn "),
        Text(n.text),
        tps.doc,
        comma_list_docs(params.docs, Parens),
    ];
    let effs = closed.fn_effects(sig);
    let ret = if (effs.w.peek_text() == "->") {
        effs.w.fn_return(effs.docs)?
    } else {
        WDocs { w: effs.w, docs: effs.docs }
    };
    let body = ret.w.fn_body()?;
    let attrs = body.w.fn_attrs([..ret.docs, Text(" "), body.doc])?;
    ok(WDoc { w: attrs.w, doc: Concat(attrs.docs) })
}

// A function body: an ordinary statement block, or the *struct-literal
// shorthand* `{ field: value, .. }`, which names no type because the declared
// return type supplies it. The shorthand is laid out like the struct literal it
// stands for — flat while it fits — not like a block, which always breaks.
//
// `{ x }` stays a block returning `x`, so the shorthand is recognized by the
// token *after* the first one: neither `IDENT :` nor `IDENT ,` can begin a
// statement, and no other body shape puts `:` or `,` in that position (a tuple
// or array literal leads with `(`/`[`, a call's comma sits past its `(`). That
// is the grammar's own rule, so testing the following token alone keeps the two
// parsers in step — testing the field name's *kind* would not, since a field
// may be named `str`, which the formatter classifies as a builtin type rather
// than an identifier.
fn fn_body(self: W) -> WDoc!FmtError {
    if (self.peek_text() != "{") {
        return self.block();
    };

    // `{ ..base, field: value }` — the spread form. Settled by the token right
    // after the `{`, not the one after that: `..` cannot begin a statement, so
    // there is nothing for it to be confused with.
    if (self.peek_text_n(1) == "..") {
        return self.bump().w.construct_body();
    };
    let after = self.peek_text_n(2);
    if (after == ":" || after == ",") {
        return self.bump().w.construct_body();
    };
    self.block()
}

// The shorthand body's field list, entered with the `{` already consumed.
// Mirrors `struct_atom` without the leading type name.
//
// One wrinkle the ordinary struct literal doesn't have: in `{ id, }` — a single
// *shorthand* field — the comma is **syntax, not style**. Drop it and `{ id }`
// reads back as a block whose value is `id`, so formatting would change what the
// source means. `comma_list_docs` writes a trailing comma only when the list
// breaks (`IfBroken`), which is not enough here, so that comma is written into
// the item itself and the style's own one switched off. Every other shape
// already carries a comma or a colon between the braces and formats as usual.
fn construct_body(self: W) -> WDoc!FmtError {
    let lone_shorthand = self.peek_text_n(1) == "," && self.peek_text_n(2) == "}";
    let inits = self.struct_inits([])?;
    let closed = inits.w.expect("}")?.w;
    if (lone_shorthand) {
        // Write the comma into the item itself so it survives *both* layouts,
        // and switch off the style's own break-only trailing comma so the
        // broken form doesn't end up with two.
        let item = Concat([..inits.docs, Text(",")]);
        return ok(WDoc { w: closed, doc: comma_list_docs([item], SpacedBracesNoTrailing) });
    };
    ok(WDoc { w: closed, doc: comma_list_docs(inits.docs, SpacedBraces) })
}

// `!prints`, `!reads`, … — a run of effect annotations after the parameters.
fn fn_effects(self: W, acc0: Doc[]) -> WDocs {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == "!") {
        let e = w.bump().w.bump();
        set acc.push(Text(` !{e.text}`));
        set w = e.w;
    }
    WDocs { w, docs: acc }
}

fn fn_return(self: W, acc: Doc[]) -> WDocs!FmtError {
    let t = self.bump().w.ty()?;
    ok(WDocs { w: t.w, docs: [..acc, Text(" -> "), t.doc] })
}

// `.test({ .. })` / `.doc("..")` attributes, glued to the closing brace the way
// the corpus writes them.
fn fn_attrs(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == ".") {
        let a = w.bump().w.bump();
        let opened = a.w.expect("(")?.w;

        // A `.test` body is a block; a `.doc` argument is its string verbatim —
        // a `"""` raw block aligns its closing delimiter under the opening one.
        let arg = if (opened.peek_text() == "{") {
            opened.block()?
        } else {
            opened.bump().str_atom()
        };
        set acc.push(Text(`.{a.text}(`));
        set acc.push(arg.doc);
        set acc.push(Text(")"));
        set w = arg.w.expect(")")?.w;
    }
    ok(WDocs { w, docs: acc })
}

// Parameters of a fn declaration, up to (not consuming) `end`.
fn params_until(self: W, end: str, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before(end)) {
        let l = w.lead();
        let m = if (l.w.peek_text() == "mut") {
            WDocs { w: l.w.bump().w, docs: [l.doc, Text("mut ")] }
        } else {
            WDocs { w: l.w, docs: [l.doc] }
        };
        let n = m.w.bump();
        let t = n.w.expect(":")?.w.ty()?;
        let typed = [..m.docs, Text(n.text), Text(": "), t.doc];
        // The variadic marker.
        let v = if (t.w.peek_text() == "*") {
            WDocs { w: t.w.bump().w, docs: typed.push(Text("*")) }
        } else {
            WDocs { w: t.w, docs: typed }
        };

        // A keyword parameter's declaration default keeps spaces around `=`,
        // unlike a call-site keyword argument.
        let d = if (v.w.peek_text() == "=") {
            v.w.spaced_default(v.docs)?
        } else {
            WDocs { w: v.w, docs: v.docs }
        };
        set acc.push(Concat(d.docs));
        set w = if (d.w.peek_text() == ",") { d.w.bump().w } else { d.w };
    }
    ok(WDocs { w, docs: acc })
}

fn spaced_default(self: W, acc: Doc[]) -> WDocs!FmtError {
    let e = self.bump().w.expr()?;
    ok(WDocs { w: e.w, docs: [..acc, Text(" = "), e.doc] })
}

fn struct_item(self: W) -> WDoc!FmtError {
    let n = self.expect("struct")?.w.bump();
    let tps = n.w.type_params()?;
    let fields = tps.w.expect("{")?.w.struct_fields([])?;
    let closed = fields.w.expect("}")?.w;
    ok(WDoc {
        w: closed,
        doc: Concat([
            Text(`struct {n.text}`),
            tps.doc,
            Text(" "),
            comma_list_docs(fields.docs, SpacedBraces),
        ]),
    })
}

fn struct_fields(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let l = w.lead();
        let f = l.w.bump();
        let t = f.w.expect(":")?.w.ty()?;
        let base = [l.doc, Text(f.text), Text(": "), t.doc];
        let d = if (t.w.peek_text() == "=") {
            t.w.spaced_default(base)?
        } else {
            WDocs { w: t.w, docs: base }
        };
        set acc.push(Concat(d.docs));
        set w = if (d.w.peek_text() == ",") { d.w.bump().w } else { d.w };
    }
    ok(WDocs { w, docs: acc })
}

// ---------- blocks & statements ----------

// A block's entries, plus the offset the next blank-line decision measures from.
struct WEntries { w: W, entries: Doc[], prev_end: u64 }

// A `{ .. }` block as its own independently-breaking group.
fn block(self: W) -> WDoc!FmtError {
    let b = self.block_layout()?;
    ok(WDoc { w: b.w, doc: group(b.doc) })
}

// A `{ .. }` block: statements (`;`-terminated) plus an optional trailing
// expression. `{}` when empty, `{ expr }` when a lone trailing expression fits,
// one statement per line otherwise. *Not* wrapped in a group, so a caller can
// place several blocks under one shared group (an `if`/`else` breaks both
// branches together) — `block` is the grouped form.
fn block_layout(self: W) -> WDoc!FmtError {
    let opened = self.expect("{")?.w;
    let body_start = opened.pos;
    let e = opened.block_entries([], opened.last_end)?;

    // A block containing any statement (a `;` anywhere inside it — nested ones
    // form their own block first, so the distinction doesn't matter) always lays
    // out one line per statement. Only a pure single-expression body may stay
    // flat.
    let has_stmt = e.w.range_has_semi(body_start..e.w.pos);
    let closed = e.w.expect("}")?.w;
    if (e.entries.len() == 0) {
        return ok(WDoc { w: closed, doc: Text("{}") });
    };
    let edge = if (has_stmt) { HardLine } else { Line };
    ok(WDoc {
        w: closed,
        doc: Concat([Text("{"), Indent(Concat([edge, ..e.entries])), edge, Text("}")]),
    })
}

// A loop rather than recursion: the depth would otherwise be one frame per
// statement, and AIPL frames are large enough (structs by value, plus a stack
// slot per composite temporary) that a big function body exhausts the native
// stack. The same reasoning applies to `program_items`.
fn block_entries(self: W, entries0: Doc[], prev_end0: u64) -> WEntries!FmtError {
    mut w = self;
    mut entries = entries0;
    mut prev_end = prev_end0;
    mut open = true;
    while (open) {
        // Comments before the next statement (or the closing brace).
        let l = w.lead();
        let had_lead = !l.doc.is_empty_doc();
        set w = l.w;
        if (had_lead) {
            let blank = w.gap_has_blank(prev_end..max(prev_end, w.last_end));
            set entries.push(sep_entry(blank, 0 < entries.len()));
            set entries.push(l.doc);

            // `lead` already ends with a line break per comment; the next entry
            // continues under it.
            set prev_end = w.last_end;
        };
        if (w.peek_text() == "}") {
            // Drop the line break `lead` left dangling before `}` — the closing
            // edge supplies it.
            if (had_lead) {
                set entries = entries.trim_last_break();
            };
            set open = false;
        } else {
            let start = w.next_start();
            let stmt = w.statement()?;
            if (!had_lead) {
                let blank = w.gap_has_blank(prev_end..start);
                set entries.push(sep_entry(blank, 0 < entries.len()));
            };
            let tc = stmt.w.trailing_comment();
            set entries.push(stmt.doc);
            set entries.push(tc.doc);
            set w = tc.w;
            set prev_end = tc.w.last_end;
        };
    }
    ok(WEntries { w, entries, prev_end })
}

fn trim_last_break(self: Doc[]) -> Doc[] {
    let n = self.len();
    if (n == 0) {
        return self;
    };
    self.with_last(self[n - 1].value_or(Concat([])).without_trailing_break())
}

// Whether any token in `[lo, hi)` is a `;`. A loop, not recursion: this scans
// every token of a block, so on a large one the recursive form ran the native
// stack out (AIPL does not guarantee tail-call elimination).
fn range_has_semi(self: W, span: Span) -> bool {
    mut i = span.start;
    while (i < span.end) {
        if (self.tok_text(i) == ";") {
            return true;
        };
        set i++;
    }
    false
}

// One statement (consuming its `;`) or the block's trailing expression.
fn statement(self: W) -> WDoc!FmtError {
    let t = self.peek_text();
    if (t == "let") {
        return self.let_stmt();
    };
    if (t == "mut") {
        return self.mut_stmt();
    };
    if (t == "set") {
        return self.set_stmt();
    };
    if (t == "return") {
        let v = self.bump().w.expr()?;
        let done = v.w.expect(";")?.w;
        return ok(WDoc { w: done, doc: Concat([Text("return "), v.doc, Text(";")]) });
    };
    if (t == "for") {
        return self.for_stmt();
    };
    if (t == "while") {
        return self.while_stmt();
    };
    let e = self.expr()?;
    if (e.w.peek_text() != ";") {
        // The block's trailing (value) expression.
        return ok(e);
    };
    ok(WDoc { w: e.w.bump().w, doc: Concat([e.doc, Text(";")]) })
}

// `let x = e;`, `let x: T = e;`, `let (a, b) = e;`, or `let Name { a, b } = e;`.
fn let_stmt(self: W) -> WDoc!FmtError {
    let kw = self.bump().w;
    if (kw.peek_text() == "(") {
        let ids = kw.bump().w.ident_list(")", []);
        let v = ids.w.expect(")")?.w.expect("=")?.w.expr()?;
        let done = v.w.expect(";")?.w;
        return ok(WDoc {
            w: done,
            doc: Concat([Text(`let ({ids.names.join(", ")}) = `), v.doc, Text(";")]),
        });
    };
    let n = kw.bump();
    if (n.w.peek_text() == "{") {
        let ids = n.w.bump().w.ident_list("}", []);
        let v = ids.w.expect("}")?.w.expect("=")?.w.expr()?;
        let done = v.w.expect(";")?.w;
        return ok(WDoc {
            w: done,
            doc: Concat([Text(`let {n.text} \{ {ids.names.join(", ")} } = `), v.doc, Text(";")]),
        });
    };
    let a = n.w.binding_ann()?;
    let v = a.w.expect("=")?.w.expr()?;
    let done = v.w.expect(";")?.w;
    ok(WDoc { w: done, doc: Concat([Text(`let {n.text}`), a.doc, Text(" = "), v.doc, Text(";")]) })
}

fn mut_stmt(self: W) -> WDoc!FmtError {
    let n = self.bump().w.bump();
    let a = n.w.binding_ann()?;
    let v = a.w.expect("=")?.w.expr()?;
    let done = v.w.expect(";")?.w;
    ok(WDoc { w: done, doc: Concat([Text(`mut {n.text}`), a.doc, Text(" = "), v.doc, Text(";")]) })
}

// The optional `: T` on a `let`/`mut` binding, rendered as `": T"` (empty when
// absent). Positioned after the name and before the `=`, so both callers can
// splice it in unconditionally.
fn binding_ann(self: W) -> WDoc!FmtError {
    if (self.peek_text() != ":") {
        return ok(WDoc { w: self, doc: Text("") });
    };
    let t = self.bump().w.ty()?;
    ok(WDoc { w: t.w, doc: Concat([Text(": "), t.doc]) })
}.test({
    // `toks_of` splits on spaces, so these inputs are spelled token-by-token.
    assert(walker_of(": u8 =").binding_ann().rendered(100)? == ": u8");
    assert(walker_of(": i8 [ ] =").binding_ann().rendered(100)? == ": i8[]");
    assert(walker_of(": # { str : u8 } =").binding_ann().rendered(100)? == ": #{str: u8}");
    assert(walker_of(": Point ? =").binding_ann().rendered(100)? == ": Point?");
    // Absent: renders nothing and consumes nothing.
    assert(walker_of("= 1 ;").binding_ann().rendered(100)? == "");
})

// `set n = e;`, `set n++;`, `set recv.f.g = e;`, or the writeback form
// `set recv.method(args);`.
fn set_stmt(self: W) -> WDoc!FmtError {
    let n = self.bump().w.bump();
    if (n.w.peek_text() == "++") {
        let done = n.w.bump().w.expect(";")?.w;
        return ok(WDoc { w: done, doc: Text(`set {n.text}++;`) });
    };
    if (n.w.peek_text() == ".") {
        return n.w.set_member(n.text);
    };
    let v = n.w.expect("=")?.w.expr()?;
    let done = v.w.expect(";")?.w;
    ok(WDoc { w: done, doc: Concat([Text(`set {n.text} = `), v.doc, Text(";")]) })
}

// After `set recv`, a `.`-led path: the token after the last member (`(` vs `=`)
// picks between a mutating-method writeback and a field assignment.
fn set_member(self: W, name: str) -> WDoc!FmtError {
    let p = self.member_path(name);
    if (p.w.peek_text() == "=") {
        let v = p.w.bump().w.expr()?;
        let done = v.w.expect(";")?.w;
        return ok(WDoc { w: done, doc: Concat([Text(`set {p.text} = `), v.doc, Text(";")]) });
    };
    let opened = p.w.expect("(")?.w;
    let hug = opened.hugs_sole_arg();
    let args = opened.call_args_until(")", [])?;
    let done = args.w.expect(")")?.w.expect(";")?.w;
    ok(WDoc {
        w: done,
        doc: Concat([Text(`set {p.text}`), call_arg_list(args.docs, hug), Text(";")]),
    })
}

fn member_path(self: W, acc0: str) -> WStr {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == ".") {
        let m = w.bump().w.bump();
        set acc = `{acc}.{m.text}`;
        set w = m.w;
    }
    WStr { w, text: acc }
}

fn for_stmt(self: W) -> WDoc!FmtError {
    let opened = self.bump().w.expect("(")?.w.expect("let")?.w;
    let binder = if (opened.peek_text() == "(") {
        opened.tuple_binder()
    } else {
        let b = opened.bump();
        if (b.w.peek_text() == ",") {
            // `for (let i, x : xs)` — the index-and-item form: two names, and the
            // comma is part of the binder rather than a separator the header
            // walker would otherwise stop on.
            let item = b.w.bump().w.bump();
            WStr { w: item.w, text: `{b.text}, {item.text}` }
        } else {
            WStr { w: b.w, text: b.text }
        }
    };
    let it = binder.w.expect(":")?.w.expr()?;
    let body = it.w.expect(")")?.w.block()?;
    ok(WDoc {
        w: body.w,
        doc: Concat([Text(`for (let {binder.text} : `), it.doc, Text(") "), body.doc]),
    })
}

fn tuple_binder(self: W) -> WStr {
    let ids = self.bump().w.ident_list(")", []);

    // The `)` here closes the binder; `for_stmt`'s own `expect(")")` closes the
    // header, so consume this one.
    match (ids.w.expect(")")) {
        ok(s) => WStr { w: s.w, text: `({ids.names.join(", ")})` },
        err(_) => WStr { w: ids.w, text: `({ids.names.join(", ")})` },
    }
}

fn while_stmt(self: W) -> WDoc!FmtError {
    let cond = self.bump().w.expect("(")?.w.expr()?;
    let body = cond.w.expect(")")?.w.block()?;
    ok(WDoc { w: body.w, doc: Concat([Text("while ("), cond.doc, Text(") "), body.doc]) })
}

// A bare comma-separated identifier list up to (not consuming) `end` — binder
// names and constructor-pattern bindings, which are names rather than types.
struct WNames { w: W, names: str[] }

fn ident_list(self: W, end: str, acc0: str[]) -> WNames {
    mut w = self;
    mut acc = acc0;
    while (!(w.peek_text() == end || w.at_end())) {
        let n = w.bump();
        set acc.push(n.text);
        set w = if (n.w.peek_text() == ",") { n.w.bump().w } else { n.w };
    }
    WNames { w, names: acc }
}

// ---------- expressions ----------

// One postfix segment, tagged so a long chain can break before each *call*
// rather than exploding an inner argument list.
struct Seg { is_call: bool, doc: Doc }

struct WSegs { w: W, segs: Seg[] }

struct WSeg { w: W, seg: Seg }

// `a..b` — range construction, spelled tight like the slice forms. A `..`
// directly followed by `]` is the open-ended slice postfix instead, left for the
// bracket code in `postfix`. Left-assoc, mirroring the grammar (`a..b..c` parses,
// even though it can only fail the type check later).
fn expr(self: W) -> WDoc!FmtError {
    let first = self.binop_expr()?;
    first.w.range_tail(first.doc)
}

fn range_tail(self: W, acc0: Doc) -> WDoc!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == ".." && w.peek_text_n(1) != "]") {
        let rhs = w.bump().w.binop_expr()?;
        set acc = Concat([acc, Text(".."), rhs.doc]);
        set w = rhs.w;
    }
    ok(WDoc { w, doc: acc })
}

fn binop_expr(self: W) -> WDoc!FmtError {
    let l = self.lead();
    let first = l.w.unary()?;
    let tail = first.w.binop_tail([])?;

    // Flat: `a + b + c`; broken: continuation lines led by the operator, one
    // indent in. No operator at all means no group to make.
    let d = if (tail.docs.len() == 0) {
        first.doc
    } else {
        group(Concat([first.doc, ..tail.docs]))
    };
    ok(WDoc { w: tail.w, doc: Concat([l.doc, d]) })
}

fn binop_tail(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (is_binop(w.peek_text())) {
        let op = w.bump();
        let lead_rhs = op.w.lead();
        let rhs = lead_rhs.w.unary()?;

        // The operator glues to the current line — `lhs == rhs` — rather than
        // being pushed onto its own indented continuation line. When the line is
        // too long the right operand breaks its *own* structure (a call's
        // argument list, a multi-line `"""` block) instead, so the closing
        // delimiter aligns with the statement and the operator stays put. A right
        // operand carrying a leading comment is the exception: the comment needs
        // its own line, so that case keeps the break-before-operator layout.
        let seg = if (lead_rhs.doc.is_empty_doc()) {
            Concat([Text(" "), Text(op.text), Text(" "), rhs.doc])
        } else {
            Indent(Concat([Line, Text(op.text), Text(" "), lead_rhs.doc, rhs.doc]))
        };
        set acc.push(seg);
        set w = rhs.w;
    }
    ok(WDocs { w, docs: acc })
}

fn is_binop(t: str) -> bool {
    t == "+" || t == "+++" || t == "-" || t == "*" || t == "/" || t == "%" || t == "==" || t == "!=" || t == "<" || t == ">" || t == "<=" || t == ">=" || t == "&&" || t == "||"
}

fn unary(self: W) -> WDoc!FmtError {
    if (self.peek_text() == "-" || self.peek_text() == "!") {
        let op = self.bump();
        let rest = op.w.unary()?;
        return ok(WDoc { w: rest.w, doc: Concat([Text(op.text), rest.doc]) });
    };
    self.postfix()
}

fn postfix(self: W) -> WDoc!FmtError {
    let head = self.atom()?;
    let segs = head.w.postfix_segs([])?;
    if (segs.segs.len() == 0) {
        return ok(WDoc { w: segs.w, doc: head.doc });
    };

    // A "member chain" (2+ method calls) becomes one group that, when it can't
    // fit, breaks before every call segment — the receiver ends up alone on the
    // first line and each `.method(..)` starts its own indented line. Fewer than
    // two calls: no chain break (a lone call's own argument list may still break).
    if (call_count(segs.segs) < 2) {
        return ok(WDoc { w: segs.w, doc: Concat([head.doc, ..segs.segs.map(|s| s.doc)]) });
    };
    ok(WDoc { w: segs.w, doc: group(Concat([head.doc, Indent(Concat(chain_docs(segs.segs)))])) })
}

fn postfix_segs(self: W, acc0: Seg[]) -> WSegs!FmtError {
    mut w = self;
    mut acc = acc0;
    mut more = true;
    while (more) {
        let t = w.peek_text();
        if (t == ".") {
            let d = w.dot_seg()?;
            set acc.push(d.seg);
            set w = d.w;
        } else {
            if (t == "[") {
                let d = w.index_seg()?;
                set acc.push(d.seg);
                set w = d.w;
            } else {
                if (t == "?") {
                    set acc.push(Seg { is_call: false, doc: Text("?") });
                    set w = w.bump().w;
                } else {
                    set more = false;
                };
            };
        };
    }
    ok(WSegs { w, segs: acc })
}

// `.member` or `.method(args)` — field access glues to its left; a call is
// tagged so the chain layout can break before it.
fn dot_seg(self: W) -> WSeg!FmtError {
    let m = self.bump().w.bump();
    if (m.w.peek_text() != "(") {
        return ok(WSeg { w: m.w, seg: Seg { is_call: false, doc: Text(`.{m.text}`) } });
    };
    let hug = m.w.bump().w.hugs_sole_arg();
    let args = m.w.bump().w.call_args_until(")", [])?;
    let closed = args.w.expect(")")?.w;
    ok(WSeg {
        w: closed,
        seg: Seg { is_call: true, doc: Concat([Text(`.{m.text}`), call_arg_list(args.docs, hug)]) },
    })
}

// `[i]`, `[a..b]`, `[a..]`, `[..b]` — indexing and the slice forms.
fn index_seg(self: W) -> WSeg!FmtError {
    let opened = self.bump().w;
    let inner = if (opened.peek_text() == "..") {
        opened.slice_to()?
    } else {
        opened.index_or_from()?
    };
    let closed = inner.w.expect("]")?.w;
    ok(WSeg {
        w: closed,
        seg: Seg { is_call: false, doc: Concat([Text("["), ..inner.docs, Text("]")]) },
    })
}

// `[..b]` — open-ended on the left.
fn slice_to(self: W) -> WDocs!FmtError {
    let e = self.bump().w.expr()?;
    ok(WDocs { w: e.w, docs: [Text(".."), e.doc] })
}

// `[i]`, `[a..b]`, or `[a..]`.
fn index_or_from(self: W) -> WDocs!FmtError {
    let a = self.expr()?;
    if (a.w.peek_text() != "..") {
        return ok(WDocs { w: a.w, docs: [a.doc] });
    };
    let dots = a.w.bump().w;
    if (dots.peek_text() == "]") {
        return ok(WDocs { w: dots, docs: [a.doc, Text("..")] });
    };
    let b = dots.expr()?;
    ok(WDocs { w: b.w, docs: [a.doc, Text(".."), b.doc] })
}

fn call_count(segs: Seg[]) -> u64 {
    mut n: u64 = 0;
    for (let s : segs) {
        if (s.is_call) {
            set n++;
        };
    }
    n
}

// The chain layout: a `SoftLine` before every call segment, so a break puts each
// `.method(..)` on its own line while field access stays glued.
fn chain_docs(segs: Seg[]) -> Doc[] {
    mut out = [];
    for (let s : segs) {
        if (s.is_call) {
            set out.push(SoftLine);
        };
        set out.push(s.doc);
    }
    out
}

// ---------- atoms ----------

fn atom(self: W) -> WDoc!FmtError {
    // Kind-dispatched forms first: a template literal is copied verbatim, and a
    // string / number / char / constant is its own text.
    if (self.peek_is(TplHead)) {
        return self.template_verbatim();
    };
    if (self.peek_is(StrTok)) {
        return ok(self.bump().str_atom());
    };
    if (self.peek_is(Num) || self.peek_is(CharTok) || self.peek_is(Constant)) {
        let b = self.bump();
        return ok(WDoc { w: b.w, doc: Text(b.text) });
    };
    let t = self.peek_text();
    if (t == "if") {
        return self.if_expr();
    };
    if (t == "match") {
        return self.match_expr();
    };
    if (t == "shim") {
        return self.shim_expr();
    };

    // A lambda used as a value (`let f = |x: i64| { .. }`). Only the single-`|`
    // form reaches expression position; `||` there would be a binary operator.
    if (t == "|") {
        return self.lambda();
    };
    if (t == "(") {
        return self.paren_atom();
    };
    if (t == "[") {
        return self.array_atom();
    };
    if (t == "#") {
        return self.set_or_dict_atom();
    };
    self.name_atom()
}

// A `"""..."""` raw string is a `RawBlock` so its closing delimiter aligns under
// the opening one; a plain `"..."` string is ordinary verbatim text.
fn str_atom(self: WStr) -> WDoc {
    let d = if (self.text.starts_with(`"""`)) { RawBlock(self.text) } else { Text(self.text) };
    WDoc { w: self.w, doc: d }
}

// `(e)` — a parenthesized expression, or a tuple literal when a comma follows.
fn paren_atom(self: W) -> WDoc!FmtError {
    let first = self.bump().w.expr()?;
    if (first.w.peek_text() != ",") {
        let closed = first.w.expect(")")?.w;
        return ok(WDoc { w: closed, doc: Concat([Text("("), first.doc, Text(")")]) });
    };
    let rest = first.w.tuple_rest([first.doc])?;
    let closed = rest.w.expect(")")?.w;
    ok(WDoc { w: closed, doc: comma_list_docs(rest.docs, Parens) })
}

fn tuple_rest(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.peek_text() == ",") {
        let stepped = w.bump().w;

        // A trailing comma before `)` ends the tuple rather than starting an
        // element.
        if (stepped.peek_text() == ")") {
            return ok(WDocs { w: stepped, docs: acc });
        };
        let e = stepped.expr()?;
        set acc.push(e.doc);
        set w = e.w;
    }
    ok(WDocs { w, docs: acc })
}

fn array_atom(self: W) -> WDoc!FmtError {
    let elems = self.bump().w.call_args_until("]", [])?;
    let closed = elems.w.expect("]")?.w;
    ok(WDoc { w: closed, doc: comma_list_docs(elems.docs, Brackets) })
}

// `#{a, b}` (set) / `#{k: v}` (dict), and the empty-dict spelling `#{:}`.
fn set_or_dict_atom(self: W) -> WDoc!FmtError {
    let opened = self.bump().w.expect("{")?.w;
    if (opened.peek_text() == ":") {
        let closed = opened.bump().w.expect("}")?.w;
        return ok(WDoc { w: closed, doc: Text("#{:}") });
    };
    let entries = opened.dict_entries([])?;
    let closed = entries.w.expect("}")?.w;
    ok(WDoc { w: closed, doc: comma_list_docs(entries.docs, HashBraces) })
}

fn dict_entries(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let l = w.lead();
        let k = l.w.expr()?;
        let e = if (k.w.peek_text() == ":") {
            k.w.dict_value(l.doc, k.doc)?
        } else {
            WDoc { w: k.w, doc: Concat([l.doc, k.doc]) }
        };
        set acc.push(e.doc);
        set w = if (e.w.peek_text() == ",") { e.w.bump().w } else { e.w };
    }
    ok(WDocs { w, docs: acc })
}

fn dict_value(self: W, lead: Doc, k: Doc) -> WDoc!FmtError {
    let v = self.bump().w.expr()?;
    ok(WDoc { w: v.w, doc: Concat([lead, k, Text(": "), v.doc]) })
}

// An identifier-led atom: a bare name, a call `f(..)`, or a struct construction
// `Name { field: value, .. }`.
fn name_atom(self: W) -> WDoc!FmtError {
    if (!(self.peek_is(Ident) || self.peek_is(BuiltinType) || self.peek_is(Keyword))) {
        return err(self.err_here(`formatter: expected an expression, found "{self.peek_text()}"`));
    };
    let n = self.bump();
    if (n.w.peek_text() == "(") {
        let hug = n.w.bump().w.hugs_sole_arg();
        let args = n.w.bump().w.call_args_until(")", [])?;
        let closed = args.w.expect(")")?.w;
        return ok(WDoc { w: closed, doc: Concat([Text(n.text), call_arg_list(args.docs, hug)]) });
    };
    if (n.w.peek_text() == "{") {
        return n.w.bump().w.struct_atom(n.text);
    };
    ok(WDoc { w: n.w, doc: Text(n.text) })
}

fn struct_atom(self: W, name: str) -> WDoc!FmtError {
    let inits = self.struct_inits([])?;
    let closed = inits.w.expect("}")?.w;
    if (inits.docs.len() == 0) {
        return ok(WDoc { w: closed, doc: Text(`{name} \{}`) });
    };
    ok(WDoc {
        w: closed,
        doc: Concat([Text(`{name} `), comma_list_docs(inits.docs, SpacedBraces)]),
    })
}

fn struct_inits(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let l = w.lead();

        // `..base` — a struct spread. It is one item, spelled tight against its
        // operand: bumping the `..` as if it were a field name would leave the
        // operand as a *separate* item, and the list would then write a comma
        // between them (`.., base`), which is a different literal.
        let e = if (l.w.peek_text() == "..") {
            let v = l.w.bump().w.expr()?;
            WDoc { w: v.w, doc: Concat([l.doc, Text(".."), v.doc]) }
        } else {
            let f = l.w.bump();

            // `field: value`, or the shorthand `field` (sugar for `field: field`)
            // — kept verbatim, not expanded.
            if (f.w.peek_text() == ":") {
                f.w.struct_field_value(l.doc, f.text)?
            } else {
                WDoc { w: f.w, doc: Concat([l.doc, Text(f.text)]) }
            }
        };
        set acc.push(e.doc);
        set w = if (e.w.peek_text() == ",") { e.w.bump().w } else { e.w };
    }
    ok(WDocs { w, docs: acc })
}

fn struct_field_value(self: W, lead: Doc, fname: str) -> WDoc!FmtError {
    let v = self.bump().w.expr()?;
    ok(WDoc { w: v.w, doc: Concat([lead, Text(`{fname}: `), v.doc]) })
}

// ---------- if / match / lambda / templates ----------

fn if_expr(self: W) -> WDoc!FmtError {
    let cond = self.expect("if")?.w.expect("(")?.w.expr()?;
    let closed = cond.w.expect(")")?.w;

    // The branches share one group (via the ungrouped `block_layout`), so they
    // break *together*: an `if`/`else` is either all on one line or both blocks
    // broken — never one inline and the other split. A trailing `else if` stays
    // its own group so a fitting tail can remain inline.
    let then_b = closed.block_layout()?;
    let head = [Text("if ("), cond.doc, Text(") "), then_b.doc];
    if (then_b.w.peek_text() != "else") {
        return ok(WDoc { w: then_b.w, doc: group(Concat(head)) });
    };
    let stepped = then_b.w.bump().w;
    let tail = if (stepped.peek_text() == "if") {
        stepped.if_expr()?
    } else {
        stepped.block_layout()?
    };
    ok(WDoc { w: tail.w, doc: group(Concat([..head, Text(" else "), tail.doc])) })
}

fn match_expr(self: W) -> WDoc!FmtError {
    let scrut = self.expect("match")?.w.expect("(")?.w.expr()?;
    let opened = scrut.w.expect(")")?.w.expect("{")?.w;
    let arms = opened.match_arms([])?;
    let closed = arms.w.expect("}")?.w;
    let head = Concat([Text("match ("), scrut.doc, Text(") ")]);
    if (arms.docs.len() == 0) {
        return ok(WDoc { w: closed, doc: Concat([head, Text("{}")]) });
    };

    // A `match` always lays out one arm per line (hard breaks), never collapsing
    // onto a single line even when it would fit — and those hard breaks force any
    // enclosing group (a `let` value, a call argument) to break around it too.
    mut inner = [];
    for (let a : arms.docs) {
        set inner.push(HardLine);
        set inner.push(a);
    }
    ok(WDoc {
        w: closed,
        doc: Concat([head, Text("{"), Indent(Concat(inner)), HardLine, Text("}")]),
    })
}

// `shim <effect> { op = f, .. } { body }`. The bindings group like a call's
// arguments — flat when they fit, one per line when they don't — and the body is
// laid out as an ordinary block.
fn shim_expr(self: W) -> WDoc!FmtError {
    let effect = self.expect("shim")?.w.bump();
    let opened = effect.w.expect("{")?.w;
    let binds = opened.shim_bindings([])?;
    let closed = binds.w.expect("}")?.w;
    let body = closed.block_layout()?;
    let list = comma_list_docs(binds.docs, SpacedBraces);
    ok(WDoc {
        w: body.w,
        doc: group(Concat([Text(`shim {effect.text} `), list, Text(" "), body.doc])),
    })
}

// `op = f` pairs up to (not consuming) the closing brace, trailing comma allowed.
fn shim_bindings(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let op = w.bump();
        let f = op.w.expect("=")?.w.bump();
        set acc.push(Text(`{op.text} = {f.text}`));
        set w = if (f.w.peek_text() == ",") { f.w.bump().w } else { f.w };
    }
    ok(WDocs { w, docs: acc })
}

fn match_arms(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("}")) {
        let l = w.lead();
        let pat = l.w.pattern()?;
        let alts = pat.w.pattern_alts(pat.doc)?;
        let after = alts.w.expect("=>")?.w;

        // A statement-block arm (`P => { .. }`) lays out as a block, exactly like
        // an `if` branch; every other arm body is a single expression. One token
        // of lookahead decides, matching the grammar — no expression starts `{`.
        let body = if (after.peek_text() == "{") { after.block()? } else { after.expr()? };
        let stepped = if (body.w.peek_text() == ",") { body.w.bump().w } else { body.w };
        // A same-line `// comment` after the arm rides on its line.
        let tc = stepped.trailing_comment();
        set acc.push(Concat([l.doc, alts.doc, Text(" => "), body.doc, Text(","), tc.doc]));
        set w = tc.w;
    }
    ok(WDocs { w, docs: acc })
}

// `A | B | C => body` — the `| P` tail of an alternation, folded onto the doc
// for the pattern already parsed. A group with `Line` before each `|`, so a
// short alternation stays on one line (`Line` renders flat as a space, giving
// `A | B`) and a long one breaks with the `|` leading each continuation.
fn pattern_alts(self: W, first: Doc) -> WDoc!FmtError {
    mut w = self;
    mut parts = [first];
    while (w.peek_text() == "|") {
        let next = w.bump().w.pattern()?;
        set parts.push(Line);
        set parts.push(Text("| "));
        set parts.push(next.doc);
        set w = next.w;
    }

    // A lone pattern is not an alternation — hand back the doc untouched rather
    // than wrapping every ordinary arm in a group that can never break.
    if (parts.len() == 1) {
        return ok(WDoc { w, doc: first });
    };
    ok(WDoc { w, doc: Group(false, Concat(parts)) })
}

fn pattern(self: W) -> WDoc!FmtError {
    // A literal pattern — a string (`"lit" => ..`, str scrutinee) or a char
    // (`'c' => ..`, char scrutinee) — lays out as its verbatim source, so its
    // escapes round-trip untouched.
    if (self.peek_is(StrTok) || self.peek_is(CharTok)) {
        let b = self.bump();
        return ok(WDoc { w: b.w, doc: Text(b.text) });
    };
    if (self.peek_text() == "[") {
        let elems = self.bump().w.call_args_until("]", [])?;
        let closed = elems.w.expect("]")?.w;
        return ok(WDoc { w: closed, doc: comma_list_docs(elems.docs, Brackets) });
    };
    let n = self.bump();
    // A variant-qualified constructor pattern `V.A` / `V.A(ids)`.
    let q = if (n.w.peek_text() == ".") { n.w.qualified_case(n.text) } else { n };
    if (q.w.peek_text() != "(") {
        return ok(WDoc { w: q.w, doc: Text(q.text) });
    };
    let ids = q.w.bump().w.ident_list(")", []);
    let closed = ids.w.expect(")")?.w;
    ok(WDoc { w: closed, doc: Text(`{q.text}({ids.names.join(", ")})`) })
}

fn qualified_case(self: W, name: str) -> WStr {
    let c = self.bump().w.bump();
    WStr { w: c.w, text: `{name}.{c.text}` }
}

// Call-argument (or array-element) list up to `end`.
fn call_args_until(self: W, end: str, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before(end)) {
        let l = w.lead();
        let a = l.w.call_arg()?;
        set acc.push(Concat([l.doc, a.doc]));
        set w = if (a.w.peek_text() == ",") { a.w.bump().w } else { a.w };
    }
    ok(WDocs { w, docs: acc })
}

// One argument, plus the arg-only forms — keyword arguments (`k=1`, spelled
// tight), lambdas, and bare operator values (`apply(2, 3, +)`).
fn call_arg(self: W) -> WDoc!FmtError {
    // `..xs` — an array-literal spread, spelled tight against its operand. The
    // grammar hangs it off the shared argument rule, so it is accepted here and
    // rejected by the parser anywhere but an array literal; the formatter only
    // has to lay it out.
    if (self.peek_text() == "..") {
        let v = self.bump().w.expr()?;
        return ok(WDoc { w: v.w, doc: Concat([Text(".."), v.doc]) });
    };

    // `k = expr` -> tight `k=expr` (`==` is one token, so a lone `=` after an
    // identifier is unambiguous).
    if (self.peek_is(Ident) && self.peek_text_n(1) == "=") {
        let n = self.bump();
        let v = n.w.bump().w.expr()?;
        return ok(WDoc { w: v.w, doc: Concat([Text(`{n.text}=`), v.doc]) });
    };
    if (self.peek_text() == "|" || self.peek_text() == "||") {
        return self.lambda();
    };

    // A bare operator passed as a value: an operator token immediately followed
    // by `,` or a closing bracket.
    if (self.peek_is(Op) && is_arg_end(self.peek_text_n(1))) {
        let b = self.bump();
        return ok(WDoc { w: b.w, doc: Text(b.text) });
    };
    self.expr()
}

fn is_arg_end(t: str) -> bool { t == "," || t == ")" || t == "]" }

fn lambda(self: W) -> WDoc!FmtError {
    let params = if (self.peek_text() == "||") {
        WDocs { w: self.bump().w, docs: [] }
    } else {
        let opened = self.expect("|")?.w;
        let ps = opened.lambda_params([])?;
        WDocs { w: ps.w.expect("|")?.w, docs: ps.docs }
    };
    let body = if (params.w.peek_text() == "{") { params.w.block()? } else { params.w.expr()? };
    mut d = [Text("|"), ..params.docs.intersperse(Text(", "))];
    set d.push(Text("| "));
    set d.push(body.doc);
    ok(WDoc { w: body.w, doc: Concat(d) })
}

fn lambda_params(self: W, acc0: Doc[]) -> WDocs!FmtError {
    mut w = self;
    mut acc = acc0;
    while (w.more_before("|")) {
        let n = w.bump();
        let p = if (n.w.peek_text() == ":") {
            n.w.lambda_param_ty(n.text)?
        } else {
            WDoc { w: n.w, doc: Text(n.text) }
        };
        set acc.push(p.doc);
        set w = if (p.w.peek_text() == ",") { p.w.bump().w } else { p.w };
    }
    ok(WDocs { w, docs: acc })
}

fn lambda_param_ty(self: W, name: str) -> WDoc!FmtError {
    let t = self.bump().w.ty()?;
    ok(WDoc { w: t.w, doc: Concat([Text(`{name}: `), t.doc]) })
}

// Copy a template literal verbatim, from its head through the matching tail
// (interpolation contents included — the formatter does not reach inside
// templates).
fn template_verbatim(self: W) -> WDoc!FmtError {
    match (self.peek()) {
        none => err(self.err_here("formatter: unterminated template literal in token stream")),
        some(t) => self.template_scan(t.span.start, 0),
    }
}

fn template_scan(self: W, start: u64, depth0: u64) -> WDoc!FmtError {
    mut w = self;
    mut depth = depth0;
    while (!w.at_end()) {
        let t = w.cur_tok();
        let stepped = w.advance(t.span.end);
        if (t.kind == TplHead) {
            set depth++;
        } else {
            if (t.kind == TplTail) {
                if (depth <= 1) {
                    // A triple-backtick template is a raw block (its closing ```
                    // aligns under the opening); a single-backtick one has no
                    // own-line closing delimiter, so `reindent_block` leaves it
                    // untouched.
                    return ok(WDoc {
                        w: stepped.drop_comments_before(t.span.end),
                        doc: RawBlock(self.src[start..t.span.end]),
                    });
                };
                set depth = depth - 1;
            };
        };
        set w = stepped;
    }
    err(FmtError {
        message: "formatter: unterminated template literal in token stream",
        span: start..self.src.len(),
    })
}

// Comments inside interpolations came through the comment stream; they are
// inside the verbatim copy already, so drop them rather than double-emitting.
fn drop_comments_before(self: W, end: u64) -> W {
    mut w = self;
    while (w.comment_starts_before(end)) {
        set w = w.skip_comment();
    }
    w
}

// The next undrained comment. Callers test `comment_starts_before` first, so the
// empty fallback is unreachable — `value_or` cannot unwrap a struct optional, so
// this is the `match` form.
fn cur_comment(self: W) -> Span {
    match (self.comments[self.cpos]) {
        none => 0..0,
        some(c) => c,
    }
}

// The token at the cursor. Callers test `at_end` first, so the fallback is
// unreachable (same `match`-not-`value_or` reason as `cur_comment`).
fn cur_tok(self: W) -> FmtTok {
    match (self.peek()) {
        none => FmtTok { kind: Punct, span: 0..0 },
        some(t) => t,
    }
}

// Whether the next undrained comment begins before `end`.
fn comment_starts_before(self: W, end: u64) -> bool {
    self.comments[self.cpos].is_some_and(|c| c.start < end)
}

// ---------- call-argument layout ----------

// Whether the call whose `(` was just consumed takes exactly one argument that
// *is* a bracketed construct — a nested call, an array, a struct literal, or a
// set/dict literal — filling the parens end to end. Such a call is *hugged*: the
// argument's own brackets carry the break, so the nesting costs one indent level
// instead of one per layer. Pure lookahead over the token stream, no parse state.
fn hugs_sole_arg(self: W) -> bool {
    // Declines when a comment sits before the argument: it needs its own line,
    // above the whole call.
    if (self.comment_before_cursor()) {
        return false;
    };

    // The candidate's opening bracket: `[`/`#{` open directly, `name(`/`name {`
    // one token in.
    let t = self.peek_text();
    let direct = t == "[" || t == "#{";
    let indirect = self.peek_is(Ident) && (self.peek_text_n(1) == "(" || self.peek_text_n(
        1,
    ) == "{");
    if (!direct && !indirect) {
        return false;
    };
    let open_at = if (direct) { self.pos } else { self.pos + 1 };
    self.hug_close(open_at).is_some_and(|close| self.hug_fills_call(open_at, close))
}

// Index of the bracket closing the one at `start`, or `none` if unbalanced. A
// loop for the same reason as `range_has_semi`: it walks token by token to the
// match, which on a large construct is far too deep to recurse.
fn hug_close(self: W, start: u64) -> u64? {
    mut i = start;
    mut depth: u64 = 0;
    while (i < self.toks.len()) {
        let t = self.tok_text(i);
        if (t == "(" || t == "[" || t == "{" || t == "#{") {
            set depth++;
        } else {
            if (t == ")" || t == "]" || t == "}") {
                if (depth <= 1) {
                    return some(i);
                };
                set depth = depth - 1;
            };
        };
        set i++;
    }
    none
}

// Hug only a non-empty construct (`f()`/`[]` have nothing to hug) that runs all
// the way to the call's own `)` — otherwise the argument is a larger expression
// that merely *starts* with a bracketed one. Source that is already broken has a
// trailing comma after the argument, so step over one.
fn hug_fills_call(self: W, open_at: u64, close: u64) -> bool {
    let after = if (self.tok_text(close + 1) == ",") { close + 2 } else { close + 1 };
    open_at + 1 < close && self.tok_text(after) == ")"
}

// The `(..)` of a call: hugged when `hugs_sole_arg` approved, else the ordinary
// comma list.
fn call_arg_list(args: Doc[], hug: bool) -> Doc {
    if (hug && args.len() == 1) {
        return Concat([Text("("), args.first().value_or(Concat([])), Text(")")]);
    };
    comma_list_docs(args, Parens)
}

// ---------- test support ----------

// Tokenize `src` by splitting on single spaces — one token per run of non-space
// characters, each span pointing at the real text. Lets a test write the source
// it means (`"# { str : i64 }"`, one space between real tokens) instead of
// hand-computing byte offsets. Every token gets kind `Ident`: the walkers in this
// file dispatch on token *text*, not kind.
fn toks_of(src: str) -> FmtTok[] {
    mut out = [];
    mut start: u64 = 0;
    mut i: u64 = 0;
    while (i < src.len()) {
        if (src[i] == some(' ')) {
            if (start < i) {
                set out.push(FmtTok { kind: Ident, span: start..i });
            };
            set start = i + 1;
        };
        set i++;
    }
    if (start < i) {
        set out.push(FmtTok { kind: Ident, span: start..i });
    };
    out
}

// A walker over `src` tokenized by `toks_of`, with no comments.
fn walker_of(src: str) -> W { new_walker(src, toks_of(src), []) }.test({
    // `toks_of` splits on single spaces, spans pointing at the real text.
    let w = walker_of("a bc d");
    assert(w.peek_text() == "a");
    assert(w.peek_text_n(1) == "bc");
    assert(w.peek_text_n(2) == "d");
    assert(w.peek_text_n(3) == "");
    assert(walker_of("").at_end());

    // --- types ------------------------------------------------------------
    // A bare name, and the `?` / `[]` suffix runs, in source order.
    assert(walker_of("i64").ty().rendered(100)? == "i64");
    assert(walker_of("i64 ?").ty().rendered(100)? == "i64?");
    assert(walker_of("i64 [ ]").ty().rendered(100)? == "i64[]");
    assert(walker_of("i64 [ ] [ ]").ty().rendered(100)? == "i64[][]");
    assert(walker_of("i64 ? [ ]").ty().rendered(100)? == "i64?[]");
    assert(walker_of("i64 [ ] ?").ty().rendered(100)? == "i64[]?");

    // Set and dict types.
    assert(walker_of("# { str }").ty().rendered(100)? == "#{str}");
    assert(walker_of("# { str : i64 }").ty().rendered(100)? == "#{str: i64}");
    assert(walker_of("# { str : i64 } [ ]").ty().rendered(100)? == "#{str: i64}[]");

    // Generic application — `<`/`>` are unambiguously argument brackets here.
    assert(walker_of("Box < i64 >").ty().rendered(100)? == "Box<i64>");
    assert(walker_of("Map < str , i64 >").ty().rendered(100)? == "Map<str, i64>");
    // An `Angles` list takes no trailing comma even when broken.
    assert(walker_of("Map < str , i64 >").ty().rendered(1)? == "Map<\n    str,\n    i64\n>");

    // Results: `T!E`, and the void-ok `!E`.
    assert(walker_of("i64 ! str").ty().rendered(100)? == "i64!str");
    assert(walker_of("! Error").ty().rendered(100)? == "!Error");

    // Parenthesized: function type, tuple, tuple array.
    assert(walker_of("( i64 , str ) -> bool").ty().rendered(100)? == "(i64, str) -> bool");
    assert(walker_of("( i64 , str )").ty().rendered(100)? == "(i64, str)");
    assert(walker_of("( i64 , str ) [ ]").ty().rendered(100)? == "(i64, str)[]");
    // A function type nests on the right.
    assert(walker_of("( i64 ) -> ( str ) -> bool").ty().rendered(100)? == "(i64) -> (str) -> bool");

    // --- comma lists --------------------------------------------------------
    // Empty renders as just the brackets; no indent machinery.
    assert(print_doc(comma_list_docs([], Parens), 100) == "()");
    assert(print_doc(comma_list_docs([], SpacedBraces), 100) == "{}");
    // Flat: `SpacedBraces` pads, the rest hug.
    assert(print_doc(comma_list_docs([Text("a"), Text("b")], Parens), 100) == "(a, b)");
    assert(print_doc(comma_list_docs([Text("a"), Text("b")], SpacedBraces), 100) == "{ a, b }");
    assert(print_doc(comma_list_docs([Text("a")], Brackets), 100) == "[a]");
    assert(print_doc(comma_list_docs([Text("a")], HashBraces), 100) == "#{a}");
    // Broken: one per line, trailing comma only where the grammar allows it.
    assert(print_doc(comma_list_docs([Text("a"), Text("b")], Parens), 1) == "(\n    a,\n    b,\n)");
    assert(
        print_doc(comma_list_docs([Text("a"), Text("b")], TyParens), 1) == "(\n    a,\n    b\n)",
    );

    // --- type parameters ----------------------------------------------------
    // Absent is an empty doc, so a caller can concatenate it unconditionally.
    assert(walker_of("(").type_params().rendered(100)? == "");
    assert(walker_of("< T >").type_params().rendered(100)? == "<T>");
    assert(walker_of("< T : any >").type_params().rendered(100)? == "<T: any>");
    assert(walker_of("< T , U : ord >").type_params().rendered(100)? == "<T, U: ord>");

    // --- end to end, on real source ---------------------------------------------
    // `format_program` lexes for itself, so these are genuine AIPL programs, not
    // space-separated fixtures — the first thing here to exercise real token
    // kinds and spans.
    assert(format_program("fn main() {}", 100)? == "fn main() {}");
    // Already-canonical source is a fixed point.
    assert(
        format_program("fn f(a: i64) -> i64 { a + 1 }", 100)? == "fn f(a: i64) -> i64 { a + 1 }",
    );
    // Messy input is normalized: spacing, indentation, and a trailing comma.
    assert(
        format_program(
            "fn  f (  a : i64 ,b:str )  ->bool{c}",
            100,
        )? == "fn f(a: i64, b: str) -> bool { c }",
    );
    assert(format_program("fn f() {\n\n\n    g();\n}", 100)? == "fn f() {\n    g();\n}");
    // Imports hoist above items, builtins first, names sorted.
    assert(
        format_program(
            "fn f() {}\nimport { b, a } from builtins;",
            100,
        )? == "import { a, b } from builtins;\n\nfn f() {}",
    );
    // A comment is carried, not dropped.
    assert(format_program("// hi\nfn f() {}", 100)? == "// hi\nfn f() {}");
    // A string literal keeps its bytes verbatim, spacing inside untouched.
    assert(format_program(`fn f() -> str \{ "a  b" }`, 100)? == `fn f() -> str \{ "a  b" }`);
    // A lex error surfaces as a formatter error rather than a panic.
    assert(
        format_program(`fn f() -> str \{ "unterminated }`, 100).is_err_and(|e| 0 < e.message.len()),
    );

    // --- expressions ------------------------------------------------------------
    assert(walker_of("a").expr().rendered(100)? == "a");
    assert(walker_of("a + b").expr().rendered(100)? == "a + b");
    assert(walker_of("a + b * c").expr().rendered(100)? == "a + b * c");
    assert(walker_of("! a").expr().rendered(100)? == "!a");
    assert(walker_of("- a").expr().rendered(100)? == "-a");
    assert(walker_of("a .. b").expr().rendered(100)? == "a..b");

    // Postfix: field access and `?` glue; a lone call keeps its own list.
    assert(walker_of("a . b").expr().rendered(100)? == "a.b");
    assert(walker_of("a ?").expr().rendered(100)? == "a?");
    assert(walker_of("f ( x )").expr().rendered(100)? == "f(x)");
    assert(walker_of("f ( )").expr().rendered(100)? == "f()");
    assert(walker_of("a . f ( x )").expr().rendered(100)? == "a.f(x)");
    assert(walker_of("xs [ i ]").expr().rendered(100)? == "xs[i]");
    assert(walker_of("xs [ a .. b ]").expr().rendered(100)? == "xs[a..b]");
    assert(walker_of("xs [ a .. ]").expr().rendered(100)? == "xs[a..]");
    assert(walker_of("xs [ .. b ]").expr().rendered(100)? == "xs[..b]");

    // Two or more calls form a chain that breaks before each call when too wide.
    assert(walker_of("a . f ( ) . g ( )").expr().rendered(100)? == "a.f().g()");
    assert(walker_of("a . f ( ) . g ( )").expr().rendered(5)? == "a\n    .f()\n    .g()");

    // Literals and containers.
    assert(walker_of("( a )").expr().rendered(100)? == "(a)");
    assert(walker_of("( a , b )").expr().rendered(100)? == "(a, b)");
    assert(walker_of("[ a , b ]").expr().rendered(100)? == "[a, b]");
    assert(walker_of("[ ]").expr().rendered(100)? == "[]");
    assert(walker_of("# { a , b }").expr().rendered(100)? == "#{a, b}");
    assert(walker_of("# { k : v }").expr().rendered(100)? == "#{k: v}");
    assert(walker_of("# { : }").expr().rendered(100)? == "#{:}");

    // Struct construction, including the field shorthand.
    assert(walker_of("S { a : 1 , b }").expr().rendered(100)? == "S { a: 1, b }");
    assert(walker_of("S { }").expr().rendered(100)? == "S {}");

    // Keyword arguments spell tight; a bare operator passes as a value.
    assert(walker_of("f ( 1 , k = 2 )").expr().rendered(100)? == "f(1, k=2)");
    assert(walker_of("apply ( 2 , 3 , + )").expr().rendered(100)? == "apply(2, 3, +)");

    // Lambdas.
    assert(walker_of("| x | x").expr().rendered(100)? == "|x| x");
    assert(walker_of("| x : i64 | x").expr().rendered(100)? == "|x: i64| x");
    assert(walker_of("f ( | | x )").expr().rendered(100)? == "f(|| x)");

    // --- if / match ---------------------------------------------------------
    assert(walker_of("if ( c ) { a }").expr().rendered(100)? == "if (c) { a }");
    assert(
        walker_of("if ( c ) { a } else { b }").expr().rendered(100)? == "if (c) { a } else { b }",
    );
    // Both branches break together, never one inline and the other split.
    assert(
        walker_of("if ( c ) { a } else { b }")
            .expr()
            .rendered(5)? == "if (c) {\n    a\n} else {\n    b\n}",
    );
    // A match is always one arm per line, even when it would fit.
    assert(
        walker_of("match ( v ) { A => 1 , }")
            .expr()
            .rendered(100)? == "match (v) {\n    A => 1,\n}",
    );
    assert(
        walker_of("match ( v ) { A ( x ) => x , B => 2 , }")
            .expr()
            .rendered(100)? == "match (v) {\n    A(x) => x,\n    B => 2,\n}",
    );

    // --- statements & blocks --------------------------------------------------
    assert(walker_of("{ }").block().rendered(100)? == "{}");
    assert(walker_of("{ a }").block().rendered(100)? == "{ a }");
    // Any `;` forces one statement per line.
    assert(walker_of("{ f ( ) ; }").block().rendered(100)? == "{\n    f();\n}");
    assert(walker_of("{ let x = 1 ; x }").block().rendered(100)? == "{\n    let x = 1;\n    x\n}");
    assert(walker_of("{ mut x = 1 ; x }").block().rendered(100)? == "{\n    mut x = 1;\n    x\n}");
    assert(walker_of("{ set x = 1 ; }").block().rendered(100)? == "{\n    set x = 1;\n}");
    assert(walker_of("{ set x ++ ; }").block().rendered(100)? == "{\n    set x++;\n}");
    assert(walker_of("{ set a . b = 1 ; }").block().rendered(100)? == "{\n    set a.b = 1;\n}");
    assert(
        walker_of("{ set xs . push ( 1 ) ; }")
            .block()
            .rendered(100)? == "{\n    set xs.push(1);\n}",
    );
    assert(walker_of("{ return 1 ; }").block().rendered(100)? == "{\n    return 1;\n}");
    // Destructuring binders.
    assert(
        walker_of("{ let ( a , b ) = p ; }").block().rendered(100)? == "{\n    let (a, b) = p;\n}",
    );
    assert(
        walker_of("{ let S { a , b } = p ; }")
            .block()
            .rendered(100)? == "{\n    let S { a, b } = p;\n}",
    );
    // Loops.
    assert(
        walker_of("{ while ( c ) { f ( ) ; } }")
            .block()
            .rendered(100)? == "{\n    while (c) {\n        f();\n    }\n}",
    );
    assert(
        walker_of("{ for ( let x : xs ) { f ( ) ; } }")
            .block()
            .rendered(100)? == "{\n    for (let x : xs) {\n        f();\n    }\n}",
    );
    assert(
        walker_of("{ for ( let ( i , x ) : xs ) { f ( ) ; } }")
            .block()
            .rendered(100)? == "{\n    for (let (i, x) : xs) {\n        f();\n    }\n}",
    );

    // --- items ------------------------------------------------------------------
    assert(walker_of("struct S { a : i64 }").struct_item().rendered(100)? == "struct S { a: i64 }");
    assert(walker_of("struct S { }").struct_item().rendered(100)? == "struct S {}");
    assert(
        walker_of("struct S < T > { a : T , b : str }")
            .struct_item()
            .rendered(100)? == "struct S<T> { a: T, b: str }",
    );
    // A field default keeps spaces around `=`.
    assert(
        walker_of("struct S { a : i64 = 1 }")
            .struct_item()
            .rendered(100)? == "struct S { a: i64 = 1 }",
    );

    assert(walker_of("fn f ( ) { }").fn_item().rendered(100)? == "fn f() {}");
    assert(walker_of("pub fn f ( ) { }").fn_item().rendered(100)? == "pub fn f() {}");
    assert(walker_of("fn f ( ) -> i64 { 1 }").fn_item().rendered(100)? == "fn f() -> i64 { 1 }");
    assert(
        walker_of("fn f ( a : i64 , b : str ) -> bool { c }")
            .fn_item()
            .rendered(100)? == "fn f(a: i64, b: str) -> bool { c }",
    );
    // `mut` receiver, variadic marker, and a declaration default.
    assert(
        walker_of("fn f ( mut self : i64 [ ] , x : i64 = 1 ) { }")
            .fn_item()
            .rendered(100)? == "fn f(mut self: i64[], x: i64 = 1) {}",
    );
    assert(walker_of("fn f ( xs : i64 * ) { }").fn_item().rendered(100)? == "fn f(xs: i64*) {}");
    // Effects, type params, and a statement body.
    assert(
        walker_of("fn f ( ) ! prints { g ( ) ; }")
            .fn_item()
            .rendered(100)? == "fn f() !prints {\n    g();\n}",
    );
    assert(
        walker_of("fn f < T : any > ( x : T ) -> T { x }")
            .fn_item()
            .rendered(100)? == "fn f<T: any>(x: T) -> T { x }",
    );
    // Attributes glue to the closing brace.
    assert(
        walker_of(`fn f ( ) \{ } . doc ( "d" )`).fn_item().rendered(100)? == `fn f() \{}.doc("d")`,
    );
    assert(
        walker_of("fn f ( ) { } . test ( { g ( ) ; } )")
            .fn_item()
            .rendered(100)? == "fn f() {}.test({\n    g();\n})",
    );

    // --- program ------------------------------------------------------------
    // Items are separated by exactly one blank line.
    assert(
        walker_of("fn a ( ) { } fn b ( ) { }").program().rendered(100)? == "fn a() {}\n\nfn b() {}",
    );

    // Imports hoist above the items, builtins before paths, each on its own line
    // and separated from the first item by a blank line.
    assert(
        walker_of(`import \{ x } from "./m.aipl" ; import \{ b , a } from builtins ; fn f ( ) \{ }`)
            .program()
            .rendered(
                100,
            )? == `import \{ a, b } from builtins;\nimport \{ x } from "./m.aipl";\n\nfn f() \{}`,
    );
    // A struct and a variant are items too.
    assert(
        walker_of("struct S { a : i64 } variant V = A | B")
            .program()
            .rendered(100)? == "struct S { a: i64 }\n\nvariant V = A | B",
    );
    assert(walker_of("").program().rendered(100)? == "");

    // Comments: a file-header comment stays at the very top (above the hoisted
    // imports), and a comment attached to an item rides with it. `walker_of`
    // has no comments of its own, so this one is built by hand.
    let csrc = "// hdr\nfn a() {}\n// on b\nfn b() {}";
    let ctoks = [
        FmtTok { kind: Keyword, span: 7..9 },
        // fn
        FmtTok { kind: Ident, span: 10..11 },
        // a
        FmtTok { kind: Punct, span: 11..12 },
        // (
        FmtTok { kind: Punct, span: 12..13 },
        // )
        FmtTok { kind: Punct, span: 14..15 },
        // {
        FmtTok { kind: Punct, span: 15..16 },
        // }
        FmtTok { kind: Keyword, span: 25..27 },
        // fn
        FmtTok { kind: Ident, span: 28..29 },
        // b
        FmtTok { kind: Punct, span: 29..30 },
        // (
        FmtTok { kind: Punct, span: 30..31 },
        // )
        FmtTok { kind: Punct, span: 32..33 },
        // {
        FmtTok { kind: Punct, span: 33..34 },
    ];
    // }

    let cw = new_walker(csrc, ctoks, [0..6, 17..24]);
    assert(cw.program().rendered(100)? == "// hdr\nfn a() {}\n\n// on b\nfn b() {}");

    // --- truncated input terminates -------------------------------------------
    // Every "scan until a closing token" loop goes through `more_before`, which
    // folds in the end-of-input check. Without it these spin forever rather than
    // failing: `peek_text()` past the last token is `""`, never the terminator,
    // and `bump()` does not advance there — so the loop cannot progress and
    // cannot exit. Each of these hung `aipl check` with no output before the
    // wrapper existed.
    assert(more_before(walker_of("import { len"), "}")); // more to read
    assert(!walker_of("").more_before("}")); // nothing left: stop, don't spin
    // An import whose `}` never arrives is an error, not a hang.
    assert(
        walker_of("import { len from builtins ;")
            .import_item()
            .is_err_and(|e| e.message == `formatter: expected "}", found "" (at end of input)`),
    );
    // Truncated right after the brace: an error naming end-of-input, not a hang.
    assert(
        walker_of("import { len}")
            .import_item()
            .is_err_and(|e| e.message.contains("at end of input")),
    );
    // A well-formed import in the same shapes still parses.
    assert(
        walker_of("import { len } from builtins ;")
            .import_item()?.doc
            .at(100) == "import { len } from builtins;",
    );

    // --- imports --------------------------------------------------------------
    // Names are sorted, and the braces get inner spaces when flat.
    assert(
        walker_of("import { b , a } from builtins ;")
            .import_item()?.doc
            .at(100) == "import { a, b } from builtins;",
    );
    // Operators sort after plain names, and among themselves by `str` order.
    assert(
        walker_of("import { == , len , ! } from builtins ;")
            .import_item()?.doc
            .at(100) == "import { len, !, == } from builtins;",
    );

    // A renamed import sorts under the name it *imports* (`w`), not its operator
    // spelling — so it stays with the plain names rather than joining the
    // operators at the end.
    assert(
        walker_of("import { wrapping_add as + , len , == } from builtins ;")
            .import_item()?.doc
            .at(100) == "import { len, wrapping_add as +, == } from builtins;",
    );

    // A prefix sorts before the longer name extending it.
    assert(
        walker_of("import { ab , a } from builtins ;")
            .import_item()?.doc
            .at(100) == "import { a, ab } from builtins;",
    );
    // A path import keeps its quoted source verbatim.
    assert(
        walker_of(`import \{ x } from "./m.aipl" ;`)
            .import_item()?.doc
            .at(100) == `import \{ x } from "./m.aipl";`,
    );
    // Too wide: one name per line with a trailing comma.
    assert(
        walker_of("import { b , a } from builtins ;")
            .import_item()?.doc
            .at(5) == "import {\n    a,\n    b,\n} from builtins;",
    );
    // The hoist key puts builtins ahead of every path.
    assert(walker_of("import { x } from builtins ;").import_item()?.source == "builtins");
    assert(walker_of(`import \{ x } from "./m.aipl" ;`).import_item()?.source == `"./m.aipl"`);

    // --- variant ------------------------------------------------------------
    assert(walker_of("variant V = A").variant_item().rendered(100)? == "variant V = A");
    assert(walker_of("variant V = A | B").variant_item().rendered(100)? == "variant V = A | B");
    assert(
        walker_of("variant V = A | B ( i64 )")
            .variant_item()
            .rendered(100)? == "variant V = A | B(i64)",
    );
    assert(
        walker_of("variant V = A ( i64 , str )")
            .variant_item()
            .rendered(100)? == "variant V = A(i64, str)",
    );
    // Generic variant.
    assert(
        walker_of("variant Opt < T > = Some ( T ) | Nil")
            .variant_item()
            .rendered(100)? == "variant Opt<T> = Some(T) | Nil",
    );

    // Too wide to fit: one case per line, `|` leading each continuation, indented
    // one level under the `=`.
    assert(
        walker_of("variant V = A | B").variant_item().rendered(5)? == "variant V =\n    A\n    | B",
    );
})

// Render what a walker step produced at the given width — the round trip a
// formatter test actually cares about.
fn rendered(self: WDoc!FmtError, width: u64) -> str!FmtError { ok(print_doc(self?.doc, width)) }

// Render a `Doc` directly — the `WDoc`-free form, for steps that hand back
// something other than a plain `WDoc`.
fn at(self: Doc, width: u64) -> str { print_doc(self, width) }
