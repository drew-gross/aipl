// The tree the parser driver (`parse.aipl`) builds: a *concrete* syntax tree,
// lossless by construction. Every byte of the parsed source is covered by
// exactly one leaf — `CLeaf` for a token the grammar matched, `CTrivia` for a
// comment or a run of whitespace the lexer set aside — so concatenating a
// tree's leaf spans in order reproduces the source byte for byte
// (`text`). That is what a formatter generator needs and what an AST
// cannot give it: an AST has already thrown away the text that carries no
// meaning, and a formatter's whole job is to put it back.
//
// An interior node is `CTree(prod, kids)`, where `prod` is a production's
// index in the grammar's `prods` array — not its name. The index is what
// `link` (see `grammar.aipl`) rewrites rule references into, so the driver
// never compares strings while parsing; `show` takes the name table when a
// human needs to read one.
//
// The type is recursive *through an array*, so a `Cst` is a refcounted heap
// block and the array holds strong references to its element nodes — see
// `tests/cases/variants/recursive_through_array.aipl`.
import {
    Span,
    case_of,
    equal as ==,
    filter,
    filter_map,
    first,
    is_empty,
    join,
    last,
    len,
    map,
    value_or,
} from builtins;

# An interior node is `CTree(prod, kids)`; a `CGroup` is the bracket pair a
# `NestedIn` matched, holding its opening kids, the kids between the brackets,
# and its closing kids as three runs.
#
# A group is *transparent*: it is not a production, it lowers to nothing of its
# own, and `nodes` and `own_tokens` splice straight through it — so converting a
# `Then([Lit("("), x, Lit(")")])` into a `NestedIn` leaves every `build` function
# reading exactly the children it read before. The only pass that sees a group is
# the formatter, which is the pass that needs to know where the brackets are.
variant Cst = CLeaf(Span) | CTrivia(Span) | CTree(u64, Cst[]) | CGroup(u64, Cst[], Cst[], Cst[])

# Every leaf span under `self`, in source order — token leaves and trivia
# alike. The whole losslessness property is stated in terms of this list: the
# spans are contiguous and cover the parsed source, so `text` is just
# "slice each one and join".
pub fn leaves(self: Cst) -> Span[] {
    match (self) {
        CLeaf(sp) | CTrivia(sp) => [sp],
        CTree(_, kids) => kids.map(leaves).join(),
        CGroup(_, open, body, close) => [
            ..open.map(leaves).join(),
            ..body.map(leaves).join(),
            ..close.map(leaves).join(),
        ],
    }
}

# The source text `self` covers, reconstructed from its leaf spans. For a whole
# parse this equals the input exactly; that identity is the cheapest regression
# test there is for the driver's trivia handling, so the `.test` blocks assert
# it directly.
pub fn text(self: Cst, src: str) -> str { self.leaves().map(|sp| src[sp]).join(sep="") }

# Every *token* leaf span under `self`, in source order — `leaves` with the
# trivia dropped. The two are the lossless/meaningful pair: `leaves` keeps the
# comments and whitespace because reconstructing the source needs them, and this
# one drops them because a lowering function reading a token's spelling does not
# want the blank line in front of it.
pub fn token_leaves(self: Cst) -> Span[] {
    match (self) {
        CLeaf(sp) => [sp],
        CTrivia(..) => [],
        CTree(_, kids) => kids.map(token_leaves).join(),
        CGroup(_, open, body, close) => [
            ..open.map(token_leaves).join(),
            ..body.map(token_leaves).join(),
            ..close.map(token_leaves).join(),
        ],
    }
}

# The text of the tokens under `self`, trivia dropped and nothing inserted
# between them — what a production's `build` reads a matched token's spelling
# from. Written for the single-token node that is the usual case; over a wider
# node the tokens run together (`( a b )` reads back as `(ab)`), which is why
# `text` and not this one is what reconstructs source.
pub fn token_text(self: Cst, src: str) -> str { self.token_leaves().map(|sp| src[sp]).join(sep="") }

# The span `self` covers: its first leaf's start through its last leaf's end.
# A node with no leaves at all — an interior node for a production that matched
# empty input, which `Maybe` and a zero-minimum `Many` can both produce — has no
# extent, and reports the empty `0..0`.
pub fn span(self: Cst) -> Span {
    let ls = self.leaves();
    match (ls.first()) {
        some(f) => match (ls.last()) {
            some(l) => f.start..l.end,
            none => f,
        },
        none => 0..0,
    }
}

# The interior children of `self` — its kids with the leaves dropped. This is
# the child list a production's `build` is lowered against, so its order and
# length are part of the contract between a grammar and its lowering functions:
# one entry per `Named` reference the rule matched, in the order it matched them.
#
# A leaf is dropped because the lowering pass has nothing to hand `build` for one
# — it has no lowered value, and its text is reachable from the node's own span.
# A `CGroup` never reaches the test: `flat_kids` splices it away first, which is
# what makes a group transparent.
pub fn nodes(self: Cst) -> Cst[] { self.flat_kids().filter(|k| k.case_of() == CTree) }

# The direct kids of `self` with every group spliced in place — the one function
# that makes a group transparent, and what `nodes` and `own_tokens` are both
# written against. A group's three runs concatenate in source order, and a group
# nested directly inside another flattens with it.
fn flat_kids(self: Cst) -> Cst[] {
    match (self) {
        CLeaf(..) | CTrivia(..) => [],
        CTree(_, kids) => kids.map(splice).join(),
        CGroup(_, open, body, close) => [
            ..open.map(splice).join(),
            ..body.map(splice).join(),
            ..close.map(splice).join(),
        ],
    }
}

# One kid as the kids it stands for: a group as its contents, anything else as
# itself.
fn splice(self: Cst) -> Cst[] {
    match (self) {
        CGroup(..) => self.flat_kids(),
        CLeaf(..) | CTrivia(..) | CTree(..) => [self],
    }
}

# The token leaves `self` matched *directly* — one level down, not recursed
# into. The mirror of `nodes`: that one is a node's direct branches, this its
# direct leaves, and between them they are everything the node itself matched.
#
# This is what a lowering function reads an operator or a keyword from. A
# `Climb` node's two operands arrive as interior children and the operator
# between them is a direct leaf, so `own_token_text` is the operator and nothing
# else — where `token_text` would hand back the whole expression's tokens run
# together. Trivia is dropped here as it is there.
pub fn own_tokens(self: Cst) -> Span[] { self.flat_kids().filter_map(is_leaf, leaf_span) }

# The source text of `self`'s direct token leaves, run together with nothing
# between them — the operator of a binary node, the keyword that opened a form.
pub fn own_token_text(self: Cst, src: str) -> str {
    self.own_tokens().map(|sp| src[sp]).join(sep="")
}

# Whether `self` is a token leaf: not an interior node, and not trivia.
fn is_leaf(self: Cst) -> bool {
    match (self) {
        CLeaf(..) => true,
        CTree(..) | CTrivia(..) | CGroup(..) => false,
    }
}

# The span of a leaf, for `own_tokens`'s `filter_map`. A non-leaf never reaches
# it (the filter runs first), and reports the empty span rather than failing.
fn leaf_span(self: Cst) -> Span {
    match (self) {
        CLeaf(sp) => sp,
        CTrivia(..) | CTree(..) | CGroup(..) => 0..0,
    }
}

# `self` rendered as an S-expression against the grammar's production names
# (`prod_names`), for tests and for reading a tree by eye: a leaf as its source
# text, a trivia leaf prefixed with `~`, an interior node as
# `(name kid kid ...)`. A production index with no name in `names` renders as
# `?` rather than failing — this is a debug rendering, not a checked one.
pub fn show(self: Cst, src: str, names: str[]) -> str {
    match (self) {
        CLeaf(sp) => src[sp],
        CTrivia(sp) => `~{src[sp]}`,
        CTree(i, kids) => {
            let parts = kids.map(|k| k.show(src, names));
            let name = names[i].value_or("?");
            if (parts.is_empty()) { `({name})` } else { `({name} {parts.join(sep=" ")})` }
        },
        // A group has no name to print, so it renders as its own brackets: what
        // it holds, between `[` and `]`, whatever the source spelled them.
        CGroup(_, open, body, close) => {
            let parts = [..open, ..body, ..close].map(|k| k.show(src, names));
            `[{parts.join(sep=" ")}]`
        },
    }
}.test({
    // `(expr 1 + 2)` over the source below, with the `+` surrounded by trivia
    // the grammar skipped over. Built by hand: the driver's own output is
    // exercised in `parse.aipl`, and this file's job is the tree, not the parse.
    let src = "1 + 2";
    let t = CTree(1, [CLeaf(0..1), CTrivia(1..2), CLeaf(2..3), CTrivia(3..4), CLeaf(4..5)]);

    // What counts as an interior child: a `CTree` does, a `CLeaf` and a
    // `CTrivia` do not.
    assert(CTree(0, [CLeaf(0..1), t, CTrivia(1..2)]).nodes() == [t]);

    // Losslessness: the leaves tile the source, so the text comes back whole.
    assert(t.text(src) == src);
    assert(t.leaves().len() == 5);
    assert(t.span() == 0..5);

    // A leaf is its own text and its own span.
    assert(CLeaf(2..3).text(src) == "+");
    assert(CTrivia(1..2).span() == 1..2);

    // `token_text` is `text` with the trivia dropped — the spelling a lowering
    // function reads, rather than the bytes a formatter reproduces.
    assert(t.token_leaves() == [0..1, 2..3, 4..5]);
    assert(t.token_text(src) == "1+2");
    assert(CTrivia(1..2).token_text(src) == "");
    assert(CTree(1, [CTrivia(1..2), CLeaf(2..3)]).token_text(src) == "+");

    // Nesting: an interior child contributes its own leaves to the parent, in
    // place, so the parent still reconstructs the whole source.
    let nested = CTree(0, [CLeaf(0..1), CTrivia(1..2), CTree(1, [CLeaf(2..3), CLeaf(3..5)])]);
    assert(nested.text(src) == src);
    assert(nested.span() == 0..5);
    assert(nested.nodes().len() == 1);
    // `nodes` is one level deep and drops leaves: three kids, one interior.
    assert(nested.nodes() == [CTree(1, [CLeaf(2..3), CLeaf(3..5)])]);

    // `own_tokens` is the mirror — one level deep, leaves only — so between them
    // they are everything `nested` matched directly. The interior child's own
    // leaves belong to it, not to the parent, which is what separates this from
    // `token_leaves`.
    assert(nested.own_tokens() == [0..1]);
    assert(nested.own_token_text(src) == "1");
    // (the last leaf spans `" 2"`, hence the space this one keeps)
    assert(nested.token_text(src) == "1+ 2");
    assert(t.own_tokens() == [0..1, 2..3, 4..5]);
    assert(CLeaf(0..1).own_tokens() == []);
    assert(CTree(0, []).own_token_text(src) == "");
    assert(t.nodes() == []);
    assert(CLeaf(0..1).nodes() == []);

    // A node that matched nothing has no extent rather than a bogus one.
    assert(CTree(0, []).span() == 0..0);
    assert(CTree(0, []).text(src) == "");

    let names = ["expr", "term"];
    assert(t.show(src, names) == "(term 1 ~  + ~  2)");

    // Trivia renders as `~` followed by its verbatim text — here a space, which
    // is why the whitespace doubles up next to the joining space.
    assert(nested.show(src, names) == "(expr 1 ~  (term +  2))");
    assert(CTree(0, []).show(src, names) == "(expr)");
    // An index past the end of the name table still renders.
    let far: u64 = 9;
    assert(CTree(far, []).show(src, names) == "(?)");

    // ---------- groups ----------
    //
    //                1
    //      0123456789012
    let gs = "(1 + 2) * (3)";
    let inner = CTree(1, [CLeaf(1..2), CTrivia(2..3), CLeaf(3..4), CTrivia(4..5), CLeaf(5..6)]);
    let grp = CGroup(0, [CLeaf(0..1)], [inner], [CLeaf(6..7)]);
    let outer = CTree(
        0,
        [
            grp,
            CTrivia(7..8),
            CLeaf(8..9),
            CTrivia(9..10),
            CGroup(0, [CLeaf(10..11)], [CTree(1, [CLeaf(11..12)])], [CLeaf(12..13)]),
        ],
    );

    // Losslessness holds through a group exactly as through a node: the three
    // runs contribute their leaves in source order.
    assert(outer.text(gs) == gs);
    assert(grp.span() == 0..7);
    assert(grp.token_text(gs) == "(1+2)");

    // Transparency: the group is not itself a child, and what it holds is. The
    // `*` between the two groups is a direct leaf of the parent, and the two
    // bracketed expressions are its two interior children — exactly what the
    // same tree written with `Then` and no group would have handed a `build`.
    assert(outer.nodes() == [inner, CTree(1, [CLeaf(11..12)])]);
    assert(outer.own_token_text(gs) == "()*()");

    // A group directly inside a group flattens with it, so nesting the brackets
    // does not nest the child list.
    let doubled = CTree(0, [CGroup(0, [CLeaf(0..1)], [grp], [CLeaf(6..7)])]);
    assert(doubled.nodes() == [inner]);

    // A group renders as its own brackets, having no production name to print.
    assert(grp.show(gs, names) == "[( (term 1 ~  + ~  2) )]");
})
