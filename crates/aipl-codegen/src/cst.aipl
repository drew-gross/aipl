// The tree the parser driver (`parse.aipl`) builds: a *concrete* syntax tree,
// lossless by construction. Every byte of the parsed source is covered by
// exactly one leaf — `Leaf` for a token the grammar matched, `Trivia` for a
// comment or a run of whitespace the lexer set aside — so concatenating a
// tree's leaf spans in order reproduces the source byte for byte
// (`text`). That is what a formatter generator needs and what an AST
// cannot give it: an AST has already thrown away the text that carries no
// meaning, and a formatter's whole job is to put it back.
//
// An interior node is `Tree(prod, kids)`, where `prod` is a production's
// index in the grammar's `prods` array — not its name. The index is what
// `link` (see `grammar.aipl`) rewrites rule references into, so the driver
// never compares strings while parsing; `show` takes the name table when a
// human needs to read one.
//
// The type is recursive *through an array*, so a `Cst` is a refcounted heap
// block and the array holds strong references to its element nodes — see
// `tests/cases/variants/recursive_through_array.aipl`.
import {
    Span,
    equal as ==,
    find_map,
    is_empty,
    join,
    len,
    map,
    push,
    reverse_find_map,
    value_or,
    wrapping_increment as ++,
} from builtins;

# An interior node is `Tree(prod, kids)`; a `Group` is the bracket pair a
# bracketed repetition matched, holding its opening kids, the kids between the
# and its closing kids as three runs.
#
# A group is *transparent*: it is not a production, it lowers to nothing of its
# own, and `nodes` and `own_tokens` splice straight through it — so converting a
# `Then([Lit("("), x, Lit(")")])` into a `nested_in` leaves every `build` function
# reading exactly the children it read before. The only pass that sees a group is
# the formatter, which is the pass that needs to know where the brackets are.
variant Cst = Leaf(Span) | Trivia(Span) | Tree(u64, Cst[]) | Group(u64, Cst[], Cst[], Cst[])

# Every leaf span under `self`, in source order — token leaves and trivia
# alike. The whole losslessness property is stated in terms of this list: the
# spans are contiguous and cover the parsed source, so `text` is just
# "slice each one and join".
pub fn leaves(self: Cst) -> Span[] {
    match (self) {
        Leaf(sp) | Trivia(sp) => [sp],
        Tree(_, kids) => kids.map(leaves).join(),
        Group(_, open, body, close) => [
            ..open.map(leaves).join(),
            ..body.map(leaves).join(),
            ..close.map(leaves).join(),
        ],
    }
}

# The source text `self` covers, reconstructed from its leaf spans. For a whole
# parse this equals the input exactly; that identity is the cheapest regression
# test there is for the driver's trivia handling, so the `.test` blocks assert
# it directly.
pub fn text(self: Cst, src: str) -> str { self.leaves().map(|sp| src[sp]).join() }

# Every *token* leaf span under `self`, in source order — `leaves` with the
# trivia dropped. The two are the lossless/meaningful pair: `leaves` keeps the
# comments and whitespace because reconstructing the source needs them, and this
# one drops them because a lowering function reading a token's spelling does not
# want the blank line in front of it.
pub fn token_leaves(self: Cst) -> Span[] {
    match (self) {
        Leaf(sp) => [sp],
        Trivia(..) => [],
        Tree(_, kids) => kids.map(token_leaves).join(),
        Group(_, open, body, close) => [
            ..open.map(token_leaves).join(),
            ..body.map(token_leaves).join(),
            ..close.map(token_leaves).join(),
        ],
    }
}

# The span `self`'s own *tokens* cover: its first token leaf's start through its
# last token leaf's end, or `none` when it holds no token at all (an interior
# node for a production that matched empty input).
#
# `span` reaches back over the trivia in front of the first token, because
# trivia attaches to the token that follows it and losslessness needs it counted
# somewhere. That makes `span` the wrong thing to compare against another
# parser's spans, which are token-tight — every comparison is off by the leading
# whitespace. This is the tight one.
#
# Found by descending to the leftmost and rightmost token rather than by
# collecting every token under `self` and taking the ends: `token_leaves` walks
# the whole subtree, and asking it at every node in a tree is quadratic in the
# tree. These two descend one edge at a time and stop at the first token.
pub fn token_span(self: Cst) -> Span? {
    match (self.first_token(), self.last_token()) {
        (some(f), some(l)) => some(f.through(l)),
        _ => none,
    }
}

# The span from `self`'s start through the other span's end — what two ends
# of a node, a first leaf and a last, cover between them. Nothing is checked
# about the order: a second span that ends before `self` starts gives a span
# that ends before it starts, exactly as `a.start..b.end` spelled out would.
fn through(self: Span, Span { end }) -> Span { self.start..end }.test({
    assert((1..3).through(5..9) == 1..9);
    // The ends are all that matter: overlapping or nested spans read the same way.
    assert((1..8).through(2..4) == 1..4);
    assert((2..2).through(2..2) == 2..2);
})

# The leftmost token span under `self`, or `none` if it holds none. A group's
# three parts are asked left to right; the first that holds a token answers.
fn first_token(self: Cst) -> Span? {
    match (self) {
        Leaf(sp) => some(sp),
        Trivia(..) => none,
        Tree(_, kids) => kids.find_map(first_token),
        Group(_, open, body, close) => {
            let in_open = open.find_map(first_token);
            let in_body = body.find_map(first_token);
            let in_close = close.find_map(first_token);
            match (in_open, in_body, in_close) {
                (some(sp), _, _) | (_, some(sp), _) | (_, _, some(sp)) => some(sp),
                _ => none,
            }
        },
    }
}

# The rightmost token span under `self`, or `none` if it holds none — the
# mirror of `first_token`: a group's parts are asked right to left.
fn last_token(self: Cst) -> Span? {
    match (self) {
        Leaf(sp) => some(sp),
        Trivia(..) => none,
        Tree(_, kids) => kids.reverse_find_map(last_token),
        Group(_, open, body, close) => {
            let in_open = open.reverse_find_map(last_token);
            let in_body = body.reverse_find_map(last_token);
            let in_close = close.reverse_find_map(last_token);
            match (in_open, in_body, in_close) {
                (_, _, some(sp)) | (_, some(sp), _) | (some(sp), _, _) => some(sp),
                _ => none,
            }
        },
    }
}

# The text of the tokens under `self`, trivia dropped and nothing inserted
# between them — what a production's `build` reads a matched token's spelling
# from. Written for the single-token node that is the usual case; over a wider
# node the tokens run together (`( a b )` reads back as `(ab)`), which is why
# `text` and not this one is what reconstructs source.
pub fn token_text(self: Cst, src: str) -> str { self.token_leaves().map(|sp| src[sp]).join() }

# The extent `self` covers: its first leaf's start through its last leaf's end.
# A node with no leaves at all — an interior node for a production that matched
# empty input, which `Maybe` and a zero-minimum `Many` can both produce — has no
# extent, and reports the empty `0..0`.
#
# Named `extent` rather than `span` because `span` is what a lowering asks its
# `Node` for, and AIPL has no overloading. This is the tree's own answer, which
# the `Parts` one delegates to; trivia at either edge is counted in, so
# `token_span` is what lines up with another parser's spans.
#
# By descent, like `token_span`, and for the same reason: this is asked at
# every node a lowering visits, and collecting every leaf beneath each of them
# is quadratic in the tree. A block is a right-recursive chain one node deep
# per statement, so on the largest compiler sources that was most of the
# lowering's time.
pub fn extent(self: Cst) -> Span {
    match (self.first_leaf(), self.last_leaf()) {
        (some(f), some(l)) => f.through(l),
        _ => 0..0,
    }
}

# The leftmost leaf span under `self` — a token or trivia — or `none`. Laid
# out like `first_token`: a group's three parts are asked left to right.
fn first_leaf(self: Cst) -> Span? {
    match (self) {
        Leaf(sp) | Trivia(sp) => some(sp),
        Tree(_, kids) => kids.find_map(first_leaf),
        Group(_, open, body, close) => {
            let in_open = open.find_map(first_leaf);
            let in_body = body.find_map(first_leaf);
            let in_close = close.find_map(first_leaf);
            match (in_open, in_body, in_close) {
                (some(sp), _, _) | (_, some(sp), _) | (_, _, some(sp)) => some(sp),
                _ => none,
            }
        },
    }
}

# The mirror of `first_leaf`. `reverse_find_map` walks by index rather than
# reversing the list: this runs once per level of a descent, and a reversed
# view per level would be an allocation per level on the way down.
fn last_leaf(self: Cst) -> Span? {
    match (self) {
        Leaf(sp) | Trivia(sp) => some(sp),
        Tree(_, kids) => kids.reverse_find_map(last_leaf),
        Group(_, open, body, close) => {
            let in_open = open.reverse_find_map(last_leaf);
            let in_body = body.reverse_find_map(last_leaf);
            let in_close = close.reverse_find_map(last_leaf);
            match (in_open, in_body, in_close) {
                (_, _, some(sp)) | (_, some(sp), _) | (some(sp), _, _) => some(sp),
                _ => none,
            }
        },
    }
}

# What a `Mk`/`TryMk` lowering is handed: the node that matched, and the two
# lists every lowering reads off it — its interior children and its own token
# spans — already computed.
#
# They are precomputed because they used to be three separate walks of the same
# kids. `lower_node` asked for the children, then the `build` asked for the own
# tokens, and more than half of them asked for the own *texts* as well; each ask
# rebuilt the flattened kid list from scratch, and rebuilt it by allocating a
# one-element array per kid and joining them. One walk fills both lists, and
# measured against the old shape on a nine-kid node it is a little under four
# times faster.
#
# `cst` is the node itself, for the accessors that have to descend — `span`,
# `tok_span`, `text`. Those stay lazy: each is asked at most once per lowering,
# so precomputing them would only move the same work earlier, and the ones that
# walk the whole subtree would then be paid by the lowerings that never ask.
struct Parts { cst: Cst, children: Cst[], tokens: Span[] }

# `self` as the `Parts` a lowering is handed: one walk of its direct kids,
# splitting them into the interior children and the token leaves.
#
# The two lists are the pair a production's `build` is written against, and
# between them they are everything the node matched *directly*:
#
#   - `children` is one entry per `Named` reference the rule matched, in the
#     order it matched them — the order and length are part of the contract
#     between a grammar and its lowering functions. Leaves are dropped because
#     the lowering pass has nothing to hand `build` for one: a leaf has no
#     lowered value, and its text is reachable from the node's own span.
#   - `tokens` is the node's direct token leaves — where a lowering reads an
#     operator or a keyword. A `Climb` node's two operands arrive as interior
#     children and the operator between them is a direct leaf, so `tokens` is
#     the operator and nothing else, where `token_text` would hand back the
#     whole expression's tokens run together.
#
# Trivia is dropped from both. A `Group` is spliced in place rather than
# recorded — that splice is the one thing making a group transparent, so a
# production that gained a bracket pair hands its `build` the children it had
# before — and a group nested directly inside another flattens with it.
pub fn parts(self: Cst) -> Parts {
    let empty = Parts { cst: self, children: [], tokens: [] };
    match (self) {
        Leaf(..) | Trivia(..) => empty,
        Tree(_, kids) => split_kids(kids, empty),
        Group(_, open, body, close) => split_kids(close, split_kids(body, split_kids(open, empty))),
    }
}

# `kids` split onto `acc`, in source order. The accumulator is a whole `Parts`
# rather than the two lists on their own so that one value threads through the
# loop and through a group's recursion.
fn split_kids(kids: Cst[], acc: Parts) -> Parts {
    mut a = acc;
    for (let k : kids) {
        set a = split_kid(a, k);
    }
    a
}

# One kid onto the accumulator: a token leaf contributes its span, an interior
# node contributes itself, trivia contributes nothing, and a group contributes
# whatever its three runs hold — which is the splice that makes it transparent.
fn split_kid(acc: Parts, kid: Cst) -> Parts {
    mut a = acc;
    match (kid) {
        Trivia(..) => {},
        Leaf(sp) => {
            set a.tokens.push(sp);
        },
        Tree(..) => {
            set a.children.push(kid);
        },
        Group(_, open, body, close) => {
            set a = split_kids(open, a);
            set a = split_kids(body, a);
            set a = split_kids(close, a);
        },
    };
    a
}

# One position of a production's rule, as the match filled it: the token a
# `Lit`/`Term` sub-rule consumed, or the index of the child a `Named` sub-rule
# produced — an index into `children`, and so into the lowered values a `build`
# is handed alongside.
#
# This is the rule read back as a positional list, which is what lets a `build`
# *match* the shape it matched rather than reconstruct it. `field_decl`'s two
# alternatives are five sub-rules and three, so an arm binding five slots is the
# one with a default — where counting interior children or searching the token
# list for an `=` is the same question asked sideways.
#
# A slot *names* a position rather than carrying its contents, which is the
# whole reason this type is not generic. Holding the lowered value instead —
# `Sub(A)`, with `A` the caller's AST — makes every slot a composite carrying a
# large recursive variant, and the refcount glue for it is generated at every
# site that touches one: measured, that made the accessor that reads a slot's
# child ten times the size of the `kids`-indexing version it replaced, and grew
# each converted production fivefold. An index costs a word and no glue.
#
# A slot is one sub-rule only where that sub-rule matches exactly one kid, which
# is every `Lit`, `Term` and `Named`. A `Maybe` or a `Many` contributes as many
# slots as it matched kids, so a rule holding one does not line up position for
# position and its `build` still reads `children` and `tokens`.
variant Slot = Tok(Span) | Sub(u64)

# `self`'s direct kids in source order — the positional view a `build` matches
# on in place of deducing its shape.
#
# Asked for by the builds that want it, off the `Parts` a `Mk`/`TryMk` build
# already holds, so wanting positions needs no `Build` case of its own. It is
# not what `parts` returns because the interleaving is the one thing `parts`
# throws away (it splits the kids two ways, losing the order between them), and
# recovering it costs a second walk of the direct kids — which most productions
# have no use for.
pub fn slots(self: Parts) -> Slot[] {
    let empty = SlotWalk { out: [], next: 0 };
    slot_walk(self.cst, empty).out
}

# The slot list being built, and how many interior children have been numbered.
struct SlotWalk { out: Slot[], next: u64 }

fn slot_walk(node: Cst, acc: SlotWalk) -> SlotWalk {
    mut a = acc;
    match (node) {
        Leaf(..) | Trivia(..) => {},
        Tree(_, kids) => {
            set a = slot_walk_kids(kids, a);
        },
        Group(_, open, body, close) => {
            set a = slot_walk_kids(open, a);
            set a = slot_walk_kids(body, a);
            set a = slot_walk_kids(close, a);
        },
    };
    a
}

fn slot_walk_kids(kids: Cst[], acc: SlotWalk) -> SlotWalk {
    mut a = acc;
    for (let k : kids) {
        set a = slot_walk_kid(a, k);
    }
    a
}

# One kid as its slot. Trivia takes no position — it is not a sub-rule — and a
# group splices, exactly as it does for `parts`, so a bracketed repetition's
# contents take the positions rather than the group taking one. The child
# numbering therefore matches `children`, which splices the same way.
fn slot_walk_kid(acc: SlotWalk, kid: Cst) -> SlotWalk {
    mut a = acc;
    match (kid) {
        Trivia(..) => {},
        Leaf(sp) => {
            set a.out.push(Tok(sp));
        },
        Tree(..) => {
            set a.out.push(Sub(a.next));
            set a.next++;
        },
        Group(..) => {
            set a = slot_walk(kid, a);
        },
    };
    a
}

# The token text of a slot, or `""` for a child position — what a `build` reads
# a name or a keyword out of a matched position with.
pub fn slot_text(self: Slot, src: str) -> str {
    match (self) {
        Tok(sp) => src[sp],
        Sub(..) => "",
    }
}

# The span of the token at a slot, or `none` for a child position — whose span
# is carried by the lowered value, not by the position.
pub fn slot_span(self: Slot) -> Span? {
    match (self) {
        Tok(sp) => some(sp),
        Sub(..) => none,
    }
}

# The index into `children` a slot names, or `none` when it holds a token. The
# caller resolves it against the lowered values it was handed; the refusal for a
# `none` is its own, since `ParseError` is declared in `grammar.aipl`, which
# imports this file.
pub fn slot_child(self: Slot) -> u64? {
    match (self) {
        Sub(i) => some(i),
        Tok(..) => none,
    }
}

# The span `self` covers — its tree's, since the parts say nothing about extent.
pub fn span(self: Parts) -> Span { self.cst.extent() }

# The span `self`'s *tokens* cover, falling back to its full extent when it
# matched no token at all. The span a lowering hands to the AST node it builds,
# and the one it blames in an error: token-tight, so it lines up with what
# another parser would report rather than reaching back over leading trivia.
pub fn tok_span(self: Parts) -> Span {
    // Not `value_or(self.cst.extent())`: an argument is evaluated whether or not
    // the optional needs it, and this fallback is a second descent of the tree.
    match (self.cst.token_span()) {
        some(sp) => sp,
        none => self.cst.extent(),
    }
}

# This node's own tokens as their text, one string per token. A `str` is a view
# into `src`, so this costs no more than the spans do, and a lowering that asks
# "which token is second?" gets a string to compare rather than a span to look
# up.
pub fn own_texts(self: Parts, src: str) -> str[] { self.tokens.map(|t| src[t]) }

# The source text of `self`'s direct token leaves, run together with nothing
# between them — the operator of a binary node, the keyword that opened a form.
pub fn own_token_text(self: Parts, src: str) -> str { self.own_texts(src).join() }

# `self` rendered as an S-expression against the grammar's production names
# (`prod_names`), for tests and for reading a tree by eye: a leaf as its source
# text, a trivia leaf prefixed with `~`, an interior node as
# `(name kid kid ...)`. A production index with no name in `names` renders as
# `?` rather than failing — this is a debug rendering, not a checked one.
pub fn show(self: Cst, src: str, names: str[]) -> str {
    match (self) {
        Leaf(sp) => src[sp],
        Trivia(sp) => `~{src[sp]}`,
        Tree(i, kids) => {
            let parts = kids.map(|k| k.show(src, names));
            let name = names[i].value_or("?");
            if (parts.is_empty()) { `({name})` } else { `({name} {parts.join(sep=" ")})` }
        },
        // A group has no name to print, so it renders as its own brackets: what
        // it holds, between `[` and `]`, whatever the source spelled them.
        Group(_, open, body, close) => {
            let parts = [..open, ..body, ..close].map(|k| k.show(src, names));
            `[{parts.join(sep=" ")}]`
        },
    }
}.test({
    // `(expr 1 + 2)` over the source below, with the `+` surrounded by trivia
    // the grammar skipped over. Built by hand: the driver's own output is
    // exercised in `parse.aipl`, and this file's job is the tree, not the parse.
    let src = "1 + 2";
    let t = Tree(1, [Leaf(0..1), Trivia(1..2), Leaf(2..3), Trivia(3..4), Leaf(4..5)]);

    // What counts as an interior child: a `Tree` does, a `Leaf` and a
    // `Trivia` do not.
    assert(Tree(0, [Leaf(0..1), t, Trivia(1..2)]).parts().children == [t]);

    // `token_span` is `span` with the trivia at either edge left out. They agree
    // here because `t` opens and closes on a token...
    assert(t.extent() == 0..5);
    assert(t.token_span() == some(0..5));

    // ...and disagree the moment one edge is trivia, which is the whole reason
    // the tight one exists: another parser's spans start at the token.
    let padded = Tree(1, [Trivia(0..1), Leaf(1..2), Trivia(2..3)]);
    assert(padded.extent() == 0..3);
    assert(padded.token_span() == some(1..2));

    // A node holding no token has no token span — an interior node for a
    // production that matched empty input.
    let blank = Tree(1, [Trivia(0..1)]);
    assert(blank.token_span() == none);

    // Losslessness: the leaves tile the source, so the text comes back whole.
    assert(t.text(src) == src);
    assert(t.leaves().len() == 5);
    assert(t.extent() == 0..5);

    // A leaf is its own text and its own span.
    assert(Leaf(2..3).text(src) == "+");
    assert(Trivia(1..2).extent() == 1..2);

    // `token_text` is `text` with the trivia dropped — the spelling a lowering
    // function reads, rather than the bytes a formatter reproduces.
    assert(t.token_leaves() == [0..1, 2..3, 4..5]);
    assert(t.token_text(src) == "1+2");
    assert(Trivia(1..2).token_text(src) == "");
    assert(Tree(1, [Trivia(1..2), Leaf(2..3)]).token_text(src) == "+");

    // Nesting: an interior child contributes its own leaves to the parent, in
    // place, so the parent still reconstructs the whole source.
    let nested = Tree(0, [Leaf(0..1), Trivia(1..2), Tree(1, [Leaf(2..3), Leaf(3..5)])]);
    assert(nested.text(src) == src);
    assert(nested.extent() == 0..5);

    // `parts` is one walk one level deep, splitting the kids two ways: the
    // interior children, and the token leaves. Between them they are everything
    // `nested` matched directly — the interior child's own leaves belong to it,
    // not to the parent, which is what separates `tokens` from `token_leaves`.
    let np = nested.parts();
    assert(np.children == [Tree(1, [Leaf(2..3), Leaf(3..5)])]);
    assert(np.tokens == [0..1]);
    assert(np.own_texts(src) == ["1"]);
    assert(np.own_token_text(src) == "1");
    // (the last leaf spans `" 2"`, hence the space this one keeps)
    assert(nested.token_text(src) == "1+ 2");
    assert(t.parts().tokens == [0..1, 2..3, 4..5]);
    assert(t.parts().children == []);

    // A leaf has no kids at all, so both lists are empty.
    let leaf_parts = Leaf(0..1).parts();
    assert(leaf_parts.tokens == []);
    assert(leaf_parts.children == []);
    assert(Tree(0, []).parts().own_token_text(src) == "");

    // `slots` puts the two lists back in source order, which is what a rule's
    // positions are: one slot per leaf, one per interior child, trivia skipped.
    // `nested` is `1`, a space, then a child — two positions, not three.
    assert(nested.parts().slots() == [Tok(0..1), Sub(0)]);

    // A node of nothing but tokens has no child position at all.
    assert(t.parts().slots() == [Tok(0..1), Tok(2..3), Tok(4..5)]);

    // Children are numbered in `children` order, so the nth child position
    // indexes the nth lowered value — what a slot-matching build relies on.
    let two_kids = Tree(0, [Tree(1, [Leaf(0..1)]), Leaf(1..2), Tree(1, [Leaf(2..3)])]);
    assert(two_kids.parts().slots() == [Sub(0), Tok(1..2), Sub(1)]);

    // Reading a slot: a token gives its text and its span and names no child, a
    // child position the reverse.
    assert(Tok(0..1).slot_text(src) == "1");
    assert(Tok(0..1).slot_span() == some(0..1));
    assert(Tok(0..1).slot_child() == none);
    let child: Slot = Sub(2);
    assert(child.slot_text(src) == "");
    assert(child.slot_span() == none);
    assert(child.slot_child() == some(2));

    // The two span accessors a lowering reads off its `Parts`, against the tree's
    // own: `span` is the full extent, `tok_span` the token-tight one, and they
    // differ exactly where an edge is trivia.
    assert(padded.parts().span() == 0..3);
    assert(padded.parts().tok_span() == 1..2);
    // With no token at all there is nothing tight to report, so it falls back.
    assert(blank.parts().tok_span() == 0..1);

    // A node that matched nothing has no extent rather than a bogus one.
    assert(Tree(0, []).extent() == 0..0);
    assert(Tree(0, []).text(src) == "");

    let names = ["expr", "term"];
    assert(t.show(src, names) == "(term 1 ~  + ~  2)");

    // Trivia renders as `~` followed by its verbatim text — here a space, which
    // is why the whitespace doubles up next to the joining space.
    assert(nested.show(src, names) == "(expr 1 ~  (term +  2))");
    assert(Tree(0, []).show(src, names) == "(expr)");
    // An index past the end of the name table still renders.
    let far: u64 = 9;
    assert(Tree(far, []).show(src, names) == "(?)");

    // ---------- groups ----------
    //
    //                1
    //      0123456789012
    let gs = "(1 + 2) * (3)";
    let inner = Tree(1, [Leaf(1..2), Trivia(2..3), Leaf(3..4), Trivia(4..5), Leaf(5..6)]);
    let grp = Group(0, [Leaf(0..1)], [inner], [Leaf(6..7)]);
    let outer = Tree(
        0,
        [
            grp,
            Trivia(7..8),
            Leaf(8..9),
            Trivia(9..10),
            Group(0, [Leaf(10..11)], [Tree(1, [Leaf(11..12)])], [Leaf(12..13)]),
        ],
    );

    // Losslessness holds through a group exactly as through a node: the three
    // runs contribute their leaves in source order.
    assert(outer.text(gs) == gs);
    assert(grp.extent() == 0..7);
    assert(grp.token_text(gs) == "(1+2)");

    // Transparency: the group is not itself a child, and what it holds is. The
    // `*` between the two groups is a direct leaf of the parent, and the two
    // bracketed expressions are its two interior children — exactly what the
    // same tree written with `Then` and no group would have handed a `build`.
    assert(outer.parts().children == [inner, Tree(1, [Leaf(11..12)])]);
    assert(outer.parts().own_token_text(gs) == "()*()");

    // A group directly inside a group flattens with it, so nesting the brackets
    // does not nest the child list.
    let doubled = Tree(0, [Group(0, [Leaf(0..1)], [grp], [Leaf(6..7)])]);
    assert(doubled.parts().children == [inner]);

    // A group renders as its own brackets, having no production name to print.
    assert(grp.show(gs, names) == "[( (term 1 ~  + ~  2) )]");
})
