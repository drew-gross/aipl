# A source file parsed and loaded as far as the loader has been ported to AIPL.
#
# `aipl_parse_file` is only the parse. The loader then does more to a file than
# parse it, and each part of that which has moved into AIPL is a step here, so
# this function is what is left to burn down: a step moves in from the Rust
# loader, and when the last one has, the loader is this.
#
# What has moved so far:
#
# - `hoist_test_fns`: a `.test` or `.performance` attribute becomes ordinary
#   top-level functions.
# - `promote_type_vars`: a declaration's own type parameters become type
#   variables.
# - `lint`: the lints that have been ported to AIPL. Their hits ride beside the
#   program, for the Rust driver to squelch and report with its own.
# - `desugar`: the destructuring forms are lowered. It comes after `lint` so the
#   lints read what the author wrote, with no temporaries the parser would have
#   bound; the lints still in Rust run on what this returns.
#
# The formatter parses with `aipl_parse_file` and not this, because it lays out
# the program the author wrote, attributes and all.

import { Span, contains, equal as ==, logical_not as ! } from builtins;
import { desugar } from "./desugar.aipl";
import {
    ParseFailure,
    ParsedFile,
    aipl_parse_file,
    aipl_parse_surface_file,
} from "./grammar_aipl.aipl";
import { hoist_test_fns } from "./hoist_test_fns.aipl";
import { Fn, Item, Program, show_program } from "./item.aipl";
import { lint } from "./lint/lint.aipl";
import { LintHit } from "./lint/lint_hit.aipl";
import { promote_type_vars } from "./promote_type_vars.aipl";

# A file as far as the loader has been ported: the program, the spans of its
# `#[allow]` markers, and what the ported lints found in the program.
struct PartialLoad { program: Program, allows: Span[], lints: LintHit[] }

# `aipl_parse_file`, then the steps of loading that happen per file and need
# nothing from any other.
pub fn parse_and_partial_load(src: str) -> PartialLoad!ParseFailure {
    let ParsedFile { program, allows } = aipl_parse_surface_file(src)?;
    let loaded = program.hoist_test_fns().promote_type_vars();
    ok(PartialLoad { program: loaded.desugar(), allows, lints: lint(loaded, src) })
}.test({
    // A file with neither attribute and no type parameters is as it was parsed.
    let plain = parse_and_partial_load("fn f() { }")?;
    assert(plain.program == aipl_parse_file("fn f() { }")?.program);
    assert(plain.lints == []);

    // The ported lints' hits come with it.
    let unused = parse_and_partial_load("import { map } from builtins;\nfn f() { }")?;
    assert(unused.lints$span == [9..12]);

    // A declared type parameter is a type variable, in a hoisted helper too.
    let generic = parse_and_partial_load("""
        fn id<T>(x: T) -> T { x }.test({
            fn pick<U>(u: U) -> U { u }
            assert(pick(1) == 1);
        })
    """)?;
    let shown = generic.program.show_program();
    assert(shown.contains("fn id<T: any>(x: TypeVar(T)) -> TypeVar(T)"));
    assert(shown.contains("(u: TypeVar(U)) -> TypeVar(U)"));

    // A `.test` helper is hoisted right after its function, and its uses in the
    // block and in the other helpers are renamed with it.
    let hoisted = parse_and_partial_load("""
        fn double(n: i64) -> i64 { n }.test({
            fn four() -> i64 { 4 }
            fn five() -> i64 { four() }
            assert(double(four()) == five());
        })
        fn after() { }
    """)?;
    let names = hoisted.program.show_program();
    assert(names.contains("fn __test$double$four() "));
    assert(names.contains("fn __test$double$five() "));
    assert(names.contains("__test$double$five()"));
    assert(!names.contains(" four()"));

    // A `.performance` block becomes `__performance$<f>`, after `f` and its
    // helpers, with the block's own helpers after it.
    let performance = parse_and_partial_load("""
        fn answer() -> i64 { 42 }.test({
            fn t() -> i64 { 1 }
            assert(t() == 1);
        }).performance({
            fn p() -> i64 { 2 }
            assert(p() == 2);
        })
    """)?;
    let order = performance.program.items$item_name();
    assert(order == [
        "answer",
        "__test$answer$t",
        "__performance$answer",
        "__test$__performance$answer$p",
    ]);
})

// A function's name, and the empty string for any other item.
fn item_name(self: Item) -> str {
    match (self) {
        Fn(f) => f.name.text,
        Struct(..) | Variant(..) | Refinement(..) | Import(..) | Const(..) => "",
    }
}
