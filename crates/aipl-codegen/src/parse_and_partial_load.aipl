# A source file parsed and loaded as far as the loader has been ported to AIPL.
#
# `aipl_parse_surface_file` is only the parse. The loader then does more to a file than
# parse it, and each part of that which has moved into AIPL is a step here, so
# this function is what is left to burn down: a step moves in from the Rust
# loader, and when the last one has, the loader is this.
#
# What has moved so far:
#
# - `hoist_test_fns`: a `.test` or `.benchmark` attribute becomes ordinary
#   top-level functions.
# - `lint` and `squelch`: the lints, and the `#[allow]` markers that keep what they
#   flag. They read the program after hoisting, so every body they check is a function,
#   and before anything else, so a type parameter is still a name and no destructuring
#   has been lowered. The hits that survive ride beside the program, for the Rust driver to
#   report.
# - `promote_type_vars`: a declaration's own type parameters become type
#   variables.
# - `desugar`: the destructuring forms are lowered.
#
# The formatter lays a file out from its tokens, and parses it only to refuse one that does
# not parse.

import { Span, contains, equal as ==, len, logical_not as ! } from builtins;
import { desugar } from "./desugar.aipl";
import {
    ParseFailure,
    ParsedFile,
    aipl_parse_file,
    aipl_parse_surface_file,
} from "./grammar_aipl.aipl";
import { hoist_test_fns } from "./hoist_test_fns.aipl";
import { Item, LoweredFn, Program, show_program } from "./item.aipl";
import { lint } from "./lint/lint.aipl";
import { LintHit } from "./lint/lint_hit.aipl";
import { squelch } from "./lint/squelch.aipl";
import { promote_type_vars } from "./promote_type_vars.aipl";
import { resolve_callees } from "./resolve_callees.aipl";

# A file as far as the loader has been ported: the program, and the lint errors it
# has: the hits no `#[allow]` squelches, and the markers that squelch nothing.
struct PartialLoad { program: Program, lints: LintHit[], type_uses: Span[] = [] }

# `aipl_parse_surface_file`, then the steps of loading that happen per file and need
# nothing from any other.
pub fn parse_and_partial_load(src: str) -> PartialLoad!ParseFailure {
    let ParsedFile { program, allows, type_uses } = aipl_parse_surface_file(src)?;
    let hoisted = program.hoist_test_fns();
    ok(PartialLoad {
        program: hoisted.promote_type_vars().desugar(),
        lints: squelch(src, allows, lint(hoisted.resolve_callees())),
        type_uses,
    })
}.test({
    let shaped = parse_and_partial_load(
        "fn f(o: i64?) -> bool { match (o) { some(v) => v > 1, none => false } }",
    )?;
    assert(shaped.lints$span.len() == 1);

    // An `#[allow]` on the hit's line keeps it; one on any other line squelches nothing.
    let kept = parse_and_partial_load(
        "fn f(o: i64?) -> bool { match (o) { some(v) => v > 1, none => false } } #[allow]",
    )?;
    assert(kept.lints == []);
    let stale = parse_and_partial_load("fn f() { } #[allow]")?;
    assert(stale.lints$message == ["this `#[allow]` squelches nothing — remove it"]);

    // A file with neither attribute and no type parameters is as it was parsed.
    let plain = parse_and_partial_load("fn f() { }")?;
    assert(plain.program == aipl_parse_file("fn f() { }")?.program);
    assert(plain.lints == []);

    // The ported lints' hits come with it.
    let unused = parse_and_partial_load("import { map } from builtins;\nfn f() { }")?;
    assert(unused.lints$span == [9..12]);

    // A declared type parameter is a type variable, in a hoisted helper too.
    let generic = parse_and_partial_load("""
        fn id<T>(x: T) -> T { x }.test({
            fn pick<U>(u: U) -> U { u }
            assert(pick(1) == 1);
        })
    """)?;
    let shown = generic.program.show_program();
    assert(shown.contains("fn id<T: any>(x: TypeVar(T)) -> TypeVar(T)"));
    assert(shown.contains("(u: TypeVar(U)) -> TypeVar(U)"));

    // A `.test` helper is hoisted right after its function, and its uses in the
    // block and in the other helpers are renamed with it.
    let hoisted = parse_and_partial_load("""
        fn double(n: i64) -> i64 { n }.test({
            fn four() -> i64 { 4 }
            fn five() -> i64 { four() }
            assert(double(four()) == five());
        })
        fn after() { }
    """)?;
    let names = hoisted.program.show_program();
    assert(names.contains("fn __test$double$four() "));
    assert(names.contains("fn __test$double$five() "));
    assert(names.contains("__test$double$five()"));
    assert(!names.contains(" four()"));

    // A `.test` block becomes `__test$<f>`, after `f`; a `.benchmark` block becomes
    // `__benchmark$<f>`, after `f` and its helpers, with the function the block is
    // and then the block's own helpers after it.
    let benchmark = parse_and_partial_load("""
        fn answer() -> i64 { 42 }.test({
            fn t() -> i64 { 1 }
            assert(t() == 1);
        }).benchmark({
            fn p() -> i64 { 2 }
            assert(p() == 2);
        })
    """)?;
    let order = benchmark.program.items$item_name();
    assert(order == [
        "answer",
        "__test$answer",
        "__test$answer$t",
        "__benchmark$answer",
        "__test$__benchmark$answer",
        "__test$__benchmark$answer$p",
    ]);

    // A top-level `test({ .. })` leaves only the function its block is.
    let standalone = parse_and_partial_load("test({ assert(true); })")?;
    assert(standalone.program.items$item_name() == ["__test$__test_block_1"]);
})

// A function's name, and the empty string for any other item.
fn item_name(self: Item) -> str {
    match (self) {
        LoweredFn(f) => f.name.text,
        Struct(..) | Variant(..) | Refinement(..) | Import(..) | Const(..) => "",
    }
}
