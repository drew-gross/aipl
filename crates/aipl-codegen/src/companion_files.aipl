// The `--- file: <path> ---` companion sources a case declares: the sibling
// files it needs on disk beside it (modules it imports, fixtures its tests
// read). `aipl check` stages these into the scratch directory it runs a file's
// tests in, and the corpus harness stages the same set for a case's build.
import { contains, len, push, starts_with, trim, value_or, !, +++, ==, || } from builtins;
import { lines } from "./lines.aipl";
import { parse_test_section_header } from "./parse_test_section_header.aipl";
import { trim_end_while } from "./trim_end_while.aipl";

struct Companion { path: str, contents: str }

pub fn companion_files(src: str) -> Companion[] {
    mut out: Companion[] = [];

    // The section the lines being collected belong to. `""` is "no section yet"
    // (the text before the first marker) and can't collide with a real name —
    // `parse_test_section_header` never yields an empty one.
    mut section = "";
    mut buf = "";
    for (let line : src.lines()) {
        let header = parse_test_section_header(line).value_or("");
        if (header == "") {
            set buf = buf +++ line +++ "\n";
        } else {
            set out = out.with_companion(section, buf);
            set section = header;
            set buf = "";
        };
    }
    out.with_companion(section, buf)
}.doc("""
    The `--- file: <path> ---` sections of `src`, in order, as `path`/`contents`
    pairs. Everything outside such a section — the program text and the other
    section kinds — is ignored, and a section body keeps its inner blank lines
    but drops trailing newlines.

    A `file:` section whose path is empty, or contains a backslash, is skipped:
    both would resolve unpredictably when staged.
""").test({
    let one = """
        fn main() {}
        --- file: data.txt ---
        hi
    """;
    assert(companion_files(one) == [Companion { path: "data.txt", contents: "hi" }]);

    // Several companions, in declaration order, alongside other section kinds
    // (which are ignored) — the shape a real case has.
    let many = """
        fn main() {}
        --- stdout ---
        ok
        --- file: a.aipl ---
        pub fn a() -> i64 { 1 }
        --- file: sub/b.txt ---
        two
        lines
        --- exit code ---
        0
    """;
    assert(
        companion_files(many) == [
            Companion { path: "a.aipl", contents: "pub fn a() -> i64 { 1 }" },
            Companion { path: "sub/b.txt", contents: "two\nlines" },
        ],
    );

    // An empty body is a real companion — `--- file: empty.txt ---` stages an
    // empty file, which is exactly what a case testing "read an empty file"
    // needs.
    let empty = """
        fn main() {}
        --- file: empty.txt ---
    """;
    assert(companion_files(empty) == [Companion { path: "empty.txt", contents: "" }]);

    // Inner blank lines survive; only trailing newlines are dropped.
    let inner = """
        --- file: gap.txt ---
        a

        b
    """;
    assert(companion_files(inner) == [Companion { path: "gap.txt", contents: "a\n\nb" }]);

    // No `file:` sections at all -> nothing, whether or not other sections exist.
    assert(companion_files("fn main() {}\n") == []);
    assert(companion_files("fn main() {}\n--- stdout ---\nok\n") == []);
    assert(companion_files("") == []);

    // Unusable paths are skipped rather than staged somewhere unexpected.
    assert(companion_files("--- file: ---\nx\n") == []); // empty path
    assert(companion_files("--- file:    ---\nx\n") == []); // whitespace-only path
    assert(companion_files("--- file: a\\b.txt ---\nx\n") == []); // backslash

    // The path is trimmed, and a `file:`-prefixed name that isn't the marker
    // (e.g. `files:`) is not a companion.
    assert(
        companion_files("--- file:   spaced.txt   ---\nx\n") == [
            Companion { path: "spaced.txt", contents: "x" },
        ],
    );
    assert(companion_files("--- files: x.txt ---\nx\n") == []);
})

// `self` plus the companion `section`/`body` describe, when they describe one at
// all. Kept separate so the flush at the end of `companion_files` is the same
// code as the flush between sections.
fn with_companion(self: Companion[], section: str, body: str) -> Companion[] {
    if (!section.starts_with("file:")) {
        return self;
    };
    let path = section["file:".len()..].trim();
    if (path == "" || path.contains("\\")) {
        return self;
    };
    mut out = self;
    set out.push(Companion { path, contents: body.trim_end_while(|c| c == '\n') });
    out
}.test({
    let empty: Companion[] = [];
    // Not a `file:` section (including the "no section yet" empty name): unchanged.
    assert(empty.with_companion("", "text") == []);
    assert(empty.with_companion("stdout", "text") == []);
    // A companion is appended after what is already there.
    assert(
        [Companion { path: "a", contents: "1" }].with_companion("file: b", "2") == [
            Companion { path: "a", contents: "1" },
            Companion { path: "b", contents: "2" },
        ],
    );
    // Only trailing newlines are dropped from the body.
    assert(
        empty.with_companion("file: x", "a\n\nb\n\n") == [
            Companion { path: "x", contents: "a\n\nb" },
        ],
    );
})
