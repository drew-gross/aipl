// The `--- file: <path> ---` companion sources a case declares: the sibling
// files it needs on disk beside it (modules it imports, fixtures its tests
// read). `aipl check` stages these into the scratch directory it runs a file's
// tests in, and the corpus harness stages the same set for a case's build.
import { contains, is_err_and, len, push, starts_with, trim, value_or, !=, +++, == } from builtins;
import { lines } from "./lines.aipl";
import { parse_test_section_header } from "./parse_test_section_header.aipl";
import { trim_end_while } from "./trim_end_while.aipl";

struct Companion { path: str, contents: str }

pub fn companion_files(src: str) -> Companion[]!str {
    mut out: Companion[] = [];

    // The path of the `file:` section whose lines are being collected, or `""`
    // when the current section isn't one (including the text before the first
    // marker). A validated path is never empty, so this doubles as the "inside a
    // companion" flag.
    mut path = "";
    mut buf = "";
    for (let line : src.lines()) {
        // A match on the optional would read better, but a match arm is an
        // expression — a statement block isn't a form — so the section-boundary
        // work can't live in one. `""` is safe as the "not a header" case:
        // `parse_test_section_header` never yields an empty name.
        let header = parse_test_section_header(line).value_or("");
        if (header == "") {
            set buf = buf +++ line +++ "\n";
        } else {
            if (path != "") {
                set out.push(Companion { path, contents: buf.trim_end_while(|c| c == '\n') });
            };

            // Validated here, at the marker, so an unusable path is reported
            // where it is written rather than where its section happens to end.
            set path = if (header.starts_with("file:")) { companion_path(header)? } else { "" };
            set buf = "";
        };
    }
    if (path != "") {
        set out.push(Companion { path, contents: buf.trim_end_while(|c| c == '\n') });
    };
    ok(out)
}.doc("""
    The `--- file: <path> ---` sections of `src`, in order, as `path`/`contents`
    pairs. Everything outside such a section — the program text and the other
    section kinds — is ignored, and a section body keeps its inner blank lines
    but drops trailing newlines.

    A `file:` section whose path is empty, or contains a backslash, is an
    `err`: both would resolve unpredictably when staged, and staging a case
    somewhere unintended is worse than refusing to stage it at all.
""").test({
    let one = """
        fn main() {}
        --- file: data.txt ---
        hi
    """;
    assert(companion_files(one)? == [Companion { path: "data.txt", contents: "hi" }]);

    // Several companions, in declaration order, alongside other section kinds
    // (which are ignored) — the shape a real case has.
    let many = """
        fn main() {}
        --- stdout ---
        ok
        --- file: a.aipl ---
        pub fn a() -> i64 { 1 }
        --- file: sub/b.txt ---
        two
        lines
        --- exit code ---
        0
    """;
    assert(
        companion_files(many)? == [
            Companion { path: "a.aipl", contents: "pub fn a() -> i64 { 1 }" },
            Companion { path: "sub/b.txt", contents: "two\nlines" },
        ],
    );

    // An empty body is a real companion — `--- file: empty.txt ---` stages an
    // empty file, which is exactly what a case testing "read an empty file"
    // needs.
    let empty = """
        fn main() {}
        --- file: empty.txt ---
    """;
    assert(companion_files(empty)? == [Companion { path: "empty.txt", contents: "" }]);

    // Inner blank lines survive; only trailing newlines are dropped.
    let inner = """
        --- file: gap.txt ---
        a

        b
    """;
    assert(companion_files(inner)? == [Companion { path: "gap.txt", contents: "a\n\nb" }]);

    // No `file:` sections at all -> nothing, whether or not other sections exist.
    assert(companion_files("fn main() {}\n")? == []);
    assert(companion_files("fn main() {}\n--- stdout ---\nok\n")? == []);
    assert(companion_files("")? == []);

    // Unusable paths are refused rather than staged somewhere unexpected.
    assert(companion_files("--- file: ---\nx\n").is_err_and(|e| e.starts_with("`file:`")));
    assert(companion_files("--- file:    ---\nx\n").is_err_and(|e| e.starts_with("`file:`")));
    assert(companion_files("--- file: a\\b.txt ---\nx\n").is_err_and(|e| e.starts_with(`use "/"`)));

    // The path is trimmed, and a `file:`-prefixed name that isn't the marker
    // (e.g. `files:`) is not a companion.
    assert(
        companion_files("--- file:   spaced.txt   ---\nx\n")? == [
            Companion { path: "spaced.txt", contents: "x" },
        ],
    );
    assert(companion_files("--- files: x.txt ---\nx\n")? == []);
})

// The path a `file:` section names, rejected when it can't be staged. Mirrors
// the corpus harness's own checks on these markers, so a fixture that would be
// staged one way by `aipl check` and another way by the harness is refused by
// both instead of being silently skipped by one.
fn companion_path(header: str) -> str!str {
    let path = header["file:".len()..].trim();
    if (path == "") {
        err("`file:` section needs a path: `--- file: path/to/it.aipl ---`")
    } else {
        if (path.contains("\\")) {
            err(`use "/" (not "\\") in "file:" section paths: {path}`)
        } else {
            ok(path)
        }
    }
}.test({
    assert(companion_path("file: a.txt") == ok("a.txt"));
    assert(companion_path("file:   spaced.txt   ") == ok("spaced.txt")); // trimmed
    assert(companion_path("file: sub/b.txt") == ok("sub/b.txt")); // separators kept
    // Unusable paths are errors, not silent skips.
    assert(companion_path("file:").is_err_and(|e| e.starts_with("`file:` section needs a path")));
    assert(
        companion_path("file:    ").is_err_and(|e| e.starts_with("`file:` section needs a path")),
    );
    assert(companion_path("file: a\\b.txt").is_err_and(|e| e.starts_with(`use "/"`)));
})
