// A Wadler/Prettier-style pretty-printing document algebra, dogfooded in AIPL:
// the formatter builds a `Doc` tree describing *possible* layouts and `print_doc`
// picks one — each `Group` renders on one line ("flat") when it fits within the
// width limit, and breaks at its `Line`/`SoftLine` points otherwise. This is the
// port of the Rust `aipl-fmt` `doc.rs`; `format_source` (the formatter proper)
// builds the tree and calls `print_doc` here.
//
// The printer walks a `Work` cons-list (the explicit work-stack the Rust version
// keeps in a `Vec`) with a `while` loop, so the native stack stays flat however
// large the document is. It was originally written as a tail-recursive walk on
// the assumption that the tail call would be eliminated; it is not, and a
// document of a few tens of thousands of nodes duly exhausted the stack. Output
// is accumulated as a `str[]` and joined once at the end. `fits` looks ahead over
// the same cons-list — the list *is* the "rest of the line" the Rust `fits` reads
// off the work stack.
import {
    !,
    !=,
    +++,
    <,
    ==,
    >,
    any,
    contains,
    ends_with,
    is_space,
    join,
    len,
    map,
    push,
    repeat,
    right_fold,
    saturating_sub as -,
    split,
    value_or,
    wrapping_add as +,
} from builtins;
import { reindent_block } from "./reindent_block.aipl";
import { trim_end_while } from "./trim_end_while.aipl";

// Number of spaces per indentation level.
// (`INDENT` in the Rust `doc.rs`; inlined as the literal 4 below since AIPL has
// no module constants.)

variant Doc =
    Text(str)
    | Concat(Doc[])
    | Line
    | SoftLine
    | HardLine
    | BlankLine
    | Indent(Doc)
    | Group(bool, Doc)
    | IfBroken(str)
    | BreakParent
    | RawBlock(str)

// Doc arms, in order: `Text` verbatim literal (multi-line forces a break);
// `Concat` a sequence; `Line` (space/newline), `SoftLine` (nothing/newline),
// `HardLine` (always newline), `BlankLine` (always a blank line); `Indent` one
// deeper level; `Group(forced, inner)` flat-if-fits (`forced` = can-never-flat);
// `IfBroken` text only when the group breaks; `BreakParent` a zero-width
// force-break; `RawBlock` a verbatim multi-line atom re-aligned via `reindent_block`.

// One step's outcome: where the cursor lands, the frames still to walk, and the
// piece to append (if any).
//
// The output accumulator is deliberately *not* a field here. A struct carrying a
// recursive-variant field (`Work`) alongside an array that is rebuilt by `push`
// corrupts memory — it segfaults non-deterministically — so `go` keeps the
// accumulator in its own `mut` binding and this struct reports what to append.
struct Step { col: u64, work: Work, emit: str, emits: bool, done: bool }

// The printer's work-stack, as a cons-list of `(indent-columns, flat?, doc)`
// frames — the tail-recursive analog of the Rust printer's `Vec` work stack.
variant Work = WNil | WCons(u64, bool, Doc, Work)

// ---------- constructors ----------

// `Text`/`Concat`/`Indent`/`RawBlock` are constructed directly at the call site;
// only `group` needs a helper, since it derives its `forced` flag.

// Wrap `self` in a group, pre-computing whether it is forced to break. Forcing
// is what makes a multi-statement block, or any construct holding a line
// comment, lay out vertically no matter the width.
pub fn group(self: Doc) -> Doc { Group(self.has_hard(), self) }

// ---------- forcing ----------

// Whether `self` contains content that can never render flat: a hard/blank line,
// a break-parent, or multi-line verbatim text. Recurses through nested groups —
// a forced inner group means the outer can't be flat either.
fn has_hard(self: Doc) -> bool {
    match (self) {
        Text(s) => s.contains("\n"),
        RawBlock(s) => s.contains("\n"),
        Concat(ds) => ds.any(has_hard),
        Line => false,
        SoftLine => false,
        IfBroken(_) => false,
        HardLine => true,
        BlankLine => true,
        BreakParent => true,
        Indent(inner) => inner.has_hard(),
        Group(forced, _) => forced,
    }
}

// ---------- printing ----------

// Render `doc` at the given width limit. Lines are indented with spaces;
// trailing whitespace is stripped from every line and a final newline is
// preserved when present (the Rust `print`'s belt-and-braces cleanup).
pub fn print_doc(doc: Doc, width: u64) -> str {
    let pieces = go(width, 0, WCons(0, false, doc, WNil), []);
    cleanup(pieces.join(""))
}

// The main layout loop: pop a frame, emit for its `Doc`, push any children, and
// tail-recurse on the rest. `col` is the current column; `sp` (inside each
// frame) is the indentation, in spaces, that a line break under that frame lands
// at.
fn go(width: u64, col0: u64, work0: Work, acc0: str[]) -> str[] {
    mut col = col0;
    mut work = work0;
    mut acc = acc0;
    mut running = true;
    while (running) {
        let st = go_step(width, col, work);
        if (st.emits) {
            set acc = acc.pushed(st.emit);
        };
        set col = st.col;
        set work = st.work;
        set running = !st.done;
    }
    acc
}

// One iteration: pop a frame and report the next state. Split from `go` because
// a `match` arm is an expression — it cannot assign to the loop's variables — so
// each arm *returns* the next `Step` instead.
fn go_step(width: u64, col: u64, work: Work) -> Step {
    match (work) {
        WNil => Step { col, work: WNil, emit: "", emits: false, done: true },
        WCons(sp, flat, d, rest) => go_node(width, col, sp, flat, d, rest),
    }
}

fn go_node(width: u64, col: u64, sp: u64, flat: bool, d: Doc, rest: Work) -> Step {
    match (d) {
        Text(s) => Step { col: col_after(col, s), work: rest, emit: s, emits: true, done: false },
        RawBlock(s) => go_raw(col, sp, s, rest),
        Concat(ds) => Step {
            col,
            work: prepend(ds, sp, flat, rest),
            emit: "",
            emits: false,
            done: false,
        },
        Line => if (flat) {
            Step { col: col + 1, work: rest, emit: " ", emits: true, done: false }
        } else {
            Step { col: sp, work: rest, emit: newline_str(sp), emits: true, done: false }
        },
        SoftLine => if (flat) {
            Step { col, work: rest, emit: "", emits: false, done: false }
        } else {
            Step { col: sp, work: rest, emit: newline_str(sp), emits: true, done: false }
        },
        HardLine => Step { col: sp, work: rest, emit: newline_str(sp), emits: true, done: false },
        BlankLine => Step { col: sp, work: rest, emit: blank_str(sp), emits: true, done: false },
        Indent(inner) => Step {
            col,
            work: WCons(sp + 4, flat, inner, rest),
            emit: "",
            emits: false,
            done: false,
        },
        Group(forced, inner) => Step {
            col,
            work: WCons(sp, group_flat(forced, width, col, sp, inner, rest), inner, rest),
            emit: "",
            emits: false,
            done: false,
        },
        IfBroken(s) => if (flat) {
            Step { col, work: rest, emit: "", emits: false, done: false }
        } else {
            Step { col: col + s.len(), work: rest, emit: s, emits: true, done: false }
        },
        BreakParent => Step { col, work: rest, emit: "", emits: false, done: false },
    }
}

// One iteration: pop a frame and produce the next state. Split from `go` because
// a `match` arm is an expression — it cannot assign to the loop's variables — so
// each arm *returns* the next `Step` instead.

// A `RawBlock`: re-lay-out the atom around its frame's indent, then emit it and
// continue. Split out so the atom is computed once (a match arm is a single
// expression).
fn go_raw(col: u64, sp: u64, s: str, rest: Work) -> Step {
    let rendered = s.reindent_block(sp);
    Step { col: col_after(col, rendered), work: rest, emit: rendered, emits: true, done: false }
}

// Decide a group's mode: forced groups always break; otherwise the group is flat
// exactly when its content — laid out flat, followed by the rest of the line —
// fits in the remaining width. The remaining width is an *unsigned* subtraction,
// so a line already past the limit floors at 0 rather than going negative — the
// same thing the Rust printer gets from `usize::saturating_sub`.
fn group_flat(forced: bool, width: u64, col: u64, sp: u64, inner: Doc, rest: Work) -> bool {
    if (forced) { false } else { fits(width - col, WCons(sp, true, inner, rest)) }
}

// Would the pending work — the flat candidate followed by the outer frames, each
// in its own mode — stay within `budget` columns? Walks until the budget is
// exhausted (no) or the line provably ends at a break point (yes).
//
// The budget is *unsigned*: it can't go negative, so an overrun is an explicit
// "doesn't fit" comparison in `fits_after` rather than a sign check on a
// wrapped-around remainder.
fn fits(budget: u64, work: Work) -> bool {
    match (work) {
        WNil => true,
        WCons(sp, flat, d, rest) => match (d) {
            Text(s) => fits_atom(budget, s, flat, rest),
            RawBlock(s) => fits_atom(budget, s, flat, rest),
            Concat(ds) => fits(budget, prepend(ds, sp, flat, rest)),
            Line => if (flat) { fits_after(budget, 1, rest) } else { true },
            SoftLine => if (flat) { fits(budget, rest) } else { true },
            HardLine => true,
            BlankLine => true,
            Indent(inner) => fits(budget, WCons(sp, flat, inner, rest)),
            Group(forced, inner) => if (forced) {
                !flat
            } else {
                fits(budget, WCons(sp, flat, inner, rest))
            },
            IfBroken(s) => if (flat) {
                fits(budget, rest)
            } else {
                fits_after(budget, s.len(), rest)
            },
            BreakParent => if (flat) { false } else { fits(budget, rest) },
        },
    }
}

// Spend `n` of the remaining columns and keep walking — or give up when `n`
// doesn't fit. The check has to come *before* the subtraction: on an unsigned
// budget `budget - n` floors at 0, which would hide the overrun.
fn fits_after(budget: u64, n: u64, rest: Work) -> bool {
    if (n > budget) { false } else { fits(budget - n, rest) }
}

// A `Text`/`RawBlock` atom in `fits`: a multi-line atom can't sit on a flat line
// (so it only "fits" when the surrounding content is already broken); a
// single-line atom just consumes its width.
fn fits_atom(budget: u64, s: str, flat: bool, rest: Work) -> bool {
    if (s.contains("\n")) { !flat } else { fits_after(budget, s.len(), rest) }
}

// ---------- helpers ----------

// Prepend an array of children onto the work-list so `ds[0]` is processed first:
// a right fold over `ds`, each frame carrying the parent's indent and mode.
fn prepend(ds: Doc[], sp: u64, flat: bool, rest: Work) -> Work {
    ds.right_fold(rest, |d, work| WCons(sp, flat, d, work))
}

// Append one emitted piece to the output accumulator.
fn pushed(self: str[], piece: str) -> str[] {
    mut a = self;
    set a.push(piece);
    a
}

// The column just past `text` when appended at column `col`: the length of its
// last line for multi-line text, else `col + width`.
fn col_after(col: u64, text: str) -> u64 {
    let parts = text.split("\n");
    let n = parts.len();
    if (n < 2) { col + text.len() } else { parts[n - 1].value_or("").len() }
}

// A line break landing at indentation `sp`: a newline plus `sp` spaces.
fn newline_str(sp: u64) -> str { "\n" +++ " ".repeat(sp) }

// A blank-line break at indentation `sp`: two newlines plus `sp` spaces (the
// blank line's own trailing spaces are removed by `cleanup`).
fn blank_str(sp: u64) -> str { "\n\n" +++ " ".repeat(sp) }

// Strip trailing whitespace from every line and preserve a final newline when
// the rendered text had one (mirrors `str::lines().map(trim_end).join("\n")`).
fn cleanup(out: str) -> str {
    let ended = out.ends_with("\n");
    let raw = out.split("\n");

    // `lines()` drops exactly one trailing empty when the text ends in a newline;
    // `split` keeps it, so drop it here to match.
    let lines = if (ended) { raw[0..raw.len() - 1] } else { raw };
    let body = lines.map(|line| line.trim_end_while(is_space)).join("\n");
    body +++ if (ended) { "\n" } else { "" }
}.test({
    // Plain text is emitted verbatim.
    assert(print_doc(Text("hello"), 100) == "hello");
    assert(print_doc(Concat([Text("a"), Text("b")]), 100) == "ab");

    // A group that fits stays flat: `Line` becomes a space, `SoftLine` nothing.
    let list = group(Concat([
        Text("("),
        Indent(Concat([SoftLine, Text("a"), Text(","), Line, Text("b")])),
        SoftLine,
        Text(")"),
    ]));
    assert(print_doc(list, 100) == "(a, b)");

    // The same group, too wide to fit, breaks at every `Line`/`SoftLine`, one
    // element per indented line.
    assert(print_doc(list, 5) == "(\n    a,\n    b\n)");

    // A `HardLine` forces the break even with width to spare.
    assert(print_doc(group(Concat([Text("a"), HardLine, Text("b")])), 100) == "a\nb");

    // `IfBroken` text appears only when the group breaks.
    let arr = group(Concat([
        Text("["),
        Indent(Concat([SoftLine, Text("x"), IfBroken(",")])),
        SoftLine,
        Text("]"),
    ]));
    assert(print_doc(arr, 100) == "[x]");
    assert(print_doc(arr, 2) == "[\n    x,\n]");

    // `BlankLine` separates with a truly-empty line (its trailing spaces are
    // cleaned away).
    assert(print_doc(Concat([Text("a"), BlankLine, Text("b")]), 100) == "a\n\nb");

    // A multi-line `RawBlock` is re-aligned around its column: a bare-opening
    // `"""` block's content is re-indented one level deeper than the delimiters.
    let raw = Concat([Text("x = "), RawBlock(`"""\n  hi\n"""`)]);
    assert(print_doc(raw, 100) == `x = """\n    hi\n"""`);
})
