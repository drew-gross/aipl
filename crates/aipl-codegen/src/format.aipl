// The formatter driver: one pass from a lossless `Cst` to a `Doc`, decided by
// the `Layout` each production carries. It is the third interpreter of a
// `Grammar` — after `parse.aipl`'s parser and `ebnf.aipl`'s dump — and is
// written the same way: the language is data, this file is the loop over it.
//
// It works off the **concrete** tree, not the AST, and has to. An AST has
// already thrown away the parentheses the author wrote and the comments they
// wrote beside them, and putting those back is the whole job. `cst.aipl`
// guarantees the tree covers every byte of the source, so nothing here can lose
// a comment; the worst it can do is place one badly.
//
// **What this is not.** `walker.aipl`, AIPL's own formatter, is 3,500 lines,
// and most of that is judgement about AIPL in particular — which call hugs its
// last argument, when a method chain breaks, how imports sort, where a blank
// line survives. None of that follows from a grammar and none of it is here.
// What is here is the mechanical majority: the productions whose layout is
// settled by the tokens they matched, which is where the cost of describing one
// syntax twice actually falls.
//
// The whole vocabulary is three `Layout` arms plus one function per language.
// That function — `space`, below — is the piece a grammar genuinely cannot
// supply: whether two adjacent tokens want a space between them is a convention
// of the language, not a fact about its structure.
import {
    Span,
    equal as ==,
    first,
    intersperse,
    is_all_whitespace,
    is_empty,
    is_nonempty,
    last,
    len,
    less_than as <,
    logical_and as &&,
    logical_not as !,
    map,
    not_equal as !=,
    push,
    value_or_err,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;
import { Cst, Group, Leaf, Tree, Trivia, span, token_leaves } from "./cst.aipl";
import {
    Concat,
    Doc,
    HardLine,
    IfBroken,
    Indent,
    Line,
    SoftLine,
    Text,
    group,
    print,
} from "./doc.aipl";
import {
    Grammar,
    Inline,
    Layout,
    ListStyle,
    Many,
    Mk,
    ParseError,
    Production,
    Rule,
    Term,
    Tight,
    failure_message,
    link,
} from "./grammar.aipl";

# One child of a node, reduced to what layout needs from it.
#
# Whitespace never becomes a piece: the formatter decides the spacing, so the
# author's is read only where it changes meaning — which is the flag on a
# comment, and nowhere else.
variant Piece =
    // A token the grammar matched, and its spelling.
    | Tok(str)
    // An interior child: its finished `Doc`, and the spellings of its first and
    // last tokens. Those two are what the spacing rule is asked about, since a
    // child's edges are what its neighbours touch. Both are `""` for a child
    // that matched no tokens at all, which an empty `Many` produces.
    | Node(Doc, str, str)
    // A comment, verbatim, and whether the source put a newline after it. That
    // flag is not style: a line comment swallows the rest of its line, so
    // getting it wrong changes what the output means.
    | Note(str, bool)

# The `Doc` that lays `node` out, given the grammar it was parsed with.
#
# `space` answers the one question a grammar cannot: whether a space belongs
# between two adjacent tokens. It is asked with the spellings on either side of
# the gap — `space("+", "1")` while laying out `1 + 1`, `space("(", "a")` while
# laying out `(a)` — so a language brings one small function instead of a layout
# function per production. Where a production wants no spaces at all, that is
# `Tight` and the rule is never consulted.
#
# `g` is linked here, so it may be handed over unlinked, exactly as `parse_cst`
# takes it. That is not a convenience: a group's style lives in `groups`, which
# only `link` fills, so an unlinked grammar would lay every bracket pair out
# against a table that is not there. Linking is idempotent, so a caller that
# linked already pays one walk and nothing else.
#
# Fails only on a tree that does not belong to `g` — a node naming a production
# or a group index the grammar has no entry for, which a tree from `parse_cst`
# cannot be.
pub fn format_cst<K: variant, A: any>(
    g: Grammar<K, A>,
    src: str,
    node: Cst,
    space: (str, str) -> bool,
) -> Doc!ParseError { fmt_node(link(g)?, src, node, space) }

# `format_cst` once the grammar is linked — the recursive half, so a call links
# once rather than once per node.
fn fmt_node<K: variant, A: any>(
    g: Grammar<K, A>,
    src: str,
    node: Cst,
    space: (str, str) -> bool,
) -> Doc!ParseError {
    match (node) {
        // Reached only when a caller hands a leaf straight in; the driver turns
        // a node's own leaves into pieces rather than recursing into them.
        Leaf(sp) | Trivia(sp) => ok(Text(src[sp])),
        Tree(i, kids) => {
            let layout = g.prods[i].value_or_err(ParseError {
                message: `no production at index {i}`,
                span: node.span(),
            })?.layout;
            let ps = pieces(g, src, kids, space)?;
            ok(
                match (layout) {
                    Tight => tight(ps),
                    Inline => inline_doc(ps, space),
                },
            )
        },
        // A group reached directly, rather than as a child of the production
        // holding it — the same layout either way.
        Group(gi, open, body, close) => group_doc(g, src, gi, open, body, close, space),
    }
}.test({
    // Two productions, one per layout, one group style, and a tree written out
    // by hand: the driver reads a production's `layout` and never its `rule`, so
    // a grammar carrying the simplest rule there is exercises it exactly.
    let g = grammar_of([Inline, Inline, Tight], [ListStyle { spaced: true }]);

    //                  1
    //        012345678901234
    let src = "{ a: 1, b: -2 }";
    let grp = Group(
        0,
        [Leaf(0..1)],
        [
            Trivia(1..2),
            kv(2),
            Trivia(4..5),
            Leaf(5..6),
            Leaf(6..7),
            Trivia(7..8),
            kv(8),
            Trivia(10..11),
            Tree(2, [Leaf(11..12), Leaf(12..13)]),
        ],
        [Trivia(13..14), Leaf(14..15)],
    );
    let tree = Tree(0, [grp]);

    // The group wraps, `Inline` lays out `a:` (a space after the colon, none
    // before it), and `Tight` gives `-2` (no space, whatever the rule says).
    assert(rendered(g, src, tree, 80)? == "{ a: 1, b: -2 }");

    // The same tree at a width it cannot fit: one item per indented line, plus
    // the trailing separator the style asks for.
    assert(rendered(g, src, tree, 12)? == "{\n    a: 1,\n    b: -2,\n}\n");

    // A group handed in on its own lays out the same as one reached through its
    // parent — the layout belongs to the brackets, not to what encloses them.
    assert(rendered(g, src, grp, 80)? == "{ a: 1, b: -2 }");

    // A leaf handed straight in is its own text.
    assert(rendered(g, src, Leaf(2..3), 80)? == "a");

    // A tree that does not belong to the grammar is the one way this fails.
    let stray: Cst[] = [];
    assert(rendered(g, src, Tree(9, stray), 80).failure_message() == "no production at index 9");

    // So is a group naming a style the table has no entry for.
    assert(
        rendered(
            g,
            src,
            Group(9, stray, stray, stray),
            80,
        ).failure_message() == "no group at index 9",
    );
})

# `src` laid out at `width` — `format_cst` and `print`, which is what every
# caller wants and neither half should assume.
pub fn render_cst<K: variant, A: any>(
    g: Grammar<K, A>,
    src: str,
    node: Cst,
    space: (str, str) -> bool,
    width: u64,
) -> str!ParseError { ok(format_cst(g, src, node, space)?.print(width)) }.test({
    let g = grammar_of([Inline], []);
    let src = "a b";
    let tree = Tree(0, [Leaf(0..1), Trivia(1..2), Leaf(2..3)]);
    assert(render_cst(g, src, tree, always_space, 80)? == "a b");
    assert(render_cst(g, src, tree, never_space, 80)? == "ab");
})

// ---------- pieces ----------

# A node's children, each reduced to a `Piece`. Interior children are laid out
# first, so every layout below works on finished `Doc`s and never recurses.
fn pieces<K: variant, A: any>(
    g: Grammar<K, A>,
    src: str,
    kids: Cst[],
    space: (str, str) -> bool,
) -> Piece[]!ParseError {
    mut out: Piece[] = [];
    for (let k : kids) {
        match (k) {
            Leaf(sp) => {
                set out.push(Tok(src[sp]));
            },
            // Whitespace is the author's spacing and this pass replaces it;
            // anything else the lexer set aside is a comment, and survives.
            Trivia(sp) => {
                if (!src[sp].is_all_whitespace()) {
                    set out.push(Note(src[sp], breaks_after(src, sp.end)));
                };
            },
            Tree(..) | Group(..) => {
                let d = fmt_node(g, src, k, space)?;
                let ts = k.token_leaves();
                set out.push(Node(d, edge(src, ts.first()), edge(src, ts.last())));
            },
        };
    }
    ok(out)
}

# Whether the source puts a line break right after position `at`, with only
# blanks in between — the end of a source line, in other words.
#
# This tells a line comment from a block one without asking the language: a
# comment the author ended their line with must still end a line, or it swallows
# whatever the formatter puts after it. End of input counts, there being nothing
# left to swallow.
fn breaks_after(src: str, at: u64) -> bool {
    mut i = at;
    while (i < src.len()) {
        let c = src[i..i + 1];
        if (c == "\n") {
            return true;
        };
        if (c != " " && c != "\t" && c != "\r") {
            return false;
        };
        set i++;
    }
    true
}.test({
    assert(breaks_after("// x\ny", 4));
    assert(breaks_after("// x  \ny", 4));
    assert(breaks_after("// x", 4)); // end of input
    assert(!breaks_after("/* x */ y", 7));
    assert(!breaks_after("/* x */y", 7));
})

# The text of a token span, or `""` for a child that matched no tokens.
fn edge(src: str, sp: Span?) -> str {
    match (sp) {
        some(s) => src[s],
        none => "",
    }
}.test({
    assert(edge("abc", some(1..2)) == "b");
    assert(edge("abc", none) == "");
})

# Whether `self` is the separator token `sep`. Only a token can be one, so a
# child that happens to render as `,` is not mistaken for it.
fn is_sep(self: Piece, sep: str) -> bool {
    match (self) {
        Tok(t) => t == sep,
        Node(..) | Note(..) => false,
    }
}

# Whether `self` begins a new item in a list with no separator token. Everything
# but a comment does: a comment belongs to the item it was written against.
fn starts_item(self: Piece) -> bool {
    match (self) {
        Tok(..) | Node(..) => true,
        Note(..) => false,
    }
}

// ---------- the three layouts ----------

# `Tight`: the children run together, the spacing rule not consulted.
#
# A comment still ends its line where the author ended theirs — that is not
# spacing, it is what the comment means.
fn tight(ps: Piece[]) -> Doc { Concat(ps.map(piece_doc)) }.test({
    let nothing: Piece[] = [];
    assert(tight([Tok("-"), Tok("2")]).at(80) == "-2");
    assert(tight(nothing).at(80) == "");
    assert(tight([Tok("a"), Note("/* c */", false), Tok("b")]).at(80) == "a/* c */b");
    assert(tight([Tok("a"), Note("// c", true), Tok("b")]).at(80) == "a// c\nb\n");
})

# One piece as a `Doc`, with nothing added around it.
fn piece_doc(self: Piece) -> Doc {
    match (self) {
        Tok(t) => Text(t),
        Node(d, _, _) => d,
        Note(t, brk) => if (brk) { Concat([Text(t), HardLine]) } else { Text(t) },
    }
}

# `Inline`: the children in order, with a space wherever the language's rule says
# one belongs between the spellings on either side of the gap.
#
# Nothing goes in front of the first piece, and nothing goes beside a child that
# matched no tokens — an empty `Maybe` must not leave a space behind it.
fn inline_doc(ps: Piece[], space: (str, str) -> bool) -> Doc {
    mut out: Doc[] = [];
    mut prev = "";
    for (let p : ps) {
        match (p) {
            Tok(t) => {
                if (gap_wanted(prev, t, space)) {
                    set out.push(Text(" "));
                };
                set out.push(Text(t));
                set prev = t;
            },
            Node(d, f, l) => {
                if (gap_wanted(prev, f, space)) {
                    set out.push(Text(" "));
                };
                set out.push(d);
                if (l != "") {
                    set prev = l;
                };
            },
            // A comment takes a space in front of it whatever the rule says — it
            // is prose, not punctuation — and then either ends the line or is
            // followed by one space. Either way what comes next starts fresh, so
            // the rule is never asked across a comment.
            Note(t, brk) => {
                if (prev != "") {
                    set out.push(Text(" "));
                };
                set out.push(Text(t));
                set out.push(if (brk) { HardLine } else { Text(" ") });
                set prev = "";
            },
        };
    }
    Concat(out)
}.test({
    let nothing: Piece[] = [];
    assert(inline_doc([Tok("a"), Tok(":"), Tok("1")], colon_space).at(80) == "a: 1");
    assert(inline_doc(nothing, colon_space).at(80) == "");

    // A child contributes its edges, not its whole text: the rule is asked about
    // `:` and `x`, never about the child's interior.
    let kid = Node(Text("x + y"), "x", "y");
    assert(inline_doc([Tok(":"), kid, Tok(":")], colon_space).at(80) == ": x + y:");

    // A child that matched nothing leaves no gap behind it.
    let empty_kid = Node(Concat([]), "", "");
    assert(inline_doc([Tok(":"), empty_kid, Tok("z")], colon_space).at(80) == ": z");

    // A comment ending a source line ends the formatted line too.
    assert(
        inline_doc([Tok("a"), Note("// c", true), Tok("b")], colon_space).at(80) == "a // c\nb\n",
    );
    assert(
        inline_doc([Tok("a"), Note("/*c*/", false), Tok("b")], colon_space).at(80) == "a /*c*/ b",
    );
})

# Whether a space belongs between two adjacent pieces: not in front of the first,
# not beside a child that matched no tokens, and otherwise the language's rule.
fn gap_wanted(prev: str, next: str, space: (str, str) -> bool) -> bool {
    prev != "" && next != "" && space(prev, next)
}

# A `Group` laid out: its brackets around its contents, on one line while they
# fit and otherwise one item per indented line.
#
# The brackets are read off the node, not inferred from it. That is the whole
# difference a group makes here: it says which of its kids opened it
# and which closed it, so `#{a}` (a two-token bracket), `|a, b|` (the same token
# both ends) and `match (e) { .. }` (two pairs in one production) are all just
# groups, with nothing to guess and nothing to be wrong about.
fn group_doc<K: variant, A: any>(
    g: Grammar<K, A>,
    src: str,
    gi: u64,
    open: Cst[],
    body: Cst[],
    close: Cst[],
    space: (str, str) -> bool,
) -> Doc!ParseError {
    let st = g.groups[gi].value_or_err(ParseError {
        message: `no group at index {gi}`,
        span: 0..0,
    })?;
    ok(wrapped(
        pieces(g, src, open, space)?,
        pieces(g, src, body, space)?,
        pieces(g, src, close, space)?,
        st,
        space,
    ))
}

# A bracketed list: `open`, the items, `close` — flat while it fits, otherwise
# one item per indented line with the brackets on their own.
#
# The bracket runs are laid out `Inline` rather than concatenated raw, so a
# comment written against a bracket survives and the language's spacing rule
# still gets asked about a bracket spelled as several tokens.
fn wrapped(
    open: Piece[],
    mid: Piece[],
    close: Piece[],
    st: ListStyle,
    space: (str, str) -> bool,
) -> Doc {
    // A pair that is only a pair — a block's braces — is laid out like any other
    // run of children. The group still told the *parser* where the brackets are,
    // which is the half of a group that has nothing to do with layout.
    if (!st.wraps) {
        return inline_doc([..open, ..mid, ..close], space);
    };
    let od = inline_doc(open, space);
    let cd = inline_doc(close, space);
    let items = list_items(mid, st, space);
    if (items.is_empty()) {
        return Concat([od, cd]);
    };

    // A style that reads as words takes a space inside its brackets while flat
    // (`{ a, b }`); the rest hug their contents (`(a, b)`).
    let edge = if (st.spaced) { Line } else { SoftLine };
    let step = if (st.sep == "") { Line } else { Concat([Text(st.sep), Line]) };
    mut parts = [od, Indent(Concat([edge, ..items.intersperse(step)]))];

    // A separator after the last item, written only once the list breaks. A
    // juxtaposed list has no separator to write.
    if (st.trailing && st.sep != "") {
        set parts.push(IfBroken(st.sep));
    };
    set parts.push(edge);
    set parts.push(cd);
    group(Concat(parts))
}.test({
    let parens = ListStyle { spaced: false };
    let lp = [Tok("(")];
    let rp = [Tok(")")];
    let three = [node_of("a"), Tok(","), node_of("b"), Tok(","), node_of("c")];

    assert(wrapped(lp, three, rp, parens, never_space).at(80) == "(a, b, c)");
    assert(wrapped(lp, three, rp, parens, never_space).at(5) == "(\n    a,\n    b,\n    c,\n)\n");

    // An empty list is its brackets and nothing else — no space to break at.
    let nothing: Piece[] = [];
    assert(wrapped(lp, nothing, rp, parens, never_space).at(80) == "()");
    let braces = ListStyle { spaced: true };
    assert(wrapped([Tok("{")], nothing, [Tok("}")], braces, never_space).at(80) == "{}");

    // A bracket spelled as two tokens is one bracket: the group said so, and
    // nothing here counts token runs to find out.
    assert(
        wrapped([Tok("#"), Tok("{")], [node_of("a")], [Tok("}")], parens, never_space).at(
            80,
        ) == "#{a}",
    );

    // The same token at both ends is no harder, which is what a lead/tail scan
    // could never tell apart from a list of one item.
    let pipes = [Tok("|")];
    assert(
        wrapped(pipes, [node_of("a"), Tok(","), node_of("b")], pipes, parens, never_space).at(
            80,
        ) == "|a, b|",
    );

    // Words-style braces gain inner spaces flat, and lose them broken.
    let pair = [node_of("a"), Tok(","), node_of("b")];
    let lb = [Tok("{")];
    let rb = [Tok("}")];
    assert(wrapped(lb, pair, rb, braces, never_space).at(80) == "{ a, b }");
    assert(wrapped(lb, pair, rb, braces, never_space).at(5) == "{\n    a,\n    b,\n}\n");

    // `trailing: false` is the dialect where `[1, 2,]` is an error.
    assert(
        wrapped(lb, pair, rb, ListStyle { trailing: false }, never_space).at(
            5,
        ) == "{\n    a,\n    b\n}\n",
    );

    // An empty separator is the juxtaposed list — a break between items and
    // never a trailing anything.
    let words = ListStyle { sep: "", trailing: false };
    let sexp = [node_of("a"), node_of("b")];
    assert(wrapped(lp, sexp, rp, words, never_space).at(80) == "(a b)");
    assert(wrapped(lp, sexp, rp, words, never_space).at(3) == "(\n    a\n    b\n)\n");

    // A group holding one thing is a list of one item: flat it is just the
    // brackets around it, and there is no separator to reach.
    assert(wrapped(lp, [node_of("a")], rp, parens, never_space).at(80) == "(a)");

    // A pair that is only a pair lays out inline, brackets and all — no break
    // points invented, whatever the width.
    let plain = ListStyle { wraps: false };
    assert(wrapped(lp, three, rp, plain, never_space).at(80) == "(a,b,c)");
    assert(wrapped(lp, three, rp, plain, never_space).at(3) == "(a,b,c)");

    // A comment written against the closing bracket rides with it rather than
    // being dropped. Where exactly it sits is not pretty — the space is the one
    // `inline_doc` puts after every non-breaking comment — but which side of the
    // bracket it lands on is meaning, and that is what is asserted here. The old
    // token-run scan had no place to put it at all.
    assert(
        wrapped(lp, [node_of("a")], [Note("/*c*/", false), Tok(")")], parens, never_space).at(
            80,
        ) == "(a/*c*/ )",
    );
})

# The items between a pair of brackets, each laid out inline.
#
# A token spelled like the style's separator ends the item it follows and is
# dropped; the style writes the separators back, which is what lets a list that
# breaks gain a trailing one it never had in the source. With an empty separator
# every token or child starts a new item instead, which is the juxtaposed list. A
# comment never starts one — it belongs to the item it was written against.
fn list_items(mid: Piece[], ListStyle { sep }, space: (str, str) -> bool) -> Doc[] {
    mut items: Doc[] = [];
    mut cur: Piece[] = [];
    for (let p : mid) {
        if (sep != "" && p.is_sep(sep)) {
            if (cur.is_nonempty()) {
                set items.push(inline_doc(cur, space));
                set cur = [];
            };
        } else {
            if (sep == "" && p.starts_item() && cur.is_nonempty()) {
                set items.push(inline_doc(cur, space));
                set cur = [];
            };
            set cur.push(p);
        };
    }
    if (cur.is_nonempty()) {
        set items.push(inline_doc(cur, space));
    };
    items
}.test({
    let nothing: Piece[] = [];
    let a = Node(Text("a"), "a", "a");
    let b = Node(Text("b"), "b", "b");

    assert(texts(list_items([a, Tok(","), b], ListStyle {}, never_space)) == ["a", "b"]);
    assert(list_items(nothing, ListStyle {}, never_space).is_empty());
    // A trailing separator in the source leaves no empty item behind it.
    assert(texts(list_items([a, Tok(","), b, Tok(",")], ListStyle {}, never_space)) == ["a", "b"]);
    // Juxtaposed: every child is its own item.
    assert(texts(list_items([a, b], ListStyle { sep: "" }, never_space)) == ["a", "b"]);
    // A comment rides with the item it was written against, not on its own.
    assert(
        texts(list_items([Note("/*x*/", false), a, Tok(","), b], ListStyle {}, never_space)) == [
            "/*x*/ a",
            "b",
        ],
    );
})

// ---------- test support ----------

// A token kind for this file's own tests. The driver reads a production's
// `layout` and never its `rule`, so one bare kind is enough to build a grammar
// whose trees can be written out by hand. `FKind` rather than `Kind`: a
// test-only variant named `Kind` collides with a constructor `lexer.aipl`
// declares, and the bare view drops one of the two silently.
variant FKind = Word

# A grammar of one production per layout, in order, so a hand-built
# `Tree(i, ..)` picks a layout by its index — followed by one throwaway
# production per group style, so a hand-built `Group(i, ..)` picks a style by
# its index too.
#
# The styles cannot simply be handed over: `groups` is `link`'s output, rebuilt
# from the rules every time, so the only way to put a style in the table is to
# write a rule that has one. The carrier productions are never matched against
# anything; they exist to be linked.
fn grammar_of(layouts: Layout[], groups: ListStyle[]) -> Grammar<FKind, str> {
    mut prods: Production<FKind, str>[] = [];
    for (let i, l : layouts) {
        set prods.push(prod_of(i, l));
    }
    for (let i, st : groups) {
        set prods.push(group_prod(i, st));
    }
    Grammar { prods }
}

# A production whose whole purpose is to carry one group style into `groups`.
fn group_prod(i: u64, st: ListStyle) -> Production<FKind, str> {
    let word: Rule<FKind> = Term(Word);
    Production {
        name: `g{i}`,
        rule: Many(word, min=1, max=1, nested_in=(word, word), style=st),
        build: Mk(nothing),
        layout: Inline,
    }
}

# Distinct names because `format_cst` links, and `link` refuses a grammar with
# two productions of one name.
fn prod_of(i: u64, l: Layout) -> Production<FKind, str> {
    let word: Rule<FKind> = Term(Word);
    Production { name: `p{i}`, rule: word, build: Mk(nothing), layout: l }
}

# A `build` that lowers nothing: the formatter never lowers, and a `Production`
# needs one anyway.
fn nothing(src: str, node: Cst, kids: str[]) -> str!ParseError { ok("") }

fn always_space(l: str, r: str) -> bool { true }

fn never_space(l: str, r: str) -> bool { false }

# A space after a colon and nowhere else — the smallest rule that is not a
# constant, which is what `inline_doc`'s tests need.
fn colon_space(l: str, r: str) -> bool { l == ":" }

# A spacing rule small enough to read in the driver's own tests: nothing after an
# opening bracket, nothing before a closing one or before hugging punctuation, a
# space everywhere else.
fn spaced_unless_punct(l: str, r: str) -> bool {
    l != "{" && l != "(" && r != "," && r != ":" && r != "}" && r != ")"
}

fn rendered(g: Grammar<FKind, str>, src: str, node: Cst, width: u64) -> str!ParseError {
    render_cst(g, src, node, spaced_unless_punct, width)
}

# A `Doc` at a width, for the assertions above.
fn at(self: Doc, width: u64) -> str { self.print(width) }

# A two-leaf node at `at`, standing in for a production that matched a key and
# its colon — enough shape for the driver's tests without a parse.
fn kv(at: u64) -> Cst { Tree(1, [Leaf(at..at + 1), Leaf(at + 1..at + 2)]) }

# A child piece that renders as `t` and has `t` at both edges.
fn node_of(t: str) -> Piece { Node(Text(t), t, t) }

fn texts(ds: Doc[]) -> str[] { ds.map(|d| d.at(80)) }
