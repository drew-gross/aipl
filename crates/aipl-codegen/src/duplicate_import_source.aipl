# The `duplicate_import_source` lint: the same source imported on more than one
# line. Legal, but a reader wants everything a file takes from `builtins`, or from
# one path, in a single `import { .. }`; the better spelling merges the names
# into the first.

import { Span, collect_arms, equal as ==, has, push } from builtins;
import { ParseFailure, aipl_parse_file } from "./grammar_aipl.aipl";
import { Builtins, Import, ImportSource, Path, Program } from "./item.aipl";
import { LintHit, hit } from "./lint_hit.aipl";

# A hit for each import of a source an earlier import already took names from,
# in the order the imports are written.
pub fn duplicate_import_source(Program { items }) -> LintHit[] {
    mut seen: #{str} = #{};
    mut hits: LintHit[] = [];
    for (let Import(decl) : items.collect_arms(Import)) {
        let source = decl.source;
        let key = source.key();
        if (seen.has(key)) {
            set hits.push(hit(source.message(), source.span()));
        };
        set seen = #{..seen, key};
    }
    hits
}

# Which source an import names, so two imports of one compare equal: the spans
# differ between them, and a path is not the `builtins` import.
fn key(self: ImportSource) -> str {
    match (self) {
        Path(path, _) => `path {path}`,
        Builtins(..) => "builtins",
    }
}

# The source as written, which is where the caret goes: it is on the import's one
# line however its names are laid out.
fn span(self: ImportSource) -> Span {
    match (self) {
        Path(_, span) | Builtins(span) => span,
    }
}

# What is said of a redundant import from `self`.
fn message(self: ImportSource) -> str {
    match (self) {
        Path(path, _) => `duplicate import from "{path}"; merge the names into the first \`import \{ .. } from "{path}";\` (or append #[allow] to this line to keep it)`,
        Builtins(..) => """duplicate import from "builtins"; merge the names into the first `import { .. } from builtins;` (or append #[allow] to this line to keep it)""",
    }
}

fn duplicates(src: str) -> LintHit[]!ParseFailure {
    ok(duplicate_import_source(aipl_parse_file(src)?.program))
}.test({
    // One import of each source is fine, however many names it takes.
    assert(
        duplicates("""
            import { map, filter } from builtins;
            import { a } from "./a.aipl";
            import { b } from "./b.aipl";
        """)? == [],
    );

    // The second `builtins` import is the redundant one, and the caret goes under
    // its source.
    let src = "import { map } from builtins;\nimport { len } from builtins;\nfn f() { }";
    assert(duplicate_import_source(aipl_parse_file(src)?.program)$span == [50..58]);
    assert(duplicate_import_source(aipl_parse_file(src)?.program)$message == [
        """duplicate import from "builtins"; merge the names into the first `import { .. } from builtins;` (or append #[allow] to this line to keep it)""",
    ]);

    // A path is told apart from `builtins` and from another path, and each
    // redundant import is reported, not just the first.
    let paths = duplicates("""
        import { a } from "./a.aipl";
        import { map } from builtins;
        import { b } from "./a.aipl";
        import { c } from "./c.aipl";
        import { d } from "./a.aipl";
    """)?;
    assert(paths$message == [
        """duplicate import from "./a.aipl"; merge the names into the first `import { .. } from "./a.aipl";` (or append #[allow] to this line to keep it)""",
        """duplicate import from "./a.aipl"; merge the names into the first `import { .. } from "./a.aipl";` (or append #[allow] to this line to keep it)""",
    ]);
})
