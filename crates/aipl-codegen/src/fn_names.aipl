# The names the parser gives functions it synthesizes from a declaration's
# attributes, and the inverse: what a function's name says it is.
#
# A `.test({ .. })` block on `f` becomes the function `__test$f`; a function
# declared inside that block is hoisted to `__test$f$helper`; a
# `.benchmark({ .. })` block on `f` becomes `__benchmark$f`, whose own
# `.test` body is the block. A `$` cannot appear in a source name, so no program
# can spell any of them, and a `$` past the prefix is the mark of something
# synthesized from a body rather than the body itself — a lambda lifted out of a
# test body is `__test$f$lambda0`, and its `?` acts on the lambda's own return
# type.
#
# Rust asks the questions of this file through the FFI (`fn_role`, `test_fn_name`,
# `benchmark_fn_name`); `test_helper_name` is only asked by the pass that
# hoists helpers, which is AIPL too.

import {
    contains,
    equal as ==,
    find_index,
    is_nonempty,
    len,
    logical_and as &&,
    logical_not as !,
    map,
    starts_with,
    value_or,
    wrapping_add as +,
} from builtins;

let TEST_PREFIX = "__test$";

let BENCHMARK_PREFIX = "__benchmark$";

let UNATTACHED_TEST_PREFIX = "__test_block_";

let UNATTACHED_BENCHMARK_PREFIX = "__benchmark_block_";

# What a function's name says it is. A source name is `Plain`.
#
# - `TestBody`: exactly a `.test` body (`__test$f`, or `__test$__benchmark$f`
#   for a `.benchmark` block).
# - `TestHelper(helper)`: a function hoisted out of a `.test` block, with the
#   name it was declared with.
# - `Benchmark(source)`: the function standing for `source`'s `.benchmark`
#   block.
variant FnRole = Plain | TestBody | TestHelper(helper: str) | Benchmark(source: str)

# The name of the function a `.test` block on `f` becomes.
pub fn test_fn_name(f: str) -> str { `{TEST_PREFIX}{f}` }.test({
    assert(test_fn_name("map") == "__test$map");
})

# The name of the function standing for `f`'s `.benchmark` block.
pub fn benchmark_fn_name(f: str) -> str { `{BENCHMARK_PREFIX}{f}` }.test({
    assert(benchmark_fn_name("map") == "__benchmark$map");
})

# The name of the function standing for a top-level `test({ .. })` block, which
# is attached to no function. `ordinal` counts the file's such blocks from 1, so
# the name does not move when anything else in the file does (a pinned `aipl
# report` lists it). The name is a plain function's, and its own `.test` body is
# the block, so the block reaches everything downstream as the test code of a
# function nobody calls.
pub fn unattached_test_name(ordinal: u64) -> str { `{UNATTACHED_TEST_PREFIX}{ordinal}` }.test({
    assert(unattached_test_name(2) == "__test_block_2");
    assert(unattached_test_name(2).fn_role() == Plain);
    assert(test_fn_name(unattached_test_name(2)).fn_role() == TestBody);
})

# The name of the function standing for a top-level `benchmark({ .. })` block: a plain
# function with an empty body that carries the block as its `.benchmark`, numbered like
# `unattached_test_name`'s.
pub fn unattached_benchmark_name(ordinal: u64) -> str {
    `{UNATTACHED_BENCHMARK_PREFIX}{ordinal}`
}.test({
    assert(unattached_benchmark_name(2) == "__benchmark_block_2");
    assert(unattached_benchmark_name(2).fn_role() == Plain);
    assert(benchmark_fn_name(unattached_benchmark_name(2)).fn_role() == Benchmark(
        "__benchmark_block_2",
    ));
})

# Whether `self` is a name `unattached_benchmark_name` made.
pub fn is_unattached_benchmark(self: str) -> bool {
    self.starts_with(UNATTACHED_BENCHMARK_PREFIX)
}.test({
    assert(unattached_benchmark_name(1).is_unattached_benchmark());
    assert(!unattached_test_name(1).is_unattached_benchmark());
    assert(!"map".is_unattached_benchmark());
})

# Whether `self` is a name `unattached_test_name` made.
pub fn is_unattached_test(self: str) -> bool { self.starts_with(UNATTACHED_TEST_PREFIX) }.test({
    assert(unattached_test_name(1).is_unattached_test());
    assert(!"map".is_unattached_test());
})

# The top-level name a function declared inside `f`'s `.test` block is hoisted
# to. Under the test body's prefix so it reads as the test's, and past it so
# `fn_role` says `TestHelper` rather than `TestBody`: a helper's `?` acts on its
# own return type, like any function's.
pub fn test_helper_name(f: str, helper: str) -> str { `{test_fn_name(f)}${helper}` }.test({
    assert(test_helper_name("map", "fixture") == "__test$map$fixture");
})

# What follows `prefix` in `self`, or `none` when `self` does not start with it.
fn after(self: str, prefix: str) -> str? {
    if (self.starts_with(prefix)) { some(self[prefix.len()..]) } else { none }
}.test({
    assert("__test$f".after("__test$") == some("f"));
    assert("__test$".after("__test$") == some(""));
    assert("map".after("__test$") == none);
})

# What follows `__test$`, split into the function the test belongs to and
# whatever was synthesized under it (empty for the body itself, `$<..>` for
# anything else). The owner is `<f>`, or `__benchmark$<f>` for a
# `.benchmark` block; one with no name is no owner.
fn split_test_owner(rest: str) -> (str, str)? {
    let owner_start = match (rest.after(BENCHMARK_PREFIX)) {
        some(..) => BENCHMARK_PREFIX.len(),
        none => 0,
    };
    let end = rest[owner_start..]
        .find_index(|c| c == '$')
        .map(|i| owner_start + i)
        .value_or(rest.len());
    let owner = rest[..end];
    let named = match (owner.after(BENCHMARK_PREFIX)) {
        some(f) => f.is_nonempty(),
        none => owner.is_nonempty(),
    };
    if (named) { some((owner, rest[end..])) } else { none }
}.test({
    assert(split_test_owner("f") == some(("f", "")));
    assert(split_test_owner("f$lambda0") == some(("f", "$lambda0")));
    assert(split_test_owner("__benchmark$f") == some(("__benchmark$f", "")));
    assert(split_test_owner("__benchmark$f$g") == some(("__benchmark$f", "$g")));
    assert(split_test_owner("") == none);
    assert(split_test_owner("$x") == none);
    assert(split_test_owner("__benchmark$") == none);
})

# Classify a function by its name — see `FnRole`.
pub fn fn_role(self: str) -> FnRole {
    match (self.after(BENCHMARK_PREFIX)) {
        some(source) => if (source.is_nonempty() && !source.contains("$")) {
            Benchmark(source)
        } else {
            Plain
        },
        none => self.test_role(),
    }
}.test({
    assert("map".fn_role() == Plain);
    assert("__m9__at_end".fn_role() == Plain);
    assert(test_fn_name("map").fn_role() == TestBody);
    assert(test_fn_name("__m9__at_end").fn_role() == TestBody);
    assert(test_helper_name("map", "fixture").fn_role() == TestHelper("fixture"));
    assert(benchmark_fn_name("map").fn_role() == Benchmark("map"));

    // Something synthesized under a test body is neither the body nor a helper.
    assert("__test$map$lambda0".fn_role() == TestHelper("lambda0"));
    assert("__test$map$fixture$lambda0".fn_role() == Plain);
    assert("__test$map$".fn_role() == Plain);
    assert("__test$".fn_role() == Plain);
    assert("__test_main".fn_role() == Plain);
    assert("__benchmark$".fn_role() == Plain);
    assert("__benchmark$a$b".fn_role() == Plain);

    // A `.benchmark` block is test code attached to a function the parser
    // invented, so its body and helpers are named under `__test$__benchmark$`.
    let perf = benchmark_fn_name("map");
    assert(test_fn_name(perf).fn_role() == TestBody);
    assert(test_helper_name(perf, "fixture").fn_role() == TestHelper("fixture"));
    assert("__test$__benchmark$".fn_role() == Plain);
    assert(`{test_fn_name(perf)}$lambda0`.fn_role() == TestHelper("lambda0"));
})

# What follows the owner in a `__test$` name, or `none` when `self` is not one.
fn test_tail(self: str) -> str? {
    match (self.after(TEST_PREFIX)) {
        some(rest) => split_test_owner(rest)$1,
        none => none,
    }
}

fn test_role(self: str) -> FnRole { self.test_tail().map(tail_role).value_or(Plain) }

# The role of a `__test$` name from what follows its owner.
fn tail_role(tail: str) -> FnRole {
    match (tail.after("$")) {
        none => if (tail.is_nonempty()) { Plain } else { TestBody },
        some(helper) => if (helper.is_nonempty() && !helper.contains("$")) {
            TestHelper(helper)
        } else {
            Plain
        },
    }
}
