# What a lint reports: the message, and the span the caret goes under. The Rust
# side rebuilds each as an `aipl_syntax::Error` and runs it through the same
# `#[allow]` squelching as the lints still written in Rust.

import {
    Span,
    collect_arms,
    contains,
    ends_with,
    equal as ==,
    filter,
    first,
    greater_than_or_equal as >=,
    is_err_and,
    is_nonempty,
    is_some,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    map,
    map_join,
    push,
    starts_with,
    value_or,
} from builtins;
import { Bool, Call, Char, Expr, Field, Ident, Num, Str, expr, ident, num } from "../expr.aipl";
import { ParseFailure, aipl_parse_surface_file } from "../grammar_aipl.aipl";
import { Fn, Function, Import, ImportDecl, Item, Program, Signature, local } from "../item.aipl";

struct LintHit { message: str, span: Span }

# A hit at `span`.
pub fn hit(message: str, span: Span) -> LintHit { message, span }.test({
    assert(hit("m", 3..5) == LintHit { message: "m", span: 3..5 });
})

# A hit whose message names builtins the way the file that was linted spells them.
# A lint cannot say how: it reads one function, and the spelling is in the import
# list, so it reports the message in parts — each stretch of text followed by the
# name of a builtin, then a closing stretch — and the caller fills the names in. A
# file that does not import a builtin is told to, which the lint need not know either.
struct UnfilledHit { named: Named[], tail: str, span: Span }

# Some text and the builtin whose name follows it in the message.
struct Named { text: str, builtin: str }

# An unfilled hit at `span` for a message `before` + the builtin's name + `after`.
pub fn unfilled(builtin: str, before: str, after: str, span: Span) -> UnfilledHit {
    named: [Named { text: before, builtin }],
    tail: after,
    span,
}.test({
    assert(unfilled("len", "use ", "()", 1..2).span == 1..2);
})

# `self` without a name it has already listed, in the order it first appears.
fn distinct(self: str[]) -> str[] {
    mut seen: str[] = [];
    for (let name : self) {
        if (!seen.contains(name)) { set seen.push(name); };
    }
    seen
}.test({
    assert(["map", "join", "map"].distinct() == ["map", "join"]);
    assert([].distinct() == []);
})

# `self` as the hit it is for a file that spells builtin `name` as `spelled(name)`,
# or does not import it (`none`).
pub fn filled_with(self: UnfilledHit, spelled: (str) -> str?) -> LintHit {
    let text = self.named.map_join(
        |part| `{part.text}{spelled(part.builtin).value_or(part.builtin)}`,
    );
    let missing = self.named$builtin.filter(|builtin| !spelled(builtin).is_some()).distinct();
    let hint = if (missing.is_nonempty()) {
        `, importing {missing.map(|builtin| `\`{builtin}\``).join(sep=", ", final_sep=" and ", only_sep=" and ")} from builtins`
    } else {
        ""
    };
    hit(`{text}{self.tail}{hint}`, self.span)
}.test({
    let advice = unfilled("is_case", "write ", "(x)", 4..5);
    assert(advice.filled_with(|name| none) == hit(
        "write is_case(x), importing `is_case` from builtins",
        4..5,
    ));
    assert(advice.filled_with(|name| some("isa")) == hit("write isa(x)", 4..5));

    // Several missing imports read as a sentence: `a` and `b`, or `a`, `b` and `c`.
    let chain = UnfilledHit {
        named: [
            Named { text: "", builtin: "filter" },
            Named { text: ".", builtin: "map" },
            Named { text: ".", builtin: "join" },
        ],
        tail: "",
        span: 0..1,
    };
    assert(
        chain.filled_with(
            |name| none,
        ).message == "filter.map.join, importing `filter`, `map` and `join` from builtins",
    );
    assert(
        chain.filled_with(|name| if (name == "join") {
            some("join")
        } else {
            none
        }).message == "filter.map.join, importing `filter` and `map` from builtins",
    );
    let pair = UnfilledHit {
        named: [Named { text: "a ", builtin: "map" }, Named { text: " b ", builtin: "value_or" }],
        tail: " c",
        span: 1..2,
    };
    assert(
        pair.filled_with(|name| if (name == "map") {
            some("m")
        } else {
            none
        }).message == "a m b value_or c, importing `value_or` from builtins",
    );
})

# `self` filled in for the file whose items are `items`.
pub fn filled(self: UnfilledHit[], items: Item[]) -> LintHit[] {
    self$filled_with(|name| items.imported_as(name))
}.test({
    let items = aipl_parse_surface_file("import { is_case as isa } from builtins;")?.program.items;
    assert([unfilled("is_case", "write ", "(x)", 0..1), unfilled("len", "use ", "", 1..2)].filled(
        items,
    )$message == ["write isa(x)", "use len, importing `len` from builtins"]);
})

# What `lint` reports for the program `src` parses to. The one way the lints'
# `.test` blocks run a lint over source text: pass the lint function itself.
pub fn lint_hits(src: str, lint: (Program) -> LintHit[]) -> LintHit[]!ParseFailure {
    ok(lint(aipl_parse_surface_file(src)?.program))
}.test({
    assert(lint_hits("fn f() { }", |program: Program| { [hit("found", 0..1)] })? == [
        hit("found", 0..1),
    ]);
    assert(lint_hits("fn (", |program: Program| { [] }).is_err_and(
        |failure| failure.errors.is_nonempty(),
    ));
})

# [`lint_hits`], keeping only the messages.
pub fn lint_messages(src: str, lint: (Program) -> LintHit[]) -> str[]!ParseFailure {
    ok(lint_hits(src, lint)?$message)
}.test({
    assert(lint_messages("fn f() { }", |program: Program| { [hit("found", 0..1)] })? == ["found"]);
})

# Whether `self`'s span covers exactly the text that spells it, so the source can be
# spliced back into advice. Only a name and a field path off one qualify: their spans
# run from the first character to the last. Most other forms do not — a call's span
# stops before its closing paren, so `f(x)` splices back as `f(x`, which doesn't
# parse — and the ones that might are left out rather than each having to be
# re-checked whenever a span moves.
pub fn spans_its_text(self: Expr) -> bool {
    match (self.kind) {
        Ident(..) => true,
        Field(receiver, _) => receiver.spans_its_text(),
        _ => false,
    }
}.test({
    assert(ident("x").spans_its_text());
    assert(expr(Field(ident("p"), "x")).spans_its_text());
    assert(!expr(Call("f", [ident("x")], false)).spans_its_text());
    assert(!expr(Field(expr(Call("f", [], false)), "x")).spans_its_text());
})

# What advice quotes for the expression `self`: its source where that spells it exactly
# — a name, a field path off one, or a literal written on one line — and `placeholder`
# for the rest. A literal is *checked* against the source rather than assumed, because
# the parser also synthesizes literals that carry no text of their own.
pub fn quote(self: Expr, placeholder: str) -> str {
    let text = self.source;
    let spells_it = match (self.kind) {
        Num(n) => text == `{n}`,
        Bool(b) => text == `{b}`,
        Char(..) => text.len() >= 3 && text.starts_with("'") && text.ends_with("'"),
        Str(..) => text.len() >= 2 && text.starts_with(`"`) && text.ends_with(
            `"`,
        ) && !text.contains("\n"),
        _ => self.spans_its_text(),
    };
    if (spells_it) { text } else { placeholder }
}.test({
    assert(Expr { ..ident("xs"), source: "xs" }.quote("<array>") == "xs");
    assert(Expr { ..num(5), source: "5" }.quote("<element>") == "5");
    assert(Expr { ..expr(Bool(true)), source: "true" }.quote("<element>") == "true");
    assert(Expr { ..expr(Str("a b")), source: `"a b"` }.quote("<element>") == `"a b"`);
    assert(Expr { ..expr(Char('c')), source: "'c'" }.quote("<element>") == "'c'");

    // A literal with no text of its own, a call and a multi-line string are not quoted.
    assert(num(5).quote("<element>") == "<element>");
    assert(Expr { ..expr(Call("f", [], false)), source: "f(" }.quote("<element>") == "<element>");
    assert(Expr { ..expr(Str("a\nb")), source: `"a\nb"` }.quote("<element>") == "<element>");
})

# The name a file's `items` import builtin `name` under, if it does: the spelling a
# lint's advice should use. `none` when the file does not import it, which is when
# the advice has to say so.
pub fn imported_as(self: Item[], name: str) -> str? {
    self.collect_arms(Import)$builtin_locals(name).join().first()
}.test({
    let program = aipl_parse_surface_file(
        "import { is_case as case_is, len } from builtins;",
    )?.program.items;
    assert(program.imported_as("is_case") == some("case_is"));
    assert(program.imported_as("len") == some("len"));
    assert(program.imported_as("map") == none);
    let from_a_file = aipl_parse_surface_file(
        """import { is_case } from "./a.aipl";""",
    )?.program.items;
    assert(from_a_file.imported_as("is_case") == none);
})

# Every name a file's `items` import from builtins, as the file spells it.
pub fn imported_locals(self: Item[]) -> str[] {
    self.collect_arms(Import)$builtin_names().join()
}.test({
    let items = aipl_parse_surface_file(
        """import { is_case as case_is, len } from builtins; import { a } from "./a.aipl";""",
    )?.program.items;
    assert(items.imported_locals() == ["case_is", "len"]);
})

# What an import from builtins brings, as the file spells each.
fn builtin_names(self: Import(ImportDecl { names, source })) -> str[] {
    match (source) {
        Builtins => names$local(),
        Path(..) => [],
    }
}

# What an import brings under `name`, when it is from builtins.
fn builtin_locals(self: Import(ImportDecl { names, source }), name: str) -> str[] {
    match (source) {
        Builtins => names.filter(|n| n.name == name)$local(),
        Path(..) => [],
    }
}

# Lints come in two kinds. A *program* lint is a function of the whole `Program`
# (`unused_imports`, which compares the imports with every name the file
# mentions). A *function* lint is a function of one `Function`, and [`on_functions`]
# is what runs it over a program, so no function lint decides for itself which
# bodies to look at.
#
# Every body that is code to check is a function here: each function, the `.test`
# block it carries, the `.performance` block it carries, and the helpers declared
# in a `.test` block. A block is checked as a function of its own when tests run, so
# it is handed over as one — no parameters, no return type, the block as its body.
pub fn on_functions(self: Program, lint: (Function) -> LintHit[]) -> LintHit[] {
    self.code_bodies()$lint().join()
}.test({
    // Each function, once.
    assert(lint_function_messages(
        "fn f() { } fn g() { }",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "g"]);

    // A `.test` block, a `.performance` block and the helpers declared in a block
    // are each another body of the function that carries them.
    assert(lint_function_messages(
        "fn f() { }.test({ g(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "f"]);
    assert(lint_function_messages(
        "fn f() { }.performance({ g(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "f"]);
    assert(lint_function_messages(
        "fn f() { }.test({ fn h() { } h(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "f", "h"]);

    // A block has no parameters of its own.
    assert(lint_function_messages(
        "fn f(x: i64) { }.test({ g(); })",
        |function| { [hit(`{function.sig.params.len()}`, 0..1)] },
    )? == ["1", "0"]);
})

# [`on_functions`] for a lint whose hits are [`UnfilledHit`]s.
pub fn on_functions_unfilled(self: Program, lint: (Function) -> UnfilledHit[]) -> UnfilledHit[] {
    self.code_bodies()$lint().join()
}

# [`on_functions_unfilled`], each hit filled in for the program's own imports.
pub fn on_functions_filled(self: Program, lint: (Function) -> UnfilledHit[]) -> LintHit[] {
    self.on_functions_unfilled(lint).filled(self.items)
}

# Every body of the program that is code to check, each as a function.
fn code_bodies(self: Program { items }) -> Function[] {
    items.collect_arms(Fn)$declared()$bodies().join()
}

fn declared(self: Fn(function)) -> Function { function }

# `self`, and a function standing for each other body it holds.
fn bodies(self: Function) -> Function[] {
    let test = self.test_body.map(|body| [self.standing_in(body)]).value_or([]);
    let performance = self.performance.map(|block| [self.standing_in(block.body)]).value_or([]);
    [self, ..test, ..performance, ..self.test_fns]
}

# `self`, with `body` as its whole body: what a block is when it is checked. A block
# runs with every effect allowed, which no function can declare, so it stands in as
# one declaring `*`.
fn standing_in(self: Function, body: Expr) -> Function {
    ..self,
    sig: Signature { type_vars: [], params: [], effects: ["*"], return_ty: none },
    body,
    shorthand_body: false,
    test_body: none,
    test_fns: [],
    performance: none,
}

# What the function lint `lint` reports for the program `src` parses to.
pub fn lint_function_hits(src: str, lint: (Function) -> LintHit[]) -> LintHit[]!ParseFailure {
    lint_hits(src, |program: Program| { program.on_functions(lint) })
}

# [`lint_function_hits`], keeping only the messages.
pub fn lint_function_messages(src: str, lint: (Function) -> LintHit[]) -> str[]!ParseFailure {
    ok(lint_function_hits(src, lint)?$message)
}

# What the function lint `lint` reports for the program `src` parses to, filled in
# for the imports `src` has.
pub fn lint_function_unfilled_hits(
    src: str,
    lint: (Function) -> UnfilledHit[],
) -> LintHit[]!ParseFailure {
    let program = aipl_parse_surface_file(src)?.program;
    ok(program.on_functions_filled(lint))
}

# [`lint_function_unfilled_hits`], keeping only the messages.
pub fn lint_function_unfilled_messages(
    src: str,
    lint: (Function) -> UnfilledHit[],
) -> str[]!ParseFailure { ok(lint_function_unfilled_hits(src, lint)?$message) }
