# What a lint reports: the message, and the span the caret goes under. The Rust
# side rebuilds each as an `aipl_syntax::Error`.

import {
    Span,
    any,
    collect_arms,
    collect_ok,
    contains,
    distinct,
    ends_with,
    equal as ==,
    filter,
    find_if,
    greater_than_or_equal as >=,
    is_empty,
    is_err_and,
    is_nonempty,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    map,
    not_equal as !=,
    starts_with,
    value_or,
    zip_with,
} from builtins;
import {
    Any,
    Callee,
    Filter,
    IsCase,
    Join,
    Len,
    Map,
    Union,
    Unresolved,
    import_name,
    lint_table,
} from "../builtin_table.aipl";
import { Bool, Call, Char, Expr, Field, Ident, Num, Str, expr, ident, num } from "../expr.aipl";
import { ParseFailure, aipl_parse_surface_file } from "../grammar_aipl.aipl";
import { hoist_test_fns } from "../hoist_test_fns.aipl";
import { Function, Item, LoweredFn, Program } from "../item.aipl";
import {
    ResolvedProgram,
    resolve_callees,
    resolve_with_every_builtin,
} from "../resolve_callees.aipl";
import { Builtin, Need, Request, Spelling, is_builtin_named, spelled } from "./spelling.aipl";

struct LintHit { message: str, span: Span }

# A hit at `span`.
pub fn hit(message: str, span: Span) -> LintHit { message, span }.test({
    assert(hit("m", 3..5) == LintHit { message: "m", span: 3..5 });
})

# A hit whose message names builtins the way the file that was linted spells them.
# A lint cannot say how: it reads one function, and the spelling is in the import
# list, so it reports the message in parts — each stretch of text followed by the
# builtin its rewrite uses, then a closing stretch — and the framework writes each in
# the way the file can take (see `spelling.aipl`), adding the import the file lacks.
struct UnfilledHit { named: Named[], tail: str, span: Span }

# An [`UnfilledHit`] with nowhere to point yet: what a lint over one node says of it, the node being
# the caller's to name. [`advised`] puts each at the node it is for.
struct Advice { named: Named[], tail: str }

# Some text and what its message goes on to name.
struct Named { text: str, builtin: Need }

# An unfilled hit at `span` for a message `before` + the builtin's spelling + `after`.
pub fn unfilled(builtin: Callee, before: str, after: str, span: Span) -> UnfilledHit {
    named: [Named { text: before, builtin: Builtin(builtin) }],
    tail: after,
    span,
}.test({
    assert(unfilled(Len, "use ", "()", 1..2).span == 1..2);
})

# An advice for a message `before` + the builtin's spelling + `after`.
pub fn advice(builtin: Callee, before: str, after: str) -> Advice {
    named: [Named { text: before, builtin: Builtin(builtin) }],
    tail: after,
}.test({
    assert(advice(Len, "use ", "()").named == [Named { text: "use ", builtin: Builtin(Len) }]);
})

# `advice`, when there is one, as the hit at the node `self`: a lint of one node says what is wrong
# with it, and the node's own span is where that is pointed.
pub fn hit_at(self: Expr, advice: Advice?) -> UnfilledHit? { some(advice?.at(self.span)) }

# The hit that `self` is when it is about the node whose span is `span`.
pub fn at(self: Advice, span: Span) -> UnfilledHit {
    named: self.named,
    tail: self.tail,
    span,
}.test({
    assert(advice(Len, "use ", "()").at(1..2) == unfilled(Len, "use ", "()", 1..2));
})

# `self` as the hit it is for a file that writes each thing it names as `spell` says, or `none`
# when some of them cannot be written: the advice is dropped.
pub fn filled_with(self: UnfilledHit, spell: (Need) -> Spelling?) -> LintHit? {
    let spellings = self.named.map(|part| spell(part.builtin)).collect_ok();
    if (spellings.len() != self.named.len()) { return none; };
    let text = zip_with(
        self.named,
        spellings,
        |part: Named, spelling: Spelling| { `{part.text}{spelling.text}` },
    ).join();
    let requests = spellings$request.collect_ok().distinct();
    let libraries = requests$library.distinct();
    let hint = if (requests.is_nonempty()) {
        `, importing {libraries.map(|library| `{requests.filter(|request| request.library == library)$item.quoted_list()} from {library}`).join(sep=", ", final_sep=" and ", only_sep=" and ")}`
    } else {
        ""
    };
    some(hit(`{text}{self.tail}{hint}`, self.span))
}.test({
    let advice = unfilled(IsCase, "write ", "(x)", 4..5);
    assert(advice.filled_with(|need| some(Spelling {
        text: "is_case",
        request: some(Request { library: "builtins", item: "is_case" }),
    })) == some(hit("write is_case(x), importing `is_case` from builtins", 4..5)));
    assert(advice.filled_with(|need| some(Spelling { text: "isa", request: none })) == some(hit(
        "write isa(x)",
        4..5,
    )));

    // Advice for what cannot be written is dropped.
    assert(advice.filled_with(|need| none) == none);

    // Several missing imports read as a sentence: `a` and `b`, or `a`, `b` and `c`.
    let chain = UnfilledHit {
        named: [
            Named { text: "", builtin: Builtin(Filter) },
            Named { text: ".", builtin: Builtin(Map) },
            Named { text: ".", builtin: Builtin(Join) },
        ],
        tail: "",
        span: 0..1,
    };
    assert(
        chain.filled_with(|need| some(Spelling {
            text: "x",
            request: some(Request { library: "builtins", item: "x" }),
        }))?.message == "x.x.x, importing `x` from builtins",
    );
    assert(
        chain.filled_with(|need| match (need) {
            Builtin(Join) => some(Spelling { text: "join", request: none }),
            Builtin(Filter) => some(Spelling {
                text: "filter",
                request: some(Request { library: "builtins", item: "filter" }),
            }),
            _ => some(Spelling {
                text: "map",
                request: some(Request { library: "builtins", item: "map" }),
            }),
        })?.message == "filter.map.join, importing `filter` and `map` from builtins",
    );

    // Imports are grouped by the library they come from.
    let pair = UnfilledHit {
        named: [
            Named { text: "a ", builtin: Builtin(Map) },
            Named { text: " b ", builtin: Builtin(Union) },
        ],
        tail: " c",
        span: 1..2,
    };
    assert(
        pair.filled_with(|need| some(Spelling {
            text: "n",
            request: some(Request { library: "builtins", item: "n" }),
        }))?.message == "a n b n c, importing `n` from builtins",
    );
})

# `self` with each thing it names written as `spelled`, the spelling a file that imports them has
# (`none`: it imports none, and the advice names the import). For a lint's own test of the message
# it gives.
pub fn filled_assuming(self: UnfilledHit, spelled: str?) -> str {
    let table = lint_table();
    self
        .filled_with(|need| match (need) {
            Builtin(callee) => table
                .find_if(|entry| entry.arm == callee)
                .map(|entry| match (spelled) {
                    some(text) => Spelling { text, request: none },
                    none => Spelling {
                        text: entry.import_name(),
                        request: some(Request {
                            library: entry.library,
                            item: entry.import_name(),
                        }),
                    },
                }),
        })$message
        .value_or("")
}.test({
    assert(unfilled(Len, "use ", "()", 0..1).filled_assuming(some("size")) == "use size()");
    assert(
        unfilled(Len, "use ", "()", 0..1).filled_assuming(
            none,
        ) == "use len(), importing `len` from builtins",
    );
})

# `self` filled in for the file whose items are `items`.
pub fn filled(self: UnfilledHit[], items: Item[]) -> LintHit[] {
    if (self.is_empty()) { return []; };
    let table = lint_table();
    self$filled_with(|need| need.spelled(items, table)).collect_ok()
}.test({
    let items = aipl_parse_surface_file(
        "import { is_case as isa } from builtins;",
    )?.program.hoist_test_fns().items;
    assert([unfilled(IsCase, "write ", "(x)", 0..1), unfilled(Len, "use ", "", 1..2)].filled(
        items,
    )$message == ["write isa(x)", "use len, importing `len` from builtins"]);

    // A name the file has for something else is not the builtin's: it is imported under another.
    assert([unfilled(Len, "use ", "", 1..2)].filled(
        aipl_parse_surface_file("fn len() { }")?.program.hoist_test_fns().items,
    )$message == ["use builtin_len, importing `len as builtin_len` from builtins"]);
})

# What `lint` reports for the program `src` parses to. The one way the lints'
# `.test` blocks run a lint over source text: pass the lint function itself.
pub fn lint_hits(src: str, lint: (ResolvedProgram) -> LintHit[]) -> LintHit[]!ParseFailure {
    ok(lint(aipl_parse_surface_file(src)?.program.hoist_test_fns().resolve_callees()))
}.test({
    assert(lint_hits("fn f() { }", |program: ResolvedProgram| { [hit("found", 0..1)] })? == [
        hit("found", 0..1),
    ]);
    assert(lint_hits("fn (", |program: ResolvedProgram| { [] }).is_err_and(
        |failure| failure.errors.is_nonempty(),
    ));
})

# [`lint_hits`], keeping only the messages.
pub fn lint_messages(src: str, lint: (ResolvedProgram) -> LintHit[]) -> str[]!ParseFailure {
    ok(lint_hits(src, lint)?$message)
}.test({
    assert(lint_messages("fn f() { }", |program: ResolvedProgram| { [hit("found", 0..1)] })? == [
        "found",
    ]);
})

# Whether `self`'s span covers exactly the text that spells it, so the source can be
# spliced back into advice. Only a name and a field path off one qualify: their spans
# run from the first character to the last. Most other forms do not — a call's span
# stops before its closing paren, so `f(x)` splices back as `f(x`, which doesn't
# parse — and the ones that might are left out rather than each having to be
# re-checked whenever a span moves.
pub fn spans_its_text(self: Expr) -> bool {
    match (self.kind) {
        Ident(..) => true,
        Field(receiver, _) => receiver.spans_its_text(),
        _ => false,
    }
}.test({
    assert(ident("x").spans_its_text());
    assert(expr(Field(ident("p"), "x")).spans_its_text());
    assert(!expr(Call("f", [ident("x")], false, Unresolved)).spans_its_text());
    assert(!expr(Field(expr(Call("f", [], false, Unresolved)), "x")).spans_its_text());
})

# What advice quotes for the expression `self`: its source where that spells it exactly
# — a name, a field path off one, or a literal written on one line — and `placeholder`
# for the rest. A literal is *checked* against the source rather than assumed, because
# the parser also synthesizes literals that carry no text of their own.
pub fn quote(self: Expr, placeholder: str) -> str {
    let text = self.source;
    let spells_it = match (self.kind) {
        Num(n) => text == `{n}`,
        Bool(b) => text == `{b}`,
        Char(..) => text.len() >= 3 && text.starts_with("'") && text.ends_with("'"),
        Str(..) => text.len() >= 2 && text.starts_with(`"`) && text.ends_with(
            `"`,
        ) && !text.contains("\n"),
        _ => self.spans_its_text(),
    };
    if (spells_it) { text } else { placeholder }
}.test({
    assert(Expr { ..ident("xs"), source: "xs" }.quote("<array>") == "xs");
    assert(Expr { ..num(5), source: "5" }.quote("<element>") == "5");
    assert(Expr { ..expr(Bool(true)), source: "true" }.quote("<element>") == "true");
    assert(Expr { ..expr(Str("a b")), source: `"a b"` }.quote("<element>") == `"a b"`);
    assert(Expr { ..expr(Char('c')), source: "'c'" }.quote("<element>") == "'c'");

    // A literal with no text of its own, a call and a multi-line string are not quoted.
    assert(num(5).quote("<element>") == "<element>");
    assert(
        Expr { ..expr(Call("f", [], false, Unresolved)), source: "f(" }.quote(
            "<element>",
        ) == "<element>",
    );
    assert(Expr { ..expr(Str("a\nb")), source: `"a\nb"` }.quote("<element>") == "<element>");
})

# Lints come in two kinds. A *program* lint is a function of the whole `Program`
# (`unused_imports`, which compares the imports with every name the file
# mentions). A *function* lint is a function of one `Function`, and [`hits`] and its
# variants run it over the program's [`functions`], so no function lint decides for itself
# which bodies to look at. A function lint that needs to know the file's imports takes its
# `items` beside the function.
#
# The program is read after hoisting, so every body that is code to check is a function: each
# function, the `.test` and `.benchmark` blocks as the functions they became, and the helpers
# declared in a block.
#
# Every function of the program, in the order it is written.
pub fn functions(self: Program) -> Function[] {
    self.items.collect_arms::<LoweredFn>()$declared()
}.test({
    // Each function once, and the function each block is.
    assert(lint_function_messages(
        "fn f() { } fn g() { }",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "g"]);
    assert(lint_function_messages(
        "fn f() { }.test({ g(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "__test$f"]);
    assert(lint_function_messages(
        "fn f() { }.benchmark({ g(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "__benchmark$f", "__test$__benchmark$f"]);
    assert(lint_function_messages(
        "fn f() { }.test({ fn h() { } h(); })",
        |function| { [hit(function.name.text, 0..1)] },
    )? == ["f", "__test$f", "__test$f$h"]);

    // A block has no parameters of its own.
    assert(lint_function_messages(
        "fn f(x: i64) { }.test({ g(); })",
        |function| { [hit(`{function.sig.params.len()}`, 0..1)] },
    )? == ["1", "0"]);
})

fn declared(self: LoweredFn(function)) -> Function { function }

# What the function lint `lint` reports for each of `self`.
pub fn hits(self: Function[], lint: (Function) -> LintHit[]) -> LintHit[] { self$lint().join() }

# [`hits`] for a lint that reports at most one hit for a function.
pub fn hits_once(self: Function[], lint: (Function) -> LintHit?) -> LintHit[] {
    self$lint().collect_ok()
}

# [`hits`] for a lint whose hits are [`UnfilledHit`]s, which [`filled`] fills in.
pub fn unfilled_hits(self: Function[], lint: (Function) -> UnfilledHit[]) -> UnfilledHit[] {
    self.map(|function| function.outside_its_definition(lint(function))).join()
}.test({
    // Advice to use `any` is not given inside the function that is `any`. Elsewhere in a file that
    // defines it, `any` is imported under another name.
    assert(lint_function_unfilled_messages(
        "fn any() { } fn f() { }",
        |function| { [unfilled(Any, `in {function.name.text}: use `, "", 0..1)] },
    )? == ["in f: use builtin_any, importing `any as builtin_any` from builtins"]);
})

# `hits` less those that advise the builtin `self` is itself: a function written to be `any` holds
# the longhand that `any` replaces, and advising it to call `any` would have it call itself.
fn outside_its_definition(self: Function, hits: UnfilledHit[]) -> UnfilledHit[] {
    if (hits.is_empty()) { return []; };
    let table = lint_table();
    hits.filter(|hit| !hit.named.any(|part| part.builtin.is_builtin_named(self.name.text, table)))
}

# What the function lint `lint` reports for the program `src` parses to, with every builtin
# counting as imported: a lint's own tests are about the shape it finds, not the file's imports.
pub fn lint_function_hits(src: str, lint: (Function) -> LintHit[]) -> LintHit[]!ParseFailure {
    ok(
        aipl_parse_surface_file(src)?.program
            .hoist_test_fns()
            .resolve_with_every_builtin()
            .functions()
            .hits(lint),
    )
}

# What the lint `lint`, which reports at most one hit for a function, reports for the program
# `src` parses to.
pub fn lint_function_once_hits(src: str, lint: (Function) -> LintHit?) -> LintHit[]!ParseFailure {
    ok(
        aipl_parse_surface_file(src)?.program
            .hoist_test_fns()
            .resolve_with_every_builtin()
            .functions()
            .hits_once(lint),
    )
}

# [`lint_function_hits`], keeping only the messages.
pub fn lint_function_messages(src: str, lint: (Function) -> LintHit[]) -> str[]!ParseFailure {
    ok(lint_function_hits(src, lint)?$message)
}

# What the function lint `lint` reports for the program `src` parses to, filled in
# for the imports `src` has.
pub fn lint_function_unfilled_hits(
    src: str,
    lint: (Function) -> UnfilledHit[],
) -> LintHit[]!ParseFailure {
    let program = aipl_parse_surface_file(src)?.program.hoist_test_fns().resolve_callees();
    ok(program.functions().unfilled_hits(lint).filled(program.items))
}

# [`lint_function_unfilled_hits`], keeping only the messages.
pub fn lint_function_unfilled_messages(
    src: str,
    lint: (Function) -> UnfilledHit[],
) -> str[]!ParseFailure { ok(lint_function_unfilled_hits(src, lint)?$message) }

# What the function lint `lint` says of the program `src` parses to, as it says it: the
# [`UnfilledHit`]s, before any file's imports decide how they are written. Every builtin counts as
# imported, so a lint's own tests are about the shape it finds and nothing about imports.
pub fn lint_function_unfilled(
    src: str,
    lint: (Function) -> UnfilledHit[],
) -> UnfilledHit[]!ParseFailure {
    ok(
        aipl_parse_surface_file(src)?.program
            .hoist_test_fns()
            .resolve_with_every_builtin()
            .functions()
            .unfilled_hits(lint),
    )
}

# `self` as messages: each stretch of text followed by the builtin it names as `to_str` shows it,
# then the closing stretch. Not what a file's author is shown, which is `filled`'s, but enough for a
# lint's tests to say what advice it gives.
pub fn shown(self: UnfilledHit[]) -> str[] {
    self.map(|hit| `{hit.named.map(|part| `{part.text}{part.builtin}`).join()}{hit.tail}`)
}.test({
    assert([unfilled(Len, "use ", "()", 1..2)].shown() == ["use Builtin(Len)()"]);
})

# What the function lint `lint`, which also reads the file's items, reports for the program
# `src` parses to.
pub fn lint_in_hits(src: str, lint: (Function, Item[]) -> LintHit[]) -> LintHit[]!ParseFailure {
    let program = aipl_parse_surface_file(src)?.program
        .hoist_test_fns()
        .resolve_with_every_builtin();
    ok(program.functions().hits(|function| lint(function, program.items)))
}

# [`lint_in_hits`], keeping only the messages.
pub fn lint_in_messages(src: str, lint: (Function, Item[]) -> LintHit[]) -> str[]!ParseFailure {
    ok(lint_in_hits(src, lint)?$message)
}

# What the lint `lint`, which also reads the file's items, says of the program `src` parses to: the
# [`UnfilledHit`]s as [`lint_function_unfilled`] gives them.
pub fn lint_in_unfilled(
    src: str,
    lint: (Function, Item[]) -> UnfilledHit[],
) -> UnfilledHit[]!ParseFailure {
    let program = aipl_parse_surface_file(src)?.program
        .hoist_test_fns()
        .resolve_with_every_builtin();
    ok(program.functions().unfilled_hits(|function| lint(function, program.items)))
}

# [`lint_in_hits`] for a lint whose hits are [`UnfilledHit`]s, filled in for the imports `src` has.
pub fn lint_in_unfilled_hits(
    src: str,
    lint: (Function, Item[]) -> UnfilledHit[],
) -> LintHit[]!ParseFailure {
    lint_hits(
        src,
        |program: ResolvedProgram| {
            program
                .functions()
                .unfilled_hits(|function| lint(function, program.items))
                .filled(program.items)
        },
    )
}

# [`lint_in_unfilled_hits`], keeping only the messages.
pub fn lint_in_unfilled_messages(
    src: str,
    lint: (Function, Item[]) -> UnfilledHit[],
) -> str[]!ParseFailure { ok(lint_in_unfilled_hits(src, lint)?$message) }

# `self` as backquoted names, read as a sentence: `a`, `a` and `b`, or `a`, `b` and `c`.
fn quoted_list(self: str[]) -> str {
    self.map(|builtin| `\`{builtin}\``).join(sep=", ", final_sep=" and ", only_sep=" and ")
}.test({
    assert(["a"].quoted_list() == "`a`");
    assert(["a", "b"].quoted_list() == "`a` and `b`");
    assert(["a", "b", "c"].quoted_list() == "`a`, `b` and `c`");
})
