# The `push_loop_collect_ok` lint:
#
#     mut out = [];
#     for (let x : xs) {
#         if (let some(v) = f(x)) {
#             set out.push(g(v));
#         };
#     }
#
# — an array seeded empty and filled by a loop that asks something of each element and
# pushes only the answers that exist. That is `xs.map(|x| f(x)).collect_ok()` (no `map`
# first when the loop variable is the optional itself), with a `.map(|v| g(v))` after it
# when what is pushed is more than the bound name: one expression that says the array
# *is* the answers, rather than a loop the reader has to run to find out that nothing
# else happens to `out`.
#
# It is the optional-guard sibling of `push_loop_pipeline`, which reads a boolean guard
# and so a `filter`; the two are disjoint by the kind of `if`. The shape is held to the
# same discipline: the loop body is the one `if let` around the one push, it has no
# `else`, the pattern is a plain `some(v)`, and neither the scrutinee nor the pushed
# element may mention `out` (see `is_liftable`). An indexed loop is left alone, since
# `map` has no index to pass, and a `str` or set receiver is the blind spot
# `push_loop_pipeline` documents: `#[allow]` is the answer there.
#
# The hit points at the seed, like `push_loop_pipeline`.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_nonempty,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
} from builtins;
import { ArrayLit, Ident, IfLet, Unit } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import { SeededLoop, is_liftable, pipeline_hit, pushed, seeded_loops } from "./accumulation.aipl";
import {
    LintHit,
    UnfilledHit,
    imported_as,
    lint_messages,
    on_functions_filled,
} from "./lint_hit.aipl";
import { lone_statement } from "./loop_shape.aipl";
import { names_case, payload_binders } from "./option_match.aipl";

# A hit for each array the program seeds empty and fills with a loop that pushes the
# answers that exist.
pub fn push_loop_collect_ok(program: Program) -> LintHit[] {
    let some(push) = program.items.imported_as("push") else { return []; };
    program.on_functions_filled(|Function { body }| {
        body.seeded_loops()$collected(push).collect_ok()
    })
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(xs: i64[]) -> i64[] \{ {body} }`,
            push_loop_collect_ok,
        )
    }
    let all = "push, map, collect_ok";

    // An answer asked of each element and mapped, asked only, and the optionals themselves.
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(g(v)); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.map(|x| ..).collect_ok().map(|v| ..);" and drop the loop`,
    ]);
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.map(|x| ..).collect_ok();" and drop the loop`,
    ]);
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (let some(v) = x) { set out.push(v); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.collect_ok();" and drop the loop`,
    ]);

    // Imports the file lacks are named once, and an alias is followed; a range is its own
    // placeholder.
    assert(messages(
        "push",
        "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(g(v)); }; } out",
    )? == [
        ```"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.map(|x| ..).collect_ok().map(|v| ..);" and drop the loop, importing `map` and `collect_ok` from builtins```,
    ]);
    assert(messages(
        "push, map, collect_ok as oks",
        "mut out = []; for (let x : 0..3) { if (let some(v) = f(x)) { set out.push(v); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = (<range>).map(|x| ..).oks();" and drop the loop`,
    ]);

    // Not the shape: an `else`, a pattern that is not a plain `some(v)`, an indexed loop, a
    // pushed element or scrutinee that reads the array, a second statement, a seed with
    // elements, and a `push` the file never imported.
    assert(
        messages(
            all,
            "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); } else { g(); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = []; for (let x : xs) { if (let some(..) = f(x)) { set out.push(x); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = []; for (let i, x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(out.len()); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = []; for (let x : xs) { if (let some(v) = f(out)) { set out.push(v); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = []; for (let x : xs) { g(x); if (let some(v) = f(x)) { set out.push(v); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = [1]; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out",
        )? == [],
    );
    assert(
        messages(
            "map, collect_ok",
            "mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out",
        )? == [],
    );
})

# `self` as the hit for an array filled with the answers that exist, when it is one.
fn collected(self: SeededLoop, push: str) -> UnfilledHit? {
    let ArrayLit(elements) = self.seed.kind.as_case(ArrayLit)?;
    if (elements.is_nonempty()) { return none; };
    let IfLet(arm, scrutinee, otherwise) = self.body.lone_statement()?.kind.as_case(IfLet)?;
    if (otherwise.kind != Unit || !arm.pattern.names_case("some")) { return none; };
    // `some` binds exactly its payload: `some(..)` binds nothing, and `_` is no name.
    let [bound] = arm.pattern.payload_binders()? else { return none; };
    if (bound == "_") { return none; };
    let element = arm.body.lone_statement()?.pushed(self.name, push)?.element;
    if (!scrutinee.is_liftable(self.name) || !element.is_liftable(self.name)) { return none; };

    // Asking nothing of the element — the iterable already holds the optionals — leaves no
    // first `map` to write, and pushing the bound name itself needs no second one.
    let asks: (str, str)? = if (scrutinee.kind != Ident(self.variable)) {
        some(("map", `(|{self.variable}| ..)`))
    } else {
        none
    };
    let maps: (str, str)? = if (element.kind != Ident(bound)) {
        some(("map", `(|{bound}| ..)`))
    } else {
        none
    };
    some(self.pipeline_hit(
        "filled by this loop with the answers that exist and nothing else",
        "",
        [asks, some(("collect_ok", "()")), maps].collect_ok(),
    ))
}
