# The `push_loop_collect_ok` lint:
#
#     mut out = [];
#     for (let x : xs) {
#         if (let some(v) = f(x)) {
#             set out.push(g(v));
#         };
#     }
#
# — an array seeded empty and filled by a loop that asks something of each element and
# pushes only the answers that exist. That is `xs.map(|x| f(x)).collect_ok()` (no `map`
# first when the loop variable is the optional itself), with a `.map(|v| g(v))` after it
# when what is pushed is more than the bound name: one expression that says the array
# *is* the answers, rather than a loop the reader has to run to find out that nothing
# else happens to `out`.
#
# It is the optional-guard sibling of `push_loop_pipeline`, which reads a boolean guard
# and so a `filter`; the two are disjoint by the kind of `if`. The shape is held to the
# same discipline: the loop body is the one `if let` around the one push, it has no
# `else`, the pattern is a plain `some(v)`, and neither the scrutinee nor the pushed
# element may mention `out` (see `is_liftable`). An indexed loop is left alone, since
# `map` has no index to pass, and a `str` or set receiver is the blind spot
# `push_loop_pipeline` documents: `#[allow]` is the answer there.
#
# The hit points at the seed, like `push_loop_pipeline`.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_empty,
    is_nonempty,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
} from builtins;
import { Callee, CollectOk, Map, Push } from "../builtin_table.aipl";
import { ArrayLit, IfLet, LetMut, Unit, is_ident } from "../expr.aipl";
import { is_liftable, pipeline_hit, plain_seeded_loop, pushed } from "./accumulation.aipl";
import { lint_with_unfilled } from "./lint.aipl";
import { LintHit, shown } from "./lint_hit.aipl";
import { lone_statement } from "./loop_shape.aipl";
import { names_case, payload_binders } from "./option_match.aipl";

# The hit for the array the binding `self` seeds, when it seeds it empty and a loop pushes the
# answers that exist onto it.
pub fn push_loop_collect_ok(self: LetMut) -> LintHit? {
    let looped = self.plain_seeded_loop()?;
    let ArrayLit(elements) = looped.seed.kind.as_case::<ArrayLit>()?;
    if (elements.is_nonempty()) { return none; };
    let IfLet(arm, scrutinee, otherwise) = looped.body.lone_statement()?.kind.as_case::<IfLet>()?;
    if (otherwise.kind != Unit || !arm.pattern.names_case("some")) { return none; };
    // `some` binds exactly its payload: `some(..)` binds nothing, and `_` is no name.
    let [bound] = arm.pattern.payload_binders()? else { return none; };
    if (bound == "_") { return none; };
    let element = arm.body.lone_statement()?.pushed(looped.name, Push)?.element;
    if (!scrutinee.is_liftable(looped.name) || !element.is_liftable(looped.name)) { return none; };

    // Asking nothing of the element — the iterable already holds the optionals — leaves no
    // first `map` to write, and pushing the bound name itself needs no second one.
    let asks: (Callee, str)? = if (!scrutinee.kind.is_ident(looped.variable)) {
        some((Map, `(|{looped.variable}| ..)`))
    } else {
        none
    };
    let maps: (Callee, str)? = if (!element.kind.is_ident(bound)) {
        some((Map, `(|{bound}| ..)`))
    } else {
        none
    };
    some(looped.pipeline_hit(
        "filled by this loop with the answers that exist and nothing else",
        "",
        [asks, some((CollectOk, "()")), maps].collect_ok(),
    ))
}.test({
    // An answer asked of each element and mapped, asked only, and the optionals themselves.
    assert(lint_with_unfilled(
        "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(g(v)); }; } out }",
        "push_loop_collect_ok",
    )?.shown() == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.Builtin(Map)(|x| ..).Builtin(CollectOk)().Builtin(Map)(|v| ..);" and drop the loop`,
    ]);
    assert(lint_with_unfilled(
        "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out }",
        "push_loop_collect_ok",
    )?.shown() == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.Builtin(Map)(|x| ..).Builtin(CollectOk)();" and drop the loop`,
    ]);
    assert(lint_with_unfilled(
        "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = x) { set out.push(v); }; } out }",
        "push_loop_collect_ok",
    )?.shown() == [
        `"out" is seeded empty and filled by this loop with the answers that exist and nothing else — write "mut out = xs.Builtin(CollectOk)();" and drop the loop`,
    ]);

    // Imports the file lacks are named once, and an alias is followed; a range is its own
    // placeholder.

    // Not the shape: an `else`, a pattern that is not a plain `some(v)`, an indexed loop, a
    // pushed element or scrutinee that reads the array, a second statement, a seed with
    // elements, and a `push` the file never imported.
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); } else { g(); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(..) = f(x)) { set out.push(x); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let i, x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = f(x)) { set out.push(out.len()); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { if (let some(v) = f(out)) { set out.push(v); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = []; for (let x : xs) { g(x); if (let some(v) = f(x)) { set out.push(v); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: i64[]) -> i64[] { mut out = [1]; for (let x : xs) { if (let some(v) = f(x)) { set out.push(v); }; } out }",
            "push_loop_collect_ok",
        )?.is_empty(),
    );

    // Shapes the lint must leave alone.
    assert(
        lint_with_unfilled(
            """fn show(xs: i64[]) -> str { xs$to_str().join(sep=",") }""",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            """fn show_u(xs: u64[]) -> str { xs$to_str().join(sep=",") }""",
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    // An `else` that does something: the pipeline has nowhere to put it.
    assert(
        lint_with_unfilled(
            """
                fn parsed_or_zero(words: str[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let word : words) {
                        if (let some(n) = word.int_parse()) {
                            set out.push(n);
                        } else {
                            set out.push(0);
                        };
                    }
                    out
                }
            """,
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    // The loop does something else as well.
    assert(
        lint_with_unfilled(
            """
                fn logged(words: str[]) !prints -> i64[] {
                    mut out: i64[] = [];
                    for (let word : words) {
                        print(word);
                        if (let some(n) = word.int_parse()) { set out.push(n); };
                    }
                    out
                }
            """,
            "push_loop_collect_ok",
        )?.is_empty(),
    );

    // The question reads the array being built, so it depends on how much the loop
    // has already done, which no `map` lambda can see.
    assert(
        lint_with_unfilled(
            """
                fn limited(words: str[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let word : words) {
                        if (let some(n) = word.int_parse()) { if (out.len() < 2) { set out.push(n); }; };
                    }
                    out
                }
            """,
            "push_loop_collect_ok",
        )?.is_empty(),
    );
    // An indexed loop: `map` has no index to pass.
    assert(
        lint_with_unfilled(
            """
                fn at_even(words: str[]) -> u64[] {
                    mut out: u64[] = [];
                    for (let i, word : words) {
                        if (let some(_) = word.int_parse()) { set out.push(word.len() + i); };
                    }
                    out
                }
            """,
            "push_loop_collect_ok",
        )?.is_empty(),
    );

    // Shapes the lint flags, and what it says of them.
    // The answers kept as they are: a `map` of the question, then `collect_ok`.

    // The answers changed on the way in.

    // The iterable already holds the optionals, so there is nothing to map first.
})
