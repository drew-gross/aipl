# The `map_find_if_some` lint:
#
#     xs.map(f).find_if(is_some)
#
# — the first element `f` has an answer for, written as a chain that hands back the
# answer wrapped twice. `xs.find_map(f)` says it in one word, and hands back the answer
# once: the chain's result is a `U??` whose outer layer every caller then peels
# (`.value_or(none)`), while `find_map` returns the `U?` that was wanted.
#
# The predicate has to *be* `is_some` — the name; a lambda forwarding to it is `identity_lambda`'s
# to turn into the name — since that is what makes the chain a `find_map` rather than a search over mapped values
# (`map_find_if`'s shape, which the fusion pass takes care of).
#
# The hit points at the whole chain.

import { collect_ok, equal as ==, is_empty, len, map, not_equal as != } from builtins;
import { FindIf, FindMap, IsSome, Map } from "../builtin_table.aipl";
import { Call, Expr, Ident, descendants_of_kind } from "../expr.aipl";
import { Function } from "../item.aipl";
import { Advice, Named, UnfilledHit, hit_at, lint_function_unfilled, shown } from "./lint_hit.aipl";
import { Builtin } from "./spelling.aipl";

# The advice for the call `self`, when it is a `map(..).find_if(is_some)` chain.
pub fn map_find_if_some(self: Call(_, arguments, _, callee)) -> Advice? {
    if (callee != FindIf) { return none; };
    let [mapped, predicate] = arguments else { return none; };
    let Call(_, inner_arguments, _, Map) = mapped.kind else { return none; };
    let Ident(_, IsSome) = predicate.kind else { return none; };
    if (inner_arguments.len() != 2) { return none; };
    some(Advice {
        named: [
            Named { text: `"`, builtin: Builtin(Map) },
            Named { text: `" then "`, builtin: Builtin(FindIf) },
            Named { text: `(`, builtin: Builtin(IsSome) },
            Named {
                text: `)" is the first element with an answer, wrapped twice — write "`,
                builtin: Builtin(FindMap),
            },
        ],
        tail: `(..)" over the mapping function, which hands the answer back once`,
    })
}.test({
    // The hits for each function's calls.
    fn flagged(Function { body }) -> UnfilledHit[] {
        body
            .descendants_of_kind::<Call>()
            .map(|call: Expr<Call>| { call.hit_at(call.kind.map_find_if_some()) })
            .collect_ok()
    }

    // The name itself; a lambda that forwards to it is `identity_lambda`'s to simplify first.
    assert(lint_function_unfilled(
        "fn f(xs: i64[]) -> i64?? { xs.map(g).find_if(is_some) }",
        flagged,
    )?.shown() == [
        `"Builtin(Map)" then "Builtin(FindIf)(Builtin(IsSome))" is the first element with an answer, wrapped twice — write "Builtin(FindMap)(..)" over the mapping function, which hands the answer back once`,
    ]);

    // Not the shape: another predicate, a lambda that does more, a different first step, and a
    // local that is called `is_some`.
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64?? { xs.map(g).find_if(|r| r.is_some() && c) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64?? { xs.map(g).find_if(other) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64?? { xs.filter(g).find_if(is_some) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[], is_some: (i64?) -> bool) -> i64?? { xs.map(g).find_if(is_some) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn first_big(xs: i64[]) -> i64? { xs.map(|x| x * 10).find_if(|y| y == 20) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn first_some(os: i64?[]) -> i64?? { os.find_if(is_some) }",
            flagged,
        )?.is_empty(),
    );
})
