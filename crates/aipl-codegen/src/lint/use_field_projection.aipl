# The `use_field_projection` lint: a lambda in a `map` that does nothing but take its parameter
# through member reads and method calls is the `$` projection.
#
# A lambda whose whole body is its parameter taken through a chain of member reads and method
# calls — `|x| x.name`, `|x| x.0`, `|x| x.f(args)`, `|x| x.a.f(b).c`, `|x| to_str(x)` — is
# `xs$name`, `xs$0`, `xs$f(args)`, `xs$a$f(b)$c` and `xs$to_str()`: each step written once, with
# no name for the element to introduce and then repeat. And a bare function name, `xs.map(f)`,
# is `xs$f()`.
#
# Only the shape `$` stands for qualifies. The parameter has to be the root of the chain and
# appear nowhere else (`|x| x.f(x)` needs the name), it has to be unannotated, since `$` has
# no place to write a type, and every call in the chain has to be one `$` can make — a
# function of this file whose first parameter is named `self`, which is what method-call
# syntax is defined by, a lowercase builtin the file imports, or a call already written as a
# method. A function from another file is not known here — its parameters are not in view
# when a file is linted — so it is never advised. An operator is never a step: `|x| x + 1`
# does something with `x`.
#
# The hit points at the lambda, or at the bare name — a short span that begins on the line
# the `#[allow]` would be written on. The lint runs before checking, so it cannot tell a
# sequence from an optional; `$` maps either, as `map` does.

import {
    Span,
    all,
    any,
    as_case,
    collect_arms,
    collect_ok,
    contains,
    drop_first,
    equal as ==,
    filter,
    first,
    greater_than as >,
    is_digit,
    is_empty,
    is_some,
    is_some_and,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    starts_with,
} from builtins;
import { Map } from "../builtin_table.aipl";
import {
    Call,
    Expr,
    Field,
    Ident,
    Lambda,
    descendants_of_kind,
    synthesized_name,
} from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { is_operator_name } from "../is_operator_name.aipl";
import { Function, Item, LoweredFn } from "../item.aipl";
import { mentions_any } from "./field_uses.aipl";
import { LintHit, hit, lint_in_messages, quote } from "./lint_hit.aipl";
import { imported_locals } from "./spelling.aipl";

# A hit for each `map` in the program whose function is a `$` projection.
pub fn use_field_projection(function: Function, items: Item[]) -> LintHit[] {
    function.projections(items)$hit
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_in_messages(
            `import \{ {imports} } from builtins; struct P \{ name: str } fn shout(self: str) -> str \{ self } fn f(xs: P[], ys: str[]) -> i64 \{ {body} }`,
            use_field_projection,
        )
    }

    // A member read, a method call with arguments, a chain, a builtin and a function name.
    assert(lint_in_messages(
        "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p| p.name) }",
        use_field_projection,
    )? == [`"map" with a lambda that only uses a member of its argument — write "xs$name"`]);
    assert(lint_in_messages(
        "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p| p.f(1, 2)) }",
        use_field_projection,
    )? == [`"map" with a lambda that only uses a member of its argument — write "xs$f(...)"`]);
    assert(lint_in_messages(
        "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p| p.a.f().c) }",
        use_field_projection,
    )? == [`"map" with a lambda that only uses a member of its argument — write "xs$a$f()$c"`]);
    assert(messages("map, to_str", "ys.map(|n| to_str(n))")? == [
        `"map" with a lambda that only uses a member of its argument — write "ys$to_str()"`,
    ]);
    assert(lint_in_messages(
        "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { ys.map(shout) }",
        use_field_projection,
    )? == [`"map" over the function "shout" — write "ys$shout()"`]);
    assert(lint_in_messages(
        "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { g().map(|p| p.name) }",
        use_field_projection,
    )? == [`"map" with a lambda that only uses a member of its argument — write "<items>$name"`]);

    // Not a step `$` can make: an annotated parameter, the parameter used twice, an operator,
    // a function from elsewhere, and a `map` the file never imported.
    assert(
        lint_in_messages(
            "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p: P| p.name) }",
            use_field_projection,
        )?.is_empty(),
    );
    assert(
        lint_in_messages(
            "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p| p.f(p)) }",
            use_field_projection,
        )?.is_empty(),
    );

    // A `$` inside the lambda maps its own receiver, so it is not a step of the outer chain.
    assert(
        lint_in_messages(
            "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|p| p.name$shout().len()) }",
            use_field_projection,
        )?.is_empty(),
    );

    // A name that is no method of this file (`g` is nothing declared here), and a lambda that is not
    // a `map`'s argument.
    assert(
        lint_in_messages(
            "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { ys.map(g) }",
            use_field_projection,
        )?.is_empty(),
    );
    assert(
        lint_in_messages(
            """struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.filter(|p| p.name == "a") }""",
            use_field_projection,
        )?.is_empty(),
    );
    assert(
        lint_in_messages(
            "struct P { name: str } fn shout(self: str) -> str { self } fn f(xs: P[], ys: str[]) -> i64 { xs.map(|n| n + 1) }",
            use_field_projection,
        )?.is_empty(),
    );
})

# What the rule says about a `map` call, and the span of the lambda it advised on (none for a
# function name), so that a lint about lambdas can leave that lambda alone.
struct Projection { hit: LintHit, lambda: Span? }

# The [`Projection`] of each `map` in `self`.
pub fn projections(self: Function, items: Item[]) -> Projection[] {
    let methods = items.methods_in_view();
    self.body
        .descendants_of_kind::<Call>()
        .map(|call: Expr<Call>| { call.projection(methods) })
        .collect_ok()
}

# The names a call can use as a `$` step: a function of this file whose first parameter is
# named `self`, which is what method-call syntax is defined by, and a lowercase builtin the
# file imports. A function from another file is not here — its parameters are not in view
# when a file is linted.
fn methods_in_view(self: Item[]) -> str[] {
    let own = self.collect_arms::<LoweredFn>()$method_name().collect_ok();
    let imported = self
        .imported_locals()
        .filter(|name| name[0].is_some_and(|c| "abcdefghijklmnopqrstuvwxyz_".contains(c)));
    [..own, ..imported]
}

# The name of the function `self`, when it takes a `self`.
fn method_name(self: LoweredFn(Function { sig, name })) -> str? {
    if (sig.is_method) { some(name.text) } else { none }
}

# `self` as the projection for `recv.map(arg)`, if `arg` is a function name or a lambda `$` can say.
fn projection(self: Expr<Call>, methods: str[]) -> Projection? {
    let Call(_, [receiver, argument], _, Map) = self.kind else { return none; };
    let items = receiver.quote("<items>");
    if (let Ident(function) = argument.kind) {
        if (!methods.contains(function)) { return none; };
        return some(Projection {
            hit: hit(
                `"map" over the function "{function}" — write "{items}${function}()"`,
                argument.span,
            ),
            lambda: none,
        });
    };
    let Lambda([parameter], body) = argument.kind else { return none; };
    if (parameter.ty.is_some() || parameter.synthesized_name().contains('$')) { return none; };
    let steps = body.chain(parameter.synthesized_name(), methods)?;
    if (steps.is_empty()) { return none; };
    some(Projection {
        hit: hit(
            `"map" with a lambda that only uses a member of its argument — write "{items}{steps.join()}"`,
            argument.span,
        ),
        lambda: some(argument.span),
    })
}

# The `$` steps `self` is made of, outermost last, when it is `parameter` taken through member
# reads and calls and nothing else; `none` otherwise. A call has to be one `$` can make — see
# `methods_in_view` — or already be written as a method call.
fn chain(self: Expr, parameter: str, methods: str[]) -> str[]? {
    if (let Ident(name) = self.kind) { return if (name == parameter) { some([]) } else { none }; };
    if (let Field(inner, name) = self.kind) {
        let steps = inner.chain(parameter, methods)?;
        return some([..steps, `${name.slot_shown()}`]);
    };
    let Call(name, arguments, method_style, _) = self.kind.as_case::<Call>()?;
    let target = arguments.first()?;
    let rest = arguments.drop_first();

    // An operator use is a call named for its spelling. A call named `__builtin_..` is
    // what the parser made of a `$` the author wrote inside the lambda (`p.a$f()` is a
    // `map` of its own, over the optional or sequence `p.a`); that is a level of mapping
    // of its own, not a step of this chain, and has no spelling here.
    if (name.starts_with(
        "__builtin_",
    ) || name.is_operator_name() || name == parameter || rest.any(|argument| argument.mentions_any(
        [parameter],
        none,
    )) || !(method_style || methods.contains(name))) {
        return none;
    };
    let steps = target.chain(parameter, methods)?;
    some([..steps, `${name}({if (rest.is_empty()) { "" } else { "..." }})`])
}

# A tuple slot is the field `_0`, written `0`; any other field is its own name.
fn slot_shown(self: str) -> str {
    if (self.starts_with("_") && self.len() > 1 && self.drop_first().all(is_digit)) {
        self.drop_first()
    } else {
        self
    }
}
