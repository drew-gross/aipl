# The `return_loop_any_all` lint:
#
#     for (let x : xs) {
#         if (matches(x)) {
#             return true;
#         };
#     }
#     false
#
# — a loop that reports whether *some* element passes a test. That is
# `xs.any(|x| matches(x))`. The mirror image, returning `false` from the loop and falling
# through to `true`, asks whether *every* element passes: with the condition negated
# (`if (!matches(x))`) it is `xs.all(|x| matches(x))`.
#
# Both spellings make the reader run the loop in their head to discover that the early
# return is the only way out and that the literal after the loop is the answer for "no
# element did" — which is the whole content of `any` and `all`, said in one word.
#
# The shape has to be exactly this, for the reasons `return_loop_find_if` spells out: the
# body is an else-less `if` around a lone `return` of a bool literal, the loop is
# immediately followed by the *opposite* literal, and a condition that propagates with
# `?` is left alone. A loop returning the same literal it falls through to is not a fold
# of anything and is left alone too.
#
# **The `all` direction fires only on a syntactically negated condition.**
# `if (x == 0) { return false; }` is `all(|x| x != 0)`, which needs the comparison
# inverted — and inverting an arbitrary condition correctly is not something to do in a
# diagnostic. Advising `!xs.any(..)` instead would be right but worse than what it
# replaces. So that shape is left alone; only the `!pred(x)` form, where the negation
# lifts off, is advised. A file may alias `!` to a function of its own, and then `!pred(x)`
# is an ordinary call whose meaning the rewrite must not assume, so the `all` direction
# also needs `!` to be `logical_not`.
#
# The hit points at the `return`, not the loop: `#[allow]` is line-scoped, so a hit
# spanning the loop could never be squelched. `return true;` is a short statement that
# always occupies one line, and it is the line that makes this a fold to a single answer.

import {
    all,
    any,
    collect_ok,
    equal as ==,
    greater_than as >,
    is_some,
    len,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    to_str,
} from builtins;
import { Bool, Call, Return, Seq } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import {
    LintHit,
    imported_as,
    lint_messages,
    on_functions_filled,
    unfilled,
} from "./lint_hit.aipl";
import { is_lambda_safe, iterable_text, search_loops } from "./loop_shape.aipl";

# A hit for each loop in the program that reports whether some or every element passes a
# test.
pub fn return_loop_any_all(program: Program) -> LintHit[] {
    let negation = program.items.imported_as("logical_not") == some("!");
    program.on_functions_filled(|Function { body }| {
        body
            .search_loops()
            .map(|found| {
                // An *indexed* loop is not this shape: `any`/`all` pass each element and have
                // no index to pass with it, so the rewrite would silently drop whatever the
                // body did with it.
                if (found.index.is_some() || !found.condition.is_lambda_safe()) { return none; };
                let Bool(returned) = found.returned.kind else { return none; };

                // What the loop falls through to: a bare `true`/`false` as the block's tail,
                // or an explicit `return true;`. Anything else, and the fall-through does
                // work neither builtin would do.
                let answer = match (found.rest.kind) {
                    Bool(literal) => some(literal),
                    Seq(statement, _) => if (let Return(value) = statement.kind) {
                        if (let Bool(literal) = value.kind) { some(literal) } else { none }
                    } else {
                        none
                    },
                    _ => none,
                };
                let some(fell_through) = answer else { return none; };

                // The two literals must disagree: `return true` above a `true` tail answers
                // the same thing either way and folds to a constant, not to `any`.
                if (returned == fell_through) { return none; };

                // `return true` / `false` is `any` of the condition as written; `return
                // false` / `true` is `all` of it with the negation lifted off.
                if (!returned) {
                    let Call("!", operands, _) = found.condition.kind else { return none; };
                    if (!negation || operands.len() != 1) { return none; };
                };
                let what = if (returned) {
                    "whether any element passes a test"
                } else {
                    "whether every element passes a test"
                };

                // The `all` rewrite takes the condition with its `!` removed, which is the one
                // part of the advice a reader could get backwards, so it is said.
                let note = if (returned) { "" } else { ` (the condition with its "!" removed)` };
                some(unfilled(
                    if (returned) { "any" } else { "all" },
                    `this loop reports {what} — write "return {found.iterable.iterable_text()}.`,
                    `(|{found.variable}| ..);"{note} and drop the loop`,
                    found.statement.span,
                ))
            })
            .collect_ok()
    })
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(xs: i64[]) -> bool \{ {body} }`,
            return_loop_any_all,
        )
    }
    let all = "any, all, logical_not as !";

    // Some element passing, and every element passing with the negation lifted off, with
    // the fall-through a tail or a `return`.
    assert(messages(all, "for (let x : xs) { if (x > 1) { return true; }; } false")? == [
        `this loop reports whether any element passes a test — write "return xs.any(|x| ..);" and drop the loop`,
    ]);
    assert(messages(all, "for (let x : xs) { if (x > 1) { return true; }; } return false;")? == [
        `this loop reports whether any element passes a test — write "return xs.any(|x| ..);" and drop the loop`,
    ]);
    assert(messages(all, "for (let x : xs) { if (!big(x)) { return false; }; } true")? == [
        `this loop reports whether every element passes a test — write "return xs.all(|x| ..);" (the condition with its "!" removed) and drop the loop`,
    ]);

    // An import the file lacks is named, and an alias is followed.
    assert(messages(
        "logical_not as !",
        "for (let x : xs) { if (x > 1) { return true; }; } false",
    )? == [
        """this loop reports whether any element passes a test — write "return xs.any(|x| ..);" and drop the loop, importing `any` from builtins""",
    ]);
    assert(messages(
        "any as some_of",
        "for (let x : xs) { if (x > 1) { return true; }; } false",
    )? == [
        `this loop reports whether any element passes a test — write "return xs.some_of(|x| ..);" and drop the loop`,
    ]);

    // Not the shape: the same literal either side, a `false` loop whose condition is not a
    // negation (inverting it is not a diagnostic's job), a `!` that is not `logical_not`, an
    // indexed loop, and a test that propagates with `?`.
    assert(messages(all, "for (let x : xs) { if (x > 1) { return true; }; } true")? == []);
    assert(messages(all, "for (let x : xs) { if (x == 0) { return false; }; } true")? == []);
    assert(
        messages(
            "any, all, not_equal as !",
            "for (let x : xs) { if (!big(x)) { return false; }; } true",
        )? == [],
    );
    assert(messages(all, "for (let i, x : xs) { if (x > 1) { return true; }; } false")? == []);
    assert(messages(all, "for (let x : xs) { if (g(x)?) { return true; }; } false")? == []);

    // Shapes the lint must leave alone.
    // A second statement in the loop: work neither builtin has anywhere to put.
    assert(
        lint_messages(
            """
                fn counted(xs: i64[], lo: i64) -> bool {
                    mut seen = 0;
                    for (let x : xs) {
                        set seen++;
                        if (x > lo) { return true; };
                    }
                    seen > 99
                }
            """,
            return_loop_any_all,
        )? == [],
    );
    // An `else` branch — same reason.
    assert(
        lint_messages(
            """
                fn with_else(xs: i64[], lo: i64) !prints -> bool {
                    for (let x : xs) {
                        if (x > lo) {
                            return true;
                        } else {
                            print("looked");
                        };
                    }
                    false
                }
            """,
            return_loop_any_all,
        )? == [],
    );

    // The fall-through is not the opposite literal, so this is not a fold: both
    // exits answer the same thing and the loop is a constant, not an `any`.
    assert(
        lint_messages(
            """
                fn always_true(xs: i64[], lo: i64) -> bool {
                    for (let x : xs) {
                        if (x > lo) { return true; };
                    }
                    true
                }
            """,
            return_loop_any_all,
        )? == [],
    );
    // The fall-through does work, so it is not an answer at all.
    assert(
        lint_messages(
            """
                fn falls_through_to_work(xs: i64[], lo: i64) !prints -> bool {
                    for (let x : xs) {
                        if (x > lo) { return true; };
                    }
                    print("none matched");
                    false
                }
            """,
            return_loop_any_all,
        )? == [],
    );

    // Returns an element rather than a verdict: that is `find_if`, and
    // `return_loop_find_if` is the lint that says so — squelched here so this file
    // stays about the one lint it is a fixture for, and kept because the two lints
    // matching disjoint shapes is the thing being shown.
    assert(
        lint_messages(
            """
                fn first_big(xs: i64[], lo: i64) -> i64? {
                    for (let x : xs) {
                        if (x > lo) {
                            return some(x); #[allow]
                        };
                    }
                    none
                }
            """,
            return_loop_any_all,
        )? == [],
    );

    // The `all` direction with a condition that is not syntactically negated.
    // `xs.all(|x| x != 0)` is the rewrite, and it needs the comparison inverted —
    // which is not something a diagnostic should attempt, so this is left alone.
    assert(
        lint_messages(
            """
                fn none_zero(xs: i64[]) -> bool {
                    for (let x : xs) {
                        if (x == 0) { return false; };
                    }
                    true
                }
            """,
            return_loop_any_all,
        )? == [],
    );
    // A condition that propagates with `?` cannot move into a lambda unchanged.
    assert(
        lint_messages(
            """
                fn any_big_checked(xs: i64[], lo: i64) -> bool!Error {
                    for (let x : xs) {
                        if (checked(x)? > lo) { return ok(true); };
                    }
                    ok(false)
                }
            """,
            return_loop_any_all,
        )? == [],
    );
    assert(lint_messages("fn checked(x: i64) -> i64!Error { ok(x) }", return_loop_any_all)? == []);

    // Shapes the lint flags, and what it says of them.
    // The `any` direction: an early `return true`, falling through to `false`.
    assert(lint_messages(
        """
            fn has_big(xs: i64[], lo: i64) -> bool {
                for (let x : xs) {
                    if (x > lo) { return true; };
                }
                false
            }
        """,
        return_loop_any_all,
    )? == [
        """this loop reports whether any element passes a test — write "return xs.any(|x| ..);" and drop the loop, importing `any` from builtins""",
    ]);

    // The `all` direction: an early `return false` under a negated condition,
    // falling through to `true`. The negation lifts off, so the advice names the
    // predicate rather than asking the reader to invert anything.
    assert(
        lint_messages(
            """
                fn all_big(xs: i64[], lo: i64) -> bool {
                    for (let x : xs) {
                        if (!(x > lo)) { return false; };
                    }
                    true
                }
            """,
            return_loop_any_all,
        )? == [],
    );

    // The fall-through may be an explicit `return`, since a reader cannot tell that
    // apart from the block's tail either.
    assert(lint_messages(
        """
            fn has_big_explicit(xs: i64[], lo: i64) -> bool {
                for (let x : xs) {
                    if (x > lo) { return true; };
                }
                return false;
            }
        """,
        return_loop_any_all,
    )? == [
        """this loop reports whether any element passes a test — write "return xs.any(|x| ..);" and drop the loop, importing `any` from builtins""",
    ]);

    // A receiver whose span does not cover its text gets the `<iterable>`
    // placeholder rather than a misquoted rewrite.
    assert(lint_messages(
        """
            fn any_doubled(xs: i64[], lo: i64) -> bool {
                for (let x : xs.map(|v| v)) {
                    if (x > lo) { return true; };
                }
                false
            }
        """,
        return_loop_any_all,
    )? == [
        """this loop reports whether any element passes a test — write "return <iterable>.any(|x| ..);" and drop the loop, importing `any` from builtins""",
    ]);

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn has_big(xs: i64[], lo: i64) -> bool {
        for (let x : xs) {
            if (x > lo) {
                return true; #[allow]
            };
        }
        false
    }
    fn all_big(xs: i64[], lo: i64) -> bool {
        for (let x : xs) {
            if (!(x > lo)) {
                return false; #[allow]
            };
        }
        true
    }

    // The rewrites the lint asks for, so both spellings are checked side by side and
    // proven to agree — including on the empty receiver, where the two builtins
    // disagree with each other (`any` is false, `all` is true) and a reader most
    // wants the short form to be the one they can trust.
    fn has_big_short(xs: i64[], lo: i64) -> bool { xs.any(|x| x > lo) }
    fn all_big_short(xs: i64[], lo: i64) -> bool { xs.all(|x| x > lo) }
    let empty: i64[] = [];
    assert(has_big([1, 5, 9], 4).to_str() == "true");
    assert(has_big_short([1, 5, 9], 4).to_str() == "true");
    assert(has_big([1, 2], 5).to_str() == "false");
    assert(has_big_short([1, 2], 5).to_str() == "false");
    assert(all_big([6, 7], 5).to_str() == "true");
    assert(all_big_short([6, 7], 5).to_str() == "true");
    assert(all_big([6, 1], 5).to_str() == "false");
    assert(all_big_short([6, 1], 5).to_str() == "false");
    assert(has_big(empty, 5).to_str() == "false");
    assert(has_big_short(empty, 5).to_str() == "false");
    assert(all_big(empty, 5).to_str() == "true");
    assert(all_big_short(empty, 5).to_str() == "true");
})
