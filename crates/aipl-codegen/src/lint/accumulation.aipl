# What the lints on a binding seeded and then filled by the loop that follows it
# (`push_loop_pipeline`, `extend_loop_map_join`, `push_loop_collect_ok`,
# `union_loop_union_all`) share: recognising the seed and the loop, and phrasing the
# pipeline that loop is. For an array filled with one expression per element:
#
#     mut out = [];
#     for (let x : xs) {
#         if (keep(x)) {
#             set out.push(f(x));
#         };
#     }
#
# The shape has to be *exactly* this, because anything else in the loop is something
# the pipeline would drop: the loop body is one statement (the add, or an else-less
# `if` around one add), the guard and the added value may not mention `out`, and may
# not use `?`, which would return from the lambda they move into instead of the
# function. What comes *after* the loop is unconstrained — a later `set out.push(..)`
# is fine, since the rewrite leaves `out` a `mut` binding that simply starts out filled.

import {
    as_case,
    collect_ok,
    drop_last,
    equal as ==,
    filter,
    is_empty,
    is_nonempty,
    is_some,
    last,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    value_or,
    zip_with,
} from builtins;
import {
    ArrayLit,
    Assign,
    Call,
    Construct,
    Expr,
    For,
    Ident,
    If,
    LetMut,
    Seq,
    Unit,
    collect_expr_cases,
    show_expr,
} from "../expr.aipl";
import { ParseError } from "../grammar.aipl";
import { lower_aipl_block_surface } from "../grammar_aipl.aipl";
import { Ty } from "../ty.aipl";
import { mentions_any } from "./field_uses.aipl";
import { Named, UnfilledHit } from "./lint_hit.aipl";
import { is_lambda_safe, iterable_text, lone_statement } from "./loop_shape.aipl";

# A binding `name` seeded at `seed` (annotated as `annotation`, when it is) and filled
# by the loop right after it, which binds each element as `variable` (and its position
# as `index`, for the two-binder form) and runs `body` for it.
struct SeededLoop {
    name: str,
    annotation: Ty?,
    seed: Expr,
    variable: str,
    index: str?,
    iterable: Expr,
    body: Expr,
}

# Every [`SeededLoop`] in `self` and under it whose loop is not indexed. The loop has to
# be the very next statement: one between the two could read the binding while it is
# still empty, which the rewrite would reorder. An *indexed* loop is not this shape:
# `map` and `filter` pass each element and have no index to pass with it, so the rewrite
# would silently drop whatever the body did with it. [`indexed_seeded_loops`] has those.
pub fn seeded_loops(self: Expr) -> SeededLoop[] {
    self.collect_expr_cases(LetMut)$seeded_loop().collect_ok().filter(|l| !l.index.is_some())
}.test({
    assert(seeded_names("{ mut a = []; for (let x : xs) { g(x); } a }")? == ["a"]);

    // Later ones are found too, in order; a statement between the seed and the loop, an
    // indexed loop and a binding no loop follows are not the shape.
    assert(seeded_names(
        "{ mut a = []; for (let x : xs) { g(x); } mut b = []; for (let y : a) { g(y); } b }",
    )? == ["a", "b"]);
    assert(seeded_names("{ mut a = []; g(); for (let x : xs) { g(x); } a }")? == []);
    assert(seeded_names("{ mut a = []; for (let i, x : xs) { g(x); } a }")? == []);
    assert(seeded_names("{ mut a = []; a }")? == []);
})

# Every [`SeededLoop`] in `self` and under it whose loop is indexed: the same shape as
# [`seeded_loops`], for the lints whose rewrite takes a position from somewhere other
# than the loop.
pub fn indexed_seeded_loops(self: Expr) -> SeededLoop[] {
    self.collect_expr_cases(LetMut)$seeded_loop().collect_ok().filter(|l| l.index.is_some())
}.test({
    assert(indexed_names("{ mut a = []; for (let i, x : xs) { g(x); } a }")? == ["a"]);
    // A plain loop, a statement between the seed and the loop, and no loop at all.
    assert(indexed_names("{ mut a = []; for (let x : xs) { g(x); } a }")? == []);
    assert(indexed_names("{ mut a = []; g(); for (let i, x : xs) { g(x); } a }")? == []);
    assert(indexed_names("{ mut a = []; a }")? == []);
})

# The name of each [`indexed_seeded_loops`] the block `src` holds.
fn indexed_names(src: str) -> str[]!ParseError {
    ok(lower_aipl_block_surface(src)?.indexed_seeded_loops()$name)
}

# The name of each [`seeded_loops`] the block `src` holds.
fn seeded_names(src: str) -> str[]!ParseError {
    ok(lower_aipl_block_surface(src)?.seeded_loops()$name)
}

# `self` as a [`SeededLoop`], when it is one.
fn seeded_loop(self: LetMut(name, annotation, seed, rest)) -> SeededLoop? {
    let Seq(first, _) = rest.kind.as_case(Seq)?;

    // `as_case(For)` would say this, but `For` has a keyword parameter, which keeps it
    // from being passed as a function value.
    let For(variable, iterable, body, index) = first.kind else { return none; }; #[allow]
    some(SeededLoop { name, annotation, seed, variable, index, iterable, body })
}

# An array `name` seeded empty and filled by a loop over `iterable`, which binds each
# element as `variable`, and for each one (that passes `guard`, if there is one) adds
# `added` to it.
struct Accumulation { seeded: SeededLoop, guard: Expr?, added: Expr }

# Every [`Accumulation`] in `self` and under it whose loop fills the array with
# `adder` — the local name of the builtin that adds to it (`push`, `extend`), so an
# aliased import is followed and a *user* function that happens to share the name
# is not.
pub fn accumulations(self: Expr, adder: str) -> Accumulation[] {
    self.seeded_loops()$accumulation(adder).collect_ok()
}.test({
    assert(block_accumulations(
        "{ mut out = []; for (let x : xs) { set out.push(f(x)); } out }",
        "push",
    )? == ["out"]);
    // Later ones are found too, in order.
    assert(block_accumulations(
        "{ mut a = []; for (let x : xs) { set a.push(x); } mut b = []; for (let y : a) { set b.push(y); } b }",
        "push",
    )? == ["a", "b"]);
    // The adder is the file's: a different name is another function.
    assert(
        block_accumulations(
            "{ mut out = []; for (let x : xs) { set out.push(x); } out }",
            "add",
        )? == [],
    );
})

# The name of each [`accumulations`] the block `src` holds.
fn block_accumulations(src: str, adder: str) -> str[]!ParseError {
    ok(lower_aipl_block_surface(src)?.accumulations(adder)$seeded$name)
}

# `self` as an [`Accumulation`], when it is one.
fn accumulation(self: SeededLoop, adder: str) -> Accumulation? {
    // `mut acc = [];` — the seed. An annotation is allowed (and usual: it is often
    // what gives the empty literal its element type) but says nothing about the
    // iterable, so it is not inspected.
    let ArrayLit(elements) = self.seed.kind.as_case(ArrayLit)?;
    if (elements.is_nonempty()) { return none; };

    // An else-less `if` around the add is the filter; anything else in the body (an
    // `else`, a second statement) is work the pipeline has nowhere to put.
    mut statement = self.body.lone_statement()?;
    mut guard: Expr? = none;
    if (let If(condition, then, otherwise) = statement.kind) {
        if (otherwise.kind != Unit) { return none; };
        set guard = some(condition);
        set statement = then.lone_statement()?;
    };
    let added = statement.pushed(self.name, adder)?.element;
    if (!added.is_liftable(self.name) || !guard$is_liftable(self.name).value_or(true)) {
        return none;
    };
    some(Accumulation { seeded: self, guard, added })
}.test({
    assert(block_accumulations(
        "{ mut out: i64[] = []; for (let x : xs) { if (x > 0) { set out.push(x); }; } out }",
        "push",
    )? == ["out"]);

    // Not the shape: a seed with elements, a statement between seed and loop, an
    // indexed loop, a second statement or an `else` in the body, and an added value
    // that reads the array or propagates with `?`.
    assert(
        block_accumulations(
            "{ mut out = [1]; for (let x : xs) { set out.push(x); } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; g(); for (let x : xs) { set out.push(x); } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; for (let i, x : xs) { set out.push(x); } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; for (let x : xs) { g(x); set out.push(x); } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; for (let x : xs) { if (c) { set out.push(x); } else { g(x); }; } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; for (let x : xs) { set out.push(out.len()); } out }",
            "push",
        )? == [],
    );
    assert(
        block_accumulations(
            "{ mut out = []; for (let x : xs) { set out.push(g(x)?); } out }",
            "push",
        )? == [],
    );
})

# What `adder` adds to `acc`, and what follows, when `self` is `set acc.adder(element);
# rest` — `acc = adder(acc, element)` — and nothing else.
struct Pushed { element: Expr, rest: Expr }

pub fn pushed(self: Expr, acc: str, adder: str) -> Pushed? {
    let Assign(target, value, rest) = self.kind.as_case(Assign)?;
    let Call(callee, arguments, _) = value.kind.as_case(Call)?;
    let [receiver, element] = arguments else { return none; };
    if (target.kind != Ident(acc) || callee != adder || receiver.kind != Ident(acc)) {
        return none;
    };
    some(Pushed { element, rest })
}.test({
    assert(block_pushes("{ set out.push(x); out }", "out", "push")? == ["x"]);

    // Another binding, another adder, another arity and another statement are not it.
    assert(block_pushes("{ set other.push(x); out }", "out", "push")? == []);
    assert(block_pushes("{ set out.push(x); out }", "out", "add")? == []);
    assert(block_pushes("{ set out.push(x, y); out }", "out", "push")? == []);
    assert(block_pushes("{ set out = g(x); out }", "out", "push")? == []);
    assert(block_pushes("{ g(x); out }", "out", "push")? == []);
})

# The element of the push `src`, a block, starts with, as the dump of its expression.
fn block_pushes(src: str, acc: str, adder: str) -> str[]!ParseError {
    ok(
        lower_aipl_block_surface(src)?
            .pushed(acc, adder)
            .map(|found| [found.element.show_expr()])
            .value_or([]),
    )
}

# Whether `self` can move into a lambda in a rewritten pipeline: it may not propagate
# with `?`, which would return from the lambda instead of the function, and it may not
# mention `acc`, the array being filled, which the rewrite no longer has.
pub fn is_liftable(self: Expr, acc: str) -> bool {
    self.is_lambda_safe() && !self.mentions_any([acc], none)
}.test({
    assert(lower_aipl_block_surface("{ f(a) }")?.is_liftable("out"));
    assert(!lower_aipl_block_surface("{ f(out) }")?.is_liftable("out"));
    assert(!lower_aipl_block_surface("{ f(a?) }")?.is_liftable("out"));
})

# Whether the loop walks a range (`a..b`, a `Span` construction), which is not an
# array: only `map` takes one, so a guard has no `filter` to become and an element
# added unchanged is the range as an array, which has no spelling to advise.
pub fn is_range(self: Accumulation) -> bool {
    match (self.seeded.iterable.kind) {
        Construct("__builtin_Span", _) => true,
        _ => false,
    }
}

# Whether the loop adds something derived from its element, rather than the element
# itself, which a pipeline just leaves out.
pub fn maps(self: Accumulation) -> bool { self.added.kind != Ident(self.seeded.variable) }

# Whether a pipeline over the loop's iterable can be advised. A range is not an
# array and only `map` takes one, so a guard has no `filter` to become, and an element
# added unchanged is the range as an array, which has no spelling.
pub fn is_advisable(self: Accumulation) -> bool {
    !self.is_range() || (!self.guard.is_some() && self.maps())
}

# The stages of the pipeline that select and derive the loop's elements: a `filter`
# for the guard, if there is one, then a `map` for what is added, if that is not the
# element itself. Each is a builtin and the arguments it is written with.
pub fn element_stages(self: Accumulation) -> (str, str)[] {
    let lambda = `(|{self.seeded.variable}| ..)`;
    let filter: (str, str)? = if (self.guard.is_some()) { some(("filter", lambda)) } else { none };
    let map: (str, str)? = if (self.maps()) { some(("map", lambda)) } else { none };
    [filter, map].collect_ok()
}

# The hit for an array filled by one loop that is the pipeline of `stages` over its
# iterable: each stage a builtin and the arguments it is written with.
pub fn filled_hit(self: Accumulation, stages: (str, str)[]) -> UnfilledHit {
    self.seeded.pipeline_hit("filled by this loop and nothing else", "", stages)
}

# The hit for a loop that is the pipeline of `stages` over its iterable, assigned to
# the binding: `what` is how the loop fills it, as the message says, and `annotation`
# what follows the binding's name in the advice. Each stage is a builtin and the
# arguments it is written with. It points at the seed, not the loop: `#[allow]` is
# line-scoped, so a hit spanning the loop could never be squelched (the marker would
# have to go on the `for (..) {` header, and the formatter relocates one written
# there onto a line of its own, where it squelches nothing). `mut out = [];` always
# occupies one line, and is where the shape starts.
pub fn pipeline_hit(
    self: SeededLoop,
    what: str,
    annotation: str,
    stages: (str, str)[],
) -> UnfilledHit {
    let lead = `"{self.name}" is seeded empty and {what} — `;
    let receiver = self.iterable.iterable_text();

    // No stage at all: the loop copies the iterable one element at a time.
    if (stages.is_empty()) {
        return UnfilledHit {
            named: [],
            tail: `{lead}it is "{receiver}" already — assign that and drop the loop`,
            span: self.seed.span,
        };
    };
    let opening = `{lead}write "mut {self.name}{annotation} = {receiver}.`;
    let separators = stages.drop_last()$1.map(|arguments| `{arguments}.`);
    UnfilledHit {
        named: zip_with(
            [opening, ..separators],
            stages,
            |text: str, stage: (str, str)| Named { text, builtin: stage.0 },
        ),
        tail: `{stages.last()$1.value_or("")};" and drop the loop`,
        span: self.seed.span,
    }
}
