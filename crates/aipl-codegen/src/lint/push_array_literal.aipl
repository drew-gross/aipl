# The `push_array_literal` lint:
#
#     mut out = xs;
#     set out.push(x);
#     out
#
# — an array bound `mut` only to append to it and hand it straight back. That is the
# literal `[..xs, x]`: one expression that says what the array *is*, rather than a
# binding the reader has to follow through two more statements to find out that
# appending is all that ever happens to it.
#
# A run of pushes collapses the same way (`[..xs, a, b]`), and a seed that is itself a
# literal is spliced open rather than spread into itself — `mut out: i64[] = []; set
# out.push(x); out` is `[x]`, and `mut out = [5]; ...` is `[5, x]`. A spread in that
# literal stays a spread, its elements coming across unchanged.
#
# The shape has to be *exactly* this: the pushes immediately follow the `mut`, and the
# binding itself is the very next thing, so nothing can read `out` half-built or touch it
# afterwards. A pushed element may not mention `out` either (`set out.push(out.len());`
# is a running index) — the literal has no binding for it to refer to. And this file's
# `push` must be the builtin, so a *user* function of that name is not mistaken for it.
#
# Unlike `push_loop_pipeline` there is no blind spot about the receiver's type: `push` is
# declared `fn __builtin_push<T: any>(mut self: T[], x: T)`, so an `out` that is pushed
# to is an array, and `[..out]` always type-checks.
#
# The hit points at the seed, where the shape starts: `#[allow]` is line-scoped, and the
# seed is the same anchor, for the same reason, as `push_loop_pipeline`'s.

import {
    any,
    collect_ok,
    equal as ==,
    is_empty,
    join,
    logical_not as !,
    logical_or as ||,
    push,
    to_str,
    value_or,
} from builtins;
import { Callee, Push } from "../builtin_table.aipl";
import { ArrayLit, Expr, LetMut, Spread, descendants_of_kind, is_ident } from "../expr.aipl";
import { Function } from "../item.aipl";
import { Pushed, pushed } from "./accumulation.aipl";
import { expr_text } from "./expr_text.aipl";
import { mentions_any } from "./field_uses.aipl";
import { LintHit, lint_function_messages, lint_message } from "./lint_hit.aipl";

# A hit for each array the program binds `mut`, pushes onto and returns.
pub fn push_array_literal(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<LetMut>()$kind$literal().collect_ok()
}.test({
    // A seed spread into the literal, a run of pushes, and a literal seed spliced open.
    assert(lint_function_messages(
        "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; set out.push(x); out }",
        push_array_literal,
    )? == [
        `"out" is seeded and then only appended to before being returned — write "[..xs, x]" and drop the mut`,
    ]);
    assert(lint_function_messages(
        "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; set out.push(1); set out.push(2); out }",
        push_array_literal,
    )? == [
        `"out" is seeded and then only appended to before being returned — write "[..xs, 1, 2]" and drop the mut`,
    ]);
    assert(lint_function_messages(
        "fn f(xs: i64[], x: i64) -> i64[] { mut out: i64[] = []; set out.push(x); out }",
        push_array_literal,
    )? == [
        `"out" is seeded and then only appended to before being returned — write "[x]" and drop the mut`,
    ]);
    assert(lint_function_messages(
        "fn f(xs: i64[], x: i64) -> i64[] { mut out = [5, ..xs]; set out.push(x); out }",
        push_array_literal,
    )? == [
        `"out" is seeded and then only appended to before being returned — write "[5, ..xs, x]" and drop the mut`,
    ]);

    // A call is written out.
    assert(lint_function_messages(
        "fn f(xs: i64[], x: i64) -> i64[] { mut out = g(); set out.push(h(x)); out }",
        push_array_literal,
    )? == [
        `"out" is seeded and then only appended to before being returned — write "[..g(), h(x)]" and drop the mut`,
    ]);

    // Not the shape: no push, a statement after the pushes, a push that reads the array, and
    // a `push` the file never imported or one that is another function's.
    assert(
        lint_function_messages(
            "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; out }",
            push_array_literal,
        )?.is_empty(),
    );
    assert(
        lint_function_messages(
            "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; set out.push(x); g(); out }",
            push_array_literal,
        )?.is_empty(),
    );
    assert(
        lint_function_messages(
            "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; set out.push(x); set out.push(1); xs }",
            push_array_literal,
        )?.is_empty(),
    );
    assert(
        lint_function_messages(
            "fn f(xs: i64[], x: i64) -> i64[] { mut out = xs; set out.push(out.len()); out }",
            push_array_literal,
        )?.is_empty(),
    );

    // Shapes the lint must leave alone.
    // A pushed element that mentions the binding: `out.len()` is a running index,
    // and the literal has no `out` for it to refer to.
    assert(
        lint_function_messages(
            """
                fn indexed(xs: u64[]) -> u64[] {
                    mut out = xs;
                    set out.push(out.len());
                    out
                }
            """,
            push_array_literal,
        )?.is_empty(),
    );

    // A statement between the pushes and the result reads `out` half-built, so the
    // pushes are not the last thing that happens to it.
    assert(
        lint_function_messages(
            """
                fn logged(xs: i64[], x: i64) !prints -> i64[] {
                    mut out = xs;
                    set out.push(x);
                    print(out.len().to_str());
                    out
                }
            """,
            push_array_literal,
        )?.is_empty(),
    );

    // The binding outlives the pushes — something else appends to it later, so
    // there is no single literal that spells it.
    assert(
        lint_function_messages(
            """
                fn twice(xs: u64[], x: u64) -> u64[] {
                    mut out = xs;
                    set out.push(x);
                    let n = out.len();
                    set out.push(n);
                    out
                }
            """,
            push_array_literal,
        )?.is_empty(),
    );
    // A push is not the last statement: the block returns something else.
    assert(
        lint_function_messages(
            """
                fn counted(xs: i64[], x: i64) -> u64 {
                    mut out = xs;
                    set out.push(x);
                    out.len()
                }
            """,
            push_array_literal,
        )?.is_empty(),
    );
    assert(
        lint_function_messages(
            """fn show(xs: i64[]) -> str { xs$to_str().join(sep=",") }""",
            push_array_literal,
        )?.is_empty(),
    );

    // Shapes the lint flags, and what it says of them.
    // One push onto a named seed — the plain case.

    // A run of pushes collapses the same way, and an empty seed needs no spread
    // at all. The annotation goes away with the binding.

    assert(
        lint_function_messages(
            "fn evens(n: i64) -> i64[] { [n, n * 2] }",
            push_array_literal,
        )?.is_empty(),
    );

    // A call-shaped seed can't be quoted back into the advice — its span stops
    // before its parens — so the literal is shown with a placeholder in its place.

    // The same goes for a computed element. The longhand `set out = out.push(..)`
    // is the same statement written out, so it is flagged the same way.

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn appended(xs: i64[], x: i64) -> i64[] {
        mut out = xs; #[allow]
        set out.push(x);
        out
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side
    // and proven to agree.
    fn appended_short(xs: i64[], x: i64) -> i64[] { [..xs, x] }
    fn show(xs: i64[]) -> str { xs$to_str().join(sep=",") }
    assert(show(appended([1, 2], 3)) == "1,2,3");
    assert(show(appended_short([1, 2], 3)) == "1,2,3");
    assert(show(appended([], 3)) == "3");
    assert(show(appended_short([], 3)) == "3");
})

# `self` as the hit for an array that is only pushed onto before it is returned, when it
# is one.
fn literal(self: LetMut(name, annotation, seed, body)) -> LintHit? {
    // Every push, in order, for as long as they run consecutively. An annotation on the
    // `mut` is allowed (it is often what gives an empty seed its element type) and simply
    // goes away with the binding.
    let Pushes { elements, rest } = body.pushes(name, Push);

    // What follows the pushes must be the binding and nothing else: any other statement
    // could read or rebind `out`, and the literal would have nowhere to put it.
    if (elements.is_empty() || !rest.kind.is_ident(name)) { return none; };
    if (elements.any(|element| element.mentions_any([name], none))) { return none; };

    // What the seed contributes to the front of the literal. A seed that is *already* a
    // literal is spliced open rather than spread into itself — `mut xs = [5]; set
    // xs.push(6); xs` is `[5, 6]`, not `[..[5], 6]` — which also covers the empty seed,
    // whose contribution is nothing at all.
    let opening = if (let ArrayLit(members) = seed.kind) {
        members$element_text()
    } else {
        [`..{seed.expr_text().value_or("<array>")}`]
    };
    some(lint_message(
        `"{name}" is seeded and then only appended to before being returned — write "[{[..opening, ..elements$element_text()].join(sep=", ")}]" and drop the mut`,
        span=seed.span,
    ))
}

# The pushes that run consecutively from `self`, and what follows them.
struct Pushes { elements: Expr[], rest: Expr }

fn pushes(self: Expr, acc: str, adder: Callee) -> Pushes {
    let some(Pushed { element, rest }) = self.pushed(acc, adder) else {
        return Pushes { elements: [], rest: self };
    };
    let Pushes { elements, rest as end } = rest.pushes(acc, adder);
    Pushes { elements: [element, ..elements], rest: end }
}

# One element of the rewritten literal. A spread stays a spread, and what cannot be
# quoted is a placeholder.
fn element_text(self: Expr) -> str {
    if (let Spread(inner) = self.kind) {
        `..{inner.expr_text().value_or("<array>")}`
    } else {
        self.expr_text().value_or("<element>")
    }
}
