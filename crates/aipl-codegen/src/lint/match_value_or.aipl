# The `match_value_or` lint:
#
#     match (o) { some(v) => v, none => d }
#
# — an optional unwrapped to its payload with a fallback. That is exactly
# `o.value_or(d)`.
#
# The `some` arm must hand back its own binding unchanged; that identity arm is what
# separates this from a `map`, where the payload is transformed on the way out. Arm
# order does not matter.
#
# The default must be built from constants (`is_constant_default`): `value_or`'s
# default is an ordinary call argument, so it is evaluated whether or not the
# optional is empty, while a `none` arm runs only when it is. Advising the rewrite
# for a default that does work would move that work to where it did not happen
# before.
#
# The hit points at the `some(v) => v` arm's body. `#[allow]` is line-scoped, so a
# hit spanning the `match` could never be squelched; that lone identifier is always
# one line, and it is the arm that identifies the shape, since a default alone is
# something `value_or` has too.

import {
    Span,
    collect_ok,
    equal as ==,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    to_str,
    value_or,
} from builtins;
import { Ident } from "../expr.aipl";
import { Function } from "../item.aipl";
import { is_constant_default } from "./constant_default.aipl";
import {
    UnfilledHit,
    filled_with,
    hit,
    lint_function_unfilled_hits,
    lint_function_unfilled_messages,
    unfilled,
} from "./lint_hit.aipl";
import { OptionMatch, default_text, option_matches, receiver_text } from "./option_match.aipl";

# A hit for each `match` in the program that only unwraps an optional or defaults.
pub fn match_value_or(Function { body }) -> UnfilledHit[] {
    body
        .option_matches()
        .map(|OptionMatch { scrutinee, binder, some_body, none_body }| {
            let Ident(payload) = some_body.kind else { return none; };
            if (payload != binder || !none_body.is_constant_default()) { return none; };
            some(advice(scrutinee.receiver_text(), none_body.default_text(), some_body.span))
        })
        .collect_ok()
}.test({
    // The identity arm is what is pointed at, in either arm order.
    assert(lint_function_unfilled_hits(
        "fn f(o: i64?) -> i64 { match (o) { some(v) => v, none => 0 } }",
        match_value_or,
    )? == [hit(message("o", "0"), 46..47)]);
    assert(lint_function_unfilled_messages(
        "fn f(o: i64?) -> i64 { match (o) { none => 0, some(v) => v } }",
        match_value_or,
    )? == [message("o", "0")]);

    // The default is quoted as written, a struct literal and arithmetic included.
    assert(lint_function_unfilled_messages(
        "fn f(o: P?) -> P { match (o) { some(v) => v, none => P { x: 0, y: 1 } } }",
        match_value_or,
    )? == [message("o", "P { x: 0, y: 1 }")]);
    assert(lint_function_unfilled_messages(
        "fn f(o: i64?) -> i64 { match (o) { some(v) => v, none => 100 / 4 } }",
        match_value_or,
    )? == [message("o", "100 / 4")]);

    // A receiver that cannot take a method as written is not quoted.
    assert(lint_function_unfilled_messages(
        "fn f(a: i64?, b: i64?) -> i64 { match (a || b) { some(v) => v, none => 0 } }",
        match_value_or,
    )? == [message("<value>", "0")]);

    // The `.test` block is held to it too.
    assert(lint_function_unfilled_messages(
        "fn f() { }.test({ assert(match (o) { some(v) => v, none => 0 } == 0); })",
        match_value_or,
    )? == [message("o", "0")]);

    // A mapping, a default that does work and a catch-all are left alone.
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> i64 { match (o) { some(v) => g(v), none => 0 } }",
            match_value_or,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> i64 { match (o) { some(v) => v, none => g() } }",
            match_value_or,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> i64 { match (o) { some(v) => v, _ => 0 } }",
            match_value_or,
        )? == [],
    );

    // Shapes the lint must leave alone.
    // The `some` arm transforms the payload, so this is a `map`, not a `value_or`
    // — which is `match_map_value_or`'s shape, squelched here so this case stays
    // about which lint does *not* fire.
    assert(
        lint_function_unfilled_messages(
            """
                fn plus_one(o: i64?) -> i64 {
                    match (o) {
                        some(v) => v + 1,
                        none => 0, #[allow]
                    }
                }
            """,
            match_value_or,
        )? == [],
    );
    // The `some` arm ignores its binding, so the payload never comes out.
    assert(
        lint_function_unfilled_messages(
            """
                fn always_zero(o: i64?) -> i64 {
                    match (o) {
                        some(v) => 0,
                        none => 0,
                    }
                }
            """,
            match_value_or,
        )? == [],
    );
    assert(lint_function_unfilled_messages("fn fallback() -> i64 { 7 }", match_value_or)? == []);

    // The default is a call. `value_or`'s argument is evaluated eagerly, but this
    // `none` arm runs only when the optional is empty — rewriting would call
    // `fallback()` even for a populated optional, so the lint stays quiet.
    assert(
        lint_function_unfilled_messages(
            """
                fn or_call(o: i64?) -> i64 {
                    match (o) {
                        some(v) => v,
                        none => fallback(),
                    }
                }
            """,
            match_value_or,
        )? == [],
    );

    // The default is a struct literal built from a *call*, so it is not constant
    // either — the lint looks through the construction at what fills it.
    assert(
        lint_function_unfilled_messages(
            """
                fn or_computed_struct(o: Pt?) -> Pt {
                    match (o) {
                        some(v) => v,
                        none => Pt { x: fallback(), y: 0 },
                    }
                }
            """,
            match_value_or,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    assert(lint_function_unfilled_messages(
        """
            fn or_zero(o: i64?) -> i64 {
                match (o) {
                    some(v) => v,
                    none => 0,
                }
            }
        """,
        match_value_or,
    )? == [
        """this `match` hands back the optional's payload or a default — write "o.value_or(0)" instead, importing `value_or` from builtins""",
    ]);
    assert(lint_function_unfilled_messages(
        """
            fn none_first(o: i64?) -> i64 {
                match (o) {
                    none => 0,
                    some(v) => v,
                }
            }
        """,
        match_value_or,
    )? == [
        """this `match` hands back the optional's payload or a default — write "o.value_or(0)" instead, importing `value_or` from builtins""",
    ]);

    // An inline *struct* default is flagged too. It used not to be — not for
    // formatting reasons, but because `value_or` was emitted natively as a tag
    // select over one i64 payload and genuinely could not unwrap such an optional.
    // It is AIPL-implemented now and generic over every payload, so the rewrite the
    // lint advises is one that compiles.
    //
    // The message quotes the default as written, its closing brace included. A
    // default that runs over several lines is quoted as `..` instead.
    assert(lint_function_unfilled_messages(
        """
            fn or_origin(o: Pt?) -> Pt {
                match (o) {
                    some(v) => v,
                    none => Pt { x: 0, y: 0 },
                }
            }
        """,
        match_value_or,
    )? == [
        """this `match` hands back the optional's payload or a default — write "o.value_or(Pt { x: 0, y: 0 })" instead, importing `value_or` from builtins""",
    ]);

    // Arithmetic in the `none` arm is flagged. It used to be exempt: `/` and `%`
    // trapped on a zero divisor, so evaluating one eagerly could turn a program that
    // returns into one that dies. Both are total now — `/` saturates and `%` answers
    // the dividend — so a division costs the same computed eagerly as lazily, like
    // any other constant.
    assert(lint_function_unfilled_messages(
        """
            fn or_divided(o: i64?) -> i64 {
                match (o) {
                    some(v) => v,
                    none => 100 / 4,
                }
            }
        """,
        match_value_or,
    )? == [
        """this `match` hands back the optional's payload or a default — write "o.value_or(100 / 4)" instead, importing `value_or` from builtins""",
    ]);

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn or_zero(o: i64?) -> i64 {
        match (o) {
            some(v) => v, #[allow]
            none => 0,
        }
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side
    // and proven to agree.
    fn or_zero_short(o: i64?) -> i64 { o.value_or(0) }
    assert(or_zero(some(5)).to_str() == "5");
    assert(or_zero_short(some(5)).to_str() == "5");
    assert(or_zero(none).to_str() == "0");
    assert(or_zero_short(none).to_str() == "0");
})

# What is said of a `match` that unwraps the optional `receiver` or gives `default`,
# pointing at `span`.
fn advice(receiver: str, default: str, span: Span) -> UnfilledHit {
    unfilled(
        "value_or",
        `this \`match\` hands back the optional's payload or a default — write "{receiver}.`,
        `({default})" instead`,
        span,
    )
}

# The message for a file that does not import `value_or`, as the tests' sources do not.
fn message(receiver: str, default: str) -> str {
    advice(receiver, default, 0..0).filled_with(|name| none).message
}
