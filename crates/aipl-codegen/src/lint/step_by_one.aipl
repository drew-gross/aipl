# The `step_by_one` lint: a step of one written the long way — `set x = x + 1;`, `set x += 1;`, and
# their `-` mirrors — where `set x++;` / `set x--;` is the form for it.
#
# Every spelling that adds or subtracts exactly one is the same statement, so they are one lint
# rather than four: the plain operator with either operand order for `+` (`x + 1` and `1 + x` both add
# one) but only the left for `-` (`set x = 1 - x;` is not a decrement), and the compound forms, whose
# receiver is always on the left.
#
# The target may be a name or a field path off one (`set p.n = p.n + 1;` is `set p.n++;`): every `set`
# form takes either, and a path's text spells it, so the advice can quote it as written.
#
# An operator has a step form of its own flavor (`wrapping_add` has `wrapping_increment`), and the
# advice names the import to add when the file lacks it. Neither step operator has a bare form,
# so following the advice without the import would only trade this error for the operator gate's.
#
# The hit points at the `set` statement.

import {
    collect_ok,
    equal as ==,
    filter,
    is_empty,
    is_some,
    is_some_and,
    logical_and as &&,
    logical_not as !,
    map,
} from builtins;
import {
    Callee,
    SaturatingAdd,
    SaturatingAddAssign,
    SaturatingDecrement,
    SaturatingIncrement,
    SaturatingSub,
    SaturatingSubAssign,
    WrappingAdd,
    WrappingAddAssign,
    WrappingDecrement,
    WrappingIncrement,
    WrappingSub,
    WrappingSubAssign,
    lint_table,
} from "../builtin_table.aipl";
import { Assign, Call, Expr, Num, descendants_of_kind } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Item } from "../item.aipl";
import {
    Advice,
    Named,
    UnfilledHit,
    hit_at,
    lint_in_unfilled,
    lint_in_unfilled_messages,
    shown,
} from "./lint_hit.aipl";
import { is_same_place, place_text } from "./places.aipl";
import { Builtin, spelled } from "./spelling.aipl";

# The step builtin that replaces an operator builtin, whether it adds, and whether the operation
# reads in either operand order.
struct Step { builtin: Callee, adds: bool, commutative: bool }

# The step the operator builtin `self` becomes, if it adds or subtracts.
pub fn step_of(self: Callee) -> Step? {
    match (self) {
        WrappingAdd => some(Step { builtin: WrappingIncrement, adds: true, commutative: true }),
        SaturatingAdd => some(Step { builtin: SaturatingIncrement, adds: true, commutative: true }),
        WrappingAddAssign => some(Step {
            builtin: WrappingIncrement,
            adds: true,
            commutative: false,
        }),
        SaturatingAddAssign => some(Step {
            builtin: SaturatingIncrement,
            adds: true,
            commutative: false,
        }),
        WrappingSub | WrappingSubAssign => some(Step {
            builtin: WrappingDecrement,
            adds: false,
            commutative: false,
        }),
        SaturatingSub | SaturatingSubAssign => some(Step {
            builtin: SaturatingDecrement,
            adds: false,
            commutative: false,
        }),
        _ => none,
    }
}

# The plain operator builtins whose `± 1` this lint has advice for in a file with these `items`:
# the file can take the step form.
pub fn stepped_operators(self: Item[]) -> Callee[] {
    [WrappingAdd, SaturatingAdd, WrappingSub, SaturatingSub].filter(
        |callee| callee
            .step_of()
            .is_some_and(|step| Builtin(step.builtin).spelled(self, lint_table()).is_some()),
    )
}

# The hit for `self`, when it is a `set` of a place to itself plus or minus one.
pub fn step_by_one(self: Assign(target, value, _)) -> Advice? {
    let name = target.place_text()?;

    // An operator use is a call of the builtin, whatever the file calls it: `+` and `+=` want
    // different advice and are told apart by their tags.
    let Call(_, [left, right], _, callee) = value.kind else { return none; };
    let Step { builtin, adds, commutative } = callee.step_of()?;
    let stepped = if (left.is_same_place(target)) {
        right.is_one()
    } else {
        // The other order is a step only where the operation is commutative: `1 + x` adds one to
        // `x`, `1 - x` does not subtract one from it.
        commutative && left.is_one() && right.is_same_place(target)
    };
    if (!stepped) { return none; };
    let (what, form) = if (adds) {
        (`adding 1 to "{name}"`, "increment")
    } else {
        (`subtracting 1 from "{name}"`, "decrement")
    };
    some(Advice {
        named: [
            Named { text: `{what} — use the {form} form "set {name}`, builtin: Builtin(builtin) },
        ],
        tail: `;"`,
    })
}.test({
    // The hits for each function's `set`s.
    fn flagged(Function { body }, items: Item[]) -> UnfilledHit[] {
        body
            .descendants_of_kind::<Assign>()
            .map(|assign: Expr<Assign>| { assign.hit_at(assign.kind.step_by_one()) })
            .collect_ok()
    }
    fn on_field(body: str) -> str[]!ParseFailure {
        lint_in_unfilled_messages(
            `import \{ wrapping_add as + } from builtins; fn f(mut c: Counter, m: i64) \{ {body} }`,
            flagged,
        )
    }

    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = n + 1; n }",
        flagged,
    )?.shown() == [
        `adding 1 to "n" — use the increment form "set nBuiltin(WrappingIncrement);"`,
    ]);
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = 1 + n; n }",
        flagged,
    )?.shown() == [
        `adding 1 to "n" — use the increment form "set nBuiltin(WrappingIncrement);"`,
    ]);
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = n - 1; n }",
        flagged,
    )?.shown() == [
        `subtracting 1 from "n" — use the decrement form "set nBuiltin(WrappingDecrement);"`,
    ]);

    // The import to add is named, in the flavor of the operator written; where the file binds `++` to
    // the other flavor there is no step to advise.
    assert(lint_in_unfilled_messages(
        "import { saturating_add as + } from builtins; fn f(mut n: i64) { set n = n + 1; }",
        flagged,
    )? == [
        """adding 1 to "n" — use the increment form "set n++;", importing `saturating_increment as ++` from builtins""",
    ]);
    assert(
        lint_in_unfilled_messages(
            "import { saturating_add as +, wrapping_increment as ++ } from builtins; fn f(mut n: i64) { set n = n + 1; }",
            flagged,
        )?.is_empty(),
    );

    // `1 - n` is not a decrement; another amount is not a step; a flavor that does not match, or an
    // operator the file defines itself, is quiet.
    assert(
        lint_in_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = 1 - n; n }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_in_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = n + 2; n }",
            flagged,
        )?.is_empty(),
    );

    // The compound spellings are the same statements, paired against the operator that was written,
    // so the plain `+` need not be imported at all.

    // The decrement names the flavor of the operator written: a saturating subtract is not
    // recommended a wrapping decrement, and a file whose `-` and `--` differ is quiet.

    // Only the same place on both sides is a step: another binding, or a field fed from one, is not.
    assert(
        lint_in_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = x + 1; n }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_in_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = x - 1; n }",
            flagged,
        )?.is_empty(),
    );
    assert(on_field("set c.n = c.n + 1;")? == [
        """adding 1 to "c.n" — use the increment form "set c.n++;", importing `wrapping_increment as ++` from builtins""",
    ]);
    assert(on_field("set c.n = m + 1;")? == []);

    // An operator bound to one of the file's own functions is not the builtin, whatever it is called.
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n += 1; n }",
        flagged,
    )?.shown() == [
        `adding 1 to "n" — use the increment form "set nBuiltin(WrappingIncrement);"`,
    ]);
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n -= 1; n }",
        flagged,
    )?.shown() == [
        `subtracting 1 from "n" — use the decrement form "set nBuiltin(WrappingDecrement);"`,
    ]);
})

fn is_one(self: Expr) -> bool { self.kind == Num(1) }
