# The `destructure_binding` lint: `let p = value; ... p.a ... p.b ...` where
# **every** mention of `p` is a field read. Say so with a pattern instead:
# `let T { a, b } = value;`.
#
# The binding then names what it actually holds. A reader of
# `let P { line, col } = pos_of(i);` knows the two fields are the whole story;
# with `let p = pos_of(i);` they have to scan the rest of the block to find out
# whether `p` is also passed somewhere, compared, or returned.
#
# One bare mention is enough to stay quiet, because a pattern cannot reproduce
# it — the value itself is gone, only its fields survive. That covers the
# obvious escapes (`f(p)`, `p == q`, a trailing `p`) without special-casing any
# of them.
#
# Only an immutable `let` is flagged. A `mut` binding is a different question —
# whether it should be `mut` at all — and answering it here would advise a
# rewrite that changes more than the spelling.
#
# **A pattern binds one name per field, so it is only available when each of
# those names would mean one thing in the function.** Two conditions take the
# lint out, and between them they are most of what it would otherwise flag:
#
# - **The name is already spoken for.** `let b = w.bump();` reading `b.text` and
#   `b.w` cannot become `let Bump { text, w } = w.bump();` where a `w` is in
#   scope: the new binding shadows it and every later mention of the old one
#   silently changes meaning.
#
#   The binding's *own* name does not count, even when a field shares it (`let
#   segs = ..` reading `segs.segs`). That binding is the one going away, and
#   every mention of it is the base of a field read the pattern replaces — so
#   there is provably nothing left for the new name to shadow.
#
# - **The field is read off more than one value.** Three `let`s binding the same
#   struct in one block are told apart by their *names* (`plain.cleaned`,
#   `empty.cleaned`); destructuring them all binds `cleaned` three times,
#   shadowing in sequence, and the distinction the names carried is gone. So a
#   field read off two different bases anywhere in the function disqualifies
#   every binding it belongs to — which is why the reads are those of the whole
#   function rather than of the binding's own body.
#
#   Reads inside the binding's **own value** are the exception, and they are not
#   a rarity: threading a cursor writes `let segs = head.w.next()?` and then reads
#   `segs.w`, so `w` has two bases and neither is ambiguous. The value is
#   evaluated before the pattern binds anything, so no name the pattern
#   introduces can be confused with a read in it.
#
# The lint runs before type checking, so it cannot know the type of a call's
# result: the advice names the struct only where an annotation already does.

import {
    any,
    collect_arms,
    contains,
    equal as ==,
    is_case,
    join,
    logical_or as ||,
    map,
    not_equal as !=,
} from builtins;
import { Construct, Let, descendants, field_reads } from "../expr.aipl";
import { Function, pattern_reads } from "../item.aipl";
import { Named } from "../ty.aipl";
import { Uses, is_shared, is_tuple_field, mentions_any, uses_of } from "./field_uses.aipl";
import { LintHit, hit, lint_function_messages } from "./lint_hit.aipl";

# A hit for each immutable `let` in the program whose binding is only ever taken
# apart by field reads.
pub fn destructure_binding(Function { sig, body }) -> LintHit[] {
    // Every read is those of the whole body, so that a field read off two bases
    // anywhere in it counts against each binding it belongs to; the function's
    // destructured parameters take their fields apart at the top of it, and their
    // reads count the same way.
    let reads = [..sig.params$pattern_reads().join(), ..body.field_reads()];
    body
        .descendants()$kind
        .collect_arms(Let)
        .map(|Let(name, annotation, value, inner)| {
            // A name the parser made (`__iset1$6`, the `seed$provider` of a shim) was never
            // written by the author, who cannot put an `#[allow]` on it. The destructuring
            // forms are not among them: this reads the program before they are lowered.
            if (name.contains("$")) {
                return [];
            };

            let Uses { mentions, field_reads, fields, shadowed } = inner.uses_of(name);

            // A rebinding of the same name inside the inner splits the mentions between two
            // different values, and this walk cannot tell which is which. Rather than
            // track scopes for a case that is rare and confusing to read anyway, say
            // nothing.
            if (shadowed || field_reads == 0 || field_reads != mentions) {
                return [];
            };

            // Is one of these field names also read off some *other* value that is still
            // around once the pattern binds it? Then the bare name would mean two things
            // and the binding names are what tell them apart today.
            if (fields.is_shared(reads, value.field_reads()) || fields.any(is_tuple_field)) {
                return [];
            };

            // The binding's own name is exempt in the inner — it is the name going away,
            // and every mention of it there is the base of a read the pattern replaces.
            // In the *value* nothing is exempt: that is evaluated before the pattern
            // binds, so a name it mentions is an outer one the pattern would shadow for
            // the rest of the block.
            if (inner.mentions_any(fields, some(name)) || value.mentions_any(fields, none)) {
                return [];
            };

            // Taking apart a value built on the same line is not an improvement: the
            // pattern restates the type name that literal just wrote and re-lists the
            // fields it just set.
            if (value.kind.is_case(Construct)) {
                return [];
            };
            // The struct is named only where the source already names it — an annotation.
            let ty = match (annotation) {
                some(Named(struct_name)) => struct_name,
                _ => "<Type>",
            };
            [hit(message(name, fields.join(sep=", "), ty), value.span)]
        })
        .join()
}.test({
    // Only fields are read: take it apart in the pattern.
    assert(lint_function_messages(
        "fn f() -> i64 { let p = g(); p.a + p.b }",
        destructure_binding,
    )? == [message("p", "a, b", "<Type>")]);

    // An annotation names the struct for the advice.
    assert(lint_function_messages(
        "fn f() -> i64 { let p: P = g(); p.a }",
        destructure_binding,
    )? == [message("p", "a", "P")]);

    // A pattern the author wrote is not a binding to advise about, whatever the
    // parser binds for it underneath; neither is the rest of the block's reading
    // of the names it made.
    assert(
        lint_function_messages(
            "fn f() -> i64 { let P { a, b } = g(); a + b }",
            destructure_binding,
        )? == [],
    );
    assert(
        lint_function_messages(
            "fn f(t: (i64, i64)) -> i64 { let (a, b) = t; a + b }",
            destructure_binding,
        )? == [],
    );
    assert(
        lint_function_messages(
            "fn f() -> i64 { for (let P { a } : xs) { h(a); } 0 }",
            destructure_binding,
        )? == [],
    );
    // A name the pattern binds shadows an outer one, which splits its mentions.
    assert(
        lint_function_messages(
            "fn f() -> i64 { let p = g(); let P { p } = h(); p.a }",
            destructure_binding,
        )? == [],
    );

    // One bare mention keeps the value whole, so a pattern could not replace it.
    assert(
        lint_function_messages(
            "fn f() -> i64 { let p = g(); h(p); p.a }",
            destructure_binding,
        )? == [],
    );

    // The name is spoken for: the field's name would shadow one in scope.
    assert(
        lint_function_messages(
            "fn f(a: i64) -> i64 { let p = g(); p.a + a }",
            destructure_binding,
        )? == [],
    );

    // A field read off two values is told apart by the names of the values...
    assert(
        lint_function_messages(
            "fn f() -> i64 { let p = g(); let q = g(); p.a + q.a }",
            destructure_binding,
        )? == [],
    );

    // ...but a read inside the binding's own value runs before the pattern binds.
    assert(lint_function_messages(
        "fn f() -> i64 { let p = h(q.a); p.a }",
        destructure_binding,
    )? == [message("p", "a", "<Type>")]);

    // A rebinding of the name splits its mentions between two values.
    assert(
        lint_function_messages(
            "fn f() -> i64 { let p = g(); h(|p| p); p.a }",
            destructure_binding,
        )? == [],
    );

    // ...and a later `let` of the same name is judged on its own.
    assert(lint_function_messages(
        "fn f() -> i64 { let p = g(); let p = h(); p.a }",
        destructure_binding,
    )? == [message("p", "a", "<Type>")]);

    // A tuple cannot be taken apart by a struct pattern.
    assert(
        lint_function_messages("fn f() -> i64 { let p = g(); p._0 }", destructure_binding)? == [],
    );

    // The parser's own temporaries are not the user's to rewrite.
    assert(lint_function_messages("fn f(P { a }) -> i64 { a }", destructure_binding)? == []);
    assert(
        lint_function_messages(
            "fn f() -> i64 { let P { a } = g(); a }",
            destructure_binding,
        )? == [],
    );

    // A value built on the same line is not taken apart.
    assert(
        lint_function_messages(
            "fn f() -> i64 { let p = P { a: 1 }; p.a }",
            destructure_binding,
        )? == [],
    );

    // A `mut` binding is a different question.
    assert(
        lint_function_messages("fn f() -> i64 { mut p = g(); p.a }", destructure_binding)? == [],
    );

    // The `.test` block is held to it too.
    assert(lint_function_messages(
        "fn f() { }.test({ let p = g(); assert(p.a == 1); })",
        destructure_binding,
    )? == [message("p", "a", "<Type>")]);
})

# What is said of the binding `name`, whose `fields` are the ones read.
fn message(name: str, fields: str, ty: str) -> str {
    `only the fields of "{name}" are read — destructure the binding instead: "let {ty} \{ {fields} } = ..."`
}
