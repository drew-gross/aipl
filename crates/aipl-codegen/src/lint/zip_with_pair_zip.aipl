# The `zip_with_pair_zip` lint:
#
#     xs.zip_with(ys, |a, b| { (a, b) })
#
# — a `zip_with` whose function does nothing but build the pair of its two arguments, in
# the order it got them. That is `xs.zip(ys)`, which says the result *is* the pairs
# instead of a function the reader has to read to find out that it combines nothing.
#
# Exactly this shape: a function with two parameters and a body that is the tuple of
# those parameters, first then second. A swapped pair is a different array, and a body
# that computes anything is a real combining function, which `zip_with` is for.
#
# The hit points at the function, which begins on the line the `#[allow]` would be
# written on.

import {
    collect_ok,
    equal as ==,
    logical_and as &&,
    logical_not as !,
    not_equal as !=,
} from builtins;
import { Zip, ZipWith } from "../builtin_table.aipl";
import {
    Call,
    Expr,
    Ident,
    Lambda,
    TupleLit,
    descendants_of_kind,
    synthesized_name,
} from "../expr.aipl";
import { Function } from "../item.aipl";
import { Named, UnfilledHit, lint_function_unfilled, quote, shown } from "./lint_hit.aipl";
import { Builtin } from "./spelling.aipl";

# The hit for `self`, when it is a `zip_with` whose function only pairs its two arguments.
pub fn zip_with_pair_zip(self: Call(_, arguments, _, callee)) -> UnfilledHit? {
    if (callee != ZipWith) { return none; };
    let [receiver, other, function] = arguments else { return none; };
    if (!function.only_pairs()) { return none; };
    some(UnfilledHit {
        named: [
            Named { text: `"`, builtin: Builtin(ZipWith) },
            Named {
                text: `" with a function that only pairs its arguments is "{receiver.quote("<items>")}.`,
                builtin: Builtin(Zip),
            },
        ],
        tail: `({other.quote("<other>")})"`,
        span: function.span,
    })
}.test({
    // The hits for each function's calls.
    fn flagged(Function { body }) -> UnfilledHit[] {
        body.descendants_of_kind::<Call>()$kind$zip_with_pair_zip().collect_ok()
    }
    // What the lint says of a `zip_with` of `items` and `other`.
    fn says(items: str, other: str) -> str {
        `"zip_with" with a function that only pairs its arguments is "{items}.zip({other})"`
    }

    // Flagged, in method and free-call form; the parameter names do not matter.
    assert(lint_function_unfilled(
        "fn f() { xs.zip_with(ys, |a, b| { (a, b) }) }",
        flagged,
    )?.shown() == [says("xs", "ys")]);
    assert(lint_function_unfilled(
        "fn f() { zip_with(xs, ys, |left, right| { (left, right) }) }",
        flagged,
    )?.shown() == [says("xs", "ys")]);

    // Receivers that cannot be quoted are placeholders.
    assert(lint_function_unfilled(
        "fn f() { g().zip_with(h(), |a, b| { (a, b) }) }",
        flagged,
    )?.shown() == [says("<items>", "<other>")]);

    // Not the shape: the pair swapped (a different array), a body that computes something, a
    // function over one value used twice, and another function of the same shape.
    assert(lint_function_unfilled("fn f() { xs.zip_with(ys, |a, b| { (b, a) }) }", flagged)? == []);
    assert(
        lint_function_unfilled("fn f() { xs.zip_with(ys, |a, b| { (a + 1, b) }) }", flagged)? == [],
    );
    assert(lint_function_unfilled("fn f() { xs.zip_with(ys, |a, b| { (a, a) }) }", flagged)? == []);
    assert(lint_function_unfilled("fn f() { xs.map(|a| { (a, a) }) }", flagged)? == []);
})

# Whether `self` is a function of two parameters whose body is the pair of them, in order.
fn only_pairs(self: Expr) -> bool {
    let Lambda([first, second], body) = self.kind else { return false; };
    let TupleLit([left, right]) = body.kind else { return false; };
    left.kind == Ident(first.synthesized_name()) && right.kind == Ident(second.synthesized_name())
}
