# The `redundant_slice_bound` lint: a slice that says in its bounds what the open-ended form
# already says. Three shapes, told apart by which bound is redundant, and a slice is at most one
# of them:
#
# - `x[0..]`, `x[..x.len()]` and `x[0..x.len()]` cover the receiver end to end, which is what `x`
#   already is. The slice is not free: an array slice allocates a fresh block and copies every
#   element, so this is a redundant copy as well as a redundant spelling. Dropping it is safe
#   because arrays have value semantics — mutating an aliased binding copies first, so `y = x`
#   cannot be surprised by a later `set x[..]`. A start of `0` counts however it was written. The
#   hit points at a bound rather than the whole slice, because `#[allow]` is line-scoped and a
#   receiver may span lines while a bound sits inside the brackets: the written `0`, or when the
#   start was left out (`x[..x.len()]`), the end bound, which must be there in that form.
# - `x[y..x.len()]`: the end bound is the receiver's own length, which is what the open-ended
#   `x[y..]` already means. The hit points at the end bound.
# - `x[0..y]`: a start of a written `0` is what the open-ended `x[..y]` already means. The hit
#   points at the `0`.
#
# The whole receiver is the first shape wherever it applies, so a full-range slice produces
# exactly one hit whichever way it was written, and its advice (`x`) is not the `x[0..]` or
# `x[..x.len()]` the other two would have started a second round trip on. Purely syntactic: the
# receiver and the `len` argument must be the same expression, so aliases or computed receivers
# that merely happen to be equal at runtime are not "redundant_slice_bound".

import { equal as ==, is_empty, logical_and as &&, value_or } from builtins;
import { Slice } from "../expr.aipl";
import { lint_with_messages, lint_with_unfilled } from "./lint.aipl";
import { LintHit, lint_message } from "./lint_hit.aipl";
import { is_len_of, is_zero } from "./slice_bounds.aipl";

# The hit for the slice `self`, when one of its bounds says what leaving it out would.
pub fn redundant_slice_bound(self: Slice(receiver, start, end)) -> LintHit? {
    // An absent end already runs to the length; a present one has to say so.
    let reaches_end = end$is_len_of(receiver).value_or(true);
    let starts_at_edge = start$is_zero().value_or(true);
    if (starts_at_edge && reaches_end) {
        // The bound to point at: the `0` when it is written, else the end that says the length
        // (`receiver[..]` is not a form, so one of the two is there).
        return some(lint_message(
            whole(receiver.source),
            span=start.value_or(end.value_or(receiver)).span,
        ));
    };
    let some(lower) = start else { return none; };
    let some(bound) = end else { return none; };
    if (bound.is_len_of(receiver)) {
        some(lint_message(to_len(receiver.source, lower.source), span=bound.span))
    } else if (lower.is_zero()) {
        some(lint_message(from_zero(receiver.source, bound.source), span=lower.span))
    } else {
        none
    }
}.test({
    // The whole receiver, in its three spellings, each pointing at a bound.
    assert(lint_with_unfilled("fn f(s: str) -> str { s[0..] }", "redundant_slice_bound")? == [
        lint_message(whole("s"), span=24..25),
    ]);
    assert(lint_with_unfilled("fn f(s: str) -> str { s[..s.len()] }", "redundant_slice_bound")? == [
        lint_message(whole("s"), span=26..33),
    ]);
    assert(lint_with_unfilled(
        "fn f(s: str) -> str { s[0..s.len()] }",
        "redundant_slice_bound",
    )? == [lint_message(whole("s"), span=24..25)]);

    // The receiver is quoted as written, a call's arguments and all.
    assert(lint_with_messages("fn f(x: str) -> str { g(x)[0..] }", "redundant_slice_bound")? == [
        whole("g(x)"),
    ]);

    // The `.test` block is held to it too.
    assert(lint_with_messages(
        "fn f() { }.test({ assert(s[0..] == s); })",
        "redundant_slice_bound",
    )? == [whole("s")]);

    // An end that is the receiver's length, with a start worth keeping.
    assert(lint_with_unfilled(
        "fn f(s: str) -> str { s[3..s.len()] }",
        "redundant_slice_bound",
    )? == [lint_message(to_len("s", "3"), span=27..34)]);

    // A bound that is itself a computation is quoted whole.
    assert(lint_with_messages(
        "fn f(s: str) -> str { s[n + 1..s.len()] }",
        "redundant_slice_bound",
    )? == [to_len("s", "n + 1")]);

    // A written zero start, with an end short of the length.
    assert(lint_with_unfilled("fn f(s: str) -> str { s[0..2] }", "redundant_slice_bound")? == [
        lint_message(from_zero("s", "2"), span=24..25),
    ]);

    // A call-shaped end is quoted whole, parentheses included.
    assert(lint_with_messages(
        "fn f(s: str, t: str) -> str { s[0..t.len()] }",
        "redundant_slice_bound",
    )? == [from_zero("s", "t.len()")]);

    // Nothing is redundant: a start worth keeping, an end that is not the length, another
    // receiver's length, an elided start with an end short of the length, or an open end.
    assert(
        lint_with_messages("fn f(s: str) -> str { s[1..] }", "redundant_slice_bound")?.is_empty(),
    );
    assert(
        lint_with_messages("fn f(s: str) -> str { s[1..2] }", "redundant_slice_bound")?.is_empty(),
    );
    assert(
        lint_with_messages("fn f(s: str) -> str { s[..2] }", "redundant_slice_bound")?.is_empty(),
    );
    assert(
        lint_with_messages("fn f(s: str) -> str { s[3..] }", "redundant_slice_bound")?.is_empty(),
    );
    assert(
        lint_with_messages("fn f(s: str) -> str { s[3..5] }", "redundant_slice_bound")?.is_empty(),
    );
    assert(
        lint_with_messages(
            "fn f(s: str, t: str) -> str { s[3..t.len()] }",
            "redundant_slice_bound",
        )?.is_empty(),
    );
})

# What is said of a slice of `receiver` that covers all of it.
fn whole(receiver: str) -> str { `slice covers the whole receiver — use "{receiver}" itself` }

# What is said of a slice `receiver[start..receiver.len()]`.
fn to_len(receiver: str, start: str) -> str {
    `slice end is the receiver's whole length — use the open-ended "{receiver}[{start}..]"`
}

# What is said of a slice `receiver[0..end]`.
fn from_zero(receiver: str, end: str) -> str {
    `slice starts at 0 — drop it for the open-ended "{receiver}[..{end}]"`
}
