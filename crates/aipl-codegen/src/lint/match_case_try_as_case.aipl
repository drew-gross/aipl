# The `match_case_try_as_case` lint:
#
#     match (x) {
#         Field(base, field) => rest,
#         _ => none,
#     }
#
# — as the last thing a function does: a variant value taken apart when it is one
# case, and given up on with `none` otherwise. That is
# `let Field(base, field) = x.as_case(Field)?;` followed by `rest`, which says the early
# exit first and leaves the rest of the function at one level instead of inside an arm.
#
# It has to be the function's *tail* (see `tail_matches`): the `?` returns `none` from
# the function, which is only the `match`'s own answer when the `match` is what the
# function returns. The first arm must be a variant case's constructor pattern and the
# second the catch-all giving `none`. A first arm that returns the matched value itself,
# `K(..) => some(x)`, is `match_case_as_case`'s, whose answer is shorter still.
#
# The hit points at the `_ => none` arm, a short line the formatter keeps in place, so
# `#[allow]` squelches it.

import { collect_ok, equal as ==, logical_not as !, map } from builtins;
import { Call, Match, show_expr } from "../expr.aipl";
import { Function } from "../item.aipl";
import { case_pattern, is_give_up, statement_head, tail_matches } from "./case_match.aipl";
import { UnfilledHit, lint_function_unfilled_messages, unfilled } from "./lint_hit.aipl";
import { receiver_text } from "./option_match.aipl";

# A hit for each `match` that ends the function and gives up with `none` unless a value
# is one case.
pub fn match_case_try_as_case(Function { body }) -> UnfilledHit[] {
    body
        .tail_matches()
        .map(
            |tail| {
                let Match(scrutinee, arms) = tail.kind else { return none; };
                let [case_arm, other_arm] = arms else { return none; };
                let some(pattern) = case_arm.pattern.case_pattern() else { return none; };
                if (!other_arm.is_give_up()) { return none; };
                // `K(..) => some(x)` of the matched value is `match_case_as_case`'s.
                if (let Call("some", wrapped, _) = case_arm.body.kind) {
                    if (wrapped$show_expr() == [scrutinee.show_expr()]) { return none; };
                };
                some(unfilled(
                    "as_case",
                    `this match gives up with none unless the value is {pattern.case}, and is the last thing the function does — write "{pattern.statement_head()}{scrutinee.receiver_text()}.`,
                    `({pattern.case})?;" and continue with the arm's body`,
                    other_arm.span,
                ))
            },
        )
        .collect_ok()
}.test({
    // The value taken apart, with the payload it names bound by the `let`.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { match (x) { Field(base, field) => some(base), _ => none } }",
        match_case_try_as_case,
    )? == [message("let Field(base, field) = ", "x", "Field")]);

    // A payload the arm does not name has nothing to bind, and a match that follows
    // statements is still the tail.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { g(); match (x) { Field(..) => some(1), _ => none } }",
        match_case_try_as_case,
    )? == [message("", "x", "Field")]);
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { match (x) { Empty => some(1), _ => none } }",
        match_case_try_as_case,
    )? == [message("", "x", "Empty")]);

    // Through an `if`'s branch and another `match`'s arm.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr, c: bool) -> i64? { if (c) { match (x) { Field(b, f) => some(b), _ => none } } else { none } }",
        match_case_try_as_case,
    )? == [message("let Field(b, f) = ", "x", "Field")]);

    // Not the shape: it is not the function's tail, the first arm hands the value back
    // (`match_case_as_case`'s), the fallback is something else, an optional's own cases.
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> i64? { let y = match (x) { Field(b, f) => some(b), _ => none }; y }",
            match_case_try_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> Expr? { match (x) { Field(..) => some(x), _ => none } }",
            match_case_try_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> i64? { match (x) { Field(b, f) => some(b), _ => some(0) } }",
            match_case_try_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> i64? { match (o) { some(v) => some(v), _ => none } }",
            match_case_try_as_case,
        )? == [],
    );

    // Shapes the lint must leave alone.
    // Not the function's last act: a `?` would return from the function, where the
    // `match` only ended a statement.
    assert(
        lint_function_unfilled_messages(
            """
                fn doubled(s: Shape) -> i64? {
                    let r = match (s) {
                        Circle(r) => some(r),
                        _ => none,
                    };
                    r
                }
            """,
            match_case_try_as_case,
        )? == [],
    );
    // The fallthrough is not `none`.
    assert(
        lint_function_unfilled_messages(
            """
                fn radius_or_zero(s: Shape) -> i64? {
                    match (s) {
                        Circle(r) => some(r),
                        _ => some(0),
                    }
                }
            """,
            match_case_try_as_case,
        )? == [],
    );
    // More than one case is named.
    assert(
        lint_function_unfilled_messages(
            """
                fn extent(s: Shape) -> i64? {
                    match (s) {
                        Circle(r) => some(r),
                        Rect(w, h) => some(w + h),
                        _ => none,
                    }
                }
            """,
            match_case_try_as_case,
        )? == [],
    );
    // Inside a lambda, where `?` would leave the lambda and not this function.
    assert(
        lint_function_unfilled_messages(
            """
                fn radii(shapes: Shape[]) -> i64?[] {
                    shapes.map(|s| {
                        match (s) {
                            Circle(r) => some(r),
                            _ => none,
                        }
                    })
                }
            """,
            match_case_try_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn show(o: i64?) -> str { `{o}` }",
            match_case_try_as_case,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // The arm takes the payload apart.
    assert(lint_function_unfilled_messages(
        """
            fn radius(s: Shape) -> i64? {
                match (s) {
                    Circle(r) => some(r * 2),
                    _ => none,
                }
            }
        """,
        match_case_try_as_case,
    )? == [
        """this match gives up with none unless the value is Circle, and is the last thing the function does — write "let Circle(r) = s.as_case(Circle)?;" and continue with the arm's body, importing `as_case` from builtins""",
    ]);
    // Nested: the inner `match` is also the function's last act.
    assert(lint_function_unfilled_messages(
        """
            fn wide(s: Shape) -> i64? {
                match (s) {
                    Rect(w, h) => match (Circle(w)) {
                        Circle(r) => some(r + h),
                        _ => none,
                    },
                    _ => none,
                }
            }
        """,
        match_case_try_as_case,
    )? == [
        """this match gives up with none unless the value is Rect, and is the last thing the function does — write "let Rect(w, h) = s.as_case(Rect)?;" and continue with the arm's body, importing `as_case` from builtins""",
        """this match gives up with none unless the value is Circle, and is the last thing the function does — write "let Circle(r) = Circle(w).as_case(Circle)?;" and continue with the arm's body, importing `as_case` from builtins""",
    ]);
    // A case with no payload to bind.
    assert(lint_function_unfilled_messages(
        """
            fn only_empty(s: Shape, n: i64) -> i64? {
                match (s) {
                    Empty => some(n),
                    _ => none,
                }
            }
        """,
        match_case_try_as_case,
    )? == [
        """this match gives up with none unless the value is Empty, and is the last thing the function does — write "s.as_case(Empty)?;" and continue with the arm's body, importing `as_case` from builtins""",
    ]);
})

# What is said of a tail `match` over `receiver` on `case`, whose statement begins
# `head`, for a file that does not import `as_case`, as the tests' sources do not.
fn message(head: str, receiver: str, case: str) -> str {
    `this match gives up with none unless the value is {case}, and is the last thing the function does — write "{head}{receiver}.as_case({case})?;" and continue with the arm's body, importing \`as_case\` from builtins`
}
