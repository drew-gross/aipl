# The `match_bool_is_case` lint:
#
#     match (shape) {
#         Circle(..) => true,
#         Square(..) => false,
#     }
#
# — a variant value turned into whether it is one case. That is
# `shape.is_case::<Circle>()`, which says so without the other arms and stays right
# when the variant gains a case.
#
# The shape is exact: every arm's body is a `true` or `false` literal, exactly one
# of them is `true`, and its pattern is a variant case's constructor. `some`,
# `none`, `ok` and `err` are optionals and results rather than cases of a variant
# the program declares, and a bare lowercase name binds rather than naming a case,
# so neither is advised. A second `true` arm (`A | B => true`) is two cases, which
# `is_case` does not ask about.
#
# The hit points at the `true` arm, a short line the formatter keeps in place.

import {
    Span,
    all,
    as_case,
    collect_ok,
    contains,
    equal as ==,
    filter,
    is_case,
    logical_not as !,
    logical_or as ||,
} from builtins;
import { IsCase } from "../builtin_table.aipl";
import { Bool, Match, MatchArm, descendants_of_kind } from "../expr.aipl";
import { Function } from "../item.aipl";
import { Ctor, is_binder_name } from "../pat.aipl";
import {
    UnfilledHit,
    filled_assuming,
    lint_function_unfilled_messages,
    unfilled,
} from "./lint_hit.aipl";

# The hit for the `match` `self`, when it only asks which case a value is.
pub fn match_bool_is_case(self: Match(_, arms)) -> UnfilledHit? {
    if (!arms.all(|arm| arm.body.kind.is_case::<Bool>())) { return none; };
    let [MatchArm { pattern, span }] = arms.filter(|arm| arm.body.kind == Bool(true)) else {
        return none;
    };
    let Ctor(case, _, _) = pattern.as_case::<Ctor>()?;
    if (case.is_binder_name() || ["some", "none", "ok", "err"].contains(case)) { return none; };
    some(advice(case, span))
}.test({
    fn flagged(Function { body }) -> UnfilledHit[] {
        body.descendants_of_kind::<Match>()$kind$match_bool_is_case().collect_ok()
    }
    // One case is `true`, the rest `false`.
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { match (s) { Circle(..) => true, Square(..) => false } }",
        flagged,
    )? == [message("Circle", none)]);

    // A catch-all `false` does as well, and the payload may be bound.
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { match (s) { Circle(r) => true, _ => false } }",
        flagged,
    )? == [message("Circle", none)]);

    // A nullary case.
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { match (s) { Dot => true, _ => false } }",
        flagged,
    )? == [message("Dot", none)]);

    // The name the file imports it under is the advice's.
    assert(lint_function_unfilled_messages(
        "import { is_case as isa } from builtins; fn f(s: Shape) -> bool { match (s) { Dot => true, _ => false } }",
        flagged,
    )? == [message("Dot", some("isa"))]);

    // A `.test` block is held to it too.
    assert(lint_function_unfilled_messages(
        "fn f() { }.test({ assert(match (s) { Dot => true, _ => false }); })",
        flagged,
    )? == [message("Dot", none)]);

    // Two cases answering `true`, an arm that is not a bool, `false` for the case
    // named (the opposite question), an optional and a result are left alone.
    assert(
        lint_function_unfilled_messages(
            "fn f(s: Shape) -> bool { match (s) { A | B => true, _ => false } }",
            flagged,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(s: Shape) -> bool { match (s) { A(..) => true, B(r) => r, _ => false } }",
            flagged,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(s: Shape) -> bool { match (s) { A(..) => false, _ => true } }",
            flagged,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(s: i64?) -> bool { match (s) { some(..) => true, none => false } }",
            flagged,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(s: i64!str) -> bool { match (s) { ok(..) => true, err(..) => false } }",
            flagged,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(n: i64) -> bool { match (n) { other => true, _ => false } }",
            flagged,
        )? == [],
    );

    // Shapes the lint must leave alone.
    // Two cases answer `true`: `is_case` asks about one.
    assert(
        lint_function_unfilled_messages(
            """
                fn round_or_square(shape: Shape) -> bool {
                    match (shape) {
                        Circle(..) | Square(..) => true,
                        Dot => false,
                    }
                }
            """,
            flagged,
        )? == [],
    );
    // The case answering `true` is the catch-all: the question is "is it not a Dot".
    assert(
        lint_function_unfilled_messages(
            """
                fn not_dot(shape: Shape) -> bool {
                    match (shape) {
                        Dot => false,
                        _ => true,
                    }
                }
            """,
            flagged,
        )? == [],
    );
    // An arm that is not a literal does work of its own.
    assert(
        lint_function_unfilled_messages(
            """
                fn is_big(shape: Shape) -> bool {
                    match (shape) {
                        Circle(r) => r > 10,
                        _ => false,
                    }
                }
            """,
            flagged,
        )? == [],
    );
    // An optional is not a variant case, and has `is_some`.
    assert(
        lint_function_unfilled_messages(
            """
                fn has(value: i64?) -> bool {
                    match (value) {
                        some(..) => true,
                        none => false,
                    }
                }
            """,
            flagged,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // The other cases spelled out.
    assert(lint_function_unfilled_messages(
        """
            fn is_circle(shape: Shape) -> bool {
                match (shape) {
                    Circle(..) => true,
                    Square(..) => false,
                    Dot => false,
                }
            }
        """,
        flagged,
    )? == [
        """this match only asks whether the value is Circle — write "<value>.is_case::<Circle>()" and drop the match, importing `is_case` from builtins""",
    ]);
    // A catch-all `false`, with the payload bound and ignored.
    assert(lint_function_unfilled_messages(
        """
            fn is_square(shape: Shape) -> bool {
                match (shape) {
                    Square(side) => true,
                    _ => false,
                }
            }
        """,
        flagged,
    )? == [
        """this match only asks whether the value is Square — write "<value>.is_case::<Square>()" and drop the match, importing `is_case` from builtins""",
    ]);
    // A nullary case, and the `false` arm first.
    assert(lint_function_unfilled_messages(
        """
            fn is_dot(shape: Shape) -> bool {
                match (shape) {
                    Circle(..) | Square(..) => false,
                    Dot => true,
                }
            }
        """,
        flagged,
    )? == [
        """this match only asks whether the value is Dot — write "<value>.is_case::<Dot>()" and drop the match, importing `is_case` from builtins""",
    ]);
})

# What is said of a match that only asks whether a value is `case`, with the name
# of `is_case` left for the caller to fill in.
fn advice(case: str, span: Span) -> UnfilledHit {
    unfilled(
        IsCase,
        `this match only asks whether the value is {case} — write "<value>.`,
        `::<{case}>()" and drop the match`,
        span,
    )
}

# The message `advice` comes to for a file that spells `is_case` as `spelled`.
fn message(case: str, spelled: str?) -> str { advice(case, 0..0).filled_assuming(spelled) }
