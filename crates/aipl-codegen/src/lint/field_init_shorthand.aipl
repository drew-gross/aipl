# The `field_init_shorthand` lint: `Point { x: x }` — a field initialized with the bare
# identifier of the same name; `Point { x }` is the same literal.
#
# The parser records which fields are written as the shorthand (`FieldInit.shorthand`), so a field
# whose value is the identifier it is named for is flagged unless it is one.
#
# A literal the parser synthesizes from other syntax carries a `__builtin_`-prefixed name a user
# cannot write — a range `start..end` is `__builtin_Span { start: start, end: end }` — and its
# bound identifiers are not a written `field: field`, so those are skipped.
#
# The hit points at the value.

import { as_case, collect_ok, equal as ==, join, not_equal as !=, starts_with } from builtins;
import { Construct, Expr, FieldInit, Ident, descendants_of_kind } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { LintHit, hit, lint_function_messages } from "./lint_hit.aipl";

# A hit for each field of the struct literal `self` that is set to a name it shares.
pub fn field_init_shorthand(self: Expr<Construct>) -> LintHit[] {
    let Construct(name, inits) = self.kind;
    if (name.starts_with("__builtin_")) { return []; };
    inits$spelled_out().collect_ok()
}.test({
    fn messages(src: str) -> str[]!ParseFailure {
        lint_function_messages(
            src,
            |function| {
                function.body.descendants_of_kind::<Construct>()$field_init_shorthand().join()
            },
        )
    }

    assert(messages("fn f(x: i64) -> P { P { x: x } }")? == [message("x")]);

    // Each field that repeats its name, and only those.
    assert(messages("fn f(x: i64, y: i64) -> P { P { x: x, y: y + 1, z: y } }")? == [message("x")]);

    // The shorthand itself, a different name, a spread and a range are not flagged.
    assert(messages("fn f(x: i64) -> P { P { x } }")? == []);
    assert(messages("fn f(x: i64) -> P { P { x: y } }")? == []);
    assert(messages("fn f(p: P) -> P { P { ..p, x: 1 } }")? == []);
    assert(messages("fn f(a: u64, b: u64) -> u64[] { a..b }")? == []);

    // A range inside a struct body desugars to a `Span` whose bound names match its fields, and the
    // value's preceding source character is the outer `span:` colon; neither is a written `field: field`.
    assert(messages("fn tok(start: i64, end: i64) -> Tok { span: start..end }")? == []);
})

# The hit for the field `self`, if it is written out in full.
fn spelled_out(self: FieldInit) -> LintHit? {
    if (self.shorthand) { return none; };
    let Ident(name) = self.value.kind.as_case::<Ident>()?;
    if (name != self.name) { return none; };
    some(hit(message(name), self.value.span))
}

fn message(name: str) -> str {
    `field "{name}" is set to the identifier of the same name — use the shorthand "{name}"`
}
