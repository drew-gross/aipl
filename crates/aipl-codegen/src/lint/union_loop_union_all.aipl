# The `union_loop_union_all` lint:
#
#     mut out = #{};
#     for (let s : xs) {
#         set out = out.union(s);
#     }
#
# — a set seeded empty and grown by a loop that does nothing but union each element into
# it. That is `xs.union_all()`: one word for "every element of every set in `xs`",
# instead of three statements the reader has to run in their head to discover that the
# loop is a plain fold and nothing else happens to `out`.
#
# When the loop unions something *derived* from the element rather than the element
# itself, that derivation is the `map` the pipeline needs first: `set out = out.union(f(s));`
# is `xs.map(|s| f(s)).union_all()`. This is the same two-stage advice `push_loop_pipeline`
# gives, and it bows out in the same places — the unioned expression may not mention
# `out` (a fold reading its own accumulator is not a `map`) and may not propagate with
# `?`. Both operand orders count: set union is commutative *and* its result is a set, so
# `out.union(x)` and `x.union(out)` accumulate the same set, unlike an array append, where
# the order is the whole answer.
#
# The shape has to be exactly this, because anything else in the loop is work `union_all`
# has nowhere to put: the body is one statement, that statement is the assignment, and
# the seed is the *empty* set — `mut out = #{1};` folds onto a starting value the builtin
# cannot express. A guard is refused for the same reason, even though
# `xs.filter(..).union_all()` would say it: the guard would have to be a predicate on
# whole sets, which is a different and much rarer thing to write than a predicate on
# elements, and advising it on the strength of a shape match is how a lint starts being
# wrong. What comes *after* the loop is unconstrained — the rewrite leaves `out` a `mut`
# binding that simply starts out full.
#
# An early `return` inside the loop takes the shape out of scope automatically: the body
# is then two statements, so there is no lone statement. That is `seq_labels` in
# `crates/aipl-codegen/src/parse.aipl`, which stops at the first non-nullable element and
# is a genuinely different fold.
#
# `set out = out.union(#{e});` unions one element at a time: that is `to_set` over the
# elements, not `union_all` over sets — and `to_set` takes its order from the binding, so
# this form is advised whatever the accumulator's order. `union_all` builds an unordered
# set, so the set-at-a-time form is only advised for an unordered accumulator, and a
# loop accumulating into a `#>{..}` / `#<{..}` with one is not one it can replace. The
# annotation stays in the advice: for an ordered set it is what `to_set` reads its order
# from.
#
# The hit points at the seed.

import {
    as_case,
    collect_ok,
    equal as ==,
    first,
    is_nonempty,
    is_some,
    is_some_and,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    push,
    sort,
    to_set,
    to_str,
    union,
    union_all,
    value_or,
    wrapping_add as +,
} from builtins;
import { Assign, Call, Expr, Ident, SetLit } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import { Set, Unordered, type_text } from "../ty.aipl";
import { SeededLoop, is_liftable, pipeline_hit, seeded_loops } from "./accumulation.aipl";
import {
    LintHit,
    UnfilledHit,
    imported_as,
    lint_messages,
    on_functions_filled,
} from "./lint_hit.aipl";
import { lone_statement } from "./loop_shape.aipl";

# A hit for each set the program seeds empty and grows with a loop of `union`s.
pub fn union_loop_union_all(program: Program) -> LintHit[] {
    let some(union) = program.items.imported_as("union") else { return []; };
    program.on_functions_filled(|Function { body }| {
        body.seeded_loops()$unioned(union).collect_ok()
    })
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(xs: #\{i64}[]) -> #\{i64} \{ {body} }`,
            union_loop_union_all,
        )
    }
    let all = "union, map, union_all, to_set";

    // A set at a time, mapped or as it is, in either operand order.
    assert(messages(all, "mut out = #{}; for (let s : xs) { set out = out.union(s); } out")? == [
        `"out" is seeded empty and unioned into by this loop a set at a time and nothing else — write "mut out = xs.union_all();" and drop the loop`,
    ]);
    assert(messages(all, "mut out = #{}; for (let s : xs) { set out = out.union(g(s)); } out")? == [
        `"out" is seeded empty and unioned into by this loop a set at a time and nothing else — write "mut out = xs.map(|s| ..).union_all();" and drop the loop`,
    ]);
    assert(messages(all, "mut out = #{}; for (let s : xs) { set out = g(s).union(out); } out")? == [
        `"out" is seeded empty and unioned into by this loop a set at a time and nothing else — write "mut out = xs.map(|s| ..).union_all();" and drop the loop`,
    ]);

    // An element at a time is `to_set`, whatever the accumulator's order, and the
    // annotation stays.
    assert(messages(
        all,
        "mut out: #{i64} = #{}; for (let s : xs) { set out = out.union(#{s}); } out",
    )? == [
        `"out" is seeded empty and unioned into by this loop an element at a time and nothing else — write "mut out: #\{i64\} = xs.to_set();" and drop the loop`,
    ]);
    assert(messages(
        all,
        "mut out: #>{i64} = #{}; for (let s : xs) { set out = out.union(#{g(s)}); } out",
    )? == [
        `"out" is seeded empty and unioned into by this loop an element at a time and nothing else — write "mut out: #>\{i64\} = xs.map(|s| ..).to_set();" and drop the loop`,
    ]);

    // Imports the file lacks are named, and an alias is followed.
    assert(messages(
        "union",
        "mut out = #{}; for (let s : xs) { set out = out.union(g(s)); } out",
    )? == [
        ```"out" is seeded empty and unioned into by this loop a set at a time and nothing else — write "mut out = xs.map(|s| ..).union_all();" and drop the loop, importing `map` and `union_all` from builtins```,
    ]);
    assert(messages(
        "union, union_all as all_of",
        "mut out = #{}; for (let s : xs) { set out = out.union(s); } out",
    )? == [
        `"out" is seeded empty and unioned into by this loop a set at a time and nothing else — write "mut out = xs.all_of();" and drop the loop`,
    ]);

    // Not the shape: an ordered accumulator unioned a set at a time, a seed with elements, a
    // guard, an unioned value that reads the accumulator or propagates with `?`, an indexed
    // loop, a second statement, the accumulator unioned with itself, and a `union` the
    // file never imported.
    assert(
        messages(
            all,
            "mut out: #>{i64} = #{}; for (let s : xs) { set out = out.union(s); } out",
        )? == [],
    );
    assert(
        messages(all, "mut out = #{1}; for (let s : xs) { set out = out.union(s); } out")? == [],
    );
    assert(
        messages(
            all,
            "mut out = #{}; for (let s : xs) { if (c(s)) { set out = out.union(s); }; } out",
        )? == [],
    );
    assert(
        messages(
            all,
            "mut out = #{}; for (let s : xs) { set out = out.union(g(out)); } out",
        )? == [],
    );
    assert(
        messages(all, "mut out = #{}; for (let s : xs) { set out = out.union(g(s)?); } out")? == [],
    );
    assert(
        messages(all, "mut out = #{}; for (let i, s : xs) { set out = out.union(s); } out")? == [],
    );
    assert(
        messages(
            all,
            "mut out = #{}; for (let s : xs) { g(s); set out = out.union(s); } out",
        )? == [],
    );
    assert(
        messages(all, "mut out = #{}; for (let s : xs) { set out = out.union(out); } out")? == [],
    );
    assert(
        messages(
            "map, union_all",
            "mut out = #{}; for (let s : xs) { set out = out.union(s); } out",
        )? == [],
    );
    // Shapes the lint must leave alone.
    assert(
        lint_messages(
            """
                fn show(s: #{i64}) -> str {
                    mut out: i64[] = []; #[allow]
                    for (let x : s) {
                        set out.push(x);
                    }
                    out.sort()$to_str().join(sep=",")
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    // The loop does something else as well. `union_all` has nowhere to put it.
    assert(
        lint_messages(
            """
                fn logged(xs: #{i64}[]) !prints -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        print(s.len().to_str());
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // An early exit out of the loop. This is a fold that stops, which `union_all`
    // cannot express — it is `seq_labels` in `crates/aipl-codegen/src/parse.aipl`,
    // which unions each element's labels in until one of them is non-nullable.
    assert(
        lint_messages(
            """
                fn upto_three(xs: #{i64}[]) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        set out = out.union(s);
                        if (out.len() > 3) { return out; };
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // A guard. `xs.filter(..).union_all()` would say it, but the predicate would
    // have to be one on whole *sets* — a different and much rarer thing to write
    // than a predicate on elements — so this is left alone rather than advised on
    // the strength of a shape match.
    assert(
        lint_messages(
            """
                fn nonempty_only(xs: #{i64}[]) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        if (s.is_nonempty()) { set out = out.union(s); };
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // The seed is not empty, so the fold starts from a value `union_all` has no
    // parameter for.
    assert(
        lint_messages(
            """
                fn merged_onto(xs: #{i64}[]) -> #{i64} {
                    mut out: #{i64} = #{99};
                    for (let s : xs) {
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    assert(
        lint_messages(
            "fn take(s: #{i64}, n: u64) -> #{i64} { if (s.len() > n) { s } else { #{} } }",
            union_loop_union_all,
        )? == [],
    );

    // The unioned expression reads the set being built, so it depends on how much
    // the loop has already done — which no `map` lambda can see.
    assert(
        lint_messages(
            """
                fn while_small(xs: #{i64}[]) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        set out = out.union(take(s, out.len()));
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    assert(
        lint_messages(
            """fn lookup(s: #{i64}) -> #{i64}!str { if (s.is_nonempty()) { ok(s) } else { err("empty") } }""",
            union_loop_union_all,
        )? == [],
    );

    // A `?` in the unioned expression returns from *this* function; lifting it into
    // a lambda would return from the lambda instead.
    assert(
        lint_messages(
            """
                fn checked(xs: #{i64}[]) -> #{i64}!str {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        set out = out.union(lookup(s)?);
                    }
                    ok(out)
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // Neither operand is the accumulator, so the loop is not a fold onto it at all
    // — every iteration throws away what the last one wrote.
    assert(
        lint_messages(
            """
                fn last_wins(xs: #{i64}[], other: #{i64}) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        set out = s.union(other);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // A statement between the seed and the loop, which could read `out` while it is
    // still empty — an order the rewrite would not preserve.
    assert(
        lint_messages(
            """
                fn announced(xs: #{i64}[]) !prints -> #{i64} {
                    mut out: #{i64} = #{};
                    print(out.len().to_str());
                    for (let s : xs) {
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // An *ordered* accumulator unioned a set at a time. `union_all` builds an
    // unordered set, so the rewrite would change the type; only the
    // element-at-a-time form (`#{x}`), which `to_set` can take in any order, is
    // advised on an ordered set.
    assert(
        lint_messages(
            """
                fn merged_desc(xs: #{i64}[]) -> #>{i64} {
                    mut out: #>{i64} = #{};
                    for (let s : xs) {
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    // Not a loop at all: a bounded fold written out. The lint wants a `for`.
    assert(
        lint_messages(
            """
                fn two(a: #{i64}, b: #{i64}) -> #{i64} {
                    mut out: #{i64} = #{};
                    set out = out.union(a);
                    set out = out.union(b);
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // The element unioned in unchanged — `union_all` alone.
    assert(
        lint_messages(
            """
                fn merged(xs: #{i64}[]) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : xs) {
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    assert(lint_messages("fn ends(n: i64) -> #{i64} { #{n, n} }", union_loop_union_all)? == []);

    // Something derived from the element instead, which is the `map` the fold needs
    // first.
    assert(
        lint_messages(
            """
                fn all_ends(ns: i64[]) -> #{i64} {
                    mut acc: #{i64} = #{};
                    for (let n : ns) {
                        set acc = acc.union(ends(n));
                    }
                    acc
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // The operands the other way round. Set union is commutative and its result is a
    // set, so this accumulates exactly the same set and gets the same advice.
    assert(
        lint_messages(
            """
                fn all_ends_flipped(ns: i64[]) -> #{i64} {
                    mut acc: #{i64} = #{};
                    for (let n : ns) {
                        set acc = ends(n).union(acc);
                    }
                    acc
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    assert(
        lint_messages(
            "fn pair(n: i64) -> #{i64}[] { [#{n}, #{n, n}] }",
            union_loop_union_all,
        )? == [],
    );

    // A call-shaped iterable can't be quoted back into the advice — its span stops
    // before its parens — so the message writes a placeholder in its place.
    assert(
        lint_messages(
            """
                fn from_call(n: i64) -> #{i64} {
                    mut out: #{i64} = #{};
                    for (let s : pair(n)) {
                        set out = out.union(s);
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // One element at a time — `#{x}` unioned in — is `to_set` over the elements
    // rather than `union_all` over sets: the advice keeps the annotation, since
    // `to_set` takes its order from it, so this fires for an ordered accumulator
    // too, where the set-at-a-time form (which builds an unordered set) would not.
    assert(
        lint_messages(
            """
                fn distinct(ns: i64[]) -> #{i64} {
                    mut seen: #{i64} = #{};
                    for (let n : ns) {
                        set seen = seen.union(#{n});
                    }
                    seen
                }
            """,
            union_loop_union_all,
        )? == [],
    );
    assert(
        lint_messages(
            """
                fn powers_desc(ns: i64[]) -> #>{i64} {
                    mut out: #>{i64} = #{};
                    for (let n : ns) {
                        set out = out.union(#{n + n});
                    }
                    out
                }
            """,
            union_loop_union_all,
        )? == [],
    );

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn merged(xs: #{i64}[]) -> #{i64} {
        mut out: #{i64} = #{}; #[allow]
        for (let s : xs) {
            set out = out.union(s);
        }
        out
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side
    // and proven to agree.
    fn merged_short(xs: #{i64}[]) -> #{i64} { xs.union_all() }
    fn ends(n: i64) -> #{i64} { #{n, n} }
    // The same pair for the mapped form.
    fn all_ends(ns: i64[]) -> #{i64} {
        mut out: #{i64} = #{}; #[allow]
        for (let n : ns) {
            set out = out.union(ends(n));
        }
        out
    }
    fn all_ends_short(ns: i64[]) -> #{i64} { ns.map(ends).union_all() }

    // One element at a time, into an ordered set: the loop, and its `to_set`
    // rewrite, which reads the order from the return type.
    fn doubled_desc(ns: i64[]) -> #>{i64} {
        mut out: #>{i64} = #{}; #[allow]
        for (let n : ns) {
            set out = out.union(#{n + n});
        }
        out
    }
    fn doubled_desc_short(ns: i64[]) -> #>{i64} { ns.map(|n| n + n).to_set() }
    // A set is unordered, so every comparison here sorts first.
    fn show(s: #{i64}) -> str {
        mut out: i64[] = []; #[allow]
        for (let x : s) {
            set out.push(x);
        }
        out.sort()$to_str().join(sep=",")
    }
    assert(show(merged([#{1, 2}, #{2, 3}])) == "1,2,3");
    assert(show(merged_short([#{1, 2}, #{2, 3}])) == "1,2,3");
    assert(show(all_ends([4, 5])) == "4,5");
    assert(show(all_ends_short([4, 5])) == "4,5");

    // An empty list of sets, both ways.
    let none_at_all: #{i64}[] = [];
    assert(`[{show(merged(none_at_all))}]` == "[]");
    assert(`[{show(merged_short(none_at_all))}]` == "[]");
    // The ordered pair renders in its own order, so no sorting is needed.
    assert(`{doubled_desc([2, 1, 2])}` == "{4, 2}");
    assert(`{doubled_desc_short([2, 1, 2])}` == "{4, 2}");
})

# `self` as the hit for a set grown by unioning into it, when it is one.
fn unioned(self: SeededLoop, union: str) -> UnfilledHit? {
    let SetLit(elements, order) = self.seed.kind.as_case(SetLit)?;
    if (elements.is_nonempty() || order != Unordered) { return none; };
    let ordered = self.annotation.is_some_and(|annotation| match (annotation) {
        Set(_, annotation_order) => annotation_order != Unordered,
        _ => false,
    });
    let Assign(target, value, _) = self.body.lone_statement()?.kind.as_case(Assign)?;
    if (target.kind != Ident(self.name)) { return none; };

    // The expression unioned into the accumulator by `value`, when `value` is a union of
    // the accumulator with exactly one other thing: `out.union(out)` is `out`, and a
    // union of two other things is not a fold onto this binding at all.
    let Call(callee, operands, _) = value.kind.as_case(Call)?;
    let [first, second] = operands else { return none; };
    if (callee != union) { return none; };
    let operand = if (first.kind == Ident(self.name) && second.kind != Ident(self.name)) {
        second
    } else if (second.kind == Ident(self.name) && first.kind != Ident(self.name)) {
        first
    } else {
        return none;
    };

    // `#{e}` unioned in is one element: that is `to_set`, and it is advised whatever
    // the accumulator's order.
    let single: Expr? = if (let SetLit(members, member_order) = operand.kind) {
        if (member_order == Unordered && members.len() == 1) { members.first() } else { none }
    } else {
        none
    };
    if (!single.is_some() && ordered) { return none; };
    let mapped = single.value_or(operand);
    if (!mapped.is_liftable(self.name)) { return none; };

    // Unioning the loop variable itself is the identity map, which the pipeline just
    // leaves out.
    let maps: (str, str)? = if (mapped.kind != Ident(self.variable)) {
        some(("map", `(|{self.variable}| ..)`))
    } else {
        none
    };
    let how = if (single.is_some()) { "an element at a time" } else { "a set at a time" };
    let fold = if (single.is_some()) { "to_set" } else { "union_all" };
    some(self.pipeline_hit(
        `unioned into by this loop {how} and nothing else`,
        self.annotation.map(|annotation| `: {annotation.type_text()}`).value_or(""),
        [maps, some((fold, "()"))].collect_ok(),
    ))
}
