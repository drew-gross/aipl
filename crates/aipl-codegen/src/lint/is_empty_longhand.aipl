# The `is_empty_longhand` lint: `!x.is_nonempty()` and `x.len() == 0` — emptiness asked the long way.
# `x.is_empty()` asks it directly.
#
# The two spellings fail differently and are both worth replacing. The negated predicate makes a
# reader hold a double negative to see what is being tested; the length comparison computes a number
# nobody wants and leaves them to recognize the idiom. `is_empty` says the thing itself, and reads
# the same for every receiver `len` takes — array, `str`, set, dict.
#
# This is the mirror of `len_gt_zero`, which sends the opposite comparison to `is_nonempty`. Between
# them, a length is never compared against zero.
#
# `!= 0` is deliberately not flagged: it is the *non*-empty test spelled with a comparison, so its
# rewrite is `is_nonempty` rather than `is_empty`, and that belongs to the sibling lint if anywhere.
# Nor is `x.len() < 1` — true of the same values, but not an idiom anyone reaches for, and flagging
# it would mean guessing at what an unusual spelling meant.
#
# Operators are bound by import and nothing fixes that binding, so a file that aliases `==` or `!` to
# a function of its own has an `x.len() == 0` that is not an equality test at all, and the lint stays
# quiet there. Only a builtins import counts. A file's own `len` is a different function answering a
# different question, and `is_empty` does not apply to what it takes.
#
# The receiver is quoted only where the rewrite is a literal splice: a call's span stops before its
# closing paren, so splicing `len(f(x))`'s receiver would produce advice that does not parse.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_empty,
    len,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
} from builtins;
import { Call, Expr, descendants } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import {
    LintHit,
    UnfilledHit,
    bound_to,
    imported_as,
    lint_messages,
    on_functions_filled,
    spans_its_text,
    unfilled,
} from "./lint_hit.aipl";
import { is_zero } from "./slice_bounds.aipl";

# What the file's imports make of the operators and builtins this lint reads.
struct Names { equal: bool, logical_not: bool, nonempty: str?, len: str? }

# A hit for each emptiness test in the program that is asked the long way.
pub fn is_empty_longhand(program: Program) -> LintHit[] {
    let items = program.items;
    let names = Names {
        equal: items.bound_to("==") == some("equal"),
        logical_not: items.bound_to("!") == some("logical_not"),
        nonempty: items.imported_as("is_nonempty"),
        len: items.imported_as("len"),
    };
    program.on_functions_filled(|Function { body }| body.descendants()$long_way(names).collect_ok())
}.test({
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(x: i64[]) -> bool \{ {body} }`,
            is_empty_longhand,
        )
    }
    let all = "len, is_empty, is_nonempty, equal as ==, logical_not as !";
    assert(messages(all, "x.len() == 0")? == [
        `emptiness asked the long way — use "x.is_empty()"`,
    ]);
    assert(messages(all, "0 == x.len()")? == [
        `emptiness asked the long way — use "x.is_empty()"`,
    ]);
    assert(messages(all, "!x.is_nonempty()")? == [
        `emptiness asked the long way — use "x.is_empty()"`,
    ]);

    // A receiver that is not a name or a field path is a placeholder, and a missing import is named.
    assert(messages(all, "f(x).len() == 0")? == [
        `emptiness asked the long way — use "is_empty" on the receiver`,
    ]);
    assert(messages("len, equal as ==", "x.len() == 0")? == [
        """emptiness asked the long way — use "x.is_empty()", importing `is_empty` from builtins""",
    ]);

    // `!= 0`, another number, an operator that is not the builtin one, and a `len` of the
    // file's own are not this.
    assert(messages(all, "x.len() != 0")? == []);
    assert(messages(all, "x.len() == 1")? == []);
    assert(messages("len, is_empty", "x.len() == 0")? == []);

    // Shapes the lint must leave alone.

    // Shapes the lint flags, and what it says of them.
    assert(
        lint_messages(
            "fn negated(xs: i64[]) -> bool { !xs.is_nonempty() }",
            is_empty_longhand,
        )? == [],
    );
    assert(
        lint_messages("fn len_zero(xs: i64[]) -> bool { xs.len() == 0 }", is_empty_longhand)? == [],
    );
    assert(
        lint_messages("fn zero_len(xs: i64[]) -> bool { 0 == xs.len() }", is_empty_longhand)? == [],
    );

    // The free-call spelling of `len` is the same AST, so it is the same hit — the
    // advice names the receiver rather than splicing it, since a call's span stops
    // before its closing paren.
    assert(
        lint_messages("fn free_call(xs: i64[]) -> bool { len(xs) == 0 }", is_empty_longhand)? == [],
    );
    // A `str` receiver counts too: `len` takes it, so `is_empty` does.
    assert(
        lint_messages("fn empty_str(s: str) -> bool { s.len() == 0 }", is_empty_longhand)? == [],
    );

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn the_long_way(xs: i64[]) -> bool { xs.len() == 0 } #[allow]
    fn the_short_way(xs: i64[]) -> bool { xs.is_empty() }
    assert(`{the_long_way([])} {the_short_way([])}` == "true true");
    assert(`{the_long_way([1])} {the_short_way([1])}` == "false false");
})

# The hit for `self`, when it is a negated `is_nonempty` or a length compared with zero for equality.
fn long_way(self: Expr, names: Names) -> UnfilledHit? {
    let Call(op, args, _) = self.kind.as_case(Call)?;
    let receiver = if (args.len() == 1) {
        args.negated_nonempty(op, names)?
    } else {
        args.length_equal_zero(op, names)?
    };
    some(if (receiver.spans_its_text()) {
        unfilled(
            "is_empty",
            `emptiness asked the long way — use "{receiver.source}.`,
            `()"`,
            self.span,
        )
    } else {
        unfilled(
            "is_empty",
            `emptiness asked the long way — use "`,
            `" on the receiver`,
            self.span,
        )
    })
}

# The receiver of the test the one argument `self` negates, when it is `!x.is_nonempty()`.
fn negated_nonempty(self: Expr[], op: str, Names { logical_not, nonempty }) -> Expr? {
    if (op != "!" || !logical_not) { return none; };
    let Call(callee, args, _) = self[0]?.kind.as_case(Call)?;
    if (args.len() != 1 || some(callee) != nonempty) { return none; };
    args[0]
}

# The receiver of the length that the two arguments `self` compare with zero for equality.
fn length_equal_zero(self: Expr[], op: str, Names { equal, len }) -> Expr? {
    if (op != "==" || !equal) { return none; };
    let len_name = len?;
    let [left, right] = self else { return none; };
    if (right.is_zero()) { return left.length_receiver(len_name); };
    if (left.is_zero()) { return right.length_receiver(len_name); };
    none
}

# The receiver of the call `self` when it is a call of `len`, however it was spelled: `x.len()` is the
# free call `len(x)`.
fn length_receiver(self: Expr, len_name: str) -> Expr? {
    let Call(callee, args, _) = self.kind.as_case(Call)?;
    if (callee != len_name || args.len() != 1) { return none; };
    args[0]
}
