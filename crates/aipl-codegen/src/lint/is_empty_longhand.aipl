# The `is_empty_longhand` lint: `!x.is_nonempty()` and `x.len() == 0` — emptiness asked the long way.
# `x.is_empty()` asks it directly.
#
# The two spellings fail differently and are both worth replacing. The negated predicate makes a
# reader hold a double negative to see what is being tested; the length comparison computes a number
# nobody wants and leaves them to recognize the idiom. `is_empty` says the thing itself, and reads
# the same for every receiver `len` takes — array, `str`, set, dict.
#
# This is the mirror of `len_gt_zero`, which sends the opposite comparison to `is_nonempty`. Between
# them, a length is never compared against zero.
#
# `!= 0` is deliberately not flagged: it is the *non*-empty test spelled with a comparison, so its
# rewrite is `is_nonempty` rather than `is_empty`, and that belongs to the sibling lint if anywhere.
# Nor is `x.len() < 1` — true of the same values, but not an idiom anyone reaches for, and flagging
# it would mean guessing at what an unusual spelling meant.
#
# What a call is to is what the file's imports make of its name, so the operators and `len` are found
# however the file spells them, and a file that aliases `==` or `!` to a function of its own has an
# `x.len() == 0` that is not an equality test at all. A file's own `len` is a different function
# answering a different question, and `is_empty` does not apply to what it takes.
#
# The receiver is quoted only where the rewrite is a literal splice: a call's span stops before its
# closing paren, so splicing `len(f(x))`'s receiver would produce advice that does not parse.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_empty,
    len,
    logical_or as ||,
    map,
    not_equal as !=,
    value_or,
} from builtins;
import { Callee, Equal, IsEmpty, IsNonempty, Len, LogicalNot } from "../builtin_table.aipl";
import { Call, Expr, descendants_of_kind } from "../expr.aipl";
import { Function } from "../item.aipl";
import { operand_text } from "./expr_text.aipl";
import {
    Advice,
    UnfilledHit,
    advice,
    hit_at,
    lint_function_unfilled,
    shown,
} from "./lint_hit.aipl";
import { is_zero } from "./slice_bounds.aipl";

# The advice for the call `self`, when it is a negated `is_nonempty` or a length compared with zero for
# equality.
pub fn is_empty_longhand(self: Call(_, args, _, callee)) -> Advice? {
    let receiver = if (args.len() == 1) {
        args.negated_nonempty(callee)?
    } else {
        args.length_equal_zero(callee)?
    };
    some(
        receiver
            .operand_text()
            .map(|text| advice(IsEmpty, `emptiness asked the long way — use "{text}.`, `()"`))
            .value_or(advice(
                IsEmpty,
                `emptiness asked the long way — use "`,
                `" on the receiver`,
            )),
    )
}.test({
    // The hits for each function's calls.
    fn flagged(Function { body }) -> UnfilledHit[] {
        body
            .descendants_of_kind::<Call>()
            .map(|call: Expr<Call>| { call.hit_at(call.kind.is_empty_longhand()) })
            .collect_ok()
    }

    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { x.len() == 0 && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "x.Builtin(IsEmpty)()"`]);
    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { 0 == x.len() && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "x.Builtin(IsEmpty)()"`]);

    // A call as the receiver is written out, a form with no text is a placeholder, and a missing import is named.
    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { f(x).len() == 0 && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "f(x).Builtin(IsEmpty)()"`]);
    assert(lint_function_unfilled(
        "fn f(a: i64[], b: i64[], c: bool) -> bool { (if (c) { a } else { b }).len() == 0 && a.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "Builtin(IsEmpty)" on the receiver`]);

    // The names the file gives the builtins do not matter.

    // `!= 0`, another number, an operator that is not the builtin one, and a `len` of the
    // file's own are not this.
    assert(
        lint_function_unfilled(
            "fn f(x: i64[]) -> bool { x.len() != 0 && x.len() == 1 && x.is_empty() }",
            flagged,
        )?.is_empty(),
    );

    // The free-call spelling of `len` is the same AST, so it is the same hit.
    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { len(x) == 0 && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "x.Builtin(IsEmpty)()"`]);

    // A `len` of the file's own is a different function answering a different question, and
    // `is_empty` does not even accept what it takes, so advising it would advise code that does not
    // compile. (A file cannot both define `len` and import the builtin one.)
    assert(
        lint_function_unfilled(
            """
                import { equal as == } from builtins;
                variant List = Nil | Cons(i64)
                fn len(self: List) -> i64 { match (self) { Nil => 0, Cons(..) => 1 } }
                fn is_nil(xs: List) -> bool { xs.len() == 0 }
            """,
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            """
                import { equal as == } from builtins;
                variant List = Nil | Cons(i64)
                fn len(self: List) -> i64 { match (self) { Nil => 0, Cons(..) => 1 } }
                fn is_nil(xs: List) -> bool { xs.len() == 0 }
            """,
            flagged,
        )?.is_empty(),
    );
    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { !x.is_nonempty() && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "x.Builtin(IsEmpty)()"`]);
    assert(lint_function_unfilled("fn f(x: i64[]) -> bool { x.len() == 0 }", flagged)?.shown() == [
        `emptiness asked the long way — use "x.Builtin(IsEmpty)()"`,
    ]);
    assert(
        lint_function_unfilled(
            """
                import { equal as == } from builtins;
                variant List = Nil | Cons(i64)
                fn len(self: List) -> i64 { match (self) { Nil => 0, Cons(..) => 1 } }
                fn is_nil(xs: List) -> bool { xs.len() == 0 }
            """,
            flagged,
        )?.is_empty(),
    );
    assert(lint_function_unfilled(
        "fn f(x: i64[]) -> bool { !x.is_nonempty() && x.is_empty() }",
        flagged,
    )?.shown() == [`emptiness asked the long way — use "x.Builtin(IsEmpty)()"`]);
    assert(lint_function_unfilled("fn f(x: i64[]) -> bool { x.len() == 0 }", flagged)?.shown() == [
        `emptiness asked the long way — use "x.Builtin(IsEmpty)()"`,
    ]);
})

# The receiver of the test the one argument `self` negates, when `callee` is `!` and it is
# `!x.is_nonempty()`.
fn negated_nonempty(self: Expr[], callee: Callee) -> Expr? {
    if (callee != LogicalNot) { return none; };
    let Call(_, args, _, inner) = self[0]?.kind.as_case::<Call>()?;
    if (args.len() != 1 || inner != IsNonempty) { return none; };
    args[0]
}

# The receiver of the length that the two arguments `self` compare with zero for equality, when
# `callee` is `==`.
fn length_equal_zero(self: Expr[], callee: Callee) -> Expr? {
    if (callee != Equal) { return none; };
    let [left, right] = self else { return none; };
    if (right.is_zero()) { return left.length_receiver(); };
    if (left.is_zero()) { return right.length_receiver(); };
    none
}

# The receiver of the call `self` when it is a call of `len`, however it was spelled: `x.len()` is the
# free call `len(x)`.
fn length_receiver(self: Expr) -> Expr? {
    let Call(_, args, _, callee) = self.kind.as_case::<Call>()?;
    if (callee != Len || args.len() != 1) { return none; };
    args[0]
}
