# The `compound_assign` lint: `set x = x + e;` — an accumulate written the long way; `set x += e;` is the
# form for it, and likewise `-=`, `*=`, `/=`.
#
# For the commutative operators either operand order counts (`x * k` and `k * x` both scale `x`), but
# `-` and `/` are flagged only with the receiver on the left: `set x = k - x;` is not `set x -= k;`, and
# rewriting it that way would silently change the program.
#
# The target may be a name or a field path off one (`set p.n = p.n + 1;` is `set p.n += 1;`): every `set`
# form takes either, and a path's text spells it, so the advice can quote it as written.
#
# `step_by_one` has the more specific advice for `set x = x ± 1;` — `set x++;` / `set x--;` — wherever it
# has advice for the operator, so this lint leaves that shape to it rather than offering a second
# rewrite of the same line. Where it has none (no step flavor matches this file's operator), `±= 1` is the
# only advice left and this lint gives it.
#
# The compound form advised is the one of the operator's own flavor (`wrapping_add` has
# `wrapping_add_assign`), and one the file already binds to something else is not offered. The advice names the import to add when the file lacks it, since no
# compound operator has a bare form.
#
# The hit points at the `set` statement.

import {
    collect_ok,
    contains,
    equal as ==,
    is_empty,
    logical_and as &&,
    logical_not as !,
    map,
} from builtins;
import {
    Callee,
    SaturatingAdd,
    SaturatingAddAssign,
    SaturatingDivide,
    SaturatingDivideAssign,
    SaturatingSub,
    SaturatingSubAssign,
    WrappingAdd,
    WrappingAddAssign,
    WrappingMul,
    WrappingMulAssign,
    WrappingSub,
    WrappingSubAssign,
} from "../builtin_table.aipl";
import { Assign, Call, Expr, Num, descendants_of_kind } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Item } from "../item.aipl";
import {
    Advice,
    Named,
    UnfilledHit,
    hit_at,
    lint_in_unfilled,
    lint_in_unfilled_messages,
    shown,
    spans_its_text,
} from "./lint_hit.aipl";
import { is_same_place } from "./places.aipl";
import { Builtin } from "./spelling.aipl";
import { stepped_operators } from "./step_by_one.aipl";

# The compound builtin the operator builtin `self` is advised to become, and whether it reads in
# either operand order.
fn compound_of(self: Callee) -> Compound? {
    match (self) {
        WrappingAdd => some(Compound { builtin: WrappingAddAssign, commutative: true }),
        SaturatingAdd => some(Compound { builtin: SaturatingAddAssign, commutative: true }),
        WrappingSub => some(Compound { builtin: WrappingSubAssign, commutative: false }),
        SaturatingSub => some(Compound { builtin: SaturatingSubAssign, commutative: false }),
        WrappingMul => some(Compound { builtin: WrappingMulAssign, commutative: true }),
        SaturatingDivide => some(Compound { builtin: SaturatingDivideAssign, commutative: false }),
        _ => none,
    }
}

struct Compound { builtin: Callee, commutative: bool }

# The hit for `self`, when it is a `set` of a place to itself combined with something. `stepped` are
# the operators, by the builtin they are, whose `± 1` the step lint has advice for.
pub fn compound_assign(self: Assign(target, value, _), stepped: Callee[]) -> Advice? {
    if (!target.spans_its_text()) { return none; };
    // An operator use is a call of the builtin, whatever the file calls it.
    let Call(_, [left, right], _, callee) = value.kind else { return none; };
    let Compound { builtin, commutative } = callee.compound_of()?;

    // The receiver on the left works for every operator; on the right only where the operation is
    // commutative, since `k - x` and `k / x` are not accumulations of `x` at all.
    let operand = if (left.is_same_place(target)) {
        right
    } else if (right.is_same_place(target) && commutative) {
        left
    } else {
        return none;
    };
    // `set x = x ± 1;` is the step lint's when that lint can fire here.
    if (operand.kind == Num(1) && stepped.contains(callee)) { return none; };
    let name = target.source;
    some(Advice {
        named: [
            Named {
                text: `"{name}" accumulates onto itself — use the compound form "set {name} `,
                builtin: Builtin(builtin),
            },
        ],
        tail: ` ...;"`,
    })
}.test({
    // The hits for each function's `set`s.
    fn flagged(Function { body }, items: Item[]) -> UnfilledHit[] {
        let stepped = items.stepped_operators();
        body
            .descendants_of_kind::<Assign>()
            .map(|assign: Expr<Assign>| { assign.hit_at(assign.kind.compound_assign(stepped)) })
            .collect_ok()
    }
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = n + x; n }",
        flagged,
    )?.shown() == [
        `"n" accumulates onto itself — use the compound form "set n Builtin(WrappingAddAssign) ...;"`,
    ]);
    assert(lint_in_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = x * n; n }",
        flagged,
    )?.shown() == [
        `"n" accumulates onto itself — use the compound form "set n Builtin(WrappingMulAssign) ...;"`,
    ]);

    // The import to add is named, in the flavor of the operator written.
    assert(lint_in_unfilled_messages(
        "import { saturating_add as + } from builtins; fn f(mut n: i64, m: i64) { set n = n + m; }",
        flagged,
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `saturating_add_assign as +=` from builtins```,
    ]);

    // `n + 1` is the step lint's wherever it can advise; where it cannot (`++` is the other flavor)
    // the compound form is the only advice left.
    assert(lint_in_unfilled_messages(
        "import { saturating_add as +, wrapping_increment as ++ } from builtins; fn f(mut n: i64) { set n = n + 1; }",
        flagged,
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `saturating_add_assign as +=` from builtins```,
    ]);
    assert(
        lint_in_unfilled_messages(
            "import { wrapping_add as + } from builtins; fn f(mut n: i64) { set n = n + 1; }",
            flagged,
        )?.is_empty(),
    );

    // `k - n` is not an accumulate.
    assert(
        lint_in_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = x - n; n }",
            flagged,
        )?.is_empty(),
    );

    // `n + 1` is the step lint's wherever it has advice, whether or not `++` is imported yet; where
    // it has none (here `++` is another flavor) the compound form is the only advice left.

    // A field path is a target like any other, quoted as written, and a fed-from-another-binding
    // store is not an accumulate.
    fn on_field(body: str) -> str[]!ParseFailure {
        lint_in_unfilled_messages(
            `import \{ wrapping_add as +, wrapping_add_assign as += } from builtins; fn f(mut c: Counter, m: i64) \{ {body} }`,
            flagged,
        )
    }
    assert(on_field("set c.n = c.n + 5;")? == [
        `"c.n" accumulates onto itself — use the compound form "set c.n += ...;"`,
    ]);
    assert(on_field("set c.n = m + 5;")? == []);

    // An operator the file binds to a function of its own is not the builtin.
})
