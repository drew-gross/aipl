# The `compound_assign` lint: `set x = x + e;` — an accumulate written the long way; `set x += e;`
# is the
# form for it, and likewise `-=`, `*=`, `/=`.
#
# For the commutative operators either operand order counts (`x * k` and `k * x` both scale `x`),
# but
# `-` and `/` are "compound_assign" only with the receiver on the left: `set x = k - x;` is not `set
# x -= k;`, and
# rewriting it that way would silently change the program.
#
# The target may be a name or a field path off one (`set p.n = p.n + 1;` is `set p.n += 1;`): every
# `set`
# form takes either, and a path's text spells it, so the advice can quote it as written.
#
# `set x = x ± 1;` is also `step_by_one`'s, which has the more specific advice; `lint()` keeps that
# one and drops this lint's hit for the same `set`, where the step lint has advice for the file.
#
# The compound form advised is the one of the operator's own flavor (`wrapping_add` has
# `wrapping_add_assign`), and one the file already binds to something else is not offered. The
# advice names the import to add when the file lacks it, since no
# compound operator has a bare form.
#
# The hit points at the `set` statement.

import { equal as ==, is_empty, logical_and as &&, logical_not as ! } from builtins;
import {
    Callee,
    SaturatingAdd,
    SaturatingAddAssign,
    SaturatingDivide,
    SaturatingDivideAssign,
    SaturatingSub,
    SaturatingSubAssign,
    WrappingAdd,
    WrappingAddAssign,
    WrappingMul,
    WrappingMulAssign,
    WrappingSub,
    WrappingSubAssign,
} from "../builtin_table.aipl";
import { Assign, Call } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { lint_with_filled_messages, lint_with_unfilled } from "./lint.aipl";
import { LintHit, Named, shown } from "./lint_hit.aipl";
import { is_same_place, place_text } from "./places.aipl";
import { Builtin } from "./spelling.aipl";

# The compound builtin the operator builtin `self` is advised to become, and whether it reads in
# either operand order.
fn compound_of(self: Callee) -> Compound? {
    match (self) {
        WrappingAdd => some(Compound { builtin: WrappingAddAssign, commutative: true }),
        SaturatingAdd => some(Compound { builtin: SaturatingAddAssign, commutative: true }),
        WrappingSub => some(Compound { builtin: WrappingSubAssign, commutative: false }),
        SaturatingSub => some(Compound { builtin: SaturatingSubAssign, commutative: false }),
        WrappingMul => some(Compound { builtin: WrappingMulAssign, commutative: true }),
        SaturatingDivide => some(Compound { builtin: SaturatingDivideAssign, commutative: false }),
        _ => none,
    }
}

struct Compound { builtin: Callee, commutative: bool }

# The hit for `self`, when it is a `set` of a place to itself combined with something.
pub fn compound_assign(self: Assign(target, value, _)) -> LintHit? {
    let name = target.place_text()?;
    // An operator use is a call of the builtin, whatever the file calls it.
    let Call(_, [left, right], _, callee) = value.kind else { return none; };
    let Compound { builtin, commutative } = callee.compound_of()?;

    // The receiver on the left works for every operator; on the right only where the operation is
    // commutative, since `k - x` and `k / x` are not accumulations of `x` at all.
    if (!left.is_same_place(target) && !(right.is_same_place(target) && commutative)) {
        return none;
    };
    some(LintHit {
        named: [
            Named {
                text: `"{name}" accumulates onto itself — use the compound form "set {name} `,
                builtin: Builtin(builtin),
            },
        ],
        tail: ` ...;"`,
    })
}.test({
    assert(lint_with_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = n + x; n }",
        "compound_assign",
    )?.shown() == [
        `"n" accumulates onto itself — use the compound form "set n Builtin(WrappingAddAssign) ...;"`,
    ]);
    assert(lint_with_unfilled(
        "fn f(x: i64) -> i64 { mut n = x; set n = x * n; n }",
        "compound_assign",
    )?.shown() == [
        `"n" accumulates onto itself — use the compound form "set n Builtin(WrappingMulAssign) ...;"`,
    ]);

    // The import to add is named, in the flavor of the operator written.
    assert(lint_with_filled_messages(
        "import { saturating_add as + } from builtins; fn f(mut n: i64, m: i64) { set n = n + m; }",
        "compound_assign",
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `saturating_add_assign as +=` from builtins```,
    ]);

    // `k - n` is not an accumulate.
    assert(
        lint_with_unfilled(
            "fn f(x: i64) -> i64 { mut n = x; set n = x - n; n }",
            "compound_assign",
        )?.is_empty(),
    );

    // A field path is a target like any other, quoted as written, and a fed-from-another-binding
    // store is not an accumulate.
    fn on_field(body: str) -> str[]!ParseFailure {
        lint_with_filled_messages(
            `import \{ wrapping_add as +, wrapping_add_assign as += } from builtins; fn f(mut c: Counter, m: i64) \{ {body} }`,
            "compound_assign",
        )
    }
    assert(on_field("set c.n = c.n + 5;")? == [
        `"c.n" accumulates onto itself — use the compound form "set c.n += ...;"`,
    ]);
    assert(on_field("set c.n = m + 5;")?.is_empty());

    // An operator the file binds to a function of its own is not the builtin.
})
