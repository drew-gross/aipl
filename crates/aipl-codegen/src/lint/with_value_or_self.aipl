# The `with_value_or_self` lint:
#
#     xs.with(i, v).value_or(xs)
#
# — a replacement that falls back to the array it was replacing in. That is
# `xs.try_set(i, v)`, which says it directly: a write past the end does nothing.
#
# The longhand also reads `xs` twice, and the first read is the one that wants to be a
# move: `with` writes into an array nobody else holds, and the fallback is someone else
# holding it. So it can never write in place; `try_set` can.
#
# Only when the fallback is the *same place* as the receiver — a binding, or a field path
# off one. A different array (`xs.with(i, v).value_or(ys)`), or an empty one
# (`.value_or([])`, for an index known to be in range), says something else and is left
# alone. A function of the file's own named `with` or `value_or` is not the one this lint
# knows the meaning of, so both have to be imported from builtins; `try_set` only decides
# whether the advice names an import too.
#
# The hit points at the fallback.

import {
    collect_ok,
    equal as ==,
    is_empty,
    logical_and as &&,
    logical_not as !,
    not_equal as !=,
    value_or,
} from builtins;
import { TrySet, ValueOr, With } from "../builtin_table.aipl";
import { Call, Expr, Field, Ident, descendants_of_kind } from "../expr.aipl";
import { Function } from "../item.aipl";
import { operand_text } from "./expr_text.aipl";
import { LintHit, Named, lint_function_unfilled, shown } from "./lint_hit.aipl";
import { Builtin } from "./spelling.aipl";

# The hit for `self`, when it is a `with(..)` the call falls back from to the array it replaces in.
pub fn with_value_or_self(self: Call(_, arguments, _, callee)) -> LintHit? {
    if (callee != ValueOr) { return none; };
    let [replaced, fallback] = arguments else { return none; };
    let Call(_, [receiver, _, _], _, With) = replaced.kind else { return none; };
    if (!receiver.same_place(fallback)) { return none; };
    some(LintHit {
        named: [
            Named { text: "this `", builtin: Builtin(ValueOr) },
            Named {
                text: `\` falls back to the array it is replacing in — write "{receiver.operand_text().value_or("<array>")}.`,
                builtin: Builtin(TrySet),
            },
        ],
        tail: `(..)" and drop the fallback`,
        span: fallback.span,
    })
}.test({
    // The hits for each function's calls.
    fn flagged(Function { body }) -> LintHit[] {
        body.descendants_of_kind::<Call>()$kind$with_value_or_self().collect_ok()
    }

    // What the lint says of a replacement in `array`.

    // A binding and a field path off one are the same place as themselves, in either call form.
    assert(lint_function_unfilled("fn f() { xs.with(0, 1).value_or(xs) }", flagged)?.shown() == [
        """this `Builtin(ValueOr)` falls back to the array it is replacing in — write "xs.Builtin(TrySet)(..)" and drop the fallback""",
    ]);
    assert(lint_function_unfilled(
        "fn f() { p.rows.with(0, 1).value_or(p.rows) }",
        flagged,
    )?.shown() == [
        """this `Builtin(ValueOr)` falls back to the array it is replacing in — write "p.rows.Builtin(TrySet)(..)" and drop the fallback""",
    ]);
    assert(lint_function_unfilled("fn f() { value_or(with(xs, 2, 5), xs) }", flagged)?.shown() == [
        """this `Builtin(ValueOr)` falls back to the array it is replacing in — write "xs.Builtin(TrySet)(..)" and drop the fallback""",
    ]);

    // Not the shape: another array, an empty one, a different field, a computed fallback, `with`
    // on its own, and `value_or` on something else.
    assert(lint_function_unfilled("fn f() { xs.with(0, 1).value_or(ys) }", flagged)?.is_empty());
    assert(lint_function_unfilled("fn f() { xs.with(0, 1).value_or([]) }", flagged)?.is_empty());
    assert(
        lint_function_unfilled(
            "fn f() { p.rows.with(0, 1).value_or(p.cols) }",
            flagged,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled("fn f() { xs.with(0, 9).value_or(xs[..1]) }", flagged)?.is_empty(),
    );
    assert(lint_function_unfilled("fn f() { xs.with(0, 9) }", flagged)?.is_empty());
    assert(lint_function_unfilled("fn f() { o.value_or(xs) }", flagged)?.is_empty());
})

# Whether `self` and `other` read the same binding, or the same field path off one.
fn same_place(self: Expr, other: Expr) -> bool {
    if (let Ident(name, _) = self.kind) {
        return if (let Ident(other_name, _) = other.kind) { name == other_name } else { false };
    };
    let Field(base, field) = self.kind else { return false; };
    if (let Field(other_base, other_field) = other.kind) {
        return field == other_field && base.same_place(other_base);
    };
    false
}
