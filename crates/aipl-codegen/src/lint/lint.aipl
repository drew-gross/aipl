# Every lint of one function, under the name of its file, in the order its hits are reported. A lint
# of one kind of node is run over each node of that kind in a function's body; one that finds at
# most one hit is written `[..hit]` to say so.
pub fn all_lints() -> Lint[] {
    [
        Lint { name: "destructure", run: OfFunction(destructure) },
        Lint { name: "unused_binding", run: OfFunction(unused_binding) },
        Lint {
            name: "fn_body_type_stutter",
            run: OfFunction(|function| [..fn_body_type_stutter(function)]),
        },
        Lint { name: "match_bool_is_case", run: OfMatch(|m| [..match_bool_is_case(m)]) },
        Lint { name: "match_is_some_and", run: OfMatch(|m| [..match_is_some_and(m)]) },
        Lint { name: "match_value_or", run: OfMatch(|m| [..match_value_or(m)]) },
        Lint {
            name: "match_value_or_err",
            run: OfMatchIn(|m, function| [..match_value_or_err(m, function)]),
        },
        Lint { name: "match_map_value_or", run: OfMatch(|m| [..match_map_value_or(m)]) },
        Lint { name: "match_map_err", run: OfMatch(|m| [..match_map_err(m)]) },
        Lint { name: "match_map_ok", run: OfMatch(|m| [..match_map_ok(m)]) },
        Lint { name: "match_case_as_case", run: OfMatch(|m| [..match_case_as_case(m)]) },
        Lint {
            name: "match_case_try_as_case",
            run: OfTailMatches(|tail| [..match_case_try_as_case(tail)]),
        },
        Lint { name: "let_else_as_case", run: OfTailMatches(|tail| [..let_else_as_case(tail)]) },
        Lint { name: "let_else_only", run: OfTailMatches(|tail| [..let_else_only(tail)]) },
        Lint { name: "match_only", run: OfMatch(|m| [..match_only(m)]) },
        Lint { name: "push_loop_pipeline", run: OfLetMut(|seed| [..push_loop_pipeline(seed)]) },
        Lint { name: "push_loop_collect_ok", run: OfLetMut(|seed| [..push_loop_collect_ok(seed)]) },
        Lint { name: "extend_loop_map_join", run: OfFunction(extend_loop_map_join) },
        Lint { name: "union_loop_union_all", run: OfFunction(union_loop_union_all) },
        Lint { name: "push_array_literal", run: OfFunction(push_array_literal) },
        Lint { name: "return_loop_find_if", run: OfFunction(return_loop_find_if) },
        Lint { name: "return_loop_any_all", run: OfFunction(return_loop_any_all) },
        Lint { name: "identity_lambda", run: OfFunction(identity_lambda) },
        Lint { name: "use_field_projection", run: OfFunction(use_field_projection) },
        Lint { name: "push_loop_zip_with", run: OfFunction(push_loop_zip_with) },
        Lint { name: "assert_some_equal", run: OfFunction(assert_some_equal) },
        Lint { name: "return_loop_find_index", run: OfFunction(return_loop_find_index) },
        Lint { name: "interp_to_str", run: OfInterpolation(|i| [..interp_to_str(i)]) },
        Lint { name: "interp_literal", run: OfInterpolation(|i| [..interp_literal(i)]) },
        Lint { name: "redundant_slice_bound", run: OfSlice(|s| [..redundant_slice_bound(s)]) },
        Lint { name: "char_set_literal", run: OfSetLitNode(|node| [..char_set_literal(node)]) },
        Lint { name: "arm_block_value", run: OfMatchNode(arm_block_value) },
        Lint { name: "field_init_shorthand", run: OfConstruct(field_init_shorthand) },
        Lint { name: "set_spread_field", run: OfAssign(|a| [..set_spread_field(a)]) },
        Lint { name: "set_spread_insert", run: OfAssign(|a| [..set_spread_insert(a)]) },
        Lint { name: "set_spread_push", run: OfAssign(|a| [..set_spread_push(a)]) },
        Lint { name: "step_by_one", run: OfAssign(|a| [..step_by_one(a)]) },
        Lint { name: "compound_assign", run: OfAssign(|a| [..compound_assign(a)]) },
        Lint { name: "value_or_compare", run: OfCall(|call| [..value_or_compare(call)]) },
        Lint { name: "map_constant_repeat", run: OfCall(|call| [..map_constant_repeat(call)]) },
        Lint { name: "map_find_if_some", run: OfCall(|call| [..map_find_if_some(call)]) },
        Lint { name: "with_value_or_self", run: OfCall(|call| [..with_value_or_self(call)]) },
        Lint { name: "case_of_equal_is_case", run: OfCall(|call| [..case_of_equal_is_case(call)]) },
        Lint { name: "len_gt_zero", run: OfCall(|call| [..len_gt_zero(call)]) },
        Lint { name: "is_empty_longhand", run: OfCall(|call| [..is_empty_longhand(call)]) },
        Lint { name: "compare_empty_array", run: OfCall(|call| [..compare_empty_array(call)]) },
    ]
}

# The lints named `names`, or the first name no lint has.
fn lints_named(names: str[]) -> Lint[]!ParseFailure {
    let registry = all_lints();
    let known = registry$name;
    if (let some(missing) = names.find_if(|name| !known.contains(name))) {
        return err(ParseFailure {
            errors: [ParseError { message: `no lint is named "{missing}"`, span: 0..0 }],
        });
    };
    ok(registry.filter(|lint| names.contains(lint.name)))
}

# What the lints named `names` say of the program `src` parses to, as they say it, before any file's
# imports decide how they are written. Every builtin counts as imported, so a lint's own tests are
# about the shape it finds and nothing about imports, or about any other lint.
pub fn lint_with_unfilled(
    # The program's source.
    src: str,
    # The lints to run, by their registered names.
    names: str*,
) -> LintHit[]!ParseFailure { lint_lints_unfilled(src, lints_named(names)?) }

# [`lint_with_unfilled`], shown as messages.
pub fn lint_with_messages(src: str, names: str*) -> str[]!ParseFailure {
    ok(lint_with_unfilled(src, names)?.shown())
}

# What the lints named `names` report for the program `src` parses to, filled in for the imports
# `src` has.
pub fn lint_with_filled_messages(
    # The program's source.
    src: str,
    # The lints to run, by their registered names.
    names: str*,
) -> str[]!ParseFailure { lint_lints_filled_messages(src, lints_named(names)?) }

# `self` less the hits at a place `others` has a hit at.
fn not_at(self: FilledHit[], others: FilledHit[]) -> FilledHit[] {
    let places = others$span;
    self.filter(|hit| !places.contains(hit.span))
}.test({
    assert([hit("a", 1..2), hit("b", 3..4)].not_at([hit("c", 3..4)]) == [hit("a", 1..2)]);
})

# Every hit the ported lints find in `program`.
#
# A lint is either a function of the whole program or of one function. The program's functions
# are listed once, and each function lint is run over them: every body that is code.
pub fn lint(program: ResolvedProgram) -> FilledHit[] {
    let items = program.items;
    let functions = program.functions();
    let registry = all_lints();
    let step = registry.filter(|lint| lint.name == "step_by_one");
    let compound = registry.filter(|lint| lint.name == "compound_assign");
    let ordinary = registry.filter(
        |lint| lint.name != "step_by_one" && lint.name != "compound_assign",
    );
    let others = [
        ..unused_imports(program),
        ..unused_functions(program),
        ..duplicate_import_source(program),
        ..functions.unfilled_hits_of(ordinary),
    ].filled(items);
    let steps = functions.unfilled_hits_of(step).filled(items);
    let compounds = functions.unfilled_hits_of(compound).filled(items).not_at(steps);
    [..others, ..steps, ..compounds]
}.test({
    assert(lint(SuperProgram { items: [], doc: none }.resolve_callees()).is_empty());
})

# The messages every lint reports for the program `src` parses to, which is how a lint's own tests
# read what it says: they run all the lints, so a snippet must be one no other lint objects to.
pub fn lint_str(src: str) -> str[]!ParseFailure {
    ok(lint(aipl_parse_surface_file(src)?.program.hoist_test_fns().resolve_callees())$message)
}.test({
    assert(lint_str("fn main() { }")?.is_empty());

    // `set n = n + 1;` has two pieces of advice, and the step form is the better where the file can
    // take it: the compound lint's hit for the same `set` is dropped.
    assert(lint_str(
        "import { wrapping_add as + } from builtins; fn f(mut n: i64) { set n = n + 1; }",
    )? == [
        """adding 1 to "n" — use the increment form "set n++;", importing `wrapping_increment as ++` from builtins""",
    ]);

    // Where it cannot (`++` is the other flavor) the compound form is the only advice left, and
    // it is not left out for a step lint that has nothing to say.
    assert(lint_str(
        "import { saturating_add as +, wrapping_increment as ++ } from builtins; fn f(mut n: i64) { set n = n + 1; set n++; }",
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `saturating_add_assign as +=` from builtins```,
    ]);
    // An operand other than one is not a step at all.
    assert(lint_str(
        "import { wrapping_add as + } from builtins; fn f(mut n: i64, m: i64) { set n = n + m; }",
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `wrapping_add_assign as +=` from builtins```,
    ]);
})
