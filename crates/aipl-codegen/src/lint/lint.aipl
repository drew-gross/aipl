# The lints, run over a parsed file.
#
# `squelch` is applied to what these return: it drops the hits an `#[allow]` marker
# covers and says how to keep the rest. A lint is added by giving it its own file and
# a line in `lint`; the hits come back in the order the lints are listed.

import {
    any,
    collect_ok,
    equal as ==,
    filter,
    is_empty,
    join,
    logical_not as !,
    map,
} from builtins;
import {
    Assign,
    Call,
    Construct,
    Expr,
    Interpolation,
    LetMut,
    Match,
    SetLit,
    Slice,
    descendants_of_kind,
} from "../expr.aipl";
import { ParseFailure, aipl_parse_surface_file } from "../grammar_aipl.aipl";
import { hoist_test_fns } from "../hoist_test_fns.aipl";
import { Function, SuperProgram } from "../item.aipl";
import { ResolvedProgram, resolve_callees } from "../resolve_callees.aipl";
import { arm_block_value } from "./arm_block_value.aipl";
import { case_of_equal_is_case } from "./case_of_equal_is_case.aipl";
import { char_set_literal } from "./char_set_literal.aipl";
import { compare_empty_array } from "./compare_empty_array.aipl";
import { compound_assign } from "./compound_assign.aipl";
import { destructure } from "./destructure.aipl";
import { duplicate_import_source } from "./duplicate_import_source.aipl";
import { extend_loop_map_join } from "./extend_loop_map_join.aipl";
import { field_init_shorthand } from "./field_init_shorthand.aipl";
import { fn_body_type_stutter } from "./fn_body_type_stutter.aipl";
import { identity_lambda } from "./identity_lambda.aipl";
import { interp_literal } from "./interp_literal.aipl";
import { interp_to_str } from "./interp_to_str.aipl";
import { is_empty_longhand } from "./is_empty_longhand.aipl";
import { len_gt_zero } from "./len_gt_zero.aipl";
import { let_else_as_case } from "./let_else_as_case.aipl";
import { FilledHit, LintHit, filled, functions, hit_at, unfilled_hits } from "./lint_hit.aipl";
import { map_constant_repeat } from "./map_constant_repeat.aipl";
import { map_find_if_some } from "./map_find_if_some.aipl";
import { match_bool_is_case } from "./match_bool_is_case.aipl";
import { match_case_as_case } from "./match_case_as_case.aipl";
import { match_case_try_as_case } from "./match_case_try_as_case.aipl";
import { match_is_some_and } from "./match_is_some_and.aipl";
import { match_map_err } from "./match_map_err.aipl";
import { match_map_ok } from "./match_map_ok.aipl";
import { match_map_value_or } from "./match_map_value_or.aipl";
import { match_value_or } from "./match_value_or.aipl";
import { match_value_or_err } from "./match_value_or_err.aipl";
import { push_array_literal } from "./push_array_literal.aipl";
import { push_loop_collect_ok } from "./push_loop_collect_ok.aipl";
import { push_loop_pipeline } from "./push_loop_pipeline.aipl";
import { push_loop_zip_with } from "./push_loop_zip_with.aipl";
import { redundant_slice_bound } from "./redundant_slice_bound.aipl";
import { return_loop_any_all } from "./return_loop_any_all.aipl";
import { return_loop_find_if } from "./return_loop_find_if.aipl";
import { return_loop_find_index } from "./return_loop_find_index.aipl";
import { set_spread_field } from "./set_spread_field.aipl";
import { set_spread_insert } from "./set_spread_insert.aipl";
import { set_spread_push } from "./set_spread_push.aipl";
import { step_by_one } from "./step_by_one.aipl";
import { union_loop_union_all } from "./union_loop_union_all.aipl";
import { unused_binding } from "./unused_binding.aipl";
import { unused_functions } from "./unused_functions.aipl";
import { unused_imports } from "./unused_imports.aipl";
import { use_field_projection } from "./use_field_projection.aipl";
import { value_or_compare } from "./value_or_compare.aipl";
import { with_value_or_self } from "./with_value_or_self.aipl";
import { zip_with_pair_zip } from "./zip_with_pair_zip.aipl";

# Every hit the ported lints find in `program`.
#
# A lint is either a function of the whole program or of one function. The program's functions
# are listed once, and each function lint is run over them: every body that is code. One that
# also needs the file's imports takes the program's `items` beside the function.
pub fn lint(program: ResolvedProgram) -> FilledHit[] {
    let items = program.items;
    let functions = program.functions();
    let others = [
        ..unused_imports(program),
        ..unused_functions(program),
        ..duplicate_import_source(program),
        ..functions.unfilled_hits(destructure),
        ..functions.unfilled_hits(unused_binding),
        ..functions.unfilled_hits(fn_body_type_stutter),
        ..functions.unfilled_hits(match_lints),
        ..functions.unfilled_hits(match_case_try_as_case),
        ..functions.unfilled_hits(let_else_as_case),
        ..functions.unfilled_hits(let_mut_lints),
        ..functions.unfilled_hits(extend_loop_map_join),
        ..functions.unfilled_hits(union_loop_union_all),
        ..functions.unfilled_hits(push_array_literal),
        ..functions.unfilled_hits(return_loop_find_if),
        ..functions.unfilled_hits(return_loop_any_all),
        ..functions.unfilled_hits(identity_lambda),
        ..functions.unfilled_hits(use_field_projection),
        ..functions.unfilled_hits(push_loop_zip_with),
        ..functions.unfilled_hits(return_loop_find_index),
        ..functions.unfilled_hits(interp_lints),
        ..functions.unfilled_hits(slice_lints),
        ..functions.unfilled_hits(set_lints),
        ..functions.unfilled_hits(match_hits),
        ..functions.unfilled_hits(construct_lints),
        ..functions.unfilled_hits(assign_lints),
        ..functions.unfilled_hits(assign_advice),
        ..functions.unfilled_hits(call_lints),
        ..functions.unfilled_hits(call_advice),
    ].filled(items);

    // `set x = x + 1;` is `set x++;` where the file can take the step form, and `set x += 1;` where it cannot:
    // the compound lint's hit for a `set` the step lint has advice for is the worse of the two.
    let steps = functions.unfilled_hits(step_hits).filled(items);
    let compounds = functions
        .unfilled_hits(compound_hits)
        .filled(items)
        .filter(|hit| !steps.any(|step| step.span == hit.span));
    [..others, ..steps, ..compounds]
}.test({
    assert(lint(SuperProgram { items: [], doc: none }.resolve_callees()).is_empty());
})

# The lints over the `match`es of `function` that are not about what they say.
fn match_hits(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<Match>()$arm_block_value().join()
}

# The lints over the set literals of `function`, which are found once for all of them.
fn set_lints(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<SetLit>()$char_set_literal().collect_ok()
}

# The lints over the template interpolations of `function`, which are found once for all of them.
fn interp_lints(Function { body }) -> LintHit[] {
    let interpolations = body.descendants_of_kind::<Interpolation>();
    [
        ..interpolations.map(|node: Expr<Interpolation>| {
            node.hit_at(node.kind.interp_to_str())
        }),
        ..interpolations.map(|node: Expr<Interpolation>| {
            node.hit_at(node.kind.interp_literal())
        }),
    ].collect_ok()
}

# The lints over the slices of `function`, which are found once for all of them.
fn slice_lints(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<Slice>()$kind$redundant_slice_bound().collect_ok()
}

# The lints over the struct literals of `function`, which are found once for all of them.
fn construct_lints(Function { body }) -> LintHit[] {
    let constructs = body.descendants_of_kind::<Construct>();
    constructs$kind$field_init_shorthand().join()
}

# The lints over the calls of `function`, which are found once for all of them.
fn call_lints(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<Call>()$kind$value_or_compare().collect_ok()
}

# The lints over the calls of `function` that advise a builtin.
fn call_advice(Function { body }) -> LintHit[] {
    let calls = body.descendants_of_kind::<Call>();
    [
        ..calls$kind$map_constant_repeat(),
        ..calls.map(|call: Expr<Call>| { call.hit_at(call.kind.map_find_if_some()) }),
        ..calls$kind$zip_with_pair_zip(),
        ..calls$kind$with_value_or_self(),
        ..calls.map(|call: Expr<Call>| { call.hit_at(case_of_equal_is_case(call.kind)) }),
        ..calls.map(|call: Expr<Call>| { call.hit_at(len_gt_zero(call.kind)) }),
        ..calls.map(|call: Expr<Call>| { call.hit_at(is_empty_longhand(call.kind)) }),
        ..calls.map(|call: Expr<Call>| { call.hit_at(compare_empty_array(call.kind)) }),
    ].collect_ok()
}

# The lints over the `match`es of `function`, which are found once for all of them. One that is about
# the function it is in takes it as well.
fn match_lints(function: Function) -> LintHit[] {
    let matches = function.body.descendants_of_kind::<Match>()$kind;
    [
        ..matches$match_bool_is_case(),
        ..matches$match_is_some_and(),
        ..matches$match_value_or(),
        ..matches$match_value_or_err(function),
        ..matches$match_map_value_or(),
        ..matches$match_map_err(),
        ..matches$match_map_ok(),
        ..matches$match_case_as_case(),
    ].collect_ok()
}

# The lints over the `mut` bindings of `function`, which are found once for all of them: each is
# about an array or set seeded and then filled by the loop that follows.
fn let_mut_lints(Function { body }) -> LintHit[] {
    let seeds = body.descendants_of_kind::<LetMut>()$kind;
    [..seeds$push_loop_pipeline(), ..seeds$push_loop_collect_ok()].collect_ok()
}

# The lints over the assignments of `function`, which are found once for all of them.
fn assign_lints(Function { body }) -> LintHit[] {
    body.descendants_of_kind::<Assign>()$kind$set_spread_field().collect_ok()
}

# The lints over the assignments of `function` that advise a builtin.
fn assign_advice(Function { body }) -> LintHit[] {
    let assigns = body.descendants_of_kind::<Assign>();
    [..assigns$kind$set_spread_insert(), ..assigns$kind$set_spread_push()].collect_ok()
}

# The step lint's hits for the assignments of `function`.
fn step_hits(Function { body }) -> LintHit[] {
    body
        .descendants_of_kind::<Assign>()
        .map(|assign: Expr<Assign>| { assign.hit_at(assign.kind.step_by_one()) })
        .collect_ok()
}

# The compound lint's hits for the assignments of `function`.
fn compound_hits(Function { body }) -> LintHit[] {
    body
        .descendants_of_kind::<Assign>()
        .map(|assign: Expr<Assign>| { assign.hit_at(assign.kind.compound_assign()) })
        .collect_ok()
}

# The messages every lint reports for the program `src` parses to, which is how a lint's own tests
# read what it says: they run all the lints, so a snippet must be one no other lint objects to.
pub fn lint_str(src: str) -> str[]!ParseFailure {
    ok(lint(aipl_parse_surface_file(src)?.program.hoist_test_fns().resolve_callees())$message)
}.test({
    assert(lint_str("fn main() { }")?.is_empty());

    // `set n = n + 1;` has two pieces of advice, and the step form is the better where the file can
    // take it: the compound lint's hit for the same `set` is dropped.
    assert(lint_str(
        "import { wrapping_add as + } from builtins; fn f(mut n: i64) { set n = n + 1; }",
    )? == [
        """adding 1 to "n" — use the increment form "set n++;", importing `wrapping_increment as ++` from builtins""",
    ]);

    // Where it cannot (`++` is the other flavor) the compound form is the only advice left, and
    // it is not left out for a step lint that has nothing to say.
    assert(lint_str(
        "import { saturating_add as +, wrapping_increment as ++ } from builtins; fn f(mut n: i64) { set n = n + 1; set n++; }",
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `saturating_add_assign as +=` from builtins```,
    ]);
    // An operand other than one is not a step at all.
    assert(lint_str(
        "import { wrapping_add as + } from builtins; fn f(mut n: i64, m: i64) { set n = n + m; }",
    )? == [
        ```"n" accumulates onto itself — use the compound form "set n += ...;", importing `wrapping_add_assign as +=` from builtins```,
    ]);
})
