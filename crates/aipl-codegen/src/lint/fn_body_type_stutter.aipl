# The `fn_body_type_stutter` lint: `fn f() -> T { T { .. } }` — a function whose
# whole body is a literal of its own declared return type, naming that type twice.
# The body-shorthand spelling drops the repetition: `fn f() -> T { .. }`.
#
# Both spellings parse to the same `Construct`, so `Function.shorthand_body` records
# which one was written.
#
# Only a body that is *exactly* the literal qualifies: a block with any statement in
# it parses to a `Let`/`Seq` wrapping the literal, and the shorthand replaces the
# whole body, so those are left alone. A destructured parameter is no statement
# either, which the surface tree this runs on makes true without looking through
# anything.

import {
    equal as ==,
    is_empty,
    logical_or as ||,
    map,
    not_equal as !=,
    starts_with,
    value_or,
} from builtins;
import { Construct, Expr, FieldInit, Ident } from "../expr.aipl";
import { Function } from "../item.aipl";
import { Generic, Named, Ty } from "../ty.aipl";
import { LintHit, hit, lint_function_hits } from "./lint_hit.aipl";

# The hit for a function whose body is a literal of its return type, or none.
pub fn fn_body_type_stutter(Function { name as function, shorthand_body, sig, body }) -> LintHit[] {
    if (shorthand_body) {
        return [];
    };

    // The name the return type offers the literal: a generic return contributes its
    // base, since `Pair<i64>` is built as `Pair { .. }`.
    let some(ret) = sig.return_ty.literal_name() else { return []; };
    let Expr { kind, span, value_span as _, name_span as _ } = body;
    let Construct(name, inits) = kind else { return []; };

    // A construct the parser synthesized from other syntax (a range is
    // `__builtin_Span { .. }`) is not a literal anyone wrote, and its name can't be
    // spelled, so it has no shorter form. `{}` has no shorthand either (it would
    // read as an empty block).
    if (name != ret || name.starts_with("__builtin_") || inits.is_empty()) {
        return [];
    };
    [hit(message(function.text, name, inits.lone_shorthand()), span)]
}.test({
    let found = lint_function_hits(
        "fn f(x: i64) -> P { P { x: x + 1, y: 0 } }",
        fn_body_type_stutter,
    )?;
    assert(found$message == [message("f", "P", none)]);
    assert(found$span == [20..40]);

    // A lone shorthand field spells out the trailing comma.
    assert(lint_function_hits("fn f(x: i64) -> P { P { x } }", fn_body_type_stutter)?$message == [
        message("f", "P", some("x")),
    ]);
    assert(lint_function_hits(
        "fn f(x: i64) -> P { P { x: x + 1 } }",
        fn_body_type_stutter,
    )?$message == [message("f", "P", none)]);

    // A generic return is built under its base name.
    assert(lint_function_hits(
        "fn f(x: i64) -> Pair<i64> { Pair { a: x, b: x } }",
        fn_body_type_stutter,
    )?$message == [message("f", "Pair", none)]);

    // The shorthand body, a literal of another type, a statement before the literal,
    // an empty literal and a field named like the type are all left alone.
    assert(lint_function_hits("fn f(x: i64) -> P { x, y: 0 }", fn_body_type_stutter)? == []);
    assert(lint_function_hits("fn f(x: i64) -> P { Q { x } }", fn_body_type_stutter)? == []);
    assert(
        lint_function_hits(
            "fn f(x: i64) -> P { let y = x; P { x, y } }",
            fn_body_type_stutter,
        )? == [],
    );
    assert(lint_function_hits("fn f() -> P { P {} }", fn_body_type_stutter)? == []);
    assert(lint_function_hits("fn f(P: i64) -> Q { P, y: 0 }", fn_body_type_stutter)? == []);

    // A destructured parameter is not a statement.
    assert(lint_function_hits(
        "fn f(P { x }) -> P { P { x: x + 1 } }",
        fn_body_type_stutter,
    )?$message == [message("f", "P", none)]);

    // A range is a synthesized literal.
    assert(lint_function_hits("fn f(a: i64) -> Span { a..a }", fn_body_type_stutter)? == []);
})

# The type name a return type offers a literal, if it offers one.
fn literal_name(self: Ty?) -> str? {
    match (self) {
        some(Named(name)) => some(name),
        some(Generic(base, _)) => some(base),
        _ => none,
    }
}

# The name of the field when it is the lone *shorthand* one, the case whose
# replacement isn't obvious: `{ x }` reads back as a block whose value is `x`, so the
# trailing comma is load-bearing and the message spells it out.
fn lone_shorthand(self: FieldInit[]) -> str? {
    let [FieldInit { name, value, name_span as _ }] = self else { return none; };
    if (value.kind == Ident(name)) {
        return some(name);
    };
    none
}

# What is said of function `name` whose body is a `type_name` literal.
fn message(name: str, type_name: str, lone: str?) -> str {
    let advice = lone
        .map(
            |field| `write the field directly as the body, "\{ {field}, }" — the trailing comma is what keeps it a struct literal rather than a block`,
        )
        .value_or("write the fields directly as the body");
    `fn "{name}" returns "{type_name}" and its body is a "{type_name}" literal, naming the type twice — {advice}`
}
