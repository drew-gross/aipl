# The `let_else_as_case` lint:
#
#     let Field(base, field) = x else {
#         return none;
#     };
#
# — a variant value taken apart, with `none` as the answer when it is another case. That
# is `let Field(base, field) = x.as_case(Field)?;`, which says the same without the
# block. (A hand-written `if (let K(..) = x) { rest } else { return none; }` lowers to
# the same tree and is the same program.)
#
# It has to be the function's *tail* (see `tail_matches`), where the `?` and the block's
# `return` both leave the function with the same answer, and the `else` has to be
# exactly `return none;`: a block that does anything first, or returns something else,
# is a different program. Only a variant case's constructor pattern is advised — an
# optional's `some(v)` has no `as_case`, and an array or tuple pattern is not a case.
#
# A case with no payload to bind has no pattern of its own to write in a `let` (a bare
# name would be a binding), so it is asked of the value alone: `x.as_case(Empty)?;`.
#
# The hit points at the `return none;` line, a short statement the formatter keeps in
# place, so `#[allow]` squelches it.

import { collect_ok, equal as ==, logical_or as ||, map, not_equal as != } from builtins;
import { IfLet, None, Return, Seq, Unit } from "../expr.aipl";
import { Function } from "../item.aipl";
import { case_pattern, statement_head, tail_matches } from "./case_match.aipl";
import { UnfilledHit, lint_function_unfilled_messages, unfilled } from "./lint_hit.aipl";
import { receiver_text } from "./option_match.aipl";

# A hit for each `let .. else { return none; }` that ends the function and takes a
# variant value apart.
pub fn let_else_as_case(Function { body }) -> UnfilledHit[] {
    body
        .tail_matches()
        .map(
            |tail| {
                let IfLet(arm, scrutinee, otherwise) = tail.kind else { return none; };
                let some(pattern) = arm.pattern.case_pattern() else { return none; };
                // `return none;` and nothing else: the statement, then the block's unit tail.
                let Seq(leave, rest) = otherwise.kind else { return none; };
                let Return(value) = leave.kind else { return none; };
                if (rest.kind != Unit || value.kind != None) { return none; };
                some(unfilled(
                    "as_case",
                    `this \`else\` only gives up with none — write "{pattern.statement_head()}{scrutinee.receiver_text()}.`,
                    `({pattern.case})?;" and drop the block`,
                    leave.span,
                ))
            },
        )
        .collect_ok()
}.test({
    // The value taken apart, with the payload bound by the `let`, and the hit on the
    // `return`.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { let Field(base, field) = x else { return none; }; some(base) }",
        let_else_as_case,
    )? == [message("let Field(base, field) = ", "x", "Field")]);

    // A case with no payload is asked of the value alone.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { let Empty(..) = x else { return none; }; some(1) }",
        let_else_as_case,
    )? == [message("", "x", "Empty")]);

    // A hand-written `if (let ..)` is the same tree.
    assert(lint_function_unfilled_messages(
        "fn f(x: Expr) -> i64? { if (let Field(b, f) = x) { some(b) } else { return none; } }",
        let_else_as_case,
    )? == [message("let Field(b, f) = ", "x", "Field")]);

    // Not the shape: another answer, work before it, an optional's `some`, an array
    // pattern, and a `let` that is not the function's tail.
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> i64? { let Field(b, f) = x else { return some(0); }; some(b) }",
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> i64? { let Field(b, f) = x else { g(); return none; }; some(b) }",
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> i64? { let some(n) = o else { return none; }; some(n) }",
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(xs: i64[]) -> i64? { let [a, ..] = xs else { return none; }; some(a) }",
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(x: Expr) -> i64? { let w = if (let Field(b, f) = x) { b } else { return none; }; some(w) }",
            let_else_as_case,
        )? == [],
    );

    // Shapes the lint must leave alone.
    // The block returns something other than `none`.
    assert(
        lint_function_unfilled_messages(
            """
                fn radius(s: Shape) -> i64 {
                    let Circle(r) = s else { return 0; };
                    r
                }
            """,
            let_else_as_case,
        )? == [],
    );
    // The block does something before it returns.
    assert(
        lint_function_unfilled_messages(
            """
                fn logged(s: Shape) !prints -> i64? {
                    let Circle(r) = s else {
                        print("not a circle");
                        return none;
                    };
                    some(r)
                }
            """,
            let_else_as_case,
        )? == [],
    );
    // An optional's `some` has no `as_case`, and neither has an array pattern.
    assert(
        lint_function_unfilled_messages(
            """
                fn double(o: i64?) -> i64? {
                    let some(n) = o else { return none; };
                    some(n + n)
                }
            """,
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            """
                fn second(xs: i64[]) -> i64? {
                    let [_, b, ..] = xs else { return none; };
                    some(b)
                }
            """,
            let_else_as_case,
        )? == [],
    );

    // Not the function's last act: the `?` would leave the function where the `if let`
    // only chose a value for a binding.
    assert(
        lint_function_unfilled_messages(
            """
                fn width(s: Shape) -> i64? {
                    let w = if (let Rect(a, b) = s) {
                        a + b
                    } else {
                        return none;
                    };
                    some(w)
                }
            """,
            let_else_as_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn show(o: i64?) -> str { `{o}` }",
            let_else_as_case,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // A payload the `let` takes apart.
    assert(lint_function_unfilled_messages(
        """
            fn radius(s: Shape) -> i64? {
                let Circle(r) = s else { return none; };
                some(r * 2)
            }
        """,
        let_else_as_case,
    )? == [
        """this `else` only gives up with none — write "let Circle(r) = s.as_case(Circle)?;" and drop the block, importing `as_case` from builtins""",
    ]);
    // Written as an `if let`, which is the same tree.
    assert(lint_function_unfilled_messages(
        """
            fn width(s: Shape) -> i64? {
                if (let Rect(w, h) = s) {
                    some(w + h)
                } else {
                    return none;
                }
            }
        """,
        let_else_as_case,
    )? == [
        """this `else` only gives up with none — write "let Rect(w, h) = s.as_case(Rect)?;" and drop the block, importing `as_case` from builtins""",
    ]);

    // A case with no payload to bind has no pattern for a `let`, so it is asked of
    // the value alone.
    assert(lint_function_unfilled_messages(
        """
            fn only_empty(s: Shape, n: i64) -> i64? {
                if (let Empty = s) {
                    some(n)
                } else {
                    return none;
                }
            }
        """,
        let_else_as_case,
    )? == [
        """this `else` only gives up with none — write "s.as_case(Empty)?;" and drop the block, importing `as_case` from builtins""",
    ]);
})

# What is said of a tail `let .. else` over `receiver` on `case`, whose statement begins
# `head`, for a file that does not import `as_case`, as the tests' sources do not.
fn message(head: str, receiver: str, case: str) -> str {
    `this \`else\` only gives up with none — write "{head}{receiver}.as_case({case})?;" and drop the block, importing \`as_case\` from builtins`
}
