# The `let_else_only` lint:
#
#     let [binder] = bindings else {
#         return none;
#     };
#
# — an array taken apart for its one element, with `none` as the answer when it holds none or
# several. That is `let binder = bindings.only()?;`, which says the same without the block. (A
# hand-written `if (let [binder] = bindings) { rest } else { return none; }` lowers to the same
# tree and is the same program.)
#
# It has to be the function's *tail* (see `tail_matches`), where the `?` and the block's `return`
# both leave the function with the same answer, and the `else` has to be exactly `return none;`:
# a block that does anything first, or returns something else, is a different program. The
# pattern has to be one plain name, or `_`, which asks only whether there is one element and is
# then written as the statement `bindings.only()?;`. A second element, a literal, or a trailing
# `..` (which allows more than one) is a different question.
#
# The hit points at the `none` after `return`, on a line the formatter keeps in place, so
# `#[allow]` squelches it.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_empty,
    logical_or as ||,
    map,
    not_equal as !=,
    only,
} from builtins;
import { Only } from "../builtin_table.aipl";
import { IfLet, None, Return, Seq, Unit } from "../expr.aipl";
import { Function } from "../item.aipl";
import { Array, Binder, Pat } from "../pat.aipl";
import { tail_matches } from "./case_match.aipl";
import { LintHit, lint_function_unfilled, shown, unfilled } from "./lint_hit.aipl";
import { receiver_text } from "./option_match.aipl";

# The name `self` binds when it is an array pattern of exactly one plain name (`_` included).
pub fn single_binder(self: Pat) -> str? {
    let Array(elements) = self.as_case::<Array>()?;
    let Binder(name) = elements.only()?.kind.as_case::<Binder>()?;
    some(name)
}

# A hit for each `let [name] = .. else { return none; }` that ends the function.
pub fn let_else_only(Function { body }) -> LintHit[] {
    body
        .tail_matches()
        .map(|tail| {
            let IfLet(arm, scrutinee, otherwise) = tail.kind else { return none; };
            let some(binder) = arm.pattern.single_binder() else { return none; };
            // `return none;` and nothing else: the statement, then the block's unit tail.
            let Seq(leave, rest) = otherwise.kind else { return none; };
            let Return(value) = leave.kind else { return none; };
            if (rest.kind != Unit || value.kind != None) { return none; };
            let statement = if (binder == "_") { "" } else { `let {binder} = ` };
            some(unfilled(
                Only,
                `this \`else\` only gives up with none — write "{statement}{scrutinee.receiver_text()}.`,
                `()?;" and drop the block`,
                leave.span,
            ))
        })
        .collect_ok()
}.test({
    // The element taken out and named by the `let`, and the hit on the `return`.
    assert(lint_function_unfilled(
        "fn f(xs: i64[]) -> i64? { let [x] = xs else { return none; }; some(x) }",
        let_else_only,
    )?.shown() == [
        """this `else` only gives up with none — write "let x = xs.Builtin(Only)()?;" and drop the block""",
    ]);
    assert(lint_function_unfilled(
        "fn f(xs: i64[]) -> i64? { let [x] = xs else { return none; }; some(x) }",
        let_else_only,
    )?$span == [53..57]);

    // A name that is not read asks only whether there is one element.
    assert(lint_function_unfilled(
        "fn f(xs: i64[]) -> i64? { let [_] = xs else { return none; }; some(1) }",
        let_else_only,
    )?.shown() == [
        """this `else` only gives up with none — write "xs.Builtin(Only)()?;" and drop the block""",
    ]);

    // A hand-written `if let` is the same tree.
    assert(lint_function_unfilled(
        "fn f(xs: i64[]) -> i64? { if (let [x] = xs) { some(x) } else { return none; } }",
        let_else_only,
    )?.shown() == [
        """this `else` only gives up with none — write "let x = xs.Builtin(Only)()?;" and drop the block""",
    ]);

    // The value taken apart is quoted as it was written, where a method can follow it.
    assert(lint_function_unfilled(
        "fn f(p: P) -> i64? { let [x] = p.xs else { return none; }; some(x) }",
        let_else_only,
    )?.shown() == [
        """this `else` only gives up with none — write "let x = p.xs.Builtin(Only)()?;" and drop the block""",
    ]);
    assert(lint_function_unfilled(
        "fn f(o: i64[]?) -> i64? { let [x] = o? else { return none; }; some(x) }",
        let_else_only,
    )?.shown() == [
        """this `else` only gives up with none — write "let x = o?.Builtin(Only)()?;" and drop the block""",
    ]);

    // Shapes the lint must leave alone.
    // The block returns something other than `none`.
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64 { let [x] = xs else { return 0; }; x }",
            let_else_only,
        )?.is_empty(),
    );
    // The block does something before it returns.
    assert(
        lint_function_unfilled(
            """fn f(xs: i64[]) !prints -> i64? { let [x] = xs else { print("no"); return none; }; some(x) }""",
            let_else_only,
        )?.is_empty(),
    );

    // More than one element, a literal, an array of at least one, and an optional's `some`:
    // none of them is "exactly one element".
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64? { let [a, b] = xs else { return none; }; some(a) }",
            let_else_only,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64? { let [1] = xs else { return none; }; some(1) }",
            let_else_only,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64? { let [a, ..] = xs else { return none; }; some(a) }",
            let_else_only,
        )?.is_empty(),
    );
    assert(
        lint_function_unfilled(
            "fn f(o: i64?) -> i64? { let some(n) = o else { return none; }; some(n) }",
            let_else_only,
        )?.is_empty(),
    );

    // Not the function's last act: the `?` would leave the function where the `if let` only
    // chose a value for a binding.
    assert(
        lint_function_unfilled(
            "fn f(xs: i64[]) -> i64? { let w = if (let [x] = xs) { x } else { return none; }; some(w) }",
            let_else_only,
        )?.is_empty(),
    );
})
