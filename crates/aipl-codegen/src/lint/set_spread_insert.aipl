# The `set_spread_insert` lint: `set seen = #{..seen, x};` — a set rebuilt from itself only to add
# to it. `set seen.insert(x);` is the addition spelled as one: it names the element added, and the
# set's other contents never come up.
#
# It is the set sibling of `set_spread_push`, and the argument is the same. The rebuild spelling
# says "build the larger set, then store it", which costs a fresh set of the combined size on every
# addition; `insert` writes into `seen`'s own storage when nothing else holds it, and copies when
# something does, so the two spellings agree on what any other binding sees. A field path works the
# same way as a bare name (`set self.seen = #{..self.seen, x}` is `set self.seen.insert(x)`), which
# is the whole set of targets: `insert` writes the grown set back into the place it was given, and
# only a name or a field path off one is a place.
#
# Three shapes are left alone. The spread must be the **first** element and must be the target
# itself — `#{x, ..seen}` is the same set but starts from `x`, and `#{..other, x}` starts from a
# different set, and neither is something `insert` can spell. A spread in the tail adds a whole set
# rather than one element (`#{..seen, ..more}`), which is `union`, so it is not advised here. And
# with more than one added element the rewrite is one call per element, so it is offered only when
# no element reads the target: `set seen = #{..seen, seen.len(), seen.len()};` adds the *same*
# length twice, where the two inserts would see the set grow between them. A single element is
# always safe — it is computed before the addition either way.
#
# The shape is all language syntax — a set literal with a spread in it needs no import — so the
# lint fires whether or not `insert` is imported. The name is only for the advice, which says to
# import it when it is missing.
#
# The hit points at the spread, which is a single line however the literal is broken.

import {
    any,
    as_case,
    drop_first,
    equal as ==,
    first,
    greater_than as >,
    is_case,
    is_empty,
    len,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    push,
    to_str,
} from builtins;
import { Insert } from "../builtin_table.aipl";
import { Assign, SetLit, Spread } from "../expr.aipl";
import { Unordered } from "../ty.aipl";
import { expr_text } from "./expr_text.aipl";
import { mentions_any } from "./field_uses.aipl";
import { lint_with_unfilled } from "./lint.aipl";
import { LintHit, Named, shown } from "./lint_hit.aipl";
import { is_same_place, root_name } from "./places.aipl";
import { Builtin } from "./spelling.aipl";
import { insert } from sets;

# The hit for the `set` `self`, when it sets a place to a set literal that starts by spreading it.
pub fn set_spread_insert(self: Assign(target, value, _)) -> LintHit? {
    let SetLit(elements, order) = value.kind.as_case::<SetLit>()?;
    // `insert` writes back an unordered set, so an ordered literal is left as it is.
    if (!order.is_case::<Unordered>()) { return none; };
    let root = target.root_name()?;
    let spread = elements.first()?;
    let Spread(base) = spread.kind.as_case::<Spread>()?;
    let added = elements.drop_first();
    if (!base.is_same_place(target) || added.is_empty()) { return none; };
    // A spread in the tail adds a whole set, which `insert` does not.
    if (added.any(|element| element.kind.is_case::<Spread>())) { return none; };
    if (added.len() > 1 && added.any(|element| element.mentions_any([root], none))) {
        return none;
    };
    let place = target.source;

    // The advice, a stretch of text at a time, each followed by the builtin it calls.
    mut named: Named[] = [];
    mut text = `this "set" rebuilds "{place}" from itself only to add to it — {if (added.len() == 1) {
        "add in place"
    } else {
        "add each in place"
    }}: "`;
    for (let i, element : added) {
        let separator = if (i == 0) { "" } else { " " };
        set named.push(Named { text: `{text}{separator}set {place}.`, builtin: Builtin(Insert) });
        set text = `({element.expr_text()});`;
    }
    some(LintHit { named, tail: `{text}"`, span: spread.span })
}.test({
    assert(lint_with_unfilled(
        "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, x}; out }",
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "out" from itself only to add to it — add in place: "set out.Builtin(Insert)(x);"`,
    ]);

    // Several elements are one call each, in the name the file imports.

    // What the file lacks is named once.
    assert(lint_with_unfilled(
        "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, x, 1}; out }",
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "out" from itself only to add to it — add each in place: "set out.Builtin(Insert)(x); set out.Builtin(Insert)(1);"`,
    ]);
    assert(lint_with_unfilled(
        "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, g(x)}; out }",
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "out" from itself only to add to it — add in place: "set out.Builtin(Insert)(g(x));"`,
    ]);

    // The target may be a field path.
    assert(lint_with_unfilled(
        "fn f(xs: #{i64}, x: i64) -> #{i64} { mut s = P { a: xs }; set s.a = #{..s.a, x}; s.a }",
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "s.a" from itself only to add to it — add in place: "set s.a.Builtin(Insert)(x);"`,
    ]);

    // Not the shape: the spread is not first, it is of another set, nothing is added, a whole set
    // is added, or several elements read the target.
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{x, ..out}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..xs, x}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #>{..out, x}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, ..xs}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, ..xs, x}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );
    assert(
        lint_with_unfilled(
            "fn f(xs: #{i64}, x: i64) -> #{i64} { mut out = xs; set out = #{..out, out.len(), out.len()}; out }",
            "set_spread_insert",
        )?.is_empty(),
    );

    // Shapes the lint flags, and what it says of them.
    assert(lint_with_unfilled(
        """
            fn grow(mut seen: #{i64}) {
                set seen = #{..seen, 1};
                set seen = #{..seen, 2, 3};
            }
        """,
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "seen" from itself only to add to it — add in place: "set seen.Builtin(Insert)(1);"`,
        `this "set" rebuilds "seen" from itself only to add to it — add each in place: "set seen.Builtin(Insert)(2); set seen.Builtin(Insert)(3);"`,
    ]);
    assert(lint_with_unfilled(
        """
            fn stash(mut self: Bag, x: i64) {
                set self.seen = #{..self.seen, x};
            }
        """,
        "set_spread_insert",
    )?.shown() == [
        `this "set" rebuilds "self.seen" from itself only to add to it — add in place: "set self.seen.Builtin(Insert)(x);"`,
    ]);

    // Not "set_spread_insert": a rebuild that is not an addition of elements to the same set.
    assert(
        lint_with_unfilled(
            """
                fn other(mut out: #{u64}, xs: #{u64}) {
                    set out = #{0, ..out};
                    set out = #{..xs, 9};
                    set out = #{..out, ..xs};
                    set out = #{..out, out.len(), out.len()};
                }
            """,
            "set_spread_insert",
        )?.is_empty(),
    );

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn rebuilt(mut self: #{i64}) {
        set self = #{..self, 3}; #[allow]
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side and
    // proven to agree.
    fn inserted(mut self: #{i64}) {
        set self.insert(3);
    }
    mut a = #{1, 2};
    mut b = #{1, 2};
    set a.rebuilt();
    set b.inserted();
    assert(to_str(a == b) == "true");
    assert(a == #{1, 2, 3});
})
