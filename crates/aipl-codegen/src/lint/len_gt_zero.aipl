# The `len_gt_zero` lint: `0 < x.len()` / `x.len() > 0`, and `!x.is_empty()` — non-emptiness asked the
# long way. `x.is_nonempty()` asks the question directly: it says what the test means rather than
# leaving the reader to recognize the idiom (or to hold a negation), and it is the one spelling that
# reads the same for every receiver `len` takes.
#
# Only these shapes qualify. `0 > x.len()` and `x.len() < 0` are something else entirely (both are
# always false on an unsigned length), and the `!= 0` spellings are left alone: this lint's job is
# the idioms people actually reach for, not every expression that happens to mention a length and a
# zero. The negated predicate is the mirror of `is_empty_longhand`'s `!x.is_nonempty()`; between
# the two, a predicate is never negated to ask the other one.
#
# Operators are bound by import and nothing fixes that binding, so a file that aliases `<` to a
# function of its own has a `0 < x.len()` that is not a length test at all, and the lint stays
# quiet there. Only a builtins import counts: the operator builtins are the ones whose meaning is
# fixed. The same goes for `len`: a file's own `len` is a different function answering a different
# question, and `is_nonempty` does not apply to what it takes.
#
# The receiver is quoted only where the rewrite is a literal splice — the method spelling, whose
# `.len` or `.is_empty` follows the receiver's text. That keeps a parenthesized or free-call
# receiver (`len(f(x))`, `(a + b).len()`) from being spliced into advice that would reassociate it.

import {
    as_case,
    collect_ok,
    equal as ==,
    is_some_and,
    len,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
    starts_with,
} from builtins;
import { Call, Expr, descendants } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import {
    LintHit,
    UnfilledHit,
    bound_to,
    imported_as,
    lint_messages,
    on_functions_filled,
    text_after,
    unfilled,
} from "./lint_hit.aipl";
import { is_zero } from "./slice_bounds.aipl";

# What the file's imports make of the operators and builtins this lint reads.
struct Names { less_than: bool, greater_than: bool, logical_not: bool, len: str?, empty: str? }

# A hit for each length compared against zero, or negated emptiness test, in the program.
pub fn len_gt_zero(program: Program) -> LintHit[] {
    let items = program.items;
    let names = Names {
        less_than: items.bound_to("<") == some("less_than"),
        greater_than: items.bound_to(">") == some("greater_than"),
        logical_not: items.bound_to("!") == some("logical_not"),
        len: items.imported_as("len"),
        empty: items.imported_as("is_empty"),
    };
    program.on_functions_filled(
        |Function { body }| body.descendants()$nonempty_test(names).collect_ok(),
    )
}.test({
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(x: i64[]) -> bool \{ {body} }`,
            len_gt_zero,
        )
    }
    let all = "len, is_empty, is_nonempty, greater_than as >, less_than as <, logical_not as !";
    assert(messages(all, "x.len() > 0")? == [
        `a length compared against 0 — use "x.is_nonempty()"`,
    ]);
    assert(messages(all, "0 < x.len()")? == [
        `a length compared against 0 — use "x.is_nonempty()"`,
    ]);
    assert(messages(all, "!x.is_empty()")? == [
        `a negated emptiness test — use "x.is_nonempty()"`,
    ]);

    // A receiver that is not spelled by its text is a placeholder, and a missing import is named.
    assert(messages(all, "len(x) > 0")? == [
        `a length compared against 0 — use "is_nonempty" on the receiver`,
    ]);
    assert(messages("len, greater_than as >", "x.len() > 0")? == [
        """a length compared against 0 — use "x.is_nonempty()", importing `is_nonempty` from builtins""",
    ]);

    // Other comparisons, or an operator that is not the builtin one, are not this.
    assert(messages(all, "x.len() != 0")? == []);
    assert(messages(all, "0 > x.len()")? == []);
    assert(messages("len", "x.len() > 0")? == []);

    // Shapes the lint must leave alone.
    // A different bound is a different question.
    assert(
        lint_messages("fn at_least_two(xs: i64[]) -> bool { 1 < xs.len() }", len_gt_zero)? == [],
    );
    assert(
        lint_messages("fn more_than_one(xs: i64[]) -> bool { xs.len() > 1 }", len_gt_zero)? == [],
    );

    // `>= 1` means the same thing, but it is not one of the two idioms the lint
    // rewrites, and inventing a third spelling to flag would make the rule harder
    // to state than to follow.
    assert(
        lint_messages("fn at_least_one(xs: i64[]) -> bool { xs.len() >= 1 }", len_gt_zero)? == [],
    );
    // So does `!= 0`, and it is left alone for the same reason.
    assert(lint_messages("fn not_zero(xs: i64[]) -> bool { xs.len() != 0 }", len_gt_zero)? == []);
    // Zero compared against anything that isn't a length.
    assert(lint_messages("fn positive(n: u64) -> bool { 0 < n }", len_gt_zero)? == []);
    // The spelling the lint asks for, which must not then flag itself.
    assert(
        lint_messages("fn any_items(xs: i64[]) -> bool { xs.is_nonempty() }", len_gt_zero)? == [],
    );

    // An un-negated `is_empty` is the other question, and a negation of anything
    // but `is_empty` is not this idiom.
    assert(lint_messages("fn no_items(xs: i64[]) -> bool { xs.is_empty() }", len_gt_zero)? == []);
    assert(lint_messages("fn not_positive(n: u64) -> bool { !(0 < n) }", len_gt_zero)? == []);
})

# The hit for `self`, when it is a comparison of a length with zero, or a negated `is_empty`.
fn nonempty_test(self: Expr, names: Names) -> UnfilledHit? {
    let Call(op, args, _) = self.kind.as_case(Call)?;
    let (receiver, what) = match (args.len()) {
        1 => (args.negated_emptiness(op, names)?, "a negated emptiness test"),
        2 => (args.length_against_zero(op, names)?, "a length compared against 0"),
        _ => {
            return none;
        },
    };
    // The method spelling, `x.len()` or `x.is_empty()`, is what the advice can splice back.
    let after = receiver.text_after(self);
    let method = after.starts_with(".len") || names.empty.is_some_and(|empty| after.starts_with(
        `.{empty}`,
    ));
    some(if (method) {
        unfilled("is_nonempty", `{what} — use "{receiver.source}.`, `()"`, self.span)
    } else {
        unfilled("is_nonempty", `{what} — use "`, `" on the receiver`, self.span)
    })
}

# The receiver of the emptiness test the one argument `self` negates, when it is `!x.is_empty()` with the builtin `!`.
fn negated_emptiness(self: Expr[], op: str, Names { logical_not, empty }) -> Expr? {
    if (op != "!" || !logical_not) { return none; };
    let Call(callee, args, _) = self[0]?.kind.as_case(Call)?;
    if (args.len() != 1 || some(callee) != empty) { return none; };
    args[0]
}

# The receiver of the length that the two arguments `self` compare with zero as `0 < x.len()` or `x.len() > 0`.
fn length_against_zero(
    self: Expr[],
    op: str,
    Names { len as length, less_than, greater_than },
) -> Expr? {
    let len_name = length?;
    let [left, right] = self else { return none; };
    if (op == "<" && less_than && left.is_zero()) { return right.length_receiver(len_name); };
    if (op == ">" && greater_than && right.is_zero()) { return left.length_receiver(len_name); };
    none
}

# The receiver of the call `self` when it is a call of `len`, however it was spelled: `x.len()` is the
# free call `len(x)`.
fn length_receiver(self: Expr, len_name: str) -> Expr? {
    let Call(callee, args, _) = self.kind.as_case(Call)?;
    if (callee != len_name || args.len() != 1) { return none; };
    args[0]
}
