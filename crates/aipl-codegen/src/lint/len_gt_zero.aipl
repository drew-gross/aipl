# The `len_gt_zero` lint: `0 < x.len()` / `x.len() > 0`, and `!x.is_empty()` — non-emptiness asked the
# long way. `x.is_nonempty()` asks the question directly: it says what the test means rather than
# leaving the reader to recognize the idiom (or to hold a negation), and it is the one spelling that
# reads the same for every receiver `len` takes.
#
# Only these shapes qualify. `0 > x.len()` and `x.len() < 0` are something else entirely (both are
# always false on an unsigned length), and the `!= 0` spellings are left alone: this lint's job is
# the idioms people actually reach for, not every expression that happens to mention a length and a
# zero. The negated predicate is the mirror of `is_empty_longhand`'s `!x.is_nonempty()`; between
# the two, a predicate is never negated to ask the other one.
#
# What a call is to is what the file's imports make of its name, so the operators and `len` are found
# however the file spells them, and a file that aliases `<` to a function of its own has a `0 < x.len()`
# that is not a length test at all. The same goes for `len`: a file's own `len` is a different function
# answering a different question, and `is_nonempty` does not apply to what it takes.
#
# The receiver is quoted only where the rewrite is a literal splice: a call's span stops before its
# closing paren, so splicing `len(f(x))`'s receiver would produce advice that does not parse.

import {
    as_case,
    equal as ==,
    len,
    logical_and as &&,
    logical_or as ||,
    not_equal as !=,
} from builtins;
import {
    Callee,
    GreaterThan,
    IsEmpty,
    IsNonempty,
    Len,
    LessThan,
    LogicalNot,
} from "../builtin_table.aipl";
import { Call, Expr } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { lint_str } from "./lint.aipl";
import { Advice, advice, spans_its_text } from "./lint_hit.aipl";
import { is_zero } from "./slice_bounds.aipl";

# The advice for the call `self`, when it is a comparison of a length with zero, or a negated `is_empty`.
pub fn len_gt_zero(self: Call(_, args, _, callee)) -> Advice? {
    let (receiver, what) = match (args.len()) {
        1 => (args.negated_emptiness(callee)?, "a negated emptiness test"),
        2 => (args.length_against_zero(callee)?, "a length compared against 0"),
        _ => {
            return none;
        },
    };
    some(if (receiver.spans_its_text()) {
        advice(IsNonempty, `{what} — use "{receiver.source}.`, `()"`)
    } else {
        advice(IsNonempty, `{what} — use "`, `" on the receiver`)
    })
}.test({
    // `lint_str` runs every lint, so each snippet imports exactly the names it uses; the ones that
    // need `is_nonempty` imported say so by calling it.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_str(`import \{ {imports} } from builtins; fn f(x: i64[]) -> bool \{ {body} }`)
    }
    let long = "len, is_nonempty, greater_than as >";
    assert(messages(long, "x.len() > 0 && x.is_nonempty()")? == [
        `a length compared against 0 — use "x.is_nonempty()"`,
    ]);
    assert(messages("len, is_nonempty, less_than as <", "0 < x.len() && x.is_nonempty()")? == [
        `a length compared against 0 — use "x.is_nonempty()"`,
    ]);
    assert(messages(
        "is_empty, is_nonempty, logical_not as !",
        "!x.is_empty() && x.is_nonempty()",
    )? == [`a negated emptiness test — use "x.is_nonempty()"`]);

    // A receiver that is not spelled by its text is a placeholder, and a missing import is named.
    assert(messages(long, "len(x) > 0 && x.is_nonempty()")? == [
        `a length compared against 0 — use "x.is_nonempty()"`,
    ]);
    assert(messages(long, "f(x).len() > 0 && x.is_nonempty()")? == [
        `a length compared against 0 — use "is_nonempty" on the receiver`,
    ]);
    assert(messages("len, greater_than as >", "x.len() > 0")? == [
        """a length compared against 0 — use "x.is_nonempty()", importing `is_nonempty` from builtins""",
    ]);

    // The names the file gives the builtins do not matter.
    assert(messages(
        "len as length, greater_than as above, is_nonempty",
        "above(x.length(), 0) && x.is_nonempty()",
    )? == [`a length compared against 0 — use "x.is_nonempty()"`]);

    // Other comparisons, or an operator that is not the builtin one, are not this.
    assert(messages("len, greater_than as >", "x.len() != 0 && x.len() > 1")? == []);
    assert(messages("len, greater_than as >", "0 > x.len()")? == []);
    assert(messages("len", "x.len() > 0")? == []);

    // A different bound is a different question. `>= 1` and `!= 0` mean the same thing but are not
    // the two idioms the lint rewrites, and inventing a third spelling to flag would make the rule
    // harder to state than to follow.
    assert(messages("len, less_than as <", "1 < x.len()")? == []);
    assert(messages("len, greater_than_or_equal as >=", "x.len() >= 1")? == []);

    // Zero compared against anything that isn't a length; the spelling the lint asks for, which must
    // not then flag itself; and the other question, an un-negated `is_empty`.
    assert(messages("less_than as <, logical_not as !", "!(0 < x)")? == []);
    assert(messages("is_nonempty", "x.is_nonempty()")? == []);
    assert(messages("is_empty", "x.is_empty()")? == []);

    // An operator the file binds to a function of its own is a call to that function, not a length test.
    assert(
        lint_str(
            """import { len } from builtins; import { my_lt as < } from "./myord.aipl"; fn f(x: i64[]) -> bool { 0 < x.len() }""",
        )? == [],
    );
})

# The receiver of the emptiness test the one argument `self` negates, when `callee` is `!` and it is
# `!x.is_empty()`.
fn negated_emptiness(self: Expr[], callee: Callee) -> Expr? {
    if (callee != LogicalNot) { return none; };
    let Call(_, args, _, inner) = self[0]?.kind.as_case::<Call>()?;
    if (args.len() != 1 || inner != IsEmpty) { return none; };
    args[0]
}

# The receiver of the length that the two arguments `self` compare with zero as `0 < x.len()` or
# `x.len() > 0`, when `callee` is the comparison.
fn length_against_zero(self: Expr[], callee: Callee) -> Expr? {
    let [left, right] = self else { return none; };
    if (callee == LessThan && left.is_zero()) { return right.length_receiver(); };
    if (callee == GreaterThan && right.is_zero()) { return left.length_receiver(); };
    none
}

# The receiver of the call `self` when it is a call of `len`, however it was spelled: `x.len()` is the
# free call `len(x)`.
fn length_receiver(self: Expr) -> Expr? {
    let Call(_, args, _, callee) = self.kind.as_case::<Call>()?;
    if (callee != Len || args.len() != 1) { return none; };
    args[0]
}
