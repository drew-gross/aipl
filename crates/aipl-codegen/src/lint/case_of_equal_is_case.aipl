# The `case_of_equal_is_case` lint: `shape.case_of() == Circle` — reading which
# case a value is only to compare it with one. That is `shape.is_case::<Circle>()`,
# which asks the same question without the detour through a `Case`.
#
# Exactly one side is a `case_of()` call. Two of them, `a.case_of() == b.case_of()`,
# compare the cases of two values, which is `same_case(a, b)` and not `is_case`.
#
# The hit points at the `==`, a short line the formatter keeps in place.

import { collect_ok, count_if, equal as ==, is_empty, len, not_equal as != } from builtins;
import { CaseOf, Equal, IsCase } from "../builtin_table.aipl";
import { Call, Expr, descendants_of_kind } from "../expr.aipl";
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function } from "../item.aipl";
import {
    LintHit,
    advice,
    at,
    filled_assuming,
    lint_function_unfilled_messages,
} from "./lint_hit.aipl";

# The advice for the call `self`, when it is `==` with a `case_of()` on exactly one side.
pub fn case_of_equal_is_case(self: Call(_, operands, _, callee)) -> LintHit? {
    if (callee != Equal) { return none; };
    let case_reads = operands.count_if(|operand| match (operand.kind) {
        Call(_, arguments, _, CaseOf) => arguments.len() == 1,
        _ => false,
    });
    if (case_reads != 1) { return none; };
    some(comparison_advice())
}.test({
    fn at_call(self: Expr<Call>) -> LintHit? {
        let found = case_of_equal_is_case(self.kind)?;
        some(found.at(self.span))
    }
    fn flagged(Function { body }) -> LintHit[] {
        body.descendants_of_kind::<Call>()$at_call().collect_ok()
    }
    // The file imports what the lint reads: a call is to a builtin by what the imports make of it.
    fn messages(source: str) -> str[]!ParseFailure {
        lint_function_unfilled_messages(
            `import \{ case_of, equal as == } from builtins; {source}`,
            flagged,
        )
    }
    assert(messages("fn f(s: Shape) -> bool { s.case_of() == Circle }")? == [message(none)]);

    // The call form, the case on the left, and the `.test` block.
    assert(messages("fn f(s: Shape) -> bool { case_of(s) == Circle }")? == [message(none)]);
    assert(messages("fn f(s: Shape) -> bool { Circle == s.case_of() }")? == [message(none)]);
    assert(messages("fn f() { }.test({ assert(s.case_of() == Dot); })")? == [message(none)]);

    // The name the file imports it under is the advice's.
    assert(messages(
        "import { is_case as isa } from builtins; fn f(s: Shape) -> bool { s.case_of() == Dot }",
    )? == [message(some("isa"))]);

    // Two `case_of`s compare two values' cases, which `is_case` cannot say.
    assert(messages("fn f(a: Shape, b: Shape) -> bool { a.case_of() == b.case_of() }")?.is_empty());

    // Neither side reads a case, or the comparison is another one.
    assert(messages("fn f(a: i64, b: i64) -> bool { a == b }")?.is_empty());
    assert(messages("fn f(s: Shape) -> bool { s.case_of() != Circle }")?.is_empty());

    // Shapes the lint must leave alone.
    // Two values' cases against each other is `same_case`, which `is_case` cannot say.
    assert(
        messages(
            "fn same_kind(a: Shape, b: Shape) -> bool { a.case_of() == b.case_of() }",
        )?.is_empty(),
    );
    // Cases held in variables compare without a `case_of()` call at all.
    assert(messages("fn same_held(a: Case<Shape>, b: Case<Shape>) -> bool { a == b }")?.is_empty());

    // Shapes the lint flags, and what it says of them.
    assert(messages("fn is_circle(shape: Shape) -> bool { shape.case_of() == Circle }")? == [
        """this compares a value's case — write "<value>.is_case::<Case>()" instead of reading it with "case_of()", importing `is_case` from builtins""",
    ]);
    // The case on the left, and the call form.
    assert(messages("fn is_dot(shape: Shape) -> bool { Dot == case_of(shape) }")? == [
        """this compares a value's case — write "<value>.is_case::<Case>()" instead of reading it with "case_of()", importing `is_case` from builtins""",
    ]);
})

# What is said of a comparison that only asks which case a value is, with the name of
# `is_case` left for the caller to fill in.
fn comparison_advice() -> LintHit {
    advice(
        IsCase,
        `this compares a value's case — write "<value>.`,
        `::<Case>()" instead of reading it with "case_of()"`,
    )
}

# The message `advice` comes to for a file that spells `is_case` as `spelled`.
fn message(spelled: str?) -> str { comparison_advice().at(0..0).filled_assuming(spelled) }
