# The `case_of_equal_is_case` lint: `shape.case_of() == Circle` — reading which
# case a value is only to compare it with one. That is `shape.is_case(Circle)`,
# which asks the same question without the detour through a `Case`.
#
# Exactly one side is a `case_of()` call. Two of them, `a.case_of() == b.case_of()`,
# compare the cases of two values, which is `same_case(a, b)` and not `is_case`.
#
# The hit points at the `==`, a short line the formatter keeps in place.

import { Span, count_if, equal as ==, join, len, map } from builtins;
import { Call, descendants } from "../expr.aipl";
import { Function } from "../item.aipl";
import {
    UnfilledHit,
    filled_with,
    lint_function_unfilled_messages,
    unfilled,
} from "./lint_hit.aipl";

# A hit for each comparison of a value's case with something.
pub fn case_of_equal_is_case(Function { body }) -> UnfilledHit[] {
    body
        .descendants()
        .map(|comparison| {
            let Call("==", operands, _) = comparison.kind else { return []; };
            if (operands.count_if(|operand| match (operand.kind) {
                Call("case_of", arguments, _) => arguments.len() == 1,
                _ => false,
            }) == 1) {
                [advice(comparison.span)]
            } else {
                []
            }
        })
        .join()
}.test({
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { s.case_of() == Circle }",
        case_of_equal_is_case,
    )? == [message(none)]);

    // The call form, the case on the left, and the `.test` block.
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { case_of(s) == Circle }",
        case_of_equal_is_case,
    )? == [message(none)]);
    assert(lint_function_unfilled_messages(
        "fn f(s: Shape) -> bool { Circle == s.case_of() }",
        case_of_equal_is_case,
    )? == [message(none)]);
    assert(lint_function_unfilled_messages(
        "fn f() { }.test({ assert(s.case_of() == Dot); })",
        case_of_equal_is_case,
    )? == [message(none)]);

    // The name the file imports it under is the advice's.
    assert(lint_function_unfilled_messages(
        "import { is_case as isa } from builtins; fn f(s: Shape) -> bool { s.case_of() == Dot }",
        case_of_equal_is_case,
    )? == [message(some("isa"))]);

    // Two `case_of`s compare two values' cases, which `is_case` cannot say.
    assert(
        lint_function_unfilled_messages(
            "fn f(a: Shape, b: Shape) -> bool { a.case_of() == b.case_of() }",
            case_of_equal_is_case,
        )? == [],
    );

    // Neither side reads a case, or the comparison is another one.
    assert(
        lint_function_unfilled_messages(
            "fn f(a: i64, b: i64) -> bool { a == b }",
            case_of_equal_is_case,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(s: Shape) -> bool { s.case_of() != Circle }",
            case_of_equal_is_case,
        )? == [],
    );
})

# The hit for one expression, or none: it is `==` with a `case_of()` on one side.
# What is said of a comparison that only asks which case a value is, with the name of
# `is_case` left for the caller to fill in.
fn advice(span: Span) -> UnfilledHit {
    unfilled(
        "is_case",
        `this compares a value's case — write "<value>.`,
        `(<case>)" instead of reading it with "case_of()"`,
        span,
    )
}

# The message `advice` comes to for a file that spells `is_case` as `spelled`.
fn message(spelled: str?) -> str { advice(0..0).filled_with(|name| spelled).message }
