# The `match_is_some_and` lint:
#
#     match (o) { some(v) => p, none => false }
#
# — an optional matched only to answer a yes/no question, with `none` spelled as
# `false`. That is exactly `o.is_some_and(|v| p)`, which says the same thing in one
# line and without naming the `none` case at all.
#
# The `none` arm being the literal `false` is what makes this recognizable without
# types: arms must agree on a type, so a `false` arm proves the whole `match` is a
# `bool`, and `some`/`none` patterns only ever match an optional. Arm order does not
# matter.
#
# Two near misses are left alone, because neither has an `is_some_and` spelling that
# improves on what is written: an arm that computes its `bool` some other way
# (`none => flag`) still has to run that expression, and `some(v) => true` ignores
# the payload entirely — that one is an `is_some`, which is not a builtin.
#
# The hit points at the `none` arm's `false`, not the whole `match`. `#[allow]` is
# line-scoped, so a hit spanning several lines could never be squelched: the only
# line able to carry the marker is the `match (..) {` header, and the formatter
# moves a marker written there onto its own line. The literal is always one line,
# and it is the part that makes the shape recognizable.

import {
    Span,
    collect_ok,
    equal as ==,
    is_some_and,
    logical_or as ||,
    map,
    not_equal as !=,
    to_str,
} from builtins;
import { Bool } from "../expr.aipl";
import { Function } from "../item.aipl";
import {
    UnfilledHit,
    filled_with,
    hit,
    lint_function_unfilled_hits,
    lint_function_unfilled_messages,
    unfilled,
} from "./lint_hit.aipl";
import { OptionMatch, option_matches, receiver_text } from "./option_match.aipl";

# A hit for each `match` in the program that only asks whether an optional holds a
# value its arm accepts.
pub fn match_is_some_and(Function { body }) -> UnfilledHit[] {
    body
        .option_matches()
        .map(|OptionMatch { scrutinee, binder, some_body, none_body }| {
            if (none_body.kind != Bool(false) || some_body.kind == Bool(true)) { return none; };
            some(advice(scrutinee.receiver_text(), binder, none_body.span))
        })
        .collect_ok()
}.test({
    // The `none => false` arm is what is pointed at, in either arm order.
    assert(lint_function_unfilled_hits(
        "fn f(o: i64?) -> bool { match (o) { some(v) => v > 1, none => false } }",
        match_is_some_and,
    )? == [hit(message("o", "v"), 62..67)]);
    assert(lint_function_unfilled_messages(
        "fn f(o: i64?) -> bool { match (o) { none => false, some(v) => v > 1 } }",
        match_is_some_and,
    )? == [message("o", "v")]);

    // A receiver that cannot take a method as written is not quoted.
    assert(lint_function_unfilled_messages(
        "fn f(a: i64?, b: i64?) -> bool { match (a || b) { some(v) => v > 1, none => false } }",
        match_is_some_and,
    )? == [message("<value>", "v")]);

    // The `.test` block is held to it too.
    assert(lint_function_unfilled_messages(
        "fn f() { }.test({ assert(match (o) { some(v) => v > 1, none => false }); })",
        match_is_some_and,
    )? == [message("o", "v")]);

    // A `none` arm that is not `false`, a `some` arm that is `true`, and a catch-all
    // are left alone.
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> bool { match (o) { some(v) => v > 1, none => flag } }",
            match_is_some_and,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> bool { match (o) { some(v) => true, none => false } }",
            match_is_some_and,
        )? == [],
    );
    assert(
        lint_function_unfilled_messages(
            "fn f(o: i64?) -> bool { match (o) { some(v) => v > 1, _ => false } }",
            match_is_some_and,
        )? == [],
    );

    // Shapes the lint must leave alone.
    // `none => true` is the opposite question, and inverting the predicate to fit
    // `is_some_and` would obscure it.
    assert(
        lint_function_unfilled_messages(
            """
                fn missing_or_five(o: i64?) -> bool {
                    match (o) {
                        some(v) => v == 5,
                        // `match_map_value_or`'s shape (`o.map(|v| v == 5).value_or(true)`),
                        // squelched so this case stays about which lint does *not* fire.
                        none => true, #[allow]
                    }
                }
            """,
            match_is_some_and,
        )? == [],
    );

    // A computed `none` arm still has to run: `is_some_and` hard-codes `false`
    // there, so this has no `is_some_and` spelling (it does have a
    // `match_map_value_or` one, squelched here for the same reason as above).
    assert(
        lint_function_unfilled_messages(
            """
                fn five_or_flag(o: i64?, flag: bool) -> bool {
                    match (o) {
                        some(v) => v == 5,
                        none => flag, #[allow]
                    }
                }
            """,
            match_is_some_and,
        )? == [],
    );

    // `some(v) => true` ignores the payload — it asks only whether the optional is
    // populated. That is an `is_some`, which is not a builtin; advising
    // `is_some_and(|v| true)` would be worse than what is written here.
    assert(
        lint_function_unfilled_messages(
            """
                fn is_present(o: i64?) -> bool {
                    match (o) {
                        some(v) => true,
                        none => false,
                    }
                }
            """,
            match_is_some_and,
        )? == [],
    );
    // Not a bool at all.
    assert(
        lint_function_unfilled_messages(
            """
                fn or_zero(o: i64?) -> i64 {
                    match (o) {
                        some(v) => v, #[allow]
                        none => 0,
                    }
                }
            """,
            match_is_some_and,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    assert(lint_function_unfilled_messages(
        """
            fn has_five(o: i64?) -> bool {
                match (o) {
                    some(v) => v == 5,
                    none => false,
                }
            }
        """,
        match_is_some_and,
    )? == [
        """this `match` only asks whether the optional holds a value the arm accepts — write "o.is_some_and(|v| ..)" instead, importing `is_some_and` from builtins""",
    ]);
    assert(lint_function_unfilled_messages(
        """
            fn none_first(o: i64?) -> bool {
                match (o) {
                    none => false,
                    some(v) => v == 5,
                }
            }
        """,
        match_is_some_and,
    )? == [
        """this `match` only asks whether the optional holds a value the arm accepts — write "o.is_some_and(|v| ..)" instead, importing `is_some_and` from builtins""",
    ]);

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn has_five(o: i64?) -> bool {
        match (o) {
            some(v) => v == 5,
            none => false, #[allow]
        }
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side
    // and proven to agree.
    fn has_five_short(o: i64?) -> bool { o.is_some_and(|v| v == 5) }
    assert(has_five(some(5)).to_str() == "true");
    assert(has_five_short(some(5)).to_str() == "true");
    assert(has_five(some(4)).to_str() == "false");
    assert(has_five_short(some(4)).to_str() == "false");
    assert(has_five(none).to_str() == "false");
    assert(has_five_short(none).to_str() == "false");
})

# What is said of a `match` that only asks whether the optional `receiver` holds a
# value its arm accepts, pointing at `span`.
fn advice(receiver: str, binder: str, span: Span) -> UnfilledHit {
    unfilled(
        "is_some_and",
        `this \`match\` only asks whether the optional holds a value the arm accepts — write "{receiver}.`,
        `(|{binder}| ..)" instead`,
        span,
    )
}

# The message for a file that does not import `is_some_and`, as the tests' sources do not.
fn message(receiver: str, binder: str) -> str {
    advice(receiver, binder, 0..0).filled_with(|name| none).message
}
