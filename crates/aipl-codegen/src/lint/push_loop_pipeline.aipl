# The `push_loop_pipeline` lint:
#
#     mut out = [];
#     for (let x : xs) {
#         if (keep(x)) {
#             set out.push(f(x));
#         };
#     }
#
# — an array seeded empty and filled by a loop that does nothing but test each element
# and push something derived from it. That is `xs.filter(|x| keep(x)).map(|x| f(x))`:
# one expression that says the array *is* the selected elements, rather than three
# statements the reader has to run in their head to find out that nothing else happens
# to `out`. See `accumulation.aipl` for how exact the shape is.
#
# Both halves are optional, and which are present picks the advice: with no guard it is
# a `map`, with the element pushed unchanged a `filter`, and with neither the loop is
# copying `xs` element by element and `xs` itself is the answer.
#
# The one thing this cannot check is that `xs` is an array: `map` and `filter` take
# arrays, but a `for` also iterates a `str`'s bytes, and which one this is only becomes
# known two passes later. A `str` loop that collects into an array is thus the lint's
# blind spot, and `#[allow]` is the answer there. A *set* is the other receiver the
# advice is wrong for, and `set_map` is not the fix: a loop that pushes into an array is
# building an array, while `set_map` maps a set to a set. Neither `map` nor `filter`
# takes a set, so a collecting loop over one is an `#[allow]` too.
#
# The hit points at the seed.

import { equal as ==, filter, map } from builtins;
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import { accumulations, element_stages, filled_hit, is_advisable } from "./accumulation.aipl";
import { LintHit, imported_as, lint_messages, on_functions_filled } from "./lint_hit.aipl";

# A hit for each array the program seeds empty and fills with a loop of `push`es.
pub fn push_loop_pipeline(program: Program) -> LintHit[] {
    let some(push) = program.items.imported_as("push") else { return []; };
    program.on_functions_filled(|Function { body }| {
        body
            .accumulations(push)
            .filter(is_advisable)
            .map(|loop| loop.filled_hit(loop.element_stages()))
    })
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(xs: i64[]) -> i64[] \{ {body} }`,
            push_loop_pipeline,
        )
    }
    let all = "push, map, filter";

    // Both halves, the guard only, the push only, and neither.
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (x > 0) { set out.push(x * 2); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.filter(|x| ..).map(|x| ..);" and drop the loop`,
    ]);
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (x > 0) { set out.push(x); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.filter(|x| ..);" and drop the loop`,
    ]);
    assert(messages(all, "mut out = []; for (let x : xs) { set out.push(x * 2); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.map(|x| ..);" and drop the loop`,
    ]);
    assert(messages(all, "mut out = []; for (let x : xs) { set out.push(x); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — it is "xs" already — assign that and drop the loop`,
    ]);

    // An import the file lacks is named; an alias is followed.
    assert(messages("push", "mut out = []; for (let x : xs) { set out.push(x * 2); } out")? == [
        ```"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.map(|x| ..);" and drop the loop, importing `map` from builtins```,
    ]);
    assert(messages(
        "push, map as each",
        "mut out = []; for (let x : xs) { set out.push(x * 2); } out",
    )? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.each(|x| ..);" and drop the loop`,
    ]);

    // An iterable that cannot be quoted is a placeholder, and a range needs `map`.
    assert(messages(all, "mut out = []; for (let x : g(xs)) { set out.push(x * 2); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = <iterable>.map(|x| ..);" and drop the loop`,
    ]);
    assert(messages(all, "mut out = []; for (let x : 0..3) { set out.push(x * 2); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = (<range>).map(|x| ..);" and drop the loop`,
    ]);

    // A range has no `filter`, and pushing its own elements has no spelling; a `push` the
    // file never imported is some other function.
    assert(
        messages(
            all,
            "mut out = []; for (let x : 0..3) { if (x > 0) { set out.push(x); }; } out",
        )? == [],
    );
    assert(messages(all, "mut out = []; for (let x : 0..3) { set out.push(x); } out")? == []);
    assert(messages("map", "mut out = []; for (let x : xs) { set out.push(x * 2); } out")? == []);
    // Shapes the lint must leave alone.
    assert(
        lint_messages(
            """fn show(xs: i64[]) -> str { xs$to_str().join(sep=",") }""",
            push_loop_pipeline,
        )? == [],
    );
    assert(
        lint_messages(
            """fn show_u(xs: u64[]) -> str { xs$to_str().join(sep=",") }""",
            push_loop_pipeline,
        )? == [],
    );
    // The loop does something else as well. A pipeline has nowhere to put it.
    assert(
        lint_messages(
            """
                fn logged(xs: i64[]) !prints -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        print(x.to_str());
                        set out.push(x);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // An `if`/`else` pushing from both arms. This one *is* a `map` — of the `if`
    // expression — but the lint reads the guard as a `filter`, and a guard with an
    // else is not one. Recognizing it would mean a second rule with a different
    // rewrite, so it is left alone rather than mis-advised.
    assert(
        lint_messages(
            """
                fn signs(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (0 < x) {
                            set out.push(1);
                        } else {
                            set out.push(0);
                        };
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // The guard reads the array being built, so it depends on how much the loop has
    // already done — a "take the first two" loop, which no `filter` predicate can
    // express.
    assert(
        lint_messages(
            """
                fn first_two(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (out.len() < 2) { set out.push(x); };
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // So does the pushed element: the running length is the index this element
    // lands at, which a `map` lambda cannot see.
    assert(
        lint_messages(
            """
                fn indexed(xs: u64[]) -> u64[] {
                    mut out: u64[] = [];
                    for (let x : xs) {
                        set out.push(x + out.len());
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );
    // The seed already holds something, so the array is not just the loop's output.
    assert(
        lint_messages(
            """
                fn with_head(xs: i64[]) -> i64[] {
                    mut out = [0];
                    for (let x : xs) {
                        set out.push(x * 2);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // A statement between the seed and the loop. The rewrite moves the loop's work
    // up to the seed, past whatever sits in between — so the lint requires the loop
    // to be the very next statement rather than reasoning about what a statement
    // there might do.
    assert(
        lint_messages(
            """
                fn offset(xs: u64[]) -> u64[] {
                    mut out: u64[] = [];
                    let n = xs.len();
                    for (let x : xs) {
                        set out.push(x + n);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // Two pushes per element. The loop emits more elements than it consumes, which
    // is an `extend`, not a `map`.
    assert(
        lint_messages(
            """
                fn doubled_up(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        set out.push(x);
                        set out.push(x);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // Two seeds and one loop, which pairs with neither: `out`'s next statement is
    // the second seed rather than the loop, and the loop that does follow `tmp`
    // pushes somewhere else. The seed and the push have to name the same array,
    // and the loop has to be the seed's very next statement.
    assert(
        lint_messages(
            """
                fn nested_targets(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    mut tmp: i64[] = [];
                    for (let x : xs) {
                        set out.push(x * 2);
                    }
                    [..out, ..tmp]
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // A `while` loop. Its condition is not an iteration, so there is nothing to
    // build a pipeline over.
    assert(
        lint_messages(
            """
                fn counted(n: i64) -> i64[] {
                    mut out: i64[] = [];
                    mut i = 0;
                    while (i < n) {
                        set out.push(i * 2);
                        set i++;
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // A range with a guard. Only `map` takes a range, so there is no `filter` to
    // write.
    assert(
        lint_messages(
            """
                fn even_below(n: u64) -> u64[] {
                    mut out: u64[] = [];
                    for (let i : 0..n) {
                        if (i % 2 == 0) { set out.push(i); };
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // A range pushed whole: the array of its values, which has no spelling the lint
    // could advise.
    assert(
        lint_messages(
            """
                fn upto(n: u64) -> u64[] {
                    mut out: u64[] = [];
                    for (let i : 0..n) {
                        set out.push(i);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // Both: a guard and a transformed element.
    assert(
        lint_messages(
            """
                fn scaled_above(xs: i64[], lo: i64) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (lo <= x) { set out.push(x * 2); };
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );
    // No guard — every element is pushed, transformed. That is a `map` alone.
    assert(
        lint_messages(
            """
                fn doubled(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        set out.push(x * 2);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // The element pushed unchanged — a `filter` alone. The longhand
    // `set out = out.push(x);` is the same statement written out, so it is flagged
    // the same way.
    assert(
        lint_messages(
            """
                fn above(xs: i64[], lo: i64) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (lo <= x) { set out = out.push(x); };
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );

    // Neither: the loop copies the array one element at a time, so the array itself
    // is the answer and there is no pipeline to build.
    assert(
        lint_messages(
            """
                fn copied(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        set out.push(x);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );
    assert(lint_messages("fn evens(n: i64) -> i64[] { [n, n * 2] }", push_loop_pipeline)? == []);

    // A call-shaped iterable can't be quoted back into the advice — its span stops
    // before its parens — so the message names neither it nor a receiver, and the
    // chain reads as the method calls to append.
    assert(
        lint_messages(
            """
                fn from_call(n: i64) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : evens(n)) {
                        set out.push(x * 2);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );
    // A range: `map` takes one, so a transformed push over it is a `map` alone.
    assert(
        lint_messages(
            """
                fn squares(n: u64) -> u64[] {
                    mut out: u64[] = [];
                    for (let i : 0..n) {
                        set out.push(i * i);
                    }
                    out
                }
            """,
            push_loop_pipeline,
        )? == [],
    );
})
