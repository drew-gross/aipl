# The `extend_loop_map_join` lint:
#
#     mut out = [];
#     for (let x : xs) {
#         set out.extend(f(x));
#     }
#
# — an array seeded empty and filled by a loop that does nothing but extend it with
# something derived from each element. That is `xs.map(|x| f(x)).join()`: one
# expression that says the array *is* the pieces joined, rather than statements the
# reader has to run in their head. It is `push_loop_pipeline`'s twin, for a loop that
# adds an array per element rather than one element, and recognises the shape the same
# way (see `accumulation.aipl`); a guard around the extension is a `filter` first.
#
# The one thing this cannot check is what each extension is: `extend` also takes an
# optional, which adds its payload if there is one, and `join` does not. A loop that
# extends with optionals is the lint's blind spot, and `#[allow]` is the answer there.
# Nor can it check that `xs` is an array, for the reasons `push_loop_pipeline` gives.
#
# The hit points at the seed.

import { equal as ==, extend, filter, join, map, to_str } from builtins;
import { ParseFailure } from "../grammar_aipl.aipl";
import { Function, Program } from "../item.aipl";
import { accumulations, element_stages, filled_hit, is_advisable } from "./accumulation.aipl";
import { LintHit, imported_as, lint_messages, on_functions_filled } from "./lint_hit.aipl";

# A hit for each array the program seeds empty and fills with a loop of `extend`s.
pub fn extend_loop_map_join(program: Program) -> LintHit[] {
    let some(extend) = program.items.imported_as("extend") else { return []; };
    program.on_functions_filled(|Function { body }| {
        body
            .accumulations(extend)
            .filter(is_advisable)
            .map(|loop| loop.filled_hit([..loop.element_stages(), ("join", "()")]))
    })
}.test({
    // The messages for a function `f` whose body is `body`, in a file that imports `imports`.
    fn messages(imports: str, body: str) -> str[]!ParseFailure {
        lint_messages(
            `import \{ {imports} } from builtins; fn f(xs: i64[][]) -> i64[] \{ {body} }`,
            extend_loop_map_join,
        )
    }
    let all = "extend, map, filter, join";

    // Mapped, mapped under a guard, and joined as they are.
    assert(messages(all, "mut out = []; for (let x : xs) { set out.extend(g(x)); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.map(|x| ..).join();" and drop the loop`,
    ]);
    assert(messages(
        all,
        "mut out = []; for (let x : xs) { if (c(x)) { set out.extend(g(x)); }; } out",
    )? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.filter(|x| ..).map(|x| ..).join();" and drop the loop`,
    ]);
    assert(messages(all, "mut out = []; for (let x : xs) { set out.extend(x); } out")? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.join();" and drop the loop`,
    ]);

    // Imports the file lacks are named, and an alias is followed.
    assert(messages("extend", "mut out = []; for (let x : xs) { set out.extend(g(x)); } out")? == [
        ```"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.map(|x| ..).join();" and drop the loop, importing `map` and `join` from builtins```,
    ]);
    assert(messages(
        "extend, map as each, join",
        "mut out = []; for (let x : xs) { set out.extend(g(x)); } out",
    )? == [
        `"out" is seeded empty and filled by this loop and nothing else — write "mut out = xs.each(|x| ..).join();" and drop the loop`,
    ]);

    // A range has no `filter`, a `push` loop is `push_loop_pipeline`'s, and an `extend` the
    // file never imported is some other function.
    assert(
        messages(
            all,
            "mut out = []; for (let x : 0..3) { if (c(x)) { set out.extend(g(x)); }; } out",
        )? == [],
    );
    assert(messages("push, map", "mut out = []; for (let x : xs) { set out.push(x); } out")? == []);
    assert(
        messages(
            "map, join",
            "mut out = []; for (let x : xs) { set out.extend(g(x)); } out",
        )? == [],
    );

    // Shapes the lint must leave alone.
    // The loop does something else as well. A pipeline has nowhere to put it.
    assert(
        lint_messages(
            """
                fn logged(xs: i64[]) !prints -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        print(to_str(x));
                        set out.extend([x]);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // A seed with elements is not an empty array to be filled.
    assert(
        lint_messages(
            """
                fn seeded(xs: i64[]) -> i64[] {
                    mut out: i64[] = [0];
                    for (let x : xs) {
                        set out.extend([x]);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // An `else` branch is work the pipeline has nowhere to put.
    assert(
        lint_messages(
            """
                fn either(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (0 != x) {
                            set out.extend([x]);
                        } else {
                            set out.extend([]);
                        };
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // What is added reads the array itself, which the pipeline no longer has.
    assert(
        lint_messages(
            """
                fn doubling(xs: i64[]) -> i64[] {
                    mut out: i64[] = [1];
                    for (let x : xs) {
                        set out.extend(out);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // An indexed loop uses its index, which `map` has no way to pass.
    assert(
        lint_messages(
            """
                fn indexed(xs: u64[]) -> u64[] {
                    mut out: u64[] = [];
                    for (let i, x : xs) {
                        set out.extend([i, x]);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );

    // Shapes the lint flags, and what it says of them.
    // A transformed piece per element: a `map` then a `join`.
    assert(
        lint_messages(
            """
                fn pairs(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        set out.extend([x, x]);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // Under a guard, a `filter` first.
    assert(
        lint_messages(
            """
                fn pairs_of_positives(xs: i64[]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        if (0 != x) { set out.extend([x, x]); };
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );
    // The elements are themselves arrays, added unchanged: just a `join`.
    assert(
        lint_messages(
            """
                fn flattened(xs: i64[][]) -> i64[] {
                    mut out: i64[] = [];
                    for (let x : xs) {
                        set out.extend(x);
                    }
                    out
                }
            """,
            extend_loop_map_join,
        )? == [],
    );

    // `#[allow]` keeps the longhand, and the rewrite it asks for agrees with it.
    fn pairs(xs: i64[]) -> i64[] {
        mut out: i64[] = []; #[allow]
        for (let x : xs) {
            set out.extend([x, x]);
        }
        out
    }

    // The rewrite the lint asks for, so the two spellings are checked side by side and
    // proven to agree.
    fn pairs_short(xs: i64[]) -> i64[] { xs.map(|x| [x, x]).join() }
    assert(to_str(pairs([1, 2])) == "[1, 1, 2, 2]");
    assert(to_str(pairs_short([1, 2])) == "[1, 1, 2, 2]");
})
