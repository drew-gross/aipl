# How a lint's advice names the builtins its rewrite needs, and how the framework decides what to
# write for each.
#
# A lint says *which* builtin its advice uses (a [`Need`]: the builtin's tag) and never how the file
# spells it. [`spelled`] decides, from the file's imports: the name the file already has one under,
# or the preferred spelling (the operator for an operator builtin, else the builtin's own name)
# with the import that makes it available. A spelling the file cannot take — the name is bound to
# something else, or an operator is bound to another flavor — is no spelling at all, and the
# advice that needed it is dropped, since a rewrite the file cannot write is no advice.
#
# Operators that come in more than one flavor (`wrapping_add` and `saturating_add`) are bound by
# import, and nothing fixes which flavor a file chose for `+`. Each flavor is a builtin of its own
# with its own tag, so a lint that advises another spelling of the same arithmetic — `set x = x + 1;`
# as `set x++;` — names the builtin of the flavor of the call it read (`WrappingAdd` advises
# `WrappingIncrement`), and the file either has that operator or can take it.

import {
    collect_arms,
    contains,
    equal as ==,
    filter,
    find_if,
    first,
    is_empty,
    is_some_and,
    join,
    logical_and as &&,
    logical_not as !,
    not_equal as !=,
    value_or,
} from builtins;
import {
    BuiltinEntry,
    Callee,
    Insert,
    IsCase,
    Len,
    SaturatingIncrement,
    WrappingAdd,
    import_name,
    lint_table,
} from "../builtin_table.aipl";
import { ParseFailure, aipl_parse_surface_file } from "../grammar_aipl.aipl";
import { hoist_test_fns } from "../hoist_test_fns.aipl";
import { is_operator_name } from "../is_operator_name.aipl";
import { Function, Import, ImportDecl, Item, LoweredFn, local } from "../item.aipl";
import { operator_named_forms, operator_spellings } from "../operator_named_forms.aipl";

# What a lint's advice needs the file to have: a builtin, by its tag.
variant Need = Builtin(callee: Callee)

# An import that makes a [`Spelling`] available: the item to import from `library`, as the import
# list writes it (`wrapping_increment as ++`).
struct Request { library: str, item: str }

# What the file writes for a [`Need`], and the import it has still to make, if any.
struct Spelling { text: str, request: Request? }

# Whether `self` asks for the builtin whose import name is `name`. `table` is the builtin table.
pub fn is_builtin_named(self: Need, name: str, table: BuiltinEntry[]) -> bool {
    match (self) {
        Builtin(callee) => table
            .find_if(|entry| entry.arm == callee)
            .is_some_and(|entry| entry.import_name() == name),
    }
}.test({
    assert(Builtin(Len).is_builtin_named("len", lint_table()));
    assert(!Builtin(Len).is_builtin_named("any", lint_table()));
})

# The spelling of `self` in a file with these `items`, or `none` when the file cannot take any.
# `table` is the builtin table.
pub fn spelled(self: Need, items: Item[], table: BuiltinEntry[]) -> Spelling? {
    match (self) {
        Builtin(callee) => items.spelled_builtin(table.find_if(|entry| entry.arm == callee)?),
    }
}.test({
    fn spelling(src: str, need: Need) -> Spelling?!ParseFailure {
        ok(need.spelled(aipl_parse_surface_file(src)?.program.hoist_test_fns().items, lint_table()))
    }
    fn missing(library: str, item: str) -> Request? { some(Request { library, item }) }

    // Imported already: the name the file gave it, with nothing left to import.
    assert(spelling("import { is_case as isa } from builtins;", Builtin(IsCase))? == some(Spelling {
        text: "isa",
        request: none,
    }));

    // Not imported: its own name, and the import that supplies it, from the library it is in.
    assert(spelling("fn f() { }", Builtin(Len))? == some(Spelling {
        text: "len",
        request: missing("builtins", "len"),
    }));
    assert(spelling("fn f() { }", Builtin(Insert))? == some(Spelling {
        text: "insert",
        request: missing("sets", "insert"),
    }));

    // The same name from another library is not the builtin.
    assert(spelling("import { insert } from sets;", Builtin(Len))? == some(Spelling {
        text: "len",
        request: missing("builtins", "len"),
    }));

    // The name is the file's own, for something else: the builtin is imported under another one.
    assert(spelling("""import { len } from "./a.aipl";""", Builtin(Len))? == some(Spelling {
        text: "builtin_len",
        request: missing("builtins", "len as builtin_len"),
    }));
    assert(spelling("fn len() { } fn builtin_len() { }", Builtin(Len))? == some(Spelling {
        text: "builtin_len_",
        request: missing("builtins", "len as builtin_len_"),
    }));

    // An operator builtin is written as its operator, imported under that alias.
    assert(spelling("fn f() { }", Builtin(WrappingAdd))? == some(Spelling {
        text: "+",
        request: missing("builtins", "wrapping_add as +"),
    }));
    assert(spelling(
        "import { wrapping_add as + } from builtins;",
        Builtin(WrappingAdd),
    )? == some(Spelling { text: "+", request: none }));

    // Imported by name only, it is still not available as an operator.
    assert(spelling(
        "import { wrapping_add } from builtins;",
        Builtin(WrappingAdd),
    )? == some(Spelling { text: "+", request: missing("builtins", "wrapping_add as +") }));

    // The operator is another flavor's: the spelling is taken.
    assert(
        spelling("import { saturating_add as + } from builtins;", Builtin(WrappingAdd))? == none,
    );

    // The flavored forms are builtins of their own, imported by name under the operator.
    assert(spelling(
        "import { saturating_add as + } from builtins;",
        Builtin(SaturatingIncrement),
    )? == some(Spelling {
        text: "++",
        request: missing("builtins", "saturating_increment as ++"),
    }));
    assert(spelling(
        "import { saturating_add as +, saturating_increment as ++ } from builtins;",
        Builtin(SaturatingIncrement),
    )? == some(Spelling { text: "++", request: none }));

    // The operator is bound to the other flavor.
    assert(
        spelling(
            "import { wrapping_increment as ++ } from builtins;",
            Builtin(SaturatingIncrement),
        )? == none,
    );
})

# The spelling of the builtin `entry` in a file with these `items`.
fn spelled_builtin(self: Item[], entry: BuiltinEntry) -> Spelling? {
    let name = entry.import_name();
    let operator = name.operator_provided();
    // An operator builtin is only usable under its operator spelling.
    let usable = self
        .imported_under(entry.library, name)
        .filter(|local| match (operator) {
            some(_) => local.is_operator_name(),
            none => true,
        });
    match (usable.first()) {
        some(text) => some(Spelling { text, request: none }),
        none => self.importable(entry.library, name, operator.value_or(name)),
    }
}

# The spelling of the builtin `name` of `library` that the file can import: `preferred`, or when
# something else in the file has that name, the builtin under a name that is free
# (`builtin_any`). An operator has no other name to take, so there is nothing.
fn importable(self: Item[], library: str, name: str, preferred: str) -> Spelling? {
    let text = if (!self.bound_names().contains(preferred)) {
        preferred
    } else {
        self.free_name(`builtin_{name}`)
    };
    // An operator has no other name to take.
    if (preferred != name && text != preferred) { return none; };
    let item = if (text == name) { name } else { `{name} as {text}` };
    some(Spelling { text, request: some(Request { library, item }) })
}

# `candidate`, or the first name made of it by adding `_` that nothing in the file has.
fn free_name(self: Item[], candidate: str) -> str {
    if (self.bound_names().contains(candidate)) {
        self.free_name(`{candidate}_`)
    } else {
        candidate
    }
}

# The operator that the builtin `self` provides, when it provides one: `+` for `wrapping_add`.
fn operator_provided(self: str) -> str? {
    operator_spellings().find_if(|operator| operator.operator_named_forms().contains(self))
}.test({
    assert("wrapping_add".operator_provided() == some("+"));
    assert("saturating_increment".operator_provided() == some("++"));
    assert("len".operator_provided() == none);
})

# Every name the file binds itself: the locals of its imports, whatever they import, and its own
# functions.
fn bound_names(self: Item[]) -> str[] {
    [
        ..self.collect_arms::<Import>()$imported_locals_of().join(),
        ..self.collect_arms::<LoweredFn>()$function_name(),
    ]
}

fn imported_locals_of(self: Import(ImportDecl { names })) -> str[] { names$local() }

fn function_name(self: LoweredFn(Function { name })) -> str { name.text }

# What the file's imports from `library` bring the export `name` in as, each spelling.
fn imported_under(self: Item[], library: str, name: str) -> str[] {
    self.collect_arms::<Import>()$locals_from(library, name).join()
}.test({
    let items = aipl_parse_surface_file(
        """import { len as size, len } from builtins; import { insert } from sets; import { len as mine } from "./a.aipl";""",
    )?.program.hoist_test_fns().items;
    assert(items.imported_under("builtins", "len") == ["size", "len"]);
    assert(items.imported_under("sets", "insert") == ["insert"]);
    assert(items.imported_under("sets", "len").is_empty());
})

fn locals_from(self: Import(ImportDecl { names, source }), library: str, name: str) -> str[] {
    match (source) {
        Builtins => if (library == "builtins") {
            names.filter(|n| n.name == name)$local()
        } else {
            []
        },
        Library(named) => if (library == named) {
            names.filter(|n| n.name == name)$local()
        } else {
            []
        },
        Path(..) => [],
    }
}
