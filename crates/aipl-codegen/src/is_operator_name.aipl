import { equal as ==, is_nonempty, logical_not as !, measure } from builtins;
import { operator_named_forms } from "./operator_named_forms.aipl";

# Whether `self` spells a built-in operator that must be imported to be used.
# Every operator is imported by aliasing its named builtin — `equal as ==`,
# `less_than as <`, `wrapping_add as +` — and none has a bare form.
# Used by the loader to gate operator imports and usage; dogfooded through the
# FFI.
#
# An operator is a spelling some named builtin provides, so the list of
# spellings is not written here: it is `operator_named_forms`'s table, asked
# whether it has an answer.
pub fn is_operator_name(self: str) -> bool { self.operator_named_forms().is_nonempty() }.test({
    // Every recognized operator spelling.
    assert("+".is_operator_name());
    assert("-".is_operator_name());
    assert("*".is_operator_name());
    assert("/".is_operator_name());
    assert("%".is_operator_name());
    assert("==".is_operator_name());
    assert("!=".is_operator_name());
    assert("<".is_operator_name());
    assert(">".is_operator_name());
    assert("<=".is_operator_name());
    assert(">=".is_operator_name());
    assert("&&".is_operator_name());
    assert("||".is_operator_name());
    assert("!".is_operator_name());
    assert("++".is_operator_name());
    assert("--".is_operator_name());
    assert("+++".is_operator_name());
    assert("+=".is_operator_name());
    assert("-=".is_operator_name());
    assert("*=".is_operator_name());
    assert("/=".is_operator_name());

    // Non-operators: names, near-misses, and the empty string.
    assert(!"wrapping_add".is_operator_name());
    assert(!"map".is_operator_name());
    assert(!"".is_operator_name());
    assert(!"=".is_operator_name()); // a single `=` is not an operator
    assert(!"%=".is_operator_name()); // no compound form for `%`
    assert(!"+++=".is_operator_name()); // nor for `+++`
    assert(!"&".is_operator_name()); // single, not `&&`
    assert(!"++++".is_operator_name()); // four, not `+++`
    assert(!"---".is_operator_name()); // three, not `--`
    assert(!"and".is_operator_name());
}).performance({
    // Asked of every identifier the loader sees, so ideally it allocates
    // nothing. `operator_named_forms` builds the array of named builtins an
    // operator is imported under, and this only asks whether that array is
    // empty: the call should inline and `is_nonempty` fuse into it, so no array
    // is ever built. Neither happens yet, and these pin what is true today: an
    // operator builds its one array (an array of two names, or of one), and a
    // name that is no operator builds none. The target is 0 for every row; when
    // an optimization gets there, these are the lines that change.
    assert(measure("two flavors", "+", is_operator_name).allocations == 1);
    assert(measure("one flavor", "==", is_operator_name).allocations == 1);
    assert(measure("not an operator", "map", is_operator_name).allocations == 0);
})
