// The error renderer's caret-block formatter: the compiler calls this through the
// FFI (see `install_parser_hooks`) when rendering an error with a span. Given
// `source` and `span` (a half-open byte range `[start, end)`), it returns the
// rustc-style location + underline block (no leading `error:`/`note:` label):
//
//   {pad}--> input:line:col
//   {pad} |
//   {line_no} | <source line>
//   {pad} | <indent>^^^
import {
    Span,
    equal as ==,
    len,
    less_than as <,
    max,
    min,
    repeat,
    saturating_sub as -,
    to_str,
    wrapping_add as +,
} from builtins;
import { line_at } from "./line_at.aipl";

pub fn caret_block(source: str, span: Span, filename: str) -> str {
    // `at.span` is the line's byte range, so the source line is one slice.
    let at = line_at(source, span.start);

    // Clamped to the line's own width. `line_at` answers a past-the-end offset
    // with the *last* line (it clamps, and is tested to), so without this the
    // column is the whole leftover byte count — and the caret row below is that
    // many spaces. An offset far past the end of a short file then renders tens
    // of thousands of spaces on one line, which a terminal wraps into screenfuls
    // of apparent blank lines. A span that does not belong to `source` is the
    // way that happens in practice, so this is a bound, not a formality.
    let line_len = at.span.end - at.span.start;
    let col = min(span.start - at.span.start, line_len);

    // The underline runs from the error's start to the earlier of its end and
    // the line's end, and is at least one column wide. `-` is `saturating_sub`,
    // so an empty or backwards span yields 0 rather than wrapping around on
    // these unsigned offsets, and `max` then widens it to 1.
    let width = min(at.span.end, span.end) - span.start;
    let underline_len = max(width, 1);
    let line_no = at.line + 1;
    let blank = " ".repeat(line_no.to_str().len());
    ```
        {blank}--> {filename}:{line_no}:{col + 1}
        {blank} |
        {line_no} | {source[at.span]}
        {blank} | {" ".repeat(col)}{"^".repeat(underline_len)}
    ```
}.test({
    assert(
        caret_block("hello world", Span { start: 0, end: 5 }, "input") == """
             --> input:1:1
              |
            1 | hello world
              | ^^^^^
        """,
    );
    assert(
        caret_block("hello\nworld", Span { start: 6, end: 11 }, "input") == """
             --> input:2:1
              |
            2 | world
              | ^^^^^
        """,
    );
    assert(
        caret_block("hello world", Span { start: 6, end: 11 }, "input") == """
             --> input:1:7
              |
            1 | hello world
              |       ^^^^^
        """,
    );
    // Zero-width span at col 0 gets at least one caret.
    assert(
        caret_block("hi", Span { start: 0, end: 0 }, "input") == """
             --> input:1:1
              |
            1 | hi
              | ^
        """,
    );
    // Span extending past line end is clamped to the line.
    assert(
        caret_block("hi\nthere", Span { start: 0, end: 10 }, "input") == """
             --> input:1:1
              |
            1 | hi
              | ^^
        """,
    );
    // Real filename appears in output.
    assert(
        caret_block("hello world", Span { start: 0, end: 5 }, "foo.aipl") == """
             --> foo.aipl:1:1
              |
            1 | hello world
              | ^^^^^
        """,
    );

    // A span that starts *past the end* of `source` — which is what a span
    // belonging to some other file looks like once it is rendered against this
    // one. `line_at` clamps to the last line and the column clamps to that
    // line's width, so the block stays the size of the source. Unclamped, the
    // caret row alone was `span.start` bytes of spaces.
    assert(
        caret_block("a\nb", Span { start: 5000, end: 5006 }, "input") == """
             --> input:2:2
              |
            2 | b
              |  ^
        """,
    );
    assert(caret_block("a\nb", Span { start: 5000, end: 5006 }, "input").len() < 40);
})
