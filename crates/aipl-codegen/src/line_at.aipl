// The error renderer's line locator: the compiler calls this through the FFI
// (see `install_parser_hooks`) when rendering an error with a span. Given
// `source` and a byte `offset`, it returns the 0-based line index and the
// line's byte range — from its first byte up to the '\n' terminator (or
// source.len() for the last line). The range is a `Span`, so a caller can
// slice the line straight out of the source with `source[at.span]`.
import { Span, len, wrapping_add as +, wrapping_increment as ++, ==, >= } from builtins;

struct LineAt { line: u64, span: Span }

pub fn line_at(source: str, offset: u64) -> LineAt {
    mut line: u64 = 0;
    mut line_start: u64 = 0;
    mut found = false;
    for (let i, c : source) {
        if (c == '\n') {
            if (found) {
                return LineAt { line, span: line_start..i };
            };
            if (i >= offset) {
                return LineAt { line, span: line_start..i };
            };
            set line++;
            set line_start = i + 1;
        };
        if (i >= offset) {
            set found = true;
        };
    }
    LineAt { line, span: line_start..source.len() }
}.test({
    assert(line_at("hello", 0) == LineAt { line: 0, span: 0..5 });
    assert(line_at("hello\nworld", 3) == LineAt { line: 0, span: 0..5 });
    assert(line_at("hello\nworld", 5) == LineAt { line: 0, span: 0..5 });
    assert(line_at("hello\nworld", 6) == LineAt { line: 1, span: 6..11 });
    assert(line_at("a\nb", 10) == LineAt { line: 1, span: 2..3 });
    assert(line_at("", 0) == LineAt { line: 0, span: 0..0 });
    assert(line_at("a\nb\nc", 4) == LineAt { line: 2, span: 4..5 });
})
