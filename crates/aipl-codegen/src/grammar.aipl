// A grammar, expressed as data. `Rule` is a PEG combinator tree — sequence,
// ordered choice, repetition, a rule reference — and a `Production` pairs one
// rule with everything the passes downstream need to know about it: the CST node
// name, the label errors should blame, the scope a highlighter should paint, and
// the function that lowers a matched node to the caller's AST. One `Grammar` is
// then the whole description of a language, interpreted by the driver in
// `parse.aipl`, exactly as `lexer.aipl` interprets a `TokenRule[]`.
//
// This file is data and one pass over it (`link`); nothing here parses. The
// split matters because the same grammar value is meant to feed more than the
// parser — an EBNF dump, a highlighter, a formatter — and each of those wants
// the description without the driver.
//
// **A rule set is written against a token *kind* type `K`**, the same `K` a
// `lexer.aipl` rule set produces, so a language's lexer and grammar compose
// directly: `Term(Name)` matches any token whose kind is a `Name`, payload
// ignored (a `Case<K>` compare, which is why `K` carries the `variant` bound).
//
// Two authoring notes that are compiler limits rather than design:
//
//   - An integer literal does not flex through a *positional* constructor
//     argument — the `0` types as `i64` where the payload is `u64` — but it does
//     through a keyword one. That is why `Many`'s minimum is a defaulted `min:`
//     rather than a bare `u64`: `Many(r)` is the common zero-or-more, and
//     `Many(r, min=1)` writes the literal where it flexes.
//   - Most `Rule` constructors mention no `K` (`Literal`, `Named`, `Then` over
//     an array of them), so nothing in them pins the type parameter. Write each
//     production's rule as an *annotated* binding — `let r: Rule<Kind> = ..` —
//     and every constructor inside it resolves from that annotation. The `.test`
//     blocks here and in `parse.aipl` are written in that idiom throughout.
import {
    Span,
    equal as ==,
    extend,
    find_index,
    is_some_and,
    join,
    len,
    less_than as <,
    logical_not as !,
    map,
    not_equal as !=,
    push,
    try_map,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;
import { Cst } from "./cst.aipl";

# Why a parse failed: a message, and the span of the offending source (absolute
# into the parsed string — slice it to show the offender, or hand it to
# `caret_block.aipl` for the rustc-style underline). Mirrors `lexer.aipl`'s
# `LexError`, and for the same reason: the two halves of a front end should
# report failure in one shape.
#
# A *grammar* error — an unresolved rule reference, a rule that can loop forever
# — has no source to point at and carries the empty `0..0`.
struct ParseError { message: str, span: Span }

# What a failed parse said — or, when it unexpectedly *succeeded*, a note
# carrying what it produced, so a broken assertion says which way it broke.
#
# For `.test` blocks, which is where the distinction matters: an assertion on a
# message that silently parses instead reads as a mismatched string with no clue
# why. Pairs with `map_ok`, which is what turns a parse of any AST type into the
# `str!ParseError` this takes: `parse_x(src).map_ok(render_x).failure_message()`.
pub fn failure_message(self: str!ParseError) -> str {
    match (self) {
        ok(s) => `unexpectedly parsed: {s}`,
        err(e) => e.message,
    }
}.test({
    let failed: str!ParseError = err(ParseError { message: "expected `)`", span: 3..4 });
    assert(failed.failure_message() == "expected `)`");

    let parsed: str!ParseError = ok("(a b)");
    assert(parsed.failure_message() == "unexpectedly parsed: (a b)");
})

# One precedence level of a `Climb`: the operators that share it, how tightly
# they bind (`power`, higher wins), and whether they associate to the right.
# Levels are matched in order, so a spelling belongs to exactly one.
struct Prec { power: u64, right: bool, ops: str[] }

# One rule shape, as plain data. Ordered choice makes this a PEG, not a CFG:
# `OneOf` commits to the first alternative that matches, so alternatives are
# tried in the order written and there is no ambiguity to resolve.
variant Rule<K: variant> =
    // Any one token whose kind is the case `k` — `Term(Name)` matches every
    // identifier, whatever text it carries. The one place a rule looks at a
    // token's *kind* rather than its text. `k` is a `Case<K>`, which is a case
    // with no payload: naming a kind takes no value of that kind, so there is no
    // dummy to invent and none to accidentally read.
    | Term(Case<K>)
    // One token whose source text is exactly `s`. Punctuation and keywords,
    // matched by what they are written as rather than by the kind that lexed
    // them — the counterpart of `Term`, which asks the kind and ignores the
    // text. Grammar files conventionally import it aliased (`Literal as Lit`):
    // it is by far the most-written rule in any real grammar, and the short form
    // is what keeps a production on one line. A convention, not a requirement —
    // `grammar_calc.aipl` imports it unaliased, its own AST having a `Lit` case
    // already, and an import colliding with a local is a hard error.
    | Literal(str)
    // Every rule in order; the matched children concatenate.
    | Then(Rule<K>[])
    // The first alternative that matches, in order.
    | OneOf(Rule<K>[])
    // `r` repeated until it stops matching, at least `min` times and at most
    // `max` — the defaults are a PEG `*`, `Many(r, min=1)` is a `+`, and
    // `Many(r, min=1, max=1)` is exactly one. A rule that can match empty input
    // would spin here forever, so the driver refuses one outright rather than
    // hanging.
    //
    // A bound stops the repetition rather than failing it: the items past `max`
    // are simply not this rule's, and the enclosing rule sees them. That is what
    // makes `min=1, max=1` mean "one item, in brackets" when it carries a
    // `nested_in` — a group that holds one thing rather than a list.
    //
    // `trailing_sep` still applies at the bound. A separator after the last item
    // ends the list rather than starting the item that would have been next, so
    // `Many(x, sep=comma, max=2)` takes `1, 2,` whole — the same answer it
    // gives when the items run out instead.
    //
    // With a `sep` it is a *separated* list: `r`, then `sep r` for as long as
    // the separator keeps appearing. `trailing_sep` decides what happens to a
    // separator with nothing after it — consumed (`[1, 2,]` is the list) or
    // rewound and left for the enclosing rule to complain about.
    //
    // `sep` and `max` are both written with the `?` on the *name*: a caller
    // gives the rule itself (`sep=Lit(",")`), and leaving it out is what yields
    // `none`. A caller that already holds an optional — `link_rule` and
    // `desugar_rule`, rebuilding a rule they took apart — forwards it with
    // `sep?=..`.
    //
    // The two are orthogonal, and between them one rule covers every list a
    // grammar writes. An LR grammar spells each combination as its own wrapper
    // production around a left-recursive pair — `x_list | x_list COMMA | _` —
    // and which of the four you picked is the thing that is easy to get subtly
    // wrong; here it is two arguments with names.
    //
    // `nested_in` is the bracketed-list shorthand: given `(open, close)` it is a
    // bracket pair around this `Many`, which is what makes it a *group* before
    // anything else runs. Nearly every bracket pair in a real grammar holds a
    // list, and writing the brackets as an argument of the list beats wrapping
    // the list in a separate rule — `Many(param, sep=comma, nested_in=parens())`
    // against a separate production wrapping the list in brackets.
    //
    // The list's *style* is read off the `Many` rather than restated: `sep` from
    // this rule's own separator and `trailing` from `trailing_sep`, which is the
    // same fact said once instead of twice (strict JSON's `[1, 2,]` is an error
    // *and* is never printed). Only `spaced` — whether flat brackets take inner
    // spaces, `{ a, b }` against `(a, b)` — cannot be derived, so it is here.
    //
    // A pair, so "exactly two brackets" is the type rather than a length
    // `desugar` has to check and a caller has to get right. It was an array
    // until generic tuples worked — a tuple whose elements mention a type
    // variable has no layout until monomorphization binds it, which is now
    // what `lt_ty` defers to `instantiate_generic`.
    //
    // `style` states the group's layout outright instead of deriving it, and is
    // what lets a bracket pair hold something whose list lives one production
    // down: `(args)` is a group that wraps like a comma list, but the `Many`
    // holding it has no separator of its own to read one off — `args` does.
    // Given, it replaces the derivation entirely, `spaced` included.
    //
    // The freedom is real and so is the hazard: nothing checks a stated `sep`
    // against the one the rule actually matches, so a style that disagrees makes
    // the printer write a separator the parser will not accept. Derive where you
    // can, state it where the list is not this rule's.
    //
    // The shape that needs stating is a group holding a list that lives one
    // production down, and inlining the list into the group removes it — at
    // which point this argument, and the disagreement it admits, both go away.
    // Which of those wrapper productions can fold is what the lowering decides;
    // `PARSER_LIBRARY.md`'s 5d carries the plan.
    | Many(
        Rule<K>,
        min: u64 = 0,
        max?: u64 = none,
        sep?: Rule<K> = none,
        trailing_sep: bool = true,
        nested_in?: (Rule<K>, Rule<K>) = none,
        spaced: bool = false,
        style?: ListStyle = none,
        group?: u64 = none
    )
    // `r`, or nothing. Always matches.
    | Maybe(Rule<K>)
    // A reference to the production called `n`. `link` rewrites every one of
    // these to a `NamedIdx`, so the driver never compares strings.
    | Named(str)
    // A reference to production `i`, and the *only* rule that builds a CST node
    // — one `CTree(i, ..)` per reference matched.
    | NamedIdx(u64)
    // Precedence climbing — an `atom`, then binary operators drawn from `precs`,
    // nested by binding power. Each application nests under the *enclosing*
    // production's index, so `1 + 2 * 3` yields a node per operand rather than
    // one flat run.
    | Climb(Rule<K>, Prec[])

# How a production's matched node becomes a value of the caller's AST type `A`:
# a function from the source text, the node itself, and the already-lowered
# values of its interior children (`nodes`, in match order). It may fail —
# a literal that overflows, a duplicate key — with a `ParseError` the driver
# passes straight through.
#
# A one-arm variant rather than a bare function type, so a later arm can be
# added without every grammar changing shape. It stays one arm deliberately: a
# payload-free `NoLower` would pin no `A` of its own, leaving nothing to infer
# the type parameter from, so a production with nothing to lower passes a
# trivial named function instead.
#
# Function values are non-capturing and non-generic (`check.rs`), so each is a
# named top-level `fn lower_x(src: str, node: Cst, kids: A[]) -> A!ParseError`.
# They also can't be compared with `==`, which is why the tests below assert on
# what a grammar *parses*, never on a grammar value — the same constraint
# `lexer.aipl` lives with.
variant Build<A: any> = Mk((str, Cst, A[]) -> A!ParseError)

# How a bracketed list lays out: what separates its items, whether the brackets
# take inner spaces while the list stays on one line (`{ a, b }` against
# `(a, b)`), and whether a separator is written after the last item once it
# breaks.
#
# The brackets themselves are not here: they are the `open` and `close` rules of
# the repetition this style belongs to, matched from the source like anything
# else. A style is only the handful of decisions the brackets cannot answer. An
# empty `sep` is the juxtaposed list, where items are separated by nothing but
# the space between them: `(a b c)`, and every S-expression ever written. A group
# holding one thing rather than a list — `(expr)` — is the same shape with no
# separator ever reached.
# `wraps: false` is the group that is a bracket pair and nothing more. A block
# `{ .. }` is one: it is a pair the parser should know about, so an unclosed brace
# is reported against the brace that opened it, but its contents are statements
# rather than a list and breaking them at a width is not what a formatter does
# with them. Such a group lays out `Inline`, like any other run of children.
#
# In the `nested_in` shorthand it is not written by hand: a `Many` bounded at one
# item is not a list, so `desugar` reads `wraps: false` off `max=1`.
struct ListStyle { sep: str = ",", spaced: bool = false, trailing: bool = true, wraps: bool = true }

# How a production's matched children are joined into a `Doc` — the formatting
# half of a language description, read by `format.aipl` exactly as `Rule` is
# read by `parse.aipl`.
#
# The vocabulary is deliberately small, and it is not the whole of a formatter:
# comment attachment, call hugging and chain breaking are judgement about
# *this* language and do not fall out of any grammar. What these two do cover is
# the mechanical majority — the productions whose layout is fully determined by
# the tokens they matched.
#
# Wrapping is not here, and that is the point of `nested_in`. Where a list breaks
# is a property of the bracket pair holding it, not of the production the pair
# happens to sit in, so it is written at the brackets and read back off the
# `CGroup` node they build. A production may hold several groups, each with its
# own style — `match (e) { .. }` is two — which is exactly what a single field on
# the production could not say.
variant Layout =
    // The children in order with nothing inserted between them: `-x`, `a.b`,
    // `i64?[]`. The layout for a production whose parts are written together.
    | Tight
    // The children in order, with a space between two of them exactly where the
    // spacing rule passed to `format_cst` says one belongs. The default, and
    // what a production that only passes a child through wants — a lone child
    // has no gaps to decide.
    | Inline

# One named production: its rule, and what each downstream pass needs from it.
#
# `name` is both the reference target (`Named("expr")`) and the CST node's name.
# `expect_as` is the label an error blames when this production fails having
# matched nothing — the reified form of the LR parser's `SYMBOL_DISPLAY_NAMES`,
# which collapses `expr`/`term`/`unary`/`atom` to one word. Empty means
# *transparent*: a plumbing production never surfaces in a message, and the
# finer expectations from inside it are what the reader sees. `scope` is the
# highlighter hint; it is carried, not yet consumed. `layout` is how the
# formatter joins what this production matched.
#
# `layout` has no default, unlike the two hints above it, and that is the
# compiler's decision rather than the design's: a struct field's default must be
# a literal, and `Layout` has no literal form. A bare `= Inline` is refused
# ("unknown identifier"), `Layout?` is refused as a field type because `Layout`
# is not recursive and so is not boxed, and a `= inline()` call *is* accepted but
# is then resolved in every file that constructs a `Production` — so a grammar
# that never mentions layout would have to import a function it never names, and
# the error when it forgets points at an unrelated line. Spelling the layout out
# is the honest version of that, and a grammar saying how each production prints
# beside how it parses is the whole point of the field.
struct Production<K: variant, A: any> {
    name: str,
    rule: Rule<K>,
    build: Build<A>,
    expect_as: str = "",
    scope: str = "",
    layout: Layout,
}

# A whole language: its productions, in order. Position is identity — a
# `NamedIdx` and a `CTree` both name a production by its index here — so the
# order of this array is part of a linked grammar's meaning.
#
# `groups` is the same idea for bracket pairs: `link` collects every bracketed
# `ListStyle` into it, in the order the rules mention them, and stamps the rule
# with the entry's index. A `CGroup` node then carries that index rather
# than a style, which keeps the CST as free of layout as it is of production
# names. It is empty on an unlinked grammar and written only by `link`, so no
# grammar file ever spells it out.
struct Grammar<K: variant, A: any> { prods: Production<K, A>[], groups: ListStyle[] = [] }

# The production names of `g`, in index order — the table `show` renders a
# tree against, and what `link` resolves references through.
pub fn prod_names<K: variant, A: any>(g: Grammar<K, A>) -> str[] { g.prods.map(|p| p.name) }

# Every group style in `r`, in the order the rules mention them: a group's own
# style first, then the styles inside its brackets. That order is the contract
# with `link_rule`, which hands out indices by walking the same tree the same
# way — get the two out of step and a `CGroup` names another group's style.
#
# Both spellings answer, so an already-linked rule reports the same list as the
# rule it was linked from, which is what makes `link` idempotent.
fn group_styles<K: variant>(r: Rule<K>) -> ListStyle[] {
    match (r) {
        // `map(group_styles)` is refused — a function *value* cannot be generic —
        // and the forwarding lambda that remains is what the lint objects to, so
        // the two rule each other out and the squelch is the only spelling left.
        Then(rs) | OneOf(rs) => rs.map(|sub| group_styles(sub)).join(), #[allow]
        // A bracketed repetition is a group, and its own style comes first —
        // before the brackets' insides and before its own body. `link_rule`
        // hands out indices by walking this same tree the same way.
        Many(sub, _, _, sep, _, nested_in, _, style, _) => match (nested_in) {
            some(brackets) => [
                style.value_or(ListStyle {}),
                ..group_styles(brackets.0),
                ..group_styles(sub),
                ..opt_group_styles(sep),
                ..group_styles(brackets.1),
            ],
            none => [..group_styles(sub), ..opt_group_styles(sep)],
        },
        Maybe(sub) => group_styles(sub),
        Climb(atom, _) => group_styles(atom),
        Term(..) | Literal(..) | Named(..) | NamedIdx(..) => [],
    }
}

# `group_styles` reaching inside an optional, which `map` cannot.
fn opt_group_styles<K: variant>(r: Rule<K>?) -> ListStyle[] {
    match (r) {
        some(sub) => group_styles(sub),
        none => [],
    }
}

# How many groups `r` holds — the amount `base` advances past it.
fn group_count<K: variant>(r: Rule<K>) -> u64 { group_styles(r).len() }

# `r` with every bracketed repetition's style settled: stated, or read off the
# rule it belongs to.
#
# Run before anything else looks at a rule, so the style a group carries is
# already the one it means by the time the driver, the formatter, the EBNF dump
# or the FIRST sets see it. The rule shape is unchanged — a bracketed `Many` is
# the storage form as well as the written one — so this only ever fills the slot
# a caller left empty.
#
# The style is derived here — `sep` from the list's own separator, `trailing`
# from `trailing_sep`, `spaced` as given — so a grammar states each of those
# once. `wraps` comes from `max`: a `Many` in brackets is a list by construction
# and lists wrap, *unless* it is bounded at one item, which makes it a bracket
# pair holding one thing (`(expr)`, a block's braces) rather than a list. There
# is nothing to break at a width in that case, so it lays out inline.
pub fn desugar_rule<K: variant>(r: Rule<K>) -> Rule<K>!ParseError {
    match (r) {
        Many(sub, min, max, sep, trailing_sep, nested_in, spaced, style, _) => {
            // `none` reads as "no bound", which is never below the minimum — so
            // the check needs no case of its own for it.
            let cap = max.value_or(min);
            if (cap < min) {
                return err(ParseError {
                    message: `a repetition's max must be at least its min, got min={min}, max={cap}`,
                    span: 0..0,
                });
            };

            // The brackets are a pair or absent — there is no third case to
            // check, which is the whole of what the tuple bought over an array.
            match (nested_in) {
                none => ok(Many(
                    desugar_rule(sub)?,
                    min=min,
                    max?=max,
                    sep?=desugar_opt(sep)?,
                    trailing_sep=trailing_sep,
                    spaced=spaced,
                )),
                some(brackets) => {
                    // Stated, or read off the rule: the separator from its own
                    // `sep`, `trailing` from `trailing_sep`, `spaced` as given,
                    // and `wraps` from `max` — a repetition bounded at one item
                    // is a bracket pair rather than a list, so it has nothing to
                    // break at a width.
                    let derived = ListStyle {
                        sep: sep_spelling(sep)?,
                        spaced,
                        trailing: trailing_sep,
                        wraps: !max.is_some_and(|m| m == 1),
                    };
                    ok(Many(
                        desugar_rule(sub)?,
                        min=min,
                        max?=max,
                        sep?=desugar_opt(sep)?,
                        trailing_sep=trailing_sep,
                        nested_in=(desugar_rule(brackets.0)?, desugar_rule(brackets.1)?),
                        spaced=spaced,
                        style=style.value_or(derived),
                    ))
                },
            }
        },
        Then(rs) => ok(Then(desugar_rules(rs)?)),
        OneOf(rs) => ok(OneOf(desugar_rules(rs)?)),
        Maybe(sub) => ok(Maybe(desugar_rule(sub)?)),
        Climb(atom, precs) => ok(Climb(desugar_rule(atom)?, precs)),
        Term(k) => ok(Term(k)),
        Literal(s) => ok(Literal(s)),
        Named(n) => ok(Named(n)),
        NamedIdx(i) => ok(NamedIdx(i)),
    }
}

# How the printer should write this list's separator: the spelling of the `Many`'s
# own separator, or the empty string for a juxtaposed list with none.
#
# A separator that is not a literal has no spelling to write back, so a grammar
# that brackets such a list is refused rather than guessed at — the alternative
# is a formatter that silently drops the separator when the list breaks.
fn sep_spelling<K: variant>(sep: Rule<K>?) -> str!ParseError {
    match (sep) {
        none => ok(""),
        some(r) => match (r) {
            Literal(s) => ok(s),
            Term(..)
            | Then(..)
            | OneOf(..)
            | Many(..)
            | Maybe(..)
            | Named(..)
            | NamedIdx(..)
            | Climb(..) => err(ParseError {
                message: "a bracketed list's separator must be a literal, so the printer can write it back",
                span: 0..0,
            }),
        },
    }
}

fn desugar_opt<K: variant>(r: Rule<K>?) -> Rule<K>?!ParseError {
    match (r) {
        some(sub) => ok(some(desugar_rule(sub)?)),
        none => ok(none),
    }
}

fn desugar_rules<K: variant>(rs: Rule<K>[]) -> Rule<K>[]!ParseError {
    // Generic, so it has no function value to pass; the lint's advice does not
    // compile here — see `group_styles` for the same pair of rules colliding.
    rs.try_map(|r| desugar_rule(r)) #[allow]
}

# One rule with every `Named(n)` in it rewritten to `NamedIdx(i)` and every
# bracketed repetition given its entry in the grammar's `groups` table. Fails
# when a reference names no production — the error a grammar author most wants
# caught before a parse rather than during one.
#
# `base` is the index the first group in `r` takes; the rest follow in
# `group_styles` order. It is threaded by arithmetic rather than by a running
# counter because a rule is a tree and `try_map` has nowhere to keep one.
fn link_rule<K: variant>(r: Rule<K>, names: str[], base: u64) -> Rule<K>!ParseError {
    match (r) {
        Named(n) => ok(NamedIdx(
            names
                .find_index(|x| x == n)
                .value_or_err(ParseError { message: `no rule named "{n}"`, span: 0..0 })?,
        )),
        Then(rs) => ok(Then(link_rules(rs, names, base)?)),
        OneOf(rs) => ok(OneOf(link_rules(rs, names, base)?)),
        // A bracketed repetition takes `base` for itself and its insides follow,
        // in the order `group_styles` reports them. Relinking one lands here too
        // and reassigns the same index, which is what keeps `link` idempotent —
        // and why the style rides on the rule rather than living in the table
        // alone.
        Many(sub, min, max, sep, trailing_sep, nested_in, spaced, style, _) => match (nested_in) {
            none => ok(Many(
                link_rule(sub, names, base)?,
                min=min,
                max?=max,
                sep?=link_opt(sep, names, base + group_count(sub))?,
                trailing_sep=trailing_sep,
                spaced=spaced,
                style?=style,
            )),
            some(brackets) => {
                let inner = base + 1 + group_count(brackets.0);
                let after_sub = inner + group_count(sub);

                // Bound rather than written into the tuple: `aipl fmt` breaks a
                // long tuple literal across lines with a trailing comma, which
                // the tuple grammar does not accept.
                let linked_open = link_rule(brackets.0, names, base + 1)?;
                let linked_close = link_rule(brackets.1, names, after_sub + opt_group_count(sep))?;
                ok(Many(
                    link_rule(sub, names, inner)?,
                    min=min,
                    max?=max,
                    sep?=link_opt(sep, names, after_sub)?,
                    trailing_sep=trailing_sep,
                    nested_in=(linked_open, linked_close),
                    spaced=spaced,
                    style?=style,
                    group=base,
                ))
            },
        },
        Maybe(sub) => ok(Maybe(link_rule(sub, names, base)?)),
        Climb(atom, precs) => ok(Climb(link_rule(atom, names, base)?, precs)),
        Term(k) => ok(Term(k)),
        Literal(s) => ok(Literal(s)),
        NamedIdx(i) => ok(NamedIdx(i)),
    }
}

# `group_count` reaching inside an optional, which `map` cannot.
fn opt_group_count<K: variant>(r: Rule<K>?) -> u64 { opt_group_styles(r).len() }

# A `Many`'s separator, linked — `none` stays `none`. Its own function because
# `?` cannot reach inside an optional.
fn link_opt<K: variant>(r: Rule<K>?, names: str[], base: u64) -> Rule<K>?!ParseError {
    match (r) {
        some(sub) => ok(some(link_rule(sub, names, base)?)),
        none => ok(none),
    }
}

# Each rule in `rs`, linked, with `base` advancing past the groups each one
# holds.
fn link_rules<K: variant>(rs: Rule<K>[], names: str[], base: u64) -> Rule<K>[]!ParseError {
    mut out: Rule<K>[] = [];
    mut b = base;
    for (let r : rs) {
        set out.push(link_rule(r, names, b)?);
        set b += group_count(r);
    }
    ok(out)
}

# `g` with every rule reference resolved: each `Named(name)` rewritten to the
# `NamedIdx(index)` of the production it names, so the driver resolves a
# reference by indexing rather than by comparing strings. Fails when a
# reference names no production, or when two productions share a name.
#
# Idempotent — a `NamedIdx` passes through — so a grammar may be linked once
# and reused, or handed to `parse` unlinked and linked per call.
pub fn link<K: variant, A: any>(g: Grammar<K, A>) -> Grammar<K, A>!ParseError {
    let names = prod_names(g);

    // Two productions of one name would make `Named` mean whichever came first
    // and leave the other unreachable — a typo that reads as a working grammar.
    for (let i, n : names) {
        if (let some(j) = names.find_index(|x| x == n)) {
            if (j != i) {
                return err(ParseError { message: `duplicate rule name "{n}"`, span: 0..0 });
            };
        };
    }

    // Group indices are handed out across the whole grammar, production by
    // production, so `base` carries over rather than restarting — one flat table
    // for the same reason `prods` is one: an index is the whole address.
    // Desugar first: a bracketed `Many` has its style settled — stated, or read
    // off the rule — before a group index is handed out, so what the table holds
    // is what the rule meant rather than what it wrote.
    mut prods: Production<K, A>[] = [];
    mut groups: ListStyle[] = [];
    for (let p : g.prods) {
        let rule = desugar_rule(p.rule)?;
        set prods.push(Production { ..p, rule: link_rule(rule, names, groups.len())? });
        set groups.extend(group_styles(rule));
    }
    ok(Grammar { prods, groups })
}.test({
    // A tiny grammar over one token kind: `list -> "(" item* ")"`, `item -> atom
    // | list`. Enough to have a reference reach back through another production,
    // which is what linking has to get right.
    let r_list: Rule<Kind> = Then([Literal("("), Many(Named("item")), Literal(")")]);
    let r_item: Rule<Kind> = OneOf([Term(Atom), Named("list")]);
    let g: Grammar<Kind, Node> = Grammar {
        prods: [
            Production { name: "list", rule: r_list, build: Mk(keep), layout: Inline },
            Production {
                name: "item",
                rule: r_item,
                build: Mk(keep),
                expect_as: "an item",
                layout: Inline,
            },
        ],
    };

    assert(prod_names(g) == ["list", "item"]);
    assert(prod_names(g).find_index(|x| x == "item") == some(1));
    assert(prod_names(g).find_index(|x| x == "nope") == none);

    let linked = link(g)?;
    // `item`'s two alternatives: a terminal, and a reference now an index.
    assert(rule_of(linked, 1) == OneOf([Term(Atom), NamedIdx(0)]));

    // The reference nested two levels down inside `list` is rewritten too, and
    // everything around it is left alone.
    assert(rule_of(linked, 0) == Then([Literal("("), Many(NamedIdx(1)), Literal(")")]));
    // Linking preserves the fields a rewrite doesn't touch.
    assert(prod_names(linked) == ["list", "item"]);
    assert(expect_of(linked, 1) == "an item");

    // Idempotent: a linked grammar links again to itself.
    assert(rule_of(link(linked)?, 1) == OneOf([Term(Atom), NamedIdx(0)]));

    // Every rule shape carries its reference, and every one is rewritten.
    let shapes: Grammar<Kind, Node> = Grammar {
        prods: [
            Production { name: "a", rule: Maybe(Named("a")), build: Mk(keep), layout: Inline },
            Production {
                name: "b",
                rule: Many(Named("a"), sep=Literal(",")),
                build: Mk(keep),
                layout: Inline,
            },
            Production {
                name: "c",
                rule: Climb(Named("a"), [Prec { power: 1, right: false, ops: ["+"] }]),
                build: Mk(keep),
                layout: Inline,
            },
            Production {
                name: "d",
                rule: Many(Named("b"), min=1),
                build: Mk(keep),
                layout: Inline,
            },
        ],
    };
    let ls = link(shapes)?;
    assert(rule_of(ls, 0) == Maybe(NamedIdx(0)));
    assert(rule_of(ls, 1) == Many(NamedIdx(0), sep=Literal(",")));
    assert(rule_of(ls, 2) == Climb(NamedIdx(0), [Prec { power: 1, right: false, ops: ["+"] }]));
    assert(rule_of(ls, 3) == Many(NamedIdx(1), min=1));

    // An unresolved reference is a grammar error, named in the message.
    let bad: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: Named("missing"), build: Mk(keep), layout: Inline }],
    };
    assert(link(bad) == err(ParseError { message: "no rule named \"missing\"", span: 0..0 }));

    // So is a duplicate name — the typo that otherwise reads as a working grammar.
    let dup: Grammar<Kind, Node> = Grammar {
        prods: [
            Production { name: "a", rule: Literal("x"), build: Mk(keep), layout: Inline },
            Production { name: "a", rule: Literal("y"), build: Mk(keep), layout: Inline },
        ],
    };
    assert(link(dup) == err(ParseError { message: "duplicate rule name \"a\"", span: 0..0 }));

    // Groups are numbered across the whole grammar, a group before its insides,
    // in the order the rules mention them. `p` holds one directly and one nested
    // inside it; `q` follows, so its own group starts where `p` left off.
    let inner: Rule<Kind> = Many(
        Named("q"),
        min=1,
        max=1,
        nested_in=(Literal("["), Literal("]")),
        style=ListStyle { sep: ";" },
    );
    let outer: Rule<Kind> = Many(
        inner,
        min=1,
        max=1,
        nested_in=(Literal("("), Literal(")")),
        style=ListStyle {},
    );
    let q_rule: Rule<Kind> = Many(
        Term(Atom),
        min=1,
        max=1,
        nested_in=(Literal("{"), Literal("}")),
        style=ListStyle { spaced: true },
    );
    let nests: Grammar<Kind, Node> = Grammar {
        prods: [
            Production { name: "p", rule: outer, build: Mk(keep), layout: Inline },
            Production { name: "q", rule: q_rule, build: Mk(keep), layout: Inline },
        ],
    };
    let ns = link(nests)?;

    // Three groups: `p`'s outer, `p`'s inner, then `q`'s.
    assert(ns.groups == [ListStyle {}, ListStyle { sep: ";" }, ListStyle { spaced: true }]);

    // Linked, a group wears its index. The rule is otherwise the one written —
    // there is no second spelling to rewrite into.
    let linked_inner: Rule<Kind> = Many(
        NamedIdx(1),
        min=1,
        max=1,
        nested_in=(Literal("["), Literal("]")),
        style=ListStyle { sep: ";" },
        group=1,
    );
    assert(
        rule_of(ns, 0) == Many(
            linked_inner,
            min=1,
            max=1,
            nested_in=(Literal("("), Literal(")")),
            style=ListStyle {},
            group=0,
        ),
    );
    assert(
        rule_of(ns, 1) == Many(
            Term(Atom),
            min=1,
            max=1,
            nested_in=(Literal("{"), Literal("}")),
            style=ListStyle { spaced: true },
            group=2,
        ),
    );

    // Idempotent for groups too: the linked form still reports its own style, so
    // linking again rebuilds the same table rather than emptying it.
    assert(link(ns)?.groups == ns.groups);
    assert(rule_of(link(ns)?, 0) == rule_of(ns, 0));

    // ---------- the derived style ----------
    //
    // A bracketed list states no style: `,` comes from its separator, `trailing`
    // from `trailing_sep`, `spaced` as given, `wraps` from `max`. `desugar`
    // settles it before `link` collects it, so what the table holds is what the
    // rule meant rather than what it wrote.
    let sugar: Rule<Kind> = Many(
        Term(Atom),
        sep=Literal(","),
        trailing_sep=false,
        nested_in=(Literal("("), Literal(")")),
    );
    let short_g: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: sugar, build: Mk(keep), layout: Inline }],
    };
    assert(link(short_g)?.groups == [ListStyle { sep: ",", trailing: false }]);

    // A group bounded at one item is not a list, so `wraps` comes off `max` and
    // the shorthand says "a bracket pair holding one thing" without restating it.
    let single: Rule<Kind> = Many(Term(Atom), min=1, max=1, nested_in=(Literal("("), Literal(")")));
    let single_g: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: single, build: Mk(keep), layout: Inline }],
    };
    assert(link(single_g)?.groups == [ListStyle { sep: "", wraps: false }]);

    // A maximum below the minimum is a rule that could never match.
    let backwards: Rule<Kind> = Many(Term(Atom), min=2, max=1);
    let back_g: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: backwards, build: Mk(keep), layout: Inline }],
    };
    assert(
        link(back_g) == err(ParseError {
            message: "a repetition's max must be at least its min, got min=2, max=1",
            span: 0..0,
        }),
    );

    // A juxtaposed list — no separator — carries the empty spelling, and
    // `spaced` is the one thing the `Many` cannot answer for itself.
    let words: Rule<Kind> = Many(Term(Atom), nested_in=(Literal("{"), Literal("}")), spaced=true);
    let words_g: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: words, build: Mk(keep), layout: Inline }],
    };
    assert(link(words_g)?.groups == [ListStyle { sep: "", spaced: true }]);

    // "Two brackets exactly" used to be a length check with a message of its
    // own, asserted here. It is the type now — `nested_in` is a pair — so there
    // is nothing left to assert: a caller that writes one bracket, or three,
    // does not compile. What remains checkable is the separator, below.

    let odd_sep: Rule<Kind> = Many(
        Term(Atom),
        sep=Term(Atom),
        nested_in=(Literal("("), Literal(")")),
    );
    let odd_g: Grammar<Kind, Node> = Grammar {
        prods: [Production { name: "a", rule: odd_sep, build: Mk(keep), layout: Inline }],
    };
    assert(
        link(odd_g) == err(ParseError {
            message: "a bracketed list's separator must be a literal, so the printer can write it back",
            span: 0..0,
        }),
    );

    // A group's insides are linked like anything else, and an unresolved
    // reference inside one is still the grammar error it would be outside.
    let bad_nest: Grammar<Kind, Node> = Grammar {
        prods: [
            Production {
                name: "a",
                rule: Many(Named("nope"), min=1, max=1, nested_in=(Literal("("), Literal(")"))),
                build: Mk(keep),
                layout: Inline,
            },
        ],
    };
    assert(link(bad_nest) == err(ParseError { message: "no rule named \"nope\"", span: 0..0 }));
})

// ---------- test-only fixtures ----------
//
# A token-kind type and an AST type for the `.test` block above. A real consumer
# declares its own pair; these exist because a `Grammar<K, A>` cannot be written
# down without both. (`Kind` rather than a `Kind` *constructor*: a constructor
# colliding with another top-level name in the same file is silently dropped —
# see the naming note in `PARSER_LIBRARY.md`.)
variant Kind = Atom(str) | Open | Close

variant Node = NAtom(str) | NList(Node[])

# The trivial lowering a production with nothing to lower passes, and all these
# fixtures need: `Build` has no payload-free arm to mean "don't".
fn keep(src: str, node: Cst, kids: Node[]) -> Node!ParseError { ok(NList(kids)) }

# The rule of production `i` of `g`, for the assertions above — a grammar value
# can't be compared with `==` (it holds function values), but the rule inside one
# can.
fn rule_of<K: variant, A: any>(g: Grammar<K, A>, i: u64) -> Rule<K> {
    match (g.prods[i]) {
        some(p) => p.rule,
        none => Literal(""),
    }
}

fn expect_of<K: variant, A: any>(g: Grammar<K, A>, i: u64) -> str {
    match (g.prods[i]) {
        some(p) => p.expect_as,
        none => "",
    }
}
