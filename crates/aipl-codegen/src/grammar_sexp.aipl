# S-expressions: the library's first end-to-end target, and deliberately the
# floor rather than a warm-up. Two productions —
#
#     list -> "(" item* ")"
#     item -> Atom | list
#
# — where `item` reaches `list` and `list` reaches back through `item`, which is
# the whole point: a non-recursive toy (a comma-separated integer list, key/value
# lines) would exercise none of what the driver is actually built on. This one
# forces a **recursive CST** (a `Cst` boxed through an array), a **parse as deep
# as its input**, and a lowering to a **boxed AST** reached through a function
# *value* — the `(str, Cst, A[]) -> A!ParseError` shape with `A` boxed.
#
# Recursive descent spends a stack frame per level and none of those calls is in
# tail position, so parse depth is bounded by the stack rather than by the heap.
# Measured on the 8 MB an ordinary binary gets: `((( ... )))` nests fine at 1,000
# levels and segfaults somewhere before 2,000, which is why the deep test below
# sits at 200 — deep enough that a regression in frame size would show, with room
# to spare.
#
# It deliberately omits precedence, more than one terminal class, separators, and
# error-message subtlety: if the driver is wrong, it is wrong here in two
# productions rather than in ten. `grammar_json.aipl` adds the rest.
#
# The file is also the worked example of what a consumer of this library brings:
# a token-kind type, a `TokenRule[]` for it, an AST, one `lower_*` per
# production, and a `Grammar` tying them together. Nothing else — the parse
# itself is `parse.aipl`'s, unmodified.

import { equal as ==, first, map_err, map_ok, to_set } from builtins;
import { Cst, Parts, show, text, token_text } from "./cst.aipl";
import { ebnf, show_first_sets } from "./ebnf.aipl";
import { render_cst } from "./format.aipl";
import {
    Grammar,
    Inline,
    Kids,
    Literal as Lit,
    Many,
    Mk,
    Named,
    OneOf,
    ParseError,
    Production,
    Rule,
    Term,
    failure_message,
    prod_names,
} from "./grammar.aipl";
import { Bare, CharRun, LexResult, Of, OneChar, ToEol, TokenRule, lex } from "./lexer.aipl";
import { parse, parse_cst } from "./parse.aipl";
import { Atom as AtomNode, List, Sexp, render_sexp } from "./sexp.aipl";

# The token kinds. One terminal class carrying its text, and one bare kind for
# the parentheses — the grammar matches those by `Lit`, so their kind never
# has to be distinguished.
variant SexpKind = Atom(str) | Punct

# Whitespace and `;` comments are recorded as **trivia** rather than skipped, so
# the concrete tree covers every byte of the source and reconstructs it exactly
# (asserted below). An atom is a run of the usual Lisp symbol characters, which
# includes digits — this grammar has no number type, so `12` is just an atom.
fn sexp_rules() -> TokenRule<SexpKind>[] {
    let space: char[] = " \t\r\n";
    let sym: char[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+-*/<>=!?_.";
    [
        TokenRule { matcher: CharRun(space.to_set()), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: ToEol(";"), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: CharRun(sym.to_set()), emit: Of(Atom) },
        TokenRule { matcher: OneChar(#{'(', ')'}), emit: Bare(Punct) },
    ]
}

# An `item` is one of its two alternatives, told apart by whether it got an
# interior child: the `list` branch lowered one, and the `Atom` branch matched a
# bare token, whose spelling is the node's own text with trivia dropped.
fn lower_item(src: str, Parts { cst }, kids: Sexp[]) -> Sexp {
    match (kids.first()) {
        some(inner) => inner,
        none => AtomNode(cst.token_text(src)),
    }
}

# The S-expression grammar: `list -> "(" item* ")"` and `item -> Atom | list`,
# with `item` as the start rule so a bare atom is as much a program as a list
# is.
#
# `item` is labelled and `list` is transparent, so a failure inside a list
# reports as "an s-expression" rather than as the grammar's internals — the
# collapse `expect_as` exists for.
pub fn sexp_grammar() -> Grammar<SexpKind, Sexp> {
    // A list is bracketed and its elements are separated by nothing but the space
    // between them — the juxtaposed list, and no trailing anything to write when
    // it breaks. The style rides on the bracket pair, which is the thing it
    // describes.
    let r_list: Rule<SexpKind> = Many(
        Named("item"),
        trailing_sep=false,
        nested_in=(Lit("("), Lit(")")),
    );
    let r_item: Rule<SexpKind> = OneOf([Term(Atom), Named("list")]);
    Grammar {
        prods: [
            // A `list` node's children are exactly its interior `item`s — the
            // parentheses are leaves, and leaves have no lowered value — so the
            // list *is* its kids.
            Production { name: "list", rule: r_list, build: Kids(List), layout: Inline },
            Production {
                name: "item",
                rule: r_item,
                build: Mk(lower_item),
                expect_as: "an s-expression",
                layout: Inline,
            },
        ],
    }
}.test({
    // The two productions of the header comment, rendered back out of the value
    // the driver parses with rather than written by hand next to it.
    assert(ebnf(sexp_grammar()) == """
        list = "(" item* ")" ;
        item = Atom | list ;
    """);

    // `item` begins with either — which is the recursion, seen from the front.
    assert(show_first_sets(sexp_grammar())? == """
        list = "("
        item = Atom "("
    """);
})

# Lexing and parsing report failure in the same shape but not the same type, so
# the conversion happens once, here.
fn lex_sexp(src: str) -> LexResult<SexpKind>!ParseError {
    src.lex(sexp_rules()).map_err(|e| ParseError { message: e.message, span: e.span })
}

# The lossless concrete tree for `src` — every byte of it under exactly one
# leaf, comments and whitespace included. Use this when the tree is the point;
# `parse_sexp` when only the `Sexp` is.
pub fn sexp_cst(src: str) -> Cst!ParseError {
    parse_cst(src, lex_sexp(src)?, sexp_grammar(), "item")
}.test({
    // The concrete tree, rendered against the production names — the debug view a
    // tree assertion reads better as than a nested `CTree` literal.
    fn shown(src: str) -> str!ParseError {
        ok(sexp_cst(src)?.show(src, prod_names(sexp_grammar())))
    }

    // The tree the two productions build: one `item` node per element, and a
    // `list` node inside the `item` that took that alternative. The parentheses
    // are leaves of the `list`, since only a rule *reference* builds a node.
    //
    // The `~ ` leaves are the recorded whitespace, sitting in front of the token
    // that follows them — which is what makes the leaves tile the source.
    assert(shown("(a b)")? == "(item (list [( (item a) (item ~  b) )]))");
    assert(shown("a")? == "(item a)");
    assert(shown("()")? == "(item (list [( )]))");
    assert(shown("(a (b))")? == "(item (list [( (item a) (item (list [~  ( (item b) )])) )]))");

    // Losslessness: every byte of the source is under exactly one leaf, so the
    // leaves concatenate back to it — including the leading comment, the run
    // between two tokens, and the trailing newline no token consumption reaches.
    let src = "; head\n( a  b )\n";
    assert(sexp_cst(src)?.text(src) == src);

    // Where each piece landed, on a source small enough to read: trivia attaches
    // in front of the token that follows it, and what follows the last token
    // attaches to the root.
    let small = "(a) ; tail";
    assert(shown(small)? == "(item (list [( (item a) )]) ~  ~; tail)");
})

# The `Sexp` `src` denotes: lex, parse to a concrete tree, lower it through
# the grammar's `build` functions.
#
# Fails with a `ParseError` carrying the span of the offending token, from
# either half of the front end — a lex error is reported in the same shape.
pub fn parse_sexp(src: str) -> Sexp!ParseError {
    parse(src, lex_sexp(src)?, sexp_grammar(), "item")
}.test({
    // The message a failed parse reports — and a distinguishable string when it
    // unexpectedly succeeded, so a broken assertion says which way it broke.
    fn msg_of(src: str) -> str { parse_sexp(src).map_ok(render_sexp).failure_message() }

    // ---- the two productions, and the recursion between them ----
    assert(parse_sexp("a")? == AtomNode("a"));
    assert(parse_sexp("()")? == List([]));
    assert(parse_sexp("(a b)")? == List([AtomNode("a"), AtomNode("b")]));
    assert(parse_sexp("(a (b c) d)")? == List([
        AtomNode("a"),
        List([AtomNode("b"), AtomNode("c")]),
        AtomNode("d"),
    ]));
    // Nesting with nothing else in it — the shape the deep test scales up.
    assert(parse_sexp("(((x)))")? == List([List([List([AtomNode("x")])])]));

    // An atom is any run of symbol characters; this grammar has no numbers.
    assert(parse_sexp("(+ 1 2)")? == List([AtomNode("+"), AtomNode("1"), AtomNode("2")]));

    // ---- trivia is invisible to the AST ----
    //
    // Layout and comments are recorded rather than skipped, and lowering
    // reads spellings with `token_text`, so neither reaches the `Sexp`.
    let spaced = """
        ; a list
        ( a   ; the first
          b )
    """;
    assert(parse_sexp(spaced)? == List([AtomNode("a"), AtomNode("b")]));

    // ---- errors ----
    assert(
        msg_of(
            "(a",
        ) == "expected `)` or an s-expression, found end of input (`(` at line 1 is never closed)",
    );
    assert(msg_of(")") == "expected an s-expression, found `)`");
    assert(msg_of("") == "expected an s-expression, found end of input");
    // Every token must be consumed: two expressions is not one.
    assert(msg_of("a b") == "expected end of input, found `b`");
    // A lex failure reports in the same shape as a parse failure.
    assert(msg_of("(a #b)") == "unexpected character");
})

// ---------- test-only helpers ----------

# `src` reformatted: parse it to the concrete tree, then lay that out at `width`.
#
# Nothing here knows what an S-expression looks like. The layout is the two
# annotations on the grammar above, and everything else — where a list breaks,
# what happens to the author's blank lines, where a comment lands — is
# `format.aipl` reading them. That is the whole point of the exercise: a second
# hand-written walker over the same syntax is what this replaces.
pub fn format_sexp(src: str, width: u64) -> str!ParseError {
    render_cst(sexp_grammar(), src, sexp_cst(src)?, sexp_space, width)
}.test({
    // Whatever spacing the source had, the canonical one comes back.
    assert(format_sexp("(a   b)", 80)? == "(a b)");
    assert(format_sexp("(  a\n\n  (b   c)  )", 80)? == "(a (b c))");
    assert(format_sexp("a", 80)? == "a");
    assert(format_sexp("()", 80)? == "()");

    // Too wide to fit: one element per indented line, and no trailing separator
    // to add, this list having none to begin with.
    assert(format_sexp("(alpha beta gamma)", 10)? == "(\n    alpha\n    beta\n    gamma\n)\n");

    // Only the list that does not fit breaks: the outer one is too wide, the
    // inner one still fits on its indented line and stays flat.
    assert(
        format_sexp("(a (bb  cc) ddddddddd)", 20)? == "(\n    a\n    (bb cc)\n    ddddddddd\n)\n",
    );

    // A comment is not layout, so it survives — and, having ended a source
    // line, it still ends a line, which forces the list it sits in to break.
    assert(format_sexp("(a ; note\n b)", 80)? == "(\n    a\n    ; note\n    b\n)\n");

    // ---- the two properties a formatter has to have ----
    //
    // It does not change what the source means...
    let messy = "; head\n(  a  (b   c)   d )\n";
    assert(parse_sexp(format_sexp(messy, 80)?)? == parse_sexp(messy)?);
    // ...and formatting an already-formatted file changes nothing.
    let once = format_sexp(messy, 80)?;
    assert(format_sexp(once, 80)? == once);
    let narrow = format_sexp(messy, 10)?;
    assert(format_sexp(narrow, 10)? == narrow);
})

# S-expressions have no spacing rule to speak of: every separation in the
# language is a list separating its elements, which the `Wrap` layout does. The
# rule still has to exist — `format.aipl` asks every language the same question —
# and answering "never" is the honest answer here.
fn sexp_space(l: str, r: str) -> bool { false }
