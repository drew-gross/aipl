# The parser driver: one function that interprets a `Grammar` (see
# `grammar.aipl`) over a token stream (see `lexer.aipl`) and yields a lossless
# `Cst` (see `cst.aipl`), plus a second pass that lowers that tree to the
# caller's own AST through each production's `build`. Together they are the
# upper half of a front end whose lower half is already data-driven: a language
# is a `TokenRule[]` and a `Grammar`, and nothing else.
#
# **PEG, not LR.** `OneOf` commits to its first matching alternative, so a
# grammar is unambiguous by construction and a failed alternative simply
# backtracks. Two consequences the driver has to handle, and does:
#
#   - *Left recursion does not work.* `expr -> expr "+" term` would call itself
#     at the same position forever. Binary operators are spelled with `Climb`
#     instead, which is why that rule exists.
#   - *Errors need furthest-failure tracking.* Backtracking throws away the
#     position where a parse got the furthest, which is nearly always where the
#     mistake is. Every rule threads a `Far` — the deepest position anything was
#     expected at, and the set of things expected there — through both success
#     and failure, so the reported error is the deepest one, not the last.
#
# **Recovery is opt-in, per rule, with `Expect`.** A grammar that has already
# committed — after a keyword that opens one form only — wraps what must come
# next in `Expect`. A miss there is recorded as an error and the parse carries on
# as though the token had been written, so `parse_cst_recovering` can return every
# such error in a file, and no enclosing choice goes looking for another way
# through. A parse that succeeds reports the misses on the path it took; one that
# does not — it misses, or a `Refuse` ends it — reports every miss it met, then
# the failure. See `Expect` in `grammar.aipl` for the contract, and `match_expect`
# for the mechanics.
#
# **Two passes, not one.** `parse_cst` builds the tree; `lower` walks it calling
# `build`. Lowering during the parse would run a production's `build` inside
# speculative alternatives that then backtrack — wasted allocation at best, and
# at worst a `build` that legitimately fails aborting a parse that should simply
# have tried the next alternative. `parse` is the two in sequence.
#
# Costs worth knowing before this drives something large: trivia is attached by
# scanning the trivia list for each consumed token, so a parse is O(tokens ×
# trivia); and with no memoization a heavily-backtracking grammar can be
# exponential. Both are answered later in the plan — FIRST sets remove most
# backtracking — and neither matters at the sizes here.

import {
    Span,
    all,
    any,
    case_name,
    case_of,
    contains,
    equal as ==,
    extend,
    filter,
    find_if,
    find_index,
    first,
    is_empty,
    is_nonempty,
    is_some,
    is_some_and,
    join,
    last,
    left_fold,
    len,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    map_err,
    not_equal as !=,
    push,
    repeat,
    sort,
    sort_by,
    to_set,
    try_map,
    union,
    union_all,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;
import {
    Cst,
    Group,
    Leaf,
    Missing,
    Parts,
    Tree,
    Trivia,
    extent,
    parts,
    show,
    span,
    text,
    token_leaves,
    token_text,
} from "./cst.aipl";
import { First, can_start, first_sets } from "./ebnf.aipl";
import {
    Climb,
    Const,
    Expect,
    Fn,
    Grammar,
    Inline,
    Kid,
    Kids,
    ListStyle,
    Literal,
    Many,
    Maybe,
    Mk,
    Msg,
    Named,
    NamedIdx,
    OneOf,
    ParseError,
    Prec,
    Production,
    Refusal,
    Refuse,
    Rule,
    Term,
    Text,
    Then,
    TryKids,
    TryMk,
    TryText,
    failure_message,
    link,
    prod_names,
} from "./grammar.aipl";
import {
    Bare,
    CharRun,
    LexResult,
    Of,
    OneChar,
    SpanStr,
    ToEol,
    Token,
    TokenRule,
    lex,
} from "./lexer.aipl";
import { line_at } from "./line_at.aipl";

# The furthest failure seen so far: the token position nothing could be matched
# at, and the deduped labels of everything that *was* expected there.
#
# This is the reified form of what an LR table gives you for free — the state's
# expected-symbol set — and it is why `Production.expect_as` exists: under
# ordered choice a more specific alternative can fail deeper than the one that
# was really meant, so a label collapsing a family of rules to one word ("an
# expression") is what keeps the message readable.
struct Far {
    //
    // `recorded` is every `Expect` that found its rule missing so far, in the order the
    // parse met them — kept here, with the furthest failure, because this is the one
    // thing that travels with a parse through a miss as well as a hit. Which of them
    // *belong* to the parse that finally succeeds is not this list's to say (a path
    // abandoned after recording one is still in it); the tree knows that, through its
    // `Missing` markers. This is what there is when there is no tree: a parse that
    // missed, or was stopped. See `recovered_errors`.
    pos: u64,
    expected: str[],
    unclosed: Span[] = [],
    recorded: Slip[] = [],
}

# One `Expect` that found its rule absent: where it was wanted (a token index), what
# could have stood there, and the bracket left open at that point, if one was —
# the three things `error_at` words an error from, held until the source is at
# hand to word it with. The same three a `Missing` marker in the tree carries.
struct Slip { pos: u64, expected: str[], unclosed: Span[] }

# Why the driver stopped rather than missed: the error, and every `Expect` that had
# been recorded before it. `?` carries it out of whatever was in the middle of
# matching, which is how a `Refuse` ends a parse — and why the recorded ones ride
# on it, since the frames it unwinds are the only other place they were held.
#
# `input` says whose fault it is. A `Refuse` is the input's: the error is an error
# in the source and is reported with the recorded ones. Anything else (an
# unresolved reference, a rule that would loop) is the grammar's, and is the call's
# own failure.
struct Abort { error: ParseError, recorded: Slip[], input: bool }

# The `Abort` for a fault in the grammar, which no recorded error is about.
fn grammar_fault(message: str) -> Abort {
    error: ParseError { message, span: 0..0 },
    recorded: [],
    input: false,
}

# The `Abort` for a refusal: an error in the input, with what `far` had recorded.
fn refused(error: ParseError, Far { recorded }) -> Abort { error, recorded, input: true }

# One rule's result at one position: whether it matched, where it left off, the
# CST children it contributed to its parent, and the furthest failure so far.
#
# `hit: false` is an ordinary non-match — the caller backtracks and tries
# something else — and is *not* an error. An `Abort` is reserved for what no
# alternative could fix: a malformed grammar, or a `Refuse`.
struct Step { hit: bool, pos: u64, kids: Cst[], far: Far }

# What the driver parses against: the tokens, the trivia the lexer set aside,
# the linked productions, and `end` — one byte past the source's last byte.
#
# The source itself is *not* here. Every token carries its own text (a
# `SpanStr`, see `lexer.aipl`), so matching a rule spelling reads the token and
# nothing else. `end` is all that remains of the source: the empty span at end
# of input, which `error_at` reports when a rule ran off the token list and
# there is no token to point at.
struct Parser<K: variant, A: any> {
    toks: Token<K>[],
    // The CST children consuming each token contributes — the trivia in front of
    // it, then its own leaf — computed once by `attach_trivia`. See `leaf_at`.
    attached: Cst[][],
    // The trivia after the last token, which no token consumption can pick up.
    trailing: Cst[],
    prods: Production<K, A>[],
    end: u64,
    // The FIRST set of each production, in `prods` order — what `match_prod`
    // asks before descending. Computed once per parse (`first_sets`, a fixed
    // point over the grammar) and never during one.
    firsts: First<K>[],
    // The expectation labels each production would record on failing at its own
    // first token — what makes pruning invisible to error messages. See
    // `label_sets`.
    labels: #{str}[],
}

# `far` updated with "`label` was expected at `pos`". Deeper wins outright;
# equally deep joins the expected set (deduped); shallower is discarded. An
# empty label is a *transparent* production and records nothing.
fn far_miss(far: Far, pos: u64, label: str) -> Far {
    if (label.is_empty() || pos < far.pos) {
        return far;
    };
    if (far.pos < pos) {
        return Far { pos, expected: [label], recorded: far.recorded };
    };
    if (far.expected.contains(label)) {
        return far;
    };

    // A deeper position starts fresh, so its `unclosed` resets with it; an
    // equally deep one keeps whatever bracket was already blamed there.
    Far { ..far, expected: [..far.expected, label] }
}

# Both failures in one: the deeper of the two, or — at equal depth — what either
# expected there, and everything either recorded. The merge `far_miss` makes one
# label at a time, for a whole record. `a`'s blamed bracket wins a tie, as the first
# to be blamed does.
#
# `b` is a failure record that began empty at this point (`match_expect` starts one
# so its error says what *it* wanted), but carrying `a`'s `recorded` — a refusal
# inside the rule it matched aborts with what `b` holds, and that has to be
# everything met so far. So `b`'s `recorded` is the whole of it, and `a`'s is a
# prefix of it.
fn far_join(a: Far, b: Far) -> Far {
    let recorded = b.recorded;
    if (a.pos < b.pos) {
        return Far { ..b, recorded };
    };
    if (b.pos < a.pos) {
        return Far { ..a, recorded };
    };
    mut expected = a.expected;
    for (let label : b.expected) {
        if (!expected.contains(label)) {
            set expected.push(label);
        };
    }
    far_unclosed(Far { ..a, expected, recorded }, b.unclosed)
}

# `far` with the opening bracket that went unclosed at its position. Set by a
# bracketed repetition whose `open` matched and whose `close` did not, which is
# time anything knows a bracket was left hanging.
#
# It rides on the furthest failure rather than aborting the parse, because under
# ordered choice a group failing to close is an ordinary non-match: `(a)` is
# parsed by trying the tuple `(a, b)` first and letting it fail at the comma. So
# this only reaches the reader when *no* alternative worked, which is exactly
# when a hanging bracket is the likely cause.
#
# `match_nested` sets it only when the close was wanted past the last token —
# see there for why a closer failure is not evidence of anything.
# The first bracket to be blamed at a position keeps it. Groups fail from the
# inside out, so the first to record is the innermost one — and closing that is
# the edit the reader has to make first, even when an outer bracket is hanging
# too.
fn far_unclosed(far: Far, open: Span[]) -> Far {
    if (far.unclosed.is_nonempty()) {
        return far;
    };
    Far { ..far, unclosed: open }
}

# A non-match that leaves `pos` where the rule started (the caller backtracks).
fn no(far: Far, pos: u64) -> Step { hit: false, pos, kids: [], far }

# The span of the first token in `kids` — where a group's opening bracket was
# written, for the message when it is never closed. Empty when there is none.
#
# A one-element array rather than a `Span?` because that is what `Far` held when
# this was written: a struct field could then be an optional of an integer or an
# array, but not of another struct, and `Span` is one. A field may be an optional
# of a struct now, so `Far` could carry a `Span?` and this could return one —
# nought-or-one array and optional mean the same thing here.
fn first_token(kids: Cst[]) -> Span[] {
    kids.map(token_leaves).join().first().map(|sp| [sp]).value_or([])
}

# A non-match that also records what was expected.
fn miss(far: Far, pos: u64, label: str) -> Step { no(far_miss(far, pos, label), pos) }

# The source text of token `i`, or `""` past the end. Empty is a safe sentinel
# because no matcher in `lexer.aipl` ever produces an empty token.
fn tok_text<K: variant, A: any>(p: Parser<K, A>, i: u64) -> str {
    p.toks[i].map(|t| t.text.text).value_or("")
}

# The CST children consuming token `i` contributes: every trivia record between
# the previous token and this one, then the token's own leaf. Attaching trivia
# *before* its following token is what makes the leaf spans tile the source with
# no gaps, which is the whole losslessness property.
#
# Looked up, not computed: a PEG asks this once per token *per attempt*, and it
# attempts a token many times. Filtering the whole trivia list on each ask was
# quadratic in the file — the largest compiler sources took a minute to parse,
# and this one call was most of it. `attach_trivia` does the same pairing once,
# by one merge over the two sorted lists.
fn leaf_at<K: variant, A: any>(p: Parser<K, A>, i: u64) -> Cst[] { p.attached[i].value_or([]) }

# Every token's `leaf_at` children, in token order, and the trivia left after the
# last token. Both lists arrive sorted by position and never overlap, so one
# pass that advances through the trivia as it walks the tokens pairs them off
# exactly as the per-token filter did — each trivia record lands in front of the
# first token that starts after it.
fn attach_trivia<K: variant>(toks: Token<K>[], trivia: Token<K>[]) -> (Cst[][], Cst[]) {
    mut attached: Cst[][] = [];
    mut j: u64 = 0;
    for (let t : toks) {
        mut run: Cst[] = [];
        while (trivia_starts_before(trivia, j, t.text.span.start)) {
            set run.push(Trivia(trivia_span(trivia, j)));
            set j++;
        }
        set run.push(Leaf(t.text.span));
        set attached.push(run);
    }
    mut trailing: Cst[] = [];
    while (j < trivia.len()) {
        set trailing.push(Trivia(trivia_span(trivia, j)));
        set j++;
    }
    (attached, trailing)
}.test({
    // A token at a span, for the attachment test — only the position matters to it.
    fn tok_at(span: Span) -> Token<Tok> { kind: Punct, text: SpanStr { text: "", span } }

    // Two tokens with trivia before each and one trailing record: each record
    // lands in front of the first token that starts after it, and what is left
    // is the tail.
    let toks = [tok_at(2..3), tok_at(6..7)];
    let trivia = [tok_at(0..2), tok_at(3..6), tok_at(7..8)];
    let (attached, trailing) = attach_trivia(toks, trivia);
    assert(attached == [[Trivia(0..2), Leaf(2..3)], [Trivia(3..6), Leaf(6..7)]]);
    assert(trailing == [Trivia(7..8)]);

    // No trivia at all: a leaf per token and nothing trailing.
    let bare: Token<Tok>[] = [];
    let (only_leaves, nothing) = attach_trivia([tok_at(0..1)], bare);
    assert(only_leaves == [[Leaf(0..1)]]);
    let no_trailing: Cst[] = [];
    assert(nothing == no_trailing);
})

# Whether trivia record `j` exists and starts before `at`.
fn trivia_starts_before<K: variant>(trivia: Token<K>[], j: u64, at: u64) -> bool {
    trivia[j].is_some_and(|tr| tr.text.span.start < at)
}

fn trivia_span<K: variant>(trivia: Token<K>[], j: u64) -> Span {
    trivia[j].map(|tr| tr.text.span).value_or(0..0)
}

# The trivia after the last token, appended to the root node so the tree still
# covers the source to its last byte.
fn with_trailing<K: variant, A: any>(p: Parser<K, A>, root: Cst) -> Cst {
    match (root) {
        Tree(i, kids) => Tree(i, [..kids, ..p.trailing]),
        Leaf(sp) => Leaf(sp),
        Trivia(sp) => Trivia(sp),
        Missing(pos, expected, unclosed) => Missing(pos, expected, unclosed),
        // The root is a production's node, never a group — `match_prod` is what
        // `parse_cst` starts with — so there is nothing to append to here.
        Group(gi, open, body, close) => Group(gi, open, body, close),
    }
}

// ---------- the rules ----------

# Match `r` at `pos`. `cur` is the index of the production being matched, which
# only `Climb` needs (each operator application nests under it).
fn match_rule<K: variant, A: any>(
    p: Parser<K, A>,
    r: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    match (r) {
        Term(k) => ok(match_term(p, k, pos, far)),
        Literal(s) => ok(match_spelling(p, s, pos, far)),
        Then(rs) => match_then(p, rs, pos, cur, far),
        OneOf(rs) => match_one_of(p, rs, pos, cur, far),
        Many(sub, min, max, sep, trailing_sep, leading_sep, nested_in, _, _, _, group) => match_many(
            p,
            sub,
            min,
            max,
            sep,
            trailing_sep,
            leading_sep,
            nested_in,
            group,
            pos,
            cur,
            far,
        ),
        Maybe(sub) => match_maybe(p, sub, pos, cur, far),
        Expect(sub) => match_expect(p, sub, pos, cur, far),
        NamedIdx(i) => match_prod(p, i, pos, far),
        Climb(atom, precs) => match_climb(p, atom, precs, pos, cur, far),
        // Reached on its own — not as an element of a sequence, which
        // `match_then` handles so the error can span what came before it —
        // there is nothing matched to point at, so it points at the token
        // that was next.
        Refuse(what) => err(refused(refusal(p, what, pos, pos), far)),
        // `link` rewrites every one of these; reaching one means the grammar was
        // handed to the driver unlinked, which `parse_cst` makes impossible.
        Named(n) => err(grammar_fault(`unlinked rule reference "{n}"`)),
    }
}

# The error a `Refuse` raises, over the tokens `start..end` — what the
# enclosing sequence accepted before refusing it. An empty range is a refusal
# reached with nothing in front of it, which points at the token at `end` (the
# empty span at end of input past the last one).
#
# A `Fn` refusal is handed those tokens' text, run together with a single
# space wherever the source had a gap: the parser holds no source, only the
# tokens, and their spans say where the gaps were.
fn refusal<K: variant, A: any>(p: Parser<K, A>, what: Refusal, start: u64, end: u64) -> ParseError {
    let matched = p.toks[start..end];
    let span = match (matched.first()) {
        some(f) => f.text.span.start..matched.last().value_or(f).text.span.end,
        none => p.toks[end].map(|t| t.text.span).value_or(p.end..p.end),
    };
    let message = match (what) {
        Msg(m) => m,
        Fn(f) => f(matched_text(matched)),
    };
    ParseError { message, span }
}

# `toks` as one string: each token's text, with a space between two tokens the
# source did not write together.
fn matched_text<K: variant>(toks: Token<K>[]) -> str {
    mut out = "";
    mut prev_end: u64 = 0;
    for (let i, t : toks) {
        if (i != 0 && prev_end < t.text.span.start) {
            set out.extend(" ");
        };
        set out.extend(t.text.text);
        set prev_end = t.text.span.end;
    }
    out
}

# Any one token whose kind is the case `k` — `Term(Name)` matches every
# identifier, whatever text it carries. `k` is a `Case<K>`: a case with no
# payload, so naming a kind needs no value of that kind.
fn match_term<K: variant, A: any>(p: Parser<K, A>, k: Case<K>, pos: u64, far: Far) -> Step {
    match (p.toks[pos]) {
        some(t) => if (t.kind.case_of() == k) {
            Step { hit: true, pos: pos + 1, kids: leaf_at(p, pos), far }
        } else {
            miss(far, pos, k.case_name())
        },
        none => miss(far, pos, k.case_name()),
    }
}

# One token spelled exactly `s`.
fn match_spelling<K: variant, A: any>(p: Parser<K, A>, s: str, pos: u64, far: Far) -> Step {
    if (pos < p.toks.len() && tok_text(p, pos) == s) {
        Step { hit: true, pos: pos + 1, kids: leaf_at(p, pos), far }
    } else {
        miss(far, pos, `\`{s}\``)
    }
}

# Every rule in order; children concatenate. A failure anywhere rewinds the
# whole sequence to where it started — the caller decides what to try next.
fn match_then<K: variant, A: any>(
    p: Parser<K, A>,
    rs: Rule<K>[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    mut cp = pos;
    mut acc: Cst[] = [];
    mut f = far;
    for (let sub : rs) {
        // A refusal here is about what the sequence matched so far, and the
        // error says so by spanning it — and by handing it to the message.
        if (let Refuse(what) = sub) {
            return err(refused(refusal(p, what, pos, cp), f));
        };
        let st = match_rule(p, sub, cp, cur, f)?;
        set f = st.far;
        if (!st.hit) {
            return ok(no(f, pos));
        };
        set cp = st.pos;
        set acc.extend(st.kids);
    }
    ok(Step { hit: true, pos: cp, kids: acc, far: f })
}

# The first alternative that matches. Every alternative's expectations are kept
# in `far` whether it matched or not, which is what makes "expected `(`, an
# identifier, or a number" possible from a choice that failed on all three.
fn match_one_of<K: variant, A: any>(
    p: Parser<K, A>,
    rs: Rule<K>[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    mut f = far;
    for (let sub : rs) {
        let st = match_rule(p, sub, pos, cur, f)?;
        set f = st.far;
        if (st.hit) {
            return ok(st);
        };
    }
    ok(no(f, pos))
}

# `sub` until it stops matching, at least `min` times — and, with a `sep`, with
# that separator between consecutive items.
#
# A rule that can match empty input would repeat forever here, and AIPL has no
# `break` to escape with — so a zero-width iteration is refused outright, the
# same invariant `lexer.aipl` keeps by having no matcher accept empty input.
# It is a grammar bug, reported as one rather than hung on.
#
# The separated case is the same loop with one step in front of each item after
# the first. What the separator matched is held back until an item follows it,
# because a separator with nothing after it is only part of the list when
# `trailing_sep` says so; otherwise the position rewinds to before it and the
# enclosing rule is the one that complains — which is how `[1, 2,]` can be
# either the list or a list followed by a stray comma.
fn match_many<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    min: u64,
    max: u64?,
    sep: Rule<K>?,
    trailing_sep: bool,
    leading_sep: bool,
    nested_in: (Rule<K>, Rule<K>)?,
    group: u64?,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    match (nested_in) {
        none => match_reps(p, sub, min, max, sep, trailing_sep, leading_sep, pos, cur, far),
        some(brackets) => {
            // `link` stamps every bracketed repetition with its style's index;
            // reaching one without means the grammar was handed to the driver
            // unlinked, which `parse_cst` makes impossible.
            let gi = group.value_or_err(grammar_fault("unlinked group"))?;
            match_group(
                p,
                gi,
                brackets,
                sub,
                min,
                max,
                sep,
                trailing_sep,
                leading_sep,
                pos,
                cur,
                far,
            )
        },
    }
}

# A bracketed repetition: `open`, then the items, then `close`, kept as one
# `Group` naming style `gi`. It parses exactly as `Then` of the three would;
# what it adds is on either side of that.
#
# On the way in, the three runs stay separate in the tree, so the formatter knows
# which tokens are brackets without inferring it from where they sit. On the way
# out, a `close` that fails after `open` matched records the opening bracket's
# span on the furthest failure — the parse still backtracks like any non-match,
# but if nothing else works the message can say which bracket was left open.
fn match_group<K: variant, A: any>(
    p: Parser<K, A>,
    gi: u64,
    brackets: (Rule<K>, Rule<K>),
    sub: Rule<K>,
    min: u64,
    max: u64?,
    sep: Rule<K>?,
    trailing_sep: bool,
    leading_sep: bool,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let so = match_rule(p, brackets.0, pos, cur, far)?;
    if (!so.hit) {
        return ok(no(so.far, pos));
    };
    let sb = match_reps(p, sub, min, max, sep, trailing_sep, leading_sep, so.pos, cur, so.far)?;
    if (!sb.hit) {
        return ok(no(sb.far, pos));
    };
    let sc = match_rule(p, brackets.1, sb.pos, cur, sb.far)?;
    if (!sc.hit) {
        // Only when the close was wanted past the last token. Anywhere else
        // there *is* a token sitting where the bracket should be, and "never
        // closed" would be a lie: `[1, 2,]` fails at the trailing comma with the
        // `]` in plain sight, and blaming the `[` would send the reader to the
        // wrong end of the list. Running out of input is the case where the
        // bracket really is hanging, and the case where the opener can be a
        // screenful away.
        if (p.toks.len() <= sb.pos) {
            return ok(no(far_unclosed(sc.far, first_token(so.kids)), pos));
        };
        return ok(no(sc.far, pos));
    };
    ok(Step { hit: true, pos: sc.pos, kids: [Group(gi, so.kids, sb.kids, sc.kids)], far: sc.far })
}

# The repetition itself, without brackets.
fn match_reps<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    min: u64,
    max: u64?,
    sep: Rule<K>?,
    trailing_sep: bool,
    leading_sep: bool,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    // Exactly one item, unseparated — what a bracket pair holding one thing
    // desugars to, and by far the commonest repetition in a real grammar. The
    // loop below would run one trip and one more to discover the bound, so this
    // takes the rule directly.
    if (min == 1 && max == some(1) && !sep.is_some()) {
        return match_rule(p, sub, pos, cur, far);
    };
    mut cp = pos;
    mut acc: Cst[] = [];
    mut f = far;
    mut n: u64 = 0;
    mut going = true;

    while (going) {
        // Reaching `max` ends the repetition without failing it: a further item,
        // and the separator that would have led it, are left where they are for
        // the enclosing rule. So `Many(x, min=1, max=1)` consumes exactly
        // one `x`, and a second `x` after it is simply not part of this rule.
        //
        // One thing at the bound is still the list's own, though: a *trailing*
        // separator. It ends the list rather than starting the item that would
        // have been next, so a list that accepts one accepts it here for the
        // same reason it accepts one when the items run out. That case takes
        // another look; every other stops without touching a token, which is
        // what keeps a bounded repetition from recording an expectation at the
        // position it stopped.
        let at_max = max.is_some_and(|m| m <= n);
        let sep_pending = trailing_sep && sep.is_some() && 0 < n;
        if (at_max && !sep_pending) {
            set going = false;
        } else {
            // Everything after the first item is preceded by the separator, when
            // there is one. An unseparated list, and the first item of any list,
            // take the empty step — so `before` and `after` coincide and the
            // trailing-separator rule below never fires. A list that allows a
            // *leading* separator tries one before the first item too, and
            // simply goes without when it is not there.
            let before = cp;
            let led = if (n == 0) {
                if (leading_sep) {
                    match_leading_sep(p, sep, cp, cur, f)?
                } else {
                    hit_nothing(cp, f)
                }
            } else {
                match_sep(p, sep, cp, cur, f)?
            };
            set f = led.far;
            if (led.hit) {
                let after = led.pos;
                let st = match_rule(p, sub, after, cur, f)?;
                set f = st.far;
                if (st.hit && !at_max) {
                    // An item that consumed nothing would be matched again at
                    // the same position forever — but only if the repetition is
                    // allowed to run that far. A `max` stops it, which is what
                    // lets `Many(x, min=1, max=1)` hold a body that can be
                    // empty: an empty block, a group around an optional thing.
                    if (st.pos == after && !max.is_some()) {
                        return err(grammar_fault(
                            "a repetition matched empty input, which would repeat forever",
                        ));
                    };
                    set acc.extend(led.kids);
                    set acc.extend(st.kids);
                    set cp = st.pos;
                    set n++;
                } else {
                    // A separator with nothing after it takes the trailing rule.
                    // An item *did* follow, but we are at the bound and cannot
                    // take it — so the separator leads something that is not
                    // ours, and both are rewound. So is a leading separator
                    // with no first item: it is not a trailing one, there being
                    // nothing for it to trail.
                    if (!st.hit && trailing_sep && before != after && 0 < n) {
                        set acc.extend(led.kids);
                        set cp = after;
                    } else {
                        set cp = before;
                    };
                    set going = false;
                };
            } else {
                set going = false;
            };
        };
    }
    if (n < min) {
        return ok(no(f, pos));
    };
    ok(Step { hit: true, pos: cp, kids: acc, far: f })
}

# The separator step: what `sep` matched, or an empty match when there is none.
fn match_sep<K: variant, A: any>(
    p: Parser<K, A>,
    sep: Rule<K>?,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    match (sep) {
        some(s) => match_rule(p, s, pos, cur, far),
        none => ok(hit_nothing(pos, far)),
    }
}

# The optional separator in front of a list's first item: what `sep` matched,
# or the empty step when it is absent. Its expectations still reach `far`, as
# `match_maybe`'s do, so a leading separator that was started and went wrong
# still reports.
fn match_leading_sep<K: variant, A: any>(
    p: Parser<K, A>,
    sep: Rule<K>?,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let st = match_sep(p, sep, pos, cur, far)?;
    if (st.hit) { ok(st) } else { ok(hit_nothing(pos, st.far)) }
}

# A match that consumed nothing and succeeded — the identity step.
fn hit_nothing(pos: u64, far: Far) -> Step { hit: true, pos, kids: [], far }

# `sub`, or nothing. Always matches — but its expectations still reach `far`, so
# an optional part that was *started* and then went wrong still reports.
fn match_maybe<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let st = match_rule(p, sub, pos, cur, far)?;
    if (st.hit) {
        return ok(st);
    };
    ok(Step { hit: true, pos, kids: [], far: st.far })
}

# `sub`, which the grammar is committed to: when it does not match, the miss is
# recorded as an error in the input and the rule matches nothing instead, as
# though the missing text had been written. The sequence around it carries on, and
# no enclosing choice goes on to its next alternative — see `Expect`.
#
# The miss is recorded twice, for two readers. A `Missing` marker goes in the tree,
# which is how the errors of a parse that *succeeds* are found: a marker belongs
# to the path that was taken and goes with it if that path is abandoned. And the
# slip goes on `far`, which is how a parse that does not succeed finds them: a miss
# or a refusal has no tree to look in, only the failure record every rule hands on.
#
# `sub` is matched against a failure record of its own, so the error says what
# *this* rule wanted where it stood. Passing `far` through would let a deeper
# failure left by an abandoned alternative speak for it, and the message would
# blame a place the reader has no reason to look. The two are joined afterwards,
# so what `far` goes on to report is what it would have been without the `Expect`.
#
# The error is the rule's alone, and does *not* take on what `far` had already
# expected at the same token. The operators that could have continued the
# expression before a missing `;` are true of the token, but the grammar has said
# what it needs here: "expected `;`" is the answer, and a list that buries it among
# the things that were merely possible is the generic message `Expect` exists to
# improve on.
fn match_expect<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let st = match_rule(p, sub, pos, cur, Far { pos, expected: [], recorded: far.recorded })?;
    let joined = far_join(far, st.far);
    if (st.hit) {
        return ok(Step { ..st, far: joined });
    };
    let wanted = st.far;
    let slip = Slip { pos: wanted.pos, expected: wanted.expected, unclosed: wanted.unclosed };
    let missing = Missing(slip.pos, slip.expected, slip.unclosed);

    // Once to a token: the same slip met again down another path — the parse
    // backtracks over a region more than once — is not a second error.
    let seen = joined.recorded.any(|prior| prior.pos == slip.pos);
    let recorded = if (seen) { joined.recorded } else { [..joined.recorded, slip] };
    ok(Step { hit: true, pos, kids: [missing], far: Far { ..joined, recorded } })
}

# A reference to production `i` — and the only rule that builds a node. The
# production's own rule matches, and its children go into one `Tree(i, ..)`.
#
# A labelled production that fails *without getting anywhere* reports as its
# label instead of as the expectations from inside it — the collapse
# `SYMBOL_DISPLAY_NAMES` performs for the LR parser, where `expr`/`term`/`atom`
# all render as "expression". It matters more here than there: under ordered
# choice every alternative of a failed `OneOf` leaves its own expectation
# behind, so an uncollapsed message lists the grammar's internals.
#
# "Without getting anywhere" is the operative test. When the production failed
# *deeper* than it started, that deeper expectation is the useful one and the
# label is not applied; when it failed at its own first token, the label
# replaces what it expected there — but only what *this* production contributed,
# since the incoming `far` (a sibling alternative's expectations at the same
# position) is what the label is merged into. A transparent production (empty
# `expect_as`) never collapses anything: its insides are the message.
fn match_prod<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64, far: Far) -> Step!Abort {
    let Production { rule, expect_as } = p.prods[i].value_or_err(grammar_fault(
        `no production at index {i}`,
    ))?;

    // Ask the FIRST set before descending. A production that cannot begin with
    // the token sitting here cannot match here, and under ordered choice that is
    // the common case: `atom`'s twenty alternatives are twenty productions, of
    // which one token of lookahead rules out nearly all.
    //
    // This is the one place worth asking. A `Named` reference is where the
    // driver recurses, so pruning here removes whole subtrees rather than single
    // token compares — and it costs a table lookup and a membership test, with
    // no rule walked and nothing allocated.
    if (!can_reach(p, i, pos)) {
        return ok(pruned(p, i, pos, expect_as, far));
    };
    let st = match_rule(p, rule, pos, i, far)?;
    if (st.hit) {
        return ok(Step { ..st, kids: [Tree(i, st.kids)] });
    };
    if (pos < st.far.pos || expect_as.is_empty()) {
        return ok(no(st.far, pos));
    };

    // The label replaces what the production expected, not what was recorded:
    // those are not expectations, and they are not the production's to drop.
    ok(no(far_miss(Far { ..far, recorded: st.far.recorded }, pos, expect_as), pos))
}

# Whether production `i` could begin with the token at `pos` — its FIRST set
# asked about that token's kind and spelling.
#
# True at end of input, where there is no token to rule anything out: a nullable
# production still matches there, and the cost of trying the rest is one failed
# token compare. `can_start` is conservative in the safe direction anyway, so the
# only thing a wrong answer here could cost is the pruning itself.
fn can_reach<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64) -> bool {
    // A grammar whose FIRST sets and productions disagree in length is not
    // one this can prune; let the match decide.
    p.toks[pos]
        .map(|t| p.firsts[i]$can_start(t.kind.case_of(), t.text.text).value_or(true))
        .value_or(true)
}

# The `Step` a pruned production yields — the one its rule would have produced,
# without running it.
#
# A pruned production cannot consume the token at `pos`, so it cannot fail any
# deeper than `pos`; that is exactly the branch of `match_prod` where a label
# replaces what the production's insides expected. So for a *labelled*
# production this is observationally identical to attempting it.
#
# A transparent one has no label to record, and what it would have recorded is
# its insides' expectations at `pos` — which pruning skips over. That is a real
# difference and it is confined to the expected-set of an error reported at this
# exact position; see `label_sets` in `ebnf.aipl` for the exact version.
fn pruned<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64, expect_as: str, far: Far) -> Step {
    if (expect_as.is_nonempty()) {
        return no(far_miss(far, pos, expect_as), pos);
    };
    no(p.labels[i].value_or(#{}).left_fold(far, |f: Far, l: str| far_miss(f, pos, l)), pos)
}

# The expectation labels each production would record on failing at its own first
# token, in grammar order — the FIRST set computed over *labels* rather than
# terminals, so a labelled sub-production contributes its label and a transparent
# one contributes its insides.
#
# This exists so pruning is invisible. `match_prod`'s label branch already makes
# a pruned *labelled* production observationally identical to an attempted one; a
# transparent production has no label, and what it would have recorded is exactly
# this. Without it, skipping a production silently drops entries from the
# "expected a, b, or c" set of any error reported at that position — which the
# driver's own tests catch, seven of them.
#
# A fixed point for the same reason `first_sets` is one: a transparent production
# referencing another is not answerable until that one is.
#
# These really are sets, and are spelled as sets. That also makes the fixed
# point's own test exact: `#{str}` equality is membership, so a round that
# reaches the same labels by a different route ends the loop instead of spinning
# — where deduped arrays would have compared unequal on order alone.
fn label_sets<K: variant, A: any>(prods: Production<K, A>[], firsts: First<K>[]) -> #{str}[] {
    mut labels: #{str}[] = [#{}].repeat(prods.len());
    mut going = true;
    while (going) {
        let prev = labels;
        let next = prods.map(|pr| rule_labels(pr.rule, prods, firsts, prev));
        if (next == prev) {
            set going = false;
        } else {
            set labels = next;
        };
    }
    labels
}

# The labels `r` would record at its own first token, given the round's `labels`.
fn rule_labels<K: variant, A: any>(
    r: Rule<K>,
    prods: Production<K, A>[],
    firsts: First<K>[],
    labels: #{str}[],
) -> #{str} {
    match (r) {
        Term(k) => #{k.case_name()},
        Literal(s) => #{`\`{s}\``},
        // A sequence is tried from its front, and past every element that can
        // match nothing — the same walk `rule_first` makes over terminals.
        Then(rs) => seq_labels(rs, prods, firsts, labels),
        OneOf(rs) => rs.map(|sub| rule_labels(sub, prods, firsts, labels)).union_all(),
        // A repetition and an option both try their body at offset 0; a
        // separator is only ever reached after an item.
        // A bracketed repetition is reached through its opening bracket, so
        // that is what is expected at its first token; an unbracketed one is
        // reached through its body.
        Many(sub, _, _, _, _, _, nested_in, _, _, _, _) => match (nested_in) {
            some(brackets) => rule_labels(brackets.0, prods, firsts, labels),
            none => rule_labels(sub, prods, firsts, labels),
        },
        Maybe(sub) | Expect(sub) => rule_labels(sub, prods, firsts, labels),
        Climb(atom, _) => rule_labels(atom, prods, firsts, labels),
        // The collapse `expect_as` exists for: a labelled production is one word
        // in a message, and its insides never surface.
        // A `match` rather than `map(..).value_or(#{})`: an optional of a set
        // is not a type the language has, so `map` cannot produce the
        // intermediate.
        NamedIdx(i) => match (prods[i]) {
            some(pr) => if (pr.expect_as.is_empty()) {
                labels[i].value_or(#{})
            } else {
                #{pr.expect_as}
            },
            none => #{}, #[allow]
        },
        // A refusal is an error, never an expectation: nothing is "expected"
        // where it sits, so it labels nothing.
        Refuse(..) => #{},
        // Unlinked — `parse_cst` links first, so neither is reachable from a
        // parse; an unlinked grammar simply prunes nothing.
        Named(..) => #{},
    }
}

# `rule_labels` across a sequence: each element in turn, stopping after the first
# that cannot match nothing.
fn seq_labels<K: variant, A: any>(
    rs: Rule<K>[],
    prods: Production<K, A>[],
    firsts: First<K>[],
    labels: #{str}[],
) -> #{str} {
    mut out: #{str} = #{};
    for (let sub : rs) {
        set out = out.union(rule_labels(sub, prods, firsts, labels));
        if (!rule_nullable(sub, firsts)) {
            return out;
        };
    }
    out
}

# Whether `r` can match nothing at all — read off the FIRST sets for a reference,
# and structural everywhere else. Only `seq_labels` needs it, to know how far
# along a sequence the first token can still be expected.
fn rule_nullable<K: variant>(r: Rule<K>, firsts: First<K>[]) -> bool {
    match (r) {
        Term(..) | Literal(..) | Named(..) | Refuse(..) => false,
        Then(rs) => rs.all(|sub| rule_nullable(sub, firsts)),
        OneOf(rs) => rs.any(|sub| rule_nullable(sub, firsts)),
        // A bracket pair always matches at least its two brackets, so a
        // bracketed repetition is never nullable however small its minimum.
        Many(sub, min, _, _, _, _, nested_in, _, _, _, _) => match (nested_in) {
            some(brackets) => rule_nullable(brackets.0, firsts) && min == 0 && rule_nullable(
                brackets.1,
                firsts,
            ),
            none => min == 0 || rule_nullable(sub, firsts),
        },
        // `Expect` matches nothing where its rule is missing, so it can match
        // nothing — whatever its rule would have wanted.
        Maybe(..) | Expect(..) => true,
        Climb(atom, _) => rule_nullable(atom, firsts),
        NamedIdx(i) => firsts[i].is_some_and(|f| f.nullable),
    }
}

# The precedence level `text` belongs to, if it binds at least as tightly as
# `min_power`. Levels are scanned in order, so a spelling listed twice takes the
# first. The empty string never matches — that is what `tok_text` returns past
# the end of the tokens, so running out of input simply ends the climb.
fn find_prec(precs: Prec[], text: str, min_power: u64) -> Prec? {
    if (text.is_empty()) {
        return none;
    };
    precs.find_if(|pr| min_power <= pr.power && pr.ops.contains(text))
}

fn match_climb<K: variant, A: any>(
    p: Parser<K, A>,
    atom: Rule<K>,
    precs: Prec[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let any_power: u64 = 0;
    climb(p, atom, precs, pos, any_power, cur, far)
}

# Precedence climbing: an atom, then any operator binding at least as tightly as
# `min_power`, whose right-hand side is climbed at one power higher (or the same
# power, for a right-associative level).
#
# Each application nests *both* operands under the enclosing production's index
# while leaving the outermost one flat, so `match_prod`'s own wrap completes the
# tree: `1 + 2 * 3` becomes `(expr (expr 1) + (expr (expr 2) * (expr 3)))` — one
# node per operand, shaped by precedence rather than a flat run the lowering
# would have to re-parse.
fn climb<K: variant, A: any>(
    p: Parser<K, A>,
    atom: Rule<K>,
    precs: Prec[],
    pos: u64,
    min_power: u64,
    cur: u64,
    far: Far,
) -> Step!Abort {
    let head = match_rule(p, atom, pos, cur, far)?;
    if (!head.hit) {
        return ok(head);
    };
    mut kids = head.kids;
    mut cp = head.pos;
    mut f = head.far;
    mut going = true;
    while (going) {
        match (find_prec(precs, tok_text(p, cp), min_power)) {
            some(pr) => {
                let op_kids = leaf_at(p, cp);
                let next_min = if (pr.right) { pr.power } else { pr.power + 1 };
                let rhs = climb(p, atom, precs, cp + 1, next_min, cur, f)?;
                set f = rhs.far;
                if (rhs.hit) {
                    set kids = [Tree(cur, kids), ..op_kids, Tree(cur, rhs.kids)];
                    set cp = rhs.pos;
                } else {
                    // An operator with nothing after it: leave it unconsumed for
                    // the enclosing rule, which will report it.
                    set going = false;
                };
            },
            none => {
                // The climb ends here because the next token is not an operator
                // this level would take — so an operator *was* one of the things
                // that could have followed, and a failure at this position has
                // to say so. Without this the expectation set after a complete
                // expression lists only the punctuation that could close it, and
                // a reader is told `a + b` is invalid where it is not.
                //
                // Only when some level is still in reach: at a `min_power` above
                // every level, no operator would have been taken and claiming
                // one was expected would be a lie.
                if (precs.any(|pr| min_power <= pr.power)) {
                    set f = far_miss(f, cp, "an operator");
                };
                set going = false;
            },
        };
    }
    ok(Step { hit: true, pos: cp, kids, far: f })
}

// ---------- errors ----------

# The error a furthest failure describes: what was expected there, and what was
# found instead. The span is the offending token's (or the empty span at the end
# of the source), which is what `caret_block.aipl` renders the underline from.
fn error_at<K: variant, A: any>(p: Parser<K, A>, src: str, far: Far) -> ParseError {
    let found = if (far.pos < p.toks.len()) {
        `\`{tok_text(p, far.pos)}\``
    } else {
        "end of input"
    };
    let span = p.toks[far.pos].map(|t| t.text.span).value_or(p.end..p.end);
    let hint = unclosed_hint(src, far.unclosed);
    if (far.expected.is_empty()) {
        return ParseError { message: `unexpected {found}{hint}`, span };
    };

    // Sorted, not in the order the alternatives happened to be tried. The order
    // a PEG reaches its alternatives in is an artefact of how the grammar was
    // written, not something a reader can use, and it moves whenever a
    // production is reordered. Sorting makes the message a function of *what*
    // was expected and nothing else, so the same missing token reads the same
    // way however the grammar around it is arranged.
    //
    // It also means nothing upstream has to preserve order: `far_miss` dedupes
    // by hand and `label_sets` is set-valued, and both are free to arrive at
    // their contents in whatever order they like.
    //
    // `a`, `a or b`, `a, b, or c` — the Oxford list `join`'s two extra
    // separators write directly.
    let expected = far.expected.sort().join(sep=", ", final_sep=", or ", only_sep=" or ");
    ParseError { message: `expected {expected}, found {found}{hint}`, span }
}

# The parenthetical naming the bracket that was never closed, or the empty string
# when no group got that far. The span stays on the *failure*, which is where the
# reader has to type something; the opener is named by line because pointing at
# two places at once is what a single-span error cannot do.
#
# This is the whole reason `nested_in` exists on the parsing side: a flat
# `Then([Lit("("), .., Lit(")")])` fails at the close having forgotten there was
# an open, and reports "expected `)`, found end of input" a hundred lines away
# from the `(` that caused it.
fn unclosed_hint(src: str, open: Span[]) -> str {
    open
        .first()
        .map(|sp| {
            let line = line_at(src, sp.start).line + 1;
            ` (\`{src[sp]}\` at line {line} is never closed)`
        })
        .value_or("")
}

// ---------- entry points ----------

# Parses `src` — already lexed into `lexed` — against grammar `g`, beginning at
# the production named `start`, and returns the lossless concrete syntax tree.
#
# `g` is linked here, so it may be handed over unlinked; linking is idempotent,
# so a caller parsing repeatedly can `link` once and pay nothing again. Every
# token must be consumed: input left over after the start rule succeeds is an
# error, not a partial parse.
#
# Fails with a `ParseError` carrying the span of the offending token — the
# *furthest* position anything was expected at, not the last one tried — or the
# empty span at the end of the source when the input simply ran out.
pub fn parse_cst<K: variant, A: any>(
    //
    // A grammar with `Expect`s that finds one of them missing fails with the first
    // such error here. `parse_cst_recovering` is the entry that keeps going and
    // returns them all.

    src: str,
    lexed: LexResult<K>,
    g: Grammar<K, A>,
    start: str,
) -> Cst!ParseError {
    // Deliberately *not* `prepare`: analysing a grammar costs more than pruning
    // saves when the result is used for a single parse. Measured on the corpus —
    // ~750 one-shot parses — analysing every time is an 8% loss, while the same
    // analysis reused across parses is a 2x win. So a one-shot parse links and
    // nothing more, and the driver simply finds no FIRST set to prune on.
    let prep = Prepared { grammar: link(g)?, firsts: [], labels: [] };
    parse_prepared(src, lexed, prep, start)
}

# What a parse that recovers from `Expect`s found: every error, in source order,
# and the tree when the parse reached the end of the input.
#
# `cst` is `none` exactly when the parse could not finish — the input ran out of
# grammar before it ran out of tokens, no rule matched at all, or a `Refuse` ended
# it. The last error is then that failure, the one a plain `parse_cst` would have
# reported, and any before it are `Expect`s met on the way there. A tree that is
# present may still be a tree of *broken* input (`errors` is not empty): it stands
# in the place of the missing text without holding it, so it is for finding more
# errors and for tools that want a best-effort shape — never for lowering.
#
# What is in `errors` depends on whether there is a tree. With one, exactly the
# `Expect`s on the path the parse took: a miss recorded down an alternative that
# was then abandoned is not an error in the input, and the tree (which the
# alternative took its markers with it out of) is how that is known. Without one,
# every miss the parse met, abandoned paths included — there is no path to say
# which were the right ones, and for a parse that has already failed an error
# that is not quite the reader's is better than the one it hid.
#
# A fault in the grammar itself — an unresolved reference, a rule that would loop
# — is not the input's, and is the `!ParseError` of the call.
struct Recovered { cst: Cst?, errors: ParseError[] }

# `parse_cst` that goes on past a missing `Expect`: the tree it recovered to, and
# every error found on the way — see `Recovered`. Links `g` as `parse_cst` does.
pub fn parse_cst_recovering<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    g: Grammar<K, A>,
    start: str,
) -> Recovered!ParseError {
    let prep = Prepared { grammar: link(g)?, firsts: [], labels: [] };
    parse_prepared_recovering(src, lexed, prep, start)
}

# A grammar linked, and optionally analysed, ready to parse with.
#
# Everything here is a function of the grammar *alone* — the linked rules, the
# FIRST sets, the expectation labels — so a caller parsing more than one source
# builds this once with `prepare` and hands it to `parse_prepared` for each.
#
# `firsts` and `labels` are empty when the grammar was linked but not analysed,
# which is what `parse_cst` does. The driver reads that as "nothing to prune on"
# and matches every production it reaches; the parse is identical, only slower.
# Analysis is a cost worth paying exactly once per grammar and never once per
# source.
struct Prepared<K: variant, A: any> { grammar: Grammar<K, A>, firsts: First<K>[], labels: #{str}[] }

# `g` linked and analysed — build it once, parse with it many times. Fails the
# way `link` does: an unresolved reference, or a duplicate rule name.
pub fn prepare<K: variant, A: any>(g: Grammar<K, A>) -> Prepared<K, A>!ParseError {
    let grammar: Grammar<K, A> = link(g)?;
    let firsts = first_sets(grammar)?;
    let labels = label_sets(grammar.prods, firsts);
    ok(Prepared { grammar, firsts, labels })
}

# `parse_cst` against an already-prepared grammar — the same parse, without
# re-linking and re-analysing the grammar for every source.
pub fn parse_prepared<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    prep: Prepared<K, A>,
    start: str,
) -> Cst!ParseError {
    let Recovered { cst, errors } = parse_prepared_recovering(src, lexed, prep, start)?;
    match (errors.first()) {
        some(e) => err(e),
        none => cst.value_or_err(ParseError {
            message: "the start rule built no node",
            span: 0..0,
        }),
    }
}

# `parse_prepared` that goes on past a missing `Expect`; see `Recovered`. The one
# parse the others are written over.
pub fn parse_prepared_recovering<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    prep: Prepared<K, A>,
    start: str,
) -> Recovered!ParseError {
    let Prepared { grammar, firsts, labels } = prep;
    let i = prod_names(grammar)
        .find_index(|n| n == start)
        .value_or_err(ParseError { message: `no rule named "{start}"`, span: 0..0 })?;
    let (attached, trailing) = attach_trivia(lexed.tokens, lexed.trivia);
    let p = Parser {
        toks: lexed.tokens,
        attached,
        trailing,
        prods: grammar.prods,
        end: src.len(),
        firsts,
        labels,
    };
    match (match_prod(p, i, 0, Far { pos: 0, expected: [] })) {
        ok(step) => finished(p, src, step),
        err(abort) => stopped(p, src, abort),
    }
}

# What a parse that ran to a result made of it: the tree and its errors, or the
# failure that ended it with the `Expect`s met on the way.
fn finished<K: variant, A: any>(
    p: Parser<K, A>,
    src: str,
    Step { hit, far, pos, kids },
) -> Recovered!ParseError {
    if (!hit) {
        let missed = error_at(p, src, far);
        return ok(Recovered {
            cst: none,
            errors: recovered_errors(p, src, far.recorded, some(missed), false),
        });
    };
    if (pos < p.toks.len()) {
        let stuck = error_at(p, src, far_miss(far, pos, "end of input"));
        return ok(Recovered {
            cst: none,
            errors: recovered_errors(p, src, far.recorded, some(stuck), false),
        });
    };
    let root = kids
        .first()
        .value_or_err(ParseError { message: "the start rule built no node", span: 0..0 })?;
    let tree = with_trailing(p, root);

    // Nothing was recorded, so there is nothing to look for: the common case, and
    // the reason a parse that meets no `Expect` pays nothing for the walk.
    if (far.recorded.is_empty()) {
        return ok(Recovered { cst: some(tree), errors: [] });
    };
    ok(Recovered {
        cst: some(tree),
        errors: recovered_errors(p, src, missing_slips(tree), none, false),
    })
}

# A parse that a `Refuse` ended: the input's error, after the `Expect`s met before
# it. Anything else that aborts is the grammar's fault, and the call's.
fn stopped<K: variant, A: any>(
    p: Parser<K, A>,
    src: str,
    Abort { error, recorded, input },
) -> Recovered!ParseError {
    if (!input) {
        return err(error);
    };
    ok(Recovered { cst: none, errors: recovered_errors(p, src, recorded, some(error), true) })
}

# Every `Missing` marker under `node`, as the slip it stands for, in source order.
fn missing_slips(node: Cst) -> Slip[] {
    match (node) {
        Missing(pos, expected, unclosed) => [Slip { pos, expected, unclosed }],
        Tree(_, kids) => kids.map(missing_slips).join(),
        Group(_, open, body, close) => [
            ..open.map(missing_slips).join(),
            ..body.map(missing_slips).join(),
            ..close.map(missing_slips).join(),
        ],
        Leaf(..) | Trivia(..) => [],
    }
}

# `slips` worded, in the order of the source, then `last` — the failure that ended
# the parse, when one did.
#
# One error to a token. Two slips at the same token are the same mistake seen
# twice (`Then([Expect(a), Expect(b)])` on a token that is neither), and so is the
# failure that ended the parse when it is at a token a slip is already reported
# at. Reporting each would make one slip read as several. Which of the two stays
# is `last_wins`: a refusal's message was written for the case, and replaces the
# generic "expected" a slip at the same token would have said; an ordinary miss
# says nothing more than the slip did, and the slip, being first, stays.
fn recovered_errors<K: variant, A: any>(
    p: Parser<K, A>,
    src: str,
    slips: Slip[],
    last: ParseError?,
    last_wins: bool,
) -> ParseError[] {
    mut out: ParseError[] = [];
    mut seen: u64[] = [];
    for (let slip : slips.sort_by(|a, b| a.pos < b.pos)) {
        if (!seen.contains(slip.pos)) {
            set seen.push(slip.pos);
            set out.push(error_at(
                p,
                src,
                Far { pos: slip.pos, expected: slip.expected, unclosed: slip.unclosed },
            ));
        };
    }
    if (let some(e) = last) {
        let clash = out.any(|prior| prior.span == e.span);
        if (clash && last_wins) {
            set out = out.filter(|prior| prior.span != e.span);
        };
        if (!clash || last_wins) {
            set out.push(e);
        };
    };
    out
}

# Lowers a parsed tree to the caller's AST by calling each node's production
# `build`, depth first: a node's children are lowered before it, and only its
# *interior* children are passed (`Parts.children`) — a leaf has no lowered
# value, and its text is reachable from the node's own span.
#
# Fails with whatever a `build` refused with, unchanged.
pub fn lower<K: variant, A: any>(src: str, node: Cst, g: Grammar<K, A>) -> A!ParseError {
    lower_node(src, node, g.prods)
}

fn lower_node<K: variant, A: any>(src: str, node: Cst, prods: Production<K, A>[]) -> A!ParseError {
    match (node) {
        Tree(i, kids) => {
            // One walk of the direct kids, splitting them into the children to
            // recurse into and the token spans a `build` reads. It splices
            // groups away, so a production that wraps a bracket pair hands its
            // `build` the same children it would without one — and doing it
            // here is what stops each `build` from rebuilding the same list.
            let parts = node.parts();
            let vals = parts.children.try_map(|k| lower_node(src, k, prods))?;
            let Production { build } = prods[i].value_or_err(ParseError {
                message: `no production at index {i}`,
                span: node.extent(),
            })?;
            match (build) {
                Mk(f) => ok(f(src, parts, vals)),
                TryMk(f) => f(src, parts, vals),
                Kids(f) => ok(f(vals)),
                TryKids(f) => f(vals),
                Kid => only_kid(vals, node.extent()),
                Text(f) => ok(f(node.token_text(src))),
                TryText(f) => f(node.token_text(src)),
                Const(v) => ok(v),
            }
        },
        Leaf(span) => err(ParseError { message: "a token leaf has no lowered value", span }),
        Trivia(span) => err(ParseError { message: "trivia has no lowered value", span }),
        // A marker is where text was missing: a tree holding one is broken input,
        // and `parse_cst` fails before anything lowers it.
        Missing(..) => err(ParseError {
            message: "a missing token has no lowered value",
            span: node.extent(),
        }),
        // Unreachable from a tree `parse_cst` built: `nodes` splices every group
        // away before this recurses, so lowering never lands on one.
        Group(..) => err(ParseError {
            message: "a group has no lowered value",
            span: node.extent(),
        }),
    }
}

# The single lowered child a `Kid` lowering declared, or a refusal naming what
# the node actually matched. Reaching this is a grammar bug rather than a bad
# program — the rule and its `build` disagree about the production's shape — so
# the message says both sides and leaves it there. A lowering that reads a child
# is the one place that disagreement can surface, and saying it once here is
# what spares every `Kid` lowering from checking.
fn only_kid<A: any>(vals: A[], span: Span) -> A!ParseError {
    match (vals) {
        [v] => ok(v),
        _ => err(ParseError {
            message: `a \`Kid\` lowering wants exactly one child; this production matched {vals.len()}`,
            span,
        }),
    }
}

# `parse_cst` followed by `lower`: the source's AST, with the concrete tree
# built and discarded in between. Use `parse_cst` when the tree itself is the
# point (a formatter, a highlighter), and this when only the AST is.
pub fn parse<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    g: Grammar<K, A>,
    start: str,
) -> A!ParseError { lower(src, parse_cst(src, lexed, g, start)?, g) }.test({
    fn trivia_rules() -> TokenRule<Tok>[] {
        let alpha: char[] = "abcdefghijklmnopqrstuvwxyz";
        let digit: char[] = "0123456789";
        [
            TokenRule { matcher: CharRun(" \t\n".to_set()), emit: Bare(Punct), trivia: true },
            TokenRule { matcher: ToEol("//"), emit: Bare(Punct), trivia: true },
            TokenRule { matcher: CharRun(alpha.to_set()), emit: Of(Word) },
            TokenRule { matcher: CharRun(digit.to_set()), emit: Of(Num) },
            TokenRule { matcher: OneChar("()[],;+*".to_set()), emit: Bare(Punct) },
        ]
    }

    // A `build` that always refuses, for the error-propagation assertion.
    fn refuse(src: str, node: Parts, kids: Node[]) -> Node!ParseError {
        err(ParseError { message: "refused", span: node.span() })
    }

    fn labelled_prod(name: str, rule: Rule<Tok>, expect_as: str) -> Production<Tok, Node> {
        name,
        rule,
        build: Mk(build_node),
        expect_as,
        layout: Inline,
    }

    fn g_of(ps: Production<Tok, Node>[]) -> Grammar<Tok, Node> { prods: ps }

    // The message a failed parse reports — and a distinguishable string when it
    // unexpectedly succeeded, so a broken assertion says which way it broke.
    fn msg_of(src: str, g: Grammar<Tok, Node>, start: str) -> str {
        shown(src, g, start).failure_message()
    }

    // Parse and render, so an assertion is one readable string rather than a nested
    // `Tree` literal.
    fn shown(src: str, g: Grammar<Tok, Node>, start: str) -> str!ParseError {
        let lexed = lex_toks(src, tok_rules())?;
        let tree = parse_cst(src, lexed, g, start)?;
        ok(tree.show(src, prod_names(g)))
    }

    // A message function for the `Refuse(Fn(..))` assertions: the matched text,
    // quoted back.
    fn as_word(matched: str) -> str { `write {matched} as a word` }

    fn msg_of_prepared(src: str, g: Grammar<Tok, Node>, start: str) -> str {
        shown_prepared(src, g, start).failure_message()
    }

    // The same as `shown`, against an *analysed* grammar — so the assertions can be
    // made twice and compared. This is the path that prunes.
    fn shown_prepared(src: str, g: Grammar<Tok, Node>, start: str) -> str!ParseError {
        let lexed = lex_toks(src, tok_rules())?;
        let tree = parse_prepared(src, lexed, prepare(g)?, start)?;
        ok(tree.show(src, prod_names(g)))
    }

    // What a recovering parse made of `src`: the tree it recovered to, shown, or
    // the reason there is none.
    fn tree_of(src: str, g: Grammar<Tok, Node>, start: str) -> str {
        match (recovered_of(src, g, start)) {
            ok(r) => r.cst$show(src, prod_names(g)).value_or("no tree"),
            err(e) => `aborted: {e.message}`,
        }
    }

    // ... and the errors it found, as their messages — or the abort that took them.
    fn errors_of(src: str, g: Grammar<Tok, Node>, start: str) -> str[] {
        match (recovered_of(src, g, start)) {
            ok(r) => r.errors$message,
            err(e) => [`aborted: {e.message}`],
        }
    }

    fn recovered_of(src: str, g: Grammar<Tok, Node>, start: str) -> Recovered!ParseError {
        parse_cst_recovering(src, lex_toks(src, tok_rules())?, g, start)
    }

    // The same against an analysed grammar, so the assertions can be made twice.
    fn errors_of_prepared(src: str, g: Grammar<Tok, Node>, start: str) -> str[] {
        let lexed = lex_toks(src, tok_rules());
        match (lexed) {
            ok(l) => match (prepare(g)) {
                ok(prep) => match (parse_prepared_recovering(src, l, prep, start)) {
                    ok(r) => r.errors$message,
                    err(e) => [`aborted: {e.message}`],
                },
                err(e) => [`grammar: {e.message}`],
            },
            err(e) => [`lex: {e.message}`],
        }
    }

    // ---- Term: any token of a kind, payload ignored ----
    let r_word: Rule<Tok> = Term(Word);
    let g_word = g_of([one("w", r_word)]);
    assert(shown("abc", g_word, "w")? == "(w abc)");
    assert(msg_of("123", g_word, "w") == "expected Word, found `123`");
    assert(msg_of("", g_word, "w") == "expected Word, found end of input");
    // Every token must be consumed; a partial parse is an error, not a result.
    assert(msg_of("a b", g_word, "w") == "expected end of input, found `b`");
    // A start rule no production answers to.
    assert(msg_of("a", g_word, "nope") == `no rule named "nope"`);

    // ---- Literal: one token by its text ----
    let r_open: Rule<Tok> = Literal("(");
    let g_open = g_of([one("o", r_open)]);
    assert(shown("(", g_open, "o")? == "(o ()");
    assert(msg_of("x", g_open, "o") == "expected `(`, found `x`");

    // ---- Then: a sequence, children concatenated ----
    let r_pair: Rule<Tok> = Then([Term(Word), Term(Num)]);
    let g_pair = g_of([one("p", r_pair)]);
    assert(shown("ab 12", g_pair, "p")? == "(p ab 12)");

    // A failure part-way through rewinds the whole sequence, but the deepest
    // expectation is what gets reported.
    assert(msg_of("ab cd", g_pair, "p") == "expected Num, found `cd`");

    // ---- OneOf: ordered choice, and the expected *set* it leaves behind ----
    let r_atom: Rule<Tok> = OneOf([Term(Word), Term(Num), Literal("(")]);
    let g_atom = g_of([one("a", r_atom)]);
    assert(shown("x", g_atom, "a")? == "(a x)");
    assert(shown("7", g_atom, "a")? == "(a 7)");
    // Three alternatives, three expectations, Oxford-joined.
    assert(msg_of("]", g_atom, "a") == "expected Num, Word, or `(`, found `]`");
    // Two joins with "or"; a repeated expectation is deduped, not doubled.
    let r_dup: Rule<Tok> = OneOf([Term(Word), Term(Num), Term(Word)]);
    assert(msg_of("]", g_of([one("a", r_dup)]), "a") == "expected Num or Word, found `]`");

    // ---- Many: zero-or-more and one-or-more ----
    let r_many: Rule<Tok> = Many(Term(Word));
    let g_many = g_of([one("m", r_many)]);
    assert(shown("a b c", g_many, "m")? == "(m a b c)");
    assert(shown("", g_many, "m")? == "(m)");
    let r_many1: Rule<Tok> = Many(Term(Word), min=1);
    assert(shown("a", g_of([one("m", r_many1)]), "m")? == "(m a)");
    assert(msg_of("", g_of([one("m", r_many1)]), "m") == "expected Word, found end of input");

    // A rule that can match empty input would repeat forever. It is refused,
    // not hung on — the driver's counterpart of the lexer's "no matcher matches
    // empty input" invariant.
    let r_loop: Rule<Tok> = Many(Maybe(Term(Word)));
    assert(
        msg_of(
            "x",
            g_of([one("l", r_loop)]),
            "l",
        ) == "a repetition matched empty input, which would repeat forever",
    );

    // ---- Many: a bounded repetition ----
    //
    // `max` stops the repetition rather than failing it, so what is left over is
    // the enclosing rule's. Here the enclosing rule takes it, which is the whole
    // observable difference between a bound and no bound.
    let r_two: Rule<Tok> = Then([Many(Term(Word), max=2), Many(Term(Num))]);
    let g_two = g_of([one("t", r_two)]);
    assert(shown("a b", g_two, "t")? == "(t a b)");
    assert(shown("a b 1 2", g_two, "t")? == "(t a b 1 2)");

    // The third word is past the bound and the `Num` list cannot take it. `Word`
    // is *not* in the expected set: a bounded repetition stops rather than
    // attempting an item it could not keep, so it records no expectation there.
    assert(msg_of("a b c", g_two, "t") == "expected Num or end of input, found `c`");

    // A bound is what makes a nullable body safe: it cannot repeat forever if it
    // cannot repeat. This is the shape `only` in `grammar_aipl.aipl` is built
    // from — a bracket pair around something that may be empty.
    let r_once: Rule<Tok> = Many(Maybe(Term(Word)), min=1, max=1);
    let g_once = g_of([one("o", r_once)]);
    assert(shown("x", g_once, "o")? == "(o x)");
    assert(shown("", g_once, "o")? == "(o)");

    // ---- Maybe: present and absent ----
    let r_opt: Rule<Tok> = Then([Term(Word), Maybe(Term(Num))]);
    let g_opt = g_of([one("m", r_opt)]);
    assert(shown("a 1", g_opt, "m")? == "(m a 1)");
    assert(shown("a", g_opt, "m")? == "(m a)");

    // ---- Named/NamedIdx: a reference reaching back through another production,
    // which is what makes the CST (and the parse) genuinely recursive ----
    let r_item: Rule<Tok> = OneOf([Term(Word), Named("list")]);

    // Annotated, like every other rule here: nothing inside `Then` mentions `K`,
    // and there is more than one `Rule` instance in scope for it to fall back on.
    let r_list: Rule<Tok> = Then([Literal("("), Many(Named("item")), Literal(")")]);
    let g_sexp = g_of([one("list", r_list), one("item", r_item)]);
    assert(shown("(a b)", g_sexp, "list")? == "(list ( (item a) (item b) ))");
    assert(
        shown(
            "(a (b) c)",
            g_sexp,
            "list",
        )? == "(list ( (item a) (item (list ( (item b) ))) (item c) ))",
    );
    assert(msg_of("(a", g_sexp, "list") == "expected Word, `(`, or `)`, found end of input");

    // ---- Many with a separator, and the trailing-separator rule ----
    let comma: Rule<Tok> = Literal(",");
    let nums = Many(Term(Num), sep=comma, trailing_sep=false);
    let r_nums: Rule<Tok> = Then([Literal("["), nums, Literal("]")]);
    let g_nums = g_of([one("l", r_nums)]);
    assert(shown("[1, 2, 3]", g_nums, "l")? == "(l [ 1 , 2 , 3 ])");
    // An empty list is a list.
    assert(shown("[]", g_nums, "l")? == "(l [ ])");

    // With `trailing: false` the dangling separator is left for the enclosing
    // rule, which is what reports it.
    assert(msg_of("[1, 2,]", g_nums, "l") == "expected Num, found `]`");
    let trail = Many(Term(Num), sep=comma);
    let r_trail: Rule<Tok> = Then([Literal("["), trail, Literal("]")]);
    assert(shown("[1, 2,]", g_of([one("l", r_trail)]), "l")? == "(l [ 1 , 2 , ])");

    // The bound and the trailing separator together. Reaching `max` ends the
    // list, and a separator after the last item is still the list's own — it
    // ends the list rather than starting the item that would have been next — so
    // `trailing_sep` decides it exactly as it does when the items simply run out.
    let bounded = Many(Term(Num), sep=comma, max=2);
    let r_bounded: Rule<Tok> = Then([Literal("["), bounded, Literal("]")]);
    let g_bounded = g_of([one("l", r_bounded)]);
    assert(shown("[1, 2]", g_bounded, "l")? == "(l [ 1 , 2 ])");
    assert(shown("[1, 2,]", g_bounded, "l")? == "(l [ 1 , 2 , ])");

    // A third item is past the bound, so the separator leading it is not the
    // list's: both are left where they are and the enclosing rule reports them.
    assert(msg_of("[1, 2, 3]", g_bounded, "l") == "expected `]`, found `,`");
    // The same list refusing the trailing separator leaves it behind instead.
    let bounded_strict = Many(Term(Num), sep=comma, max=2, trailing_sep=false);
    let r_bstrict: Rule<Tok> = Then([Literal("["), bounded_strict, Literal("]")]);
    let g_bstrict = g_of([one("l", r_bstrict)]);
    assert(msg_of("[1, 2,]", g_bstrict, "l") == "expected `]`, found `,`");

    // ---- The leading separator ----
    // `leading_sep` lets the list open with its separator — present or absent,
    // the items are the same items. A separator with no item after it is not a
    // leading one, and the list does not take it as a trailing one either.
    let pipe: Rule<Tok> = Literal("+");
    let led = Many(Term(Num), min=1, sep=pipe, trailing_sep=false, leading_sep=true);
    let r_led: Rule<Tok> = Then([Literal("["), led, Literal("]")]);
    let g_led = g_of([one("l", r_led)]);
    assert(shown("[1 + 2]", g_led, "l")? == "(l [ 1 + 2 ])");
    assert(shown("[+ 1 + 2]", g_led, "l")? == "(l [ + 1 + 2 ])");
    assert(shown("[+ 1]", g_led, "l")? == "(l [ + 1 ])");
    assert(msg_of("[+]", g_led, "l") == "expected Num, found `]`");
    assert(msg_of("[1 +]", g_led, "l") == "expected Num, found `]`");
    // Without it, the same list refuses the opening separator.
    let unled = Many(Term(Num), min=1, sep=pipe, trailing_sep=false);
    let r_unled: Rule<Tok> = Then([Literal("["), unled, Literal("]")]);
    let g_unled = g_of([one("l", r_unled)]);
    assert(msg_of("[+ 1]", g_unled, "l") == "expected Num, found `+`");

    // ---- Climb: precedence and associativity ----
    let plus = Prec { power: 1, right: false, ops: ["+"] };
    let times = Prec { power: 2, right: false, ops: ["*"] };
    let r_expr: Rule<Tok> = Climb(Term(Num), [plus, times]);
    let g_expr = g_of([one("e", r_expr)]);
    // A bare atom climbs to itself: no operator, no extra node.
    assert(shown("1", g_expr, "e")? == "(e 1)");
    // `*` binds tighter, so it nests inside the `+`.
    assert(shown("1 + 2 * 3", g_expr, "e")? == "(e (e 1) + (e (e 2) * (e 3)))");
    // ... and the other order proves it is precedence, not source order.
    assert(shown("1 * 2 + 3", g_expr, "e")? == "(e (e (e 1) * (e 2)) + (e 3))");
    // Equal power, left-associative: the left operand is the nested one.
    assert(shown("1 + 2 + 3", g_expr, "e")? == "(e (e (e 1) + (e 2)) + (e 3))");
    // The same level marked right-associative nests the other way.
    let rpow = Prec { power: 1, right: true, ops: ["*"] };
    let r_pow: Rule<Tok> = Climb(Term(Num), [rpow]);
    assert(shown("1 * 2 * 3", g_of([one("e", r_pow)]), "e")? == "(e (e 1) * (e (e 2) * (e 3)))");

    // An operator with nothing after it leaves the operator unconsumed, so the
    // leftover-input check fires at the `+` — but the missing operand was
    // expected one position *further*, and furthest-failure tracking is what
    // makes that, rather than the `+`, the thing reported.
    assert(msg_of("1 +", g_expr, "e") == "expected Num, found end of input");

    // ---- expect_as: collapsing a family of rules to one word ----
    //
    // Unlabelled, the message is the grammar's internals; labelled, it is the
    // one word a reader wants — and only when the production got nowhere, so a
    // partly-matched one still reports the finer expectation.
    let r_stmt: Rule<Tok> = Then([Named("expr"), Literal(";")]);
    let r_alt: Rule<Tok> = OneOf([Term(Word), Term(Num)]);
    let plain = g_of([one("stmt", r_stmt), one("expr", r_alt)]);
    assert(msg_of("]", plain, "stmt") == "expected Num or Word, found `]`");
    let labelled = g_of([one("stmt", r_stmt), labelled_prod("expr", r_alt, "an expression")]);
    assert(msg_of("]", labelled, "stmt") == "expected an expression, found `]`");
    // Got somewhere, so the label steps aside for what actually went wrong.
    assert(msg_of("a ]", labelled, "stmt") == "expected `;`, found `]`");

    // ---- Trivia and losslessness ----
    //
    // With whitespace and comments lexed as trivia rather than skipped, every
    // byte of the source ends up under exactly one leaf — including the run
    // after the last token, which no token consumption can pick up.
    let src = "  ( a  b ) // done\n";
    let lexed = lex_toks(src, trivia_rules())?;
    let tree = parse_cst(src, lexed, g_sexp, "list")?;
    assert(tree.text(src) == src);

    // Where each piece landed, on a source small enough to read: leading trivia
    // attaches in front of the token that follows it, and the comment and
    // newline after the last token attach to the root.
    let small = "(a) // x";
    let small_tree = parse_cst(small, lex_toks(small, trivia_rules())?, g_sexp, "list")?;
    assert(small_tree.text(small) == small);
    assert(small_tree.show(small, prod_names(g_sexp)) == "(list ( (item a) ) ~  ~// x)");

    // ---- Lowering ----
    //
    // Each node's `build` sees the already-lowered values of its *interior*
    // children only, so `build_node` distinguishes a leaf from a branch by
    // whether it got any. `Node` is boxed and recursive, and `build` reaches it
    // through a function *value* — the shape this library was waiting on.
    assert(parsed("(a b)", g_sexp, "list")? == List([Atom("a"), Atom("b")]));
    assert(parsed("(a (b) c)", g_sexp, "list")? == List([
        Atom("a"),
        List([List([Atom("b")])]),
        Atom("c"),
    ]));
    // A `build` that refuses fails the parse with its own error, unchanged.
    let refuser = g_of([
        Production { name: "w", rule: r_word, build: TryMk(refuse), layout: Inline },
    ]);
    assert(parsed("abc", refuser, "w") == err(ParseError { message: "refused", span: 0..3 }));

    // ---- Kid: the one child, with the count checked by the driver ----
    //
    // A production that is exactly one other thing takes the child itself, so
    // its lowering is the pass-through `Kid` rather than an indexing
    // one. A rule that can match some other number of children disagrees with
    // its own `build`, and the driver is what names that — once, here, instead
    // of in every lowering that reaches for a child which might not be there.
    let r_one_w: Rule<Tok> = Named("w");
    let r_two_w: Rule<Tok> = Then([Named("w"), Named("w")]);
    let g_kid = g_of([
        Production { name: "pass", rule: r_one_w, build: Kid, layout: Inline },
        Production { name: "two_kids", rule: r_two_w, build: Kid, layout: Inline },
        Production { name: "no_kid", rule: r_word, build: Kid, layout: Inline },
        one("w", r_word),
    ]);
    assert(parsed("abc", g_kid, "pass")? == Atom("abc"));
    assert(parsed("a b", g_kid, "two_kids") == err(ParseError {
        message: "a `Kid` lowering wants exactly one child; this production matched 2",
        span: 0..3,
    }));

    // A leaf-only production has no interior child at all, which is the same
    // disagreement counted from the other side.
    assert(parsed("abc", g_kid, "no_kid") == err(ParseError {
        message: "a `Kid` lowering wants exactly one child; this production matched 0",
        span: 0..3,
    }));

    // ---- Refuse: a rule that is an error when reached ----
    //
    // The shape it exists for: accept a form the language no longer has, then
    // reject it with a message that says what to write instead. The error
    // spans what the sequence matched before the refusal — the offending form,
    // not the token after it.
    let r_old: Rule<Tok> = Then([Term(Num), Refuse(Msg("write the number as a word"))]);
    let r_form: Rule<Tok> = OneOf([Term(Word), r_old]);
    let g_form = g_of([one("f", r_form)]);
    assert(shown("abc", g_form, "f")? == "(f abc)");
    assert(parsed("42", g_form, "f") == err(ParseError {
        message: "write the number as a word",
        span: 0..2,
    }));
    // The span covers everything the sequence matched, not only its last token.
    let r_two: Rule<Tok> = Then([Term(Num), Term(Num), Refuse(Msg("one number, not two"))]);
    assert(parsed("1 23", g_of([one("t", r_two)]), "t") == err(ParseError {
        message: "one number, not two",
        span: 0..4,
    }));

    // Neither a choice nor a repetition backtracks out of a refusal: reaching
    // it is the error, wherever it sits.
    let r_list: Rule<Tok> = Many(Named("f"));
    assert(parsed("abc 42 def", g_of([one("f", r_form), one("l", r_list)]), "l") == err(ParseError {
        message: "write the number as a word",
        span: 4..6,
    }));

    // A form that is not reached is not refused: input the earlier alternative
    // takes never gets there, and neither does input that matches nothing.
    assert(msg_of("(", g_form, "f") == "expected Num or Word, found `(`");

    // Reached with nothing matched in front of it, the error points at the
    // token that was next — or at end of input.
    let r_bare: Rule<Tok> = Refuse(Msg("nothing goes here"));
    assert(parsed("abc", g_of([one("b", r_bare)]), "b") == err(ParseError {
        message: "nothing goes here",
        span: 0..3,
    }));
    assert(parsed("", g_of([one("b", r_bare)]), "b") == err(ParseError {
        message: "nothing goes here",
        span: 0..0,
    }));

    // A `Fn` refusal is handed what the sequence matched, so the message can
    // name it: one token as written, several with a space at each gap the
    // source had and none where there was none — and `""` when nothing was
    // matched in front of it.
    let r_named: Rule<Tok> = Then([Term(Num), Refuse(Fn(as_word))]);
    assert(msg_of("42", g_of([one("n", r_named)]), "n") == "write 42 as a word");
    let r_pair: Rule<Tok> = Then([Term(Num), Term(Num), Refuse(Fn(as_word))]);
    assert(msg_of("1 23", g_of([one("n", r_pair)]), "n") == "write 1 23 as a word");
    let r_glued: Rule<Tok> = Then([Literal("("), Term(Num), Literal(")"), Refuse(Fn(as_word))]);
    assert(msg_of("(1)", g_of([one("n", r_glued)]), "n") == "write (1) as a word");
    let r_empty: Rule<Tok> = Refuse(Fn(as_word));
    assert(msg_of("42", g_of([one("n", r_empty)]), "n") == "write  as a word");

    // Pruning sees a refusal as unable to start anything, so an analysed
    // grammar refuses exactly where a one-shot parse does.
    assert(msg_of_prepared("42", g_form, "f") == "write the number as a word");
    assert(msg_of_prepared("(", g_form, "f") == "expected Num or Word, found `(`");

    // ---- link is not optional, and `parse_cst` does it ----
    //
    // A grammar handed over unlinked parses anyway; linking twice changes
    // nothing.
    assert(shown("(a b)", link(g_sexp)?, "list")? == "(list ( (item a) (item b) ))");

    // ---- Groups ----
    //
    // The same S-expression grammar with its brackets written as the list's own
    // `nested_in` rather than a flat `Then`. It parses the same input to the
    // same *lowered* value, because a group is transparent to everything but the
    // formatter.
    let g_list: Rule<Tok> = Many(
        NamedIdx(1),
        sep=Literal(","),
        nested_in=(Literal("("), Literal(")")),
        spaced=true,
    );
    let g_item: Rule<Tok> = OneOf([Term(Word), Named("list")]);
    let g_grp = g_of([one("list", g_list), one("item", g_item)]);

    // The tree shows the brackets as a group — `[..]` in `show` — with the items
    // between them, and the source still comes back whole.
    assert(shown("(a, b)", g_grp, "list")? == "(list [( (item a) , (item b) )])");
    assert(parsed("(a, b)", g_grp, "list")? == List([Atom("a"), Atom("b")]));

    // Nested groups nest, and lowering still sees one child per item.
    assert(parsed("(a, (b))", g_grp, "list")? == List([Atom("a"), List([List([Atom("b")])])]));

    // The style rode into the grammar's `groups` table, keyed by the index the
    // `Group` carries.
    assert(link(g_grp)?.groups == [ListStyle { spaced: true }]);

    // Losslessness holds through a group: trivia inside the brackets attaches to
    // the token that follows it, exactly as it does inside a production.
    let gsrc = "( a, // c\n  b )";
    let gtree = parse_cst(gsrc, lex_toks(gsrc, trivia_rules())?, g_grp, "list")?;
    assert(gtree.text(gsrc) == gsrc);

    // ---- The unclosed bracket ----
    //
    // The payoff for the parser: a group that opens and never closes names the
    // bracket that did it. A flat `Then` fails at the close having forgotten
    // there was an open, so all it can say is the first half of this.
    assert(
        msg_of(
            "(a, b",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 1 is never closed)",
    );

    // The line is the *opener's*, not the failure's — which is the whole point
    // when the two are far apart.
    assert(
        msg_of(
            "(a,\nb,\nc",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 1 is never closed)",
    );

    // An inner bracket left open blames the inner one, being the deepest failure
    // — put the two on different lines and it is the inner line that is named.
    assert(
        msg_of(
            "(a,\n(b",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 2 is never closed)",
    );

    // A failure that has nothing to do with a bracket says nothing about one.
    assert(msg_of("a", g_grp, "list") == "expected `(`, found `a`");

    // ---- Pruning is invisible ----
    //
    // `prepare` analyses the grammar so `match_prod` can skip a production whose
    // FIRST set rules out the token in front of it. That must change *nothing* a
    // caller can see: the same trees, and — the part that is easy to get wrong —
    // the same expected-sets in the same order.
    //
    // The expectations are the whole reason `label_sets` exists. Pruning a
    // labelled production is exactly its label, which `match_prod` would have
    // applied anyway; pruning a *transparent* one skips the insides that would
    // have recorded what they expected here, and those have to be put back. Seven
    // of the assertions below caught that when they were not.
    assert(shown_prepared("(a b)", g_sexp, "list")? == shown("(a b)", g_sexp, "list")?);
    assert(shown_prepared("(a (b) c)", g_sexp, "list")? == shown("(a (b) c)", g_sexp, "list")?);
    assert(shown_prepared("(a, b)", g_grp, "list")? == shown("(a, b)", g_grp, "list")?);
    assert(msg_of_prepared("123", g_word, "w") == msg_of("123", g_word, "w"));
    assert(msg_of_prepared("x", g_open, "o") == msg_of("x", g_open, "o"));
    assert(msg_of_prepared("]", g_atom, "a") == msg_of("]", g_atom, "a"));
    assert(msg_of_prepared("]", plain, "stmt") == msg_of("]", plain, "stmt"));
    assert(msg_of_prepared("]", labelled, "stmt") == msg_of("]", labelled, "stmt"));
    assert(msg_of_prepared("a", g_grp, "list") == msg_of("a", g_grp, "list"));
    assert(msg_of_prepared("(a, b", g_grp, "list") == msg_of("(a, b", g_grp, "list"));

    // Spelled out once rather than only compared, so a regression that broke
    // *both* paths the same way could not pass unnoticed.
    assert(msg_of_prepared("]", g_atom, "a") == "expected Num, Word, or `(`, found `]`");
    assert(msg_of_prepared("]", labelled, "stmt") == "expected an expression, found `]`");

    // ---- Expect: an error in the input, recovered from ----
    //
    // `word ;` where the `;` is not optional. Present, `Expect` is invisible: the
    // same tree, no errors.
    let e_stmts: Rule<Tok> = Many(Named("stmt"));
    let e_stmt: Rule<Tok> = Then([Term(Word), Expect(Literal(";"))]);
    let g_e = g_of([one("stmts", e_stmts), one("stmt", e_stmt)]);
    assert(tree_of("a; b;", g_e, "stmts") == "(stmts (stmt a ;) (stmt b ;))");
    assert(errors_of("a; b;", g_e, "stmts") == []);

    // Missing, it is reported and the parse goes on: the tree has the statement
    // with a marker where its `;` should be, which holds no text.
    assert(errors_of("a b;", g_e, "stmts") == ["expected `;`, found `b`"]);
    assert(tree_of("a b;", g_e, "stmts") == "(stmts (stmt a <missing `;`>) (stmt b ;))");

    // So a second mistake is found by the same parse, which is the point.
    assert(errors_of("a b c;", g_e, "stmts") == [
        "expected `;`, found `b`",
        "expected `;`, found `c`",
    ]);
    assert(errors_of("a; b c d", g_e, "stmts").len() == 3);

    // The error points at the token that was found; at the end of the input, at
    // the end.
    let at_b = recovered_of("a b;", g_e, "stmts")?;
    assert(at_b.errors$span == [2..3]);
    let at_end = recovered_of("a", g_e, "stmts")?;
    assert(at_end.errors$message == ["expected `;`, found end of input"]);
    assert(at_end.errors$span == [1..1]);

    // `parse_cst` has no use for a tree of broken input: it fails with the first
    // error, in the words the recovering parse gave it.
    assert(msg_of("a b;", g_e, "stmts") == "expected `;`, found `b`");
    assert(msg_of("a b c;", g_e, "stmts") == "expected `;`, found `b`");
    assert(shown("a; b;", g_e, "stmts")? == "(stmts (stmt a ;) (stmt b ;))");

    // The tree still reconstructs the source, trivia and all: the missing token
    // adds no text, and nothing else was dropped.
    let trivial = "a // c\n b;";
    let mended = parse_cst_recovering(trivial, lex_toks(trivial, trivia_rules())?, g_e, "stmts")?;
    assert(mended.cst$text(trivial) == some(trivial));
    assert(mended.errors$span == [8..9]);

    // ---- Expect: it does not backtrack ----
    //
    // Both alternatives start with a word. Without `Expect` the first misses on
    // the absent `;` and the second is tried — and here the second is a `Refuse`,
    // which is how a test can see that it was. With `Expect` the first has
    // matched, an error and all, and the second is never reached.
    let e_second: Rule<Tok> = Then([Term(Word), Refuse(Msg("the second alternative was tried"))]);
    let e_plain: Rule<Tok> = OneOf([Then([Term(Word), Literal(";")]), e_second]);
    let e_commit: Rule<Tok> = OneOf([Then([Term(Word), Expect(Literal(";"))]), e_second]);
    assert(errors_of("a", g_of([one("s", e_plain)]), "s") == ["the second alternative was tried"]);
    assert(errors_of("a", g_of([one("s", e_commit)]), "s") == ["expected `;`, found end of input"]);

    // That is the contract, and it cuts both ways: put where a later alternative
    // *would* have taken the input, `Expect` turns a program that parses into an
    // error. `a +` is valid here, and stops being.
    let e_other: Rule<Tok> = Then([Term(Word), Literal("+")]);
    let e_plain_other: Rule<Tok> = OneOf([Then([Term(Word), Literal(";")]), e_other]);
    let e_commit_other: Rule<Tok> = OneOf([Then([Term(Word), Expect(Literal(";"))]), e_other]);
    assert(errors_of("a +", g_of([one("s", e_plain_other)]), "s") == []);
    assert(errors_of("a +", g_of([one("s", e_commit_other)]), "s") == ["expected `;`, found `+`"]);

    // What it does not do is outlive its path. An error recorded inside an
    // alternative that then fails is discarded with it: the parse did not go that
    // way, so the input is not wrong that way.
    let e_abandoned: Rule<Tok> = OneOf([
        Then([Term(Word), Expect(Literal(";")), Literal("+")]),
        Then([Term(Word), Term(Num)]),
    ]);
    let g_abandoned = g_of([one("s", e_abandoned)]);
    assert(errors_of("a 1", g_abandoned, "s") == []);
    assert(tree_of("a 1", g_abandoned, "s") == "(s a 1)");

    // Once the parse has failed there is no path to say which were the right ones,
    // so the miss the abandoned alternative met is reported with the rest.
    assert(errors_of("a 1 ]", g_abandoned, "s") == [
        "expected `;`, found `1`",
        "expected end of input, found `]`",
    ]);

    // ---- Expect: where the errors are collected from ----
    //
    // Through a bracketed group, which joins the runs of its open, body and close.
    let e_block: Rule<Tok> = Many(Named("stmt"), nested_in=(Literal("("), Literal(")")));
    let g_block = g_of([one("block", e_block), one("stmt", e_stmt)]);
    assert(errors_of("(a b;)", g_block, "block") == ["expected `;`, found `b`"]);
    assert(
        tree_of("(a b;)", g_block, "block") == "(block [( (stmt a <missing `;`>) (stmt b ;) )])",
    );

    // Through a precedence climb, whose operands are rebuilt around the errors
    // the atom recorded.
    let e_plus = Prec { power: 1, right: false, ops: ["+"] };
    let e_expr: Rule<Tok> = Climb(Named("atom"), [e_plus]);
    let e_atom: Rule<Tok> = OneOf([
        Term(Num),
        Then([Literal("("), Named("expr"), Expect(Literal(")"))]),
    ]);
    let g_climb = g_of([one("expr", e_expr), one("atom", e_atom)]);
    assert(errors_of("1 + (2 + 3", g_climb, "expr") == ["expected `)`, found end of input"]);
    assert(errors_of("1 + (2 + 3)", g_climb, "expr") == []);

    // Through a separated, repeated list.
    let e_list: Rule<Tok> = Many(Named("stmt"), sep=Literal(","));
    let g_list_e = g_of([one("list", e_list), one("stmt", e_stmt)]);
    assert(errors_of("a, b;, c", g_list_e, "list").len() == 2);

    // A total miss still reports what was met on the way to it. The group here
    // never closes, so the whole of it is given up on — the statement inside
    // included — and the `;` it was missing is reported ahead of the bracket.
    assert(errors_of("(a b;", g_block, "block") == [
        "expected `;`, found `b`",
        "expected Word or `)`, found end of input (`(` at line 1 is never closed)",
    ]);
    assert(tree_of("(a b;", g_block, "block") == "no tree");

    // But a parse that gets through the whole rule and is then left holding
    // tokens keeps what it recovered, and ends with that failure.
    assert(errors_of("a b; ]", g_e, "stmts") == [
        "expected `;`, found `b`",
        "expected Word or end of input, found `]`",
    ]);

    // ---- Expect: what it says ----
    //
    // One error to a token: the second `Expect` failing at the token the first
    // just failed at is the same slip, and the first speaks for it.
    let e_twice: Rule<Tok> = Then([Term(Word), Expect(Literal(";")), Expect(Literal(","))]);
    assert(errors_of("a", g_of([one("t", e_twice)]), "t") == ["expected `;`, found end of input"]);

    // An `Expect` around a rule that gets part of the way blames where it stopped,
    // not where it began.
    let e_call: Rule<Tok> = Then([
        Term(Word),
        Expect(Then([Literal("("), Term(Num), Literal(")")])),
    ]);
    assert(errors_of("a ( b", g_of([one("c", e_call)]), "c") == ["expected Num, found `b`"]);

    // A `Refuse` still ends the parse, and the error it ends it with is last: the
    // `Expect`s met before it are errors too, and are reported ahead of it.
    let e_refused: Rule<Tok> = Then([Term(Word), Expect(Literal(";")), Refuse(Msg("stop"))]);
    assert(errors_of("a", g_of([one("r", e_refused)]), "r") == [
        "expected `;`, found end of input",
        "stop",
    ]);
    assert(tree_of("a", g_of([one("r", e_refused)]), "r") == "no tree");

    // ... however many, and in source order. This refusal spans everything the
    // sequence matched before it, so it is the last error and the slips come first.
    let e_gated: Rule<Tok> = Then([Many(Named("stmt")), Refuse(Msg("stop"))]);
    let g_gate = g_of([one("gated", e_gated), one("stmt", e_stmt)]);
    assert(errors_of("a b c;", g_gate, "gated") == [
        "expected `;`, found `b`",
        "expected `;`, found `c`",
        "stop",
    ]);

    // ... also when the refusal is itself inside an `Expect`, whose rule is matched
    // against a failure record of its own: what was met before still reaches it.
    let e_inside: Rule<Tok> = Then([
        Term(Word),
        Expect(Literal("+")),
        Expect(Then([Term(Num), Term(Num), Refuse(Msg("stop"))])),
    ]);
    assert(errors_of("a 1 2", g_of([one("i", e_inside)]), "i") == [
        "expected `+`, found `1`",
        "stop",
    ]);

    // A refusal at the very token a slip was reported at says it better, and
    // replaces it: its message was written for the case.
    let e_here: Rule<Tok> = Then([Term(Word), Expect(Literal(";")), Maybe(Refuse(Msg("stop")))]);
    assert(errors_of("a b", g_of([one("h", e_here)]), "h") == ["stop"]);

    // What a grammar fault does not do is blame the input: it is the call's.
    let e_unlinked: Rule<Tok> = Then([Term(Word), Expect(Literal(";")), Named("nope")]);
    assert(errors_of("a", g_of([one("u", e_unlinked)]), "u") == [`aborted: no rule named "nope"`]);

    // It can match nothing, so a repetition of one is refused rather than spun on.
    let e_forever: Rule<Tok> = Many(Expect(Literal(";")));
    assert(errors_of("a", g_of([one("f", e_forever)]), "f") == [
        "aborted: a repetition matched empty input, which would repeat forever",
    ]);

    // ---- Expect: pruning sees through it ----
    //
    // A production that opens with an `Expect` can begin with whatever follows it,
    // so FIRST-set pruning must not rule it out on the token that is there.
    let e_lead: Rule<Tok> = Then([Expect(Literal("(")), Term(Word)]);
    let g_lead = g_of([one("top", Then([Named("lead")])), one("lead", e_lead)]);
    assert(errors_of("a", g_lead, "top") == ["expected `(`, found `a`"]);
    assert(errors_of_prepared("a", g_lead, "top") == ["expected `(`, found `a`"]);
    assert(errors_of_prepared("(a", g_lead, "top") == []);

    // And an analysed grammar recovers exactly where a one-shot parse does.
    assert(errors_of_prepared("a b c;", g_e, "stmts") == errors_of("a b c;", g_e, "stmts"));
    assert(errors_of_prepared("(a b;)", g_block, "block") == errors_of("(a b;)", g_block, "block"));
    assert(errors_of_prepared("1 + (2 + 3", g_climb, "expr") == errors_of(
        "1 + (2 + 3",
        g_climb,
        "expr",
    ));
})

// ---------- test-only fixtures ----------
//
// A token kind, an AST, and a lexer for them. A real consumer brings its own of
// each; these exist because a `Grammar<K, A>` cannot be written down without
// both type arguments, and because parsing a *string* reads far better in a test
// than a hand-built token array with hand-counted spans.

variant Tok = Word(str) | Num(str) | Punct

# Lower-case words, digit runs, and one-character punctuation. Whitespace is
# skipped, so most assertions above are about grammar rather than layout;
# `trivia_rules` is the same set with whitespace and comments *recorded*, which
# is what the losslessness assertion needs.
fn tok_rules() -> TokenRule<Tok>[] {
    let alpha: char[] = "abcdefghijklmnopqrstuvwxyz";
    let digit: char[] = "0123456789";
    [
        TokenRule { matcher: CharRun(" \t\n".to_set()), emit: Bare(Punct), skip: true },
        TokenRule { matcher: CharRun(alpha.to_set()), emit: Of(Word) },
        TokenRule { matcher: CharRun(digit.to_set()), emit: Of(Num) },
        TokenRule { matcher: OneChar("()[],;+*".to_set()), emit: Bare(Punct) },
    ]
}

# Lexing and parsing report failure in the same shape but not the same type, so
# the tests convert once here rather than at every call.
fn lex_toks(src: str, rules: TokenRule<Tok>[]) -> LexResult<Tok>!ParseError {
    src.lex(rules).map_err(|e| ParseError { message: e.message, span: e.span })
}

variant Node = Atom(str) | List(Node[])

# The lowering every fixture production uses: a node with no interior children
# is a leaf carrying its text, anything else a branch carrying its children.
fn build_node(src: str, Parts { cst }, kids: Node[]) -> Node {
    if (kids.is_nonempty()) {
        return List(kids);
    };
    Atom(cst.text(src))
}

fn one(name: str, rule: Rule<Tok>) -> Production<Tok, Node> {
    name,
    rule,
    build: Mk(build_node),
    layout: Inline,
}

fn parsed(src: str, g: Grammar<Tok, Node>, start: str) -> Node!ParseError {
    let lexed = lex_toks(src, tok_rules())?;
    parse(src, lexed, g, start)
}
