// The parser driver: one function that interprets a `Grammar` (see
// `grammar.aipl`) over a token stream (see `lexer.aipl`) and yields a lossless
// `Cst` (see `cst.aipl`), plus a second pass that lowers that tree to the
// caller's own AST through each production's `build`. Together they are the
// upper half of a front end whose lower half is already data-driven: a language
// is a `TokenRule[]` and a `Grammar`, and nothing else.
//
// **PEG, not LR.** `OneOf` commits to its first matching alternative, so a
// grammar is unambiguous by construction and a failed alternative simply
// backtracks. Two consequences the driver has to handle, and does:
//
//   - *Left recursion does not work.* `expr -> expr "+" term` would call itself
//     at the same position forever. Binary operators are spelled with `Climb`
//     instead, which is why that rule exists.
//   - *Errors need furthest-failure tracking.* Backtracking throws away the
//     position where a parse got the furthest, which is nearly always where the
//     mistake is. Every rule threads a `Far` — the deepest position anything was
//     expected at, and the set of things expected there — through both success
//     and failure, so the reported error is the deepest one, not the last.
//
// **Two passes, not one.** `parse_cst` builds the tree; `lower` walks it calling
// `build`. Lowering during the parse would run a production's `build` inside
// speculative alternatives that then backtrack — wasted allocation at best, and
// at worst a `build` that legitimately fails aborting a parse that should simply
// have tried the next alternative. `parse` is the two in sequence.
//
// Costs worth knowing before this drives something large: trivia is attached by
// scanning the trivia list for each consumed token, so a parse is O(tokens ×
// trivia); and with no memoization a heavily-backtracking grammar can be
// exponential. Both are answered later in the plan — FIRST sets remove most
// backtracking — and neither matters at the sizes here.
import {
    Span,
    all,
    any,
    case_name,
    case_of,
    contains,
    equal as ==,
    extend,
    filter,
    find_if,
    find_index,
    first,
    is_empty,
    is_nonempty,
    is_some_and,
    join,
    len,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    map_err,
    not_equal as !=,
    sort,
    try_map,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_increment as ++,
    wrapping_sub as -,
} from builtins;
import {
    CGroup,
    CLeaf,
    CTree,
    CTrivia,
    Cst,
    nodes,
    show,
    span,
    text,
    token_leaves,
} from "./cst.aipl";
import { First, can_start, first_sets } from "./ebnf.aipl";
import {
    Climb,
    Grammar,
    Inline,
    ListStyle,
    Literal,
    Many,
    Maybe,
    Mk,
    Named,
    NamedIdx,
    NestedIdx,
    NestedIn,
    OneOf,
    ParseError,
    Prec,
    Production,
    Rule,
    Term,
    Then,
    failure_message,
    link,
    prod_names,
} from "./grammar.aipl";
import { Bare, CharRun, LexResult, Of, OneChar, ToEol, Token, TokenRule, lex } from "./lexer.aipl";
import { line_at } from "./line_at.aipl";

# The furthest failure seen so far: the token position nothing could be matched
# at, and the deduped labels of everything that *was* expected there.
#
# This is the reified form of what an LR table gives you for free — the state's
# expected-symbol set — and it is why `Production.expect_as` exists: under
# ordered choice a more specific alternative can fail deeper than the one that
# was really meant, so a label collapsing a family of rules to one word ("an
# expression") is what keeps the message readable.
struct Far { pos: u64, expected: str[], unclosed: Span[] = [] }

# One rule's result at one position: whether it matched, where it left off, the
# CST children it contributed to its parent, and the furthest failure so far.
#
# `hit: false` is an ordinary non-match — the caller backtracks and tries
# something else — and is *not* an error. A `ParseError` is reserved for what no
# alternative could fix: a malformed grammar, or a `build` that refused.
struct Step { hit: bool, pos: u64, kids: Cst[], far: Far }

# What the driver parses against: the tokens, the trivia the lexer set aside,
# the linked productions, and `end` — one byte past the source's last byte.
#
# The source itself is *not* here. Every token carries its own text (a
# `SpanStr`, see `lexer.aipl`), so matching a rule spelling reads the token and
# nothing else. `end` is all that remains of the source: the empty span at end
# of input, which `error_at` reports when a rule ran off the token list and
# there is no token to point at.
struct Parser<K: variant, A: any> {
    toks: Token<K>[],
    trivia: Token<K>[],
    prods: Production<K, A>[],
    end: u64,
    // The FIRST set of each production, in `prods` order — what `match_prod`
    // asks before descending. Computed once per parse (`first_sets`, a fixed
    // point over the grammar) and never during one.
    firsts: First<K>[],
    // The expectation labels each production would record on failing at its own
    // first token — what makes pruning invisible to error messages. See
    // `label_sets`.
    labels: str[][],
}

# `far` updated with "`label` was expected at `pos`". Deeper wins outright;
# equally deep joins the expected set (deduped); shallower is discarded. An
# empty label is a *transparent* production and records nothing.
fn far_miss(far: Far, pos: u64, label: str) -> Far {
    if (label.is_empty() || pos < far.pos) {
        return far;
    };
    if (far.pos < pos) {
        return Far { pos, expected: [label] };
    };
    if (far.expected.contains(label)) {
        return far;
    };

    // A deeper position starts fresh, so its `unclosed` resets with it; an
    // equally deep one keeps whatever bracket was already blamed there.
    Far { ..far, expected: [..far.expected, label] }
}

# `far` with the opening bracket that went unclosed at its position. Set by a
# `NestedIn` whose `open` matched and whose `close` did not, which is the only
# time anything knows a bracket was left hanging.
#
# It rides on the furthest failure rather than aborting the parse, because under
# ordered choice a group failing to close is an ordinary non-match: `(a)` is
# parsed by trying the tuple `(a, b)` first and letting it fail at the comma. So
# this only reaches the reader when *no* alternative worked, which is exactly
# when a hanging bracket is the likely cause.
#
# `match_nested` sets it only when the close was wanted past the last token —
# see there for why a closer failure is not evidence of anything.
# The first bracket to be blamed at a position keeps it. Groups fail from the
# inside out, so the first to record is the innermost one — and closing that is
# the edit the reader has to make first, even when an outer bracket is hanging
# too.
fn far_unclosed(far: Far, open: Span[]) -> Far {
    if (far.unclosed.is_nonempty()) {
        return far;
    };
    Far { ..far, unclosed: open }
}

# A non-match that leaves `pos` where the rule started (the caller backtracks).
fn no(far: Far, pos: u64) -> Step { hit: false, pos, kids: [], far }

# The span of the first token in `kids` — where a group's opening bracket was
# written, for the message when it is never closed. Empty when there is none.
#
# A one-element array rather than a `Span?` because that is what `Far` can hold:
# a struct field may be an optional of an integer or an array, but not of another
# struct, and `Span` is one.
fn first_token(kids: Cst[]) -> Span[] {
    match (kids.map(token_leaves).join().first()) {
        some(sp) => [sp],
        none => [],
    }
}

# A non-match that also records what was expected.
fn miss(far: Far, pos: u64, label: str) -> Step { no(far_miss(far, pos, label), pos) }

# The source text of token `i`, or `""` past the end. Empty is a safe sentinel
# because no matcher in `lexer.aipl` ever produces an empty token.
fn tok_text<K: variant, A: any>(p: Parser<K, A>, i: u64) -> str {
    match (p.toks[i]) {
        some(t) => t.text.text,
        none => "",
    }
}

# Where token `i - 1` ended — the start of the run of trivia that belongs in
# front of token `i`. Derived from the token positions rather than remembered,
# so backtracking can't leave it stale: re-consuming a token re-attaches exactly
# the same trivia.
fn prev_end<K: variant, A: any>(p: Parser<K, A>, i: u64) -> u64 {
    if (i == 0) {
        return 0;
    };
    match (p.toks[i - 1]) {
        some(t) => t.text.span.end,
        none => 0,
    }
}

# The CST children consuming token `i` contributes: every trivia record between
# the previous token and this one, then the token's own leaf. Attaching trivia
# *before* its following token is what makes the leaf spans tile the source with
# no gaps, which is the whole losslessness property.
fn leaf_at<K: variant, A: any>(p: Parser<K, A>, i: u64) -> Cst[] {
    match (p.toks[i]) {
        some(t) => {
            let start = prev_end(p, i);
            [
                ..p.trivia
                    .filter(
                        |tr| {
                            start <= tr.text.span.start && tr.text.span.start < t.text.span.start
                        },
                    )
                    .map(|tr| CTrivia(tr.text.span)),
                CLeaf(t.text.span),
            ]
        },
        none => [],
    }
}

# The trivia after the last token — a trailing comment or newline, which no
# token consumption can pick up. Appended to the root node so the tree still
# covers the source to its last byte.
fn trailing_trivia<K: variant, A: any>(p: Parser<K, A>) -> Cst[] {
    let start = prev_end(p, p.toks.len());
    p.trivia.filter(|tr| start <= tr.text.span.start).map(|tr| CTrivia(tr.text.span))
}

fn with_trailing<K: variant, A: any>(p: Parser<K, A>, root: Cst) -> Cst {
    match (root) {
        CTree(i, kids) => CTree(i, [..kids, ..trailing_trivia(p)]),
        CLeaf(sp) => CLeaf(sp),
        CTrivia(sp) => CTrivia(sp),
        // The root is a production's node, never a group — `match_prod` is what
        // `parse_cst` starts with — so there is nothing to append to here.
        CGroup(gi, open, body, close) => CGroup(gi, open, body, close),
    }
}

fn quoted(s: str) -> str {
    let q = "`";
    `{q}{s}{q}`
}

// ---------- the rules ----------

# Match `r` at `pos`. `cur` is the index of the production being matched, which
# only `Climb` needs (each operator application nests under it).
fn match_rule<K: variant, A: any>(
    p: Parser<K, A>,
    r: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    match (r) {
        Term(k) => ok(match_term(p, k, pos, far)),
        Literal(s) => ok(match_spelling(p, s, pos, far)),
        Then(rs) => match_then(p, rs, pos, cur, far),
        OneOf(rs) => match_one_of(p, rs, pos, cur, far),
        Many(sub, min, sep, trailing_sep, _, _) => match_many(
            p,
            sub,
            min,
            sep,
            trailing_sep,
            pos,
            cur,
            far,
        ),
        Maybe(sub) => match_maybe(p, sub, pos, cur, far),
        NamedIdx(i) => match_prod(p, i, pos, far),
        NestedIdx(gi, open, body, close, _) => match_nested(
            p,
            gi,
            open,
            body,
            close,
            pos,
            cur,
            far,
        ),
        Climb(atom, precs) => match_climb(p, atom, precs, pos, cur, far),
        // `link` rewrites every one of these; reaching one means the grammar was
        // handed to the driver unlinked, which `parse_cst` makes impossible.
        Named(n) => err(ParseError { message: `unlinked rule reference "{n}"`, span: 0..0 }),
        NestedIn(..) => err(ParseError { message: "unlinked group", span: 0..0 }),
    }
}

# A bracketed group: `open`, then `body`, then `close`, matched in order and kept
# as one `CGroup` naming style `gi`. It parses exactly as `Then` of the three
# would; what it adds is on either side of that.
#
# On the way in, the three runs stay separate in the tree, so the formatter knows
# which tokens are brackets without inferring it from where they sit. On the way
# out, a `close` that fails after `open` matched records the opening bracket's
# span on the furthest failure — the parse still backtracks like any non-match,
# but if nothing else works the message can say which bracket was left open.
fn match_nested<K: variant, A: any>(
    p: Parser<K, A>,
    gi: u64,
    open: Rule<K>,
    body: Rule<K>,
    close: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    let so = match_rule(p, open, pos, cur, far)?;
    if (!so.hit) {
        return ok(no(so.far, pos));
    };
    let sb = match_rule(p, body, so.pos, cur, so.far)?;
    if (!sb.hit) {
        return ok(no(sb.far, pos));
    };
    let sc = match_rule(p, close, sb.pos, cur, sb.far)?;
    if (!sc.hit) {
        // Only when the close was wanted past the last token. Anywhere else
        // there *is* a token sitting where the bracket should be, and "never
        // closed" would be a lie: `[1, 2,]` fails at the trailing comma with the
        // `]` in plain sight, and blaming the `[` would send the reader to the
        // wrong end of the list. Running out of input is the case where the
        // bracket really is hanging, and the case where the opener can be a
        // screenful away.
        if (p.toks.len() <= sb.pos) {
            return ok(no(far_unclosed(sc.far, first_token(so.kids)), pos));
        };
        return ok(no(sc.far, pos));
    };
    ok(Step { hit: true, pos: sc.pos, kids: [CGroup(gi, so.kids, sb.kids, sc.kids)], far: sc.far })
}

# Any one token whose kind is the case `k` — `Term(Name)` matches every
# identifier, whatever text it carries. `k` is a `Case<K>`: a case with no
# payload, so naming a kind needs no value of that kind.
fn match_term<K: variant, A: any>(p: Parser<K, A>, k: Case<K>, pos: u64, far: Far) -> Step {
    match (p.toks[pos]) {
        some(t) => if (t.kind.case_of() == k) {
            Step { hit: true, pos: pos + 1, kids: leaf_at(p, pos), far }
        } else {
            miss(far, pos, k.case_name())
        },
        none => miss(far, pos, k.case_name()),
    }
}

# One token spelled exactly `s`.
fn match_spelling<K: variant, A: any>(p: Parser<K, A>, s: str, pos: u64, far: Far) -> Step {
    if (pos < p.toks.len() && tok_text(p, pos) == s) {
        Step { hit: true, pos: pos + 1, kids: leaf_at(p, pos), far }
    } else {
        miss(far, pos, quoted(s))
    }
}

# Every rule in order; children concatenate. A failure anywhere rewinds the
# whole sequence to where it started — the caller decides what to try next.
fn match_then<K: variant, A: any>(
    p: Parser<K, A>,
    rs: Rule<K>[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    mut cp = pos;
    mut acc: Cst[] = [];
    mut f = far;
    for (let sub : rs) {
        let st = match_rule(p, sub, cp, cur, f)?;
        set f = st.far;
        if (!st.hit) {
            return ok(no(f, pos));
        };
        set cp = st.pos;
        set acc.extend(st.kids);
    }
    ok(Step { hit: true, pos: cp, kids: acc, far: f })
}

# The first alternative that matches. Every alternative's expectations are kept
# in `far` whether it matched or not, which is what makes "expected `(`, an
# identifier, or a number" possible from a choice that failed on all three.
fn match_one_of<K: variant, A: any>(
    p: Parser<K, A>,
    rs: Rule<K>[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    mut f = far;
    for (let sub : rs) {
        let st = match_rule(p, sub, pos, cur, f)?;
        set f = st.far;
        if (st.hit) {
            return ok(st);
        };
    }
    ok(no(f, pos))
}

# `sub` until it stops matching, at least `min` times — and, with a `sep`, with
# that separator between consecutive items.
#
# A rule that can match empty input would repeat forever here, and AIPL has no
# `break` to escape with — so a zero-width iteration is refused outright, the
# same invariant `lexer.aipl` keeps by having no matcher accept empty input.
# It is a grammar bug, reported as one rather than hung on.
#
# The separated case is the same loop with one step in front of each item after
# the first. What the separator matched is held back until an item follows it,
# because a separator with nothing after it is only part of the list when
# `trailing_sep` says so; otherwise the position rewinds to before it and the
# enclosing rule is the one that complains — which is how `[1, 2,]` can be
# either the list or a list followed by a stray comma.
fn match_many<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    min: u64,
    sep: Rule<K>?,
    trailing_sep: bool,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    mut cp = pos;
    mut acc: Cst[] = [];
    mut f = far;
    mut n: u64 = 0;
    mut going = true;
    while (going) {
        // Everything after the first item is preceded by the separator, when
        // there is one. An unseparated list, and the first item of any list,
        // take the empty step — so `before` and `after` coincide and the
        // trailing-separator rule below never fires.
        let before = cp;
        let led = if (n == 0) { hit_nothing(cp, f) } else { match_sep(p, sep, cp, cur, f)? };
        set f = led.far;
        if (led.hit) {
            let after = led.pos;
            let st = match_rule(p, sub, after, cur, f)?;
            set f = st.far;
            if (st.hit) {
                if (st.pos == after) {
                    return err(ParseError {
                        message: "a repetition matched empty input, which would repeat forever",
                        span: 0..0,
                    });
                };
                set acc.extend(led.kids);
                set acc.extend(st.kids);
                set cp = st.pos;
                set n++;
            } else {
                // A separator with nothing after it.
                if (trailing_sep && before != after) {
                    set acc.extend(led.kids);
                    set cp = after;
                } else {
                    set cp = before;
                };
                set going = false;
            };
        } else {
            set going = false;
        };
    }
    if (n < min) {
        return ok(no(f, pos));
    };
    ok(Step { hit: true, pos: cp, kids: acc, far: f })
}

# The separator step: what `sep` matched, or an empty match when there is none.
fn match_sep<K: variant, A: any>(
    p: Parser<K, A>,
    sep: Rule<K>?,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    match (sep) {
        some(s) => match_rule(p, s, pos, cur, far),
        none => ok(hit_nothing(pos, far)),
    }
}

# A match that consumed nothing and succeeded — the identity step.
fn hit_nothing(pos: u64, far: Far) -> Step { hit: true, pos, kids: [], far }

# `sub`, or nothing. Always matches — but its expectations still reach `far`, so
# an optional part that was *started* and then went wrong still reports.
fn match_maybe<K: variant, A: any>(
    p: Parser<K, A>,
    sub: Rule<K>,
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    let st = match_rule(p, sub, pos, cur, far)?;
    if (st.hit) {
        return ok(st);
    };
    ok(Step { hit: true, pos, kids: [], far: st.far })
}

# A reference to production `i` — and the only rule that builds a node. The
# production's own rule matches, and its children go into one `CTree(i, ..)`.
#
# A labelled production that fails *without getting anywhere* reports as its
# label instead of as the expectations from inside it — the collapse
# `SYMBOL_DISPLAY_NAMES` performs for the LR parser, where `expr`/`term`/`atom`
# all render as "expression". It matters more here than there: under ordered
# choice every alternative of a failed `OneOf` leaves its own expectation
# behind, so an uncollapsed message lists the grammar's internals.
#
# "Without getting anywhere" is the operative test. When the production failed
# *deeper* than it started, that deeper expectation is the useful one and the
# label is not applied; when it failed at its own first token, the label
# replaces what it expected there — but only what *this* production contributed,
# since the incoming `far` (a sibling alternative's expectations at the same
# position) is what the label is merged into. A transparent production (empty
# `expect_as`) never collapses anything: its insides are the message.
fn match_prod<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64, far: Far) -> Step!ParseError {
    let Production { rule, expect_as } = p.prods[i].value_or_err(ParseError {
        message: `no production at index {i}`,
        span: 0..0,
    })?;

    // Ask the FIRST set before descending. A production that cannot begin with
    // the token sitting here cannot match here, and under ordered choice that is
    // the common case: `atom`'s twenty alternatives are twenty productions, of
    // which one token of lookahead rules out nearly all.
    //
    // This is the one place worth asking. A `Named` reference is where the
    // driver recurses, so pruning here removes whole subtrees rather than single
    // token compares — and it costs a table lookup and a membership test, with
    // no rule walked and nothing allocated.
    if (!can_reach(p, i, pos)) {
        return ok(pruned(p, i, pos, expect_as, far));
    };
    let st = match_rule(p, rule, pos, i, far)?;
    if (st.hit) {
        return ok(Step { hit: true, pos: st.pos, kids: [CTree(i, st.kids)], far: st.far });
    };
    if (pos < st.far.pos || expect_as.is_empty()) {
        return ok(no(st.far, pos));
    };
    ok(no(far_miss(far, pos, expect_as), pos))
}

# Whether production `i` could begin with the token at `pos` — its FIRST set
# asked about that token's kind and spelling.
#
# True at end of input, where there is no token to rule anything out: a nullable
# production still matches there, and the cost of trying the rest is one failed
# token compare. `can_start` is conservative in the safe direction anyway, so the
# only thing a wrong answer here could cost is the pruning itself.
fn can_reach<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64) -> bool {
    match (p.toks[pos]) {
        some(t) => match (p.firsts[i]) {
            some(f) => f.can_start(t.kind.case_of(), t.text.text),
            // A grammar whose FIRST sets and productions disagree in length is
            // not one this can prune; let the match decide.
            none => true,
        },
        none => true,
    }
}

# The `Step` a pruned production yields — the one its rule would have produced,
# without running it.
#
# A pruned production cannot consume the token at `pos`, so it cannot fail any
# deeper than `pos`; that is exactly the branch of `match_prod` where a label
# replaces what the production's insides expected. So for a *labelled*
# production this is observationally identical to attempting it.
#
# A transparent one has no label to record, and what it would have recorded is
# its insides' expectations at `pos` — which pruning skips over. That is a real
# difference and it is confined to the expected-set of an error reported at this
# exact position; see `label_sets` in `ebnf.aipl` for the exact version.
fn pruned<K: variant, A: any>(p: Parser<K, A>, i: u64, pos: u64, expect_as: str, far: Far) -> Step {
    if (!expect_as.is_empty()) {
        return no(far_miss(far, pos, expect_as), pos);
    };
    mut f = far;
    for (let l : p.labels[i].value_or([])) {
        set f = far_miss(f, pos, l);
    }
    no(f, pos)
}

# The expectation labels each production would record on failing at its own first
# token, in grammar order — the FIRST set computed over *labels* rather than
# terminals, so a labelled sub-production contributes its label and a transparent
# one contributes its insides.
#
# This exists so pruning is invisible. `match_prod`'s label branch already makes
# a pruned *labelled* production observationally identical to an attempted one; a
# transparent production has no label, and what it would have recorded is exactly
# this. Without it, skipping a production silently drops entries from the
# "expected a, b, or c" set of any error reported at that position — which the
# driver's own tests catch, seven of them.
#
# A fixed point for the same reason `first_sets` is one: a transparent production
# referencing another is not answerable until that one is.
#
# The result is a *set* in everything but representation: `error_at` sorts before
# rendering, so the order these accumulate in is not observable. It stays a
# deduped `str[]` only because a `#{str}` cannot be iterated, and the labels have
# to be folded into `Far` one at a time.
fn label_sets<K: variant, A: any>(prods: Production<K, A>[], firsts: First<K>[]) -> str[][] {
    let empty: str[] = [];
    mut labels = prods.map(|pr| empty);
    mut going = true;
    while (going) {
        let prev = labels;
        let next = prods.map(|pr| rule_labels(pr.rule, prods, firsts, prev));
        if (next == prev) {
            set going = false;
        } else {
            set labels = next;
        };
    }
    labels
}

# The labels `r` would record at its own first token, given the round's `labels`.
fn rule_labels<K: variant, A: any>(
    r: Rule<K>,
    prods: Production<K, A>[],
    firsts: First<K>[],
    labels: str[][],
) -> str[] {
    match (r) {
        Term(k) => [k.case_name()],
        Literal(s) => [quoted(s)],
        // A sequence is tried from its front, and past every element that can
        // match nothing — the same walk `rule_first` makes over terminals.
        Then(rs) => seq_labels(rs, prods, firsts, labels),
        OneOf(rs) => {
            mut out: str[] = [];
            for (let sub : rs) {
                set out = union_labels(out, rule_labels(sub, prods, firsts, labels));
            }
            out
        },
        // A repetition and an option both try their body at offset 0; a
        // separator is only ever reached after an item.
        Many(sub, _, _, _, _, _) => rule_labels(sub, prods, firsts, labels),
        Maybe(sub) => rule_labels(sub, prods, firsts, labels),
        Climb(atom, _) => rule_labels(atom, prods, firsts, labels),
        NestedIdx(_, open, body, close, _) => seq_labels(
            [open, body, close],
            prods,
            firsts,
            labels,
        ),
        // The collapse `expect_as` exists for: a labelled production is one word
        // in a message, and its insides never surface.
        NamedIdx(i) => match (prods[i]) {
            some(pr) => if (pr.expect_as.is_empty()) {
                labels[i].value_or([])
            } else {
                [pr.expect_as]
            },
            none => [],
        },
        // Unlinked — `parse_cst` links first, so neither is reachable from a
        // parse; an unlinked grammar simply prunes nothing.
        Named(..) | NestedIn(..) => [],
    }
}

# `rule_labels` across a sequence: each element in turn, stopping after the first
# that cannot match nothing.
fn seq_labels<K: variant, A: any>(
    rs: Rule<K>[],
    prods: Production<K, A>[],
    firsts: First<K>[],
    labels: str[][],
) -> str[] {
    mut out: str[] = [];
    for (let sub : rs) {
        set out = union_labels(out, rule_labels(sub, prods, firsts, labels));
        if (!rule_nullable(sub, firsts)) {
            return out;
        };
    }
    out
}

# Whether `r` can match nothing at all — read off the FIRST sets for a reference,
# and structural everywhere else. Only `seq_labels` needs it, to know how far
# along a sequence the first token can still be expected.
fn rule_nullable<K: variant>(r: Rule<K>, firsts: First<K>[]) -> bool {
    match (r) {
        Term(..) | Literal(..) | Named(..) | NestedIn(..) => false,
        Then(rs) => rs.all(|sub| rule_nullable(sub, firsts)),
        OneOf(rs) => rs.any(|sub| rule_nullable(sub, firsts)),
        Many(sub, min, _, _, _, _) => min == 0 || rule_nullable(sub, firsts),
        Maybe(..) => true,
        Climb(atom, _) => rule_nullable(atom, firsts),
        NestedIdx(_, open, body, close, _) => rule_nullable(open, firsts) && rule_nullable(
            body,
            firsts,
        ) && rule_nullable(close, firsts),
        NamedIdx(i) => firsts[i].is_some_and(|f| f.nullable),
    }
}

# `a` then whatever in `b` is not already there. Only the deduplication matters —
# `error_at` sorts — so this is a set union written the long way, for want of an
# iterable set.
fn union_labels(a: str[], b: str[]) -> str[] {
    mut out = a;
    for (let l : b) {
        if (!out.contains(l)) {
            set out = [..out, l];
        };
    }
    out
}

# The precedence level `text` belongs to, if it binds at least as tightly as
# `min_power`. Levels are scanned in order, so a spelling listed twice takes the
# first. The empty string never matches — that is what `tok_text` returns past
# the end of the tokens, so running out of input simply ends the climb.
fn find_prec(precs: Prec[], text: str, min_power: u64) -> Prec? {
    if (text.is_empty()) {
        return none;
    };
    precs.find_if(|pr| min_power <= pr.power && pr.ops.contains(text))
}

fn match_climb<K: variant, A: any>(
    p: Parser<K, A>,
    atom: Rule<K>,
    precs: Prec[],
    pos: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    let any_power: u64 = 0;
    climb(p, atom, precs, pos, any_power, cur, far)
}

# Precedence climbing: an atom, then any operator binding at least as tightly as
# `min_power`, whose right-hand side is climbed at one power higher (or the same
# power, for a right-associative level).
#
# Each application nests *both* operands under the enclosing production's index
# while leaving the outermost one flat, so `match_prod`'s own wrap completes the
# tree: `1 + 2 * 3` becomes `(expr (expr 1) + (expr (expr 2) * (expr 3)))` — one
# node per operand, shaped by precedence rather than a flat run the lowering
# would have to re-parse.
fn climb<K: variant, A: any>(
    p: Parser<K, A>,
    atom: Rule<K>,
    precs: Prec[],
    pos: u64,
    min_power: u64,
    cur: u64,
    far: Far,
) -> Step!ParseError {
    let head = match_rule(p, atom, pos, cur, far)?;
    if (!head.hit) {
        return ok(head);
    };
    mut kids = head.kids;
    mut cp = head.pos;
    mut f = head.far;
    mut going = true;
    while (going) {
        match (find_prec(precs, tok_text(p, cp), min_power)) {
            some(pr) => {
                let op_kids = leaf_at(p, cp);
                let next_min = if (pr.right) { pr.power } else { pr.power + 1 };
                let rhs = climb(p, atom, precs, cp + 1, next_min, cur, f)?;
                set f = rhs.far;
                if (rhs.hit) {
                    set kids = [CTree(cur, kids), ..op_kids, CTree(cur, rhs.kids)];
                    set cp = rhs.pos;
                } else {
                    // An operator with nothing after it: leave it unconsumed for
                    // the enclosing rule, which will report it.
                    set going = false;
                };
            },
            none => {
                set going = false;
            },
        };
    }
    ok(Step { hit: true, pos: cp, kids, far: f })
}

// ---------- errors ----------

# The error a furthest failure describes: what was expected there, and what was
# found instead. The span is the offending token's (or the empty span at the end
# of the source), which is what `caret_block.aipl` renders the underline from.
fn error_at<K: variant, A: any>(p: Parser<K, A>, src: str, far: Far) -> ParseError {
    let found = if (far.pos < p.toks.len()) {
        quoted(tok_text(p, far.pos))
    } else {
        "end of input"
    };
    let span = match (p.toks[far.pos]) {
        some(t) => t.text.span,
        none => p.end..p.end,
    };
    let hint = unclosed_hint(src, far.unclosed);
    if (far.expected.is_empty()) {
        return ParseError { message: `unexpected {found}{hint}`, span };
    };

    // Sorted, not in the order the alternatives happened to be tried. The order
    // a PEG reaches its alternatives in is an artefact of how the grammar was
    // written, not something a reader can use, and it moves whenever a
    // production is reordered. Sorting makes the message a function of *what*
    // was expected and nothing else — the same reason gazelle collects its own
    // expected set into a `BTreeSet` (`friendly_syntax_error`), which is the
    // behaviour this has to match when it takes over.
    //
    // It also means nothing upstream has to preserve order: `far_miss` and
    // `label_sets` dedupe, and are free to do it however they like.
    //
    // `a`, `a or b`, `a, b, or c` — the Oxford list `join`'s two extra
    // separators write directly.
    let expected = far.expected.sort().join(sep=", ", final_sep=", or ", only_sep=" or ");
    ParseError { message: `expected {expected}, found {found}{hint}`, span }
}

# The parenthetical naming the bracket that was never closed, or the empty string
# when no group got that far. The span stays on the *failure*, which is where the
# reader has to type something; the opener is named by line because pointing at
# two places at once is what a single-span error cannot do.
#
# This is the whole reason `NestedIn` exists on the parsing side: a flat
# `Then([Lit("("), .., Lit(")")])` fails at the close having forgotten there was
# an open, and reports "expected `)`, found end of input" a hundred lines away
# from the `(` that caused it.
fn unclosed_hint(src: str, open: Span[]) -> str {
    match (open.first()) {
        some(sp) => {
            let line = line_at(src, sp.start).line + 1;
            ` ({quoted(src[sp])} at line {line} is never closed)`
        },
        none => "",
    }
}

// ---------- entry points ----------

# Parses `src` — already lexed into `lexed` — against grammar `g`, beginning at
# the production named `start`, and returns the lossless concrete syntax tree.
#
# `g` is linked here, so it may be handed over unlinked; linking is idempotent,
# so a caller parsing repeatedly can `link` once and pay nothing again. Every
# token must be consumed: input left over after the start rule succeeds is an
# error, not a partial parse.
#
# Fails with a `ParseError` carrying the span of the offending token — the
# *furthest* position anything was expected at, not the last one tried — or the
# empty span at the end of the source when the input simply ran out.
pub fn parse_cst<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    g: Grammar<K, A>,
    start: str,
) -> Cst!ParseError {
    // Deliberately *not* `prepare`: analysing a grammar costs more than pruning
    // saves when the result is used for a single parse. Measured on the corpus —
    // ~750 one-shot parses — analysing every time is an 8% loss, while the same
    // analysis reused across parses is a 2x win. So a one-shot parse links and
    // nothing more, and the driver simply finds no FIRST set to prune on.
    let none_yet: First<K>[] = [];
    let no_labels: str[][] = [];
    let prep = Prepared { grammar: link(g)?, firsts: none_yet, labels: no_labels };
    parse_prepared(src, lexed, prep, start)
}

# A grammar linked, and optionally analysed, ready to parse with.
#
# Everything here is a function of the grammar *alone* — the linked rules, the
# FIRST sets, the expectation labels — so a caller parsing more than one source
# builds this once with `prepare` and hands it to `parse_prepared` for each.
#
# `firsts` and `labels` are empty when the grammar was linked but not analysed,
# which is what `parse_cst` does. The driver reads that as "nothing to prune on"
# and matches every production it reaches; the parse is identical, only slower.
# Analysis is a cost worth paying exactly once per grammar and never once per
# source.
struct Prepared<K: variant, A: any> { grammar: Grammar<K, A>, firsts: First<K>[], labels: str[][] }

# `g` linked and analysed — build it once, parse with it many times. Fails the
# way `link` does: an unresolved reference, or a duplicate rule name.
pub fn prepare<K: variant, A: any>(g: Grammar<K, A>) -> Prepared<K, A>!ParseError {
    let grammar: Grammar<K, A> = link(g)?;
    let firsts = first_sets(grammar)?;
    let labels = label_sets(grammar.prods, firsts);
    ok(Prepared { grammar, firsts, labels })
}

# `parse_cst` against an already-prepared grammar — the same parse, without
# re-linking and re-analysing the grammar for every source.
pub fn parse_prepared<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    prep: Prepared<K, A>,
    start: str,
) -> Cst!ParseError {
    let Prepared { grammar, firsts, labels } = prep;
    let i = prod_names(grammar)
        .find_index(|n| n == start)
        .value_or_err(ParseError { message: `no rule named "{start}"`, span: 0..0 })?;
    let p = Parser {
        toks: lexed.tokens,
        trivia: lexed.trivia,
        prods: grammar.prods,
        end: src.len(),
        firsts,
        labels,
    };
    let Step { hit, far, pos, kids } = match_prod(p, i, 0, Far { pos: 0, expected: [] })?;
    if (!hit) {
        return err(error_at(p, src, far));
    };
    if (pos < p.toks.len()) {
        return err(error_at(p, src, far_miss(far, pos, "end of input")));
    };
    let root = kids
        .first()
        .value_or_err(ParseError { message: "the start rule built no node", span: 0..0 })?;
    ok(with_trailing(p, root))
}

# Lowers a parsed tree to the caller's AST by calling each node's production
# `build`, depth first: a node's children are lowered before it, and only its
# *interior* children are passed (`nodes`) — a leaf has no lowered value,
# and its text is reachable from the node's own span.
#
# Fails with whatever a `build` refused with, unchanged.
pub fn lower<K: variant, A: any>(src: str, node: Cst, g: Grammar<K, A>) -> A!ParseError {
    lower_node(src, node, g.prods)
}

fn lower_node<K: variant, A: any>(src: str, node: Cst, prods: Production<K, A>[]) -> A!ParseError {
    match (node) {
        CTree(i, kids) => {
            // `nodes` splices groups away, so a production that wraps a bracket
            // pair hands its `build` the same children it would without one.
            let vals = node.nodes().try_map(|k| lower_node(src, k, prods))?;
            let Production { build } = prods[i].value_or_err(ParseError {
                message: `no production at index {i}`,
                span: node.span(),
            })?;
            match (build) {
                Mk(f) => f(src, node, vals),
            }
        },
        CLeaf(span) => err(ParseError { message: "a token leaf has no lowered value", span }),
        CTrivia(span) => err(ParseError { message: "trivia has no lowered value", span }),
        // Unreachable from a tree `parse_cst` built: `nodes` splices every group
        // away before this recurses, so lowering never lands on one.
        CGroup(..) => err(ParseError {
            message: "a group has no lowered value",
            span: node.span(),
        }),
    }
}

# `parse_cst` followed by `lower`: the source's AST, with the concrete tree
# built and discarded in between. Use `parse_cst` when the tree itself is the
# point (a formatter, a highlighter), and this when only the AST is.
pub fn parse<K: variant, A: any>(
    src: str,
    lexed: LexResult<K>,
    g: Grammar<K, A>,
    start: str,
) -> A!ParseError { lower(src, parse_cst(src, lexed, g, start)?, g) }.test({
    // ---- Term: any token of a kind, payload ignored ----
    let r_word: Rule<Tok> = Term(Word);
    let g_word = g_of([one("w", r_word)]);
    assert(shown("abc", g_word, "w")? == "(w abc)");
    assert(msg_of("123", g_word, "w") == "expected Word, found `123`");
    assert(msg_of("", g_word, "w") == "expected Word, found end of input");
    // Every token must be consumed; a partial parse is an error, not a result.
    assert(msg_of("a b", g_word, "w") == "expected end of input, found `b`");
    // A start rule no production answers to.
    assert(msg_of("a", g_word, "nope") == "no rule named \"nope\"");

    // ---- Literal: one token by its text ----
    let r_open: Rule<Tok> = Literal("(");
    let g_open = g_of([one("o", r_open)]);
    assert(shown("(", g_open, "o")? == "(o ()");
    assert(msg_of("x", g_open, "o") == "expected `(`, found `x`");

    // ---- Then: a sequence, children concatenated ----
    let r_pair: Rule<Tok> = Then([Term(Word), Term(Num)]);
    let g_pair = g_of([one("p", r_pair)]);
    assert(shown("ab 12", g_pair, "p")? == "(p ab 12)");

    // A failure part-way through rewinds the whole sequence, but the deepest
    // expectation is what gets reported.
    assert(msg_of("ab cd", g_pair, "p") == "expected Num, found `cd`");

    // ---- OneOf: ordered choice, and the expected *set* it leaves behind ----
    let r_atom: Rule<Tok> = OneOf([Term(Word), Term(Num), Literal("(")]);
    let g_atom = g_of([one("a", r_atom)]);
    assert(shown("x", g_atom, "a")? == "(a x)");
    assert(shown("7", g_atom, "a")? == "(a 7)");
    // Three alternatives, three expectations, Oxford-joined.
    assert(msg_of("]", g_atom, "a") == "expected Num, Word, or `(`, found `]`");
    // Two joins with "or"; a repeated expectation is deduped, not doubled.
    let r_dup: Rule<Tok> = OneOf([Term(Word), Term(Num), Term(Word)]);
    assert(msg_of("]", g_of([one("a", r_dup)]), "a") == "expected Num or Word, found `]`");

    // ---- Many: zero-or-more and one-or-more ----
    let r_many: Rule<Tok> = Many(Term(Word));
    let g_many = g_of([one("m", r_many)]);
    assert(shown("a b c", g_many, "m")? == "(m a b c)");
    assert(shown("", g_many, "m")? == "(m)");
    let r_many1: Rule<Tok> = Many(Term(Word), min=1);
    assert(shown("a", g_of([one("m", r_many1)]), "m")? == "(m a)");
    assert(msg_of("", g_of([one("m", r_many1)]), "m") == "expected Word, found end of input");

    // A rule that can match empty input would repeat forever. It is refused,
    // not hung on — the driver's counterpart of the lexer's "no matcher matches
    // empty input" invariant.
    let r_loop: Rule<Tok> = Many(Maybe(Term(Word)));
    assert(
        msg_of(
            "x",
            g_of([one("l", r_loop)]),
            "l",
        ) == "a repetition matched empty input, which would repeat forever",
    );

    // ---- Maybe: present and absent ----
    let r_opt: Rule<Tok> = Then([Term(Word), Maybe(Term(Num))]);
    let g_opt = g_of([one("m", r_opt)]);
    assert(shown("a 1", g_opt, "m")? == "(m a 1)");
    assert(shown("a", g_opt, "m")? == "(m a)");

    // ---- Named/NamedIdx: a reference reaching back through another production,
    // which is what makes the CST (and the parse) genuinely recursive ----
    let r_item: Rule<Tok> = OneOf([Term(Word), Named("list")]);

    // Annotated, like every other rule here: nothing inside `Then` mentions `K`,
    // and there is more than one `Rule` instance in scope for it to fall back on.
    let r_list: Rule<Tok> = Then([Literal("("), Many(Named("item")), Literal(")")]);
    let g_sexp = g_of([one("list", r_list), one("item", r_item)]);
    assert(shown("(a b)", g_sexp, "list")? == "(list ( (item a) (item b) ))");
    assert(
        shown(
            "(a (b) c)",
            g_sexp,
            "list",
        )? == "(list ( (item a) (item (list ( (item b) ))) (item c) ))",
    );
    assert(msg_of("(a", g_sexp, "list") == "expected Word, `(`, or `)`, found end of input");

    // ---- Many with a separator, and the trailing-separator rule ----
    let comma: Rule<Tok> = Literal(",");
    let nums = Many(Term(Num), sep=some(comma), trailing_sep=false);
    let r_nums: Rule<Tok> = Then([Literal("["), nums, Literal("]")]);
    let g_nums = g_of([one("l", r_nums)]);
    assert(shown("[1, 2, 3]", g_nums, "l")? == "(l [ 1 , 2 , 3 ])");
    // An empty list is a list.
    assert(shown("[]", g_nums, "l")? == "(l [ ])");

    // With `trailing: false` the dangling separator is left for the enclosing
    // rule, which is what reports it.
    assert(msg_of("[1, 2,]", g_nums, "l") == "expected Num, found `]`");
    let trail = Many(Term(Num), sep=some(comma));
    let r_trail: Rule<Tok> = Then([Literal("["), trail, Literal("]")]);
    assert(shown("[1, 2,]", g_of([one("l", r_trail)]), "l")? == "(l [ 1 , 2 , ])");

    // ---- Climb: precedence and associativity ----
    let plus = Prec { power: 1, right: false, ops: ["+"] };
    let times = Prec { power: 2, right: false, ops: ["*"] };
    let r_expr: Rule<Tok> = Climb(Term(Num), [plus, times]);
    let g_expr = g_of([one("e", r_expr)]);
    // A bare atom climbs to itself: no operator, no extra node.
    assert(shown("1", g_expr, "e")? == "(e 1)");
    // `*` binds tighter, so it nests inside the `+`.
    assert(shown("1 + 2 * 3", g_expr, "e")? == "(e (e 1) + (e (e 2) * (e 3)))");
    // ... and the other order proves it is precedence, not source order.
    assert(shown("1 * 2 + 3", g_expr, "e")? == "(e (e (e 1) * (e 2)) + (e 3))");
    // Equal power, left-associative: the left operand is the nested one.
    assert(shown("1 + 2 + 3", g_expr, "e")? == "(e (e (e 1) + (e 2)) + (e 3))");
    // The same level marked right-associative nests the other way.
    let rpow = Prec { power: 1, right: true, ops: ["*"] };
    let r_pow: Rule<Tok> = Climb(Term(Num), [rpow]);
    assert(shown("1 * 2 * 3", g_of([one("e", r_pow)]), "e")? == "(e (e 1) * (e (e 2) * (e 3)))");

    // An operator with nothing after it leaves the operator unconsumed, so the
    // leftover-input check fires at the `+` — but the missing operand was
    // expected one position *further*, and furthest-failure tracking is what
    // makes that, rather than the `+`, the thing reported.
    assert(msg_of("1 +", g_expr, "e") == "expected Num, found end of input");

    // ---- expect_as: collapsing a family of rules to one word ----
    //
    // Unlabelled, the message is the grammar's internals; labelled, it is the
    // one word a reader wants — and only when the production got nowhere, so a
    // partly-matched one still reports the finer expectation.
    let r_stmt: Rule<Tok> = Then([Named("expr"), Literal(";")]);
    let r_alt: Rule<Tok> = OneOf([Term(Word), Term(Num)]);
    let plain = g_of([one("stmt", r_stmt), one("expr", r_alt)]);
    assert(msg_of("]", plain, "stmt") == "expected Num or Word, found `]`");
    let labelled = g_of([one("stmt", r_stmt), labelled_prod("expr", r_alt, "an expression")]);
    assert(msg_of("]", labelled, "stmt") == "expected an expression, found `]`");
    // Got somewhere, so the label steps aside for what actually went wrong.
    assert(msg_of("a ]", labelled, "stmt") == "expected `;`, found `]`");

    // ---- Trivia and losslessness ----
    //
    // With whitespace and comments lexed as trivia rather than skipped, every
    // byte of the source ends up under exactly one leaf — including the run
    // after the last token, which no token consumption can pick up.
    let src = "  ( a  b ) // done\n";
    let lexed = lex_toks(src, trivia_rules())?;
    let tree = parse_cst(src, lexed, g_sexp, "list")?;
    assert(tree.text(src) == src);

    // Where each piece landed, on a source small enough to read: leading trivia
    // attaches in front of the token that follows it, and the comment and
    // newline after the last token attach to the root.
    let small = "(a) // x";
    let small_tree = parse_cst(small, lex_toks(small, trivia_rules())?, g_sexp, "list")?;
    assert(small_tree.text(small) == small);
    assert(small_tree.show(small, prod_names(g_sexp)) == "(list ( (item a) ) ~  ~// x)");

    // ---- Lowering ----
    //
    // Each node's `build` sees the already-lowered values of its *interior*
    // children only, so `build_node` distinguishes a leaf from a branch by
    // whether it got any. `Node` is boxed and recursive, and `build` reaches it
    // through a function *value* — the shape this library was waiting on.
    assert(parsed("(a b)", g_sexp, "list")? == NNode([NLeaf("a"), NLeaf("b")]));
    assert(
        parsed("(a (b) c)", g_sexp, "list")? == NNode([
            NLeaf("a"),
            NNode([NNode([NLeaf("b")])]),
            NLeaf("c"),
        ]),
    );
    // A `build` that refuses fails the parse with its own error, unchanged.
    let refuser = g_of([Production { name: "w", rule: r_word, build: Mk(refuse), layout: Inline }]);
    assert(parsed("abc", refuser, "w") == err(ParseError { message: "refused", span: 0..3 }));

    // ---- link is not optional, and `parse_cst` does it ----
    //
    // A grammar handed over unlinked parses anyway; linking twice changes
    // nothing.
    assert(shown("(a b)", link(g_sexp)?, "list")? == "(list ( (item a) (item b) ))");

    // ---- Groups ----
    //
    // The same S-expression grammar with its brackets written as a `NestedIn`
    // rather than a flat `Then`. It parses the same input to the same *lowered*
    // value, because a group is transparent to everything but the formatter.
    let g_list: Rule<Tok> = NestedIn(
        Literal("("),
        Many(NamedIdx(1), sep=some(Literal(","))),
        Literal(")"),
        style=ListStyle { spaced: true },
    );
    let g_item: Rule<Tok> = OneOf([Term(Word), Named("list")]);
    let g_grp = g_of([one("list", g_list), one("item", g_item)]);

    // The tree shows the brackets as a group — `[..]` in `show` — with the items
    // between them, and the source still comes back whole.
    assert(shown("(a, b)", g_grp, "list")? == "(list [( (item a) , (item b) )])");
    assert(parsed("(a, b)", g_grp, "list")? == NNode([NLeaf("a"), NLeaf("b")]));

    // Nested groups nest, and lowering still sees one child per item.
    assert(parsed("(a, (b))", g_grp, "list")? == NNode([NLeaf("a"), NNode([NNode([NLeaf("b")])])]));

    // The style rode into the grammar's `groups` table, keyed by the index the
    // `CGroup` carries.
    assert(link(g_grp)?.groups == [ListStyle { spaced: true }]);

    // Losslessness holds through a group: trivia inside the brackets attaches to
    // the token that follows it, exactly as it does inside a production.
    let gsrc = "( a, // c\n  b )";
    let gtree = parse_cst(gsrc, lex_toks(gsrc, trivia_rules())?, g_grp, "list")?;
    assert(gtree.text(gsrc) == gsrc);

    // ---- The unclosed bracket ----
    //
    // The payoff for the parser: a group that opens and never closes names the
    // bracket that did it. A flat `Then` fails at the close having forgotten
    // there was an open, so all it can say is the first half of this.
    assert(
        msg_of(
            "(a, b",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 1 is never closed)",
    );

    // The line is the *opener's*, not the failure's — which is the whole point
    // when the two are far apart.
    assert(
        msg_of(
            "(a,\nb,\nc",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 1 is never closed)",
    );

    // An inner bracket left open blames the inner one, being the deepest failure
    // — put the two on different lines and it is the inner line that is named.
    assert(
        msg_of(
            "(a,\n(b",
            g_grp,
            "list",
        ) == "expected `)` or `,`, found end of input (`(` at line 2 is never closed)",
    );

    // A failure that has nothing to do with a bracket says nothing about one.
    assert(msg_of("a", g_grp, "list") == "expected `(`, found `a`");

    // ---- Pruning is invisible ----
    //
    // `prepare` analyses the grammar so `match_prod` can skip a production whose
    // FIRST set rules out the token in front of it. That must change *nothing* a
    // caller can see: the same trees, and — the part that is easy to get wrong —
    // the same expected-sets in the same order.
    //
    // The expectations are the whole reason `label_sets` exists. Pruning a
    // labelled production is exactly its label, which `match_prod` would have
    // applied anyway; pruning a *transparent* one skips the insides that would
    // have recorded what they expected here, and those have to be put back. Seven
    // of the assertions below caught that when they were not.
    assert(shown_prepared("(a b)", g_sexp, "list")? == shown("(a b)", g_sexp, "list")?);
    assert(shown_prepared("(a (b) c)", g_sexp, "list")? == shown("(a (b) c)", g_sexp, "list")?);
    assert(shown_prepared("(a, b)", g_grp, "list")? == shown("(a, b)", g_grp, "list")?);
    assert(msg_of_prepared("123", g_word, "w") == msg_of("123", g_word, "w"));
    assert(msg_of_prepared("x", g_open, "o") == msg_of("x", g_open, "o"));
    assert(msg_of_prepared("]", g_atom, "a") == msg_of("]", g_atom, "a"));
    assert(msg_of_prepared("]", plain, "stmt") == msg_of("]", plain, "stmt"));
    assert(msg_of_prepared("]", labelled, "stmt") == msg_of("]", labelled, "stmt"));
    assert(msg_of_prepared("a", g_grp, "list") == msg_of("a", g_grp, "list"));
    assert(msg_of_prepared("(a, b", g_grp, "list") == msg_of("(a, b", g_grp, "list"));

    // Spelled out once rather than only compared, so a regression that broke
    // *both* paths the same way could not pass unnoticed.
    assert(msg_of_prepared("]", g_atom, "a") == "expected Num, Word, or `(`, found `]`");
    assert(msg_of_prepared("]", labelled, "stmt") == "expected an expression, found `]`");
})

// ---------- test-only fixtures ----------
//
// A token kind, an AST, and a lexer for them. A real consumer brings its own of
// each; these exist because a `Grammar<K, A>` cannot be written down without
// both type arguments, and because parsing a *string* reads far better in a test
// than a hand-built token array with hand-counted spans.

variant Tok = Word(str) | Num(str) | Punct

# Lower-case words, digit runs, and one-character punctuation. Whitespace is
# skipped, so most assertions above are about grammar rather than layout;
# `trivia_rules` is the same set with whitespace and comments *recorded*, which
# is what the losslessness assertion needs.
fn tok_rules() -> TokenRule<Tok>[] {
    let alpha = "abcdefghijklmnopqrstuvwxyz";
    let digit = "0123456789";
    [
        TokenRule { matcher: CharRun(" \t\n"), emit: Bare(Punct), skip: true },
        TokenRule { matcher: CharRun(alpha), emit: Of(Word) },
        TokenRule { matcher: CharRun(digit), emit: Of(Num) },
        TokenRule { matcher: OneChar("()[],;+*"), emit: Bare(Punct) },
    ]
}

fn trivia_rules() -> TokenRule<Tok>[] {
    let alpha = "abcdefghijklmnopqrstuvwxyz";
    let digit = "0123456789";
    [
        TokenRule { matcher: CharRun(" \t\n"), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: ToEol("//"), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: CharRun(alpha), emit: Of(Word) },
        TokenRule { matcher: CharRun(digit), emit: Of(Num) },
        TokenRule { matcher: OneChar("()[],;+*"), emit: Bare(Punct) },
    ]
}

# Lexing and parsing report failure in the same shape but not the same type, so
# the tests convert once here rather than at every call.
fn lex_toks(src: str, rules: TokenRule<Tok>[]) -> LexResult<Tok>!ParseError {
    src.lex(rules).map_err(|e| ParseError { message: e.message, span: e.span })
}

variant Node = NLeaf(str) | NNode(Node[])

# The lowering every fixture production uses: a node with no interior children
# is a leaf carrying its text, anything else a branch carrying its children.
fn build_node(src: str, node: Cst, kids: Node[]) -> Node!ParseError {
    if (kids.is_nonempty()) {
        return ok(NNode(kids));
    };
    ok(NLeaf(node.text(src)))
}

# A `build` that always refuses, for the error-propagation assertion.
fn refuse(src: str, node: Cst, kids: Node[]) -> Node!ParseError {
    err(ParseError { message: "refused", span: node.span() })
}

fn one(name: str, rule: Rule<Tok>) -> Production<Tok, Node> {
    name,
    rule,
    build: Mk(build_node),
    layout: Inline,
}

fn labelled_prod(name: str, rule: Rule<Tok>, expect_as: str) -> Production<Tok, Node> {
    name,
    rule,
    build: Mk(build_node),
    expect_as,
    layout: Inline,
}

fn g_of(ps: Production<Tok, Node>[]) -> Grammar<Tok, Node> { prods: ps }

# Parse and render, so an assertion is one readable string rather than a nested
# `CTree` literal.
fn shown(src: str, g: Grammar<Tok, Node>, start: str) -> str!ParseError {
    let lexed = lex_toks(src, tok_rules())?;
    let tree = parse_cst(src, lexed, g, start)?;
    ok(tree.show(src, prod_names(g)))
}

# The message a failed parse reports — and a distinguishable string when it
# unexpectedly succeeded, so a broken assertion says which way it broke.
fn msg_of(src: str, g: Grammar<Tok, Node>, start: str) -> str {
    shown(src, g, start).failure_message()
}

fn parsed(src: str, g: Grammar<Tok, Node>, start: str) -> Node!ParseError {
    let lexed = lex_toks(src, tok_rules())?;
    parse(src, lexed, g, start)
}

# The same as `shown`, against an *analysed* grammar — so the assertions can be
# made twice and compared. This is the path that prunes.
fn shown_prepared(src: str, g: Grammar<Tok, Node>, start: str) -> str!ParseError {
    let lexed = lex_toks(src, tok_rules())?;
    let tree = parse_prepared(src, lexed, prepare(g)?, start)?;
    ok(tree.show(src, prod_names(g)))
}

fn msg_of_prepared(src: str, g: Grammar<Tok, Node>, start: str) -> str {
    shown_prepared(src, g, start).failure_message()
}
