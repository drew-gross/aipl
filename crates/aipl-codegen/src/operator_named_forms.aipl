import { equal as == } from builtins;

# The named builtins that provide the operator `self` — the names it is
# imported under (`wrapping_add as +`) — in the order the compiler declares
# them, or `[]` for a spelling that is not an operator. Where an operator has
# more than one semantics every flavor is listed, and the first is the one a
# diagnostic suggests first.
#
# Mirrors `OPERATOR_BUILTINS` in `aipl-syntax`, which is where the compiler
# itself reads the pairing from; the two tables are kept in the same order so a
# diff between them reads line for line. `is_operator_name` is this table's
# question of whether the answer is empty, so the AIPL side states the pairing
# once.
pub fn operator_named_forms(self: str) -> str[] {
    match (self) {
        "+" => ["wrapping_add", "saturating_add", "float_add"],
        "-" => ["wrapping_sub", "saturating_sub", "float_sub"],
        "*" => ["wrapping_mul", "float_mul"],
        "++" => ["wrapping_increment", "saturating_increment"],
        "--" => ["wrapping_decrement", "saturating_decrement"],
        "+=" => ["wrapping_add_assign", "saturating_add_assign"],
        "-=" => ["wrapping_sub_assign", "saturating_sub_assign"],
        "*=" => ["wrapping_mul_assign"],
        "/=" => ["saturating_divide_assign"],
        "==" => ["equal", "float_equal"],
        "!=" => ["not_equal", "float_not_equal"],
        "<" => ["less_than", "float_less_than"],
        ">" => ["greater_than", "float_greater_than"],
        "<=" => ["less_than_or_equal", "float_less_than_or_equal"],
        ">=" => ["greater_than_or_equal", "float_greater_than_or_equal"],
        "&&" => ["logical_and"],
        "||" => ["logical_or"],
        "!" => ["logical_not"],
        "/" => ["saturating_divide", "float_div"],
        "%" => ["saturating_remainder"],
        _ => [],
    }
}.test({
    // Two flavors, in the order the compiler declares them.
    assert("+".operator_named_forms() == ["wrapping_add", "saturating_add", "float_add"]);
    assert("+=".operator_named_forms() == ["wrapping_add_assign", "saturating_add_assign"]);
    assert("--".operator_named_forms() == ["wrapping_decrement", "saturating_decrement"]);
    // The float operations follow the integer ones, one name per operator.
    assert("==".operator_named_forms() == ["equal", "float_equal"]);
    assert("/".operator_named_forms() == ["saturating_divide", "float_div"]);
    assert("<=".operator_named_forms() == ["less_than_or_equal", "float_less_than_or_equal"]);
    // One flavor, still listed: every operator is imported the same way.
    assert("%".operator_named_forms() == ["saturating_remainder"]);
    assert("/=".operator_named_forms() == ["saturating_divide_assign"]);
    // Not an operator: nothing.
    let nothing: str[] = [];
    assert("wrapping_add".operator_named_forms() == nothing);
    assert("=".operator_named_forms() == nothing);
    assert("".operator_named_forms() == nothing);
})
