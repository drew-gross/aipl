# AIPL's own TextMate grammar, as data — the file
# `editors/vscode/syntaxes/aipl.tmLanguage.json` is generated from. This is the
# highlighter's counterpart of `lex_aipl.aipl`: `highlight.aipl` is the generic
# machinery, and this is just the table.
#
# Almost all of it comes straight from `aipl_rules()` — the same rule list the
# lexer runs on, whose `scope` fields say what each token is painted. What is
# left is what a *lexer* cannot know:
#
#   - `fn NAME` / `struct NAME`, where the name is scoped for its position, not
#     its spelling. The names they accept come from the identifier rule's own
#     character classes, so the two cannot disagree.
#   - The builtin type names, which lex as ordinary identifiers and are told
#     apart afterwards (`classify_lexed` in `aipl-parser`); this list is that
#     one, and the only genuinely duplicated data here.
#   - The `!prints` effect marker, which is one token to the lexer (`!`) and two
#     halves to a reader.
#   - The `--- section ---` tail of a test-case file, which is not AIPL at all:
#     everything after the first marker is expected output, and highlighting it
#     as source would be actively wrong.
#
# Regenerate the JSON with:
#
#     cargo test --test compiler -- --ignored highlighting::fill_tmlanguage
#
# `highlighting::checked_in_tmlanguage_is_current` fails when the checked-in
# file and this description disagree, and the rest of `tests/highlighting.rs`
# validates the *result* against every token of every case file and example —
# which is the real check on anything changed here.

import { contains, to_set, value_or } from builtins;
import {
    Caps,
    Entry,
    Expansion,
    Include,
    Match,
    Pat,
    Region,
    Tm,
    brace_group_entry,
    decl_pat,
    matcher_regex,
    re_escape,
    rule_pats,
    template_inner,
    tm_json,
    word_pat,
} from "./highlight.aipl";
import { IDENT_CONT, IDENT_START, S_PUNCT, S_STRING, aipl_rules } from "./lex_aipl.aipl";
import { CharRun } from "./lexer.aipl";

# One template literal as a region: the delimiter opens and closes it, and
# inside are its escapes and the `{ .. }` interpolation that includes the whole
# language back into itself. `template_inner` builds the inside — the one piece
# of this that is not AIPL-specific, so it stays in `highlight.aipl`.
fn template_pat(delim: str, escapes: #{char}) -> Pat {
    Region(
        re_escape(delim),
        re_escape(delim),
        template_inner(escapes, escape_scope(), S_PUNCT),
        scope=S_STRING,
    )
}

# AIPL's TextMate grammar as `.tmLanguage.json` text — what
# `editors/vscode/syntaxes/aipl.tmLanguage.json` holds. Derived from
# `aipl_rules()` plus the four patterns a lexer cannot describe; see the file
# header.
pub fn aipl_tmlanguage() -> str {
    let Expansion { pats, entries } = rule_pats(aipl_rules(), escape_scope());
    let ident = ident_regex();
    let main: Pat[] = [
        // These four come before the lexical patterns so that a tie at one
        // position goes to the more specific one: `fn` here rather than as a
        // bare keyword, `i64` here rather than as a bare identifier. A pattern
        // that starts *later* never loses to them — TextMate takes the earliest
        // match first — so a `fn` inside a comment or a string is still comment
        // or string.
        decl_pat("fn", ident, "keyword.declaration.function.aipl", "entity.name.function.aipl"),
        decl_pat(
            "struct",
            ident,
            "keyword.declaration.struct.aipl",
            "entity.name.type.struct.aipl",
        ),
        effect_pat(),
        word_pat(builtin_types(), "support.type.builtin.aipl"),
        // The template literals, written by hand. Their lexer rules carry no
        // scope (see `aipl_rules`): the lexer nests them with its mode stack and
        // a TextMate grammar nests with begin/end regions, so the two models do
        // not translate — the region has to be stated in the target's own terms.
        // Triple-backtick first, so a tie at the opening backtick goes to the
        // longer delimiter, exactly as the lexer's rule order does.
        template_pat("```", #{}),
        template_pat("`", """\`ntr""".to_set()),
        ..pats,
    ];
    tm_json(Tm {
        name: "AIPL",
        scope_name: "source.aipl",
        file_types: ["aipl"],
        top: [Include("section-tail"), Include("main")],
        note: """
            Generated from crates/aipl-codegen/src/highlight_aipl.aipl, which
            derives it from the lexer's own rule table. Do not edit by hand:
            regenerate with `cargo test --test compiler -- --ignored
            highlighting::fill_tmlanguage`.
        """,
        repo: [
            Entry { name: "main", pats: main },
            Entry { name: "section-tail", pats: [section_tail()] },
            brace_group_entry(S_PUNCT),
            ..entries,
        ],
    })
}.test({
    let json = aipl_tmlanguage();

    // The frame.
    assert(json.contains(`"scopeName": "source.aipl"`));
    assert(json.contains(`"fileTypes": ["aipl"]`));
    assert(json.contains("""{ "include": "#section-tail" }"""));

    // The keyword and constant runs, merged from their individual `kw` rules in
    // table order — every keyword AIPL has, in one alternation.
    assert(json.contains("""\\bfn\\b|\\blet\\b|\\bmut\\b"""));
    assert(json.contains("""\\btrue\\b|\\bfalse\\b|\\bnone\\b"""));

    // The operator run stays longest-first, which is what keeps the alternation
    // maximal munch: `+++` ahead of `++`, `==` ahead of `=`.
    assert(json.contains("""\\+\\+\\+|==|!="""));

    // The three string forms are regions, and the triple-quoted one is listed
    // before the single — the same ordering the lexer rules carry.
    let q = `"`;
    let esc_q = `\\"`;
    assert(json.contains(`{q}begin{q}: {q}{esc_q}{esc_q}{esc_q}{q}`));
    assert(json.contains(`"name": "string.quoted.double.aipl"`));
    assert(json.contains(`"name": "string.quoted.single.aipl"`));

    // A template interpolation includes the whole language back into itself.
    assert(json.contains("""{ "include": "#main" }"""));

    // The block comment is the one self-referential pattern, so the one that
    // needed a name.
    assert(json.contains(`"comment-block": \{`));

    // The contextual declarations, and the post-lexical type names.
    assert(json.contains(`"match": "\\\\b(fn)\\\\s+`));
    assert(json.contains(`"name": "entity.name.function.aipl"`));
    assert(json.contains("""\\bi64\\b"""));

    // ... and the section tail, which runs to end of file.
    assert(json.contains(`"contentName": "meta.section-content.aipl"`));
})

# What an escape sequence inside a string, char or template literal is painted.
# One scope for all of them, since a `\n` means the same thing wherever it is.
fn escape_scope() -> str { "constant.character.escape.aipl" }

# The identifier regex, built from the very classes the identifier *rule* is
# built from (`lex_aipl.aipl`), so `fn NAME` accepts exactly the names AIPL
# accepts. `matcher_regex` answers `none` only for the delimiter-scanning
# matchers, which a `CharRun` is not.
fn ident_regex() -> str { matcher_regex(CharRun(IDENT_CONT, first=IDENT_START)).value_or("") }

# The builtin type names. Lexically these are plain identifiers — the AIPL lexer
# emits `Name` for them and `classify_lexed` (`crates/aipl-parser/src/lib.rs`)
# is what separates them out — so there is no rule to derive this from, and this
# list has to stay in step with that one by hand.
fn builtin_types() -> str[] {
    ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "bool", "char", "str", "any"]
}

# An effect declaration — `!prints` in a signature. The effect names are spelled
# out rather than matched as any `!ident`, which would mis-scope the unary `!`
# in `!true` / `!ready`; they must stay in step with `KNOWN_EFFECTS`.
fn effect_pat() -> Pat {
    Caps("""(!)(prints)\b""", ["keyword.operator.effect.aipl", "entity.name.tag.effect.aipl"])
}

# A test-case file's `--- name ---` markers and everything after the first one.
# The tail is expected output, not AIPL, so it is scoped as plain content and
# only the markers themselves are painted — as comments, which is the closest
# thing a theme has to "not code". `\z` never matches inside the text, so the
# region runs to end of file.
fn section_tail() -> Pat {
    let marker = """^[ \t]*---[ \t]+\S.*?\S[ \t]+---[ \t]*\r?$""";
    Region(
        marker,
        """\z""",
        [Match(marker, "comment.line.section-marker.aipl")],
        begin_scope="comment.line.section-marker.aipl",
        content_scope="meta.section-content.aipl",
    )
}
