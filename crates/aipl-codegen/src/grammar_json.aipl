// JSON: the library's second end-to-end target, and the one that adds everything
// S-expressions deliberately left out — several terminal classes rather than one,
// a separated `Many` with a trailing-comma rule, an `OneOf` across six
// alternatives, and a heterogeneous AST. Still no precedence; that arrives with
// the calculator in `grammar_calc.aipl`.
//
// Complete but tiny: eight productions and one `variant Json`, against a rule set
// cribbed from `lexer.aipl`'s own JSON-flavored test table.
//
// Two things worth reading before the grammar:
//
//   - **Numbers stay text.** `Number` carries the source spelling rather than a
//     parsed value. JSON's number syntax is wider than any one AIPL type (an
//     arbitrary-precision integer is legal JSON), so *what a number means* is the
//     consumer's policy, exactly as it is for the lexer's `Int`/`Float`, which
//     hand over their digits unparsed for the same reason.
//   - **`Member` is where a uniform lowering type shows its seam.** `Build<A>`
//     pins one `A` for every production in a grammar, so the `member` production
//     — whose natural result is a key/value *pair*, not a JSON value — has to
//     lower to a `Json` too. It gets a case of its own, meaningful only as an
//     element of a `Object`. That is the honest cost of one lowering type per
//     grammar, and it is worth knowing before the grammar describes AIPL itself,
//     where the AST has many more shapes than its expression type.
import {
    equal as ==,
    first,
    join,
    len,
    map,
    map_err,
    map_ok,
    value_or_err,
    wrapping_sub as -,
} from builtins;
import { Cst, show, span, text, token_leaves } from "./cst.aipl";
import { ebnf, show_first_sets } from "./ebnf.aipl";
import { render_cst } from "./format.aipl";
import {
    Const,
    Grammar,
    Inline,
    Kids,
    Literal as Lit,
    Many,
    Maybe,
    Named,
    OneOf,
    ParseError,
    Production,
    Rule,
    Term,
    Text,
    Then,
    Tight,
    TryMk,
    failure_message,
    prod_names,
} from "./grammar.aipl";
import {
    Bare,
    CharRun,
    Delimited,
    Exact,
    Float,
    Int,
    Keyword,
    LexResult,
    Of,
    OneChar,
    TokenRule,
    lex,
} from "./lexer.aipl";
import { parse, parse_cst } from "./parse.aipl";
import { unescape } from "./unescape.aipl";

# The token kinds: three terminal classes that carry meaning, and one bare kind
# for the punctuation the grammar matches by `Lit`.
#
# `Str` keeps its delimiter-stripped contents (the lexer's `Delimited` computes
# them), but the concrete tree holds *spans*, not values — so lowering reads the
# quoted source text back out and strips it itself. The payload is what makes a
# string token tell itself apart from a number, which is all `Term` needs.
variant JsonTok = Str(str) | Num | Kw | Punct

# The AST. `Number` keeps the source spelling (see the header); `Member` is a
# key/value pair and is meaningful only inside a `Object`.
variant Json =
    | Null
    | Bool(bool)
    | Number(str)
    | String(str)
    | Array(Json[])
    | Object(Json[])
    | Member(str, Json)

# Whitespace is recorded as **trivia** rather than skipped, so the concrete tree
# covers every byte of the source and reconstructs it exactly. JSON has no
# comments, so trivia is whitespace and nothing else.
#
# Rule order carries two decisions. `Float` sits ahead of `Int` because a bare
# digit run doesn't match `Float` and `1.5` would otherwise lex as `1` then a
# stray `.`. And `Exact("-")` sits ahead of both, which makes every `-` its own
# token and `Int` unsigned — so the sign is the *grammar's* business
# (`Maybe(Lit("-"))` in `number`), one place, rather than split between a
# sign the lexer swallowed and one it didn't.
fn json_rules() -> TokenRule<JsonTok>[] {
    let alnum = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    [
        TokenRule { matcher: CharRun(" \t\r\n"), emit: Bare(Punct), trivia: true },
        TokenRule { matcher: Delimited(`"`, `"\\/bfnrtu`), emit: Of(Str) },
        TokenRule { matcher: Exact("-"), emit: Bare(Punct) },
        TokenRule { matcher: Float, emit: Bare(Num) },
        TokenRule { matcher: Int, emit: Bare(Num) },
        TokenRule { matcher: Keyword("true", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("false", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("null", alnum), emit: Bare(Kw) },
        TokenRule { matcher: OneChar("{}[]:,"), emit: Bare(Punct) },
    ]
}

// ---------- lowering ----------
//
// A production whose value *is* one of its constructors names the constructor
// (`Kids(Object)`); one that is a one-liner over its text is a lambda at the
// production, taking its parameter type from `Build`'s payload. Only a lowering
// with something to say — a child to unwrap, a key to read off a leaf — gets a
// name of its own.

# The single alternative that matched, unwrapped. Every branch of `value` is a
# rule *reference*, so exactly one interior child arrives.
fn lower_value(src: str, node: Cst, kids: Json[]) -> Json!ParseError {
    kids
        .first()
        .value_or_err(ParseError {
            message: "a JSON value matched no alternative",
            span: node.span(),
        })
}

# A member's value is its one interior child; its key is the string token in
# front of the `:`, which is a *leaf* and so has no lowered value — the node's
# first token leaf is where it is read from.
fn lower_member(src: str, node: Cst, kids: Json[]) -> Json!ParseError {
    let key = node
        .token_leaves()
        .first()
        .value_or_err(ParseError { message: "a member has no key", span: node.span() })?;
    let value = kids
        .first()
        .value_or_err(ParseError { message: "a member has no value", span: node.span() })?;
    ok(Member(unquote(src[key]).unescape(), value))
}

# `s` without its first and last byte — a string token's surrounding quotes. The
# lexer guarantees both are there (a `Delimited` match spans them), so this needs
# no check of its own.
fn unquote(s: str) -> str { s[1..s.len() - 1] }

# The JSON grammar, with `value` as the start rule.
#
# Only `value` carries an `expect_as`, so a failure anywhere inside reports as
# "a JSON value" rather than as the six alternatives it is made of — the
# collapse that keeps a PEG's error messages readable.
pub fn json_grammar() -> Grammar<JsonTok, Json> {
    let r_value: Rule<JsonTok> = OneOf([
        Named("object"),
        Named("array"),
        Named("string"),
        Named("number"),
        Named("bool"),
        Named("null"),
    ]);

    // `trailing: false` — strict JSON, where `[1, 2,]` is an error. Flipping the
    // flag is the whole difference between this and the dialects that allow it,
    // which is what that parameter exists to express. It is said twice: once to
    // the parser, which refuses the trailing comma, and once to the printer,
    // which never writes one.
    //
    // Braces read as words and take inner spaces while flat (`{ "a": 1 }`);
    // brackets hug (`[1, 2]`). That decision belongs to the bracket pair, so it
    // is written on the bracket pair.
    //
    // `sorted` is the same kind of statement: an object's members are printed
    // in key order. A member leads with its key, so the formatter's "leading
    // token" is exactly the key, and nothing beyond this one word is needed to
    // say so — no comparator, no walker, no second description of what an
    // object is. An array says nothing, because its order is its meaning.
    let r_object: Rule<JsonTok> = Many(
        Named("member"),
        sep=Lit(","),
        trailing_sep=false,
        nested_in=(Lit("{"), Lit("}")),
        spaced=true,
        sorted=true,
    );
    let r_member: Rule<JsonTok> = Then([Term(Str), Lit(":"), Named("value")]);
    let r_array: Rule<JsonTok> = Many(
        Named("value"),
        sep=Lit(","),
        trailing_sep=false,
        nested_in=(Lit("["), Lit("]")),
    );
    let r_string: Rule<JsonTok> = Term(Str);
    let r_number: Rule<JsonTok> = Then([Maybe(Lit("-")), Term(Num)]);
    let r_bool: Rule<JsonTok> = OneOf([Lit("true"), Lit("false")]);
    let r_null: Rule<JsonTok> = Lit("null");
    Grammar {
        prods: [
            Production {
                name: "value",
                rule: r_value,
                build: TryMk(lower_value),
                expect_as: "a JSON value",
                layout: Inline,
            },
            Production { name: "object", rule: r_object, build: Kids(Object), layout: Inline },
            Production {
                name: "member",
                rule: r_member,
                build: TryMk(lower_member),
                layout: Inline,
            },
            Production { name: "array", rule: r_array, build: Kids(Array), layout: Inline },
            Production {
                name: "string",
                rule: r_string,
                build: Text(|t| String(unquote(t).unescape())),
                layout: Inline,
            },
            // The spelling, sign included — `Text` hands over the matched tokens
            // run together with nothing between them, which is exactly right for
            // `-` followed by digits. And since a sign and its digits are written
            // together, the spacing rule is not consulted at all.
            Production { name: "number", rule: r_number, build: Text(Number), layout: Tight },
            Production {
                name: "bool",
                rule: r_bool,
                build: Text(|t| Bool(t == "true")),
                layout: Inline,
            },
            Production { name: "null", rule: r_null, build: Const(Null), layout: Inline },
        ],
    }
}.test({
    // The grammar as a reader would write it, derived from the same value the
    // driver parses with. A separated `Many` has no EBNF operator, so both lists render as
    // the separator longhand — and the strictness the flag encodes shows up as
    // the trailing `","?` that is *not* there.
    assert(
        ebnf(json_grammar()) == """
            value = object | array | string | number | bool | null ;
            object = "{" (member ("," member)*)? "}" ;
            member = Str ":" value ;
            array = "[" (value ("," value)*)? "]" ;
            string = Str ;
            number = "-"? Num ;
            bool = "true" | "false" ;
            null = "null" ;
        """,
    );

    // JSON is the grammar whose alternatives *are* disjoint by first token: no
    // two of `value`'s six share one, which is exactly the condition under which
    // a driver could pick a branch without trying any of the others.
    assert(
        show_first_sets(json_grammar())? == """
            value = Str Num "{" "[" "-" "true" "false" "null"
            object = "{"
            member = Str
            array = "["
            string = Str
            number = Num "-"
            bool = "true" "false"
            null = "null"
        """,
    );
})

fn lex_json(src: str) -> LexResult<JsonTok>!ParseError {
    src.lex(json_rules()).map_err(|e| ParseError { message: e.message, span: e.span })
}

# The lossless concrete tree for `src` — every byte of it under exactly one
# leaf, whitespace included. Use this when the tree is the point; `parse_json`
# when only the `Json` is.
pub fn json_cst(src: str) -> Cst!ParseError {
    parse_cst(src, lex_json(src)?, json_grammar(), "value")
}.test({
    // The tree the eight productions build. Every alternative of `value` is a
    // rule *reference*, so a value is always a `value` node wrapping the node
    // that matched — which is what gives `lower_value` its single child. The
    // `~ ` leaves are recorded whitespace, sitting in front of the token that
    // follows them.
    assert(
        shown("[1, true]")? == "(value (array [[ (value (number 1)) , (value (bool ~  true)) ]]))",
    );
    assert(
        shown(
            """{"a": null}""",
        )? == """(value (object [{ (member "a" : (value (null ~  null))) }]))""",
    );

    // The sign is part of the `number` node, as two leaves rather than one
    // token — which is why lowering reads the node's text and not a token's.
    assert(shown("-2.5")? == "(value (number - 2.5))");

    // Losslessness: every byte is under exactly one leaf, so the leaves
    // concatenate back to the source — including the run after the last token,
    // which no token consumption reaches and which attaches to the root.
    assert(shown(" 7 ")? == "(value (number ~  7) ~ )");
    let padded = """{ "a" : [ 1 , 2 ] }""";
    assert(json_cst(padded)?.text(padded) == padded);
})

# The `Json` `src` denotes: lex, parse to a concrete tree, lower it through
# the grammar's `build` functions.
#
# Numbers arrive as their source spelling (`Number("1e9")`), since JSON's
# number syntax is wider than any one AIPL type — parsing one is the
# consumer's policy.
pub fn parse_json(src: str) -> Json!ParseError {
    parse(src, lex_json(src)?, json_grammar(), "value")
}.test({
    // ---- the terminal classes, one at a time ----
    assert(parse_json("null")? == Null);
    assert(parse_json("true")? == Bool(true));
    assert(parse_json("false")? == Bool(false));
    assert(parse_json(`"hi"`)? == String("hi"));
    assert(parse_json("42")? == Number("42"));
    assert(parse_json("3.14")? == Number("3.14"));
    assert(parse_json("1e9")? == Number("1e9"));

    // The sign is the grammar's, not the lexer's, so it reads back attached.
    assert(parse_json("-7")? == Number("-7"));
    assert(parse_json("-2.5")? == Number("-2.5"));

    // Escapes are decoded on the way into the AST.
    assert(parse_json(`"a\\nb"`)? == String("a\nb"));
    assert(parse_json(`"q\\"q"`)? == String(`q"q`));

    // ---- arrays: a separated `Many`, and the empty case ----
    assert(parse_json("[]")? == Array([]));
    assert(parse_json("[1]")? == Array([Number("1")]));
    assert(parse_json("[1, true, null]")? == Array([Number("1"), Bool(true), Null]));
    // Nesting, which is what makes the CST and the parse recursive.
    assert(parse_json("[[1], []]")? == Array([Array([Number("1")]), Array([])]));

    // ---- objects ----
    assert(parse_json("{}")? == Object([]));
    assert(parse_json("""{"a": 1}""")? == Object([Member("a", Number("1"))]));
    assert(
        parse_json("""{"a": 1, "b": [2]}""")? == Object([
            Member("a", Number("1")),
            Member("b", Array([Number("2")])),
        ]),
    );
    // A key with an escape in it goes through the same decoding as a value.
    assert(parse_json("""{"a\tb": null}""")? == Object([Member("a\tb", Null)]));

    // ---- strict about trailing separators ----
    //
    // `trailing_sep=false` leaves the dangling comma unconsumed, so
    // the enclosing rule is what reports it.
    assert(msg_of("[1, 2,]") == "expected a JSON value, found `]`");
    assert(msg_of("""{"a": 1,}""") == "expected Str, found `}`");

    // ---- errors ----
    assert(msg_of("") == "expected a JSON value, found end of input");
    assert(
        msg_of("[1") == "expected `,` or `]`, found end of input (`[` at line 1 is never closed)",
    );
    assert(msg_of("{1: 2}") == "expected Str or `}`, found `1`");
    assert(msg_of("""{"a" 1}""") == "expected `:`, found `1`");
    // Every token must be consumed: two documents is not one.
    assert(msg_of("1 2") == "expected end of input, found `2`");
    // A lex failure reports in the same shape as a parse failure.
    assert(msg_of("@") == "unexpected character");
})

# `self` printed back as JSON source, in one canonical compact spelling: no
# spaces, no trailing separators, strings escaped.
#
# Round-trips with `parse_json` — `parse_json(render_json(v)) == v` for every
# `v` a parse produced — which is what makes the pair a usable end-to-end check
# of the library.
#
# A bare `Member` renders as the `"key":value` it is; it is only meaningful
# inside a `Object`, which is where a parse ever puts one.
pub fn render_json(self: Json) -> str {
    match (self) {
        Null => "null",
        Bool(b) => if (b) { "true" } else { "false" },
        Number(n) => n,
        String(s) => `"{escape_json(s)}"`,
        Array(xs) => `[{xs.map(render_json).join(sep=",")}]`,
        Object(ms) => `\{{ms.map(render_json).join(sep=",")}}`,
        Member(k, v) => `"{escape_json(k)}":{v.render_json()}`,
    }
}.test({
    // ---- round trip: parse -> lower -> render -> parse ----
    let src = """{"name":"ada","tags":["x","y"],"n":-1.5,"ok":true,"nil":null}""";
    let v = parse_json(src)?;
    // Rendering is canonical, and this source is already in that spelling.
    assert(v.render_json() == src);
    assert(parse_json(v.render_json())? == v);

    // ... and from a source `render_json` would never have written.
    let messy = """{ "a" : [ 1 , 2 ] , "b" : { } }""";
    let mv = parse_json(messy)?;
    assert(mv.render_json() == """{"a":[1,2],"b":{}}""");
    assert(parse_json(mv.render_json())? == mv);

    // Escapes survive the round trip: decoded into the AST, re-escaped on the
    // way out, decoded again by the second parse.
    let esc = parse_json("""{"a\"b": "c\nd"}""")?;
    assert(esc.render_json() == """{"a\"b":"c\nd"}""");
    assert(parse_json(esc.render_json())? == esc);

    assert(render_json(Array([])) == "[]");
    assert(render_json(Object([])) == "{}");
    assert(render_json(Member("k", Null)) == `"k":null`);
})

# The inverse of the `unescape` lowering applies: the two characters JSON
# *requires* escaping, plus the control characters that have short forms. Enough
# for the round trip, and for anything this library will parse back.
fn escape_json(s: str) -> str {
    s
        .map(
            |c| match (c) {
                '"' => `\\"`,
                '\\' => """\\""",
                '\n' => """\n""",
                '\t' => """\t""",
                '\r' => """\r""",
                // A `char` interpolates as the bare character.
                _ => `{c}`,
            },
        )
        .join()
}.test({
    assert(escape_json("plain") == "plain");
    assert(escape_json(`a"b`) == """a\"b""");
    assert(escape_json("a\nb") == """a\nb""");
    assert(escape_json("""a\b""") == """a\\b""");
    assert(escape_json("") == "");
})

// ---------- test-only helpers ----------

# The message a failed parse reports — and a distinguishable string when it
# unexpectedly succeeded, so a broken assertion says which way it broke.
fn msg_of(src: str) -> str { parse_json(src).map_ok(render_json).failure_message() }

# The concrete tree, rendered against the production names — the debug view a
# tree assertion reads better as than a nested `Tree` literal.
fn shown(src: str) -> str!ParseError { ok(json_cst(src)?.show(src, prod_names(json_grammar()))) }

# `src` reformatted: parse it to the concrete tree, then lay that out at `width`.
#
# The whole of JSON's layout is the eight annotations on the grammar above plus
# `json_space` below. There is no second walker over JSON's syntax, and adding a
# ninth production would need no more than a ninth annotation — which is the
# claim this stage exists to make good on. Key order is part of that claim: the
# members of every object come out sorted, and the only place that is said is
# `sorted=true` on the object's `Many`.
pub fn format_json(src: str, width: u64) -> str!ParseError {
    render_cst(json_grammar(), src, json_cst(src)?, json_space, width)
}.test({
    // Canonical spacing, whatever the source had.
    assert(format_json("""{"a":1,"b":[1,2]}""", 80)? == """{ "a": 1, "b": [1, 2] }""");
    assert(format_json("[  ]", 80)? == "[]");
    assert(format_json("{}", 80)? == "{}");
    assert(format_json("  -12  ", 80)? == "-12");
    assert(format_json("[true,null]", 80)? == "[true, null]");

    // Members come out in key order, flat or broken — and at every depth, since
    // every object is the same group. Arrays keep their order: it is meaning.
    assert(format_json("""{"b":1,"a":2}""", 80)? == """{ "a": 2, "b": 1 }""");
    assert(format_json("""{"b":1,"a":2}""", 12)? == `\{\n    "a": 2,\n    "b": 1\n\}\n`);
    assert(
        format_json(
            """{"z":{"y":1,"x":2},"a":[2,1]}""",
            80,
        )? == """{ "a": [2, 1], "z": { "x": 2, "y": 1 } }""",
    );

    // Keys sort by their spelling — `"ab"` after `"a"`, as a prefix sorts before
    // the longer key extending it — and a duplicate key keeps its source order,
    // the sort being stable.
    assert(format_json("""{"ab":1,"a":2}""", 80)? == """{ "a": 2, "ab": 1 }""");
    assert(format_json("""{"k":1,"k":2}""", 80)? == """{ "k": 1, "k": 2 }""");

    // Too wide: one member per indented line, and no trailing comma — strict
    // JSON has none to add.
    assert(format_json("""{"a":1,"b":2}""", 12)? == `\{\n    "a": 1,\n    "b": 2\n\}\n`);
    assert(format_json("[1,2,3]", 5)? == "[\n    1,\n    2,\n    3\n]\n");
    // Only what does not fit breaks; the inner array still fits its line.
    assert(format_json("""{"xs":[1,2],"y":3}""", 18)? == `\{\n    "xs": [1, 2],\n    "y": 3\n\}\n`);

    // ---- the two properties a formatter has to have ----
    //
    // Formatting reorders members, so what it preserves is the object up to
    // key order: the parse of the output is the parse of the source with its
    // members sorted.
    let messy = `  \{"b" : [ 1,2 ] , "a":null \}  `;
    let tidy = """{"a":null,"b":[1,2]}""";
    assert(parse_json(format_json(messy, 80)?)? == parse_json(tidy)?);
    let once = format_json(messy, 80)?;
    assert(format_json(once, 80)? == once);
    let narrow = format_json(messy, 12)?;
    assert(format_json(narrow, 12)? == narrow);
})

# JSON's whole spacing rule: a space after the `:` of a member, and nowhere
# else. Everything else that looks like spacing — between members, inside
# braces — is a list breaking or not breaking, which the layouts decide.
fn json_space(l: str, r: str) -> bool { l == ":" }
