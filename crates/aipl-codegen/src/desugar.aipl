# Lowering the destructuring forms, after the lints have read them.
#
# `let T { x, y } = v;`, `let (a, b) = v;`, `let Case(a) = v;`, the same in a
# `for` header, and a pattern in a parameter are kept as written when a file is
# parsed (`LetPattern`, `ForPattern`, `Param::pattern`). The lints that run next
# see what the author wrote, not the temporaries the lowering would bind, so
# none of them has to recognise a name the compiler made. This is the pass that
# does the binding: each form becomes the `let`s and one-arm `match`es that bind
# its names off a temporary, and nothing past it knows the surface form existed.
#
# Spans and the temporaries' names come from the value or iterable the pattern
# takes apart, as they always have, so the tree this produces is the one the
# parser used to produce directly.

import {
    Span,
    as_case,
    contains,
    equal as ==,
    extend,
    first,
    greater_than as >,
    is_empty,
    len,
    logical_and as &&,
    logical_not as !,
    map,
    not_equal as !=,
    push,
    range,
    right_fold,
    value_or,
    wrapping_add as +,
    wrapping_decrement as --,
} from builtins;
import { Unresolved } from "./builtin_table.aipl";
import {
    Alias,
    Binding,
    ByCase,
    ByPattern,
    ByStruct,
    ByTuple,
    Call,
    Construct,
    Expr,
    ExprKind,
    Field,
    FieldInit,
    FieldProjection,
    For,
    ForPattern,
    Ident,
    IfLet,
    Interpolation,
    Lambda,
    LambdaParam,
    Let,
    LetMut,
    LetPattern,
    Match,
    MatchArm,
    MethodProjection,
    Name,
    ProviderShim,
    Range,
    Seq,
    Shim,
    WrittenName,
    WrittenNames,
    WrittenStruct,
    binder_span,
    expr,
    ident,
    join_spans,
    mapped,
    name_at,
    named_at,
    show_expr,
    struct_written,
} from "./expr.aipl";
import {
    CaseParam,
    Const,
    ConstDecl,
    FieldDecl,
    Function,
    Item,
    LoweredFn,
    Param,
    Program,
    Signature,
    Struct,
    StructDecl,
    SuperProgram,
    Variant,
    VariantCase,
    VariantDecl,
} from "./item.aipl";
import {
    Array,
    ArrayNested,
    ArrayRest,
    Ctor,
    Ctor as PatCtor,
    ElementKind,
    Int,
    Nested,
    Pat,
    PatElement,
