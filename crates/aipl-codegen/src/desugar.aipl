    pat_bindings,
} from "./pat.aipl";
import { Named as TyNamed } from "./ty.aipl";

# `self` with every destructuring form lowered, in every expression it holds.
pub fn desugar(self: Program) -> Program {
    SuperProgram { items: self.items$desugared_item(), doc: self.doc }
}

fn desugared_item(self: Item) -> Item {
    match (self) {
        LoweredFn(f) => LoweredFn(f.desugared_function()),
        Struct(s) => Struct(StructDecl {
            ..s,
            fields: s.fields.map(|f| FieldDecl { ..f, default: f.default$desugared() }),
        }),
        Variant(v) => Variant(VariantDecl { ..v, cases: v.cases$desugared_case() }),
        Const(c) => Const(ConstDecl { ..c, value: c.value.desugared() }),
        _ => self,
    }
}

fn desugared_case(self: VariantCase) -> VariantCase {
    ..self,
    payload: self.payload.map(|slot| CaseParam { ..slot, default: slot.default$desugared() }),
}

# A function whose destructured parameters are bound off their synthetic
# scrutinees at the top of the body — the shape `let Point { x, y } = v;` has,
# less the `let`, the value being bound already by being an argument. Folded from
# the right so the bindings come out in source order.
fn desugared_function(self: Function) -> Function {
    let plain = self.sig.params.map(|p| Param {
        ..p,
        default: p.default$desugared(),
        binding: Name(p.binding.name_at(p.name_span)),
    });
    Function {
        ..self,
        sig: Signature { ..self.sig, params: plain },
        body: self.sig.params.right_fold(self.body.desugared(), bind_one_param),
    }
}

# `self` and every expression under it, the destructuring forms lowered.
pub fn desugared(self: Expr) -> CoreExpr {
    let kind = self.kind;
    let written = self.written.value_or(WrittenNames {});
    match (kind) {
        LetPattern(binding, value, body) => let_pattern(
            binding,
            value.desugared(),
            body.desugared(),
            written,
        ),
        ForPattern(binding, iterable, body, index) => for_pattern(
            binding,
            iterable.desugared(),
            body.desugared(),
            index,
            written,
        ),
        ProviderShim(provider, args, body) => random_shim(
            provider,
            args$desugared(),
            body.desugared(),
            self.span,
        ),
        Range(start, end) => {
            let span = self.span;
            let bounds: CoreFieldInit[] = [
                FieldInit { name: "start", value: start.desugared() },
                FieldInit { name: "end", value: end.desugared() },
            ];
            core_at(Construct("__builtin_Span", bounds), span)
        },
        Interpolation(value) => {
            let rendered = value.desugared();
            core_at(Call("__template_interp", [rendered], false, Unresolved), rendered.span)
        },
        FieldProjection(receiver, name) => receiver
            .desugared()
            .projected(self, |element: CoreExpr| core_at(Field(element, name), self.span)),
        MethodProjection(receiver, name, args) => {
            let lowered = args$desugared();
            receiver
                .desugared()
                .projected(
                    self,
                    |element: CoreExpr| core_at(
                        Call(name, [element, ..lowered], true, Unresolved),
                        self.span,
                    ),
                )
        },
        _ => core_with_kind(self, mapped(kind, desugared)).with_binders_lowered(),
    }
}.test({
    // A range is the `Span` construct.
    assert(
        expr(Range(ident("a"), ident("b")))
            .desugared()
            .show_expr() == "Construct(__builtin_Span, [start: a, end: b])",
    );

    // An interpolation is the `__template_interp` call.
    assert(expr(Interpolation(ident("x"))).desugared().show_expr() == "__template_interp(x)");

    // A projection is a `map` over a lambda whose element is named for where the projection is.
    assert(
        expr(FieldProjection(ident("p"), "x"))
            .desugared()
            .show_expr() == "p.__builtin_map(Lambda([__map$0_0], __map$0_0.x))",
    );
    assert(
        expr(MethodProjection(ident("p"), "f", [ident("a")]))
            .desugared()
            .show_expr() == "p.__builtin_map(Lambda([__map$0_0], __map$0_0.f(a)))",
    );

    // The element sits where the step's name is written, so an error about it points at the name.
    let named = expr(FieldProjection(ident("p"), "x")).named_at(5..6);
    let Call(_, arguments, _, _) = named.desugared().kind.as_case::<Call>()?;
    let Lambda(_, step, _) = arguments[1]?.kind.as_case::<Lambda>()?;
    assert(step.name_span == 5..6);
    let Field(element, _) = step.kind.as_case::<Field>()?;
    assert(element.span == 5..6);

    // A tuple pattern binds a slot at a time, off a temporary named for the value.
    let tuple = expr(LetPattern(ByTuple(["a", "b"]), ident("v"), ident("a")));
    assert(
        tuple
            .desugared()
            .show_expr() == "Let(__tpat$0, v, Let(a, __tpat$0._0, Let(b, __tpat$0._1, a)))",
    );

    // A struct pattern annotates the temporary with the struct, which is what
    // checks the pattern names the right one; `as` reads one field into another name.
    let record = expr(LetPattern(
        ByStruct("P", ["x", "y"], ["x", "b"], false),
        ident("v"),
        ident("b"),
    ));
    assert(
        record
            .desugared()
            .show_expr() == "Let(__spat$0: P, v, Let(x, __spat$0.x, Let(b, __spat$0.y, b)))",
    );
    let mutable = expr(LetPattern(ByStruct("P", ["x"], ["x"], true), ident("v"), ident("x")));
    assert(mutable.desugared().show_expr() == "Let(__spat$0: P, v, Mut(x, __spat$0.x, x))");

    // A case pattern reads each name with a `match` of its own.
    let arm = expr(LetPattern(ByCase("Pair", ["a", "b"]), ident("v"), ident("a")));
    assert(
        arm
            .desugared()
            .show_expr() == "Let(__cpat$0, v, Let(a, Match(__cpat$0, [Pair(a, _) => a]), Let(b, Match(__cpat$0, [Pair(_, b) => b]), a)))",
    );

    // A loop over a pattern is a loop over a temporary with the reads in front of
    // the body; an index rides along.
    let looped = expr(ForPattern(ByTuple(["a", "b"]), ident("xs"), ident("a"), index=some("i")));
    assert(
        looped
            .desugared()
            .show_expr() == "For([i], __fpat$0, xs, Let(a, __fpat$0._0, Let(b, __fpat$0._1, a)))",
    );

    // A plain name is a binding that takes nothing apart: the `let` or loop itself.
    assert(
        expr(LetPattern(Name("a"), ident("v"), ident("a")))
            .desugared()
            .show_expr() == "Let(a, v, a)",
    );
    assert(
        expr(ForPattern(Name("a"), ident("xs"), ident("a"), index=some("i")))
            .desugared()
            .show_expr() == "For([i], a, xs, a)",
    );

    // An alias is the value bound to its name, with the inner binding read off that name.
    assert(
        expr(LetPattern(Alias("p", ByStruct("P", ["x"], ["x"], false)), ident("v"), ident("x")))
            .desugared()
            .show_expr() == "Let(p: P, v, Let(x, p.x, x))",
    );
    assert(
        expr(ForPattern(Alias("p", ByCase("W", ["c"])), ident("xs"), ident("c")))
            .desugared()
            .show_expr() == "For(p, xs, Let(c, Match(p, [W(c) => c]), c))",
    );

    // A struct pattern inside another pattern becomes a binder, and the arm's body
    // reads the fields off it.
    let inside = MatchArm {
        pattern: ArrayNested([Pat.Struct("P", ["x"], ["x"])]),
        body: ident("x"),
        span: 4..9,
    };
    assert(
        expr(IfLet(inside, ident("v"), ident("z")))
            .desugared()
            .show_expr() == "IfLet([__npat$4_0] => Let(__spat$4_0: P, __npat$4_0, Let(x, __spat$4_0.x, x)), v, z)",
    );

    // The forms are lowered wherever they sit.
    let nested = expr(Seq(tuple, ident("z")));
    assert(nested.desugared().show_expr().contains("__tpat$0"));
    assert(!nested.desugared().show_expr().contains("LetPattern"));
    assert(ident("x").desugared() == ident("x"));
})

# `self`, a node whose children are already lowered, with the binders its patterns write
# lowered too: the struct patterns inside an arm's pattern become binders the arm's body
# reads the fields off, and a lambda's destructured parameters are bound off the parameter
# itself, in front of its body, as a function's are.
fn with_binders_lowered(self: CoreExpr) -> CoreExpr {
    let kind = self.kind;
    match (kind) {
        Match(scrutinee, arms) => core_with_kind(self, Match(scrutinee, arms$lifted_arm())),
        IfLet(arm, scrutinee, otherwise) => core_with_kind(
            self,
            IfLet(arm.lifted_arm(), scrutinee, otherwise),
        ),
        Lambda(params, body, captures) => core_with_kind(
            self,
            Lambda(
                params.map(|p: LambdaParam| LambdaParam {
                    ..p,
                    binding: Name(p.binding.name_at(p.span)),
                }),
                params.right_fold(
                    body,
                    |p: LambdaParam, result: CoreExpr| bind_param_pattern(
                        p.binding.name_at(p.span),
                        p.binding,
                        p.span,
                        result,
                        p.written.value_or(WrittenNames {}),
                    ),
                ),
                captures=captures,
            ),
        ),
        _ => self,
    }
}

# `base` with another kind: its spans and source stay.
fn core_with_kind(
    Expr { span, value_span, name_span, source, written },
    kind: CoreKind,
) -> CoreExpr { Expr { kind, span, value_span, name_span, source, written } }

# The shim a `random` provider stands for: `random_u64` is the runtime's generator, and
# the seeding runs before the body. `seeded_with_int(n)` seeds with `n`,
# `seeded_with_clock()` from the clock, and `seeded_with_provider(p)` from a value that
# holds the seed to start from, `none` for the clock.
fn random_shim(provider: str, args: CoreExpr[], body: CoreExpr, head: Span) -> CoreExpr {
    let clock = core_at(Call("__random_seed_from_clock", [], false, Unresolved), head);
    let seeding = match (provider) {
        "seeded_with_int" => core_at(Call("__random_seed", args, false, Unresolved), head),
        "seeded_with_provider" => match (args.first()) {
            some(value) => core_at(
                IfLet(
                    MatchArm {
                        pattern: PatCtor("some", bindings=["seed$provider"]),
                        body: core_at(
                            Call(
                                "__random_seed",
                                [core_at(Ident("seed$provider"), head)],
                                false,
                                Unresolved,
                            ),
                            head,
                        ),
                        span: head,
                        written: none,
                    },
                    core_at(Field(value, "seed"), head),
                    clock,
                ),
                head,
            ),
            // Not `map`: what a closure builds is not held to the clean type here.
            none => clock, #[allow]
        },
        _ => clock,
    };
    core_at(
        Shim("random", [("random_u64", "__random_next")], core_at(Seq(seeding, body), body.span)),
        head,
    )
}

# A struct pattern nested in another pattern — `[Point { x, y }]` — always
# matches, so it takes no more than a name does. The arm binds a temporary where
# the struct pattern stood, and its body starts by reading the fields off it, the
# way `let Point { x, y } = temporary;` would. Temporaries are named for where the
# arm's pattern starts and the struct pattern's place in it.
fn lifted_arm(self: CoreMatchArm) -> CoreMatchArm {
    let written = self.written.value_or(WrittenNames {});
    let Lifted { pattern, structs } = self.pattern.lifted(self.span.start, 0, written);
    let span = self.span;
    let body = structs.right_fold(
        self.body,
        |found: Found, rest: CoreExpr| {
            let Found { binder, struct_name, fields, names, temporary, spelled } = found.bound_only();
            destructure_struct(
                struct_name,
                fields,
                names,
                core_at(Ident(binder), span),
                span,
                rest,
                false,
                temporary,
                spelled,
            )
        },
    );
    MatchArm { ..self, pattern, body }
}

# `self` with the fields bound to `_` dropped: they are not read.
fn bound_only(self: Found) -> Found {
    mut fields: str[] = [];
    mut names: str[] = [];
    mut field_places: WrittenName[] = [];
    mut binder_places: WrittenName[] = [];
    for (let i, name : self.names) {
        if (name != "_") {
            set fields.push(self.fields[i].value_or(""));
            set names.push(name);
            set field_places.push(self.spelled.fields[i].value_or(NOWHERE));
            set binder_places.push(self.spelled.binders[i].value_or(NOWHERE));
        };
    }
    Found {
        ..self,
        fields,
        names,
        spelled: WrittenStruct { fields: field_places, binders: binder_places },
    }
}

# A name that is written nowhere.
let NOWHERE: WrittenName = WrittenName { text: "", span: 0..0 };

# A struct pattern taken out of a pattern: the binder that stands in for it, what
# it destructures, and the name of the temporary its fields are read off.
struct Found {
    binder: str,
    struct_name: str,
    fields: str[],
    names: str[],
    temporary: str,
    spelled: WrittenStruct,
}

# A pattern with its struct patterns replaced, and what they were, in order.
struct Lifted { pattern: Pat, structs: Found[] }

# The same for a list of patterns.
struct LiftedAll { patterns: Pat[], structs: Found[] }

# `self` with each struct pattern in it replaced by a binder named for `tag` and
# its place, counting from `taken` — the number already lifted from the patterns
# before this one in the arm.
fn lifted(self: Pat, tag: u64, taken: u64, written: WrittenNames) -> Lifted {
    match (self) {
        Struct(struct_name, fields, names) => Lifted {
            pattern: PatCtor(`__npat${tag}_{taken}`),
            structs: [
                Found {
                    binder: `__npat${tag}_{taken}`,
                    struct_name,
                    fields,
                    names,
                    temporary: `__spat${tag}_{taken}`,
                    spelled: written.struct_written(taken),
                },
            ],
        },
        Nested(name, args) => {
            let LiftedAll { patterns, structs } = args.lifted_all(tag, taken, written);
            Lifted { pattern: nested_or_ctor(name, patterns), structs }
        },
        Tuple(elements) => {
            let LiftedAll { patterns, structs } = elements.lifted_all(tag, taken, written);
            Lifted { pattern: Tuple(patterns), structs }
        },
        ArrayNested(elements) => {
            let LiftedAll { patterns, structs } = elements.lifted_all(tag, taken, written);
            Lifted { pattern: ArrayNested(patterns), structs }
        },
        Ctor(..) | Str(..) | Char(..) | Array(..) | ArrayRest(..) | Wildcard | Int(..) => Lifted {
            pattern: self,
            structs: [],
        },
    }
}

fn lifted_all(self: Pat[], tag: u64, taken: u64, written: WrittenNames) -> LiftedAll {
    mut patterns: Pat[] = [];
    mut structs: Found[] = [];
    for (let p : self) {
        let Lifted { pattern, structs as found } = p.lifted(tag, taken + structs.len(), written);
        set patterns.push(pattern);
        set structs.extend(found);
    }
    LiftedAll { patterns, structs }
}

# The tree every pass after this one is handed: an expression with none of the surface forms
# `desugared` lowers anywhere in it.
variant CoreExpr = Expr without (
    LetPattern,
    ForPattern,
    ProviderShim,
    FieldProjection,
    MethodProjection,
    Interpolation,
    Range,
) throughout

variant CoreKind = ExprKind without (
    LetPattern,
    ForPattern,
    ProviderShim,
    FieldProjection,
    MethodProjection,
    Interpolation,
    Range,
) throughout

variant CoreFieldInit = FieldInit without (
    LetPattern,
    ForPattern,
    ProviderShim,
    FieldProjection,
    MethodProjection,
    Interpolation,
    Range,
) throughout

variant CoreMatchArm = MatchArm without (
    LetPattern,
    ForPattern,
    ProviderShim,
    FieldProjection,
    MethodProjection,
    Interpolation,
    Range,
) throughout

# What `receiver$step` means: `receiver.map(|e| step)`, where `step` is the projection written
# against the element `e`, which sits where the step's name is written so an error about it points
# at the name. The element's name has a `$` in it, so no source can spell it and an argument of
# the step can never mean it by accident; it carries the projection's span, so no two projections
# of a function name their element alike.
fn projected(self: CoreExpr, Expr { span, name_span }, step: (CoreExpr) -> CoreExpr) -> CoreExpr {
    let name = `__map${span.start}_{span.end}`;
    let element = LambdaParam { binding: Name(name), ty: none, span };
    let body = step(core_at(Ident(name), name_span)).core_named_at(name_span);
    core_at(
        Call("__builtin_map", [self, core_at(Lambda([element], body), span)], true, Unresolved),
        span,
    )
}

# `at`, for a kind that holds no surface form, so what it builds holds none either.
fn core_at(kind: CoreKind, span: Span) -> CoreExpr {
    Expr { kind, span, value_span: 0..0, name_span: 0..0, source: "" }
}

# `named_at`, for an expression that holds no surface form.
fn core_named_at(self: CoreExpr, name_span: Span) -> CoreExpr {
    Expr {
        kind: self.kind,
        span: self.span,
        value_span: self.value_span,
        name_span,
        source: self.source,
        written: self.written,
    }
}

# `let <pattern> = value; body`. The temporary is named for where the value
# starts, and holds the value so it is evaluated once.
fn let_pattern(
    binding: Binding,
    value: CoreExpr,
    body: CoreExpr,
    written: WrittenNames,
) -> CoreExpr {
    let span = value.span;
    match (binding) {
        Name(name) => core_at(Let(name, none, value, body), join_spans(span, body.span)),
        ByTuple(names) => {
            let tmp = `__tpat${span.start}`;
            let inner = bind_fields(names, tmp, span, body, tuple_slot_names(names), written);
            core_at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
        ByCase(case_name, names) => {
            let tmp = `__cpat${span.start}`;
            let inner = bind_arm(case_name, names, tmp, span, body, written);
            core_at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
        ByStruct(struct_name, fields, names, mutable) => destructure_struct(
            struct_name,
            fields,
            names,
            value,
            span,
            body,
            mutable,
            `__spat${span.start}`,
            written.struct_written(0),
        ),
        ByPattern(pattern) => {
            let tmp = `__cpat${span.start}`;
            let inner = bind_pattern(pattern, tmp, span, body, written);
            core_at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
        // The value is the name, and the inner binding reads its parts off it. A struct
        // annotates the name itself, which is what holds the value to the struct written.
        Alias(name, inner) => match (inner) {
            ByStruct(struct_name, fields, names, mutable) => destructure_struct(
                struct_name,
                fields,
                names,
                value,
                span,
                body,
                mutable,
                name,
                written.struct_written(0),
            ),
            _ => {
                let rest = bind_off(inner, name, span, body, written);
                core_at(Let(name, none, value, rest), join_spans(span, rest.span))
            },
        },
    }
}

# `for (let <pattern> : iterable) { body }` is a plain loop over a temporary
# whose fields (or slots, or payload) are read in front of the body, as the same
# pattern in a `let` reads them — through the same helpers, so the pattern's type
# is checked the same way. With an `index` it is the indexed loop over that
# temporary: the counter and the pattern compose as each does alone.
fn for_pattern(
    binding: Binding,
    iterable: CoreExpr,
    body: CoreExpr,
    index: str?,
    written: WrittenNames,
) -> CoreExpr {
    let span = iterable.span;
    // A plain name is the loop variable itself, and so is an alias's.
    if (let Name(name) = binding) {
        return core_at(For(name, iterable, body, index=index), join_spans(span, body.span));
    };
    if (let Alias(name, inner) = binding) {
        let rest = bind_off(inner, name, span, body, written);
        return core_at(For(name, iterable, rest, index=index), join_spans(span, rest.span));
    };
    let tmp = `__fpat${span.start}`;
    let inner = bind_off(binding, tmp, span, body, written);
    core_at(For(tmp, iterable, inner, index=index), join_spans(span, inner.span))
}

# The names `binding` binds, read off the variable `tmp` in front of `body`. A
# struct is read through a binding annotated with its type, which is what checks the
# pattern names the right one.
fn bind_off(
    binding: Binding,
    tmp: str,
    span: Span,
    body: CoreExpr,
    written: WrittenNames,
) -> CoreExpr {
    match (binding) {
        Name(..) => body,
        ByTuple(names) => bind_fields(names, tmp, span, body, tuple_slot_names(names), written),
        ByCase(case_name, names) => bind_arm(case_name, names, tmp, span, body, written),
        ByStruct(struct_name, fields, names, mutable) => destructure_struct(
            struct_name,
            fields,
            names,
            core_at(Ident(tmp), span),
            span,
            body,
            mutable,
            `__spat${span.start}`,
            written.struct_written(0),
        ),
        ByPattern(pattern) => bind_pattern(pattern, tmp, span, body, written),
        Alias(name, inner) => {
            let rest = bind_off(inner, name, span, body, written);
            core_at(Let(name, none, core_at(Ident(tmp), span), rest), join_spans(span, rest.span))
        },
    }
}

# The field names a tuple pattern reads: `_0`, `_1`, ... one per binder, which is
# how the AST spells a tuple's slots.
fn tuple_slot_names(names: str[]) -> str[] { names.range().map(|i| `_{i}`) }

# `let a = <tmp>.<field0>; let b = <tmp>.<field1>; rest`, innermost last — the
# body of both destructuring forms, which differ only in the field names they
# read and in whether the bindings are mutable.
fn bind_fields(
    names: str[],
    tmp: str,
    span: Span,
    rest: CoreExpr,
    fields: str[],
    written: WrittenNames,
) -> CoreExpr {
    let spelled = WrittenStruct {
        fields: [],
        binders: names.map(|name| WrittenName { text: name, span: written.binder_span(name) }),
    };
    bind_fields_mut(names, tmp, span, rest, fields, false, spelled)
}

fn bind_fields_mut(
    names: str[],
    tmp: str,
    span: Span,
    rest: CoreExpr,
    fields: str[],
    mutable: bool,
    spelled: WrittenStruct,
) -> CoreExpr {
    mut result = rest;
    mut i = names.len();
    while (i > 0) {
        set i--;
        let field_at = spelled.fields[i]$span.value_or(0..0);
        let binder_at = spelled.binders[i]$span.value_or(0..0);
        let field = core_at(
            Field(core_at(Ident(tmp), span), fields[i].value_or("")),
            span,
        ).core_named_at(field_at);
        let inner_span = join_spans(span, result.span);
        let name = names[i].value_or("");
        set result = if (mutable) {
            core_at(LetMut(name, none, field, result), inner_span).core_named_at(binder_at)
        } else {
            core_at(Let(name, none, field, result), inner_span).core_named_at(binder_at)
        };
    }
    result
}

# `let a = match (<tmp>) { Case(a, _) => a }; let b = match (<tmp>) { Case(_, b) => b };
# rest`, innermost last — what `let Case(a, b) = value; rest` binds, one `match`
# per name. The scrutinee is a value that can only be `Case`, which is what makes
# each `match` exhaustive with the one arm; any other value is refused by that
# check. A `match` for each name, rather than one around the rest of the block,
# keeps `rest` out of an arm: a block that is an expression may not assign to a
# binding from outside it.
fn bind_arm(
    case_name: str,
    names: str[],
    tmp: str,
    span: Span,
    rest: CoreExpr,
    written: WrittenNames,
) -> CoreExpr { bind_pattern(PatCtor(case_name, bindings=names), tmp, span, rest, written) }

# The same for any pattern: a `match` of `pattern` per name it binds, with the
# other names left unbound. Struct patterns inside it become binders and reads in
# front of the arm's body, as in any other arm.
fn bind_pattern(
    pattern: Pat,
    tmp: str,
    span: Span,
    rest: CoreExpr,
    written: WrittenNames,
) -> CoreExpr {
    let names = pattern.pat_bindings();
    mut result = rest;
    mut i = names.len();
    while (i > 0) {
        set i--;
        let name = names[i].value_or("");
        let arm = MatchArm {
            pattern: pattern.keeping(name),
            body: core_at(Ident(name), span),
            span,
            written: some(written),
        }.lifted_arm();
        let read = core_at(Match(core_at(Ident(tmp), span), [arm]), span);
        set result = core_at(
            Let(name, none, read, result),
            join_spans(span, result.span),
        ).core_named_at(written.binder_span(name));
    }
    result
}

# `self` with every name but `name` left unbound: `_` where a binder stood.
fn keeping(self: Pat, name: str) -> Pat {
    match (self) {
        Ctor(case_name, bindings, ignore) => {
            if (bindings.is_empty() && !ignore) {
                // A bare name is a binder or a case, which the spelling tells apart.
                return if (case_name.is_binder_name() && case_name != name) {
                    Wildcard
                } else {
                    self
                };
            };
            Ctor(
                case_name,
                bindings=bindings.map(|b| if (b == name) { b } else { "_" }),
                ignore_payload=ignore,
            )
        },
        Nested(case_name, args) => Nested(case_name, args$keeping(name)),
        Tuple(elements) => Tuple(elements$keeping(name)),
        ArrayNested(elements) => ArrayNested(elements$keeping(name)),
        // A struct pattern with nothing left to bind reads no field, so it matches
        // anything, as `_` does: the arm that keeps one of its names checks its type.
        Struct(struct_name, fields, names) => {
            if (!names.contains(name)) { return Wildcard; };
            Pat.Struct(struct_name, fields, names.map(|n| if (n == name) { n } else { "_" }))
        },
        Array(elements) => Array(elements$keeping_ident(name)),
        ArrayRest(elements) => ArrayRest(elements$keeping_ident(name)),
        Str(..) | Char(..) | Wildcard | Int(..) => self,
    }
}

# An array pattern's element, `_` unless it is the binder `name`.
fn keeping_ident(self: PatElement, name: str) -> PatElement {
    if (let Binder(bound) = self.kind) {
        if (bound != name) {
            return PatElement { kind: ElementKind.Binder("_"), span: self.span };
        };
    };
    self
}

# `let T { a, b } = value; rest` and its `mut` twin, as nested bindings. The
# scrutinee stays an immutable `let` either way — it is read once per field and
# never written through — and carries the pattern's type as its annotation,
# which is what makes the type name mean something rather than decorate the
# line. The `__spat$` prefix is `aipl_syntax::DESTRUCTURE_BASE_PREFIX`, which is
# how the checker knows to report a mismatch as the destructuring it was.
fn destructure_struct(
    struct_name: str,
    fields: str[],
    names: str[],
    value: CoreExpr,
    span: Span,
    acc: CoreExpr,
    mutable: bool,
    tmp: str,
    spelled: WrittenStruct,
) -> CoreExpr {
    let inner = bind_fields_mut(names, tmp, span, acc, fields, mutable, spelled);
    let outer_span = join_spans(span, inner.span);
    core_at(Let(tmp, some(TyNamed(struct_name)), value, inner), outer_span)
}

# A destructured parameter's bindings in front of `body`: the case's payload, or
# the struct's fields, read off the parameter itself. Folded from the right by the
# caller so they come out in source order.
fn bind_one_param(Param { binding, name_span, written }, body: CoreExpr) -> CoreExpr {
    let name = binding.name_at(name_span);
    bind_param_pattern(name, binding, name_span, body, written.value_or(WrittenNames {}))
}

# The bindings `pattern` makes, read off the parameter called `parameter`, in front of
# `body`. The parameter's own type is what the checker holds the pattern to.
fn bind_param_pattern(
    parameter: str,
    pattern: Binding,
    span: Span,
    body: CoreExpr,
    written: WrittenNames,
) -> CoreExpr {
    match (pattern) {
        Name(..) => body,
        ByCase(case_name, names) => bind_arm(case_name, names, parameter, span, body, written),
        ByStruct(_, fields, names, _) => bind_fields_mut(
            names,
            parameter,
            span,
            body,
            fields,
            false,
            written.struct_written(0),
        ),
        ByPattern(pattern) => bind_pattern(pattern, parameter, span, body, written),
        ByTuple(names) => bind_fields(
            names,
            parameter,
            span,
            body,
            tuple_slot_names(names),
            written,
        ),
        // The parameter is the name when it was written with one.
        Alias(name, inner) => if (name == parameter) {
            bind_param_pattern(parameter, inner, span, body, written)
        } else {
            let rest = bind_param_pattern(name, inner, span, body, written);
            core_at(
                Let(name, none, core_at(Ident(parameter), span), rest),
                join_spans(span, rest.span),
            )
        },
    }
}
