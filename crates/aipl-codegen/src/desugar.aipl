} from "./pat.aipl";
import { Named as TyNamed } from "./ty.aipl";

# `self` with every destructuring form lowered, in every expression it holds.
pub fn desugar(self: Program) -> Program { ..self, items: self.items$desugared_item() }

fn desugared_item(self: Item) -> Item {
    match (self) {
        Fn(f) => Fn(f.desugared_function()),
        Struct(s) => Struct(StructDecl {
            ..s,
            fields: s.fields.map(|f| FieldDecl { ..f, default: f.default$desugared() }),
        }),
        Variant(v) => Variant(VariantDecl { ..v, cases: v.cases$desugared_case() }),
        Const(c) => Const(ConstDecl { ..c, value: c.value.desugared() }),
        _ => self,
    }
}

fn desugared_case(self: VariantCase) -> VariantCase {
    ..self,
    payload: self.payload.map(|slot| CaseParam { ..slot, default: slot.default$desugared() }),
}

# A function whose destructured parameters are bound off their synthetic
# scrutinees at the top of the body — the shape `let Point { x, y } = v;` has,
# less the `let`, the value being bound already by being an argument. Folded from
# the right so the bindings come out in source order.
fn desugared_function(self: Function) -> Function {
    let plain = self.sig.params.map(|p| Param {
        ..p,
        default: p.default$desugared(),
        pattern: none,
    });
    Function {
        ..self,
        sig: Signature { ..self.sig, params: plain },
        body: self.sig.params.right_fold(self.body.desugared(), bind_one_param),
        test_body: self.test_body$desugared(),
    }
}

# `self` and every expression under it, the destructuring forms lowered.
pub fn desugared(self: Expr) -> Expr {
    let inner = self.with_struct_patterns_lifted().map_subexprs(desugared);
    match (inner.kind) {
        LetPattern(pattern, value, body) => let_pattern(
            pattern,
            value,
            body,
            inner.written.value_or(WrittenNames {}),
        ),
        ForPattern(pattern, iterable, body, index) => for_pattern(
            pattern,
            iterable,
            body,
            index,
            inner.written.value_or(WrittenNames {}),
        ),
        // A lambda's destructured parameters are bound off the parameter itself, in
        // front of its body, as a function's are.
        Lambda(params, body) => Expr {
            ..inner,
            kind: Lambda(
                params.map(|p| LambdaParam { ..p, pattern: none }),
                params.right_fold(
                    body,
                    |p: LambdaParam, result: Expr| p.pattern
                        .map(|pattern| bind_param_pattern(
                            p.name,
                            pattern,
                            p.span,
                            result,
                            p.written.value_or(WrittenNames {}),
                        ))
                        .value_or(result),
                ),
            ),
        },
        _ => inner,
    }
}.test({
    // A tuple pattern binds a slot at a time, off a temporary named for the value.
    let tuple = expr(LetPattern(ByTuple(["a", "b"]), ident("v"), ident("a")));
    assert(
        tuple
            .desugared()
            .show_expr() == "Let(__tpat$0, v, Let(a, __tpat$0._0, Let(b, __tpat$0._1, a)))",
    );

    // A struct pattern annotates the temporary with the struct, which is what
    // checks the pattern names the right one; `as` reads one field into another name.
    let record = expr(LetPattern(
        ByStruct("P", ["x", "y"], ["x", "b"], false),
        ident("v"),
        ident("b"),
    ));
    assert(
        record
            .desugared()
            .show_expr() == "Let(__spat$0: P, v, Let(x, __spat$0.x, Let(b, __spat$0.y, b)))",
    );
    let mutable = expr(LetPattern(ByStruct("P", ["x"], ["x"], true), ident("v"), ident("x")));
    assert(mutable.desugared().show_expr() == "Let(__spat$0: P, v, Mut(x, __spat$0.x, x))");

    // A case pattern reads each name with a `match` of its own.
    let arm = expr(LetPattern(ByCase("Pair", ["a", "b"]), ident("v"), ident("a")));
    assert(
        arm
            .desugared()
            .show_expr() == "Let(__cpat$0, v, Let(a, Match(__cpat$0, [Pair(a, _) => a]), Let(b, Match(__cpat$0, [Pair(_, b) => b]), a)))",
    );

    // A loop over a pattern is a loop over a temporary with the reads in front of
    // the body; an index rides along.
    let looped = expr(ForPattern(ByTuple(["a", "b"]), ident("xs"), ident("a"), index=some("i")));
    assert(
        looped
            .desugared()
            .show_expr() == "For([i], __fpat$0, xs, Let(a, __fpat$0._0, Let(b, __fpat$0._1, a)))",
    );

    // A struct pattern inside another pattern becomes a binder, and the arm's body
    // reads the fields off it.
    let inside = MatchArm {
        pattern: ArrayNested([Pat.Struct("P", ["x"], ["x"])]),
        body: ident("x"),
        span: 4..9,
    };
    assert(
        expr(IfLet(inside, ident("v"), ident("z")))
            .desugared()
            .show_expr() == "IfLet([__npat$4_0] => Let(__spat$4_0: P, __npat$4_0, Let(x, __spat$4_0.x, x)), v, z)",
    );

    // The forms are lowered wherever they sit.
    let nested = expr(Seq(tuple, ident("z")));
    assert(nested.desugared().show_expr().contains("__tpat$0"));
    assert(!nested.desugared().show_expr().contains("LetPattern"));
    assert(ident("x").desugared() == ident("x"));
})

# `self` with the struct patterns inside its arms' patterns replaced by binders
# the arm's body reads the fields off.
fn with_struct_patterns_lifted(self: Expr) -> Expr {
    let kind = match (self.kind) {
        Match(scrutinee, arms) => Match(scrutinee, arms$lifted_arm()),
        IfLet(arm, scrutinee, otherwise) => IfLet(arm.lifted_arm(), scrutinee, otherwise),
        _ => self.kind,
    };
    Expr { ..self, kind }
}

# A struct pattern nested in another pattern — `[Point { x, y }]` — always
# matches, so it takes no more than a name does. The arm binds a temporary where
# the struct pattern stood, and its body starts by reading the fields off it, the
# way `let Point { x, y } = temporary;` would. Temporaries are named for where the
# arm's pattern starts and the struct pattern's place in it.
fn lifted_arm(self: MatchArm) -> MatchArm {
    let written = self.written.value_or(WrittenNames {});
    let Lifted { pattern, structs } = self.pattern.lifted(self.span.start, 0, written);
    let span = self.span;
    let body = structs.right_fold(
        self.body,
        |found: Found, rest: Expr| {
            let Found { binder, struct_name, fields, names, temporary, spelled } = found.bound_only();
            destructure_struct(
                struct_name,
                fields,
                names,
                at(Ident(binder), span),
                span,
                rest,
                false,
                temporary,
                spelled,
            )
        },
    );
    MatchArm { ..self, pattern, body }
}

# `self` with the fields bound to `_` dropped: they are not read.
fn bound_only(self: Found) -> Found {
    mut fields: str[] = [];
    mut names: str[] = [];
    mut field_places: WrittenName[] = [];
    mut binder_places: WrittenName[] = [];
    for (let i, name : self.names) {
        if (name != "_") {
            set fields.push(self.fields[i].value_or(""));
            set names.push(name);
            set field_places.push(self.spelled.fields[i].value_or(NOWHERE));
            set binder_places.push(self.spelled.binders[i].value_or(NOWHERE));
        };
    }
    Found {
        ..self,
        fields,
        names,
        spelled: WrittenStruct { fields: field_places, binders: binder_places },
    }
}

# A name that is written nowhere.
let NOWHERE: WrittenName = WrittenName { text: "", span: 0..0 };

# A struct pattern taken out of a pattern: the binder that stands in for it, what
# it destructures, and the name of the temporary its fields are read off.
struct Found {
    binder: str,
    struct_name: str,
    fields: str[],
    names: str[],
    temporary: str,
    spelled: WrittenStruct,
}

# A pattern with its struct patterns replaced, and what they were, in order.
struct Lifted { pattern: Pat, structs: Found[] }

# The same for a list of patterns.
struct LiftedAll { patterns: Pat[], structs: Found[] }

# `self` with each struct pattern in it replaced by a binder named for `tag` and
# its place, counting from `taken` — the number already lifted from the patterns
# before this one in the arm.
fn lifted(self: Pat, tag: u64, taken: u64, written: WrittenNames) -> Lifted {
    match (self) {
        Struct(struct_name, fields, names) => Lifted {
            pattern: PatCtor(`__npat${tag}_{taken}`),
            structs: [
                Found {
                    binder: `__npat${tag}_{taken}`,
                    struct_name,
                    fields,
                    names,
                    temporary: `__spat${tag}_{taken}`,
                    spelled: written.struct_written(taken),
                },
            ],
        },
        Nested(name, args) => {
            let LiftedAll { patterns, structs } = args.lifted_all(tag, taken, written);
            Lifted { pattern: nested_or_ctor(name, patterns), structs }
        },
        Tuple(elements) => {
            let LiftedAll { patterns, structs } = elements.lifted_all(tag, taken, written);
            Lifted { pattern: Tuple(patterns), structs }
        },
        ArrayNested(elements) => {
            let LiftedAll { patterns, structs } = elements.lifted_all(tag, taken, written);
            Lifted { pattern: ArrayNested(patterns), structs }
        },
        Ctor(..) | Str(..) | Char(..) | Array(..) | ArrayRest(..) | Wildcard | Int(..) => Lifted {
            pattern: self,
            structs: [],
        },
    }
}

fn lifted_all(self: Pat[], tag: u64, taken: u64, written: WrittenNames) -> LiftedAll {
    mut patterns: Pat[] = [];
    mut structs: Found[] = [];
    for (let p : self) {
        let Lifted { pattern, structs as found } = p.lifted(tag, taken + structs.len(), written);
        set patterns.push(pattern);
        set structs.extend(found);
    }
    LiftedAll { patterns, structs }
}

# `let <pattern> = value; body`. The temporary is named for where the value
# starts, and holds the value so it is evaluated once.
fn let_pattern(pattern: Destructure, value: Expr, body: Expr, written: WrittenNames) -> Expr {
    let span = value.span;
    match (pattern) {
        ByTuple(names) => {
            let tmp = `__tpat${span.start}`;
            let inner = bind_fields(names, tmp, span, body, tuple_slot_names(names), written);
            at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
        ByCase(case_name, names) => {
            let tmp = `__cpat${span.start}`;
            let inner = bind_arm(case_name, names, tmp, span, body, written);
            at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
        ByStruct(struct_name, fields, names, mutable) => destructure_struct(
            struct_name,
            fields,
            names,
            value,
            span,
            body,
            mutable,
            `__spat${span.start}`,
            written.struct_written(0),
        ),
        ByPattern(pattern) => {
            let tmp = `__cpat${span.start}`;
            let inner = bind_pattern(pattern, tmp, span, body, written);
            at(Let(tmp, none, value, inner), join_spans(span, inner.span))
        },
    }
}

# `for (let <pattern> : iterable) { body }` is a plain loop over a temporary
# whose fields (or slots, or payload) are read in front of the body, as the same
# pattern in a `let` reads them — through the same helpers, so the pattern's type
# is checked the same way. With an `index` it is the indexed loop over that
# temporary: the counter and the pattern compose as each does alone.
fn for_pattern(
    pattern: Destructure,
    iterable: Expr,
    body: Expr,
    index: str?,
    written: WrittenNames,
) -> Expr {
    let span = iterable.span;
    let tmp = `__fpat${span.start}`;
    let inner = match (pattern) {
        ByTuple(names) => bind_fields(names, tmp, span, body, tuple_slot_names(names), written),
        ByCase(case_name, names) => bind_arm(case_name, names, tmp, span, body, written),
        ByStruct(struct_name, fields, names, mutable) => destructure_struct(
            struct_name,
            fields,
            names,
            at(Ident(tmp), span),
            span,
            body,
            mutable,
            `__spat${span.start}`,
            written.struct_written(0),
        ),
        ByPattern(pattern) => bind_pattern(pattern, tmp, span, body, written),
    };
    at(For(tmp, iterable, inner, index=index), join_spans(span, inner.span))
}

# The field names a tuple pattern reads: `_0`, `_1`, ... one per binder, which is
# how the AST spells a tuple's slots.
fn tuple_slot_names(names: str[]) -> str[] { names.range().map(|i| `_{i}`) }

# `let a = <tmp>.<field0>; let b = <tmp>.<field1>; rest`, innermost last — the
# body of both destructuring forms, which differ only in the field names they
# read and in whether the bindings are mutable.
fn bind_fields(
    names: str[],
    tmp: str,
    span: Span,
    rest: Expr,
    fields: str[],
    written: WrittenNames,
) -> Expr {
    let spelled = WrittenStruct {
        fields: [],
        binders: names.map(|name| WrittenName { text: name, span: written.binder_span(name) }),
    };
    bind_fields_mut(names, tmp, span, rest, fields, false, spelled)
}

fn bind_fields_mut(
    names: str[],
    tmp: str,
    span: Span,
    rest: Expr,
    fields: str[],
    mutable: bool,
    spelled: WrittenStruct,
) -> Expr {
    mut result = rest;
    mut i = names.len();
    while (i > 0) {
        set i--;
        let field_at = spelled.fields[i]$span.value_or(0..0);
        let binder_at = spelled.binders[i]$span.value_or(0..0);
        let field = at(Field(at(Ident(tmp), span), fields[i].value_or("")), span).named_at(
            field_at,
        );
        let inner_span = join_spans(span, result.span);
        let name = names[i].value_or("");
        set result = if (mutable) {
            at(LetMut(name, none, field, result), inner_span).named_at(binder_at)
        } else {
            at(Let(name, none, field, result), inner_span).named_at(binder_at)
        };
    }
    result
}

# `let a = match (<tmp>) { Case(a, _) => a }; let b = match (<tmp>) { Case(_, b) => b };
# rest`, innermost last — what `let Case(a, b) = value; rest` binds, one `match`
# per name. The scrutinee is a value that can only be `Case`, which is what makes
# each `match` exhaustive with the one arm; any other value is refused by that
# check. A `match` for each name, rather than one around the rest of the block,
# keeps `rest` out of an arm: a block that is an expression may not assign to a
# binding from outside it.
fn bind_arm(
    case_name: str,
    names: str[],
    tmp: str,
    span: Span,
    rest: Expr,
    written: WrittenNames,
) -> Expr { bind_pattern(PatCtor(case_name, bindings=names), tmp, span, rest, written) }

# The same for any pattern: a `match` of `pattern` per name it binds, with the
# other names left unbound. Struct patterns inside it become binders and reads in
# front of the arm's body, as in any other arm.
fn bind_pattern(pattern: Pat, tmp: str, span: Span, rest: Expr, written: WrittenNames) -> Expr {
    let names = pattern.pat_bindings();
    mut result = rest;
    mut i = names.len();
    while (i > 0) {
        set i--;
        let name = names[i].value_or("");
        let arm = MatchArm {
            pattern: pattern.keeping(name),
            body: at(Ident(name), span),
            span,
            written: some(written),
        }.lifted_arm();
        let read = at(Match(at(Ident(tmp), span), [arm]), span);
        set result = at(
            Let(name, none, read, result),
            join_spans(span, result.span),
        ).named_at(written.binder_span(name));
    }
    result
}

# `self` with every name but `name` left unbound: `_` where a binder stood.
fn keeping(self: Pat, name: str) -> Pat {
    match (self) {
        Ctor(case_name, bindings, ignore) => {
            if (bindings.is_empty() && !ignore) {
                // A bare name is a binder or a case, which the spelling tells apart.
                return if (case_name.is_binder_name() && case_name != name) {
                    Wildcard
                } else {
                    self
                };
            };
            Ctor(
                case_name,
                bindings=bindings.map(|b| if (b == name) { b } else { "_" }),
                ignore_payload=ignore,
            )
        },
        Nested(case_name, args) => Nested(case_name, args$keeping(name)),
        Tuple(elements) => Tuple(elements$keeping(name)),
        ArrayNested(elements) => ArrayNested(elements$keeping(name)),
        // A struct pattern with nothing left to bind reads no field, so it matches
        // anything, as `_` does: the arm that keeps one of its names checks its type.
        Struct(struct_name, fields, names) => {
            if (!names.contains(name)) {
                return Wildcard;
            };
            Pat.Struct(struct_name, fields, names.map(|n| if (n == name) { n } else { "_" }))
        },
        Array(elements) => Array(elements$keeping_ident(name)),
        ArrayRest(elements) => ArrayRest(elements$keeping_ident(name)),
        Str(..) | Char(..) | Wildcard | Int(..) => self,
    }
}

# An array pattern's element, `_` unless it is the binder `name`.
fn keeping_ident(self: Expr, name: str) -> Expr {
    if (let Ident(bound) = self.kind) {
        if (bound != name) {
            return at(Ident("_"), self.span);
        };
    };
    self
}

# `let T { a, b } = value; rest` and its `mut` twin, as nested bindings. The
# scrutinee stays an immutable `let` either way — it is read once per field and
# never written through — and carries the pattern's type as its annotation,
# which is what makes the type name mean something rather than decorate the
# line. The `__spat$` prefix is `aipl_syntax::DESTRUCTURE_BASE_PREFIX`, which is
# how the checker knows to report a mismatch as the destructuring it was.
fn destructure_struct(
    struct_name: str,
    fields: str[],
    names: str[],
    value: Expr,
    span: Span,
    acc: Expr,
    mutable: bool,
    tmp: str,
    spelled: WrittenStruct,
) -> Expr {
    let inner = bind_fields_mut(names, tmp, span, acc, fields, mutable, spelled);
    let outer_span = join_spans(span, inner.span);
    at(Let(tmp, some(TyNamed(struct_name)), value, inner), outer_span)
}

# A destructured parameter's bindings in front of `body`: the case's payload, or
# the struct's fields, read off the parameter itself. Folded from the right by the
# caller so they come out in source order.
fn bind_one_param(p: Param, body: Expr) -> Expr {
    let ParamPattern { pattern, span, written } = p.pattern.value_or(ParamPattern {
        pattern: ByTuple([]),
        span: 0..0,
    });
    bind_param_pattern(p.name, pattern, span, body, written.value_or(WrittenNames {}))
}

# The bindings `pattern` makes, read off the parameter called `parameter`, in front of
# `body`. The parameter's own type is what the checker holds the pattern to.
fn bind_param_pattern(
    parameter: str,
    pattern: Destructure,
    span: Span,
    body: Expr,
    written: WrittenNames,
) -> Expr {
    match (pattern) {
        ByCase(case_name, names) => bind_arm(case_name, names, parameter, span, body, written),
        ByStruct(_, fields, names, _) => bind_fields_mut(
            names,
            parameter,
            span,
            body,
            fields,
            false,
            written.struct_written(0),
        ),
        ByPattern(pattern) => bind_pattern(pattern, parameter, span, body, written),
        ByTuple(names) => bind_fields(
            names,
            parameter,
            span,
            body,
            tuple_slot_names(names),
            written,
        ),
    }
}
