// AIPL's string-escape decoder.
import {
    concat as +++,
    equal as ==,
    extend,
    less_than_or_equal as <=,
    logical_and as &&,
    tuple_windows,
    wrapping_add as +,
} from builtins;

# Map a `\X` escape's X to its meaning: `n`/`t`/`r` to the control chars, and
# any other escaped char (`"`, `\`, `` ` ``, `{`) to itself. Validity was
# already enforced by the matcher's scan (its `escapes` set), so an unknown `\X`
# never reaches here. `self` is the char following the backslash.
pub fn escape_text(self: char) -> str {
    match (self) {
        'n' => "\n",
        't' => "\t",
        'r' => "\r",
        _ => `{self}`,
    }
}.test({
    // The three control-char escapes.
    assert(escape_text('n') == "\n");
    assert(escape_text('t') == "\t");
    assert(escape_text('r') == "\r");
    // Every other escaped char decodes to itself.
    assert(escape_text('\\') == "\\");
    assert(escape_text('"') == "\"");
    assert(escape_text('{') == "{");
    assert(escape_text('`') == "`");
})

# Decode every `\X` escape in `self`, copying everything else verbatim. Each
# char is read with the one after it, so a backslash flushes the plain run before
# it and decodes its X in the same step; the next run starts past both. The X is
# then the *first* half of the following pair, which is what `run_start <= i`
# rules out — an escaped backslash is one char, not the start of another escape.
# Copying runs by slicing (rather than char-by-char) keeps the common no-escape
# case a single copy. A trailing lone backslash can't occur — the matcher already
# rejected such a token as unterminated — and would be copied verbatim if it did,
# since the last char is never the first of a pair.
pub fn unescape(self: str) -> str {
    mut out = "";
    mut run_start: u64 = 0;
    for (let i, w : self.tuple_windows()) {
        let (c, next) = w;
        if (c == '\\' && run_start <= i) {
            set out.extend(self[run_start..i]);
            set out.extend(next.escape_text());
            set run_start = i + 2;
        };
    }
    out +++ self[run_start..]
}.test({
    // No escapes: the input is returned verbatim (the common case, one copy).
    assert(unescape("") == "");
    assert(unescape("hello world") == "hello world");

    // The control-char escapes decode (the AIPL source writes each as a literal
    // backslash-`n`/`t`/`r`; the result carries the actual control char).
    assert(unescape("\\n") == "\n");
    assert(unescape("\\t") == "\t");
    assert(unescape("\\r") == "\r");
    // An escaped backslash / quote / brace / backtick decodes to the bare char.
    assert(unescape("\\\\") == "\\");
    assert(unescape("\\\"") == "\"");
    assert(unescape("\\{") == "{");
    // Runs before, between, and after escapes are all preserved.
    assert(unescape("a\\nb") == "a\nb");
    assert(unescape("pre\\npost") == "pre\npost");
    assert(unescape("x\\ny\\tz") == "x\ny\tz");
    // Adjacent escapes with no plain runs between them.
    assert(unescape("\\n\\t\\r") == "\n\t\r");

    // An escaped backslash is one char: the one after it is plain, not another
    // escape's X.
    assert(unescape("\\\\n") == "\\n");

    // A lone trailing backslash (which the matcher never lets through) is copied
    // verbatim rather than decoded.
    assert(unescape("a\\") == "a\\");
    assert(unescape("\\") == "\\");
})
