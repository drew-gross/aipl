// The formatter's string re-delimiter. A `"..."` literal and an
// interpolation-free `` `...` `` literal denote the same value and differ only in
// which characters they must escape — `"` under the first, `` ` ``/`{`/`}` under
// the second — so `aipl fmt` spells each literal with whichever delimiter needs
// fewer escapes. A `"""`/```` ``` ```` block whose value has no newline is a
// single-line literal spread over three lines, so it is respelled as one too,
// with the same choice of delimiter. `walker.aipl` applies it to every string
// token.
import {
    contains,
    count_if,
    equal as ==,
    extend,
    first,
    len,
    less_than as <,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
    starts_with,
    value_or,
    wrapping_increment as ++,
    wrapping_sub as -,
} from builtins;
import { str_lit_value } from "./lex_aipl.aipl";

# Whether `self` must be written escaped inside a single-line literal delimited
# by `delim`: the delimiter itself, plus `{`/`}` under a backtick, where a bare
# brace would open an interpolation. Every other escape (`\n`, `\t`, `\r`, `\\`)
# is spelled the same under both delimiters.
fn needs_escape(self: char, delim: char) -> bool {
    self == delim || (delim == '`' && (self == '{' || self == '}'))
}.test({
    assert('"'.needs_escape('"'));
    assert(!'`'.needs_escape('"'));
    assert(!'{'.needs_escape('"'));
    assert('`'.needs_escape('`'));
    assert('{'.needs_escape('`'));
    assert('}'.needs_escape('`'));
    assert(!'"'.needs_escape('`'));
    assert(!'a'.needs_escape('"'));
    assert(!'\\'.needs_escape('`'));
})

# Whether `\X` with `self` as X is an escape both delimiters share — so a swap
# copies it as-is rather than deciding it afresh for the new delimiter.
fn is_shared_escape(self: char) -> bool {
    self == 'n' || self == 't' || self == 'r' || self == '\\'
}.test({
    assert('n'.is_shared_escape());
    assert('t'.is_shared_escape());
    assert('r'.is_shared_escape());
    assert('\\'.is_shared_escape());
    assert(!'"'.is_shared_escape());
    assert(!'`'.is_shared_escape());
    assert(!'{'.is_shared_escape());
})

# How many escapes `body` — the source text between a literal's delimiters,
# escapes undecoded — would need under `delim`. A `\X` pair counts as the one
# char X, so `\"` costs one under `"` and nothing under a backtick, exactly as a
# bare `"` does.
fn escape_cost(body: str, delim: char) -> u64 {
    mut cost: u64 = 0;
    mut escaped = false;
    for (let c : body) {
        if (escaped) {
            set escaped = false;
            if (c.needs_escape(delim)) {
                set cost++;
            };
        } else if (c == '\\') {
            set escaped = true;
        } else if (c.needs_escape(delim)) {
            set cost++;
        };
    }
    cost
}.test({
    assert(escape_cost("", '"') == 0);
    assert(escape_cost("plain", '"') == 0);
    assert(escape_cost("plain", '`') == 0);
    // Escaped and bare occurrences cost the same: what matters is the value.
    assert(escape_cost(`say \\"hi\\"`, '"') == 2);
    assert(escape_cost(`say "hi"`, '"') == 2);
    assert(escape_cost(`say \\"hi\\"`, '`') == 0);
    // Braces and backticks cost under a backtick only.
    assert(escape_cost("\\{a\\} `b`", '`') == 4);
    assert(escape_cost("\\{a\\} `b`", '"') == 0);
    // The shared escapes cost nothing under either.
    assert(escape_cost("a\\nb\\\\c\\t", '"') == 0);
    assert(escape_cost("a\\nb\\\\c\\t", '`') == 0);
    // An escaped backslash's X is not the start of another escape.
    assert(escape_cost(`\\\\"`, '"') == 1);
    // Both kinds present: each delimiter pays for its own.
    assert(escape_cost("\\\"{", '"') == 1);
    assert(escape_cost("\\\"{", '`') == 1);
})

# `body` respelled for `delim`: an escape the old delimiter needed and this one
# doesn't is dropped (`\"` → `"` under a backtick), a bare char this one needs
# escaped gains its backslash (`{` → `\{`), and everything else — the shared
# escapes, plain text — copies verbatim. Respelling for the delimiter `body`
# already has is the identity.
fn redelimit(body: str, delim: char) -> str {
    mut out = "";
    mut escaped = false;
    for (let c : body) {
        if (escaped) {
            set escaped = false;
            if (c.is_shared_escape() || c.needs_escape(delim)) {
                set out.extend(`\\{c}`);
            } else {
                set out.extend(`{c}`);
            };
        } else if (c == '\\') {
            set escaped = true;
        } else if (c.needs_escape(delim)) {
            set out.extend(`\\{c}`);
        } else {
            set out.extend(`{c}`);
        };
    }
    out
}.test({
    assert(redelimit("", '`') == "");
    assert(redelimit("plain", '`') == "plain");
    // `"` → backtick: quotes shed their backslashes.
    assert(redelimit(`say \\"hi\\"`, '`') == `say "hi"`);
    // backtick → `"`: braces and backticks shed theirs.
    assert(redelimit("\\{a\\} \\`b\\`", '"') == "{a} `b`");
    // The reverse directions gain them.
    assert(redelimit("{a} `b`", '`') == "\\{a\\} \\`b\\`");
    assert(redelimit(`say "hi"`, '"') == `say \\"hi\\"`);

    // Shared escapes copy verbatim under either delimiter — and an escaped
    // backslash is one char, so the quote after it is a bare quote.
    assert(redelimit("a\\nb\\\\c\\t", '`') == "a\\nb\\\\c\\t");
    assert(redelimit(`\\\\"`, '`') == `\\\\"`);
    // Respelling for the delimiter the body already has changes nothing.
    assert(redelimit(`say \\"hi\\"`, '"') == `say \\"hi\\"`);
    assert(redelimit("\\{a\\} \\`b\\`", '`') == "\\{a\\} \\`b\\`");
})

# A string token's source text, re-delimited as whichever of `"` and `` ` ``
# spells its value with fewer escapes. A tie keeps the delimiter it has, so a
# literal with nothing to escape is never rewritten; a `"""`/```` ``` ```` block
# (whose two forms are not interchangeable — only the raw template decodes `\{`)
# is returned unchanged.
pub fn requote(self: str) -> str {
    if (self.starts_with(`"""`) || self.starts_with("```")) {
        return self.unblock();
    };
    let delim = self.first().value_or(' ');
    if (delim != '"' && delim != '`') {
        return self;
    };
    let other = if (delim == '"') { '`' } else { '"' };
    let body = self[1..self.len() - 1];
    if (escape_cost(body, other) < escape_cost(body, delim)) {
        `{other}{redelimit(body, other)}{other}`
    } else {
        self
    }
}.test({
    // Nothing to escape either way: the literal keeps its delimiter.
    assert(requote(`"plain"`) == `"plain"`);
    assert(requote("`plain`") == "`plain`");
    assert(requote(`""`) == `""`);
    assert(requote("``") == "``");
    // A `"` literal that only escapes quotes: a backtick spells them bare.
    assert(requote(`"say \\"hi\\""`) == "`say \"hi\"`");

    // A backtick literal that only escapes braces / backticks: `"` spells them
    // bare.
    assert(requote("`\\{a\\}`") == "\"{a}\"");
    assert(requote("`\\`b\\``") == "\"`b`\"");
    // Mixed content goes to the cheaper side; a tie stays put.
    assert(requote(`"\\"\\"\{"`) == "`\"\"\\{`");
    assert(requote("`\\{\\}\"`") == `"\{\}\\""`);
    assert(requote(`"\\"\{"`) == `"\\"\{"`);
    assert(requote("`\\{\"`") == "`\\{\"`");
    // Shared escapes ride along unchanged.
    assert(requote(`"a\\n\\"b\\""`) == "`a\\n\"b\"`");

    // A block whose value is one line becomes a single-line literal, by the
    // same rule; one whose value spans lines stays a block. Any other token is
    // left alone.
    assert(requote(`"""a "b" c"""`) == "`a \"b\" c`");
    assert(requote("```\\{a\\}```") == `"\{a\}"`);
    assert(requote(`"""\na\nb\n"""`) == `"""\na\nb\n"""`);
    assert(requote(`'"'`) == `'"'`);
})

# A `"""`/```` ``` ```` block respelled as the single-line literal of its value
# when that value holds no newline — the block was three lines spent on one
# line's worth of text — under whichever of `"` and `` ` `` needs fewer
# escapes; a tie keeps the block's own family (`"""` to `"`, ```` ``` ```` to
# `` ` ``). A value with a newline is what the block form is for, and stays.
#
# Unlike `requote`'s single-line respelling, which copies the source and only
# moves the delimiter-specific escapes, this one is spelled from the *value*:
# a block's content is verbatim (a raw template decodes only `\{`/`\}`), so
# every backslash, tab and delimiter in it gains its escape here.
fn unblock(self: str) -> str {
    let value = str_lit_value(self);
    if (value.contains('\n')) {
        return self;
    };
    let family = if (self.starts_with(`"""`)) { '"' } else { '`' };
    let other = if (family == '"') { '`' } else { '"' };
    let delim = if (value_cost(value, other) < value_cost(value, family)) { other } else { family };
    `{delim}{encode(value, delim)}{delim}`
}.test({
    assert(unblock(`"""hi"""`) == `"hi"`);
    assert(unblock("```hi```") == "`hi`");
    // The blank opening and closing lines a block usually has are not content.
    assert(unblock(`"""\n    hi\n"""`) == `"hi"`);
    // Delimiters in the value pick the other family when that is cheaper.
    assert(unblock(`"""say "hi""""`) == "`say \"hi\"`");
    assert(unblock("```say \"hi\"```") == "`say \"hi\"`");
    assert(unblock("```a \\{b\\} c```") == `"a \{b\} c"`);
    // A raw block's backslash is content, and gains its escape.
    assert(unblock(`"""a\\b"""`) == `"a\\\\b"`);
    // Trailing content space is kept; a value with a newline stays a block.
    assert(unblock(`"""x """`) == `"x "`);
    assert(unblock(`"""\na\nb\n"""`) == `"""\na\nb\n"""`);
})

# How many escapes `value` needs under `delim` when spelled from the value.
fn value_cost(value: str, delim: char) -> u64 { value.count_if(|c| c.needs_escape(delim)) }.test({
    assert(value_cost(`say "hi"`, '"') == 2);
    assert(value_cost(`say "hi"`, '`') == 0);
    assert(value_cost("{a}", '`') == 2);
})

# `value` as the body of a single-line literal delimited by `delim`: the
# shared escapes for a backslash, tab and carriage return, and the delimiter's
# own escapes (`needs_escape`); everything else verbatim.
fn encode(value: str, delim: char) -> str {
    mut out = "";
    for (let c : value) {
        if (c == '\\') {
            set out.extend("\\\\");
        } else if (c == '\t') {
            set out.extend("\\t");
        } else if (c == '\r') {
            set out.extend("\\r");
        } else if (c.needs_escape(delim)) {
            set out.extend(`\\{c}`);
        } else {
            set out.extend(`{c}`);
        };
    }
    out
}.test({
    assert(encode("plain", '"') == "plain");
    assert(encode(`say "hi"`, '"') == `say \\"hi\\"`);
    assert(encode(`say "hi"`, '`') == `say "hi"`);
    assert(encode("a{b}`c", '`') == "a\\{b\\}\\`c");
    assert(encode("a\\b\tc", '"') == "a\\\\b\\tc");
})
