# Every importable builtin: which callee it is, where its signature and documentation come from,
# what else its source exports, and the library an import takes it from.
#
# A builtin is one of three kinds. `Written` is an ordinary AIPL file in `aipl-mono/src/`, whose
# `pub fn` and `# ..` block are its signature and documentation. `Declared` is expanded or generated
# by the compiler and typed by a declaration named `__builtin_<name>`. `Described` is typed by a rule
# in the checker with nothing to read, so its signature and prose are written here.
#
# The table is in the order the arms of `Callee` list the importable builtins. Rust reads it through
# the embedding FFI.

import { distinct, equal as == } from builtins;

variant BuiltinDefinition = Written(file: str) | Declared | Described(signature: str, doc: str)

# `callee` is the canonical name (`__builtin_len`); `exports` are the other names its source makes
# importable; `library` is the namespace an import names; `public_name` is the spelling inside the
# library when it is not the callee's own (`parse` for `__builtin_parse_json`).
struct BuiltinEntry {
    callee: str,
    definition: BuiltinDefinition,
    exports: str[] = [],
    library: str = "builtins",
    public_name: str? = none,
}

# The whole table.
pub fn builtin_table() -> BuiltinEntry[] {
    [
        BuiltinEntry { callee: "__builtin_print", definition: Declared },
        BuiltinEntry { callee: "__builtin_put", definition: Declared },
        BuiltinEntry { callee: "__builtin_split", definition: Declared },
        BuiltinEntry { callee: "__builtin_split_len", definition: Declared },
