        },
        BuiltinEntry {
            callee: "__builtin_float_greater_than_or_equal",
            definition: Described(
                "fn float_greater_than_or_equal<T: float>(a: T, b: T) -> bool",
                "Whether `a` is greater than or equal to `b` (false when either is NaN). Import it as the operator: `float_greater_than_or_equal as >=`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_equal",
            definition: Described(
                "fn equal<T: any>(a: T, b: T) -> bool",
                "Whether the two values are equal. Import it as the operator: `equal as ==`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_not_equal",
            definition: Described(
                "fn not_equal<T: any>(a: T, b: T) -> bool",
                "Whether the two values differ. Import it as the operator: `not_equal as !=`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_less_than",
            definition: Described(
                "fn less_than<T: ord>(a: T, b: T) -> bool",
                "Whether `a` is less than `b`. Import it as the operator: `less_than as <`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_greater_than",
            definition: Described(
                "fn greater_than<T: ord>(a: T, b: T) -> bool",
                "Whether `a` is greater than `b`. Import it as the operator: `greater_than as >`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_less_than_or_equal",
            definition: Described(
                "fn less_than_or_equal<T: ord>(a: T, b: T) -> bool",
                "Whether `a` is less than or equal to `b`. Import it as the operator: `less_than_or_equal as <=`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_greater_than_or_equal",
            definition: Described(
                "fn greater_than_or_equal<T: ord>(a: T, b: T) -> bool",
                "Whether `a` is greater than or equal to `b`. Import it as the operator: `greater_than_or_equal as >=`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_logical_and",
            definition: Described(
                "fn logical_and(a: bool, b: bool) -> bool",
                "Whether both are true; `b` is not evaluated when `a` is false. Import it as the operator: `logical_and as &&`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_logical_or",
            definition: Described(
                "fn logical_or(a: bool, b: bool) -> bool",
                "Whether either is true; `b` is not evaluated when `a` is true. Import it as the operator: `logical_or as ||`.",
            ),
        },
        BuiltinEntry {
            callee: "__builtin_logical_not",
            definition: Described(
                "fn logical_not(a: bool) -> bool",
                "Whether `a` is false. Import it as the operator: `logical_not as !`.",
            ),
        },
    ]
}.test({
    let table = builtin_table();
    // Each builtin is listed once.
    assert(table$callee.distinct() == table$callee);
    assert(table[0]? == BuiltinEntry { callee: "__builtin_print", definition: Declared });
})
