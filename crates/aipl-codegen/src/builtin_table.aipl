# Every importable builtin: which callee it is, where its signature and documentation come from,
# what else its source exports, and the library an import takes it from.
#
# A builtin is one of three kinds. `Written` is an ordinary AIPL file in `aipl-mono/src/`, whose
# `pub fn` and `# ..` block are its signature and documentation. `Declared` is expanded or generated
# by the compiler and typed by a declaration named `__builtin_<name>`. `Described` is typed by a
# rule
# in the checker with nothing to read, so its signature and prose are written here.
#
# The table is in the order the arms of the Rust `Callee` list the importable builtins. Rust reads
# it through the embedding FFI; the lints read it as `Callee`.

import {
    all,
    distinct,
    equal as ==,
    find_if,
    len,
    logical_and as &&,
    logical_not as !,
    starts_with,
    value_or,
} from builtins;

# What a call is to. The importable builtins have a case each, named as the Rust `Callee` arm is;
# `Some`, `Ok`, `Err` and `Assert` are the names the language reserves; a call to a name the file
# does not import from a builtins library is `User` (`is_method` says whether the file's own
# function it names takes `self` first, so `recv.f(..)` can call it), or `Local` where a local
# holding a function
# hides the name. `Unresolved` is what the parser writes, before `resolve_callees` decides.
variant Callee =
    | Print
    | Put
    | Split
    | SplitLen
    | Join
    | Intersperse
    | TupleWindows
    | SameCase
    | CaseName
    | CaseOf
    | CountIsLessThan
    | CountIsAtMost
    | CountIsGreaterThan
    | CountIsAtLeast
    | CountIsEqual
    | CountIsNotEqual
    | CountIfIsLessThan
    | CountIfIsAtMost
    | CountIfIsGreaterThan
    | CountIfIsAtLeast
    | CountIfIsEqual
    | CountIfIsNotEqual
    | First
    | Only
    | GridGet
    | GridFrom
    | GridOf
    | GridTrySet
    | Width
    | SeededWithInt
    | SeededWithClock
    | Height
    | IsInBoundsOf
    | GridIsInBoundsOf
    | Last
    | NonemptyFirst
    | NonemptyLast
    | EnsureNonempty
    | AssumeNonempty
    | DropFirst
    | DropLast
    | DropN
    | DropLastN
    | RemoveIndex
    | ToStr
    | ToStrLen
    | Map
    | TryMap
    | Filter
    | FilterMap
    | All
    | Any
    | Fold
    | OptFold
    | Zip
    | Trim
    | HeapStr
    | RopeStr
    | InlineStr
    | PackInline
    | InlineCapacity
    | Measure
    | MeasureBegin
    | MeasureConsume
    | MeasureEnd
    | MeasureRead
    | IsAllWhitespace
    | StartsWith
    | StartsWithAt
    | EndsWith
    | Len
    | Range
    | IsNonempty
    | IsEmpty
    | Push
    | Extend
    | ExtendOptional
    | ExtendMap
    | ExtendFilter
    | ExtendFilterMap
    | Reserve
    | IsSome
    | IsSomeAnd
    | IsErrAnd
    | MapErr
    | ErrorOf
    | MapOk
    | IntParse
    | IntParseUnsigned
    | IsSpace
    | IsWhitespace
    | IsDigit
    | ToDigit
    | Narrow
    | TrimWhile
    | Words
    | CartesianProduct
    | Count
    | CountWhile
    | CountIf
    | FindIf
    | CollectArms
    | AsCase
    | IsCase
    | CollectOk
    | MapFindIf
    | MapJoin
    | JoinIsNonempty
    | JoinIsEmpty
    | Reduce
    | MapReduce
    | FilterMapReduce
    | SplitMap
    | FindMap
    | ReverseFindMap
    | FindIndex
    | ValueOr
    | ValueOrErr
    | Contains
    | Has
    | ToArray
    | ToSet
    | ReadFileToString
    | WriteStringToFile
    | ListFiles
    | ReadLine
    | ReadByte
    | ClearTerminal
    | MoveTo
    | EnterAlternateScreen
    | LeaveAlternateScreen
    | ShimCellGet
    | ShimCellSet
    | CellNew
    | CellGet
    | CellSet
    | ReadKey
    | ParseJson
    | RandomU64
    | NowNanos
    | MonotonicNow
    | ExecuteProgram
    | HttpGet
    | ShowWindow
    | ShowView
    | NextEvent
    | CloseWindow
    | Union
    | UnionAll
    | SetMap
    | Difference
    | Intersection
    | Insert
    | Get
    | ContainsKey
    | RemoveKey
    | InsertKey
    | ToDict
    | MapToDict
    | Hash
    | Min
    | Max
    | Minimum
    | Maximum
    | Reverse
    | Sort
    | SortBy
    | Repeat
    | With
    | TrySet
    | WrappingAdd
    | SaturatingAdd
    | WrappingSub
    | SaturatingSub
    | WrappingMul
    | SaturatingDivide
    | SaturatingRemainder
    | ToFloat
    | Render
    | Distinct
    | Pad
    | Tabulate
    | ToFixed
    | FloatAdd
    | FloatSub
    | FloatMul
    | FloatDivide
    | FloatEqual
    | FloatNotEqual
    | FloatLessThan
    | FloatGreaterThan
    | FloatLessThanOrEqual
    | FloatGreaterThanOrEqual
    | Equal
    | NotEqual
    | LessThan
    | GreaterThan
    | LessThanOrEqual
    | GreaterThanOrEqual
    | LogicalAnd
    | LogicalOr
    | LogicalNot
    # The operator builtins that share another's Rust callee (`wrapping_increment` is a
    # `wrapping_add` of one), so the table the Rust side reads has no row for them and a call to
    # one is a call of the shared callee there. A lint tells them apart, which is what
    # `lint_table` is for.
    | WrappingIncrement
    | SaturatingIncrement
    | WrappingDecrement
    | SaturatingDecrement
    | WrappingAddAssign
    | SaturatingAddAssign
    | WrappingSubAssign
    | SaturatingSubAssign
    | WrappingMulAssign
    | SaturatingDivideAssign
    | Some
    | Ok
    | Err
    | Assert
    | User(name: str, is_method: bool)
    | Local(name: str)
    | Unresolved

# Whether a call to `self` can be written with the first argument as its receiver: a function of
# the file's own that takes `self` first, or a builtin. A local that holds a function, a reserved
# name and an unresolved call cannot.
pub fn is_method_callable(self: Callee) -> bool {
    match (self) {
        User(_, is_method) => is_method,
        Local(..) | Some | Ok | Err | Assert | Unresolved => false,
        _ => true,
    }
}.test({
    assert(Len.is_method_callable());
    assert(User("f", true).is_method_callable());
    assert(!User("f", false).is_method_callable());
    assert(!Local("f").is_method_callable());
    assert(!Some.is_method_callable());
})

variant BuiltinDefinition = Written(file: str) | Declared | Described(signature: str, doc: str)

# `arm` is the callee as a case and `callee` is its canonical name (`__builtin_len`); `exports` are
# the other names its source makes importable; `library` is the namespace an import names;
# `public_name` is the spelling inside the library when it is not the callee's own (`parse` for
# `__builtin_parse_json`).
struct BuiltinEntry {
    arm: Callee,
    callee: str,
    definition: BuiltinDefinition,
    exports: str[] = [],
    library: str = "builtins",
    public_name: str? = none,
}

# The spelling an import from `self`'s library uses for it.
pub fn import_name(self: BuiltinEntry) -> str {
    self.public_name.value_or(self.callee["__builtin_".len()..])
}.test({
    let len = BuiltinEntry { arm: Len, callee: "__builtin_len", definition: Declared };
    assert(len.import_name() == "len");
    assert(BuiltinEntry { ..len, public_name: some("size") }.import_name() == "size");
})

# The builtin that `import { name } from library;` brings in, if there is one.
pub fn builtin_imported(self: BuiltinEntry[], library: str, name: str) -> BuiltinEntry? {
    self.find_if(|entry| entry.library == library && entry.import_name() == name)
}.test({
    let table = builtin_table();
    assert(table.builtin_imported("builtins", "len")$arm? == Len);
    assert(table.builtin_imported("sets", "union")$arm? == Union);
    assert(table.builtin_imported("json", "parse")$arm? == ParseJson);
    assert(table.builtin_imported("sets", "len") == none);
    assert(table.builtin_imported("builtins", "__builtin_len") == none);
})

# The table the lints read: the importable builtins, and the operator builtins that Rust resolves
# to another's callee. Each is a builtin the file imports under its operator (`wrapping_increment
# as ++`), so a lint can say which one a call is, and what to advise, without the written name.
pub fn lint_table() -> BuiltinEntry[] {
    [
        ..builtin_table(),
        BuiltinEntry {
            arm: WrappingIncrement,
            callee: "__builtin_wrapping_increment",
            definition: Declared,
        },
        BuiltinEntry {
            arm: SaturatingIncrement,
            callee: "__builtin_saturating_increment",
            definition: Declared,
        },
        BuiltinEntry {
            arm: WrappingDecrement,
            callee: "__builtin_wrapping_decrement",
            definition: Declared,
        },
        BuiltinEntry {
            arm: SaturatingDecrement,
            callee: "__builtin_saturating_decrement",
            definition: Declared,
        },
        BuiltinEntry {
            arm: WrappingAddAssign,
            callee: "__builtin_wrapping_add_assign",
            definition: Declared,
        },
        BuiltinEntry {
            arm: SaturatingAddAssign,
            callee: "__builtin_saturating_add_assign",
            definition: Declared,
        },
        BuiltinEntry {
            arm: WrappingSubAssign,
            callee: "__builtin_wrapping_sub_assign",
            definition: Declared,
        },
        BuiltinEntry {
            arm: SaturatingSubAssign,
            callee: "__builtin_saturating_sub_assign",
            definition: Declared,
        },
        BuiltinEntry {
            arm: WrappingMulAssign,
            callee: "__builtin_wrapping_mul_assign",
            definition: Declared,
        },
        BuiltinEntry {
            arm: SaturatingDivideAssign,
            callee: "__builtin_saturating_divide_assign",
            definition: Declared,
        },
    ]
}.test({
    let table = lint_table();
    assert(table$arm.distinct() == table$arm);
    assert(
        table
            .find_if(|entry| entry.arm == WrappingIncrement)?
            .import_name() == "wrapping_increment",
    );
    // They follow the table the Rust side reads.
    assert(table[builtin_table().len()]?.arm == WrappingIncrement);
})

