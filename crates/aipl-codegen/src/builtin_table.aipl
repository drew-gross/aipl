    | LogicalOr
    | LogicalNot

variant BuiltinDefinition = Written(file: str) | Declared | Described(signature: str, doc: str)

# `arm` is the callee as a case and `callee` is its canonical name (`__builtin_len`); `exports` are
# the other names its source makes importable; `library` is the namespace an import names;
# `public_name` is the spelling inside the library when it is not the callee's own (`parse` for
# `__builtin_parse_json`).
struct BuiltinEntry {
    arm: Callee,
    callee: str,
    definition: BuiltinDefinition,
    exports: str[] = [],
    library: str = "builtins",
    public_name: str? = none,
}

# The spelling an import from `self`'s library uses for it.
pub fn import_name(self: BuiltinEntry) -> str {
    self.public_name.value_or(self.callee["__builtin_".len()..])
}.test({
    let len = BuiltinEntry { arm: Callee.Len, callee: "__builtin_len", definition: Declared };
    assert(len.import_name() == "len");
    assert(BuiltinEntry { ..len, public_name: some("size") }.import_name() == "size");
})

# The builtin that `import { name } from library;` brings in, if there is one.
pub fn builtin_imported(self: BuiltinEntry[], library: str, name: str) -> BuiltinEntry? {
    self.find_if(|entry| entry.library == library && entry.import_name() == name)
}.test({
    let table = builtin_table();
    assert(table.builtin_imported("builtins", "len")$arm == some(Callee.Len));
    assert(table.builtin_imported("sets", "union")$arm == some(Callee.Union));
    assert(table.builtin_imported("json", "parse")$arm == some(Callee.ParseJson));
    assert(table.builtin_imported("sets", "len") == none);
    assert(table.builtin_imported("builtins", "__builtin_len") == none);
})

