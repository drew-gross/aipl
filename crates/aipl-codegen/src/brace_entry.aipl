// One entry of a `#{ .. }` literal and the decision that turns a list of them
// into a set or a dict. One of the files the AST is declared across; see
// `ast.aipl`.
import { Span, equal as ==, is_err_and, is_nonempty, logical_and as &&, push } from builtins;
import { DictLit, Expr, SetLit, at, num, show_expr } from "./expr.aipl";
import { ParseError } from "./grammar.aipl";

# One entry of a `#{ .. }` literal, before it is known whether the literal is a
# set or a dict. Every entry has to be one or the other consistently, and the
# entries are not all in scope until the whole body is lowered — so the decision
# belongs to `atom`, and this is what `brace_body` hands it.
variant BraceEntry = Key(Expr) | Pair(Expr, Expr)

# `#{ .. }` — a set, a dict, or an empty of either, which is both until its use
# site says. Mixing the two spellings is refused here, where the whole body is
# in scope for the first time.
pub fn brace_literal(entries: BraceEntry[], span: Span) -> Expr!ParseError {
    mut keys: Expr[] = [];
    mut pairs: (Expr, Expr)[] = [];
    for (let e : entries) {
        match (e) {
            Key(k) => {
                set keys.push(k);
            },
            Pair(k, v) => {
                set pairs.push((k, v));
            },
        };
    }
    if (keys.is_nonempty() && pairs.is_nonempty()) {
        return err(ParseError { message: brace_mix_message(), span });
    };
    if (pairs.is_nonempty()) {
        return ok(at(DictLit(pairs), span));
    };
    ok(at(SetLit(keys), span))
}.test({
    assert(brace_literal([Key(num(1)), Key(num(2))], 0..0)?.show_expr() == "Set([1, 2])");
    assert(brace_literal([Pair(num(1), num(2))], 0..0)?.show_expr() == "Dict([1: 2])");
    // Empty is a set: nothing said "key: value".
    assert(brace_literal([], 0..0)?.show_expr() == "Set([])");
    assert(
        brace_literal([Key(num(1)), Pair(num(1), num(2))], 0..0).is_err_and(
            |e| e.message == brace_mix_message(),
        ),
    );
})

fn brace_mix_message() -> str {
    """
        a "#{ .. }" literal can't mix set elements and "key: value" pairs — use either all bare elements (a set) or all pairs (a dict)
    """
}
