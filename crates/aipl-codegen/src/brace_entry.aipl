# One entry of a `#{ .. }` literal and the decision that turns a list of them
# into a set or a dict. One of the files the AST is declared across; see
# `ast.aipl`.

import {
    Span,
    any,
    equal as ==,
    is_err_and,
    is_nonempty,
    logical_and as &&,
    logical_not as !,
    push,
    same_case,
} from builtins;
import { DictLit, Expr, SetLit, at, is_spread, num, show_expr } from "./expr.aipl";
import { ParseError } from "./grammar.aipl";
import { Asc, Desc, SetOrder, Unordered } from "./ty.aipl";

# One entry of a `#{ .. }` literal, before it is known whether the literal is a
# set or a dict. Every entry has to be one or the other consistently, and the
# entries are not all in scope until the whole body is lowered — so the decision
# belongs to `atom`, and this is what `brace_body` hands it.
variant BraceEntry = Key(Expr) | Pair(Expr, Expr)

# `#{ .. }` — a set, a dict, or an empty of either, which is both until its use
# site says. Mixing the two spellings is refused here, where the whole body is
# in scope for the first time. An ordered `#>{ .. }` / `#<{ .. }` is a set and
# nothing else: a pair in one is refused too.
pub fn brace_literal(entries: BraceEntry[], order: SetOrder, span: Span) -> Expr!ParseError {
    mut keys: Expr[] = [];
    mut pairs: (Expr, Expr)[] = [];
    for (let e : entries) {
        match (e) {
            Key(k) => {
                set keys.push(k);
            },
            Pair(k, v) => {
                set pairs.push((k, v));
            },
        };
    }
    if (pairs.is_nonempty() && keys.any(is_spread)) {
        return err(ParseError { message: dict_spread_message(), span });
    };
    if (keys.is_nonempty() && pairs.is_nonempty()) {
        return err(ParseError { message: brace_mix_message(), span });
    };
    if (pairs.is_nonempty()) {
        if (!order.same_case(Unordered)) {
            return err(ParseError { message: ordered_pairs_message(), span });
        };
        return ok(at(DictLit(pairs), span));
    };
    ok(at(SetLit(keys, order), span))
}.test({
    assert(
        brace_literal([Key(num(1)), Key(num(2))], Unordered, 0..0)?.show_expr() == "Set([1, 2])",
    );
    assert(brace_literal([Pair(num(1), num(2))], Unordered, 0..0)?.show_expr() == "Dict([1: 2])");
    // Empty is a set: nothing said "key: value".
    assert(brace_literal([], Unordered, 0..0)?.show_expr() == "Set([])");
    assert(brace_literal([Key(num(1)), Pair(num(1), num(2))], Unordered, 0..0).is_err_and(
        |e| e.message == brace_mix_message(),
    ));
    // An ordered literal carries its order, and is never a dict.
    assert(
        brace_literal([Key(num(2)), Key(num(1))], Desc, 0..0)?.show_expr() == "Set([2, 1], Desc)",
    );
    assert(brace_literal([], Asc, 0..0)?.show_expr() == "Set([], Asc)");
    assert(brace_literal([Pair(num(1), num(2))], Desc, 0..0).is_err_and(
        |e| e.message == ordered_pairs_message(),
    ));
})

fn ordered_pairs_message() -> str {
    """an ordered "#>{ .. }" / "#<{ .. }" literal is a set, so it holds bare elements — a "key: value" pair belongs in a "#{ .. }" dict"""
}

fn dict_spread_message() -> str {
    """a `..` spread is only allowed in a set literal — a "#{ .. }" holding "key: value" pairs is a dict"""
}

fn brace_mix_message() -> str {
    """a "#{ .. }" literal can't mix set elements and "key: value" pairs — use either all bare elements (a set) or all pairs (a dict)"""
}
