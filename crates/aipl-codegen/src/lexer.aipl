// A small library for building lexers. `lex` turns source text into a flat
// `Token[]`, driven by an ordered `TokenRule[]` describing the language being
// lexed. Each rule pairs a caller-chosen `kind` label with a `Matcher` — a
// data-only description of one token shape (a char-class run, a list of fixed
// spellings, a delimited literal, ...) — so a rule set is plain data and one
// `lex` serves many languages; see the JSON and AIPL-flavored rule sets in the
// tests. At each position the *first* rule whose matcher matches wins, so
// order is priority: put keywords before identifiers, floats before ints.
// Whitespace is an ordinary rule marked `skip: true` — matched and consumed,
// but producing nothing. Rules marked `trivia: true` (comments, lint markers)
// are consumed the same way but recorded in the result's trivia side-channel,
// so a formatter or lint pass can find them without them cluttering the token
// stream. Lexing can fail: a byte no rule matches, or a matcher that matches
// invalid input outright (an unterminated `Delimited` token), aborts the lex
// with a `LexError` — a message plus the span of the offending source.
import {
    !,
    !=,
    &&,
    wrapping_add as +,
    +++,
    wrapping_sub as -,
    <,
    ==,
    ||,
    Span,
    contains,
    count_while,
    int_parse,
    is_digit,
    is_some_and,
    len,
    push,
    starts_with,
    value_or,
} from builtins;
// The `.test` block's decoding emits need a string-escape decoder. The library
// deliberately provides none (escape meaning is a language's policy), so the
// test borrows AIPL's own — the same `unescape` the real lexer uses — rather
// than keeping a second copy in sync.
import { unescape } from "./unescape.aipl";

// What a token carries beyond its span: the processed *value* of the matched
// text, computed at lex time by the matcher that claimed it (see each
// matcher's doc). `StrVal` holds delimiter-stripped, *un-decoded* text (strings,
// raw strings, template segments) — the library strips the delimiters but leaves
// escapes verbatim for the rule's `emit` to decode with its own decoder (escape
// meaning is a language's policy, not the library's). Everything a rule can
// recover by slicing its span — identifiers, punctuation, keywords, comments,
// and the `Int`/`Float` numeric runs (whose *parsing* is the rule's `emit`'s
// job, via the `int_parse` builtin or its own) — carries `NoValue`. (A char
// literal is not a library concern: a consumer that wants one lexes it as a
// single-quoted `Delimited` string and validates the one-char shape in its
// `emit` — see `lex_aipl.aipl`.)
variant TokenValue = NoValue | StrVal(str)

// What a token is: its `kind` — a caller-defined value carrying whatever the
// matched token means, produced by the rule's `emit` (see `Emit`) — and the
// half-open byte range it covers in the source (the raw text is recovered by
// slicing, `src[t.span]`). `Token` is generic over the kind type `K`, so a
// language pins `K` to its own `variant` whose arms *are* the token kinds, each
// carrying that kind's content (`Int(i64)`, `Str(str)`, a bare `Plus`, …) —
// rather than a stringly-typed label plus a separate value.
struct Token<K> { kind: K, span: Span }

// Where in a template literal a text segment sits, handed to a `Template`
// rule's `OfSeg` emit so one rule can produce a *different* kind per position:
// `Plain` (a literal with no interpolations), `Head` (open delim through the
// first `{`), `Middle` (between two interpolations), `Tail` (through the close).
variant Seg = Plain | Head | Middle | Tail

// How a rule turns its matched token into a kind `K`: a fixed set of options.
// `Bare` is a finished kind for a valueless token (punctuation, an operator);
// `Of` applies a constructor to the token's *content string* — the
// delimiter-stripped text for a string matcher (`Delimited`/`Between`/`Nested`),
// or the raw matched text for everything else (identifiers, whose text is their
// content, and numeric `Int`/`Float` runs, whose emit parses the digits itself).
// The two never overlap — a matcher either strips delimiters or has none — so one
// option serves both, always handing over the meaningful content. `OfSeg` is for
// a `Template` rule, applied to each segment's text and its position.
//
// `Try`/`TrySeg` are the fallible siblings: the function returns `K!str` — a
// kind, or an error *message*. Interpreting a match can fail (a numeric literal
// that overflows i64, a string that breaks a content rule — e.g. a single-quoted
// string that isn't exactly one char, a consumer's char literal); when it returns
// `err(msg)` the library pairs the message with the token's whole span to build a
// `LexError` (see `apply_emit`). The token span is the right location for a
// whole-token verdict like overflow; a matcher-level, byte-precise error (an
// unterminated string, an unknown escape) still comes from scanning, not the emit.
variant Emit<K> =
    Bare(K)
    | Of((str) -> K)
    | OfSeg((str, Seg) -> K)
    | Try((str) -> K!str)
    | TrySeg((str, Seg) -> K!str)

// Why a lex failed: what went wrong, and the span of the offending source
// (absolute into the lexed string — slice it to show the offender).
struct LexError { message: str, span: Span }

// One token shape, as plain data. Char classes and fixed spellings are both
// spelled as strings (class membership via `contains`, a spelling matched
// whole); none of them ever match empty input, so `lex` always makes progress.
//
// - `CharRun(first, cont)`: a maximal run — a char in `first` opens the token,
//   chars in `cont` extend it. Identifiers, digit runs, whitespace.
// - `Exact(spelling)`: the given spelling, verbatim. Punctuation and operators
//   — one spelling per rule; when spellings share a prefix, order the rules
//   longest first (`==` before `=`), since rule order is the priority mechanism
//   (a single rule matching a set, with its own longest-wins, would duplicate
//   that ordering as a second mechanism).
// - `Keyword(spelling, boundary)`: like `Exact`, but the spelling only matches
//   when the char after it is absent or outside `boundary` (the identifier
//   continue class) — so a keyword rule placed before the identifier rule
//   claims `if` without biting the front off `iffy`. One spelling per rule, as
//   with `Exact`; a shared prefix (`in`/`int`) is resolved by the boundary
//   check, not rule order, so order among keyword rules doesn't matter.
// - `Delimited(delims, escapes)`: a char in `delims` opens the token, which
//   runs to just past the next occurrence of the *same* char. `escapes` is
//   the set of chars that may follow a backslash inside the token: `\` plus
//   an allowed char is content (in particular an escaped delimiter does not
//   close), `\` plus anything else is a lex error, and "" turns escape
//   handling off entirely (a backslash is ordinary content). A token still
//   open at the end of the source is a lex error. String literals. `escapes`
//   governs *scanning* only — the token's value is the delimiter-stripped text
//   left *un-decoded*, so the rule's `emit` decides what escapes mean, with its
//   own decoder (the library provides none — escape semantics are the
//   language's).
// - `Between(open, close)`: the `open` spelling opens the token, which runs to
//   just past the next *full* occurrence of the `close` spelling. Unlike
//   `Delimited`, open and close are multi-char and may differ, and the scan
//   matches the whole `close` — so a partial close inside (a lone `"` or `""`
//   under a `"""` close) is ordinary content. Contents are verbatim (no escape
//   processing), which is what raw strings `"""..."""` and non-nesting block
//   comments `/* ... */` want. Both spellings must be non-empty. A token still
//   open at the end of the source is a lex error.
// - `Nested(open, close)`: like `Between`, but depth-tracked — each further
//   `open` inside raises the nesting depth and the matching `close` lowers it,
//   so the token ends only at the `close` that balances the outermost `open`.
//   Rust-style nesting block comments `/* ... /* ... */ ... */`. `open` and
//   `close` must be distinct (a delimiter can't both open and close a level)
//   and non-empty. A token still open (depth > 0) at the end of the source is a
//   lex error.
// - `Template(delim, escapes, finalize)`: a template literal — text with
//   `{expr}` interpolations. The `delim` spelling opens and closes the literal;
//   it may be multi-char and scans like `Between` (a lone backtick under a
//   triple-backtick delim is content). Text segments follow `escapes` as in
//   `Delimited` (`\{` doesn't interpolate, an escaped delim doesn't close,
//   `""` turns escapes off — the verbatim raw-template shape). A `{` in text
//   opens an interpolation, lexed by the full rule set until the balancing
//   `}` — so skip rules and nested template rules apply inside — with brace
//   depth tracked and the closing `}` consumed without a token. `finalize` is a
//   `(str[]) -> str[]` the caller supplies to post-process a literal's text
//   segments *as a group* before they're emitted (it must return one text per
//   input segment) — for a transform that needs the whole literal, like
//   de-denting a raw template's shared indent; pass an identity for none. The
//   emitted kinds are context-dependent, derived from the rule's kind K: a
//   literal with no interpolations is one K token; otherwise K_head (the open
//   delim through the first `{`), each interpolation's tokens under their own
//   rules' kinds, K_middle for each segment between interpolations, and
//   K_tail (through the closing delim). The `skip` flag is ignored — a
//   template always produces tokens.
// - `ToEol(marker)`: the `marker` spelling, then everything up to (not
//   including) the next newline. Line comments — usually `skip: true`.
// - `Float`: a digit run that extends past a fraction (`.` plus at least one
//   digit) and/or an exponent (`e`/`E`, an optional sign, at least one
//   digit), JSON style. A bare digit run does *not* match — put a `Float`
//   rule ahead of the int rule and each number lexes as the right one.
// - `Int`: a decimal digit run with an *optional* leading `-` — a distinct
//   matcher because a number is not an identifier, but (like `Float`) it carries
//   no computed value: its text is left *unparsed*, so the rule pairs it with an
//   `Of`/`Try` emit that parses the digits (and any sign) itself (via the
//   `int_parse` builtin, or its own scanner). Parsing — base, digit separators,
//   and what overflow means — is the caller's, not the library's. The `-` is
//   consumed only when a digit *immediately* follows it, so `- 5`/`-x` (a space or
//   a letter after the `-`) don't match and are left for a `-` operator rule. Rule
//   order alone then decides the reading: `Int` before a `-` operator makes `-5` a
//   signed literal (and `a - 5` still subtraction, since the `- 5` there has a
//   space); the operator before `Int` makes every `-` the operator and `Int`
//   unsigned. Scanning the sign *into* the token is also what lets the emit reach
//   the full signed range — an i64's `-9223372036854775808` overflows as a
//   positive literal, so it's only expressible with the `-` and digits together.
//
// Tokens carry values (see `TokenValue`), computed by the claiming matcher:
// `Delimited` a `StrVal` of the delimiter-stripped contents, *un-decoded* (the
// rule's `emit` decodes — escape handling is the caller's, not the library's);
// `Between`/`Nested` a verbatim `StrVal` of the contents (a raw string's
// de-denting is the caller's post-pass). `Template` (its segments), `Int`/`Float`
// (their digit text), and everything else — plus every trivia record — carry
// `NoValue`, so an `Of` emit recovers the raw matched text and interprets it. The
// library provides no string-escape decoder: what a `\X` means is a language's
// own policy, so a consumer's `emit` decodes with its own (e.g. `lex_aipl.aipl`'s
// `unescape`, mapping `\n`/`\t`/`\r` to control chars and any other `\X` to X
// itself). A char literal is likewise not a matcher: a consumer lexes it as a
// single-quoted `Delimited` string and enforces the one-char shape in a `Try`
// emit (see `lex_aipl.aipl`'s `char_lit_emit`).
variant Matcher =
    CharRun(str, str)
    | Exact(str)
    | Keyword(str, str)
    | Delimited(str, str)
    | Between(str, str)
    | Nested(str, str)
    | Template(str, str, (str[]) -> str[])
    | ToEol(str)
    | Float
    | Int

// One prioritized entry of a rule set: the shape to match, how to turn a match
// into a kind (`emit`), and what becomes of its matches. A plain rule emits a
// token; `skip: true` consumes matches silently (whitespace); `trivia: true`
// consumes them but records each in the result's trivia side-channel — for
// matches a later pass wants located but not parsed, like comments (a formatter
// re-attaches them) or lint markers (`#[allow]`). Set at most one of the two
// flags (`skip` wins when both are set). Generic over the kind type `K` — every
// rule of one set builds the same `K`.
// `unterminated` overrides the message used when this rule's token runs off the
// end of the source (a `Delimited`/`Between`/`Nested`/`Template` scan that never
// closes). Empty means "use the matcher's built-in default" (a generic
// "unterminated delimited token" / "unterminated template literal") — so a rule
// can name its token in the diagnostic (`"unterminated string literal"`) without
// every rule having to.
struct TokenRule<K> {
    matcher: Matcher,
    emit: Emit<K>,
    skip: bool = false,
    trivia: bool = false,
    unterminated: str = "",
}

// What `lex` returns: the emitted tokens, and the trivia side-channel — the
// recorded matches of every `trivia: true` rule, in source order. Silent
// `skip` matches appear in neither.
struct LexResult<K> { tokens: Token<K>[], trivia: Token<K>[] }

fn lex_err(message: str, start: i64, end: i64) -> LexError {
    LexError { message, span: start..end }
}

// `CharRun`: length of the maximal run at the start of `self` — a `first`
// char, then `cont` chars. 0 when the first char isn't in `first`.
fn char_run_len(self: str, first: str, cont: str) -> i64 {
    if (self[0].is_some_and(|c| first.contains(c))) {
        1 + self[1..].count_while(|c| cont.contains(c))
    } else {
        0
    }
}

// `Exact`: length of `spelling` when it prefixes `self`, else 0. An empty
// spelling never matches.
fn exact_len(self: str, spelling: str) -> i64 {
    if (0 < spelling.len() && self.starts_with(spelling)) { spelling.len() } else { 0 }
}

// `Keyword`: the length of `spelling` when it prefixes `self`, but only when the
// char after it is absent (end of source) or outside `boundary` — a keyword must
// not end in the middle of an identifier. 0 when it doesn't match (or the char
// after is a boundary char, as in `iffy` for `if`).
fn keyword_len(self: str, spelling: str, boundary: str) -> i64 {
    let bounded = !self[spelling.len()].is_some_and(|c| boundary.contains(c));
    if (0 < spelling.len() && bounded && self.starts_with(spelling)) { spelling.len() } else { 0 }
}

// `Delimited`: a `delims` char opens the token, which spans to just past the
// next occurrence of the same char. ok(0) when the first char isn't a
// delimiter. With a non-empty `escapes` set, a backslash escapes its next
// char: an allowed char is content (an escaped delimiter doesn't close), a
// disallowed one is a hard error, and a dangling backslash at the end of the
// source leaves the token unterminated. A token still open at the end of the
// source is a hard error (`at` is the token's absolute start, so error spans
// land in the real source).
fn delimited_len(self: str, at: i64, delims: str, escapes: str, msg: str) -> i64!LexError {
    if (!self[0].is_some_and(|c| delims.contains(c))) {
        return ok(0);
    };
    let d = self[0].value_or(' '); // in bounds: the guard above saw a char
    mut i = 1;
    mut closed = false;
    while (!closed && i < self.len()) {
        let c = self[i].value_or(' '); // in bounds: the loop condition holds
        if (c == d) {
            set closed = true;
        } else {
            // A backslash escapes its next char (when escapes are on and one
            // exists — a dangling backslash at the end of the source escapes
            // nothing, so the loop just runs out and the token is
            // unterminated). The escaped char must be allowed, and is content:
            // the extra step below skips it, so an escaped delimiter can't
            // close the token.
            if (c == '\\' && 0 < escapes.len() && i + 1 < self.len()) {
                if (!self[i + 1].is_some_and(|e| escapes.contains(e))) {
                    return err(
                        LexError {
                            message: "unknown escape sequence \\" +++ self[i + 1..i + 2],
                            span: at + i..at + i + 2,
                        },
                    );
                };
                set i = i + 1;
            };
        };
        set i = i + 1;
    }
    if (!closed) {
        return err(LexError { message: unterminated_msg(msg), span: at..at + self.len() });
    };
    ok(i)
}

// The message for an unterminated scan: a rule's own `unterminated` override, or
// the generic default when it left the field empty.
fn unterminated_msg(msg: str) -> str {
    if (msg.len() == 0) { "unterminated delimited token" } else { msg }
}

// `Between`: the `open` spelling opens the token, which runs to just past the
// next full occurrence of `close`. ok(0) when `self` doesn't start with
// `open`. The close scan starts past the open and matches the whole `close`
// spelling, so a partial close inside (a lone `"`/`""` under a `"""` close) is
// content, not a terminator, and open/close may be multi-char and differ. No
// escapes — contents are verbatim. A token still open at the end of the source
// is a hard error (`at` places the span in the real source).
fn between_len(self: str, at: i64, open: str, close: str, msg: str) -> i64!LexError {
    if (!self.starts_with(open)) {
        return ok(0);
    };

    // Scan for the close from just past the open, so an `open`/`close` that
    // share text (e.g. `"""`/`"""`) can't self-close on the opener.
    mut i = open.len();
    while (i < self.len()) {
        if (self[i..].starts_with(close)) {
            return ok(i + close.len());
        };
        set i = i + 1;
    }
    err(LexError { message: unterminated_msg(msg), span: at..at + self.len() })
}

// `Nested`: the depth-tracked `Between`. The `open` spelling opens the token at
// depth 1; each further `open` raises the depth and each `close` lowers it, so
// the token ends just past the `close` that returns the depth to 0. ok(0) when
// `self` doesn't start with `open`. `open` is tested before `close` so an
// overlap can't misclassify, but the two must be distinct for nesting to mean
// anything. No escapes — contents are verbatim. Still open (depth > 0) at the
// end of the source is a hard error (`at` places the span in the real source).
fn nested_len(self: str, at: i64, open: str, close: str, msg: str) -> i64!LexError {
    if (!self.starts_with(open)) {
        return ok(0);
    };
    mut depth = 1;
    mut i = open.len();
    while (0 < depth && i < self.len()) {
        if (self[i..].starts_with(open)) {
            set depth = depth + 1;
            set i = i + open.len();
        } else {
            if (self[i..].starts_with(close)) {
                set depth = depth - 1;
                set i = i + close.len();
            } else {
                set i = i + 1;
            };
        };
    }
    if (0 < depth) {
        return err(LexError { message: unterminated_msg(msg), span: at..at + self.len() });
    };
    ok(i)
}

// `ToEol`: the marker, then everything up to (not including) the next
// newline. 0 when `self` doesn't start with the (non-empty) marker.
fn to_eol_len(self: str, marker: str) -> i64 {
    if (0 < marker.len() && self.starts_with(marker)) { self.count_while(|x| x != '\n') } else { 0 }
}

// The end of the number whose integer part ends at `int_end`: extends past a
// fraction (`.` then at least one digit), then past an exponent (`e` or `E`,
// an optional sign, then at least one digit). Either part may be absent;
// `int_end` comes back unchanged when neither matches.
fn number_end(self: str, int_end: i64) -> i64 {
    mut end = int_end;
    if (self[end] == some('.') && self[end + 1].is_some_and(is_digit)) {
        set end = end + 1 + self[end + 1..].count_while(is_digit);
    };
    if (self[end].is_some_and(|e| e == 'e' || e == 'E')) {
        let has_sign = self[end + 1].is_some_and(|sign| sign == '+' || sign == '-');
        let digits = if (has_sign) { end + 2 } else { end + 1 };
        if (self[digits].is_some_and(is_digit)) {
            set end = digits + self[digits..].count_while(is_digit);
        };
    };
    end
}

// `Float`: a digit run that extends past a fraction and/or exponent. A bare
// digit run is 0 (no match) — it belongs to the int rule.
fn float_len(self: str) -> i64 {
    let int_end = self.count_while(is_digit);
    if (int_end == 0) {
        return 0;
    };
    let end = self.number_end(int_end);
    if (int_end < end) { end } else { 0 }
}

// `Int`: the length of an optional leading `-` then a digit run. 0 (no match)
// when there's no digit run — including a `-` *not* immediately followed by a
// digit (a `-` before a space or a letter is left for a `-` operator rule, so
// `- 5`/`-x` don't match). That decline is the entire sign-vs-operator
// disambiguation: with an `Int` rule before the `-` operator rule, `-5` is a
// signed literal while `- 5`/`-x` are the operator; put the operator first and
// every `-` is the operator and `Int` is unsigned.
fn int_len(self: str) -> i64 {
    let signed = self[0] == some('-') && self[1].is_some_and(is_digit);
    let start = if (signed) { 1 } else { 0 };
    let digits = self[start..].count_while(is_digit);
    if (digits == 0) { 0 } else { start + digits }
}

// The value a token of matcher `m` carries, computed from its matched `text`
// (`src[at..at+n]`, delimiters included) — see the value table on `Matcher`.
// Only the string-valued matchers carry a computed value; everything a rule can
// recover by slicing its span (`Int`/`Float` numeric runs, identifiers, …) is
// `NoValue`, so the rule's `emit` interprets the text itself. `Template` returns
// `NoValue` here only because its tokens are built inside `template_scan`, which
// attaches each segment's value itself.
fn token_value(m: Matcher, text: str) -> TokenValue {
    match (m) {
        CharRun(first, cont) => NoValue,
        Exact(spelling) => NoValue,
        Keyword(spelling, boundary) => NoValue,
        Delimited(delims, escapes) => StrVal(text[1..text.len() - 1]),
        Between(open, close) => StrVal(text[open.len()..text.len() - close.len()]),
        Nested(open, close) => StrVal(text[open.len()..text.len() - close.len()]),
        Template(delim, escapes, finalize) => NoValue,
        ToEol(marker) => NoValue,
        Float => NoValue,
        Int => NoValue,
    }
}

// Build a token's kind by applying the rule's `emit` to its content string —
// the matcher-computed `value` (a delimited string, stripped) when there is one,
// else the raw matched `text`. `Bare` ignores it; `Of` applies its constructor;
// `Try` does too but may fail with a message (paired with the token `span` to
// make a `LexError`). `OfSeg`/`TrySeg` belong to a `Template` rule and are a lex
// error here.
fn apply_emit<K>(e: Emit<K>, text: str, value: TokenValue, span: Span) -> K!LexError {
    // A matcher either hands over a computed value (a delimited string, already
    // stripped) or nothing; take the stripped string when present, else the raw
    // matched text. One content string, so `Of`/`Try` serve every matcher.
    let content = match (value) {
        StrVal(s) => s,
        NoValue => text,
    };
    match (e) {
        Bare(k) => ok(k),
        Of(f) => ok(f(content)),
        OfSeg(f) => err(seg_only(span)),
        // A fallible emit yields `K!str` — a kind or an error *message*; pair the
        // message with the token's `span` to make the `LexError` the lexer
        // surfaces. (Inlined rather than a helper: the checker can't infer the
        // helper's `K` from a bare type-parameter argument.)
        Try(f) => match (f(content)) {
            ok(k) => ok(k),
            err(message) => err(LexError { message, span }),
        },
        TrySeg(f) => err(seg_only(span)),
    }
}

// A `LexError` for a segment emit (`OfSeg`/`TrySeg`) used on a non-`Template`
// rule — those only make sense per template segment (see `seg_emit`).
fn seg_only(span: Span) -> LexError {
    LexError { message: "an OfSeg/TrySeg emit is only valid on a Template rule", span }
}

// One lexing step's outcome: the token(s) the winning rule produced — one
// usually, none for a `skip` rule, a whole head/expr/middle/tail run for a
// `Template` — any trivia recorded along the way, and the position just past
// the consumed text. `end` staying at the step's start means no rule matched.
struct StepResult<K> { tokens: Token<K>[], trivia: Token<K>[], end: i64 }

// A simple (single-token) matcher's outcome: a decline when the matched
// length `n` is 0, otherwise `n` chars consumed producing the rule's one
// token — recorded as trivia for a `trivia` rule, or nothing at all for a
// `skip` rule. The token's kind comes from the rule's `emit` applied to the
// matcher-computed value, which can fail on an emit/value-shape mismatch.
fn step_result<K>(r: TokenRule<K>, src: str, at: i64, n: i64) -> StepResult<K>!LexError {
    if (n == 0 || r.skip) {
        return ok(StepResult { tokens: [], trivia: [], end: at + n });
    };
    let text = src[at..at + n];
    let v = token_value(r.matcher, text);
    let kind = apply_emit(r.emit, text, v, at..at + n)?;
    let t = Token { kind, span: at..at + n };
    if (r.trivia) {
        return ok(StepResult { tokens: [], trivia: [t], end: at + n });
    };
    ok(StepResult { tokens: [t], trivia: [], end: at + n })
}

// One lexing step at absolute position `at`: tries each rule in order (first
// match wins) and returns the winning rule's outcome — see `StepResult`. Every
// arm but `Template` computes how far its matcher reaches (0 for no match — no
// matcher matches empty input, so a nonzero length always means progress) and
// wraps it via `step_result`; a `Template`'s multi-token run doesn't fit a single
// length, so its arm builds the outcome directly. Mutually recursive with
// `template_scan`: an interpolation re-enters this full rule set, so template
// literals nest.
fn lex_step<K>(src: str, at: i64, rules: TokenRule<K>[]) -> StepResult<K>!LexError {
    for (let r : rules) {
        let res = match (r.matcher) {
            CharRun(first, cont) => step_result(r, src, at, src[at..].char_run_len(first, cont))?,
            Exact(spelling) => step_result(r, src, at, src[at..].exact_len(spelling))?,
            Keyword(spelling, boundary) => step_result(
                r,
                src,
                at,
                src[at..].keyword_len(spelling, boundary),
            )?,
            Delimited(delims, escapes) => step_result(
                r,
                src,
                at,
                src[at..].delimited_len(at, delims, escapes, r.unterminated)?,
            )?,
            Between(open, close) => step_result(
                r,
                src,
                at,
                src[at..].between_len(at, open, close, r.unterminated)?,
            )?,
            Nested(open, close) => step_result(
                r,
                src,
                at,
                src[at..].nested_len(at, open, close, r.unterminated)?,
            )?,
            Template(delim, escapes, finalize) => template_step(
                src,
                at,
                delim,
                escapes,
                finalize,
                r.emit,
                rules,
                r.unterminated,
            )?,
            ToEol(marker) => step_result(r, src, at, src[at..].to_eol_len(marker))?,
            Float => step_result(r, src, at, src[at..].float_len())?,
            Int => step_result(r, src, at, src[at..].int_len())?,
        };
        if (at < res.end) {
            return ok(res);
        };
    }
    ok(StepResult { tokens: [], trivia: [], end: at })
}

// Apply a `Template` rule's `emit` to one segment's raw text and its position.
// The emit must be an `OfSeg` (or its fallible sibling `TrySeg`) — a template
// produces several kinds per literal, one per segment position, which only a
// segment emit can distinguish; any other option is a lex error. A `TrySeg` that
// returns `err(msg)` carries the segment's `span`.
fn seg_emit<K>(e: Emit<K>, text: str, seg: Seg, span: Span) -> K!LexError {
    match (e) {
        OfSeg(f) => ok(f(text, seg)),
        TrySeg(f) => match (f(text, seg)) {
            ok(k) => ok(k),
            err(message) => err(LexError { message, span }),
        },
        Bare(k) => err(seg_needs_ofseg(span)),
        Of(f) => err(seg_needs_ofseg(span)),
        Try(f) => err(seg_needs_ofseg(span)),
    }
}

fn seg_needs_ofseg(span: Span) -> LexError {
    LexError { message: "a Template rule needs an OfSeg/TrySeg emit", span }
}

// The `Template` arm of `lex_step`'s dispatch: a decline when `src[at..]`
// doesn't open with `delim` (mirroring every other matcher's 0), else the
// literal's whole token run.
fn template_step<K>(
    src: str,
    at: i64,
    delim: str,
    escapes: str,
    finalize: (str[]) -> str[],
    emit: Emit<K>,
    rules: TokenRule<K>[],
    unterminated: str,
) -> StepResult<K>!LexError {
    if (!src[at..].starts_with(delim)) {
        return ok(StepResult { tokens: [], trivia: [], end: at });
    };
    template_scan(src, at, delim, escapes, finalize, emit, rules, unterminated)
}

// `Template`: scans a whole template literal at `at` (the caller verified the
// opening `delim`); the result's tokens are the literal's whole run and its
// `end` sits just past the closing `delim`. A text segment runs until the
// closing `delim` (matched in full, like `Between`) or a `{`, which ends the
// segment and opens an interpolation (see `interp_scan`); head/middle spans
// include their `{`, and the next segment starts just past the interpolation's
// `}`. The text segments are collected first (with their spans and the
// interpolation token runs between them), then handed to `finalize_template` —
// which post-processes them as a group and emits each. A nested template inside
// an interpolation is fully lexed (and its own segments finalized) by the
// recursive `interp_scan`, so each `template_scan` only ever handles its own
// direct segments. `escapes` still governs *scanning* as in `delimited_len`,
// including the hard error on an unknown escape and the dangling backslash
// falling through to run the literal out unterminated.
fn template_scan<K>(
    src: str,
    at: i64,
    delim: str,
    escapes: str,
    finalize: (str[]) -> str[],
    emit: Emit<K>,
    rules: TokenRule<K>[],
    unterminated: str,
) -> StepResult<K>!LexError {
    // Raw text of each segment, its span, and the interpolation run that follows
    // each non-final segment (`interp_runs[k]` comes after segment `k`).
    mut seg_texts = [];
    mut seg_spans = [];
    mut interp_runs = [];
    mut i = at + delim.len();
    mut seg_start = at;
    while (i < src.len()) {
        // The segment's text: past the opening delim for the first segment,
        // from just past the previous interpolation's `}` after — through the
        // current position (a closing delim or an opening `{`), exclusive.
        let text_start = if (seg_texts.len() == 0) { at + delim.len() } else { seg_start };
        if (src[i..].starts_with(delim)) {
            let end = i + delim.len();
            set seg_texts.push(src[text_start..i]);
            set seg_spans.push(seg_start..end);
            return finalize_template(finalize, emit, seg_texts, seg_spans, interp_runs, end);
        };
        let c = src[i].value_or(' '); // in bounds: the loop condition holds
        if (c == '{') {
            set seg_texts.push(src[text_start..i]);
            set seg_spans.push(seg_start..i + 1);
            let interp = interp_scan(src, i + 1, i, rules)?;
            set interp_runs.push(interp);
            set i = interp.end;
            set seg_start = i;
        } else {
            if (c == '\\' && 0 < escapes.len() && i + 1 < src.len()) {
                if (!src[i + 1].is_some_and(|e| escapes.contains(e))) {
                    return err(
                        LexError {
                            message: "unknown escape sequence \\" +++ src[i + 1..i + 2],
                            span: i..i + 2,
                        },
                    );
                };
                set i = i + 2;
            } else {
                set i = i + 1;
            };
        };
    }
    let m = if (unterminated.len() == 0) { "unterminated template literal" } else { unterminated };
    err(LexError { message: m, span: at..src.len() })
}

// Emit a template literal's tokens: apply the caller's `finalize` to all of its
// text segments as a group (it returns one finalized text per segment), then
// emit each finalized segment — its position `Plain` for a lone segment, else
// `Head`/`Middle`/`Tail` — via the rule's `OfSeg`/`TrySeg` emit, interleaved
// with the interpolation token runs (`interp_runs[k]` following segment `k`).
// `end` sits just past the closing delim.
fn finalize_template<K>(
    finalize: (str[]) -> str[],
    emit: Emit<K>,
    seg_texts: str[],
    seg_spans: Span[],
    interp_runs: StepResult<K>[],
    end: i64,
) -> StepResult<K>!LexError {
    let finals = finalize(seg_texts);
    mut toks = [];
    mut trivia = [];
    let n = seg_texts.len();
    mut k = 0;
    while (k < n) {
        // `k` is always in range (0..n), so the `none` fallbacks below are dead.
        let txt = finals[k].value_or("");
        let sp = match (seg_spans[k]) {
            some(s) => s,
            none => 0..0,
        };
        let seg = if (n == 1) {
            Plain
        } else {
            if (k == 0) { Head } else { if (k + 1 == n) { Tail } else { Middle } }
        };
        let kind = seg_emit(emit, txt, seg, sp)?;
        set toks.push(Token { kind, span: sp });

        // The interpolation after segment `k`; an empty run after the final
        // segment, so the loops below are simply skipped there.
        let run = match (interp_runs[k]) {
            some(r) => r,
            none => StepResult { tokens: [], trivia: [], end: 0 },
        };
        for (let t : run.tokens) {
            set toks.push(t);
        }
        for (let t : run.trivia) {
            set trivia.push(t);
        }
        set k = k + 1;
    }
    ok(StepResult { tokens: toks, trivia, end })
}

// A template interpolation's `{ ... }` body: lexes expression tokens with the
// full rule set from `at` (just past the opening `{`, which sits at `open`)
// until the `}` balancing it; that closing `}` is consumed without a token —
// it's the template's delimiter, not an expression token. Depth moves by what
// each step consumed: a step consuming exactly `{` or `}` (a brace lexed as
// its own token — set/dict literals, blocks) raises/lowers it, while a brace
// buried inside a bigger token (a delimited string's content, a nested
// template) doesn't. The result's `end` sits just past the closing `}`.
fn interp_scan<K>(src: str, at: i64, open: i64, rules: TokenRule<K>[]) -> StepResult<K>!LexError {
    mut toks = [];
    mut trivia = [];
    mut depth = 1;
    mut i = at;
    while (0 < depth) {
        if (!(i < src.len())) {
            return err(
                LexError {
                    message: "unterminated template literal interpolation",
                    span: open..open + 1,
                },
            );
        };
        if (depth == 1 && src[i] == some('}')) {
            set depth = 0;
            set i = i + 1;
        } else {
            let step = lex_step(src, i, rules)?;
            if (step.end == i) {
                return err(LexError { message: "unexpected character", span: i..i + 1 });
            };
            for (let t : step.tokens) {
                set toks.push(t);
            }
            for (let t : step.trivia) {
                set trivia.push(t);
            }
            if (src[i..step.end] == "{") {
                set depth = depth + 1;
            };
            if (src[i..step.end] == "}") {
                set depth = depth - 1;
            };
            set i = step.end;
        };
    }
    ok(StepResult { tokens: toks, trivia, end: i })
}

// A concrete token-kind variant for the `.test` block below — one example of
// the per-language `K` a caller pins `Token<K>`/`TokenRule<K>` to. Each arm is a
// kind; value-bearing kinds carry their content (`Int(i64)`, `Str(str)`, the
// template segments), text-recovered kinds are bare (their text is sliced from
// the span). A real consumer writes its own such variant.
variant Kind =
    Ws
    | Ident(str)
    | IntTok(i64)
    | Digits
    | Op
    | Kw
    | Punct
    | Dot
    | FloatTok
    | Str(str)
    | Raw(str)
    | Block(str)
    | Comment
    | Allow
    | Tpl(str)
    | TplHead(str)
    | TplMid(str)
    | TplTail(str)
    | RawTpl(str)
    | RawTplHead(str)
    | RawTplMid(str)
    | RawTplTail(str)

// The `.test` block's template `OfSeg` emit: the library hands each segment's
// *raw* text, so this emit decodes it (with the imported `unescape`) before
// mapping to a `Kind` arm — escape handling is the caller's job.
fn tpl_kind(text: str, seg: Seg) -> Kind {
    let t = text.unescape();
    match (seg) {
        Plain => Tpl(t),
        Head => TplHead(t),
        Middle => TplMid(t),
        Tail => TplTail(t),
    }
}

// The `Of` emit for the escaped-string test below: the library hands the raw
// (un-decoded) delimiter-stripped contents, so the emit decodes them itself.
fn esc_str(text: str) -> Kind { Str(text.unescape()) }

// The `Try` emit for the `Int` test below: the library hands the raw digit
// run, so this emit parses it — here with the `int_parse` builtin, reporting an
// i64 overflow as an error *message* (the library attaches the token's span).
// Parsing policy, and what overflow means, is the caller's — a bignum lexer would
// parse into a wide type and never fail here.
fn int_tok(text: str) -> Kind!str {
    match (text.int_parse()) {
        some(v) => ok(IntTok(v)),
        none => err("integer literal overflows i64"),
    }
}

// A `Try` emit: the escaped-string decoder above, plus a content rule the
// caller enforces — a string literal may not be empty. A whole-token verdict, so
// the token's span is the right place for the error.
fn nonempty_str(text: str) -> Kind!str {
    let s = text.unescape();
    if (s.len() == 0) { err("empty string literal") } else { ok(Str(s)) }
}

// A `TrySeg` emit: like `tpl_kind`, but the caller rejects a `TODO` segment. The
// error carries the whole template's span.
fn checked_seg(text: str, seg: Seg) -> Kind!str {
    if (text == "TODO") { err("TODO segment not allowed") } else { ok(tpl_kind(text, seg)) }
}

fn rawtpl_kind(text: str, seg: Seg) -> Kind {
    match (seg) {
        Plain => RawTpl(text),
        Head => RawTplHead(text),
        Middle => RawTplMid(text),
        Tail => RawTplTail(text),
    }
}

// Test-block shorthands over the concrete `Kind` (each kind arm carries its own
// content): an expected token, and a token-only result (no trivia).
fn tok(kind: Kind, start: i64, end: i64) -> Token<Kind> { Token { kind, span: start..end } }

fn toks(tokens: Token<Kind>[]) -> LexResult<Kind> { LexResult { tokens, trivia: [] } }

pub fn lex<K>(self: str, rules: TokenRule<K>[]) -> LexResult<K>!LexError {
    mut tokens = [];
    mut trivia = [];
    mut pos = 0;
    while (pos < self.len()) {
        let step = lex_step(self, pos, rules)?;
        if (step.end == pos) {
            // No rule matched: a lex error at the offending byte (slice the
            // source with the span to show it).
            return err(LexError { message: "unexpected character", span: pos..pos + 1 });
        };
        for (let t : step.tokens) {
            set tokens.push(t);
        }
        for (let t : step.trivia) {
            set trivia.push(t);
        }
        set pos = step.end;
    }
    ok(LexResult { tokens, trivia })
}.doc("""
    Lexes `self` into a `LexResult`: the flat token list, plus the trivia
    side-channel, as described by the ordered `rules`. At each position the
    first rule whose matcher matches claims the token (so order is priority —
    keywords before identifiers, floats before ints); a `skip: true` rule
    consumes its match without producing anything (whitespace), and a
    `trivia: true` rule records its matches in the side-channel instead of
    the token stream (comments, lint markers). A `Template` rule emits
    several tokens per literal — head/middle/tail segments around the tokens
    of each `{...}` interpolation, which are lexed by this same rule set.
    Lexing fails with
    an `err` — a `LexError` carrying a message and the offending span — when
    a byte matches no rule or a matcher sees invalid input outright (an
    unterminated `Delimited` token).
""").test({
    // Character classes shared across the rule sets below.
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_";
    let alnum = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789";

    // Reusable rules. Each pairs a matcher with an `emit` that builds a `Kind`:
    // `Of` applies a constructor to the token's content (stripped for a delimited
    // matcher, raw text otherwise); `Bare` is a fixed kind; a skip rule's emit is
    // never applied.
    let ws = TokenRule { matcher: CharRun(" \t\n\r", " \t\n\r"), emit: Bare(Ws), skip: true };
    let ident = TokenRule { matcher: CharRun(alpha, alnum), emit: Of(Ident) };
    let digits = TokenRule { matcher: CharRun("0123456789", "0123456789"), emit: Bare(Digits) };
    let base = [ws, ident, digits];

    // Empty / all-whitespace input produces no tokens.
    assert(lex("", base)? == toks([]));
    assert(lex(" \t\n\r ", base)? == toks([]));

    // Each kind is a variant arm carrying its content: an identifier holds its
    // text, and its span still slices the same text from the source.
    assert(lex("foo", base)? == toks([tok(Ident("foo"), 0, 3)]));
    assert(lex("x1", base)? == toks([tok(Ident("x1"), 0, 2)]));
    assert(lex("1x", base)? == toks([tok(Digits, 0, 1), tok(Ident("x"), 1, 2)]));
    assert(lex("  hi  ", base)? == toks([tok(Ident("hi"), 2, 4)]));

    // A byte no rule matches is a lex error carrying that byte's span.
    assert(lex("a+1", base) == err(lex_err("unexpected character", 1, 2)));
    match (lex("a+1", base)) {
        ok(ts) => assert(false),
        err(e) => assert("a+1"[e.span] == "+"),
    };

    // Exact: one spelling per rule. Ordering the rules longest-first makes the
    // longer spelling win where they share a prefix (`==`/`=>` before `=`) —
    // rule order is the priority mechanism, so no per-rule spelling set is needed.
    let ops = [
        ws,
        TokenRule { matcher: Exact("=="), emit: Bare(Op) },
        TokenRule { matcher: Exact("=>"), emit: Bare(Op) },
        TokenRule { matcher: Exact("="), emit: Bare(Op) },
        ident,
    ];
    assert(lex("===", ops)? == toks([tok(Op, 0, 2), tok(Op, 2, 3)]));
    assert(lex("a=b", ops)? == toks([tok(Ident("a"), 0, 1), tok(Op, 1, 2), tok(Ident("b"), 2, 3)]));
    assert(lex("+", ops) == err(lex_err("unexpected character", 0, 1)));

    // Keyword: a spelling matches only at an identifier boundary. One spelling
    // per rule, as with `Exact`; order among keyword rules is immaterial (the
    // boundary check, not order, keeps `if` out of `iffy`).
    let kw_if = TokenRule { matcher: Keyword("if", alnum), emit: Bare(Kw) };
    let kw_let = TokenRule { matcher: Keyword("let", alnum), emit: Bare(Kw) };
    let kws = [ws, kw_if, kw_let, ident];
    assert(lex("iffy", kws)? == toks([tok(Ident("iffy"), 0, 4)]));
    assert(lex("if fy", kws)? == toks([tok(Kw, 0, 2), tok(Ident("fy"), 3, 5)]));
    assert(lex("if", kws)? == toks([tok(Kw, 0, 2)]));

    // Delimited: an `Of` emit carries the delimiter-stripped contents, left
    // *un-decoded* — with escapes off ("") that's the whole content verbatim, and
    // here none of the inputs carry a backslash so `Of(Str)` needs no decoding.
    // An unterminated token is a hard error at its open delimiter.
    let strs = [ws, TokenRule { matcher: Delimited("\"'", ""), emit: Of(Str) }, ident];
    assert(lex("\"hi\" x", strs)? == toks([tok(Str("hi"), 0, 4), tok(Ident("x"), 5, 6)]));
    assert(lex("''", strs)? == toks([tok(Str(""), 0, 2)]));
    assert(lex("\"hi", strs) == err(lex_err("unterminated delimited token", 0, 3)));

    // With escapes on, `escapes` still governs scanning (an unknown escape is a
    // hard error), but *decoding* is the emit's job: `esc_str` calls `unescape`.
    let esc = [ws, TokenRule { matcher: Delimited("\"", "nt\\\""), emit: Of(esc_str) }, ident];
    assert(lex("\"a\\\"b\"", esc)? == toks([tok(Str("a\"b"), 0, 6)]));
    assert(lex("\"a\\nb\"", esc)? == toks([tok(Str("a\nb"), 0, 6)]));
    assert(lex("\"a\\xb\"", esc) == err(lex_err("unknown escape sequence \\x", 2, 4)));

    // Try: a fallible string emit. `nonempty_str` decodes, then enforces a
    // content rule the *caller* owns — an empty string literal is an error whose
    // message the library pairs with the token's span. A well-formed one passes.
    let nes = [
        ws,
        TokenRule { matcher: Delimited("\"", "nt\\\""), emit: Try(nonempty_str) },
        ident,
    ];
    assert(lex("\"hi\"", nes)? == toks([tok(Str("hi"), 0, 4)]));
    assert(lex("\"\"", nes) == err(lex_err("empty string literal", 0, 2)));

    // Between: a raw string `"""..."""` — a lone `"`/`""` inside is content.
    let q3 = "\"\"\"";
    let raw = [ws, TokenRule { matcher: Between(q3, q3), emit: Of(Raw) }, ident];
    assert(lex("\"\"\"a\"b\"\"c\"\"\"", raw)? == toks([tok(Raw("a\"b\"\"c"), 0, 12)]));
    assert(lex("\"\"\"hi\"\"", raw) == err(lex_err("unterminated delimited token", 0, 7)));

    // Nested: depth-tracked block comments — an inner `/* */` doesn't close the
    // outer. On the same input `Between` (`blk`) stops at the first `*/`.
    let nest = [ws, TokenRule { matcher: Nested("/*", "*/"), emit: Of(Block) }, ident];
    let blk = [ws, TokenRule { matcher: Between("/*", "*/"), emit: Of(Block) }, ident];
    assert(
        lex("/* a /* b */ c */x", nest)? == toks(
            [tok(Block(" a /* b */ c "), 0, 17), tok(Ident("x"), 17, 18)],
        ),
    );
    assert(lex("/* a /* b */", nest) == err(lex_err("unterminated delimited token", 0, 12)));
    assert(lex("/* a /* b */", blk)? == toks([tok(Block(" a /* b "), 0, 12)]));

    // Char literals are not a library matcher: a consumer lexes one as a
    // single-quoted `Delimited` string and enforces the one-char shape in a
    // `Try` emit (see `lex_aipl.aipl`'s `char_lit_emit`). The `Delimited`
    // single-quote scan and the `Try` one-char verdict are exercised by the
    // string tests above and the `nonempty_str` test below.

    // Int: one matcher for both unsigned and signed literals — a digit run with an
    // *optional* leading `-`. The `Try` emit (`int_tok`) parses it; overflow is a
    // lex error the *caller* decides (the library just attaches the span), so a
    // bignum lexer never fails here.
    let minus = TokenRule { matcher: Exact("-"), emit: Bare(Op) };
    let ints = [ws, TokenRule { matcher: Int, emit: Try(int_tok) }, ident, minus];
    assert(lex("42", ints)? == toks([tok(IntTok(42), 0, 2)]));
    assert(lex("0 7", ints)? == toks([tok(IntTok(0), 0, 1), tok(IntTok(7), 2, 3)]));
    assert(
        lex("9223372036854775808", ints) == err(lex_err("integer literal overflows i64", 0, 19)),
    );

    // `-` glued to digits → one signed literal, wherever it appears (the `Int`
    // rule is before the `-` operator rule).
    assert(lex("-5", ints)? == toks([tok(IntTok(-5), 0, 2)]));
    assert(lex("a -5", ints)? == toks([tok(Ident("a"), 0, 1), tok(IntTok(-5), 2, 4)]));

    // A space after `-` makes `Int` decline, so the operator rule claims the `-`
    // and the digits are a separate `Int`: `- 5` is the operator, `-5` isn't.
    assert(
        lex("a - 5", ints)? == toks([tok(Ident("a"), 0, 1), tok(Op, 2, 3), tok(IntTok(5), 4, 5)]),
    );
    assert(
        lex("5 - 3", ints)? == toks([tok(IntTok(5), 0, 1), tok(Op, 2, 3), tok(IntTok(3), 4, 5)]),
    );

    // `-` before a non-digit (a letter) also declines → the operator rule takes it
    // and the letters are a separate identifier (so a consumer gets unary `-x`).
    assert(lex("-b", ints)? == toks([tok(Op, 0, 1), tok(Ident("b"), 1, 2)]));

    // Optional sign reaches the full range: i64::MIN parses (a positive run of the
    // same magnitude would overflow), one past it does not.
    assert(
        lex("-9223372036854775808", ints)? == toks(
            [tok(IntTok(0 - 9223372036854775807 - 1), 0, 20)],
        ),
    );
    assert(
        lex("-9223372036854775809", ints) == err(lex_err("integer literal overflows i64", 0, 20)),
    );

    // The rule composes anywhere the full rule set runs, including a template
    // interpolation.
    let tpls_signed = [
        ws,
        TokenRule { matcher: Template("`", "\\`{ntr", |segs: str[]| segs), emit: OfSeg(tpl_kind) },
        TokenRule { matcher: Int, emit: Try(int_tok) },
        ident,
        digits,
        minus,
    ];
    assert(
        lex("`v{-5}`", tpls_signed)? == toks(
            [tok(TplHead("v"), 0, 3), tok(IntTok(-5), 3, 5), tok(TplTail(""), 6, 7)],
        ),
    );

    // Float before int: a fraction/exponent extends a digit run; a bare run
    // falls through to the digit rule.
    let dot = TokenRule { matcher: Exact("."), emit: Bare(Dot) };
    let flt = [ws, TokenRule { matcher: Float, emit: Bare(FloatTok) }, digits, ident, dot];
    assert(lex("1.5e-3", flt)? == toks([tok(FloatTok, 0, 6)]));
    assert(lex("1.", flt)? == toks([tok(Digits, 0, 1), tok(Dot, 1, 2)]));

    // Template: `text {expr} text`. `OfSeg` maps each segment's decoded text and
    // position (`Plain`/`Head`/`Middle`/`Tail`) to a `Kind` arm.
    let tpl = TokenRule {
        matcher: Template("`", "\\`{ntr", |segs: str[]| segs),
        emit: OfSeg(tpl_kind),
    };
    let tpls = [ws, tpl, ident, digits];
    assert(lex("`hi`", tpls)? == toks([tok(Tpl("hi"), 0, 4)]));
    assert(
        lex("`a{x}b`", tpls)? == toks(
            [tok(TplHead("a"), 0, 3), tok(Ident("x"), 3, 4), tok(TplTail("b"), 5, 7)],
        ),
    );
    assert(
        lex("`{x}{y}`", tpls)? == toks(
            [
                tok(TplHead(""), 0, 2),
                tok(Ident("x"), 2, 3),
                tok(TplMid(""), 4, 5),
                tok(Ident("y"), 5, 6),
                tok(TplTail(""), 7, 8),
            ],
        ),
    );
    // Text escapes: `\{` doesn't interpolate; an unknown escape is a hard error.
    assert(lex("`a\\{b`", tpls)? == toks([tok(Tpl("a{b"), 0, 6)]));
    assert(lex("`a\\qb`", tpls) == err(lex_err("unknown escape sequence \\q", 2, 4)));
    assert(lex("`ab", tpls) == err(lex_err("unterminated template literal", 0, 3)));
    assert(lex("`a{x", tpls) == err(lex_err("unterminated template literal interpolation", 2, 3)));
    // Brace depth: braces lexed as their own tokens inside an interpolation nest.
    let lbrace = TokenRule { matcher: Exact("{"), emit: Bare(Punct) };
    let rbrace = TokenRule { matcher: Exact("}"), emit: Bare(Punct) };
    let tplb = [ws, tpl, lbrace, rbrace, ident, digits];
    assert(
        lex("`a{ {x} }b`", tplb)? == toks(
            [
                tok(TplHead("a"), 0, 3),
                tok(Punct, 4, 5),
                tok(Ident("x"), 5, 6),
                tok(Punct, 6, 7),
                tok(TplTail("b"), 9, 11),
            ],
        ),
    );
    // Templates nest: an inner template between head and tail.
    assert(
        lex("`a{`x`}b`", tpls)? == toks(
            [tok(TplHead("a"), 0, 3), tok(Tpl("x"), 3, 6), tok(TplTail("b"), 7, 9)],
        ),
    );
    // A raw-template delim scans like `Between` and `""` escapes make it verbatim.
    let raw3 = TokenRule {
        matcher: Template("```", "", |segs: str[]| segs),
        emit: OfSeg(rawtpl_kind),
    };
    let tpl2 = [ws, raw3, tpl, ident, digits];
    assert(lex("```a`b\\c```", tpl2)? == toks([tok(RawTpl("a`b\\c"), 0, 11)]));
    assert(
        lex("```a{x}b```", tpl2)? == toks(
            [tok(RawTplHead("a"), 0, 5), tok(Ident("x"), 5, 6), tok(RawTplTail("b"), 7, 11)],
        ),
    );

    // TrySeg: a fallible segment emit (`checked_seg`) validates each segment; a
    // rejected one aborts the lex with the template's span.
    let tseg = TokenRule {
        matcher: Template("`", "\\`{ntr", |segs: str[]| segs),
        emit: TrySeg(checked_seg),
    };
    let tsegs = [ws, tseg, ident, digits];
    assert(lex("`hi`", tsegs)? == toks([tok(Tpl("hi"), 0, 4)]));
    assert(lex("`TODO`", tsegs) == err(lex_err("TODO segment not allowed", 0, 6)));

    // Trivia: a `trivia: true` rule is consumed like a skip rule, but each match
    // is recorded in the result's side-channel, out of the token stream.
    let cmt_t = TokenRule { matcher: ToEol("//"), emit: Bare(Comment), trivia: true };
    let allow_t = TokenRule { matcher: Exact("#[allow]"), emit: Bare(Allow), trivia: true };
    let trv = [ws, cmt_t, allow_t, ident, digits];
    assert(
        lex("a #[allow] // b\nc", trv)? == LexResult {
            tokens: [tok(Ident("a"), 0, 1), tok(Ident("c"), 16, 17)],
            trivia: [tok(Allow, 2, 10), tok(Comment, 11, 15)],
        },
    );
    // Trivia inside a template interpolation rides up through the scan.
    let trvt = [ws, cmt_t, tpl, ident, digits];
    assert(
        lex("`a{x // c\n}b`", trvt)? == LexResult {
            tokens: [tok(TplHead("a"), 0, 3), tok(Ident("x"), 3, 4), tok(TplTail("b"), 11, 13)],
            trivia: [tok(Comment, 5, 9)],
        },
    );

    // ToEol with skip: comments are dropped like whitespace.
    let cmt = [ws, TokenRule { matcher: ToEol("//"), emit: Bare(Comment), skip: true }, ident];
    assert(lex("a // b\nc", cmt)? == toks([tok(Ident("a"), 0, 1), tok(Ident("c"), 7, 8)]));
    assert(lex("// only", cmt)? == toks([]));

    // --- Rule sets resembling real languages. ---

    // JSON: strings, numbers, keywords, punctuation.
    let json = [
        ws,
        TokenRule { matcher: Delimited("\"", "\"\\/bfnrtu"), emit: Of(Str) },
        TokenRule { matcher: Float, emit: Bare(FloatTok) },
        TokenRule { matcher: Int, emit: Try(int_tok) },
        TokenRule { matcher: Keyword("true", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("false", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("null", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Exact("{"), emit: Bare(Punct) },
        TokenRule { matcher: Exact("}"), emit: Bare(Punct) },
        TokenRule { matcher: Exact("["), emit: Bare(Punct) },
        TokenRule { matcher: Exact("]"), emit: Bare(Punct) },
        TokenRule { matcher: Exact(":"), emit: Bare(Punct) },
        TokenRule { matcher: Exact(","), emit: Bare(Punct) },
        TokenRule { matcher: Exact("-"), emit: Bare(Punct) },
    ];
    let jsrc = """{"pi": 3.14, "n": [1, true]}""";
    let jtoks = [
        tok(Punct, 0, 1),
        tok(Str("pi"), 1, 5),
        tok(Punct, 5, 6),
        tok(FloatTok, 7, 11),
        tok(Punct, 11, 12),
        tok(Str("n"), 13, 16),
        tok(Punct, 16, 17),
        tok(Punct, 18, 19),
        tok(IntTok(1), 19, 20),
        tok(Punct, 20, 21),
        tok(Kw, 22, 26),
        tok(Punct, 26, 27),
        tok(Punct, 27, 28),
    ];
    assert(lex(jsrc, json)? == toks(jtoks));

    // AIPL: keywords, multi-byte operators, strings, skipped line comments.
    let aipl = [
        ws,
        TokenRule { matcher: ToEol("//"), emit: Bare(Comment), skip: true },
        TokenRule { matcher: Keyword("fn", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("let", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("mut", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("set", alnum), emit: Bare(Kw) },
        ident,
        TokenRule { matcher: Int, emit: Try(int_tok) },
        TokenRule { matcher: Delimited("\"", "ntr\\\""), emit: Of(Str) },
        TokenRule { matcher: Exact("=="), emit: Bare(Op) },
        TokenRule { matcher: Exact("->"), emit: Bare(Op) },
        TokenRule { matcher: Exact("&&"), emit: Bare(Op) },
        TokenRule { matcher: Exact("="), emit: Bare(Op) },
        TokenRule { matcher: Exact(";"), emit: Bare(Op) },
    ];
    let asrc = "let ok = s == \"hi\"; // check";
    let atoks = [
        tok(Kw, 0, 3),
        tok(Ident("ok"), 4, 6),
        tok(Op, 7, 8),
        tok(Ident("s"), 9, 10),
        tok(Op, 11, 13),
        tok(Str("hi"), 14, 18),
        tok(Op, 18, 19),
    ];
    assert(lex(asrc, aipl)? == toks(atoks));
})
