# A small library for building lexers. `lex` turns source text into a flat
# `Token[]`, driven by an ordered `TokenRule[]` describing the language being
# lexed. Each rule pairs a caller-chosen `kind` label with a `Matcher` — a
# data-only description of one token shape (a char-class run, a list of fixed
# spellings, a delimited literal, ...) — so a rule set is plain data and one
# `lex` serves many languages; see the JSON and AIPL-flavored rule sets in the
# tests. At each position the *first* rule whose matcher matches wins, so
# order is priority: put keywords before identifiers, floats before ints.
# Whitespace is an ordinary rule marked `skip: true` — matched and consumed,
# but producing nothing. Rules marked `trivia: true` (comments, lint markers)
# are consumed the same way but recorded in the result's trivia side-channel,
# so a formatter or lint pass can find them without them cluttering the token
# stream. Lexing can fail: a byte no rule matches, or a matcher that matches
# invalid input outright (an unterminated `Delimited` token), aborts the lex
# with a `LexError` — a message plus the span of the offending source.

import {
    Span,
    any,
    count_while,
    drop_first,
    drop_last,
    equal as ==,
    filter,
    first,
    has,
    int_parse,
    is_digit,
    is_empty,
    is_err_and,
    is_nonempty,
    is_some_and,
    last,
    len,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    map_err,
    not_equal as !=,
    push,
    starts_with,
    starts_with_at,
    to_set,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_add_assign as +=,
    wrapping_decrement as --,
    wrapping_increment as ++,
    wrapping_sub as -,
} from builtins;
// The `.test` block's decoding emits need a string-escape decoder. The library
// deliberately provides none (escape meaning is a language's policy), so the
// test borrows AIPL's own — the same `unescape` the real lexer uses — rather
// than keeping a second copy in sync.
import { unescape } from "./unescape.aipl";

# Matched text together with where it was matched: the two halves every
# consumer of a token needs, carried in one value so they cannot be separated.
#
# A `SpanStr` is built by `span_str` and nothing else, which is what makes its
# one invariant hold: **`text` is exactly `src[span]`** for the source it was
# sliced from. Consumers rely on that in both directions — a diagnostic renders
# `span` against the source it already has, and a parser reads `text` without
# needing the source at all.
#
# It is a plain struct, not a language feature: `str` alone cannot carry the
# offset (a `str` is text, and two equal strings from different places are
# equal), so the span rides alongside. That costs 16 bytes over a bare `str`,
# and buys every function downstream one parameter instead of two.
struct SpanStr { text: str, span: Span }

# `src[at]` paired with `at` — the only way a `SpanStr` is made, so its
# text-matches-span invariant holds by construction. Slicing clamps, so an
# out-of-range or inverted `at` yields the empty text rather than failing;
# `span` is kept verbatim either way, since it is what a caret block underlines.
pub fn span_str(src: str, at: Span) -> SpanStr { text: src[at], span: at }.test({
    let src = "let x = 42;";
    assert(span_str(src, 0..3).text == "let");
    assert(span_str(src, 0..3).span == 0..3);
    assert(span_str(src, 8..10).text == "42");

    // The whole source, and the empty slice at either end — both are ordinary
    // spans, and the empty one is what a parser reports at end of input.
    assert(span_str(src, 0..src.len()).text == src);
    assert(span_str(src, 0..0).text == "");
    assert(span_str(src, src.len()..src.len()).text == "");

    // Out of range and inverted clamp like any slice, and the span is still
    // reported as asked — a diagnostic underlines what the caller meant.
    assert(span_str(src, 99..200).text == "");
    assert(span_str(src, 99..200).span == 99..200);
    assert(span_str(src, 5..2).text == "");
    assert(span_str("", 0..0) == SpanStr { text: "", span: 0..0 });

    // The invariant, stated as a test: the text is always the source slice.
    for (let sp : [0..0, 0..1, 4..5, 3..8, 0..src.len()]) {
        assert(span_str(src, sp).text == src[sp]);
    }
})

# What a token is: its `kind` — a caller-defined value carrying whatever the
# matched token means, produced by the rule's `emit` (see `Emit`) — and its
# `text`, the raw source it covers plus the span it covers (see `SpanStr`).
# A language pins `K` to its own `variant` whose arms *are* the token kinds,
# each carrying that kind's content (`Int(i64)`, `Str(str)`, a bare `Plus`, …) —
# rather than a stringly-typed label plus a separate value.
#
# The text is carried rather than recovered by slicing (`src[t.span]`, as it
# used to be) so that holding a token is enough: a parser does not thread the
# source alongside its token list just to read a token back.
struct Token<K> { kind: K, text: SpanStr }

# How a rule turns its matched token into a kind `K`: a fixed set of options.
#
# Four of the five are handed the token's *content string* — the
# delimiter-stripped text for a string matcher (`Delimited`/`Between`/`Nested`),
# or the raw matched text for everything else (identifiers, whose text is their
# content, and numeric `Int`/`Float` runs, whose emit parses the digits itself).
# The two never overlap — a matcher either strips delimiters or has none — so
# one notion serves both, always handing over the meaningful content.
variant Emit<K> =
    # A finished kind for a valueless token: punctuation, an operator.
    | Bare(K)
    # Applies a constructor to the token's content string.
    | Of((str) -> K)
    # `Of`'s fallible sibling: the function returns `K!str` — a kind, or an
    # error *message*. Interpreting a match can fail (a numeric literal that
    # overflows i64, a single-quoted string that isn't exactly one char), and on
    # `err(msg)` the library pairs the message with the token's whole span to
    # build a `LexError` (see `apply_emit`). The token span is the right
    # location for a whole-token verdict like overflow; a matcher-level,
    # byte-precise error (an unterminated string, an unknown escape) still comes
    # from scanning, not the emit.
    | Try((str) -> K!str)

# Why a lex failed: what went wrong, and the span of the offending source
# (absolute into the lexed string — slice it to show the offender).
struct LexError { message: str, span: Span }

# One token shape, as plain data. Char classes and fixed spellings are both
# spelled as strings (class membership via `contains`, a spelling matched
# whole); none of them ever match empty input, so `lex` always makes progress.
#
# Every token has a *content string*, and that is what its rule's `emit` is
# handed (see `token_content`): the raw matched text, except for the three
# matchers that bracket their content, which strip their delimiters first.
# `Delimited` strips to the contents *un-decoded* (the rule's `emit` decodes —
# escape handling is the caller's, not the library's); `Between`/`Nested` strip
# to the contents verbatim (a raw string's de-denting is the caller's
# post-pass). Everything else — identifiers, punctuation, keywords, the
# `Int`/`Float` digit runs, every trivia record — is its own text, which an `Of`
# emit interprets. That is why a numeric literal's *parsing* is the rule's
# `emit`'s job, via the `int_parse` builtin or its own. The library provides no
# string-escape decoder: what a `\X` means is a language's own policy, so a
# consumer's `emit` decodes with its own (e.g. `lex_aipl.aipl`'s `unescape`,
# mapping `\n`/`\t`/`\r` to control chars and any other `\X` to X itself). A
# char literal is likewise not a matcher: a consumer lexes it as a single-quoted
# `Delimited` string and enforces the one-char shape in a `Try` emit (see
# `lex_aipl.aipl`'s `char_lit_emit`).
variant Matcher =
    # A maximal run of chars in `cont`. `first` restricts what may *open* the
    # run and defaults to `cont`, so the usual shape — one class for the whole
    # token — is a single argument (`CharRun(digits)`, and whitespace runs),
    # and only a narrower opener is worth naming
    # (`CharRun(alnum, first = alpha)`: an identifier may not start with a
    # digit).
    | CharRun(cont: #{char}, first: #{char} = cont)
    # Exactly one char, any of `chars`. Single-character punctuation, where one
    # rule stands for a whole class of one-char tokens (`OneChar("()[],;")`)
    # instead of an `Exact` rule apiece. It is the direct concept a `CharRun`
    # cannot state: a run needs something to continue with, so "exactly one"
    # would have to be spelled as a run that can never extend.
    | OneChar(#{char})
    # The given spelling, verbatim. Punctuation and operators — one spelling
    # per rule; when spellings share a prefix, order the rules longest first
    # (`==` before `=`), since rule order is the priority mechanism (a single
    # rule matching a set, with its own longest-wins, would duplicate that
    # ordering as a second mechanism).
    | Exact(str)
    # Like `Exact`, but the spelling only matches when the char after it is
    # absent or outside `boundary` (the identifier continue class) — so a
    # keyword rule placed before the identifier rule claims `if` without biting
    # the front off `iffy`. One spelling per rule, as with `Exact`; a shared
    # prefix (`in`/`int`) is resolved by the boundary check, not rule order, so
    # order among keyword rules doesn't matter.
    | Keyword(str, #{char})
    # A char in `delims` opens the token, which runs to just past the next
    # occurrence of the *same* char. `escapes` is the set of chars that may
    # follow a backslash inside the token: `\` plus an allowed char is content
    # (in particular an escaped delimiter does not close), `\` plus anything
    # else is a lex error, and `#{}` turns escape handling off entirely (a
    # backslash is ordinary content). A token still open at the end of the
    # source is a lex error. String literals. `escapes` governs *scanning* only
    # — the token's value is the delimiter-stripped text left *un-decoded*, so
    # the rule's `emit` decides what escapes mean, with its own decoder (the
    # library provides none — escape semantics are the language's).
    | Delimited(#{char}, escaped: #{char} = #{})
    # The `open` spelling opens the token, which runs to just past the next
    # *full* occurrence of the `close` spelling. Unlike `Delimited`, open and
    # close are multi-char and may differ, and the scan matches the whole
    # `close` — so a partial close inside (a lone `"` or `""` under a `"""`
    # close) is ordinary content. Contents are verbatim (no escape processing),
    # which is what raw strings `"""..."""` and non-nesting block comments
    # `/* ... */` want. Both spellings must be non-empty. A token still open at the
    # end of the source is a lex error.
    | Between(str, str)
    # Like `Between`, but depth-tracked — each further `open` inside raises the
    # nesting depth and the matching `close` lowers it, so the token ends only
    # at the `close` that balances the outermost `open`. Rust-style nesting
    # block comments `/* ... /* ... */ ... */`. `open` and `close` must be
    # distinct (a delimiter can't both open and close a level) and non-empty. A
    # token still open (depth > 0) at the end of the source is a lex error.
    | Nested(str, str)
    # A maximal run of text holding none of the `stops` spellings, with `\X`
    # escapes consumed as a unit and checked against `escapes` exactly as
    # `Delimited` does (`#{}` turns escaping off, leaving the run verbatim).
    #
    # The complement of the bracketing matchers: where they are told what encloses
    # a token, this one is told what *ends* it and consumes up to there without
    # consuming the terminator. That is the shape a mode wants — inside a
    # template, text runs until the closing delimiter or the `{` that opens an
    # interpolation, and each of those is a token of its own belonging to another
    # rule.
    #
    # The stops are spellings rather than chars so a multi-char terminator works:
    # a run inside a ```` ``` ```` template stops at the full ```` ``` ```` and a
    # lone backtick stays content, the same distinction `Between` draws.
    #
    # Reaching the end of the source is a match, not an error: an unclosed
    # construct is the *mode's* to report (see `Transition`), and this matcher has
    # no idea what opened the one it is scanning inside of. Like every matcher it
    # declines rather than matching empty, so a stop spelling at the cursor is
    # length 0 — which is exactly right: the rule that matches the terminator is
    # the one that should win there, so order it first.
    | UpToAny(
        stops: str[],
        escapes: #{char},
        # Whether a `\X` whose X is not in `escapes` is a hard error, as in
        # `Delimited`, or ordinary content. Content is what a *verbatim* scan
        # wants: a raw template decodes `\{`/`\}` so a brace can be written
        # without opening an interpolation, and holds every other backslash as
        # written — so it lists those two and refuses nothing.
        refuse_unknown_escape: bool = true
    )
    # The `marker` spelling, then everything up to (not including) the next
    # newline. Line comments — usually `skip: true`.
    | ToEol(str)
    # `marker`, then everything up to (not including) the next newline — but
    # only when the character right after `marker` is *not* in `blocked`. Line
    # comments whose marker is also the start of something else: AIPL's `#`
    # leads a doc comment, and also a set/dict literal (`#{..}`), an ordered
    # set (`#>{..}` / `#<{..}`) and the `#[allow]` lint marker, so
    # `ToEolUnless("#", "{[<>")` claims the comment and leaves the others to
    # the rules that want them.
    #
    # The marker alone at end of line still matches — an empty doc line has no
    # following character to block it, and writing one as `marker` plus a space
    # is not open to a language that forbids trailing whitespace.
    | ToEolUnless(marker: str, blocked: #{char})
    # A digit run that extends past a fraction (`.` plus at least one digit)
    # and/or an exponent (`e`/`E`, an optional sign, at least one digit), JSON
    # style. A bare digit run does *not* match — put a `Float` rule ahead of
    # the int rule and each number lexes as the right one.
    | Float
    # A decimal digit run with an *optional* leading `-` — a distinct matcher
    # because a number is not an identifier, but (like `Float`) it carries no
    # computed value: its text is left *unparsed*, so the rule pairs it with an
    # `Of`/`Try` emit that parses the digits (and any sign) itself (via the
    # `int_parse` builtin, or its own scanner). Parsing — base, digit
    # separators, and what overflow means — is the caller's, not the library's.
    # The `-` is consumed only when a digit *immediately* follows it, so
    # `- 5`/`-x` (a space or a letter after the `-`) don't match and are left for
    # a `-` operator rule. Rule order alone then decides the reading: `Int`
    # before a `-` operator makes `-5` a signed literal (and `a - 5` still
    # subtraction, since the `- 5` there has a space); the operator before
    # `Int` makes every `-` the operator and `Int` unsigned. Scanning the sign
    # *into* the token is also what lets the emit reach the full signed range —
    # an i64's `-9223372036854775808` overflows as a positive literal, so it's
    # only expressible with the `-` and digits together.
    | Int

# What matching a rule does to the lexer's mode stack.
#
# A rule set is otherwise context-free at the token level: the rules are tried in
# order at every position, so the same bytes always lex the same way. That is
# what keeps a rule set plain data — and it is not enough for a language where
# the same bytes mean different things in different places, which is any language
# with string interpolation: in `` `a{x}b` `` the `b` is template text and the
# `x` is an identifier, and only what came before tells them apart.
#
# A **mode** is a named subset of the rules, named by a `u64` the caller assigns.
# The lexer is always in one and only its rules are tried, so a rule can be
# invisible outside the context it belongs to. `Push` enters a mode and `Pop`
# leaves it.
#
# The **stack** is what makes contexts nest. A single "current mode" could say
# where the lexer is but not what it returns to when the context ends; a stack
# answers both, at any depth. `{` inside a template pushes, and the `}` that
# balances it pops back into the template — and a template inside *that*
# interpolation simply pushes again. Nothing here counts depth: the stack is the
# depth.
#
# `Pop` at the base mode stays at the base rather than running off the bottom. A
# stray closer is a syntax error for a parser to report against a token, not a
# lexical one — the lexer's job is to hand over the tokens.
variant Transition = Stay | Push(i64) | Pop

# A rule's `push`/`pop` pair read as the one decision it is. The flags are a pair
# because a struct field's default must be a literal, so a `Transition`
# constructor cannot sit on `TokenRule`; classifying them here means the stack is
# driven by an exhaustive `match` on three cases rather than by two booleans
# checked in the right order at each site. (`Transition? = none` would be legal
# now that a field may be an optional of a variant — `none` is a literal — at the
# cost of an unwrap at each use.)
fn transition(push: i64, pop: bool) -> Transition {
    if (0 <= push) { Push(push) } else { if (pop) { Pop } else { Stay } }
}

# One entry of the mode stack: the mode, where the token that pushed it started,
# and that rule's `unterminated` message. The span and the message are carried so
# that a mode still open at the end of the source is reported against its
# *opener* — which is where a reader has to go to fix it — rather than against
# the whole remaining source.
struct ModeFrame { mode: i64, open: Span, unterminated: str }

# One prioritized entry of a rule set: the shape to match, how to turn a match
# into a kind (`emit`), and what becomes of its matches. A plain rule emits a
# token; `skip: true` consumes matches silently (whitespace); `trivia: true`
# consumes them but records each in the result's trivia side-channel — for
# matches a later pass wants located but not parsed, like comments (a formatter
# re-attaches them) or lint markers (`#[allow]`). Set at most one of the two
# flags (`skip` wins when both are set). Every rule of one set builds the same
# `K`.
# `unterminated` overrides the message used when this rule's token runs off the
# end of the source (a `Delimited`/`Between`/`Nested` scan that never closes), or
# that this rule's mode is still open there (see `Transition`). Empty means "use
# the built-in default" (a generic "unterminated delimited token") — so a rule
# can name its token in the diagnostic (`"unterminated string literal"`) without
# every rule having to.
#
# `mode` and `go` are the rule's place in, and effect on, the lexer's mode stack
# — see `Transition`. A rule set that mentions neither is entirely in the base
# mode, which is how every rule set that predates modes keeps working.
#
# `scope` is the TextMate scope a syntax highlighter should paint this rule's
# matches — `"keyword.control.aipl"`, `"string.quoted.double.aipl"`. `lex`
# ignores it entirely: it is carried here so that one rule set describes a
# language's lexical structure *once*, for the lexer and the highlighter both
# (`highlight.aipl` generates the second from it), rather than the two drifting
# apart as separate descriptions. Empty means "not highlighted", which is what a
# `skip` rule wants. The same hint on the syntactic half is
# `Production.scope` in `grammar.aipl`.
struct TokenRule<K> {
    matcher: Matcher,
    emit: Emit<K>,
    skip: bool = false,
    trivia: bool = false,
    unterminated: str = "",
    scope: str = "",
    // Which mode this rule belongs to — see `Transition`. `0` is the base mode a
    // lex starts in, so a rule set that never mentions modes is entirely in it
    // and behaves exactly as it did before modes existed.
    mode: i64 = 0,
    // What matching this rule does to the mode stack: `push` the mode named, or
    // `pop` the innermost one. A negative `push` is "no push" rather than 0,
    // because 0 is the base mode and pushing it is a real thing to want — it is
    // how a mode re-enters the ordinary rules for a nested construct, the way a
    // template's `{` re-enters them for its interpolation. Set at most one
    // (`push` wins when both are set), the same terms as `skip`/`trivia` above;
    // the pair is read as one decision by `transition`. A `skip` rule
    // transitions too: consuming a match silently and changing mode are
    // independent.
    push: i64 = -1,
    pop: bool = false,
}

# What `lex` returns: the emitted tokens, and the trivia side-channel — the
# recorded matches of every `trivia: true` rule, in source order. Silent
# `skip` matches appear in neither.
struct LexResult<K> { tokens: Token<K>[], trivia: Token<K>[] }

# `self` with every `skip` rule turned into a `trivia` rule: nothing is
# dropped, so every byte of a lexed source is accounted for by some token or
# trivia record.
#
# A compiler's rule set skips whitespace outright — it has no use for it, and
# recording it would cost every consumer something only one of them wants. A
# *lossless* consumer has the opposite need: a parser building a concrete
# syntax tree, or a formatter reproducing its input, must be able to put every
# byte back. Both read the one rule set through this, rather than the language
# keeping two of them.
pub fn keep_skipped<K>(self: TokenRule<K>[]) -> TokenRule<K>[] {
    self.map(|r| if (r.skip) { TokenRule { ..r, skip: false, trivia: true } } else { r })
}.test({
    let ws: TokenRule<Kind> = TokenRule { matcher: CharRun(#{' '}), emit: Bare(Ws), skip: true };
    let word: TokenRule<Kind> = TokenRule { matcher: CharRun(#{'a', 'b'}), emit: Of(Ident) };

    // A rule set holds function values, so two of them cannot be compared with
    // `==` — the assertion is on what they *do*, over one source.
    assert("a b".lex([ws, word])?.trivia.is_empty());
    assert("a b".lex([ws, word].keep_skipped())?.trivia.len() == 1);
    // The tokens are the same either way: only what was dropped changes.
    assert("a b".lex([ws, word])?.tokens.len() == 2);
    assert("a b".lex([ws, word].keep_skipped())?.tokens.len() == 2);

    // And the recorded span is the byte the skipping set threw away.
    let space: Token<Kind>? = "a b".lex([ws, word].keep_skipped())?.trivia[0];
    assert(space.is_some_and(|tr| tr.text.span == 1..2));
})

# `CharRun`: length of the maximal run at the start of `self` — a `head`
# char, then `cont` chars. 0 when the first char isn't in `head`.
# (`head` rather than `first`, which is now a builtin this file calls.)
fn char_run_len(self: str, head: #{char}, cont: #{char}) -> u64 {
    if (self.first().is_some_and(|c| head.has(c))) {
        1 + self.drop_first().count_while(|c| cont.has(c))
    } else {
        0
    }
}

# `OneChar`: 1 when `self` opens with a char in `chars`, else 0 —
# `char_run_len`'s single-character counterpart, and the reason a rule never has
# to spell that shape as a run with nothing to continue it. An empty set never
# matches.
fn one_char_len(self: str, chars: #{char}) -> u64 {
    if (self.first().is_some_and(|c| chars.has(c))) { 1 } else { 0 }
}

# `Exact`: length of `spelling` when it prefixes `self`, else 0. An empty
# spelling never matches.
fn exact_len(self: str, spelling: str) -> u64 {
    if (spelling.is_nonempty() && self.starts_with(spelling)) { spelling.len() } else { 0 }
}

# `Keyword`: the length of `spelling` when it prefixes `self`, but only when the
# char after it is absent (end of source) or outside `boundary` — a keyword must
# not end in the middle of an identifier. 0 when it doesn't match (or the char
# after is a boundary char, as in `iffy` for `if`).
fn keyword_len(self: str, spelling: str, boundary: #{char}) -> u64 {
    let bounded = !self[spelling.len()].is_some_and(|c| boundary.has(c));
    if (spelling.is_nonempty() && bounded && self.starts_with(spelling)) {
        spelling.len()
    } else {
        0
    }
}

# `Delimited`: a `delims` char opens the token, which spans to just past the
# next occurrence of the same char. ok(0) when the first char isn't a
# delimiter. With a non-empty `escapes` set, a backslash escapes its next
# char: an allowed char is content (an escaped delimiter doesn't close), a
# disallowed one is a hard error, and so is a backslash with nothing after it —
# the end of the source cut the escape off. A token still open at the end of
# the source is a hard error (`at` is the token's absolute start, so error spans
# land in the real source).
fn delimited_len(self: str, at: u64, delims: #{char}, escapes: #{char}, msg: str) -> u64!LexError {
    if (!self.first().is_some_and(|c| delims.has(c))) {
        return ok(0);
    };
    let d = self.first().value_or(' '); // in bounds: the guard above saw a char

    // The opener is passed over the way an escaped char is: neither is content
    // that can close the token.
    mut skip = true;
    for (let i, c : self) {
        if (skip) {
            set skip = false;
        } else if (c == d) {
            return ok(i + 1);
        } else if (c == '\\' && escapes.is_nonempty()) {
            // A backslash escapes its next char. A backslash with nothing
            // after it means the end of the source cut the escape off, which
            // is its own error rather than a plain unterminated token. The
            // escaped char must be allowed, and is content: skipping it is
            // what keeps an escaped delimiter from closing the token.
            let e = self[i + 1].value_or_err(LexError {
                message: INCOMPLETE_ESCAPE,
                span: at + i..at + i + 1,
            })?;
            if (!escapes.has(e)) {
                return err(LexError {
                    message: `unknown escape sequence \\{e}`,
                    span: at + i..at + i + 2,
                });
            };
            set skip = true;
        };
    }
    err(LexError { message: unterminated_msg(msg), span: at..at + self.len() })
}

# The message for a backslash the end of the source cut off. Shared by the
# `Delimited` and `UpToAny` scans, which handle escapes the same way.
let INCOMPLETE_ESCAPE = """incomplete escape sequence: \ at end of input""";

# The message for an unterminated scan: a rule's own `unterminated` override, or
# the generic default when it left the field empty.
fn unterminated_msg(msg: str) -> str {
    if (msg.is_empty()) { "unterminated delimited token" } else { msg }
}

# `Between`: the `open` spelling opens the token, which runs to just past the
# next full occurrence of `close`. ok(0) when `self` doesn't start with
# `open`. The close scan starts past the open and matches the whole `close`
# spelling, so a partial close inside (a lone `"`/`""` under a `"""` close) is
# content, not a terminator, and open/close may be multi-char and differ. No
# escapes — contents are verbatim. A token still open at the end of the source
# is a hard error (`at` places the span in the real source).
fn between_len(self: str, at: u64, open: str, close: str, msg: str) -> u64!LexError {
    if (!self.starts_with(open)) {
        return ok(0);
    };

    // Scan for the close from just past the open, so an `open`/`close` that
    // share text (e.g. `"""`/`"""`) can't self-close on the opener.
    mut i = open.len();
    while (i < self.len()) {
        if (self[i..].starts_with(close)) {
            return ok(i + close.len());
        };
        set i++;
    }
    err(LexError { message: unterminated_msg(msg), span: at..at + self.len() })
}

# `UpToAny`: the length of the run before the first of `stops`, or the whole of
# `self` when none of them appears. `\X` escapes are consumed as a unit and
# validated as in `delimited_len`, so an escaped terminator does not end the run
# and an unknown or cut-off escape is the same hard error there.
#
# 0 when a stop spelling sits at the cursor — a decline, like every other
# matcher, which hands the position to the rule that matches the terminator.
fn up_to_any_len(
    self: str,
    at: u64,
    stops: str[],
    escapes: #{char},
    refuse_unknown_escape: bool,
) -> u64!LexError {
    mut i: u64 = 0;
    while (i < self.len()) {
        if (stops.any(|stop| self[i..].starts_with(stop))) {
            return ok(i);
        };
        let c = self[i].value_or(' '); // in bounds: the loop condition holds
        let escaped = self[i + 1];
        if (c == '\\' && escapes.is_nonempty() && escaped.is_some_and(|e| escapes.has(e))) {
            // A listed escape: the pair is content, and skipping it whole is
            // what keeps an escaped stop from ending the run.
            set i += 2;
        } else if (c == '\\' && escapes.is_nonempty() && refuse_unknown_escape) {
            let e = escaped.value_or_err(LexError {
                message: INCOMPLETE_ESCAPE,
                span: at + i..at + i + 1,
            })?;
            return err(LexError {
                message: `unknown escape sequence \\{e}`,
                span: at + i..at + i + 2,
            });
        } else {
            set i++;
        };
    }
    ok(i)
}

# `Nested`: the depth-tracked `Between`. The `open` spelling opens the token at
# depth 1; each further `open` raises the depth and each `close` lowers it, so
# the token ends just past the `close` that returns the depth to 0. ok(0) when
# `self` doesn't start with `open`. `open` is tested before `close` so an
# overlap can't misclassify, but the two must be distinct for nesting to mean
# anything. No escapes — contents are verbatim. Still open (depth > 0) at the
# end of the source is a hard error (`at` places the span in the real source).
fn nested_len(self: str, at: u64, open: str, close: str, msg: str) -> u64!LexError {
    if (!self.starts_with(open)) {
        return ok(0);
    };
    mut depth: u64 = 1;

    // Where the scan resumes: a delimiter is matched at its first byte, and the
    // rest of its bytes can't open or close anything on their own.
    mut next = open.len();
    for (let i, _ : self) {
        if (next <= i) {
            if (self.starts_with_at(open, i)) {
                set depth++;
                set next = i + open.len();
            } else if (self.starts_with_at(close, i)) {
                set depth--;
                if (depth == 0) {
                    return ok(i + close.len());
                };
                set next = i + close.len();
            };
        };
    }
    err(LexError { message: unterminated_msg(msg), span: at..at + self.len() })
}

# `ToEol`: the marker, then everything up to (not including) the next
# newline. 0 when `self` doesn't start with the (non-empty) marker.
fn to_eol_len(self: str, marker: str) -> u64 {
    if (marker.is_nonempty() && self.starts_with(marker)) {
        self.count_while(|x| x != '\n')
    } else {
        0
    }
}

# `ToEolUnless`: `to_eol_len`, refused when the character right after the marker
# is one `blocked` claims. End of input or a newline right after the marker is
# *not* blocked — an empty comment line is a comment.
fn to_eol_unless_len(self: str, marker: str, blocked: #{char}) -> u64 {
    let len = self.to_eol_len(marker);
    if (len == 0) {
        return 0;
    };
    if (self[marker.len()..].first().is_some_and(|c| blocked.has(c))) { 0 } else { len }
}

# The end of the number whose integer part ends at `int_end`: extends past a
# fraction (`.` then at least one digit), then past an exponent (`e` or `E`,
# an optional sign, then at least one digit). Either part may be absent;
# `int_end` comes back unchanged when neither matches.
fn number_end(self: str, int_end: u64) -> u64 {
    mut end = int_end;
    if (self[end] == some('.') && self[end + 1].is_some_and(is_digit)) {
        set end = end + 1 + self[end + 1..].count_while(is_digit);
    };
    if (self[end].is_some_and(|e| e == 'e' || e == 'E')) {
        let has_sign = self[end + 1].is_some_and(|sign| sign == '+' || sign == '-');
        let digits = if (has_sign) { end + 2 } else { end + 1 };
        if (self[digits].is_some_and(is_digit)) {
            set end = digits + self[digits..].count_while(is_digit);
        };
    };
    end
}

# `Float`: a digit run that extends past a fraction and/or exponent. A bare
# digit run is 0 (no match) — it belongs to the int rule.
fn float_len(self: str) -> u64 {
    let int_end = self.count_while(is_digit);
    if (int_end == 0) {
        return 0;
    };
    let end = self.number_end(int_end);
    if (int_end < end) { end } else { 0 }
}

# `Int`: the length of an optional leading `-` then a digit run. 0 (no match)
# when there's no digit run — including a `-` *not* immediately followed by a
# digit (a `-` before a space or a letter is left for a `-` operator rule, so
# `- 5`/`-x` don't match). That decline is the entire sign-vs-operator
# disambiguation: with an `Int` rule before the `-` operator rule, `-5` is a
# signed literal while `- 5`/`-x` are the operator; put the operator first and
# every `-` is the operator and `Int` is unsigned.
fn int_len(self: str) -> u64 {
    let signed = self.first() == some('-') && self[1].is_some_and(is_digit);
    let start: u64 = if (signed) { 1 } else { 0 };
    let digits = self[start..].count_while(is_digit);
    if (digits == 0) { 0 } else { start + digits }
}

# The content string a token of matcher `m` is built from: its matched `text`
# (`src[at..at+n]`, delimiters included), with the delimiters taken off by the
# three matchers that bracket their content — see the table on `Matcher`.
# Everything else is its own text, and its rule's `emit` interprets it.
fn token_content(m: Matcher, text: str) -> str {
    match (m) {
        Delimited(..) => text[1..text.len() - 1],
        // The two bracketing matchers strip the same way — their delimiters are
        // the only difference, and the arm reads both out of the case it matched.
        Between(open, close) | Nested(open, close) => text[open.len()..text.len() - close.len()],
        CharRun(..)
        | OneChar(..)
        | Exact(..)
        | Keyword(..)
        | ToEol(..)
        | ToEolUnless(..)
        | UpToAny(..)
        | Float
        | Int => text,
    }
}

# Build a token's kind by applying the rule's `emit` to its `content` string —
# what `token_content` made of the matched text. `Bare` ignores it; `Of` applies
# its constructor; `Try` does too but may fail with a message (paired with the
# token `span` to make a `LexError`).
fn apply_emit<K>(e: Emit<K>, span: Span, content: str) -> K!LexError {
    match (e) {
        Bare(k) => ok(k),
        Of(f) => ok(f(content)),
        // A fallible emit yields `K!str` — a kind or an error *message*; pair the
        // message with the token's span to make the `LexError` the lexer
        // surfaces.
        Try(f) => f(content).map_err(|message| LexError { message, span }),
    }
}

# One lexing step's outcome: the one token the winning rule produced, whether
# that token is trivia, and the position just past the consumed text. `end`
# staying at the step's start means no rule matched.
#
# **One token, or none — never two.** A rule is a token rule or a `trivia` rule,
# and a `skip` rule is neither, so a step yields at most one token either way.
# That is why `trivia` is a flag on the token rather than a second token field:
# two optionals could represent "both at once", which no step can produce, and
# the invariant then lived in this comment instead of in the type.
#
# It cost real bytes, too. `Token<AiplTok>` is 80 wide, so a second
# `Token<K>?` field put 88 more bytes inline in a struct that is built and
# returned at every position of every lex — 248 bytes against 168 for this
# shape.
#
# Both fields were `Token<K>[]` before struct fields could be optionals of
# structs, when an array of nought-or-one was the only way to spell "maybe a
# token". Before that they were arrays for a stronger reason: `Matcher::Template`
# emitted a whole head/interpolation/tail run from a single step, and it was the
# only matcher that ever emitted more than one token. Modes replaced it, and each
# piece of a template is now its own step.
struct StepResult<K> {
    token: Token<K>? = none,
    // Whether `token` is trivia — the winning rule's own `trivia` flag, carried
    // out so the collectors can route it without re-reading the rule.
    trivia: bool = false,
    end: u64,
    // The winning rule's `push`/`pop` and the message it names an unclosed mode
    // with, carried out to `lex`, which owns the stack. Defaulted, so a
    // `StepResult` built for "nothing matched" says nothing about modes.
    push: i64 = -1,
    pop: bool = false,
    unterminated: str = "",
    // The winning rule's `scope`, for the highlighting side-channel — see
    // `lex_scoped`. Here rather than on `Token` because a token is compared
    // whole all over this file's tests, and what a *highlighter* wants painted
    // is no part of what a token *is*.
    scope: str = "",
}

# A simple (single-token) matcher's outcome: a decline when the matched
# length `n` is 0, otherwise `n` chars consumed producing the rule's one
# token — flagged as trivia for a `trivia` rule, or absent for a `skip` rule.
# The token's kind comes from the rule's `emit` applied to the matcher's content
# string, which can fail on an emit/matcher mismatch.
fn step_result<K>(r: TokenRule<K>, src: str, at: u64, n: u64) -> StepResult<K>!LexError {
    // A decline transitions nothing: the rule did not match, so the mode stack
    // is no more its business than the token stream is.
    if (n == 0) {
        return ok(StepResult { end: at });
    };
    let moved = StepResult {
        trivia: r.trivia,
        end: at + n,
        push: r.push,
        pop: r.pop,
        unterminated: r.unterminated,
        scope: r.scope,
    };
    if (r.skip) {
        return ok(moved);
    };
    let text = span_str(src, at..at + n);
    let kind = apply_emit(r.emit, text.span, token_content(r.matcher, text.text))?;
    ok(StepResult { ..moved, token: some(Token { kind, text }) })
}

# The mode stack after a step that consumed `at..step.end`: unchanged, one frame
# deeper, or one shallower. A `Pop` at the base stays at the base — see
# `Transition`.
fn stepped<K>(self: ModeFrame[], step: StepResult<K>, at: u64) -> ModeFrame[] {
    match (transition(step.push, step.pop)) {
        Stay => self,
        Push(m) => [
            ..self,
            ModeFrame { mode: m, open: at..step.end, unterminated: step.unterminated },
        ],
        Pop => self.drop_last(),
    }
}

# One lexing step at absolute position `at`: tries each rule of `mode` in order
# (first match wins) and returns the winning rule's outcome — see `StepResult`.
# Each arm computes how far its matcher reaches (0 for no match — no matcher
# matches empty input, so a nonzero length always means progress) and wraps it
# via `step_result`.
#
# A rule of another mode is passed over rather than filtered out up front: the
# check is one comparison inside the loop that already runs, where filtering
# would build a new array at every position of every lex.
fn lex_step<K>(src: str, at: u64, rules: TokenRule<K>[], mode: i64) -> StepResult<K>!LexError {
    for (let r : rules) {
        let res = if (r.mode != mode) {
            StepResult { end: at }
        } else {
            match (r.matcher) {
                CharRun(cont, first) => step_result(
                    r,
                    src,
                    at,
                    src[at..].char_run_len(first, cont),
                )?,
                OneChar(chars) => step_result(r, src, at, src[at..].one_char_len(chars))?,
                Exact(spelling) => step_result(r, src, at, src[at..].exact_len(spelling))?,
                Keyword(spelling, boundary) => step_result(
                    r,
                    src,
                    at,
                    src[at..].keyword_len(spelling, boundary),
                )?,
                Delimited(delims, escapes) => step_result(
                    r,
                    src,
                    at,
                    src[at..].delimited_len(at, delims, escapes, r.unterminated)?,
                )?,
                Between(open, close) => step_result(
                    r,
                    src,
                    at,
                    src[at..].between_len(at, open, close, r.unterminated)?,
                )?,
                Nested(open, close) => step_result(
                    r,
                    src,
                    at,
                    src[at..].nested_len(at, open, close, r.unterminated)?,
                )?,
                UpToAny(stops, escapes, refuse) => step_result(
                    r,
                    src,
                    at,
                    src[at..].up_to_any_len(at, stops, escapes, refuse)?,
                )?,
                ToEol(marker) => step_result(r, src, at, src[at..].to_eol_len(marker))?,
                ToEolUnless(marker, blocked) => step_result(
                    r,
                    src,
                    at,
                    src[at..].to_eol_unless_len(marker, blocked),
                )?,
                Float => step_result(r, src, at, src[at..].float_len())?,
                Int => step_result(r, src, at, src[at..].int_len())?,
            }
        };
        if (at < res.end) {
            return ok(res);
        };
    }
    ok(StepResult { end: at })
}

# A concrete token-kind variant for the `.test` block below — one example of
# the per-language `K` a caller pins `Token<K>`/`TokenRule<K>` to. Each arm is a
# kind; value-bearing kinds carry their content (`Int(i64)`, `Str(str)`, the
# template segments), text-recovered kinds are bare (their text is sliced from
# the span). A real consumer writes its own such variant.
variant Kind =
    | Ws
    | Ident(str)
    | IntTok(i64)
    | Digits
    | Op
    | Kw
    | Punct
    | Dot
    | FloatTok
    | Str(str)
    | Raw(str)
    | Block(str)
    | Comment
    | Allow
    | Tpl(str)

fn toks(tokens: Token<Kind>[]) -> LexResult<Kind> { tokens, trivia: [] }

# Lexes `self` into a `LexResult`: the flat token list, plus the trivia
# side-channel, as described by the ordered `rules`. At each position the
# first rule whose matcher matches claims the token (so order is priority —
# keywords before identifiers, floats before ints); a `skip: true` rule
# consumes its match without producing anything (whitespace), and a
# `trivia: true` rule records its matches in the side-channel instead of
# the token stream (comments, lint markers). Lexing fails with
# an `err` — a `LexError` carrying a message and the offending span — when
# a byte matches no rule or a matcher sees invalid input outright (an
# unterminated `Delimited` token).
# One token's span and the scope its rule declares — the highlighting
# side-channel. `TokenRule.scope` exists so that one rule set describes a
# language's lexical structure *once*, for the lexer and the highlighter both;
# this is that hint read per token rather than per rule.
struct ScopeSpan { span: Span, scope: str }

# What a drive of the rule set should gather. One loop serves every consumer, and
# this is what keeps each from paying for the others: a parse wants tokens and
# does not care what colour they are, the highlighter's oracle wants the reverse,
# and `lex_kinds` wants neither span nor trivia.
variant Collect = Tokens | Scopes | Kinds

# Everything a drive can produce. Whichever arrays the `Collect` did not ask for
# stay empty, and each entry point takes the one it wanted — so the three views
# can never disagree about what matched where, because there is one loop behind
# all of them.
struct LexAll<K> { result: LexResult<K>, scopes: ScopeSpan[], kinds: K[] }

# `lex`, plus the scope each token's rule declares — see `ScopeSpan`. The
# highlighter's oracle reads this: the grammar it generates has to paint every
# token with the scope the rule set already names for it, and asking the rule set
# beats restating the mapping somewhere else.
pub fn lex_scoped<K>(self: str, rules: TokenRule<K>[]) -> ScopeSpan[]!LexError {
    ok(self.lex_all(rules, Scopes)?.scopes)
}

# Every token's *kind*, and nothing else: no spans, no trivia, and an error that
# is a bare message.
#
# The *plain* path. A consumer that only asks "what tokens are these" reads the
# answer without walking into a token to find it —
# `lex_kinds(src, rules)? == [Let, Name("x")]` against `lex`'s
# `toks([tok(src, Let, 0..3), tok(src, Name("x"), 4..5)])` — which is most of
# this file's own tests, and why they use it.
#
# **It is not meaningfully faster, and it was written expecting to be.** Measured
# over 460k tokens: `lex` spent 1.85s, this 1.82s, and a throwaway build that
# emitted kinds while constructing *no* token at all spent 1.79s. So the whole
# token-and-span apparatus is ~3% of a lex and this saves half of that: the other
# ~97% is matching a rule, slicing its content and running its `emit`, which both
# paths must do and neither can skip. A spanless lexer here buys a plainer call
# site, not throughput — look to the matchers if that is what you need.
#
# **The errors are worse on purpose.** A `str` carries no span, so a caller that
# wants to *report* one re-lexes with `lex` — the slow path only on the way to
# failing. Nothing is lost by refusing first and locating second: the two drive
# the same rules in the same order, so whatever this refuses `lex` refuses at the
# same byte.
pub fn lex_kinds<K>(self: str, rules: TokenRule<K>[]) -> K[]!str {
    match (self.lex_all(rules, Kinds)) {
        ok(all) => ok(all.kinds),
        err(e) => err(e.message),
    }
}

pub fn lex<K>(self: str, rules: TokenRule<K>[]) -> LexResult<K>!LexError {
    ok(self.lex_all(rules, Tokens)?.result)
}

# Append what `t` holds, if it holds anything. A step carries *at most* one token
# (see `StepResult`), so every array `lex_all` accumulates grows by nought or one
# per step — and spelling that as a `match` at each site buried the loop in empty
# `none` arms. `mut self`, so this appends in place like the `push` it wraps
# rather than rebuilding the array at every position of every lex.
fn push_optional<T: any>(mut self: T[], t: T?) {
    match (t) {
        some(v) => {
            set self.push(v);
        },
        none => {},
    };
}.test({
    // A `none` leaves the array alone, which is the whole point: a `skip` rule
    // and a rule that declined both reach this with nothing to add.
    mut xs: i64[] = [];
    set xs.push_optional(some(1));
    set xs.push_optional(none);
    set xs.push_optional(some(2));
    assert(xs == [1, 2]);

    // The shape `lex_all` uses it in — a token optional off a `StepResult`.
    mut ts: Token<Kind>[] = [];
    let t = Token { kind: Ident("hi"), text: span_str("hi", 0..2) };
    set ts.push_optional(some(t));
    set ts.push_optional(none);
    assert(ts == [t]);
})

# What the highlighter paints for this step: the span of the token it produced,
# under the winning rule's scope. A skipped rule produces no token and so paints
# nothing; a trivia rule paints, since a comment is painted like anything else —
# which is why this does not consult `trivia`.
fn scope_span<K>(self: StepResult<K>) -> ScopeSpan? {
    self.token.map(|t| ScopeSpan { span: t.text.span, scope: self.scope })
}

fn lex_all<K>(self: str, rules: TokenRule<K>[], want: Collect) -> LexAll<K>!LexError {
    // Annotated like `scopes` and `kinds` below: a bare `[]` carries only a
    // placeholder element type, which `push_optional` would bind its `T` to
    // ahead of the `Token<K>?` it is handed.
    mut tokens: Token<K>[] = [];
    mut trivia: Token<K>[] = [];
    mut scopes: ScopeSpan[] = [];
    mut kinds: K[] = [];
    mut pos: u64 = 0;

    // The mode stack, innermost last; empty *is* the base mode, so a rule set
    // that never mentions modes never touches this.
    mut modes: ModeFrame[] = [];
    while (pos < self.len()) {
        let step = lex_step(self, pos, rules, modes.last().map(|f| f.mode).value_or(0))?;
        if (step.end == pos) {
            // No rule matched: a lex error at the offending byte (slice the
            // source with the span to show it).
            return err(LexError { message: "unexpected character", span: pos..pos + 1 });
        };
        match (want) {
            Tokens => {
                if (step.trivia) {
                    set trivia.push_optional(step.token);
                } else {
                    set tokens.push_optional(step.token);
                };
            },
            // Trivia is no part of a kind stream: a parser driven by kinds alone
            // never sees a comment.
            Kinds => {
                if (!step.trivia) {
                    set kinds.push_optional(step.token.map(|t| t.kind));
                };
            },
            Scopes => {
                set scopes.push_optional(step.scope_span());
            },
        };
        set modes = modes.stepped(step, pos);
        set pos = step.end;
    }

    // A mode still open at the end of the source: an unclosed construct,
    // reported against the token that opened it.
    //
    // Frames in the *base* mode are not that. A rule set balances its brackets
    // by pushing the base mode on the opener and popping on the closer — which
    // is what makes a nested block inside an interpolation close itself — so an
    // unclosed bracket leaves one behind. That is a syntax error, and a parser
    // reports it far better than "unterminated" against a lone `{`; the lexer's
    // job was to hand over the tokens, and it did. Only a frame that entered a
    // mode of its own is an unfinished *lexical* construct, and the innermost
    // one is the one to name.
    match (modes.filter(|f| f.mode != 0).last()) {
        some(f) => err(LexError { message: unterminated_msg(f.unterminated), span: f.open }),
        none => ok(LexAll { result: LexResult { tokens, trivia }, scopes, kinds }),
    }
}.test({
    fn lex_err(message: str, span: Span) -> LexError { message, span }

    // The `Of` emit for the escaped-string test below: the library hands the raw
    // (un-decoded) delimiter-stripped contents, so the emit decodes them itself.
    fn esc_str(text: str) -> Kind { Str(text.unescape()) }

    // The `Try` emit for the `Int` test below: the library hands the raw digit
    // run, so this emit parses it — here with the `int_parse` builtin, reporting an
    // i64 overflow as an error *message* (the library attaches the token's span).
    // Parsing policy, and what overflow means, is the caller's — a bignum lexer would
    // parse into a wide type and never fail here.
    fn int_tok(text: str) -> Kind!str {
        ok(IntTok(text.int_parse().value_or_err("integer literal overflows i64")?))
    }

    // A `Try` emit: the escaped-string decoder above, plus a content rule the
    // caller enforces — a string literal may not be empty. A whole-token verdict, so
    // the token's span is the right place for the error.
    fn nonempty_str(text: str) -> Kind!str {
        let s = text.unescape();
        if (s.is_empty()) { err("empty string literal") } else { ok(Str(s)) }
    }

    // Test-block shorthands over the concrete `Kind` (each kind arm carries its own
    // content): an expected token, and a token-only result (no trivia).
    //
    // `tok` slices its text out of `src` — the same source the `lex` call under
    // test was given — rather than taking it as a literal. An expectation therefore
    // cannot claim text the source does not hold at that span, which is the one
    // thing a hand-written `SpanStr` could get wrong while still looking right.
    fn tok(src: str, kind: Kind, span: Span) -> Token<Kind> { kind, text: span_str(src, span) }

    // Character classes shared across the rule sets below.
    let alpha = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".to_set();
    let alnum = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789".to_set();
    let num = "0123456789".to_set();

    // Reusable rules. Each pairs a matcher with an `emit` that builds a `Kind`:
    // `Of` applies a constructor to the token's content (stripped for a delimited
    // matcher, raw text otherwise); `Bare` is a fixed kind; a skip rule's emit is
    // never applied.
    let ws = TokenRule { matcher: CharRun(" \t\n\r".to_set()), emit: Bare(Ws), skip: true };
    let ident = TokenRule { matcher: CharRun(alnum, first=alpha), emit: Of(Ident) };
    let digits = TokenRule { matcher: CharRun(num), emit: Bare(Digits) };
    let base = [ws, ident, digits];

    // Empty / all-whitespace input produces no tokens.
    assert(lex_kinds("", base)? == []);
    assert(lex_kinds(" \t\n\r ", base)? == []);

    // Each kind is a variant arm carrying its content: an identifier holds its
    // text, and its span still slices the same text from the source.
    assert(lex_kinds("foo", base)? == [Ident("foo")]);
    assert(lex_kinds("x1", base)? == [Ident("x1")]);
    assert(lex_kinds("1x", base)? == [Digits, Ident("x")]);
    assert(lex_kinds("  hi  ", base)? == [Ident("hi")]);

    // `first` defaults to `cont`: `digits` names one class and gets a run that
    // both opens and continues with it, while `ident` narrows only the opener —
    // so an identifier may hold a digit but not start with one.
    assert(lex("1x", [ws, digits]) == err(lex_err("unexpected character", 1..2)));
    assert(lex_kinds("x1", [ws, ident])? == [Ident("x1")]);
    assert(lex("1x", [ws, ident]) == err(lex_err("unexpected character", 0..1)));
    // Naming `first` explicitly as the same class is the default spelled out.
    let d2 = TokenRule { matcher: CharRun(num, first=num), emit: Bare(Digits) };
    assert(lex("42", [ws, d2])? == lex("42", [ws, digits])?);

    // A byte no rule matches is a lex error carrying that byte's span.
    assert(lex("a+1", base) == err(lex_err("unexpected character", 1..2)));
    match (lex("a+1", base)) {
        ok(..) => assert(false),
        err(e) => assert("a+1"[e.span] == "+"),
    };

    // Exact: one spelling per rule. Ordering the rules longest-first makes the
    // longer spelling win where they share a prefix (`==`/`=>` before `=`) —
    // rule order is the priority mechanism, so no per-rule spelling set is needed.
    let ops = [
        ws,
        TokenRule { matcher: Exact("=="), emit: Bare(Op) },
        TokenRule { matcher: Exact("=>"), emit: Bare(Op) },
        TokenRule { matcher: Exact("="), emit: Bare(Op) },
        ident,
    ];
    assert(lex_kinds("===", ops)? == [Op, Op]);
    assert(lex_kinds("a=b", ops)? == [Ident("a"), Op, Ident("b")]);
    assert(lex("+", ops) == err(lex_err("unexpected character", 0..1)));

    // Keyword: a spelling matches only at an identifier boundary. One spelling
    // per rule, as with `Exact`; order among keyword rules is immaterial (the
    // boundary check, not order, keeps `if` out of `iffy`).
    let kw_if = TokenRule { matcher: Keyword("if", alnum), emit: Bare(Kw) };
    let kw_let = TokenRule { matcher: Keyword("let", alnum), emit: Bare(Kw) };
    let kws = [ws, kw_if, kw_let, ident];
    assert(lex_kinds("iffy", kws)? == [Ident("iffy")]);
    assert(lex_kinds("if fy", kws)? == [Kw, Ident("fy")]);
    assert(lex_kinds("if", kws)? == [Kw]);

    // Delimited: an `Of` emit carries the delimiter-stripped contents, left
    // *un-decoded* — with escapes off (`#{}`) that's the whole content verbatim, and
    // here none of the inputs carry a backslash so `Of(Str)` needs no decoding.
    // An unterminated token is a hard error at its open delimiter.
    let strs = [ws, TokenRule { matcher: Delimited(`"'`.to_set()), emit: Of(Str) }, ident];
    assert(lex_kinds(`"hi" x`, strs)? == [Str("hi"), Ident("x")]);
    assert(lex_kinds("''", strs)? == [Str("")]);
    assert(lex(`"hi`, strs) == err(lex_err("unterminated delimited token", 0..3)));

    // With escapes on, `escapes` still governs scanning (an unknown escape is a
    // hard error), but *decoding* is the emit's job: `esc_str` calls `unescape`.
    let esc = [
        ws,
        TokenRule { matcher: Delimited(`"`.to_set(), escaped=`nt\\"`.to_set()), emit: Of(esc_str) },
        ident,
    ];
    assert(lex(`"a\\"b"`, esc)? == toks([tok(`"a\\"b"`, Str(`a"b`), 0..6)]));
    assert(lex_kinds(`"a\\nb"`, esc)? == [Str("a\nb")]);
    assert(lex(`"a\\xb"`, esc) == err(lex_err("""unknown escape sequence \x""", 2..4)));

    // A backslash the source ends on is an incomplete escape, not merely an
    // unterminated token — and only where escapes are on: `strs` scans none.
    assert(lex(`"a\\`, esc) == err(lex_err(
        """incomplete escape sequence: \ at end of input""",
        2..3,
    )));
    assert(lex(`"a\\`, strs) == err(lex_err("unterminated delimited token", 0..3)));

    // Try: a fallible string emit. `nonempty_str` decodes, then enforces a
    // content rule the *caller* owns — an empty string literal is an error whose
    // message the library pairs with the token's span. A well-formed one passes.
    let nes = [
        ws,
        TokenRule {
            matcher: Delimited(`"`.to_set(), escaped=`nt\\"`.to_set()),
            emit: Try(nonempty_str),
        },
        ident,
    ];
    assert(lex_kinds(`"hi"`, nes)? == [Str("hi")]);
    assert(lex(`""`, nes) == err(lex_err("empty string literal", 0..2)));

    // Between: a raw string `"""..."""` — a lone `"`/`""` inside is content.
    let q3 = `"""`;
    let raw = [ws, TokenRule { matcher: Between(q3, q3), emit: Of(Raw) }, ident];
    assert(lex(`"""a"b""c"""`, raw)? == toks([tok(`"""a"b""c"""`, Raw(`a"b""c`), 0..12)]));
    assert(lex(`"""hi""`, raw) == err(lex_err("unterminated delimited token", 0..7)));

    // Nested: depth-tracked block comments — an inner `/* */` doesn't close the
    // outer. On the same input `Between` (`blk`) stops at the first `*/`.
    let nest = [ws, TokenRule { matcher: Nested("/*", "*/"), emit: Of(Block) }, ident];
    let blk = [ws, TokenRule { matcher: Between("/*", "*/"), emit: Of(Block) }, ident];
    assert(lex_kinds("/* a /* b */ c */x", nest)? == [Block(" a /* b */ c "), Ident("x")]);
    assert(lex("/* a /* b */", nest) == err(lex_err("unterminated delimited token", 0..12)));
    assert(lex_kinds("/* a /* b */", blk)? == [Block(" a /* b ")]);

    // Char literals are not a library matcher: a consumer lexes one as a
    // single-quoted `Delimited` string and enforces the one-char shape in a
    // `Try` emit (see `lex_aipl.aipl`'s `char_lit_emit`). The `Delimited`
    // single-quote scan and the `Try` one-char verdict are exercised by the
    // string tests above and the `nonempty_str` test below.

    // Int: one matcher for both unsigned and signed literals — a digit run with an
    // *optional* leading `-`. The `Try` emit (`int_tok`) parses it; overflow is a
    // lex error the *caller* decides (the library just attaches the span), so a
    // bignum lexer never fails here.
    let minus = TokenRule { matcher: Exact("-"), emit: Bare(Op) };
    let ints = [ws, TokenRule { matcher: Int, emit: Try(int_tok) }, ident, minus];
    assert(lex_kinds("42", ints)? == [IntTok(42)]);
    assert(lex_kinds("0 7", ints)? == [IntTok(0), IntTok(7)]);
    assert(lex("9223372036854775808", ints) == err(lex_err(
        "integer literal overflows i64",
        0..19,
    )));

    // `-` glued to digits → one signed literal, wherever it appears (the `Int`
    // rule is before the `-` operator rule).
    assert(lex_kinds("-5", ints)? == [IntTok(-5)]);
    assert(lex_kinds("a -5", ints)? == [Ident("a"), IntTok(-5)]);

    // A space after `-` makes `Int` decline, so the operator rule claims the `-`
    // and the digits are a separate `Int`: `- 5` is the operator, `-5` isn't.
    assert(lex_kinds("a - 5", ints)? == [Ident("a"), Op, IntTok(5)]);
    assert(lex_kinds("5 - 3", ints)? == [IntTok(5), Op, IntTok(3)]);

    // `-` before a non-digit (a letter) also declines → the operator rule takes it
    // and the letters are a separate identifier (so a consumer gets unary `-x`).
    assert(lex_kinds("-b", ints)? == [Op, Ident("b")]);

    // Optional sign reaches the full range: i64::MIN parses (a positive run of the
    // same magnitude would overflow), one past it does not.
    assert(lex_kinds("-9223372036854775808", ints)? == [IntTok(-9223372036854775808)]);
    assert(lex("-9223372036854775809", ints) == err(lex_err(
        "integer literal overflows i64",
        0..20,
    )));

    // Float before int: a fraction/exponent extends a digit run; a bare run
    // falls through to the digit rule.
    let dot = TokenRule { matcher: Exact("."), emit: Bare(Dot) };
    let flt = [ws, TokenRule { matcher: Float, emit: Bare(FloatTok) }, digits, ident, dot];
    assert(lex_kinds("1.5e-3", flt)? == [FloatTok]);
    assert(lex_kinds("1.", flt)? == [Digits, Dot]);

    // --- modes and `UpToAny` ------------------------------------------------
    // A template lexer built from modes alone: no re-entrancy, and no matcher
    // that knows what a template is — which is what the `Template` matcher this
    // replaced spent ~290 lines on.
    let M_TPL: i64 = 1;
    let tpl_open = TokenRule {
        matcher: Exact("`"),
        emit: Bare(Punct),
        push: M_TPL,
        unterminated: "unterminated template",
    };
    let tpl_close = TokenRule { matcher: Exact("`"), emit: Bare(Punct), mode: M_TPL, pop: true };

    // `{` re-enters the *base* rules for the interpolation and its `}` pops back
    // into the template. Pushing mode 0 is the whole mechanism — neither rule
    // knows anything about templates.
    let tpl_interp = TokenRule { matcher: Exact("{"), emit: Bare(Punct), mode: M_TPL, push: 0 };

    // The base mode's own braces, which balance the same way — so a `{ .. }`
    // *inside* an interpolation closes itself rather than the interpolation.
    let brace_open = TokenRule { matcher: Exact("{"), emit: Bare(Punct), push: 0 };
    let interp_end = TokenRule { matcher: Exact("}"), emit: Bare(Punct), pop: true };
    let tpl_text = TokenRule {
        matcher: UpToAny(["`", "{"], """\`{""".to_set()),
        emit: Of(Tpl),
        mode: M_TPL,
    };
    let tpl_rules = [
        ws,
        ident,
        digits,
        tpl_open,
        brace_open,
        interp_end,
        tpl_close,
        tpl_interp,
        tpl_text,
    ];

    // A rule of another mode is invisible: the base mode has no `tpl_text`, so
    // the same bytes lex differently depending on the mode they are read in.
    let plain = "`ab`";
    assert(lex(plain, tpl_rules)? == toks([
        tok(plain, Punct, 0..1),
        tok(plain, Tpl("ab"), 1..3),
        tok(plain, Punct, 3..4),
    ]));

    // An interpolation: inside the braces the *base* rules apply again, so `x`
    // is an identifier rather than template text.
    let one = "`a{x}b`";
    assert(lex(one, tpl_rules)? == toks([
        tok(one, Punct, 0..1),
        tok(one, Tpl("a"), 1..2),
        tok(one, Punct, 2..3),
        tok(one, Ident("x"), 3..4),
        tok(one, Punct, 4..5),
        tok(one, Tpl("b"), 5..6),
        tok(one, Punct, 6..7),
    ]));

    // A brace inside an interpolation closes itself, not the interpolation: its
    // `{` pushed the base mode and its `}` pops that, leaving the template mode
    // underneath untouched. This is the depth tracking, for free.
    let nested_brace = "`a{ {x} }b`";
    assert(lex(nested_brace, tpl_rules)?.tokens.len() == 9);
    assert(lex(nested_brace, tpl_rules)?.tokens[7] == some(tok(nested_brace, Tpl("b"), 9..10)));

    // The stack *is* the depth counter: a template inside an interpolation
    // inside a template nests by pushing, with nothing counting anything. The
    // inner `x` is template text again because the inner backtick pushed
    // `M_TPL` back on.
    let deep = "`a{`x`}b`";
    assert(lex(deep, tpl_rules)?.tokens.len() == 9);
    assert(lex(deep, tpl_rules)?.tokens[4] == some(tok(deep, Tpl("x"), 4..5)));

    // An empty segment emits no text token at all: `UpToAny` declines at a stop,
    // so the rule matching the terminator wins there instead.
    assert(lex("`{x}`", tpl_rules)?.tokens.len() == 5);

    // A mode still open at the end of the source is reported against the token
    // that opened it — the backtick, not the whole remaining line.
    assert(lex("`ab", tpl_rules).is_err_and(|e| e == lex_err("unterminated template", 0..1)));

    // An interpolation left open still names the *template*, not the `{`: the
    // `{` pushed the base mode, which is bracket bookkeeping rather than an
    // unfinished lexical construct.
    assert(lex("`a{x", tpl_rules).is_err_and(|e| e == lex_err("unterminated template", 0..1)));

    // And an unclosed bracket on its own is no lexical error at all — it is a
    // token stream a parser will complain about.
    assert(lex("{x", tpl_rules)?.tokens.len() == 2);

    // A `pop` at the base mode stays at the base rather than running off the
    // bottom: a stray closer is a token, and a parser's problem.
    assert(lex("}", tpl_rules)? == toks([tok("}", Punct, 0..1)]));

    // --- the scope side-channel ---------------------------------------------
    // Every token's span paired with the scope its own rule declares, which is
    // what a highlighter's oracle compares a generated grammar against. A
    // `skip` rule contributes nothing — there is no token to paint — and a rule
    // with no scope reports the empty one it declares.
    let kw_scoped = TokenRule {
        matcher: Keyword("let", "abcdefghijklmnopqrstuvwxyz_0123456789".to_set()),
        emit: Bare(Kw),
        scope: "kw",
    };
    assert(lex_scoped("let x", [ws, kw_scoped, ident])? == [
        ScopeSpan { span: 0..3, scope: "kw" },
        ScopeSpan { span: 4..5, scope: "" },
    ]);

    // `UpToAny` on its own, in the base mode. It stops at a *spelling*, so a
    // multi-character terminator is not confused with its first character: under
    // a ``` stop, a lone backtick is content.
    let fence = TokenRule { matcher: Exact("```"), emit: Bare(Punct) };
    let raw_text = TokenRule { matcher: UpToAny(["```", "{"], #{}), emit: Of(Raw) };
    let raw = "a`b```";
    assert(lex_kinds(raw, [fence, raw_text])? == [Raw("a`b"), Punct]);

    // An escaped stop stays inside the run, and an unknown escape is the same
    // hard error `Delimited` raises.
    let text0 = TokenRule { matcher: UpToAny(["`", "{"], """\`{""".to_set()), emit: Of(Tpl) };
    let esc = """a\`b""";
    assert(lex_kinds(esc, [text0])? == [Tpl(esc)]);
    assert(lex("""a\qb""", [text0]).is_err_and(|e| e.message == """unknown escape sequence \q"""));

    // Running to the end of the source is a match, not an error: an unclosed
    // construct is the mode's to report, and this rule set opens no mode.
    assert(lex_kinds("abc", [raw_text])? == [Raw("abc")]);

    // Trivia: a `trivia: true` rule is consumed like a skip rule, but each match
    // is recorded in the result's side-channel, out of the token stream.
    // `ToEolUnless`: a marker that also leads something else. `#` opens a doc
    // comment, except before `{` (a set literal) or `[` (the lint marker),
    // which the rules after it claim.
    let doc_r: TokenRule<Kind> = TokenRule {
        matcher: ToEolUnless("#", #{'{', '['}),
        emit: Of(Str),
    };
    let punct_r: TokenRule<Kind> = TokenRule {
        matcher: OneChar("#{}".to_set()),
        emit: Bare(Punct),
    };
    let docs = [ws, doc_r, punct_r, ident, digits];
    assert(lex_kinds("# hi\na", docs)? == [Str("# hi"), Ident("a")]);
    // The blocked leads fall through to the rule that wants them.
    assert(lex_kinds("#{a}", docs)? == [Punct, Punct, Ident("a"), Punct]);

    // A bare marker at end of line is an empty comment, not a blocked one:
    // there is no following character to block it.
    assert(lex_kinds("#\na", docs)? == [Str("#"), Ident("a")]);

    let cmt_t = TokenRule { matcher: ToEol("//"), emit: Bare(Comment), trivia: true };
    let allow_t = TokenRule { matcher: Exact("#[allow]"), emit: Bare(Allow), trivia: true };
    let trv = [ws, cmt_t, allow_t, ident, digits];
    assert(lex("a #[allow] // b\nc", trv)? == LexResult {
        tokens: [
            tok("a #[allow] // b\nc", Ident("a"), 0..1),
            tok("a #[allow] // b\nc", Ident("c"), 16..17),
        ],
        trivia: [
            tok("a #[allow] // b\nc", Allow, 2..10),
            tok("a #[allow] // b\nc", Comment, 11..15),
        ],
    });

    // Trivia inside a template interpolation is recorded like any other: the
    // interpolation is lexed by the ordinary rules, so there is nothing for the
    // template to do about it.
    let trvt = [cmt_t, ..tpl_rules];
    let commented = "`a{x // c\n}b`";
    assert(lex(commented, trvt)? == LexResult {
        tokens: [
            tok(commented, Punct, 0..1),
            tok(commented, Tpl("a"), 1..2),
            tok(commented, Punct, 2..3),
            tok(commented, Ident("x"), 3..4),
            tok(commented, Punct, 10..11),
            tok(commented, Tpl("b"), 11..12),
            tok(commented, Punct, 12..13),
        ],
        trivia: [tok(commented, Comment, 5..9)],
    });

    // ToEol with skip: comments are dropped like whitespace.
    let cmt = [ws, TokenRule { matcher: ToEol("//"), emit: Bare(Comment), skip: true }, ident];
    assert(lex_kinds("a // b\nc", cmt)? == [Ident("a"), Ident("c")]);
    assert(lex_kinds("// only", cmt)? == []);

    // --- Rule sets resembling real languages. ---

    // JSON: strings, numbers, keywords, punctuation.
    let json = [
        ws,
        TokenRule {
            matcher: Delimited(`"`.to_set(), escaped=`"\\/bfnrtu`.to_set()),
            emit: Of(Str),
        },
        TokenRule { matcher: Float, emit: Bare(FloatTok) },
        TokenRule { matcher: Int, emit: Try(int_tok) },
        TokenRule { matcher: Keyword("true", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("false", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("null", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Exact("{"), emit: Bare(Punct) },
        TokenRule { matcher: Exact("}"), emit: Bare(Punct) },
        TokenRule { matcher: Exact("["), emit: Bare(Punct) },
        TokenRule { matcher: Exact("]"), emit: Bare(Punct) },
        TokenRule { matcher: Exact(":"), emit: Bare(Punct) },
        TokenRule { matcher: Exact(","), emit: Bare(Punct) },
        TokenRule { matcher: Exact("-"), emit: Bare(Punct) },
    ];
    let jsrc = """{"pi": 3.14, "n": [1, true]}""";
    let jtoks = [
        tok(jsrc, Punct, 0..1),
        tok(jsrc, Str("pi"), 1..5),
        tok(jsrc, Punct, 5..6),
        tok(jsrc, FloatTok, 7..11),
        tok(jsrc, Punct, 11..12),
        tok(jsrc, Str("n"), 13..16),
        tok(jsrc, Punct, 16..17),
        tok(jsrc, Punct, 18..19),
        tok(jsrc, IntTok(1), 19..20),
        tok(jsrc, Punct, 20..21),
        tok(jsrc, Kw, 22..26),
        tok(jsrc, Punct, 26..27),
        tok(jsrc, Punct, 27..28),
    ];
    assert(lex(jsrc, json)? == toks(jtoks));

    // AIPL: keywords, multi-byte operators, strings, skipped line comments.
    let aipl = [
        ws,
        TokenRule { matcher: ToEol("//"), emit: Bare(Comment), skip: true },
        TokenRule { matcher: Keyword("fn", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("let", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("mut", alnum), emit: Bare(Kw) },
        TokenRule { matcher: Keyword("set", alnum), emit: Bare(Kw) },
        ident,
        TokenRule { matcher: Int, emit: Try(int_tok) },
        TokenRule { matcher: Delimited(`"`.to_set(), escaped=`ntr\\"`.to_set()), emit: Of(Str) },
        TokenRule { matcher: Exact("=="), emit: Bare(Op) },
        TokenRule { matcher: Exact("->"), emit: Bare(Op) },
        TokenRule { matcher: Exact("&&"), emit: Bare(Op) },
        TokenRule { matcher: Exact("="), emit: Bare(Op) },
        TokenRule { matcher: Exact(";"), emit: Bare(Op) },
    ];
    let asrc = `let ok = s == "hi"; // check`;
    let atoks = [
        tok(asrc, Kw, 0..3),
        tok(asrc, Ident("ok"), 4..6),
        tok(asrc, Op, 7..8),
        tok(asrc, Ident("s"), 9..10),
        tok(asrc, Op, 11..13),
        tok(asrc, Str("hi"), 14..18),
        tok(asrc, Op, 18..19),
    ];
    assert(lex(asrc, aipl)? == toks(atoks));
})
