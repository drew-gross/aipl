// The AST `grammar_sexp.aipl` lowers to, and its canonical rendering. Its own
// file because its `Atom` and the token kind's `Atom` are two names for one
// idea at two levels, and a file holds one of each: `grammar_sexp.aipl`
// imports this one as `AtomNode`.
import { equal as ==, join, map, maximum, repeat, value_or, wrapping_add as + } from builtins;
import { parse_sexp } from "./grammar_sexp.aipl";

# The AST an S-expression lowers to: a bare atom, or a list of them. Recursive
# through an array, so a `Sexp` is a refcounted heap block — the shape a
# `build` function value had to be proven able to return.
variant Sexp = Atom(str) | List(Sexp[])

# `self` printed back as S-expression source, in the one canonical spelling:
# atoms as themselves, a list as its elements joined by single spaces.
#
# Round-trips with `parse_sexp` — `parse_sexp(render_sexp(v)) == v` for every
# `v` — which is what makes the pair a usable end-to-end check of the library.
pub fn render_sexp(self: Sexp) -> str {
    match (self) {
        Atom(a) => a,
        List(xs) => `({xs.map(render_sexp).join(sep=" ")})`,
    }
}.test({
    // ---- round trip: parse -> lower -> render -> parse ----
    //
    // Rendering is canonical, so the second parse is what the assertion turns
    // on: whatever layout the source had, the value survives the round trip.
    let src = "(define (square x) (* x x))";
    let v = parse_sexp(src)?;
    assert(v.render_sexp() == src);
    assert(parse_sexp(v.render_sexp())? == v);

    // ... including from a source `render_sexp` would never have written.
    let messy = "( a  ; comment\n   (b) )";
    let mv = parse_sexp(messy)?;
    assert(mv.render_sexp() == "(a (b))");
    assert(parse_sexp(mv.render_sexp())? == mv);
    assert(render_sexp(List([])) == "()");

    // ---- deep nesting, on the 8 MB stack a shipped binary gets ----
    //
    // 200 levels of `((((...))))`. Under `aipl check` this runs on the CLI's
    // 256 MB thread stack, which would prove nothing; the case harness also
    // links this `.test` driver into an ordinary binary and runs *that*, and
    // that run is what the depth is aimed at.
    let n: u64 = 200;
    let opens = "(".repeat(n);
    let closes = ")".repeat(n);
    let deep = `{opens}{closes}`;
    let dv = parse_sexp(deep)?;
    assert(dv.depth() == n);

    // Rendering and re-parsing at that depth too — every pass over the tree is
    // as deep as the input, not just the parse.
    assert(dv.render_sexp() == deep);
    assert(parse_sexp(dv.render_sexp())? == dv);
})

// ---------- test-only helpers ----------

# How deeply `self` nests: an atom is 0, a list one more than its deepest
# element. The deep-nesting assertion's whole content — a parse that silently
# stopped early would show up here as a shallower tree.
fn depth(self: Sexp) -> u64 {
    match (self) {
        Atom(_) => 0,
        List(xs) => xs.map(depth).maximum().value_or(0) + 1,
    }
}
