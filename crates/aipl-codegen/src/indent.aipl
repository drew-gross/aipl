// The content half of the formatter's raw-block re-layout (see `reindent_block`):
// indents a block of text — the lines *between* a raw-string / template atom's
// delimiters, with no `"""` / ``` ``` ``` framing — by a chosen column. Split out
// so `reindent_block` deals only with the delimiters. Assumes the input is already
// fully dedented (its common indent is 0): it *adds* `target` spaces, it does not
// rebase an existing indent — `reindent_block` dedents first (via `dedent`).
import { concat as +++, equal as ==, is_all_whitespace, join, map, repeat } from builtins;
import { lines } from "./lines.aipl";

pub fn indent(self: str, target: u64) -> str {
    let pad = " ".repeat(target);

    // Add `target` spaces to each non-blank line, keeping its own (already
    // dedented) relative indent. A blank line stays empty — indenting it would
    // add trailing whitespace (illegal), and a dedented block emits blanks empty.
    self
        .lines()
        .map(|line| if (line.is_all_whitespace()) { "" } else { pad +++ line })
        .join(sep="\n")
}.doc("""
    Indents every non-blank line of `self` by `target` spaces, keeping each line's
    own relative indentation; blank (empty or all-whitespace) lines are emitted
    empty. Assumes `self` is already fully dedented — it *adds* indentation, it does
    not rebase an existing common indent to `target`. The inverse of `dedent`;
    `reindent_block` dedents the raw-block content before calling this.
""").test({
    // A dedented block is indented by the target, line for line.
    assert("a\nb".indent(4) == "    a\n    b");
    // Relative indent is preserved: a deeper line keeps its extra 2 spaces.
    assert("a\n  b".indent(4) == "    a\n      b");
    // Blank lines stay empty — indentation is added, not applied to blank lines.
    assert("a\n\nb".indent(2) == "  a\n\n  b");
    // A whitespace-only line is emitted empty, not indented to the target.
    assert("a\n   \nb".indent(2) == "  a\n\n  b");
    // A single line is indented to the target.
    assert("x".indent(2) == "  x");
    // Target 0 is a no-op.
    assert("a\n  b".indent(0) == "a\n  b");
})
