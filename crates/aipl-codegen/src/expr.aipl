# `aipl_syntax::ast::Expr` and `ExprKind` as AIPL declares them, with the
# structural dump the lowering's tests assert against. One of the files the
# AST is declared across; see `ast.aipl`.

import {
    Span,
    as_case,
    collect_ok,
    equal as ==,
    find_if,
    first,
    is_empty,
    join,
    logical_not as !,
    map,
    max,
    min,
    not_equal as !=,
    push,
    to_array,
    value_or,
    zip_with,
} from builtins;
import { Ctor, Pat, Wildcard, pat_bindings, show_pat } from "./pat.aipl";
import { I64 } from "./prim.aipl";
import {
    Array,
    Desc,
    Named,
    Primitive,
    SetOrder,
    Ty,
    TypeVar,
    Unordered,
    promoted,
    show_order,
    show_ty,
} from "./ty.aipl";

# block) where its *value* is.
#
# The span is this node's *token* span: every token the node was built from,
# closing bracket and unary operator included. A span kept for diagnostics alone
# can be narrower than that — it only has to point somewhere useful — but a
# formatter needs the extent, so this one records it.
#
# `value_span` is a block's tail position: `fn f() -> str { let a = 1; a }`
# returns the `a`, but the body's span starts at the `let`, so a return-type
# error would underline the binding. It is recorded while the block is being
# built, where the tail is in hand, rather than re-walked at every diagnostic.
#
# Rust spells it `Option<Box<Span>>`; here it is a plain `Span` with the *empty*
# one meaning "none", which is the convention already in force for a location
# that does not exist (see `join_spans`). A struct field could not be an optional
# struct when this was written, so there was no choice; it can be one now, and
# the two spellings mean the same thing either way, since a recorded value span
# is never empty: the repair that fills it in runs first.
#
# `name_span` is where the node's *name* is written: the field in `p.x`/`p$x`, the
# callee in `f(a)`/`p.f(a)`, the identifier of an `Ident` or `Construct`, the
# binder of a `Let`. The node's own span covers the whole construct, which cannot
# say where inside it the name sits; a language server needs exactly that. Like
# `value_span` it is a plain `Span`, with the empty one meaning "none" (a
# synthesized node has no name written anywhere).
#
# `source` is the text `span` covers, so a lint can quote what the author wrote
# without being handed the file. It is the empty string on a node the parser
# synthesized, and on every node until `with_source_text` has filled it in. Rust
# has no such field: it is read only by the lints, which run on the AIPL side.
#
# `written` is where a destructuring `let` or `for` writes the names in its
# pattern (`LetPattern` and `ForPattern` only), kept for `desugar.aipl`, which turns
# them into bindings that carry the places.
#
# The `ty` field `Expr` carries in Rust is absent — nothing the parser sets it.
struct Expr {
    kind: ExprKind,
    span: Span,
    value_span: Span,
    name_span: Span,
    source: str,
    written: WrittenNames? = none,
}

# One field of a struct literal. A `..base` spread rides as an init with an
# empty name whose *value* is the `Spread` — the value is what identifies it,
# exactly as an array-literal spread is identified by being a spread element.
#
# `name_span` is where the field name is written in `T { name: v }` or the
# shorthand `T { name }`; empty for a spread and for a synthesized init.
struct FieldInit { name: str, value: Expr, name_span: Span = 0..0 }

# One parameter of a lambda. `ty` is the annotation from `|x: i64| ..`, absent
# for the bare `|x| ..` form.
#
# `pattern` is the destructuring a parameter was written as (`|Point { x, y }| ..`,
# `|(a, b)| ..`): the parameter itself is a synthetic one named `name`, and the
# names are bound off it at the top of the body when `desugar.aipl` lowers it. Always
# `none` once that has run.
struct LambdaParam {
    name: str,
    ty: Ty?,
    span: Span,
    pattern: Destructure? = none,
    written: WrittenNames? = none,
}

# One name as it is written in a pattern, and where.
struct WrittenName { text: str, span: Span }

# The fields a struct pattern `T { a, b as c }` reads, in order, and the names it
# binds them as — `a` and `a` for a field bound under its own name.
struct WrittenStruct { fields: WrittenName[], binders: WrittenName[] }

# The names a pattern spells and where, so a language server can point at them.
# `Pat` keeps names as text, which is all the compiler needs; this is the part of
# the source it drops.
#
# `cases` are the constructors the pattern names, `binders` the names it binds
# (outside any struct pattern), and `structs` one entry per struct pattern, in
# source order.
struct WrittenNames {
    cases: WrittenName[] = [],
    binders: WrittenName[] = [],
    structs: WrittenStruct[] = [],
}

# Where `self` writes `text`, or the empty span for a name that is not written.
pub fn span_named(self: WrittenName[], text: str) -> Span {
    self.find_if(|name| name.text == text)$span.value_or(0..0)
}.test({
    let names = [WrittenName { text: "a", span: 1..2 }, WrittenName { text: "b", span: 4..5 }];
    assert(names.span_named("b") == 4..5);
    assert(names.span_named("c") == 0..0);
})

# Where a pattern writes the binder `text`, whether directly or in one of its
# struct patterns; the empty span if it does not.
pub fn binder_span(self: WrittenNames, text: str) -> Span {
    let found = self.binders.span_named(text);
    if (found != 0..0) {
        return found;
    };
    self.structs$binders.join().span_named(text)
}.test({
    let direct = WrittenName { text: "a", span: 1..2 };
    let inner = WrittenName { text: "x", span: 6..7 };
    let names = WrittenNames {
        cases: [],
        binders: [direct],
        structs: [WrittenStruct { fields: [inner], binders: [inner] }],
    };
    assert(names.binder_span("a") == 1..2);
    assert(names.binder_span("x") == 6..7);
    assert(names.binder_span("y") == 0..0);
})

# The `i`th struct pattern's part of `self`: nothing written if there is none.
pub fn struct_written(self: WrittenNames, i: u64) -> WrittenStruct {
    self.structs[i].value_or(WrittenStruct { fields: [], binders: [] })
}.test({
    let written = WrittenStruct { fields: [WrittenName { text: "f", span: 2..3 }], binders: [] };
    let names = WrittenNames { cases: [], binders: [], structs: [written] };
    assert(names.struct_written(0) == written);
    assert(names.struct_written(1).fields == []);
})

# One arm of a `match`, and the `then` half of an `if let`. Its span is the
# *pattern's*, so a diagnostic points at what selected the arm rather than at
# everything it does. `written` is where the pattern's names are written.
struct MatchArm { pattern: Pat, body: Expr, span: Span, written: WrittenNames? = none }

# Where `self`'s pattern writes its names; nothing for an arm a pass made up.
pub fn names_written(self: MatchArm) -> WrittenNames {
    self.written.value_or(WrittenNames { cases: [], binders: [], structs: [] })
}.test({
    let arm = MatchArm { pattern: Wildcard, body: ident("x"), span: 0..0 };
    assert(arm.names_written().cases == []);
    let named = WrittenNames {
        cases: [WrittenName { text: "A", span: 1..2 }],
        binders: [],
        structs: [],
    };
    assert(MatchArm { ..arm, written: some(named) }.names_written() == named);
})

# `aipl_syntax::ast::ExprKind`, all 32 cases.
#
# Several surface forms are gone by the time they get here, because the AST is
# where the language stops having them: an operator is an `Call` on its
# spelling, a range is an `Construct` of the builtin `Span`, a template is a
# chain of concat calls, and a block is a right-nested `Seq`. Each is done in
# the lowering, so nothing downstream has to know the surface form existed.
#
# `Call`'s `method_style` is the one bit that says which spelling was written:
# `recv.f(a)` is stored as the free call `f(recv, a)` with the flag set, so the
# receiver is `args[0]` either way.
variant ExprKind =
    | Num(i64)
    | Bool(bool)
    | Str(str)
    | Char(char)
    | Ident(str)
    | Call(name: str, args: Expr[], method_style: bool)
    | Neg(Expr)
    | If(Expr, Expr, Expr)
    | Construct(str, FieldInit[])
    | Field(Expr, str)
    | Let(name: str, ty: Ty?, value: Expr, body: Expr)
    | LetMut(name: str, ty: Ty?, value: Expr, body: Expr)
    | Assign(lhs: Expr, value: Expr, body: Expr)
    # The loop's element binder, what it walks, its body, and the *index*
    # binder of the two-binder form `for (let i, x : xs)` (`none` for the plain
    # form). What an index is depends on what is iterated — a position over an
    # array, the key over a dict — so it survives parsing and mono lowers it.
    #
    # `index` is deliberately the *last* slot rather than beside `name`: the
    # artifact that compiles the next one is the previous one, so a slot added
    # at the end lets the decoder (`ffi_ast.rs`) read an artifact built before
    # it as the plain loop it was, and the bootstrap costs nothing.
    | For(name: str, iterable: Expr, body: Expr, index: str? = none)
    | While(cond: Expr, body: Expr)
    | Shim(effect: str, bindings: (str, str)[], body: Expr)
    | None
    | Match(Expr, MatchArm[])
    | IfLet(MatchArm, Expr, Expr)
    | ArrayLit(Expr[])
    | Spread(Expr)
    | SetLit(Expr[], SetOrder)
    | DictLit((Expr, Expr)[])
    | Index(Expr, Expr)
    # `receiver[start..end]`, with either bound left out: `receiver[start..]` has
    # no `end`, `receiver[..end]` has no `start`, and each is `none` rather than a
    # stand-in value, so a bound that is present is one the author wrote. A missing
    # bound means the receiver's own edge — the start clamps to the beginning, the
    # end to the length — and `receiver[..]` is not a form.
    | Slice(receiver: Expr, start: Expr?, end: Expr?)
    | Try(Expr)
    | Unit
    | Seq(Expr, Expr)
    | Return(Expr)
    | Lambda(LambdaParam[], Expr)
    | TupleLit(Expr[])
    | KwArg(name: str, value: Expr, forwarded: bool)
    # `f::<T, U>(args)`: the call, and the types written between the angles.
    # Last in the variant so an artifact built before it decodes as it always did.
    | TypeArgs(Expr, Ty[])
    # `let T { x, y } = v; rest`, `let (a, b) = v; rest` and `let Case(a) = v; rest`:
    # the pattern, what it takes apart, and the rest of the block. Written
    # syntax, kept as it was written so the lints see it; `desugar.aipl` lowers it
    # to the `let`s and `match`es that bind the names, and nothing downstream of
    # it ever sees the node.
    | LetPattern(pattern: Destructure, value: Expr, body: Expr)
    # `for (let (a, b) : xs) { .. }` and its struct and case twins, with the
    # optional index binder. Lowered by `desugar.aipl` like `LetPattern`.
    | ForPattern(pattern: Destructure, iterable: Expr, body: Expr, index: str? = none)

# What a `let`, a `for` or a parameter takes a value apart with, as written. A
# tuple's slots are its positions, so only the names are kept; a case's payload
# is bound in order; a struct names the fields it reads and what each is bound as,
# and `mutable` is the `mut T { .. } = v` form.
variant Destructure =
    | ByTuple(names: str[])
    | ByCase(case_name: str, names: str[])
    | ByStruct(struct_name: str, fields: str[], names: str[], mutable: bool)
    # A pattern with something nested in it, `Case(Point { x, y })` or
    # `(Point { x }, n)`, which the forms above cannot spell. It is read the way a
    # `match` arm is, so it is any pattern an arm takes; whether it can fail to
    # match is for the type checker to say, as it is for `ByCase`.
    | ByPattern(pattern: Pat)

# Two spans as the one that covers both — `aipl_syntax::join_spans`, mirrored.
#
# The rule that matters is the empty one: an *empty* span is the "no location"
# placeholder a construct with no text of its own carries (an empty block body,
# a synthesized node), and it must not take part in a join. Written naively as
# `a.start..b.end` it drags every enclosing construct's end back to offset 0,
# which is a span that ends before it starts — and a caret rendered from one is
# nonsense. Contributing nothing is the honest answer.
pub fn join_spans(a: Span, b: Span) -> Span {
    if (a.start == a.end) {
        return b;
    };
    if (b.start == b.end) {
        return a;
    };
    min(a.start, b.start)..max(a.end, b.end)
}

# An expression as a one-line structural dump. Spans are left out: they are what
# 5e has to settle and what would make every assertion unreadable in the
# meantime, and none of them is what a lowering test is asking about.
#
# A free call renders `f(a, b)` and a method call `a.f(b)`, so the `method_style`
# flag is visible without a tag of its own — the two spellings are the two
# things it distinguishes.
pub fn show_expr(self: Expr) -> str {
    match (self.kind) {
        Num(n) => `{n}`,
        Bool(b) => if (b) { "true" } else { "false" },
        Str(s) => `Str({s})`,
        Char(c) => `Char({c})`,
        Ident(n) => n,
        Call(name, args, method_style) => show_call(name, args, method_style),
        Neg(e) => `Neg({e.show_expr()})`,
        If(c, t, f) => `If({c.show_expr()}, {t.show_expr()}, {f.show_expr()})`,
        Construct(name, fields) => `Construct({name}, [{show_field_inits(fields)}])`,
        Field(e, name) => `{e.show_expr()}.{name}`,
        Let(name, ty, value, body) => `Let({name}{show_ann(ty)}, {value.show_expr()}, {body.show_expr()})`,
        LetMut(name, ty, value, body) => `Mut({name}{show_ann(ty)}, {value.show_expr()}, {body.show_expr()})`,
        Assign(lhs, value, body) => `Assign({lhs.show_expr()}, {value.show_expr()}, {body.show_expr()})`,
        For(name, iterable, body, index) => match (index) {
            // Bracketed so a plain loop prints exactly as it always has and an
            // indexed one is unmistakable.
            some(i) => `For([{i}], {name}, {iterable.show_expr()}, {body.show_expr()})`,
            none => `For({name}, {iterable.show_expr()}, {body.show_expr()})`,
        },
        While(cond, body) => `While({cond.show_expr()}, {body.show_expr()})`,
        Shim(effect, bindings, body) => `Shim({effect}, [{show_binds(bindings)}], {body.show_expr()})`,
        None => "none",
        Match(e, arms) => `Match({e.show_expr()}, [{show_arms(arms)}])`,
        IfLet(arm, e, f) => `IfLet({arm.show_arm()}, {e.show_expr()}, {f.show_expr()})`,
        ArrayLit(es) => `[{show_exprs(es)}]`,
        Spread(e) => `..{e.show_expr()}`,
        SetLit(es, o) => `Set([{show_exprs(es)}]{o.show_order()})`,
        DictLit(ps) => `Dict([{ps$show_dict_entry().join(sep=", ")}])`,
        Index(a, i) => `Index({a.show_expr()}, {i.show_expr()})`,
        Slice(a, lo, hi) => `Slice({a.show_expr()}, {show_opt_expr(lo)}, {show_opt_expr(hi)})`,
        Try(e) => `Try({e.show_expr()})`,
        Unit => "()",
        Seq(a, b) => `Seq({a.show_expr()}, {b.show_expr()})`,
        Return(e) => `Return({e.show_expr()})`,
        Lambda(ps, body) => `Lambda([{ps$show_lambda_param().join(sep=", ")}], {body.show_expr()})`,
        TupleLit(es) => `Tuple({show_exprs(es)})`,
        TypeArgs(call, tys) => `TypeArgs({call.show_expr()}, [{tys.map(show_ty).join(sep=", ")}])`,
        KwArg(name, value, forwarded) => if (forwarded) {
            `KwFwd({name}, {value.show_expr()})`
        } else {
            `Kw({name}, {value.show_expr()})`
        },
        LetPattern(pattern, value, body) => `LetPattern({pattern.show_destructure()}, {value.show_expr()}, {body.show_expr()})`,
        ForPattern(pattern, iterable, body, index) => match (index) {
            some(i) => `ForPattern([{i}], {pattern.show_destructure()}, {iterable.show_expr()}, {body.show_expr()})`,
            none => `ForPattern({pattern.show_destructure()}, {iterable.show_expr()}, {body.show_expr()})`,
        },
    }
}.test({
    let three = num(3);
    assert(three.show_expr() == "3");
    assert(ident("x").show_expr() == "x");
    assert(expr(Str("hi")).show_expr() == "Str(hi)");
    assert(expr(Char('c')).show_expr() == "Char(c)");
    assert(expr(Bool(true)).show_expr() == "true");
    assert(expr(None).show_expr() == "none");
    assert(expr(Unit).show_expr() == "()");
    assert(expr(Neg(three)).show_expr() == "Neg(3)");
    // The two call spellings, which is what `method_style` is for.
    assert(expr(Call("+", [three, three], false)).show_expr() == "+(3, 3)");
    assert(expr(Call("f", [ident("xs"), three], true)).show_expr() == "xs.f(3)");
    assert(expr(Call("f", [ident("xs")], true)).show_expr() == "xs.f()");
    assert(expr(Field(ident("p"), "x")).show_expr() == "p.x");
    assert(expr(Spread(ident("xs"))).show_expr() == "..xs");
    assert(expr(ArrayLit([three, three])).show_expr() == "[3, 3]");
    assert(expr(TupleLit([three, ident("x")])).show_expr() == "Tuple(3, x)");
    assert(expr(SetLit([three], Unordered)).show_expr() == "Set([3])");
    assert(expr(SetLit([three], Desc)).show_expr() == "Set([3], Desc)");
    assert(expr(DictLit([(three, ident("v"))])).show_expr() == "Dict([3: v])");
    assert(expr(Slice(ident("s"), some(three), none)).show_expr() == "Slice(s, 3, )");
    assert(expr(Slice(ident("s"), none, some(three))).show_expr() == "Slice(s, , 3)");
    assert(expr(Slice(ident("s"), some(three), some(three))).show_expr() == "Slice(s, 3, 3)");

    // The annotation is written where the source writes it, and vanishes when
    // there is none.
    let i64_ty: Ty = Primitive(I64);
    assert(
        expr(TypeArgs(
            expr(Call("f", [three], false)),
            [i64_ty],
        )).show_expr() == "TypeArgs(f(3), [i64])",
    );
    assert(expr(Let("x", none, three, ident("x"))).show_expr() == "Let(x, 3, x)");
    assert(expr(LetMut("x", some(i64_ty), three, ident("x"))).show_expr() == "Mut(x: i64, 3, x)");
    assert(
        expr(Shim("prints", [("print", "p")], three)).show_expr() == "Shim(prints, [print = p], 3)",
    );
    let arm = MatchArm { pattern: Ctor("some", bindings=["v"]), body: ident("v"), span: 0..0 };
    assert(expr(Match(ident("o"), [arm])).show_expr() == "Match(o, [some(v) => v])");
    assert(
        expr(Lambda(
            [LambdaParam { name: "x", ty: none, span: 0..0 }],
            three,
        )).show_expr() == "Lambda([x], 3)",
    );
    assert(
        expr(Lambda(
            [LambdaParam { name: "x", ty: some(i64_ty), span: 0..0 }],
            three,
        )).show_expr() == "Lambda([x: i64], 3)",
    );
})

# An `Expr` at an empty span — the shorthand this file's own tests are written
# with, and the one every synthesized node uses (a template's `Str` segments,
# An expression node at a span — the constructor every lowering uses.
pub fn at(kind: ExprKind, span: Span) -> Expr {
    kind,
    span,
    value_span: 0..0,
    name_span: 0..0,
    source: "",
}

# an else-less `if`'s unit branch, an open slice's `0`).
pub fn expr(kind: ExprKind) -> Expr {
    kind,
    span: 0..0,
    value_span: 0..0,
    name_span: 0..0,
    source: "",
}

# `self` with the span of its name recorded — see `Expr`.
pub fn named_at(self: Expr, name_span: Span) -> Expr { ..self, name_span }.test({
    assert(at(Ident("x"), 4..9).named_at(4..5).name_span == 4..5);
    assert(at(Ident("x"), 4..9).named_at(4..5).span == 4..9);
    assert(expr(Num(1)).name_span == 0..0);
})

# The two synthesized leaves that come up most.
pub fn num(v: i64) -> Expr { expr(Num(v)) }

pub fn ident(name: str) -> Expr { expr(Ident(name)) }

# One match arm as `pattern => body`.
pub fn show_arm(self: MatchArm) -> str { `{self.pattern.show_pat()} => {self.body.show_expr()}` }

fn show_arms(self: MatchArm[]) -> str { self$show_arm().join(sep=", ") }

# A call, in the spelling its `method_style` flag says was written: the receiver
# is `args[0]` for a method call and an ordinary argument for a free one.
fn show_call(name: str, args: Expr[], method_style: bool) -> str {
    if (!method_style) {
        return `{name}({show_exprs(args)})`;
    };
    match (args.first()) {
        some(recv) => `{recv.show_expr()}.{name}({show_exprs(args[1..])})`,
        none => `{name}({show_exprs(args)})`,
    }
}

pub fn show_exprs(self: Expr[]) -> str { self$show_expr().join(sep=", ") }

fn show_opt_expr(self: Expr?) -> str { self$show_expr().value_or("") }

# `: T` when a binding or a lambda parameter was annotated, and nothing when it
# was not — so the dump reads like the source did.
fn show_ann(self: Ty?) -> str { self.map(|t| `: {t.show_ty()}`).value_or("") }

fn show_lambda_param(self: LambdaParam) -> str { `{self.name}{show_ann(self.ty)}` }

fn show_field_init(self: FieldInit) -> str {
    if (self.name.is_empty()) {
        return self.value.show_expr();
    };
    `{self.name}: {self.value.show_expr()}`
}

fn show_field_inits(self: FieldInit[]) -> str { self$show_field_init().join(sep=", ") }

fn show_dict_entry(self: (Expr, Expr)) -> str { `{self.0.show_expr()}: {self.1.show_expr()}` }

fn show_binds(self: (str, str)[]) -> str { self$show_bind().join(sep=", ") }

fn show_bind(self: (str, str)) -> str { `{self.0} = {self.1}` }

// The helpers below are loops rather than `xs.map(..)`: a function-typed
// parameter can be called from a loop, but not captured by a lambda (`call to
// undefined fn "f"`) and not passed to `map` by name (`expected (Expr) -> _,
// got (Expr) -> Expr`). Each carries the `#[allow]` the loop lint wants.
# `f` applied to each of `xs`.
# A destructuring pattern as one line, for the dump: `(a, b)`, `Case(a, b)`,
# `T { x as a, y }` (and `mut T { .. }`). A field bound under its own name prints
# bare.
fn show_destructure(self: Destructure) -> str {
    match (self) {
        ByTuple(names) => `({names.join(sep=", ")})`,
        ByCase(case_name, names) => `{case_name}({names.join(sep=", ")})`,
        ByStruct(struct_name, fields, names, mutable) => {
            let reads = zip_with(
                fields,
                names,
                |field: str, name: str| if (field == name) { name } else { `{field} as {name}` },
            );
            `{if (mutable) { "mut " } else { "" }}{struct_name} \{ {reads.join(sep=", ")} }`
        },
        ByPattern(pattern) => pattern.show_pat(),
    }
}.test({
    assert(
        ByPattern(Pat.Tuple([
            Pat.Struct("P", ["x"], ["x"]),
            Ctor("n"),
        ])).show_destructure() == "(P { x }, n)",
    );
    assert(ByTuple(["a", "b"]).show_destructure() == "(a, b)");
    assert(ByCase("Pair", ["a", "_"]).show_destructure() == "Pair(a, _)");
    assert(ByStruct("P", ["x", "y"], ["x", "b"], false).show_destructure() == "P { x, y as b }");
    assert(ByStruct("P", ["x"], ["x"], true).show_destructure() == "mut P { x }");
})

fn each_mapped(xs: Expr[], f: (Expr) -> Expr) -> Expr[] {
    mut mapped: Expr[] = []; #[allow]
    for (let x : xs) {
        set mapped.push(f(x));
    }
    mapped
}

# `f` applied to `x` when it is present.
fn optional_mapped(x: Expr?, f: (Expr) -> Expr) -> Expr? {
    if (let some(e) = x) { some(f(e)) } else { none }
}

# `f` applied to the value of each field initializer.
fn inits_mapped(inits: FieldInit[], f: (Expr) -> Expr) -> FieldInit[] {
    mut mapped: FieldInit[] = []; #[allow]
    for (let i : inits) {
        set mapped.push(FieldInit { ..i, value: f(i.value) });
    }
    mapped
}

# `f` applied to the body of each arm.
fn arms_mapped(arms: MatchArm[], f: (Expr) -> Expr) -> MatchArm[] {
    mut mapped: MatchArm[] = []; #[allow]
    for (let a : arms) {
        set mapped.push(MatchArm { ..a, body: f(a.body) });
    }
    mapped
}

# Both halves of each entry of a dict literal mapped by `f`. (`pairs.map(|p|
# (f(p.0), f(p.1)))` panics the compiler: "Synthetic-type members cannot be
# unit".)
fn pairs_mapped(pairs: (Expr, Expr)[], f: (Expr) -> Expr) -> (Expr, Expr)[] {
    mut mapped: (Expr, Expr)[] = []; #[allow]
    for (let p : pairs) {
        set mapped.push((f(p.0), f(p.1)));
    }
    mapped
}

# `Neg(e)`: the node `map_subexprs`'s tests map with, easy to see in a dump.
fn wrap(e: Expr) -> Expr { expr(Neg(e)) }

# `self` with `f` applied to each of its direct sub-expressions, and nothing
# else changed: not `self`'s own kind payload (names, types, patterns), not its
# spans, and not the sub-expressions' own children — a pass that wants to reach
# those recurses through `f`. The sub-expressions are the same ones Rust's
# `each_subexpr` walks: a `Shim`'s bindings name functions and a pattern binds
# names, so only a shim's body and an arm's body nest expressions.
pub fn map_subexprs(self: Expr, f: (Expr) -> Expr) -> Expr {
    let kind = match (self.kind) {
        Num(..) | Bool(..) | Str(..) | Char(..) | Ident(..) | None | Unit => self.kind,
        Call(name, args, method_style) => Call(name, each_mapped(args, f), method_style),
        Neg(x) => Neg(f(x)),
        If(cond, then_branch, else_branch) => If(f(cond), f(then_branch), f(else_branch)),
        Construct(name, inits) => Construct(name, inits_mapped(inits, f)),
        Field(x, name) => Field(f(x), name),
        Let(name, ty, value, body) => Let(name, ty, f(value), f(body)),
        LetMut(name, ty, value, body) => LetMut(name, ty, f(value), f(body)),
        Assign(lhs, value, body) => Assign(f(lhs), f(value), f(body)),
        For(name, iterable, body, index) => For(name, f(iterable), f(body), index=index),
        While(cond, body) => While(f(cond), f(body)),
        Shim(effect, bindings, body) => Shim(effect, bindings, f(body)),
        Match(scrutinee, arms) => Match(f(scrutinee), arms_mapped(arms, f)),
        IfLet(arm, scrutinee, else_branch) => IfLet(
            MatchArm { ..arm, body: f(arm.body) },
            f(scrutinee),
            f(else_branch),
        ),
        ArrayLit(elements) => ArrayLit(each_mapped(elements, f)),
        Spread(x) => Spread(f(x)),
        SetLit(elements, order) => SetLit(each_mapped(elements, f), order),
        DictLit(pairs) => DictLit(pairs_mapped(pairs, f)),
        Index(obj, index) => Index(f(obj), f(index)),
        Slice(obj, start, end) => Slice(f(obj), optional_mapped(start, f), optional_mapped(end, f)),
        Try(x) => Try(f(x)),
        Seq(first, rest) => Seq(f(first), f(rest)),
        Return(x) => Return(f(x)),
        Lambda(params, body) => Lambda(params, f(body)),
        TupleLit(elements) => TupleLit(each_mapped(elements, f)),
        KwArg(name, value, forwarded) => KwArg(name, f(value), forwarded),
        TypeArgs(x, types) => TypeArgs(f(x), types),
        LetPattern(pattern, value, body) => LetPattern(pattern, f(value), f(body)),
        ForPattern(pattern, iterable, body, index) => ForPattern(
            pattern,
            f(iterable),
            f(body),
            index=index,
        ),
    };
    Expr { ..self, kind }
}.test({
    // A leaf has nothing to map.
    assert(ident("x").map_subexprs(wrap).show_expr() == "x");
    // Only the direct children are wrapped, not their children.
    let call = expr(Call("f", [ident("a"), expr(Neg(ident("b")))], false));
    assert(
        call.map_subexprs(wrap).show_expr() == show_expr(expr(Call(
            "f",
            [expr(Neg(ident("a"))), expr(Neg(expr(Neg(ident("b")))))],
            false,
        ))),
    );
    // A binder's name and type are not sub-expressions; its value and body are.
    let bound = expr(Let("v", none, ident("a"), ident("b")));
    assert(
        bound.map_subexprs(wrap).show_expr() == show_expr(expr(Let(
            "v",
            none,
            wrap(ident("a")),
            wrap(ident("b")),
        ))),
    );
    // An optional child is mapped when present and left absent otherwise.
    let open = expr(Slice(ident("s"), some(num(1)), none));
    assert(
        open.map_subexprs(wrap).show_expr() == show_expr(expr(Slice(
            wrap(ident("s")),
            some(wrap(num(1))),
            none,
        ))),
    );
    let closed = expr(Slice(ident("s"), some(num(1)), some(num(2))));
    assert(
        closed.map_subexprs(wrap).show_expr() == show_expr(expr(Slice(
            wrap(ident("s")),
            some(wrap(num(1))),
            some(wrap(num(2))),
        ))),
    );
    let unbounded_start = expr(Slice(ident("s"), none, some(num(2))));
    assert(
        unbounded_start.map_subexprs(wrap).show_expr() == show_expr(expr(Slice(
            wrap(ident("s")),
            none,
            some(wrap(num(2))),
        ))),
    );
    // A match arm's body is mapped; its pattern is not.
    let arms = expr(Match(
        ident("s"),
        [MatchArm { pattern: Ctor("some", bindings=["v"]), body: ident("v"), span: 0..0 }],
    ));
    assert(
        arms.map_subexprs(wrap).show_expr() == show_expr(expr(Match(
            wrap(ident("s")),
            [
                MatchArm {
                    pattern: Ctor("some", bindings=["v"]),
                    body: wrap(ident("v")),
                    span: 0..0,
                },
            ],
        ))),
    );
    // The node's span survives.
    assert(at(Neg(ident("x")), 3..7).map_subexprs(wrap).span == 3..7);
})

# Whether `self` is a `..xs` spread: an element of an array or set literal that
# splices a collection in, rather than an expression of its own.
pub fn is_spread(self: Expr) -> bool {
    if (let Spread(..) = self.kind) { true } else { false }
}.test({
    assert(expr(Spread(ident("xs"))).is_spread());
    assert(!ident("xs").is_spread());
})

# The direct sub-expressions of `self`, in the order Rust's `each_subexpr` visits
# them: not `self`'s own names, types or patterns, and not their children. A
# `Shim`'s bindings name functions and a pattern binds names, so only a shim's
# body and an arm's body nest expressions.
pub fn subexprs(self: Expr) -> Expr[] {
    match (self.kind) {
        Num(..) | Bool(..) | Str(..) | Char(..) | Ident(..) | None | Unit => [],
        Call(_, args, _) | ArrayLit(args) | SetLit(args, _) | TupleLit(args) => args,
        Neg(x)
        | Field(x, _)
        | Try(x)
        | Return(x)
        | KwArg(_, x, _)
        | TypeArgs(x, _)
        | Spread(x)
        | Lambda(_, x)
        | Shim(_, _, x) => [x],
        Construct(_, inits) => inits$value,
        DictLit(pairs) => pairs$to_array().join(),
        Seq(a, b)
        | Index(a, b)
        | Let(_, _, a, b)
        | LetMut(_, _, a, b)
        | For(_, a, b, _)
        | LetPattern(_, a, b)
        | ForPattern(_, a, b, _)
        | While(a, b) => [a, b],
        Assign(a, b, c) | If(a, b, c) => [a, b, c],
        Match(scrutinee, arms) => [scrutinee, ..arms$body],
        IfLet(arm, scrutinee, else_branch) => [scrutinee, arm.body, else_branch],
        Slice(receiver, start, end) => [
            receiver,
            ..start.map(|bound| [bound]).value_or([]),
            ..end.map(|bound| [bound]).value_or([]),
        ],
    }
}.test({
    assert(ident("x").subexprs() == []);
    let call = expr(Call("f", [ident("a"), num(1)], false));
    assert(call.subexprs() == [ident("a"), num(1)]);
    // A binder's name and type are not sub-expressions; its value and body are.
    assert(expr(Let("v", none, ident("a"), ident("b"))).subexprs() == [ident("a"), ident("b")]);
    // The scrutinee comes before the arms' bodies.
    let arms = expr(Match(
        ident("s"),
        [MatchArm { pattern: Ctor("some", bindings=["v"]), body: ident("v"), span: 0..0 }],
    ));
    assert(arms.subexprs() == [ident("s"), ident("v")]);
    assert(expr(DictLit([(ident("k"), ident("v"))])).subexprs() == [ident("k"), ident("v")]);
    assert(expr(Slice(ident("s"), some(num(1)), none)).subexprs() == [ident("s"), num(1)]);
    assert(expr(Slice(ident("s"), none, some(num(2)))).subexprs() == [ident("s"), num(2)]);
    assert(expr(Slice(ident("s"), some(num(1)), some(num(2)))).subexprs() == [
        ident("s"),
        num(1),
        num(2),
    ]);
})

# `self` and every expression under it with the declared type parameters in
# `vars` made `TypeVar`s in the annotations a body holds: a `let` or `mut`
# binding's, and a lambda parameter's.
pub fn promoted_annotations(self: Expr, vars: str[]) -> Expr {
    let kind = match (self.kind) {
        Let(name, ty, value, body) => Let(name, ty$promoted(vars), value, body),
        LetMut(name, ty, value, body) => LetMut(name, ty$promoted(vars), value, body),
        Lambda(params, body) => Lambda(
            params.map(|p| LambdaParam { ..p, ty: p.ty$promoted(vars) }),
            body,
        ),
        _ => self.kind,
    };
    Expr { ..self, kind }.map_subexprs(|child| child.promoted_annotations(vars))
}.test({
    let vars = ["T"];
    let annotated = expr(Let("x", some(Array(Named("T"))), ident("a"), ident("b")));
    assert(
        annotated.promoted_annotations(vars).show_expr() == show_expr(expr(Let(
            "x",
            some(Array(TypeVar("T"))),
            ident("a"),
            ident("b"),
        ))),
    );
    // A lambda's parameter, nested under a binding with no annotation.
    let lambda = expr(Lambda(
        [LambdaParam { name: "p", ty: some(Named("T")), span: 0..0 }],
        ident("p"),
    ));
    let nested = expr(Let("f", none, lambda, ident("f")));
    assert(
        nested.promoted_annotations(vars).show_expr() == show_expr(expr(Let(
            "f",
            none,
            expr(Lambda(
                [LambdaParam { name: "p", ty: some(TypeVar("T")), span: 0..0 }],
                ident("p"),
            )),
            ident("f"),
        ))),
    );
    // A name that is not declared is left alone.
    assert(annotated.promoted_annotations(["U"]).show_expr() == annotated.show_expr());
})

# A field read off a plain name: `base.field`.
struct Read { field: str, base: str }

# `self` and every expression under it, outermost first.
pub fn descendants(self: Expr) -> Expr[] { [self, ..self.subexprs()$descendants().join()] }.test({
    assert(ident("x").descendants() == [ident("x")]);
    let call = expr(Call("f", [ident("a"), expr(Neg(ident("b")))], false));
    assert(call.descendants()$show_expr() == ["f(a, Neg(b))", "a", "Neg(b)", "b"]);
})

# The field read `self` is, when it reads one off a plain name.
pub fn read(self: Expr) -> Read? {
    let Field(base, field) = self.kind.as_case(Field)?;
    let Ident(name) = base.kind.as_case(Ident)?;
    some(Read { field, base: name })
}.test({
    assert(expr(Field(ident("p"), "x")).read() == some(Read { field: "x", base: "p" }));
    // Only a plain name has fields read off it here.
    assert(expr(Field(expr(Field(ident("p"), "q")), "x")).read() == none);
    assert(ident("p").read() == none);
})

# Every field `self` and the expressions under it read off a plain name, with a
# read for each time it is read — the reads a destructuring pattern makes
# included, since taking a field apart is reading it.
pub fn field_reads(self: Expr) -> Read[] {
    [..self.descendants()$read().collect_ok(), ..self.descendants()$pattern_reads().join()]
}.test({
    let reads = expr(Seq(
        expr(Field(ident("p"), "a")),
        expr(Seq(expr(Field(ident("p"), "a")), expr(Field(ident("q"), "b")))),
    ));
    assert(reads.field_reads() == [
        Read { field: "a", base: "p" },
        Read { field: "a", base: "p" },
        Read { field: "b", base: "q" },
    ]);
    // A struct pattern reads its fields off the value it takes apart.
    let pattern = expr(LetPattern(
        ByStruct("P", ["x", "y"], ["x", "b"], false),
        ident("v"),
        ident("x"),
    ));
    assert(pattern.field_reads()$field == ["x", "y"]);
    assert(ident("x").field_reads() == []);
})

# The reads a destructuring `let` or `for` makes of the value it takes apart: one
# per field its pattern names, off a base of its own. A binding that is taken
# apart by field reads to the same names is not a place for a second pattern, so
# these count as reads like any other.
fn pattern_reads(self: Expr) -> Read[] {
    match (self.kind) {
        LetPattern(pattern, value, _) => pattern.reads_off(`$pattern{value.span.start}`),
        ForPattern(pattern, iterable, _, _) => pattern.reads_off(`$pattern{iterable.span.start}`),
        _ => [],
    }
}

# The fields `self` reads off `base`: a struct pattern's, none for the others.
pub fn reads_off(self: Destructure, base: str) -> Read[] {
    match (self) {
        ByStruct(_, fields, _, _) => fields.map(|field| Read { field, base }),
        ByTuple(..) | ByCase(..) | ByPattern(..) => [],
    }
}.test({
    assert(ByStruct("P", ["x", "y"], ["a", "b"], false).reads_off("v") == [
        Read { field: "x", base: "v" },
        Read { field: "y", base: "v" },
    ]);
    assert(ByTuple(["a", "b"]).reads_off("v") == []);
    assert(ByCase("C", ["a"]).reads_off("v") == []);
})

# The names a destructuring pattern binds, in order.
pub fn binders(self: Destructure) -> str[] {
    match (self) {
        ByTuple(names) | ByCase(_, names) | ByStruct(_, _, names, _) => names,
        ByPattern(pattern) => pattern.pat_bindings(),
    }
}.test({
    assert(ByPattern(Pat.Nested("some", [Pat.Struct("P", ["x"], ["b"])])).binders() == ["b"]);
    assert(ByTuple(["a", "b"]).binders() == ["a", "b"]);
    assert(ByCase("C", ["a"]).binders() == ["a"]);
    assert(ByStruct("P", ["x", "y"], ["x", "b"], false).binders() == ["x", "b"]);
})
