// The content half of the formatter's raw-block re-layout (see `reindent_block`):
// re-indents a block of text — the lines *between* a raw-string / template atom's
// delimiters, with no `"""` / ``` ``` ``` framing — so its common indent lands at a
// chosen column. Split out so `reindent_block` deals only with the delimiters.
import {
    !,
    +++,
    ==,
    count_while,
    filter,
    is_all_whitespace,
    join,
    map,
    minimum,
    repeat,
} from builtins;
import { lines } from "./lines.aipl";

pub fn reindent_contents(self: str, target: i64) -> str {
    let ls = self.lines();

    // The common indent is the smallest leading-space run over the non-blank
    // lines; with no non-blank lines there is nothing to shift (`none`).
    let common = ls
        .filter(|l| !l.is_all_whitespace())
        .map(|l| l.count_while(|c| c == ' '))
        .minimum();

    // Each line: blank -> empty (its whitespace would be trailing, and de-denting
    // renders it empty anyway); under a common indent -> shifted so the common
    // base becomes `target`, keeping its relative extra indent; otherwise verbatim.
    ls
        .map(
            |line| if (line.is_all_whitespace()) {
                ""
            } else {
                match (common) {
                    some(c) => " ".repeat(target) +++ line[c..],
                    none => line,
                }
            },
        )
        .join("\n")
}.doc("""
    Re-indents a block of text so the common leading-space indent shared by its
    non-blank lines becomes `target`, while each line keeps its indentation relative
    to that common base; blank lines are emitted empty. Like `dedent` (which strips
    the common indent entirely) but re-adds `target` spaces. Value-safe for
    raw-string contents: the de-denter strips the common indent and renders blank
    lines empty, so a uniform shift leaves the value unchanged.
""").test({
    // A uniform indent is rebased to the target.
    assert("  a\n  b".reindent_contents(4) == "    a\n    b");
    // Relative indent is preserved: the deeper line keeps its extra 2 spaces.
    assert("  a\n    b".reindent_contents(0) == "a\n  b");

    // Blank lines (empty or all-whitespace) are emitted empty and don't constrain
    // the common indent.
    assert("  a\n   \n  b".reindent_contents(0) == "a\n\nb");
    assert("  a\n\n  b".reindent_contents(2) == "  a\n\n  b");
    // No non-blank lines: nothing to shift, and every blank line is emptied.
    assert("   \n  ".reindent_contents(4) == "\n");
    // A single line is shifted to the target.
    assert("x".reindent_contents(2) == "  x");
    // Zero common indent and target 0: a no-op on non-blank content.
    assert("a\nb".reindent_contents(0) == "a\nb");
})
