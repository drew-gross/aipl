# `aipl_syntax::ast::Type` as AIPL declares it. One of the files the AST is
# declared across; see `ast.aipl`.

import { contains, equal as ==, join } from builtins;
import { I64, Prim, Str, prim_name } from "./prim.aipl";

# `aipl_syntax::ast::Type`, less the four checker sentinels (see the header).
#
# A type parameter is written as an ordinary identifier and reaches the parser's
# output as `Named`; `promoted` is what turns the ones a declaration declared
# into `TypeVar`s afterwards.
variant Ty =
    | Unit
    | Primitive(Prim)
    | Named(str)
    | Case(Ty)
    | TypeVar(str)
    | Optional(Ty)
    | Array(Ty)
    | Set(Ty, SetOrder)
    | Dict(Ty, Ty)
    | Result(Ty, Ty)
    | Fn(Ty[], Ty)
    | Tuple(Ty[])
    | Generic(str, Ty[])
    | Any
    | Without(Ty, Exclusion)

# What a `T without X` type leaves out — the `X`. One case per kind of value the
# checker knows how to exclude: the empty array literal, `[]`, or a case of a
# variant, by its declared name.
variant Exclusion = EmptyArray | NamedCase(str)

# The excluded value as the user writes it after `without`.
pub fn show_exclusion(self: Exclusion) -> str {
    match (self) {
        EmptyArray => "[]",
        NamedCase(name) => name,
    }
}.test({
    assert(EmptyArray.show_exclusion() == "[]");
    assert(NamedCase("Leaf").show_exclusion() == "Leaf");
})

# How a set orders its elements: `#{T}` promises no order, `#>{T}` walks
# largest first, `#<{T}` smallest first. The two ordered forms require an `ord`
# element type; all three are distinct types.
variant SetOrder = Unordered | Desc | Asc

# The dump suffix for an order: nothing for the unordered set, so the plain
# `Set(i64)` reads as it always has.
pub fn show_order(self: SetOrder) -> str {
    match (self) {
        Unordered => "",
        Desc => ", Desc",
        Asc => ", Asc",
    }
}.test({
    assert(Unordered.show_order() == "");
    assert(Desc.show_order() == ", Desc");
    assert(Asc.show_order() == ", Asc");
})

# A type as it is written in source: `i64[]`, `str?`, `#>{i64}`, `(i64, str) -> bool`. The
# structural dump below keeps which way a type nested; this is the spelling a diagnostic
# quotes back, and it is the one `aipl_syntax::type_name` gives.
pub fn type_text(self: Ty) -> str {
    match (self) {
        Unit => "()",
        Primitive(p) => p.prim_name(),
        Named(n) => n,
        Any => "any",
        TypeVar(n) => if (n == "") { "any" } else { n },
        Case(t) => `Case<{t.type_text()}>`,
        Optional(t) => `{t.suffix_operand()}?`,
        Array(t) => `{t.suffix_operand()}[]`,
        Set(t, o) => `#{o.set_spelling()}\{{t.type_text()}\}`,
        Dict(k, v) => `#\{{k.type_text()}: {v.type_text()}\}`,
        Result(o, e) => `{o.suffix_operand()}!{e.suffix_operand()}`,
        Fn(ps, r) => `({ps$type_text().join(sep=", ")}) -> {r.type_text()}`,
        Tuple(ts) => `({ts$type_text().join(sep=", ")})`,
        Generic(n, args) => `{n}<{args$type_text().join(sep=", ")}>`,
        Without(t, x) => `{t.type_text()} without {x.show_exclusion()}`,
    }
}.test({
    let i64_ty: Ty = Primitive(I64);
    assert(i64_ty.type_text() == "i64");
    assert(Array(Optional(i64_ty)).type_text() == "i64?[]");
    assert(Set(i64_ty, Unordered).type_text() == "#{i64}");
    assert(Set(i64_ty, Desc).type_text() == "#>{i64}");
    assert(Set(Primitive(Str), Asc).type_text() == "#<{str}");
    assert(Dict(Primitive(Str), i64_ty).type_text() == "#{str: i64}");
    assert(Result(i64_ty, Primitive(Str)).type_text() == "i64!str");
    assert(Fn([i64_ty, Primitive(Str)], Unit).type_text() == "(i64, str) -> ()");
    assert(Tuple([i64_ty, Named("P")]).type_text() == "(i64, P)");
    assert(Generic("Box", [i64_ty]).type_text() == "Box<i64>");
    assert(Case(Named("Shape")).type_text() == "Case<Shape>");
    assert(TypeVar("").type_text() == "any");

    // A refinement binds looser than every suffix, so a suffix wraps it in parentheses.
    assert(Optional(Without(Array(i64_ty), EmptyArray)).type_text() == "(i64[] without [])?");
})

# `self` as the operand of a postfix `?`, `[]` or `!E`: parenthesized when it is a `without`
# refinement, which binds looser than every suffix.
fn suffix_operand(self: Ty) -> str {
    match (self) {
        Without(..) => `({self.type_text()})`,
        _ => self.type_text(),
    }
}

# What follows the `#` of a set type to say how it is ordered: nothing for the unordered set,
# `>` for largest first and `<` for smallest first.
fn set_spelling(self: SetOrder) -> str {
    match (self) {
        Unordered => "",
        Desc => ">",
        Asc => "<",
    }
}

# A type as a one-line structural dump: constructors named, leaves bare. It is
# the oracle the lowering's tests assert against, so it is deliberately *not*
# the source spelling — `Array(Optional(i64))` says which way `i64?[]` nested,
# where re-rendering the source could not.
pub fn show_ty(self: Ty) -> str {
    match (self) {
        Unit => "()",
        Primitive(p) => p.prim_name(),
        Named(n) => n,
        Any => "any",
        TypeVar(n) => `TypeVar({n})`,
        Case(t) => `Case({t.show_ty()})`,
        Optional(t) => `Optional({t.show_ty()})`,
        Array(t) => `Array({t.show_ty()})`,
        Set(t, o) => `Set({t.show_ty()}{o.show_order()})`,
        Dict(k, v) => `Dict({k.show_ty()}, {v.show_ty()})`,
        Result(o, e) => `Result({o.show_ty()}, {e.show_ty()})`,
        Fn(ps, r) => `Fn([{show_tys(ps)}], {r.show_ty()})`,
        Tuple(ts) => `Tuple({show_tys(ts)})`,
        Generic(n, args) => `Generic({n}, {show_tys(args)})`,
        Without(t, x) => `Without({t.show_ty()}, {x.show_exclusion()})`,
    }
}.test({
    let i64_ty: Ty = Primitive(I64);
    assert(i64_ty.show_ty() == "i64");
    assert(Array(Optional(i64_ty)).show_ty() == "Array(Optional(i64))");
    assert(Dict(Primitive(Str), i64_ty).show_ty() == "Dict(str, i64)");
    assert(Result(Unit, Named("Error")).show_ty() == "Result((), Error)");
    assert(Fn([i64_ty, Primitive(Str)], Unit).show_ty() == "Fn([i64, str], ())");
    assert(Tuple([i64_ty, Any]).show_ty() == "Tuple(i64, any)");
    assert(Generic("Box", [Named("T")]).show_ty() == "Generic(Box, T)");
    assert(Case(Named("V")).show_ty() == "Case(V)");
    assert(Set(i64_ty, Unordered).show_ty() == "Set(i64)");
    assert(Set(i64_ty, Desc).show_ty() == "Set(i64, Desc)");
    assert(Set(Primitive(Str), Asc).show_ty() == "Set(str, Asc)");
    assert(TypeVar("T").show_ty() == "TypeVar(T)");
    assert(Without(Array(i64_ty), EmptyArray).show_ty() == "Without(Array(i64), [])");
    assert(Without(Named("V"), NamedCase("C")).show_ty() == "Without(V, C)");
})

# `self` with every `Named` whose name is one of `vars` made a `TypeVar`, at any
# depth. A declared type parameter shadows a type of the same name, so the
# promotion is by name alone.
pub fn promoted(self: Ty, vars: str[]) -> Ty {
    match (self) {
        Named(n) => if (vars.contains(n)) { TypeVar(n) } else { self },
        Unit | Primitive(..) | TypeVar(..) | Any => self,
        Case(t) => Case(t.promoted(vars)),
        Optional(t) => Optional(t.promoted(vars)),
        Array(t) => Array(t.promoted(vars)),
        Set(t, order) => Set(t.promoted(vars), order),
        Without(t, excluded) => Without(t.promoted(vars), excluded),
        Dict(k, v) => Dict(k.promoted(vars), v.promoted(vars)),
        Result(o, e) => Result(o.promoted(vars), e.promoted(vars)),
        Fn(params, ret) => Fn(params$promoted(vars), ret.promoted(vars)),
        Tuple(elements) => Tuple(elements$promoted(vars)),
        Generic(n, args) => Generic(n, args$promoted(vars)),
    }
}.test({
    let vars = ["T"];
    assert(Named("T").promoted(vars) == TypeVar("T"));
    assert(Named("P").promoted(vars) == Named("P")); // not declared
    assert(Primitive(I64).promoted(vars) == Primitive(I64));
    // At every depth, through every constructor that holds a type.
    assert(Array(Optional(Named("T"))).promoted(vars) == Array(Optional(TypeVar("T"))));
    assert(Set(Named("T"), Desc).promoted(vars) == Set(TypeVar("T"), Desc));
    assert(Dict(Named("T"), Named("P")).promoted(vars) == Dict(TypeVar("T"), Named("P")));
    assert(Result(Named("T"), Named("T")).promoted(vars) == Result(TypeVar("T"), TypeVar("T")));
    assert(Case(Named("T")).promoted(vars) == Case(TypeVar("T")));
    assert(Without(Array(Named("T")), EmptyArray).promoted(vars) == Without(
        Array(TypeVar("T")),
        EmptyArray,
    ));
    assert(Fn([Named("T"), Unit], Named("T")).promoted(vars) == Fn(
        [TypeVar("T"), Unit],
        TypeVar("T"),
    ));
    assert(Tuple([Named("T"), Any]).promoted(vars) == Tuple([TypeVar("T"), Any]));
    assert(Generic("Box", [Named("T")]).promoted(vars) == Generic("Box", [TypeVar("T")]));
    let none_declared: str[] = [];
    assert(Named("T").promoted(none_declared) == Named("T"));
})

# The elements of a type list, comma-separated. An empty list renders empty,
# which is what `() -> R` and `Foo<>` would need if either could be written.
pub fn show_tys(self: Ty[]) -> str { self$show_ty().join(sep=", ") }.test({
    let empty: Ty[] = [];
    assert(empty.show_tys() == "");
    assert([Unit].show_tys() == "()");
    assert([Primitive(I64), Named("P")].show_tys() == "i64, P");
})
