# The AIPL implementation of the `find_if` builtin. The loader names this
# function by the canonical name `__builtin_find_if` (see
# `aipl_syntax::aipl_builtins`), so a user's `xs.find_if(pred)` resolves through
# the ordinary generic / higher-order machinery — the in-file name `find_if` is
# only for this file's own tests, which read exactly like user code.
#
# It is `any` with the element handed back: both stop at the first element
# satisfying `pred`, and where `any` reports only that one existed, this
# returns it. The optional is what carries the not-found case, so the empty
# array needs no special handling.
#
# The `#[allow]` squelches `return_loop_find_if`, which flags exactly this
# shape — a loop returning the first match — and asks for `find_if`. Here it
# *is* `find_if`.

import { equal as ==, filter, greater_than as >, logical_not as ! } from builtins;

# The first element of `self` satisfying `pred`, or `none` when none does,
# stopping at the first match. A `str` receiver iterates its chars, since `str`
# and `char[]` share a representation.
#
# See `any` for the same scan reporting only whether a match existed, and
# `first` for the unconditional first element.
pub fn find_if<T: any>(self: T[], pred: (T) -> bool) -> T? {
    for (let x : self) {
        if (pred(x)) {
            return some(x); #[allow]
        };
    }
    none
}.test({
    fn is_nine(self: i64) -> bool { self == 9 }
    assert(is_nine(9));
    assert(!is_nine(8));

    assert([1, 2, 3, 4].find_if(|x| x > 2) == some(3));
    assert([1, 2, 3].find_if(|x| x > 9) == none); // nothing matches
    // The *first* match, not the last: it stops there.
    assert([5, 1, 7].find_if(|x| x > 2) == some(5));
    assert(find_if([2, 4], |x| x > 3) == some(4)); // function-call form too

    // Generic over the element type — the same definition serves char and str.
    assert(['a', 'b', 'c'].find_if(|c| c == 'b') == some('b'));
    assert(["go", "stop"].find_if(|s| s == "stop") == some("stop"));
    // A `str` receiver iterates its chars.
    assert("a b".find_if(|c| c == ' ') == some(' '));
    assert("abc".find_if(|c| c == ' ') == none);

    assert([8, 9, 9].find_if(is_nine) == some(9)); // a named predicate
    let limit = 3;
    assert([1, 5, 9].find_if(|x| x > limit) == some(5)); // a captured bound
    // `none` on an empty array (a typed empty from `filter`).
    assert([1, 2].filter(is_nine).find_if(|x| x == 99) == none);
})
