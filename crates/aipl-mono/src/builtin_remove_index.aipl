# The AIPL implementation of the `remove_index` builtin. The loader names this function by the
# canonical name `__builtin_remove_index`, so a user's `xs.remove_index(i)` resolves through the
# ordinary generic machinery.
#
# It is the array without one element, by position: `drop_first` and `drop_last` remove an end,
# `drop_n` a prefix, and this the element between. No lint flags the longhand
# `[..xs[..i], ..xs[(i + 1)..]]`: it is one shape among the many ways to build an array from
# slices, and the rewrite would not read better in each of them.

import { equal as ==, is_empty, wrapping_add as + } from builtins;

# `self` without the element at `index`. An `index` at or past the end leaves `self` as it is, the
# way an out-of-range slice clamps.
pub fn remove_index<T: any>(
    self: T[],
    # Where the element is, counting from 0.
    index: u64,
) -> T[] { [..self[..index], ..self[(index + 1)..]] }.test({
    assert([1, 2, 3].remove_index(0) == [2, 3]);
    assert([1, 2, 3].remove_index(1) == [1, 3]);
    assert([1, 2, 3].remove_index(2) == [1, 2]);
    // At and past the end: nothing to remove.
    assert([1, 2, 3].remove_index(3) == [1, 2, 3]);
    assert([1, 2, 3].remove_index(99) == [1, 2, 3]);
    assert([1].remove_index(0).is_empty());
    assert(remove_index(["a", "b"], 0) == ["b"]); // free-call form
    // Any element type, and the receiver is not changed.
    let words = ["a", "b", "c"];
    assert(words.remove_index(1) == ["a", "c"]);
    assert(words == ["a", "b", "c"]);
    assert([some(1), none].remove_index(0) == [none]);
})
