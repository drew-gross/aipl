# The AIPL implementation of the `intersection` builtin. The loader names this
# function by the canonical name `__builtin_intersection` (see
# `aipl_syntax::aipl_builtins`), so a user's `a.intersection(b)` resolves through
# the ordinary generic machinery — the in-file name `intersection` is only for this
# file's own tests, which read exactly like user code.

import { equal as ==, push } from builtins;
import { has, to_set } from sets;

# The elements both `self` and `other` hold, as a set. Either operand empty, or
# the two disjoint, gives the empty set.
#
# Callable as a method (`wanted.intersection(found)`). Both operands are sets of any
# order; the result is always unordered, for the reason `difference` gives — and
# `difference` is the one to reach for when you want the elements `other` does *not*
# hold.
pub fn intersection<T: any>(self: #{T}, other: #{T}) -> #{T} {
    // `push_loop_pipeline` flags this loop and advises `filter`, which has no set
    // form; the array is the intermediate and `to_set` makes the result a set.
    mut shared: T[] = []; #[allow]
    for (let x : self) {
        if (other.has(x)) { set shared.push(x); };
    }
    shared.to_set()
}.test({
    assert(#{1, 2, 3}.intersection(#{2, 3, 4}) == #{2, 3}); // overlapping
    assert(intersection(#{1, 2}, #{2}) == #{2}); // free-call form
    assert(#{1, 2}.intersection(#{3, 4}) == #{}); // disjoint
    assert(#{1, 2}.intersection(#{1, 2}) == #{1, 2}); // identical
    assert(#{1}.intersection(#{1, 2, 3}) == #{1}); // `self` inside `other`
    assert(#{1, 2, 3}.intersection(#{1}) == #{1}); // `other` inside `self`

    // Either operand empty.
    let empty: #{i64} = #{};
    assert(empty.intersection(#{1}) == #{});
    assert(#{1}.intersection(empty) == #{});

    // Any element type a set can hold.
    assert(#{"a", "b"}.intersection(#{"b", "c"}) == #{"b"});
    assert(#{'x', 'y'}.intersection(#{'y'}) == #{'y'});
    assert(#{true, false}.intersection(#{false}) == #{false});

    // Neither operand is changed.
    let left = #{1, 2, 3};
    let right = #{2, 3, 4};
    assert(left.intersection(right) == #{2, 3});
    assert(left == #{1, 2, 3});
    assert(right == #{2, 3, 4});

    // An ordered operand is accepted; the result is unordered.
    let ordered: #>{i64} = #>{5, 1, 3};
    assert(ordered.intersection(#{1, 3, 9}) == #{1, 3});
})
