# The AIPL implementation of the `tabulate` builtin. The loader names this function by the
# canonical name `__builtin_tabulate` (see `aipl_syntax::builtin`), so a user's
# `rows.tabulate(headers)` specializes through the ordinary generic machinery — the in-file
# name is only for this file's own tests, which read exactly like user code.
#
# No lint steers the longhand here: a hand-drawn table is built from so many different pieces
# (separators, padding, borders) that no shape could be advised precisely, and a mis-advised
# lint is worse than ntwo.

import {
    equal as ==,
    join,
    left_fold,
    len,
    less_than as <,
    map,
    max,
    measure,
    repeat,
    saturating_sub as -,
    wrapping_add as +,
    wrapping_mul as *,
    zip_with,
} from builtins;

# `text` padded with spaces to `width`: on the left when `right`, else on the right. Text
# already wider than `width` is left as it is.
fn padded(text: str, width: u64, right: bool) -> str {
    let gap = " ".repeat(width - text.len());
    if (right) { `{gap}{text}` } else { `{text}{gap}` }
}.test({
    assert(padded("ab", 5, false) == "ab   ");
    assert(padded("ab", 5, true) == "   ab");
    assert(padded("abcdef", 3, false) == "abcdef");
    assert(padded("", 2, true) == "  ");
})

# The line of `fill` characters over each column of `widths`, joined by `+`.
fn rule(widths: u64[], fill: str) -> str {
    let spans = widths.map(|w| { fill.repeat(w + 2) });
    `+{spans.join(sep="+")}+`
}.test({
    assert(rule([1, 3], "-") == "+---+-----+");
    assert(rule([2], "=") == "+====+");
})

# What a table needs to know of a column to draw a cell of it.
struct Column { width: u64, right: bool }

# One row's line: each cell padded to its column, between `|`s. A row with more cells than there
# are columns is cut off at the last column.
fn cells_line(self: str[], columns: Column[]) -> str {
    let parts = self.zip_with(columns, |text, column| padded(text, column.width, column.right));
    `| {parts.join(sep=" | ")} |`
}.test({
    let columns = [Column { width: 3, right: false }, Column { width: 2, right: true }];
    assert(["a", "b"].cells_line(columns) == "| a   |  b |");
    assert(["a", "b", "c"].cells_line(columns) == "| a   |  b |");
})

# `self` made `n` long by adding `filler` to the end; one already longer is left as it is.
fn fitted<T: any>(self: T[], n: u64, filler: T) -> T[] {
    [..self, ..[filler].repeat(n - self.len())]
}.test({
    assert([1, 2].fitted(4, 0) == [1, 2, 0, 0]);
    assert([1, 2].fitted(1, 0) == [1, 2]);
    let empty: i64[] = [];
    assert(empty.fitted(2, 7) == [7, 7]);
})

# `rows` drawn as a table, as lines: a rule above, `headers` and a heavier rule under them,
# the rows, and a rule below. Each column is as wide as its widest cell, padded on the right,
# or on the left for a column `right_aligned` marks (a column it does not reach is on the
# left). A row with fewer cells than `headers` has blanks for the rest, and one with more is cut
# off. Callable as a method.
pub fn tabulate(self: str[][], headers: str[], right_aligned: bool[] = []) -> str[] {
    let count = headers.len();
    let cells = self$fitted(count, "");
    // A column is as wide as its widest cell, its header included.
    let widths = cells.left_fold(
        headers$len(),
        |widths, row| { widths.zip_with(row, |width, cell| max(width, cell.len())) },
    );
    let columns = widths.zip_with(
        right_aligned.fitted(count, false),
        |width, right| { Column { width, right } },
    );
    [
        rule(widths, "-"),
        headers.cells_line(columns),
        rule(widths, "="),
        ..cells$cells_line(columns),
        rule(widths, "-"),
    ]
}.test({
    assert([["ab", "1"], ["c", "10"]].tabulate(["Name", "N"], right_aligned=[false, true]) == [
        "+------+----+",
        "| Name |  N |",
        "+======+====+",
        "| ab   |  1 |",
        "| c    | 10 |",
        "+------+----+",
    ]);
    // No rows: just the header.
    let nothing: str[][] = [];
    assert(nothing.tabulate(["X"]) == ["+---+", "| X |", "+===+", "+---+"]);
    // Alignment is optional, and the free-call form is the same.
    assert(tabulate([["7"]], ["Count"]) == [
        "+-------+",
        "| Count |",
        "+=======+",
        "| 7     |",
        "+-------+",
    ]);
    // A cell wider than its header widens the column.
    assert([["long"]].tabulate(["h"]) == [
        "+------+",
        "| h    |",
        "+======+",
        "| long |",
        "+------+",
    ]);
}).benchmark({
    let headers = ["Name", "Count", "Share"];
    let few = [["ab", "1", "10%"], ["c", "10", "5%"]];
    let many = [
        ["ab", "1", "10%"],
        ["c", "10", "5%"],
        ["def", "100", "1%"],
        ["g", "1000", "50%"],
        ["hi", "7", "3%"],
        ["j", "8", "9%"],
        ["klm", "9", "2%"],
        ["n", "11", "4%"],
    ];
    let two = measure(
        "two rows",
        few,
        |rows| { rows.tabulate(headers, right_aligned=[false, true, true]) },
    );
    let eight = measure(
        "eight rows",
        many,
        |rows| { rows.tabulate(headers, right_aligned=[false, true, true]) },
    );

    // Allocations are exact: the widths, the columns, the three rules and the header line are the fixed
    // part, and each row adds its padded copy and its line, so a temporary array optimized away shows up here.
    assert(two.allocations == 37);
    assert(eight.allocations == 104);

    // Four times the rows costs under three times the instructions: the fixed part is shared and
    // nothing in a row's line depends on the number of rows.
    assert(eight.instructions < 3 * two.instructions);
})
