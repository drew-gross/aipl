# The AIPL implementation of the `tabulate` builtin. The loader names this function by the
# canonical name `__builtin_tabulate` (see `aipl_syntax::builtin`), so a user's
# `rows.tabulate(columns)` specializes through the ordinary generic machinery — the in-file
# name is only for this file's own tests, which read exactly like user code.
#
# No lint steers the longhand here: a hand-drawn table is built from so many different pieces
# (separators, padding, borders) that no shape could be advised precisely, and a mis-advised
# lint is worse than ntwo.

import {
    Direction,
    Left,
    Right,
    equal as ==,
    join,
    left_fold,
    len,
    less_than as <,
    map,
    max,
    measure,
    pad,
    repeat,
    saturating_sub as -,
    wrapping_add as +,
    wrapping_mul as *,
    zip_with,
} from builtins;

# The line of `fill` characters over each column of `widths`, joined by `+`.
fn rule(widths: u64[], fill: str) -> str {
    let spans = widths.map(|w| { fill.repeat(w + 2) });
    `+{spans.join(sep="+")}+`
}.test({
    assert(rule([1, 3], "-") == "+---+-----+");
    assert(rule([2], "=") == "+====+");
})

# A column of a table: what its header says, and the side its cells are padded on: `Right` (the
# default) leaves the text on the left, and `Left` puts it on the right, as for numbers.
struct Column { header: str, side: Direction = Right }

# One row's line: each cell padded to a width, on a side, between `|`s. A row with more cells than
# there are `(width, side)` pairs is cut off at the last pair.
fn cells_line(self: str[], layout: (u64, Direction)[]) -> str {
    let parts = self.zip_with(layout, |text, (width, side)| text.pad(width, dir=side));
    `| {parts.join(sep=" | ")} |`
}.test({
    let layout = [(3, Right), (2, Left)];
    assert(["a", "b"].cells_line(layout) == "| a   |  b |");
    assert(["a", "b", "c"].cells_line(layout) == "| a   |  b |");
})

# `self` made `n` long by adding `filler` to the end; one already longer is left as it is.
fn fitted<T: any>(self: T[], n: u64, filler: T) -> T[] {
    [..self, ..[filler].repeat(n - self.len())]
}.test({
    assert([1, 2].fitted(4, 0) == [1, 2, 0, 0]);
    assert([1, 2].fitted(1, 0) == [1, 2]);
    let empty: i64[] = [];
    assert(empty.fitted(2, 7) == [7, 7]);
})

# `rows` drawn as a table, as lines: a rule above, the headers of `columns` and a heavier rule
# under them, the rows, and a rule below. Each column is as wide as its widest cell, its header
# included, and its cells are on the side its `Column` says. A row with fewer cells than there are
# columns has blanks for the rest, and one with more is cut off. Callable as a method.
pub fn tabulate(self: str[][], columns: Column[]) -> str[] {
    let headers = columns$header;
    let cells = self$fitted(columns.len(), "");
    // A column is as wide as its widest cell, its header included.
    let widths = cells.left_fold(
        headers$len(),
        |widths, row| { widths.zip_with(row, |width, cell| max(width, cell.len())) },
    );
    let layout = widths.zip_with(columns, |width, column| (width, column.side));
    [
        rule(widths, "-"),
        headers.cells_line(layout),
        rule(widths, "="),
        ..cells$cells_line(layout),
        rule(widths, "-"),
    ]
}.test({
    assert([["ab", "1"], ["c", "10"]].tabulate([
        Column { header: "Name" },
        Column { header: "N", side: Left },
    ]) == [
        "+------+----+",
        "| Name |  N |",
        "+======+====+",
        "| ab   |  1 |",
        "| c    | 10 |",
        "+------+----+",
    ]);
    // No rows: just the header.
    assert([].tabulate([Column { header: "X" }]) == ["+---+", "| X |", "+===+", "+---+"]);
    // A column's side is optional, and the free-call form is the same.
    assert(tabulate([["7"]], [Column { header: "Count" }]) == [
        "+-------+",
        "| Count |",
        "+=======+",
        "| 7     |",
        "+-------+",
    ]);
    // A cell wider than its header widens the column.
    assert([["long"]].tabulate([Column { header: "h" }]) == [
        "+------+",
        "| h    |",
        "+======+",
        "| long |",
        "+------+",
    ]);
}).benchmark({
    let columns = [
        Column { header: "Name" },
        Column { header: "Count", side: Left },
        Column { header: "Share", side: Left },
    ];
    let few = [["ab", "1", "10%"], ["c", "10", "5%"]];
    let many = [
        ["ab", "1", "10%"],
        ["c", "10", "5%"],
        ["def", "100", "1%"],
        ["g", "1000", "50%"],
        ["hi", "7", "3%"],
        ["j", "8", "9%"],
        ["klm", "9", "2%"],
        ["n", "11", "4%"],
    ];
    let two = measure("two rows", few, |rows| { rows.tabulate(columns) });
    let eight = measure("eight rows", many, |rows| { rows.tabulate(columns) });

    // Allocations are exact: the headers, widths, layout, the three rules and the header line are the fixed
    // part, and each row adds its padded copy and its line, so a temporary array optimized away shows up here.
    assert(two.allocations == 38);
    assert(eight.allocations == 105);

    // Four times the rows costs under three times the instructions: the fixed part is shared and
    // nothing in a row's line depends on the number of rows.
    assert(eight.instructions < 3 * two.instructions);
})
