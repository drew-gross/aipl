# The AIPL implementation of the `ensure_nonempty` builtin (see
# `aipl_syntax::aipl_builtins`): the runtime road into `T[] without []`. A
# literal with an element in it takes the refined type on sight; every other
# array has to be tested, and this is where the test lives.
#
# `assume_nonempty` is the internal builtin that grants the refinement without
# a test, and the `is_nonempty` guard here is what makes granting it sound.
# The checker erases both the refinement and the call once it has verified the
# program, so the whole thing costs one length check and no copy.

import { assume_nonempty, equal as ==, is_nonempty, is_some, nonempty_first } from builtins;

# `some(self)` as a `T[] without []` when the array has an element, `none` when
# it is empty. How an array of unknown length becomes one `nonempty_first` /
# `nonempty_last` accept: `match (xs.ensure_nonempty()) { some(ne) => .., none
# => .. }`.
pub fn ensure_nonempty<T: any>(self: T[]) -> (T[] without [])? {
    if (self.is_nonempty()) { some(self.assume_nonempty()) } else { none }
}.test({
    assert([1, 2].ensure_nonempty().is_some());
    assert(ensure_nonempty(["a"]).is_some()); // free-call form
    let e: i64[] = [];
    assert(e.ensure_nonempty() == none);
    // The refined array is the same array.
    match ([7, 8].ensure_nonempty()) {
        some(ne) => assert(ne.nonempty_first() == 7),
        none => assert(false),
    };
})
