import { equal as ==, greater_than as >, reverse, to_digit, wrapping_mul as * } from builtins;

// The AIPL implementation of the `reverse_find_map` builtin. Monomorphization
// registers this function under the canonical name `__builtin_reverse_find_map`
// (see `AIPL_BUILTIN_SOURCES` in `lib.rs`), so a user's `xs.reverse_find_map(f)`
// resolves through the ordinary generic / higher-order machinery — the in-file
// name is only for this file's own tests, which read exactly like user code.
//
// It walks by index from the end rather than reversing first: `find_map` over
// `xs.reverse()` would allocate the reversed view each time, and a descent
// that asks this at every level (the parser's `last_leaf_of`) would pay that
// per level. The indexed loop is the whole reason the builtin exists rather
// than being spelled as the two calls.
# The first `some` that `f` returns over the elements of `self` taken from the
# *end* — `some(y)` for the last `x` with `f(x) == some(y)`, `none` when every
# `f(x)` is `none` — stopping at that element. `find_map` from the other end.
# Generic over both types and callable as a method; a `str` receiver iterates
# its chars.
pub fn reverse_find_map<T: any, U: any>(self: T[], f: (T) -> U?) -> U? {
    for (let x : self.reverse()) {
        if (let some(y) = f(x)) {
            return some(y);
        };
    }
    none
}.test({
    // The *last* answer, not the first.
    assert([0, 3, 5].reverse_find_map(nonzero) == some(5));
    assert([3, 0].reverse_find_map(nonzero) == some(3));
    assert([0, 0].reverse_find_map(nonzero) == none);
    // The lambda form, the free-call form, and the empty array.
    assert([1, 2, 3].reverse_find_map(|x| if (x > 1) { some(x * 10) } else { none }) == some(30));
    assert(reverse_find_map([1, 2][..0], nonzero) == none);
    // A `str` receiver iterates its chars.
    assert("1a2b".reverse_find_map(to_digit) == some(2));
})

fn nonzero(self: i64) -> i64? { if (self == 0) { none } else { some(self) } }.test({
    assert(nonzero(0) == none);
    assert(nonzero(2) == some(2));
})
