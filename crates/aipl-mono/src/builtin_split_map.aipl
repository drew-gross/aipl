# The AIPL implementation of the `split_map` builtin. Monomorphization
# registers this function under the canonical name `__builtin_split_map` (see
# `AIPL_BUILTIN_SOURCES` in `lib.rs`), so a user's `s.split_map(sep, f)`
# resolves through the ordinary generic / higher-order machinery — the in-file
# name is only for this file's own tests, which read exactly like user code.
#
# It is what `s.split(sep).map(f)` means, without the array of parts between:
# `split` would build a block holding every part — a retained view each — for
# `map` to walk once and drop. Written by the compiler's operation-fusion pass
# for that chain (see `chain_fusions` in aipl-mono); also callable directly,
# and the shape `src.lines().map(f)` becomes once `lines` has inlined.
#
# The loop below is the other half of the same story: a `for` over a `split` is
# itself fused (see `loop_fusions`), into a walk of a cursor that hands back
# one part at a time. So nothing here materializes either — the part goes
# straight from the source string through `f` into `out`.
#
# No lint of its own: `push_loop_pipeline` already sends a hand-written
# building loop to `map`, and a `map` over a `split` arrives here through the
# chain. The seed below escapes that lint honestly rather than with an
# `#[allow]` — the `reserve` between the seed and the loop is work the lint's
# rewrite has nowhere to put, which is exactly when it declines.

import { equal as ==, len, logical_not as !, push, reserve, split, split_len } from builtins;

# `self.split(sep).map(f)` — every `sep`-separated part of `self` mapped through
# `f` — computed without the array of parts in between. The parts are `split`'s:
# `n` separators give `n + 1`, including empty ones at either end, and an empty
# `sep` never matches, so the whole string is the one part.
pub fn split_map<U: any>(self: str, sep: str, f: (str) -> U) -> U[] {
    mut out: U[] = [];

    // Exactly one allocation: `split_len` is the same scan the loop makes with
    // nothing built, so asking for the count first is cheaper than growing into
    // it.
    set out.reserve(self.split_len(sep));
    for (let part : self.split(sep)) {
        set out.push(f(part));
    }
    out
}.test({
    fn tagged(self: str) -> str { `<{self}>` }
    assert(tagged("x") == "<x>");

    fn is_blank(self: str) -> bool { self == "" }
    assert(is_blank(""));
    assert(!is_blank("x"));

    assert("a,b,c".split_map(",", tagged) == ["<a>", "<b>", "<c>"]);

    // The parts are `split`'s: a trailing separator leaves a trailing empty
    // part, and a separator that never occurs leaves the whole string as one.
    assert("a,,".split_map(",", tagged) == ["<a>", "<>", "<>"]);
    assert("abc".split_map(",", tagged) == ["<abc>"]);
    // An empty separator never matches; the empty string is one empty part.
    assert("abc".split_map("", tagged) == ["<abc>"]);
    assert("".split_map(",", tagged) == ["<>"]);
    // A multi-byte separator, and parts long enough to be heap strings.
    assert("first long piece--second long piece".split_map("--", tagged) == [
        "<first long piece>",
        "<second long piece>",
    ]);
    // Mapped to another type, through a named predicate.
    assert("a,,b".split_map(",", is_blank) == [false, true, false]);

    // Each part's length, so the parts are proven to be the windows `split`
    // cuts rather than anything reassembled.
    assert("a,bb,ccc".split_map(",", len) == [1, 2, 3]);
    // Free-call form, a lambda, and a binding captured from outside it.
    let mark = "!";
    assert(split_map("a,b", ",", |p| `{p}{mark}`) == ["a!", "b!"]);
})
