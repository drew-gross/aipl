# The AIPL implementation of the `read_key` builtin. The loader names this
# function by the canonical name `__builtin_read_key` (see
# `aipl_syntax::aipl_builtins`). The file also defines `Key` and its cases, which
# a program imports from builtins beside `read_key`.

import { drop_first, equal as ==, first, not_equal as !=, push, read_byte } from builtins;

# One key press: an arrow key, or the byte of any other key.
variant Key = Up | Down | Left | Right | Other(u8)

# The first two bytes of an arrow key's three, `ESC [ A` for up.
let ESCAPE: u8 = 27;

let BRACKET: u8 = 91;

# The arrow key whose escape sequence ends in `last`, or `Other(last)`.
fn arrow_ending(last: u8) -> Key {
    if (last == 65) {
        Up
    } else if (last == 66) {
        Down
    } else if (last == 67) {
        Right
    } else if (last == 68) {
        Left
    } else {
        Other(last)
    }
}.test({
    assert(arrow_ending(65) == Up);
    assert(arrow_ending(66) == Down);
    assert(arrow_ending(67) == Right);
    assert(arrow_ending(68) == Left);
    assert(arrow_ending(69) == Other(69));
})

# The next key press, without waiting for Enter: `some(key)`, or `none` once input
# is exhausted. An arrow key is the three bytes `ESC [ A`..`D` that `read_byte`
# returns, and arrives as `Up`, `Down`, `Right` or `Left`; any other key is `Other`
# with its first byte, and an escape sequence that is not an arrow ends at the
# byte that breaks it. Carries `!read_stdin_raw`, like `read_byte`.
pub fn read_key() !read_stdin_raw -> Key? {
    match (read_byte()) {
        none => none,
        some(first) => {
            if (first != ESCAPE) {
                return some(Other(first));
            };
            match (read_byte()) {
                none => some(Other(first)),
                some(second) => {
                    if (second != BRACKET) {
                        return some(Other(second));
                    };
                    match (read_byte()) {
                        none => some(Other(second)),
                        some(last) => some(arrow_ending(last)),
                    }
                },
            }
        },
    }
}.test({
    // A key that is one byte arrives as that byte, and an arrow key as its three.
    assert(keys_from([97], 1) == [some(Other(97))]);
    assert(keys_from([27, 91, 65], 1) == [some(Up)]);
    assert(keys_from([27, 91, 66], 1) == [some(Down)]);
    assert(keys_from([27, 91, 67], 1) == [some(Right)]);
    assert(keys_from([27, 91, 68], 1) == [some(Left)]);
    // Keys come one at a time, in order, and `none` once the bytes run out.
    assert(keys_from([27, 91, 65, 97, 27, 91, 68], 4) == [
        some(Up),
        some(Other(97)),
        some(Left),
        none,
    ]);

    // An escape sequence that is not an arrow ends at the byte that breaks it, and
    // one that stops short ends at the last byte it had.
    assert(keys_from([27, 91, 69], 1) == [some(Other(69))]);
    assert(keys_from([27, 120], 1) == [some(Other(120))]);
    assert(keys_from([27], 2) == [some(Other(27)), none]);
    assert(keys_from([27, 91], 2) == [some(Other(91)), none]);
    assert(keys_from([], 1) == [none]);
})

# The first `count` answers of `read_key` when `typed` is all that is typed, one byte
# after another.
fn keys_from(typed: u8[], count: u64) -> Key?[] {
    mut remaining = typed;
    mut keys: Key?[] = [];
    shim read_stdin_raw {
        read_byte = || {
            let next = remaining.first();
            set remaining = remaining.drop_first();
            next
        },
    } {
        for (let _ : 0..count) {
            set keys.push(read_key());
        }
    };
    keys
}
