# The AIPL implementation of the `count_while` builtin. The loader names this
# function by the canonical name `__builtin_count_while` (see
# `aipl_syntax::aipl_builtins`), so a user's `xs.count_while(pred)` resolves
# through the ordinary generic / higher-order machinery — the in-file name
# `count_while` is only for this file's own tests, which read exactly like user
# code. Because a builtin's body may call other builtins (loaded through the
# real loader), this is also the shared helper the `trim_while` builtin and the
# dogfooded compiler helpers (`dedent`, and `lexer.aipl`) call.

import {
    equal as ==,
    less_than_or_equal as <=,
    logical_not as !,
    wrapping_increment as ++,
} from builtins;

# Counts elements from the front while `pred` holds, stopping at the first element
# that fails it (or at the end).
pub fn count_while<T: any>(self: T[], pred: (T) -> bool) -> u64 {
    mut n: u64 = 0;
    for (let x : self) {
        if (!pred(x)) {
            return n;
        };
        set n++;
    }
    n
}.test({
    assert([1, 2, 3].count_while(|x| x <= 2) == 2); // stops at 3
    assert([1, 2, 3].count_while(|x| x <= 9) == 3); // whole array passes
    assert([1, 2, 3].count_while(|x| x <= 0) == 0); // first element fails
    assert([5, 1, 5].count_while(|x| x <= 2) == 0); // only a leading run counts
    assert(count_while([2, 2], |x| x <= 2) == 2); // function-call form too
    // Generic over the element type — the same definition serves char and str:
    assert(['a', 'a', 'b'].count_while(|c| c == 'a') == 2);
    assert(["go", "go", "stop"].count_while(|s| s == "go") == 2);
})
