# The AIPL implementation of the `try_map` builtin. The loader names this
# function by the canonical name `__builtin_try_map` (see
# `aipl_syntax::aipl_builtins`), so a user's `xs.try_map(f)` resolves through
# the ordinary generic / higher-order machinery — the in-file name `try_map` is
# only for this file's own tests, which read exactly like user code.
#
# `map` cannot call a fallible `f`: a `U[]` has nowhere to put an error, so
# every mapping that can fail had to be spelled out as a loop over `push` with
# `?` — the one array-building shape `map` could not absorb. This is that loop,
# written once.

import { equal as ==, is_err_and, len, less_than as <, push } from builtins;

# `self` with `f` applied to each element, short-circuiting on failure: the
# result is `ok` of every mapped value, in order, or the *first* `err` that
# `f` returned — after which no further element is mapped.
#
# The fallible counterpart of `map`, and what a `for` loop over
# `set out.push(f(x)?)` is written as.
pub fn try_map<T: any, U: any, E: any>(self: T[], f: (T) -> U!E) -> U[]!E {
    mut out: U[] = [];
    for (let x : self) {
        set out.push(f(x)?);
    }
    ok(out)
}.test({
    // Fails on a negative input, so a test can place a failure at a chosen position
    // and name which one came back.
    fn label(n: i64) -> str!str { if (n < 0) { err(`negative {n}`) } else { ok(`n{n}`) } }
    assert(label(1)? == "n1");
    assert(label(-2).is_err_and(|e| e == "negative -2"));

    // A second fallible mapping whose ok, err and element types all differ from
    // `label`'s, so the tests cover `try_map` being generic in all three.
    fn width(s: str) -> u64!char { if (s == "") { err('e') } else { ok(s.len()) } }
    assert(width("abc")? == 3);
    assert(width("").is_err_and(|c| c == 'e'));

    // Every element succeeds: the mapped values come back in order.
    assert([1, 2, 3].try_map(label)? == ["n1", "n2", "n3"]);
    assert(try_map([1, 2], label)? == ["n1", "n2"]); // function-call form too

    // The mapped type differs from the element type (`i64` -> `str` above,
    // `str` -> `i64` here), and the error type from both.
    assert(["a", "bb"].try_map(width)? == [1, 2]);

    // An empty array never calls `f`, so it cannot fail.
    let empty: i64[] = [];
    assert(empty.try_map(label)? == []);

    // A failure anywhere is the whole result.
    assert([1, -2].try_map(label).is_err_and(|e| e == "negative -2"));

    // The *first* failure wins and nothing after it is mapped — which is what
    // distinguishes this from collecting every error.
    assert([1, -2, -3].try_map(label).is_err_and(|e| e == "negative -2"));
    assert([-3, -2].try_map(label).is_err_and(|e| e == "negative -3"));

    // A lambda that can fail *only* through a `?`: `ok(..)` names no error
    // type, so the `?` is the one thing that pins `E` (see
    // `tests/cases/lambdas/try_error_inferred.aipl`).
    assert([1, 2].try_map(|n| ok(label(n)?))? == ["n1", "n2"]);
    assert([1, -2].try_map(|n| ok(label(n)?)).is_err_and(|e| e == "negative -2"));

    // A lambda, including one that captures — the form the call sites use to
    // pass a fallible function its extra arguments.
    let floor = 0;
    assert([1, 2].try_map(|n| if (n < floor) { err("under") } else { ok(n) })? == [1, 2]);
    assert(
        [1, -2]
            .try_map(|n| if (n < floor) { err("under") } else { ok(n) })
            .is_err_and(|e| e == "under"),
    );
})
