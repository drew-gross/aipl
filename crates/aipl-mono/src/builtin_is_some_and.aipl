# The AIPL implementation of the `is_some_and` builtin. The loader names this
# function by the canonical name `__builtin_is_some_and` (see
# `aipl_syntax::aipl_builtins`), so a user's `x.is_some_and(pred)` specializes
# through the ordinary generic / higher-order machinery — the in-file name
# `is_some_and` is only for this file's own tests, which read exactly like user
# code.

import { equal as ==, less_than_or_equal as <=, logical_not as ! } from builtins;

# True when `self` is `some(x)` and `pred(x)` holds; `false` for `none` (the
# predicate is not called).
pub fn is_some_and<T: any>(self: T?, pred: (T) -> bool) -> bool {
    // The `match_is_some_and` lint points at exactly this shape and advises
    // `is_some_and` — which is what this *is*. Rewriting it in terms of itself
    // is the one thing it can't do, so the lint is squelched here.
    match (self) {
        some(x) => pred(x),
        none => false, #[allow]
    }
}.test({
    fn is_nine(self: i64) -> bool { self == 9 }
    assert(is_nine(9));
    assert(!is_nine(8));

    assert(some(5).is_some_and(|x| x == 5)); // some, predicate holds
    assert(!some(5).is_some_and(|x| x == 6)); // some, predicate fails
    assert(!""[0].is_some_and(|c| c == 'a')); // none -> false (char? from index past end)
    assert(is_some_and(some('a'), |c| c == 'a')); // free-call form, char inner
    assert(some(9).is_some_and(is_nine)); // a named predicate, no lambda
    let limit = 3;
    assert(some(2).is_some_and(|x| x <= limit)); // a captured bound
})
