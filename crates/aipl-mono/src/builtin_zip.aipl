# The AIPL implementation of the `zip` builtin. The loader names this function by the
# canonical name `__builtin_zip` (see `aipl_syntax::builtin`), so a user's
# `xs.zip(ys)` specializes through the ordinary generic machinery — the in-file name
# is only for this file's own tests, which read exactly like user code.
#
# The pairs are what is wanted by default (to build a dict, to sort, to walk with a
# destructuring `for`), and `with` says what to make of each pair instead when it is only
# going to be combined: `xs.zip(ys, with=|x, y| { x + y })`. A lint steers a loop that pairs by
# index here (`push_loop_zip_with`).
#
# The pairing function's default is a lambda, which the call fills in and types from the
# arrays it is given; its parameters need no types of their own. The body is a loop, so a
# call with a lambda `with` is specialized for it like any function that takes one.

import { equal as ==, is_empty, push, wrapping_add as +, wrapping_mul as * } from builtins;

# The elements of both arrays combined pairwise by `with`, stopping at the shorter one:
# `[1, 2, 3].zip(["a", "b"])` is `[(1, "a"), (2, "b")]`, and
# `[1, 2].zip([10, 20], with=|x, y| { x + y })` is `[11, 22]`. Callable as a method.
pub fn zip<T: any, U: any, V: any>(
    self: T[],
    # The second array; the result stops at the shorter of the two.
    other: U[],
    # Called with the elements of both, pairwise. Defaults to making the pair.
    with: (T, U) -> V = |first, second| { (first, second) },
) -> V[] {
    mut out = [];
    for (let i, x : self) {
        let some(y) = other[i] else { return out; };
        set out.push(with(x, y));
    }
    out
}.test({
    assert([1, 2, 3].zip(["a", "b", "c"]) == [(1, "a"), (2, "b"), (3, "c")]);
    // The shorter array decides, whichever side it is.
    assert([1, 2, 3].zip(["a"]) == [(1, "a")]);
    assert([1].zip(["a", "b"]) == [(1, "a")]);
    assert([1, 2].zip([""][..0]).is_empty());
    assert([1][..0].zip(["a"]).is_empty());
    // Free-call form.
    assert(zip([1, 2], [true, false]) == [(1, true), (2, false)]);
    // Reading a pair back out.
    let pairs = [10, 20].zip(["x", "y"]);
    assert(pairs[1]? == (20, "y"));

    // `with` combines each pair: a lambda or a named function.
    assert([1, 2, 3].zip([10, 20, 30], with=add) == [11, 22, 33]);
    assert([1, 2, 3].zip([10, 20, 30], with=|x, y| { x * y + y }) == [20, 60, 120]);
    assert([1, 2, 3].zip([10, 20, 30], with=tagged) == [1011, 1022, 1033]);
    assert([1, 2, 3, 4].zip([100, 200], with=add) == [101, 202]);
    assert([1, 2].zip(["x", "y"], with=|n, text| { `{n}{text}` }) == ["1x", "2y"]);
})

fn add(x: i64, y: i64) -> i64 { x + y }

fn tagged(x: i64, y: i64) -> i64 { x + y + 1000 }
