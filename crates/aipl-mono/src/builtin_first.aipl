# The AIPL implementation of the `first` builtin. The loader names this function
# by the canonical name `__builtin_first` (see `aipl_syntax::aipl_builtins`), so
# a user's `xs.first()` resolves through the ordinary generic machinery.
#
# Indexing already yields an optional — `some(elem)` in bounds, `none` out of
# bounds — so the empty case needs no special handling: `[][0]` is `none`.

import { equal as == } from builtins;

# The first element, or `none` if the array is empty.
pub fn first<T: any>(self: T[]) -> T? { self[0] }.test({
    assert([1, 2, 3].first() == some(1));
    assert([7].first() == some(7));
    assert(first(["a", "b"]) == some("a")); // free-call form
    // Empty: nothing to hand back.
    assert([1, 2][..0].first() == none);
})
