import {
    count,
    equal as ==,
    greater_than_or_equal as >=,
    less_than as <,
    wrapping_increment as ++,
} from builtins;

// The AIPL implementation of the `count_is_less_than` builtin. Registered under
// `__builtin_count_is_less_than` (see `AIPL_BUILTIN_SOURCES` in `lib.rs`).
//
// A fused comparison: `count(x) < limit` without counting past the point the answer is
// settled. `count` itself always walks the whole collection; this stops at the
// first element that decides it, which is the entire reason the fusion pass
// exists.
pub fn count_is_less_than<T: any>(self: T[], x: T, limit: u64) -> bool {
    if (limit == 0) {
        return false;
    };
    mut n: u64 = 0;
    for (let e : self) {
        if (e == x) {
            set n++;
            if (n >= limit) {
                return false;
            };
        };
    }
    true
}.doc("""
    Fused form of `count(x) < limit` — see `count`. Counts only as far as the answer
    needs, so a an early match decides it without walking the rest.

    Written by the compiler's operation-fusion pass, which rewrites
    `xs.count(x) < n` (and the mirrored `n > xs.count(x)`) into this. Also
    callable directly.
""").test({
    assert([1, 2, 2, 3].count_is_less_than(2, 2) == ([1, 2, 2, 3].count(2) < 2));
    assert([1, 2, 2, 3].count_is_less_than(2, 3) == ([1, 2, 2, 3].count(2) < 3));
    assert([1, 2, 2, 3].count_is_less_than(2, 1) == ([1, 2, 2, 3].count(2) < 1));
    assert([1, 2, 2, 3].count_is_less_than(2, 0) == ([1, 2, 2, 3].count(2) < 0));
    assert([1, 2, 3].count_is_less_than(9, 0) == ([1, 2, 3].count(9) < 0)); // no matches
    assert([].count_is_less_than(1, 0) == (0 < 0)); // empty
})
