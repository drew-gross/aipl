import { equal as ==, first, is_empty, len } from builtins;

// The AIPL implementation of the `drop_n` builtin (see `AIPL_BUILTIN_SOURCES`
// in `lib.rs`).
//
// A start past the end already slices to empty, so dropping more than there is
// needs no guard.
# Every element except the first `n`. Dropping `n >= len` gives an empty
# array — the same clamping an out-of-range slice does.
pub fn drop_n<T: any>(self: T[], n: u64) -> T[] { self[n..] }.test({
    assert([1, 2, 3].drop_n(1).len() == 2);
    assert([1, 2, 3].drop_n(1).first() == some(2));
    assert([1, 2, 3].drop_n(0).len() == 3);
    // At and past the end: empty, not an error.
    assert([1, 2, 3].drop_n(3).is_empty());
    assert([1, 2, 3].drop_n(99).is_empty());
    assert(drop_n(["a", "b"], 1).first() == some("b")); // free-call form
})
