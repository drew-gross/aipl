# The AIPL implementation of the `drop_n` builtin (see
# `aipl_syntax::aipl_builtins`).
#
# A start past the end already slices to empty, so dropping more than there is
# needs no guard.

import { equal as ==, first, is_empty, len } from builtins;

# Every element except the first `n`.
pub fn drop_n<T: any>(
    self: T[],
    # How many to drop from the front; at or past the length it gives an empty array, the same
    # clamping an out-of-range slice does.
    n: u64,
) -> T[] { self[n..] }.test({
    assert([1, 2, 3].drop_n(1).len() == 2);
    assert([1, 2, 3].drop_n(1).first()? == 2);
    assert([1, 2, 3].drop_n(0).len() == 3);
    // At and past the end: empty, not an error.
    assert([1, 2, 3].drop_n(3).is_empty());
    assert([1, 2, 3].drop_n(99).is_empty());
    assert(drop_n(["a", "b"], 1).first()? == "b"); // free-call form
})
