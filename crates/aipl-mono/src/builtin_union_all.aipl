# The AIPL implementation of the `union_all` builtin. Monomorphization
# registers this function under the canonical name `__builtin_union_all` (see
# `AIPL_BUILTIN_SOURCES` in `lib.rs`), so a user's `xs.union_all()` specializes
# through the ordinary generic machinery — the in-file name `union_all` is only
# for this file's own tests, which read exactly like user code.

import { equal as ==, filter, greater_than as >, len, union } from builtins;

# Every element of every set in `self`, collected into one set — `union` folded
# across a list. An empty list gives the empty set, and a one-element list gives
# that set back unchanged.
#
# This is the whole content of the `mut out = #{}; for (let s : xs) { set out =
# out.union(s); }` longhand, which is why `union_loop_union_all` flags that shape
# and points here.
pub fn union_all<T: any>(self: #{T}[]) -> #{T} {
    // `union_loop_union_all` flags this loop, correctly: it is the longhand the
    // lint exists to replace. It is also the *implementation* of the shorthand,
    // so taking the advice would have `union_all` call itself.
    mut out: #{T} = #{}; #[allow]
    for (let s : self) {
        set out = out.union(s);
    }
    out
}.test({
    assert([#{1, 2}, #{2, 3}, #{4}].union_all() == #{1, 2, 3, 4}); // overlapping
    assert(union_all([#{1}, #{2}]) == #{1, 2}); // free-call form
    assert([#{7, 8}].union_all() == #{7, 8}); // one set, given back
    assert([#{1}, #{1}, #{1}].union_all() == #{1}); // all duplicates collapse
    // An empty *list* of sets, and a list of empty sets: both give the empty set.
    let none_at_all: #{i64}[] = [#{1}].filter(|s| s.len() > 5);
    assert(none_at_all.union_all() == #{});
    let empties: #{i64}[] = [#{}, #{}];
    assert(empties.union_all() == #{});
    // A single empty set among non-empty ones contributes nothing.
    assert([#{1}, #{}, #{2}].union_all() == #{1, 2});
    // Any element type a set can hold.
    assert([#{"a"}, #{"b", "a"}].union_all() == #{"a", "b"});
    assert([#{'x'}, #{'y'}].union_all() == #{'x', 'y'});
    assert([#{true}, #{false}].union_all() == #{false, true});
})
