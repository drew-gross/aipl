# The AIPL implementation of the `count_is_not_equal` builtin. Registered under
# `__builtin_count_is_not_equal` (see `aipl_syntax::aipl_builtins`).
#
# A fused comparison: `count(x) != limit` without counting past the point the answer is
# settled. Once the running count exceeds `limit` it can never come back, so the
# rest of the collection cannot change the answer.

import {
    count,
    equal as ==,
    greater_than as >,
    not_equal as !=,
    wrapping_increment as ++,
} from builtins;

# Fused form of `count(x) != limit` — see `count`. Stops as soon as the count passes
# `limit`, since no later element can bring it back.
#
# Written by the compiler's operation-fusion pass, which rewrites
# `xs.count(x) != n` (and the mirrored form) into this. Also callable directly.
pub fn count_is_not_equal<T: any>(self: T[], x: T, limit: u64) -> bool {
    mut n: u64 = 0;
    for (let e : self) {
        if (e == x) {
            set n++;
            if (n > limit) {
                return true;
            };
        };
    }
    n != limit
}.test({
    assert([1, 2, 2, 3].count_is_not_equal(2, 2) == ([1, 2, 2, 3].count(2) != 2));
    assert([1, 2, 2, 3].count_is_not_equal(2, 3) == ([1, 2, 2, 3].count(2) != 3));
    assert([1, 2, 2, 3].count_is_not_equal(2, 1) == ([1, 2, 2, 3].count(2) != 1));
    assert([1, 2, 2, 3].count_is_not_equal(2, 0) == ([1, 2, 2, 3].count(2) != 0));
    assert([1, 2, 3].count_is_not_equal(9, 0) == ([1, 2, 3].count(9) != 0)); // no matches
    assert([].count_is_not_equal(1, 0) == (0 != 0)); // empty
})
