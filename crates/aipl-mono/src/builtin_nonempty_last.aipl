import { equal as ==, len, wrapping_sub as - } from builtins;

// The AIPL implementation of the `nonempty_last` builtin (see
// `AIPL_BUILTIN_SOURCES` in `lib.rs`); `nonempty_first`'s mirror, and `last`
// for an array the type system knows is not empty. The `none` arm recurses
// for the reason `nonempty_first`'s does.
# The last element of a non-empty array — the element itself, not a `T?`,
# because a `T[] without []` has one. `last` is the same question for an array
# that may be empty.
pub fn nonempty_last<T: any>(self: T[] without []) -> T {
    match (self[self.len() - 1]) {
        some(v) => v,
        none => self.nonempty_last(),
    }
}.test({
    let xs: i64[] without [] = [1, 2, 3];
    assert(xs.nonempty_last() == 3);
    assert(nonempty_last(xs) == 3); // free-call form
    let one: str[] without [] = ["only"];
    assert(one.nonempty_last() == "only");
    let cs: char[] without [] = ['a', 'b'];
    assert(cs.nonempty_last() == 'b');
})
