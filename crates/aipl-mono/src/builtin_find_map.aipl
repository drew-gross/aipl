# The AIPL implementation of the `find_map` builtin. Monomorphization
# registers this function under the canonical name `__builtin_find_map` (see
# `AIPL_BUILTIN_SOURCES` in `lib.rs`), so a user's `xs.find_map(f)` resolves
# through the ordinary generic / higher-order machinery — the in-file name is
# only for this file's own tests, which read exactly like user code.
#
# It is the one-pass shape of `xs.map(f).find_if(is_some)` with the double
# optional that chain produces already peeled: the first element `f` has an
# answer for, and that answer. The `map_find_if_some` lint sends the chain
# here.

import { equal as ==, greater_than as >, to_digit, wrapping_mul as * } from builtins;

# The first `some` that `f` returns over the elements of `self`, unwrapped
# one level — `some(y)` for the first `x` with `f(x) == some(y)`, `none` when
# every `f(x)` is `none` — stopping at that element. A `str` receiver iterates
# its chars.
#
# See `find_if` for a predicate on the elements themselves, and `map_find_if`
# for a predicate on the mapped values.
pub fn find_map<T: any, U: any>(self: T[], f: (T) -> U?) -> U? {
    for (let x : self) {
        if (let some(y) = f(x)) {
            return some(y);
        };
    }
    none
}.test({
    fn nonzero(self: i64) -> i64? { if (self == 0) { none } else { some(self) } }
    assert(nonzero(0) == none);
    assert(nonzero(2) == some(2));

    assert([0, 3, 5].find_map(nonzero) == some(3));
    assert([0, 0].find_map(nonzero) == none);
    // The first answer, not the last, and the lambda form.
    assert([1, 2, 3].find_map(|x| if (x > 1) { some(x * 10) } else { none }) == some(20));
    // Free-call form, and the empty array.
    assert(find_map([1, 2][..0], nonzero) == none);
    // A `str` receiver iterates its chars.
    assert("a1b".find_map(to_digit) == some(1));
})
