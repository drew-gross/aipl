# The AIPL implementation of the `count` builtin. The loader names this function
# by the canonical name `__builtin_count` (see `aipl_syntax::aipl_builtins`), so
# a user's `xs.count(x)` resolves through the ordinary generic machinery — the
# in-file name `count` is only for this file's own tests, which read exactly
# like user code.
#
# The counterpart of `count_while`, which counts a *leading run* matching a
# predicate; this counts *every* element equal to a value, anywhere. Unsigned,
# like `len`: a count is never negative.

import { equal as ==, wrapping_increment as ++ } from builtins;

# Counts how many elements of `self` equal `x`, comparing with `==` (so strings
# and chars compare by value). A `str` receiver counts bytes, since `str` and
# `char[]` share a representation: `s.count('\\n')` is the number of newlines in
# `s`.
#
# See `count_while` for the leading-run-matching-a-predicate form.
pub fn count<T: any>(self: T[], x: T) -> u64 {
    mut n: u64 = 0;
    for (let e : self) {
        if (e == x) { set n++; };
    }
    n
}.test({
    assert([1, 2, 3, 2].count(2) == 2);
    assert([1, 2, 3].count(9) == 0); // absent
    assert([].count(1) == 0); // empty
    assert([7, 7, 7].count(7) == 3); // every element
    assert(count([2, 2], 2) == 2); // function-call form too

    // Generic over the element type — the same definition serves char and str,
    // and comparison is by value, not identity.
    assert(['a', 'b', 'a'].count('a') == 2);
    assert(["go", "stop", "go"].count("go") == 2);

    // A `str` receiver counts bytes: `str` and `char[]` share a representation.
    assert("a\nb\nc".count('\n') == 2);
    assert("abc".count('\n') == 0);
    assert("".count('\n') == 0);
})
