# The AIPL implementation of the `map_to_dict` builtin. The loader names this
# function by the canonical name `__builtin_map_to_dict` (see
# `aipl_syntax::builtin`), so a user's `xs.map_to_dict(f)` resolves through the
# ordinary generic / higher-order machinery — the in-file name is only for this
# file's own tests, which read exactly like user code.
#
# It is what `xs.map(f).to_dict()` means, without the array of pairs: `map`
# would build one `(key, value)` per element for `to_dict` to walk once and
# drop, where here each pair is bound as `f` produces it. Written by the
# compiler's operation-fusion pass for that chain (see `chain_fusions` in
# aipl-mono); also callable directly.
#
# No lint steers a hand-written loop here: `push_loop_pipeline` already sends a
# building loop to `map`, from where the chain fuses.

import {
    equal as ==,
    insert_key,
    is_empty,
    saturating_remainder as %,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

# `self.map(f).to_dict()`: every element through `f` to a `(key, value)` pair,
# bound in a dict as it is produced. As with `to_dict`, the last pair for a key
# wins and the key keeps the place of its first.
pub fn map_to_dict<T: any, K: any, V: any>(self: T[], f: (T) -> (K, V)) -> #{K: V} {
    mut out: #{K: V} = #{};
    for (let x : self) {
        let pair = f(x);
        set out.insert_key(pair.0, pair.1);
    }
    out
}.test({
    fn square_pair(self: i64) -> (i64, i64) { (self, self * self) }
    assert(square_pair(3) == (3, 9));

    assert([1, 2, 3].map_to_dict(square_pair) == #{1: 1, 2: 4, 3: 9}); // named function
    assert([1, 2].map_to_dict(|x| (x, x + 10)) == #{1: 11, 2: 12}); // lambda
    assert(map_to_dict([5], square_pair) == #{5: 25}); // free-call form
    let offset = 100;
    assert([1].map_to_dict(|x| (x + offset, "v")) == #{101: "v"}); // captured bound
    assert(["a", "bb"].map_to_dict(|s| (s, s)) == #{"a": "a", "bb": "bb"}); // str elements and keys
    let nothing: i64[] = [];
    assert(nothing.map_to_dict(square_pair).is_empty()); // empty
    assert([1, 2, 3, 4].map_to_dict(|x| (x % 2, x)) == #{1: 3, 0: 4}); // last write wins
})
