# The AIPL implementation of the `drop_last_n` builtin (see
# `aipl_syntax::aipl_builtins`); `drop_n`'s mirror.
#
# The guard is deliberate rather than emergent. Without it, `len() - n` for
# `n > len` wraps to a value that reads as a *negative* slice bound, which does
# happen to produce an empty array — but that is an accident of how a wrapped
# `u64` is interpreted, not a stated rule. Spelling the empty case out keeps the
# contract independent of that.

import { equal as ==, first, is_empty, last, len, less_than as <, wrapping_sub as - } from builtins;

# Every element except the last `n`. Dropping `n >= len` gives an empty array,
# mirroring `drop_n`.
pub fn drop_last_n<T: any>(self: T[], n: u64) -> T[] {
    if (self.len() < n) { self[..0] } else { self[..self.len() - n] }
}.test({
    assert([1, 2, 3].drop_last_n(1).len() == 2);
    assert([1, 2, 3].drop_last_n(1).last() == some(2));
    assert([1, 2, 3].drop_last_n(0).len() == 3);
    // At and past the end: empty, not the whole array.
    assert([1, 2, 3].drop_last_n(3).is_empty());
    assert([1, 2, 3].drop_last_n(99).is_empty());
    assert(drop_last_n(["a", "b"], 1).first() == some("a")); // free-call form
})
