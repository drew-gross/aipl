# A todo list, shown in a window. `todo` opens it, with nothing to do and a button to add the first
# item; `todo gallery` shows every element the window can draw, from constants. The list lives only as
# long as the window: nothing is saved yet. GUI_TODO_APP.md plans the rest.

import {
    drop_first,
    equal as ==,
    filter,
    first,
    is_empty,
    len,
    logical_and as &&,
    logical_not as !,
    not_equal as !=,
    print,
    push,
    starts_with,
    value_or,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;
import {
    Button,
    Checkbox,
    Column,
    Element,
    Field,
    Label,
    Row,
    Separator,
    to_text,
} from "./elements.aipl";
import {
    Clicked,
    CloseRequested,
    Closed,
    QuitRequested,
    parse_event,
    wait_until_closed,
} from "./events.aipl";
import { close_window, next_event, show_view } from gui;

# One thing to do.
struct Todo { text: str, done: bool }

# What the command line asks for.
variant Command = Show | Gallery

# What a run came to: a window to show, with its title, or the list to use in a window.
variant Outcome = Window(str, Element) | Interact

# `self` as a row of the window: a checkbox for whether it is done, and its text, struck through
# and muted once it is.
fn row(self: Todo) -> Element {
    Row([Checkbox("", checked=self.done), Label(self.text, muted=self.done, strike=self.done)])
}.test({
    assert(Todo { text: "a", done: false }.row() == Row([Checkbox(""), Label("a")]));
    assert(Todo { text: "a", done: true }.row() == Row([
        Checkbox("", checked=true),
        Label("a", muted=true, strike=true),
    ]));
})

# `self` as the window: a title, a row for each item and a button for another, or a button for the
# first when there is none, and how many are left.
fn view(self: Todo[]) -> Element {
    let rows = if (self.is_empty()) {
        [Label("Nothing to do.", muted=true), Button("Add your first todo", "add-first")]
    } else {
        [..self$row(), Button("Add a todo", "add")]
    };
    let left = self.filter(|todo| !todo.done).len();
    Column(
        [
            Label("Todo", size=24, bold=true),
            Separator(),
            ..rows,
            Separator(),
            Label(`{left} left`, muted=true),
        ],
        padding=16,
        icon="✓",
    )
}.test({
    assert([].view() == Column(
        [
            Label("Todo", size=24, bold=true),
            Separator(),
            Label("Nothing to do.", muted=true),
            Button("Add your first todo", "add-first"),
            Separator(),
            Label("0 left", muted=true),
        ],
        padding=16,
        icon="✓",
    ));
    let list = [Todo { text: "a", done: false }, Todo { text: "b", done: true }];
    assert(
        list.view().to_text() == """
            column spacing=8 padding=16 icon="✓"
              label "Todo" size=24 bold
              separator
              row spacing=8
                checkbox ""
                label "a"
              row spacing=8
                checkbox "" checked
                label "b" muted strike
              button "Add a todo" key="add"
              separator
              label "1 left" muted

        """,
    );
})

# One of each element, with the options each takes, from constants: what to look at while the
# elements are drawn.
fn gallery() -> Element {
    Column(
        [
            Label("Elements", size=24, bold=true),
            Separator(),
            Label("A label"),
            Label("A large label", size=20),
            Label("A bold label", bold=true),
            Label("A muted label", muted=true),
            Label("A struck label", strike=true),
            Separator(),
            Row([Button("A button", "gallery-button"), Button("Another", "gallery-another")]),
            Row([Checkbox("Unchecked"), Checkbox("Checked", checked=true)]),
            Field(placeholder="A text field", width=240),
            Field(value="A field with text", width=240),
            Separator(),
            Row([Label("A row", muted=true), Label("of labels"), Label("spaced out")], spacing=24),
            Column([Label("A column"), Label("inside a column")], padding=12, spacing=2),
        ],
        padding=16,
        icon="▦",
    )
}.test({
    assert(
        gallery()
            .to_text()
            .starts_with(
                `column spacing=8 padding=16 icon="▦"\n  label "Elements" size=24 bold\n`,
            ),
    );
})

# `self` as the button `key` was clicked changes it: the first item is added to an empty list, another
# to any list, and a click on a button nothing is made of is not a change. (The text of an added item
# is a placeholder until a window can be typed into.)
fn clicked(self: Todo[], key: str) -> Todo[] {
    if (key == "add-first" && self.is_empty()) {
        [Todo { text: "My first todo", done: false }]
    } else if (key == "add") {
        [..self, Todo { text: `Todo {self.len() + 1}`, done: false }]
    } else {
        self
    }
}.test({
    assert([].clicked("add-first") == [Todo { text: "My first todo", done: false }]);

    // The button for the first is only there while the list is empty, so a late click on it adds
    // nothing.
    let list = [Todo { text: "a", done: false }];
    assert(list.clicked("add-first") == list);
    assert([].clicked("elsewhere").is_empty());
    // Another goes at the end and is numbered by where it lands.
    assert(list.clicked("add") == [
        Todo { text: "a", done: false },
        Todo { text: "Todo 2", done: false },
    ]);
    assert(list.clicked("add").clicked("add").len() == 3);
    assert(list.clicked("add").clicked("add")[2] == some(Todo { text: "Todo 3", done: false }));
})

# Show an empty list in a window, and keep the window to date as it is used, until the window is gone:
# it is closed when asked to close or to quit.
fn interact() !gui {
    mut list: Todo[] = [];
    mut open = true;
    show_view("Todo", list.view().to_text());
    while (open) {
        match (parse_event(next_event())) {
            ok(Closed) => {
                set open = false;
            },
            ok(CloseRequested) | ok(QuitRequested) => {
                close_window();
            },
            ok(Clicked(key)) => {
                let changed = list.clicked(key);
                if (changed != list) {
                    set list = changed;
                    show_view("Todo", list.view().to_text());
                };
            },
            err(..) => {},
        };
    }
}.test({
    // A click on the button of an empty list adds the first item and shows it; the new window offers
    // a button for another, and a click on the first one's, which it no longer offers, changes
    // nothing.
    mut script = [
        "clicked add-first",
        "clicked add",
        "clicked add-first",
        "close_requested",
        "closed",
    ];
    mut shown: str[] = [];
    mut closes: u64 = 0;
    shim gui {
        show_window = |title, text| {},
        show_view = |title, view| {
            set shown.push(view);
        },
        next_event = || {
            let next = script.first().value_or("closed");
            set script = script.drop_first();
            next
        },
        close_window = || {
            set closes++;
        },
    } {
        interact();
    };
    assert(closes == 1);

    // The empty list's window, then the window with the item in it, then with two: one for each
    // state the list was in, and none for the click that changed nothing.
    let first = [Todo { text: "My first todo", done: false }];
    assert(shown == [
        [].view().to_text(),
        first.view().to_text(),
        [..first, Todo { text: "Todo 2", done: false }].view().to_text(),
    ]);
    assert(script.is_empty());
})

# What the command line `args` asks for.
fn parse_command(args: str[]) -> Command!str {
    match (args) {
        [] => ok(Show),
        ["show"] => ok(Show),
        ["gallery"] => ok(Gallery),
        [verb] => err(`unknown command {verb}`),
        _ => err("expected at most one command"),
    }
}.test({
    assert(parse_command([]) == ok(Show));
    assert(parse_command(["show"]) == ok(Show));
    assert(parse_command(["gallery"]) == ok(Gallery));
    assert(parse_command(["frobnicate"]) == err("unknown command frobnicate"));
    assert(parse_command(["show", "gallery"]) == err("expected at most one command"));
})

# What running `args` comes to.
fn run(args: str[]) -> Outcome!str {
    match (parse_command(args)?) {
        Show => ok(Interact),
        Gallery => ok(Window("Gallery", gallery())),
    }
}.test({
    assert(run([]) == ok(Interact));
    assert(run(["gallery"]) == ok(Window("Gallery", gallery())));
    assert(run(["nope"]) == err("unknown command nope"));
})

# Open the list in a window, or with `gallery` a window of every element. Exits 1, after saying why,
# for a command that makes no sense.
fn main(args: str[]) !prints !gui -> i64 {
    match (run(args)) {
        err(reason) => {
            print(`todo: {reason}`);
            print("usage: todo [show | gallery]");
            1
        },
        ok(Window(title, view)) => {
            show_view(title, view.to_text());
            wait_until_closed();
            0
        },
        ok(Interact) => {
            interact();
            0
        },
    }
}
