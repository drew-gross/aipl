# A todo list, shown in a window. `todo` opens it, with nothing to do and a button to add the first
# item; `todo gallery` shows every element the window can draw, from constants. The list lives only as
# long as the window: nothing is saved yet. GUI_TODO_APP.md plans the rest.
#
# It is written the way the React version is: `todo_app` is a function of the list that answers the
# elements to show, `item` is a component it uses, and what a button does when it is clicked is
# written on the button as a closure that names the list it changes, `[mut todos] || { .. }`, made
# where the list is and handed down to the components as a callback.

import {
    drop_first,
    equal as ==,
    filter,
    first,
    is_empty,
    len,
    logical_not as !,
    not_equal as !=,
    print,
    push,
    remove_index,
    starts_with,
    value_or,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;
import {
    Button,
    Checkbox,
    Column,
    Element,
    Field,
    Label,
    Row,
    Separator,
    click,
    to_text,
} from "./elements.aipl";
import {
    Clicked,
    CloseRequested,
    Closed,
    QuitRequested,
    parse_event,
    wait_until_closed,
} from "./events.aipl";
import { close_window, next_event, show_view } from gui;

# One thing to do.
struct Todo { text: str, done: bool }

# What the command line asks for.
variant Command = Show | Gallery

# What a run came to: a window to show, with its title and what is in it, or the list to use in
# a window.
variant Outcome = Window(str, str) | Interact

# `self` as a row of the window: a checkbox for whether it is done, its text, struck through and
# muted once it is, and a button that calls `remove`.
fn item(self: Todo, remove: () mut -> ()) -> Element {
    Row([
        Checkbox("", checked=self.done),
        Label(self.text, muted=self.done, strike=self.done),
        Button("Remove", remove),
    ])
}.test({
    assert(
        Todo { text: "a", done: false }.item(|| {}).to_text() == """
            row spacing=8
              checkbox ""
              label "a"
              button "Remove" key="b0.2"

        """,
    );
    assert(
        Todo { text: "b", done: true }.item(|| {}).to_text() == """
            row spacing=8
              checkbox "" checked
              label "b" muted strike
              button "Remove" key="b0.2"

        """,
    );
    // The button is what calls `remove`.
    mut removed = 0;
    Todo { text: "a", done: false }
        .item([mut removed] || {
            set removed++;
        })
        .click("b0.2");
    assert(removed == 1);
})

# The title of the window, and a line under it.
fn header() -> Element[] { [Label("Todo", size=24, bold=true), Separator()] }

# A line, and how many of the items are not done.
fn footer(left: u64) -> Element[] { [Separator(), Label(`{left} left`, muted=true)] }

# The window for the list `self`: a title, the rows and a button for another, or for the first when there is none, and how many are left.
fn todo_app(
    self: Todo[],
    # The elements of the items, one each.
    rows: Element[],
    # Called when the button for another item (or the first) is clicked.
    add: () mut -> (),
) -> Element {
    let label = if (self.is_empty()) { "Add your first todo" } else { "Add a todo" };
    let left = self.filter(|todo| !todo.done).len();
    Column(
        [
            ..header(),
            ..if (self.is_empty()) { [Label("Nothing to do.", muted=true)] } else { rows },
            Button(label, add),
            ..footer(left),
        ],
        padding=16,
        icon="✓",
    )
}.test({
    let list = [Todo { text: "a", done: false }, Todo { text: "b", done: true }];
    assert(
        [].todo_app([], || {}).to_text() == """
            column spacing=8 padding=16 icon="✓"
              label "Todo" size=24 bold
              separator
              label "Nothing to do." muted
              button "Add your first todo" key="b0.3"
              separator
              label "0 left" muted

        """,
    );
    assert(
        list.todo_app([Label("row a"), Label("row b")], || {}).to_text() == """
            column spacing=8 padding=16 icon="✓"
              label "Todo" size=24 bold
              separator
              label "row a"
              label "row b"
              button "Add a todo" key="b0.4"
              separator
              label "1 left" muted

        """,
    );

    // The button calls `add`, and only the button.
    mut added = 0;
    let view = list.todo_app(
        [],
        [mut added] || {
            set added++;
        },
    );
    view.click("b0.2");
    assert(added == 1);
    view.click("nothing");
    assert(added == 1);
})

# One of each element, with the options each takes, from constants: what to look at while the
# elements are drawn.
fn gallery() -> Element {
    Column(
        [
            Label("Elements", size=24, bold=true),
            Separator(),
            Label("A label"),
            Label("A large label", size=20),
            Label("A bold label", bold=true),
            Label("A muted label", muted=true),
            Label("A struck label", strike=true),
            Separator(),
            Row([Button("A button", || {}), Button("Another", || {})]),
            Row([Checkbox("Unchecked"), Checkbox("Checked", checked=true)]),
            Field(placeholder="A text field", width=240),
            Field(value="A field with text", width=240),
            Separator(),
            Row([Label("A row", muted=true), Label("of labels"), Label("spaced out")], spacing=24),
            Column([Label("A column"), Label("inside a column")], padding=12, spacing=2),
        ],
        padding=16,
        icon="▦",
    )
}.test({
    assert(
        gallery()
            .to_text()
            .starts_with(
                `column spacing=8 padding=16 icon="▦"\n  label "Elements" size=24 bold\n`,
            ),
    );
})

# Show the empty list in a window, and keep the window to date as it is used, until the window is gone:
# it is closed when asked to close or to quit. The list is `todos`; the window is built from it, and
# the buttons' closures change it.
fn interact() !gui {
    mut todos: Todo[] = [];
    let add = [mut todos] || {
        let text = if (todos.is_empty()) { "My first todo" } else { `Todo {todos.len() + 1}` };
        set todos.push(Todo { text, done: false });
    };
    mut view = Label("");
    mut changed = true;
    mut open = true;
    while (open) {
        if (changed) {
            mut rows: Element[] = [];
            for (let index, todo : todos) {
                set rows.push(todo.item([mut todos] || {
                    set todos = todos.remove_index(index);
                }));
            }
            set view = todos.todo_app(rows, add);
            show_view("Todo", view.to_text());
            set changed = false;
        };
        match (parse_event(next_event())) {
            ok(Closed) => {
                set open = false;
            },
            ok(CloseRequested) | ok(QuitRequested) => {
                close_window();
            },
            ok(Clicked(key)) => {
                let before = todos;
                view.click(key);
                set changed = todos != before;
            },
            err(..) => {},
        };
    }
}.test({
    // The window for `todos`, from handlers that do nothing: the text does not show them.
    fn shows(todos: Todo[]) -> str { todos.todo_app(todos$item(|| {}), || {}).to_text() }

    // A click on the button of an empty list adds the first item and shows it; the new window's
    // button adds another, and the first item's removes it, and then the other. A click on a button
    // that is not there changes nothing, and the window is not drawn again.
    mut script = [
        "clicked b0.3",
        "clicked b0.3",
        "clicked b0.2.2",
        "clicked b0.2.2",
        "clicked b0.9",
        "close_requested",
        "closed",
    ];
    mut shown: str[] = [];
    mut closes: u64 = 0;
    shim gui {
        show_window = |title, text| {},
        show_view = |title, view| {
            set shown.push(view);
        },
        next_event = || {
            let next = script.first().value_or("closed");
            set script = script.drop_first();
            next
        },
        close_window = || {
            set closes++;
        },
    } {
        interact();
    };
    assert(closes == 1);

    // The empty list's window, the window with the item in it, with two, with one after the first is
    // removed, and with none after the other is: one for each state the list was in, and none for
    // the click that changed nothing.
    let first = [Todo { text: "My first todo", done: false }];
    let second = [..first, Todo { text: "Todo 2", done: false }];
    assert(shown == [
        shows([]),
        shows(first),
        shows(second),
        shows([Todo { text: "Todo 2", done: false }]),
        shows([]),
    ]);
    assert(script.is_empty());
})

# What the command line `args` asks for.
fn parse_command(args: str[]) -> Command!str {
    match (args) {
        [] => ok(Show),
        ["show"] => ok(Show),
        ["gallery"] => ok(Gallery),
        [verb] => err(`unknown command {verb}`),
        _ => err("expected at most one command"),
    }
}.test({
    assert(parse_command([]) == ok(Show));
    assert(parse_command(["show"]) == ok(Show));
    assert(parse_command(["gallery"]) == ok(Gallery));
    assert(parse_command(["frobnicate"]) == err("unknown command frobnicate"));
    assert(parse_command(["show", "gallery"]) == err("expected at most one command"));
})

# What running `args` comes to.
fn run(args: str[]) -> Outcome!str {
    match (parse_command(args)?) {
        Show => ok(Interact),
        Gallery => ok(Window("Gallery", gallery().to_text())),
    }
}.test({
    assert(run([]) == ok(Interact));
    assert(run(["gallery"]) == ok(Window("Gallery", gallery().to_text())));
    assert(run(["nope"]) == err("unknown command nope"));
})

# Open the list in a window, or with `gallery` a window of every element. Exits 1, after saying why,
# for a command that makes no sense.
fn main(args: str[]) !prints !gui -> i64 {
    match (run(args)) {
        err(reason) => {
            print(`todo: {reason}`);
            print("usage: todo [show | gallery]");
            1
        },
        ok(Window(title, view)) => {
            show_view(title, view);
            wait_until_closed();
            0
        },
        ok(Interact) => {
            interact();
            0
        },
    }
}
