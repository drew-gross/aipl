# The elements a window is made of, and the text form `show_view` is given them in.
#
# An element is a case of `Element<M>`, built like any variant, with what it leaves out at its
# default: `Label("Todo", size=24, bold=true)`, `Column([..], padding=16)`. A `Column` or `Row`
# holds elements, which is how a view is composed. `M` is the model the view is of, and a `Button`
# holds what a click does to it, `|model| { .. }`, as the function that answers the model
# after the click, the way React's `setState(model => ..)` is given one. What names an element in
# the events it causes is its `key`, which it need not be given: it is where the element is in the
# tree, until one is written. The root takes an `icon`, a glyph the window draws as the
# application's icon.
# `to_text` writes a view as the lines the runtime reads, one element a line with its children
# indented two spaces under it, and `click` applies the handler of the button an event names. The
# runtime's reader (`gui_cocoa.rs`) says what each element means.

import {
    equal as ==,
    extend,
    greater_than as >,
    is_empty,
    join,
    repeat,
    split,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

variant Element<M> =
    | Column(
        children: Element<M>[],
        spacing: u64 = 8,
        padding: u64 = 0,
        width: u64 = 0,
        key: str = "",
        icon: str = ""
    )
    | Row(
        children: Element<M>[],
        spacing: u64 = 8,
        padding: u64 = 0,
        width: u64 = 0,
        key: str = "",
        icon: str = ""
    )
    | Label(
        text: str,
        size: u64 = 0,
        bold: bool = false,
        muted: bool = false,
        strike: bool = false,
        key: str = ""
    )
    | Button(text: str, on_click: (M) -> M, key: str = "")
    | Checkbox(text: str, checked: bool = false, key: str = "")
    | Field(value: str = "", placeholder: str = "", width: u64 = 0, key: str = "")
    | Separator(key: str = "")

# `text` in double quotes, with a backslash, a quote, a newline and a tab written as the runtime
# reads them.
fn quoted(self: str) -> str {
    let slashes = self.split("""\""").join(sep="""\\""");
    let quotes = slashes.split(`"`).join(sep=`\\"`);
    let newlines = quotes.split("\n").join(sep="""\n""");
    let tabs = newlines.split("\t").join(sep="""\t""");
    `"{tabs}"`
}.test({
    assert("plain".quoted() == `"plain"`);
    assert("".quoted() == `""`);
    assert(`say "hi"`.quoted() == `"say \\"hi\\""`);
    assert("""a\b""".quoted() == `"a\\\\b"`);
    assert("two\nlines\tand a tab".quoted() == `"two\\nlines\\tand a tab"`);
})

# `name=value`, or nothing when the value is the default 0.
fn number(name: str, value: u64) -> str[] {
    if (value > 0) { [`{name}={value}`] } else { [] }
}.test({
    assert(number("size", 24) == ["size=24"]);
    assert(number("size", 0).is_empty());
})

# `name`, when `on`.
fn flag(name: str, on: bool) -> str[] { if (on) { [name] } else { [] } }.test({
    assert(flag("bold", true) == ["bold"]);
    assert(flag("bold", false).is_empty());
})

# `name="value"`, or nothing when the value is empty.
fn text_attribute(name: str, value: str) -> str[] {
    if (value.is_empty()) { [] } else { [`{name}={value.quoted()}`] }
}.test({
    assert(text_attribute("key", "row 1") == [`key="row 1"`]);
    assert(text_attribute("key", "").is_empty());
})

# The line for an element made of `parts`, indented `depth` levels.
fn line(self: str[], depth: u64) -> str { `{" ".repeat(depth * 2)}{self.join(sep=" ")}` }.test({
    assert(["label", `"x"`].line(0) == `label "x"`);
    assert(["label", `"x"`].line(2) == `    label "x"`);
})

# The lines of a container at `path`: its own, then those of its children one level in, each at
# its place in the tree.
fn container<M>(
    name: str,
    children: Element<M>[],
    attributes: str[],
    depth: u64,
    path: str,
) -> str[] {
    mut out = [[name, ..attributes].line(depth)];
    for (let index, child : children) {
        set out.extend(child.lines(depth + 1, `{path}.{index}`));
    }
    out
}

# What names a button in the events it causes: the key it was given, and else where it is in the
# tree, `b0.2.1`.
fn event_key(key: str, path: str) -> str { if (key.is_empty()) { `b{path}` } else { key } }.test({
    assert(event_key("add", "0.2") == "add");
    assert(event_key("", "0.2") == "b0.2");
})

# `self` as lines of the text form, indented `depth` levels, at `path` in the tree.
fn lines<M>(self: Element<M>, depth: u64, path: str) -> str[] {
    match (self) {
        Column(children, spacing, padding, width, key, icon) => container(
            "column",
            children,
            [
                `spacing={spacing}`,
                ..number("padding", padding),
                ..number("width", width),
                ..text_attribute("key", key),
                ..text_attribute("icon", icon),
            ],
            depth,
            path,
        ),
        Row(children, spacing, padding, width, key, icon) => container(
            "row",
            children,
            [
                `spacing={spacing}`,
                ..number("padding", padding),
                ..number("width", width),
                ..text_attribute("key", key),
                ..text_attribute("icon", icon),
            ],
            depth,
            path,
        ),
        Label(text, size, bold, muted, strike, key) => [
            [
                "label",
                text.quoted(),
                ..number("size", size),
                ..flag("bold", bold),
                ..flag("muted", muted),
                ..flag("strike", strike),
                ..text_attribute("key", key),
            ].line(depth),
        ],
        Button(text, _, key) => [
            ["button", text.quoted(), `key={event_key(key, path).quoted()}`].line(depth),
        ],
        Checkbox(text, checked, key) => [
            [
                "checkbox",
                text.quoted(),
                ..flag("checked", checked),
                ..text_attribute("key", key),
            ].line(depth),
        ],
        Field(value, placeholder, width, key) => [
            [
                "field",
                ..text_attribute("value", value),
                ..text_attribute("placeholder", placeholder),
                ..number("width", width),
                ..text_attribute("key", key),
            ].line(depth),
        ],
        Separator(key) => [["separator", ..text_attribute("key", key)].line(depth)],
    }
}.test({
    // What a view of no model in particular is a view of.
    fn numbers(view: Element<i64>) -> Element<i64> { view }

    assert(numbers(Label("Todo")).lines(0, "0") == [`label "Todo"`]);
    assert(numbers(Label("Todo", size=24, bold=true)).lines(1, "0") == [
        `  label "Todo" size=24 bold`,
    ]);
    assert(numbers(Label("x", muted=true, strike=true, key="k")).lines(0, "0") == [
        `label "x" muted strike key="k"`,
    ]);
    assert(Button("Add", |n: i64| { n }, key="add").lines(0, "0") == [`button "Add" key="add"`]);
    assert(numbers(Checkbox("Milk", checked=true)).lines(0, "0") == [`checkbox "Milk" checked`]);
    assert(numbers(Checkbox("Milk")).lines(0, "0") == [`checkbox "Milk"`]);
    assert(numbers(Field(placeholder="Name", width=220)).lines(0, "0") == [
        `field placeholder="Name" width=220`,
    ]);
    assert(numbers(Field(value="x")).lines(0, "0") == [`field value="x"`]);
    assert(numbers(Separator()).lines(0, "0") == ["separator"]);

    // A container is its own line and then its children, a level in, and a button that was given
    // no key is named by its place.
    assert(Column([Label("a"), Row([Button("b", |n: i64| { n })], spacing=4)], padding=16).lines(
        0,
        "0",
    ) == [
        "column spacing=8 padding=16",
        `  label "a"`,
        "  row spacing=4",
        `    button "b" key="b0.1.0"`,
    ]);
    assert(numbers(Column([])).lines(0, "0") == ["column spacing=8"]);
    // The root's icon is a text attribute like the key.
    assert(numbers(Column([], icon="✓")).lines(0, "0") == [`column spacing=8 icon="✓"`]);
    assert(numbers(Row([], key="r", icon="T")).lines(0, "0") == [`row spacing=8 key="r" icon="T"`]);
})

# `self` in the text form `show_view` is given.
pub fn to_text<M>(self: Element<M>) -> str { `{self.lines(0, "0").join(sep="\n")}\n` }.test({
    // What a view of no model in particular is a view of.
    fn numbers(view: Element<i64>) -> Element<i64> { view }

    assert(
        numbers(Column([
            Label("a"),
            Separator(),
        ])).to_text() == `column spacing=8\n  label "a"\n  separator\n`,
    );
})

# `model` after the click the event `key` names: what the handler of the button of that name
# answers, or `model` when no button has the name.
fn click_at<M>(self: Element<M>, key: str, model: M, path: str) -> M {
    match (self) {
        Column(children, _, _, _, _, _) => children.click_in(key, model, path),
        Row(children, _, _, _, _, _) => children.click_in(key, model, path),
        Button(_, on_click, own) => if (event_key(own, path) == key) {
            on_click(model)
        } else {
            model
        },
        Label(..) | Checkbox(..) | Field(..) | Separator(..) => model,
    }
}

# `model` after the click `key` names, among `children` at `path`.
fn click_in<M>(self: Element<M>[], key: str, model: M, path: str) -> M {
    mut answer = model;
    for (let index, child : self) {
        set answer = child.click_at(key, answer, `{path}.{index}`);
    }
    answer
}

# `model` after the click the event `key` names: what the handler of the button of that name
# answers, or `model` when no button has the name.
pub fn click<M>(self: Element<M>, key: str, model: M) -> M { self.click_at(key, model, "0") }.test({
    let view = Column([
        Button("add", |n: i64| { n + 1 }),
        Row([Button("double", |n: i64| { n * 2 }, key="double")]),
    ]);
    assert(
        view.to_text() == `column spacing=8\n  button "add" key="b0.0"\n  row spacing=8\n    button "double" key="double"\n`,
    );
    assert(view.click("b0.0", 5) == 6);
    assert(view.click("double", 5) == 10);
    // A key no button has leaves the model as it is.
    assert(view.click("b0.7", 5) == 5);
})
