# The winrate matrix as an SVG page: a heat map with a row and a column for each archetype, green
# where the row's archetype wins, red where it loses. Hovering a cell lights up its row and column
# and fills a panel beside the matrix with the pairing's record and how it did in each round, counted
# back from the end of the tournament.

import {
    contains,
    equal as ==,
    first,
    join,
    len,
    less_than as <,
    map,
    max,
    push,
    saturating_divide as /,
    split,
    value_or,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
} from builtins;
import { percent } from "./meta_share.aipl";
import { Record, played } from "./metagame.aipl";
import { Bracket, bracket_text } from "./rounds.aipl";
import { Cell, Matrix, rate_text, share_text } from "./winrate_matrix.aipl";

# The size of a cell, and the space around the matrix, in pixels.
let CELL: u64 = 64;

let MARGIN: u64 = 24;

let TITLE_HEIGHT: u64 = 56;

# The height of a panel's headings, summary and table headers, and of each row of its tables.
let PANEL_FIXED_HEIGHT: u64 = 220;

let PANEL_ROW: u64 = 18;

# The width of the panel beside the matrix.
let PANEL_WIDTH: u64 = 440;

# The width in pixels one character of a label takes, for sizing the room it needs.
let CHARACTER_WIDTH: u64 = 7;

# `self` as text safe inside an XML attribute or element.
fn xml_escape(self: str) -> str {
    self
        .split("&")
        .join(sep="&amp;")
        .split("<")
        .join(sep="&lt;")
        .split(">")
        .join(sep="&gt;")
        .split(`"`)
        .join(sep="&quot;")
}.test({
    assert(xml_escape("plain") == "plain");
    assert(xml_escape("a & b <c>") == "a &amp; b &lt;c&gt;");
    assert(xml_escape(`say "hi"`) == "say &quot;hi&quot;");
})

# One colour channel at `rate`, the share won in thousandths: `low` at none, `middle` at an even
# record, `high` at all.
fn channel(low: i64, middle: i64, high: i64, rate: i64) -> i64 {
    if (rate < 500) {
        low + (middle - low) * rate / 500
    } else {
        middle + (high - middle) * (rate - 500) / 500
    }
}.test({
    assert(channel(200, 250, 100, 0) == 200);
    assert(channel(200, 250, 100, 250) == 225);
    assert(channel(200, 250, 100, 500) == 250);
    assert(channel(200, 250, 100, 750) == 175);
    assert(channel(200, 250, 100, 1000) == 100);
})

# The colour of a cell holding `self`: red for losing, white for even, green for winning, and grey
# when it has no match. Its rate is the one `win_rate` gives, in thousandths.
fn colour(self: Record) -> str {
    let played = self.played();
    if (played == 0) { return "rgb(232,232,232)"; };
    let rate = (self.win * 2 + self.draw) * 500 / played;
    let red = channel(215, 247, 26, rate);
    let green = channel(48, 247, 152, rate);
    let blue = channel(39, 247, 80, rate);
    `rgb({red},{green},{blue})`
}.test({
    assert(Record {}.colour() == "rgb(232,232,232)");
    // A draw is half a win, so draws alone are an even record.
    assert(Record { draw: 3 }.colour() == "rgb(247,247,247)");
    assert(Record { loss: 2 }.colour() == "rgb(215,48,39)");
    assert(Record { win: 1, loss: 1 }.colour() == "rgb(247,247,247)");
    assert(Record { win: 2 }.colour() == "rgb(26,152,80)");
})

# `self` as wins, losses and draws: `3-0-1`.
fn record_text(self: Record) -> str {
    let Record { win, loss, draw } = self;
    `{win}-{loss}-{draw}`
}.test({
    assert(Record { win: 3, draw: 1 }.record_text() == "3-0-1");
})

# What a cell centred on (`x`, `y`) shows of `self`: its win rate and, smaller beneath, its record.
# An archetype against itself (`none`) and a pairing that never met show only a `-`.
fn cell_labels(x: u64, y: u64, self: Record?) -> str {
    let some(record) = self else { return `<text x="{x}" y="{y}">-</text>`; };
    if (record.win + record.loss + record.draw == 0) { return `<text x="{x}" y="{y}">-</text>`; };
    `<text x="{x}" y="{y - 7}">{record.rate_text()}</text><text class="detail" x="{x}" y="{y + 9}">{record.record_text()}</text>`
}.test({
    assert(cell_labels(10, 20, none) == `<text x="10" y="20">-</text>`);
    assert(cell_labels(10, 20, some(Record {})) == `<text x="10" y="20">-</text>`);
    assert(
        cell_labels(
            10,
            20,
            some(Record { win: 3, draw: 1 }),
        ) == `<text x="10" y="13">87.5%</text><text class="detail" x="10" y="29">3-0-1</text>`,
    );
})

# What hovering a cell says, as the tooltip: `row` against `column`, the win rate and the record.
fn describe(row: str, column: str, cell: Cell?) -> str {
    match (cell) {
        some(found) => `{row} vs {column}: {found.record.rate_text()} ({found.record.record_text()})`,
        none => `{row} against itself is not counted`,
    }
}.test({
    let nothing = Record {};
    assert(
        describe(
            "A",
            "B",
            some(Cell { record: Record { win: 2, loss: 1 }, rounds: [], brackets: [] }),
        ) == "A vs B: 66.7% (2-1-0)",
    );
    assert(
        describe(
            "A",
            "B",
            some(Cell { record: Record { draw: 1 }, rounds: [nothing], brackets: [] }),
        ) == "A vs B: 50.0% (0-0-1)",
    );
    assert(describe("A", "A", none) == "A against itself is not counted");
})

# What the panel shows of the cell, as the attributes it carries: the `title`, a `summary` of
# two lines apart by `|`, and the `rounds`: for each slot in `shown`, apart by `;`, how many times
# the pairing met in it, its share of the metagame's matches in that slot, the record and the win
# rate, apart by `,`. The `brackets` are the same for each record the row's archetype had going in:
# how many times the pairing met, the record and the win rate. `slot_matches` is how many matches
# each slot has, out of `matches` in all.
fn panel_attributes(
    title: str,
    Cell { record, rounds, brackets },
    shown: u64[],
    slot_matches: u64[],
    matches: u64,
) -> str {
    let summary = `{record.rate_text()} win rate · {record.record_text()}|Seen in {record.played()} of {matches} matches · {record.share_text(matches)}`;
    let entries = shown.map(|slot| {
        let round = rounds[slot].value_or(Record {});
        if (round.played() == 0) {
            "0,-,-,-"
        } else {
            `{round.played()},{round.share_text(slot_matches[slot].value_or(0))},{round.record_text()},{round.rate_text()}`
        }
    });
    let at_record = brackets.map(|each| {
        if (each.played() == 0) {
            "0,-,-"
        } else {
            `{each.played()},{each.record_text()},{each.rate_text()}`
        }
    });
    `data-title="{title.xml_escape()}" data-summary="{summary.xml_escape()}" data-rounds="{entries.join(sep=";")}" data-brackets="{at_record.join(sep=";")}" data-record="{record.win},{record.loss},{record.draw}"`
}.test({
    let nothing = Record {};
    let cell = Cell {
        record: Record { win: 3, draw: 1 },
        rounds: [Record { win: 1 }, nothing, Record { win: 2, draw: 1 }],
        brackets: [Record { win: 3 }, nothing, Record { draw: 1 }],
    };
    assert(
        panel_attributes(
            "A vs B",
            cell,
            [0, 2],
            [2, 5, 4],
            10,
        ) == `data-title="A vs B" data-summary="87.5% win rate · 3-0-1|Seen in 4 of 10 matches · 40.0%" data-rounds="1,50.0%,1-0-0,100.0%;3,75.0%,2-0-1,83.3%" data-brackets="3,3-0-0,100.0%;0,-,-;1,0-0-1,50.0%" data-record="3,0,1"`,
    );
    // A slot the pairing never met in is a row of dashes.
    assert(
        panel_attributes(
            "A vs B",
            cell,
            [1],
            [2, 5, 4],
            10,
        ) == `data-title="A vs B" data-summary="87.5% win rate · 3-0-1|Seen in 4 of 10 matches · 40.0%" data-rounds="0,-,-,-" data-brackets="3,3-0-0,100.0%;0,-,-;1,0-0-1,50.0%" data-record="3,0,1"`,
    );
})

# How big an archetype with `count` of `total` decks is, as its row label says.
fn deck_summary(count: u64, total: u64) -> str {
    let noun = if (count == 1) { "deck" } else { "decks" };
    `{count} {noun} · {percent(count, total)}`
}.test({
    assert(deck_summary(92, 353) == "92 decks · 26.1%");
    assert(deck_summary(1, 4) == "1 deck · 25.0%");
})

# The heading of the column starting at `left`, sitting on `bottom` and `rise` tall, with `attributes`
# on it: a tile the width of the column whose sides lean up and to the right at 45 degrees, as the
# name written along its middle does, so the headings fit side by side the way the cells do and
# the whole tile is what a click lands on.
fn column_heading(attributes: str, left: u64, bottom: u64, rise: u64, text: str) -> str {
    let top = bottom - rise;
    let corners = `{left},{bottom} {left + CELL},{bottom} {left + CELL + rise},{top} {left + rise},{top}`;
    `<g class="label"{attributes}><polygon class="hit" points="{corners}"/><text transform="translate({left + CELL / 2},{bottom}) rotate(-45)" x="14" y="0">{text.xml_escape()}</text></g>`
}.test({
    assert(
        column_heading(
            ` data-column="2"`,
            100,
            50,
            20,
            "A & B",
        ) == `<g class="label" data-column="2"><polygon class="hit" points="100,50 164,50 184,30 120,30"/><text transform="translate(132,50) rotate(-45)" x="14" y="0">A &amp; B</text></g>`,
    );
})

# The styles of the page. A hovered cell sets `hot` on every cell and label sharing its row or
# column, and those are deepened in colour, the hovered cell most of all.
let STYLE = """
    text { font-family: Verdana, sans-serif; font-size: 12px; fill: #222; }
    #title { text-anchor: middle; font-size: 17px; }
    #subtitle { text-anchor: middle; fill: #888; }
    .cell rect { stroke: #fff; stroke-width: 1; }
    .cell text { text-anchor: middle; dominant-baseline: central; pointer-events: none; }
    .cell .detail { font-size: 10px; fill: #222; opacity: 0.85; }
    .row-label { text-anchor: end; dominant-baseline: central; }
    .row-label .detail { font-size: 11px; font-weight: normal; fill: #888; }
    .cell.hot rect { filter: saturate(1.3) brightness(0.94); }
    .cell { cursor: pointer; }
    .label[data-row], .label[data-column] { cursor: pointer; }
    .label .hit { fill: #f3f3f3; stroke: #fff; stroke-width: 1; }
    .label[data-row]:hover .hit, .label[data-column]:hover .hit { fill: #e2e2e2; }
    .label.hot .hit { fill: #e9e9e9; }
    .label:not(.row-label) text { dominant-baseline: central; }
    .label.removed { text-decoration: line-through; opacity: 0.4; }
    .cell.removed { opacity: 0.25; }
    svg:not(.locked-view) .cell:hover rect, .cell.locked rect { filter: saturate(1.6) brightness(0.84); }
    .label.hot { font-weight: bold; }
    #panel { pointer-events: none; }
    #panel .button { pointer-events: all; cursor: pointer; text-anchor: end; font-weight: bold; fill: #1a6fb5; }
    #panel .fold { pointer-events: all; cursor: pointer; }
    #panel .fold:hover { fill: #1a6fb5; }
    #panel .button:hover { text-decoration: underline; }
    #panel .heading { font-size: 14px; font-weight: bold; }
    #panel .summary { fill: #444; }
    #panel .head { fill: #888; font-size: 11px; }
    #panel .number { text-anchor: end; }
    #panel .zero { opacity: 0.35; }
    #panel line { stroke: #ccc; }
""";

# What hovering does: light up the cell's row and column, and fill the panel, which stays at the
# top of the page, from the cell's attributes. A line wider than the panel is wrapped at a space.
# Clicking a cell locks the panel on it, whatever the mouse then passes over, until the Unlock
# button, the same cell or the Escape key is clicked or pressed. Clicking an archetype's name
# removes it from the metagame: its row and column fade, and the Projected column is what every
# other archetype's overall record would be without its matches against the removed ones. The
# removed archetypes are kept in the page's address, so a reload or a shared link has them.
let SCRIPT = """
    var root, panel, locked = null, removed = [], names = [], folded = [];
    var ROW = 18, NUMBERS = [200, 270, 355, 430];
    function init(evt) {
        root = evt.target;
        panel = document.getElementById("panel");
        for (var each of root.querySelectorAll(".row-label")) names[+each.getAttribute("data-row")] = each.getAttribute("data-name");
        var saved = /removed=([\d,]+)/.exec(location.hash);
        if (saved) removed = saved[1].split(",").map(Number).filter(function(i) { return i < names.length; });
        refresh();
    }
    function ancestor(node, test) {
        while (node && !(node.classList && test(node))) node = node.parentNode;
        return node;
    }
    function cell_of(node) {
        return ancestor(node, function(n) { return n.classList.contains("cell"); });
    }
    function label_of(node) {
        return ancestor(node, function(n) {
            return n.classList.contains("label") && (n.hasAttribute("data-row") || n.hasAttribute("data-column"));
        });
    }
    function light(row, column) {
        for (var each of root.querySelectorAll(".cell, .label")) {
            var hot = (row !== null && each.getAttribute("data-row") === row)
                || (column !== null && each.getAttribute("data-column") === column);
            each.classList.toggle("hot", hot);
        }
    }
    function put(text, x, y, classes) {
        var node = document.createElementNS("http://www.w3.org/2000/svg", "text");
        node.setAttribute("x", x);
        node.setAttribute("y", y);
        if (classes) node.setAttribute("class", classes);
        node.textContent = text;
        panel.appendChild(node);
        return node;
    }
    function put_wrapped(text, y, classes) {
        var node = put("", 0, y, classes), line = "";
        for (var word of text.split(" ")) {
            var tried = line === "" ? word : line + " " + word;
            node.textContent = tried;
            if (line !== "" && node.getComputedTextLength() > NUMBERS[3]) {
                node.textContent = line;
                y += ROW;
                node = put(word, 0, y, classes);
                line = word;
            } else {
                line = tried;
            }
        }
        return y;
    }
    function rule(y) {
        var node = document.createElementNS("http://www.w3.org/2000/svg", "line");
        node.setAttribute("x1", 0);
        node.setAttribute("x2", NUMBERS[3]);
        node.setAttribute("y1", y);
        node.setAttribute("y2", y);
        panel.appendChild(node);
    }
    // A heading that folds the section under it: true when the section is open.
    function fold(text, key, y, classes) {
        var shut = folded.indexOf(key) >= 0;
        put((shut ? "\u25b8 " : "\u25be ") + text, 0, y, (classes || "head") + " fold").setAttribute("data-fold", key);
        return !shut;
    }
    function button(text, action, y) {
        put(text, NUMBERS[3], y, "button").setAttribute("data-action", action);
    }
    function grab(row, column) {
        return root.querySelector('.cell[data-row="' + row + '"][data-column="' + column + '"]');
    }
    function record_of(cell) {
        var text = cell && cell.getAttribute("data-record");
        if (!text) return null;
        var parts = text.split(",").map(Number);
        return { win: parts[0], loss: parts[1], draw: parts[2] };
    }
    function played(r) { return r.win + r.loss + r.draw; }
    function record_text(r) { return r.win + "-" + r.loss + "-" + r.draw; }
    // The win rate in percent, a draw counting as half a win (see `win_rate` in metagame.aipl).
    function rate_of(r) { return (((2 * r.win + r.draw) / (2 * played(r))) * 100); }
    // One decimal, half to even on the float's exact value, as the page's other numbers are.
    function percent(x) {
        var tie = /^(\d+)\.(\d)50*$/.exec(x.toFixed(25));
        if (!tie) return x.toFixed(1);
        var digit = +tie[2];
        return digit % 2 === 0 ? tie[1] + "." + digit : (+(tie[1] + "." + digit) + 0.1).toFixed(1);
    }
    function rate_text(r) { return played(r) === 0 ? "-" : percent(rate_of(r)) + "%"; }
    // The colour of a record, the same scale as the matrix's (see `colour` in winrate_svg.aipl).
    function channel(low, middle, high, rate) {
        return rate < 500
            ? low + Math.trunc((middle - low) * rate / 500)
            : middle + Math.trunc((high - middle) * (rate - 500) / 500);
    }
    function colour(r) {
        if (played(r) === 0) return "rgb(232,232,232)";
        var rate = Math.trunc((2 * r.win + r.draw) * 500 / played(r));
        return "rgb(" + channel(215, 247, 26, rate) + "," + channel(48, 247, 152, rate) + "," + channel(39, 247, 80, rate) + ")";
    }
    // What the row's archetype would have done without the removed archetypes' matches: its
    // overall record less its record against each of them.
    function project(row) {
        var was = record_of(root.querySelector('.cell.overall[data-row="' + row + '"]'));
        var now = { win: was.win, loss: was.loss, draw: was.draw }, gone = [];
        for (var column of removed) {
            var record = column === row ? null : record_of(grab(row, column));
            if (!record) continue;
            now.win -= record.win;
            now.loss -= record.loss;
            now.draw -= record.draw;
            gone.push({ column: column, record: record });
        }
        return { was: was, now: now, gone: gone };
    }
    function delta_text(p) {
        if (played(p.now) === 0 || played(p.was) === 0) return "-";
        var d = rate_of(p.now) - rate_of(p.was);
        return (d < 0 ? "-" : "+") + Math.abs(d).toFixed(1);
    }
    function set_labels(cell, rate, detail) {
        for (var old of Array.from(cell.querySelectorAll("text"))) cell.removeChild(old);
        var rect = cell.querySelector("rect");
        var x = +rect.getAttribute("x") + rect.getAttribute("width") / 2, y = +rect.getAttribute("y") + rect.getAttribute("height") / 2;
        var make = function(text, dy, classes) {
            var node = document.createElementNS("http://www.w3.org/2000/svg", "text");
            node.setAttribute("x", x);
            node.setAttribute("y", y + dy);
            if (classes) node.setAttribute("class", classes);
            node.textContent = text;
            cell.appendChild(node);
        };
        if (detail === null) { make(rate, 0); return; }
        make(rate, -7);
        make(detail, 9, "detail");
    }
    function refresh() {
        removed.sort(function(a, b) { return a - b; });
        for (var each of root.querySelectorAll(".cell, .label")) {
            var row = each.getAttribute("data-row"), column = each.getAttribute("data-column");
            each.classList.toggle("removed", (row !== null && removed.indexOf(+row) >= 0) || (column !== null && removed.indexOf(+column) >= 0));
        }
        for (var cell of root.querySelectorAll(".cell.projected")) {
            var index = +cell.getAttribute("data-row"), rect = cell.querySelector("rect");
            if (removed.indexOf(index) >= 0) {
                rect.setAttribute("fill", "rgb(255,255,255)");
                set_labels(cell, "out", null);
                continue;
            }
            var p = project(index);
            rect.setAttribute("fill", colour(p.now));
            set_labels(cell, rate_text(p.now), played(p.now) === 0 ? null : removed.length === 0 ? record_text(p.now) : delta_text(p));
        }
        try {
            history.replaceState(null, "", removed.length ? "#removed=" + removed.join(",") : location.pathname + location.search);
        } catch (error) {}
        if (locked) show(locked); else clear();
    }
    function toggle(index) {
        var at = removed.indexOf(index);
        if (at >= 0) removed.splice(at, 1); else removed.push(index);
        refresh();
    }
    function clear() {
        while (panel.firstChild) panel.removeChild(panel.firstChild);
        panel.setAttribute("transform", "translate(" + panel.getAttribute("data-left") + "," + panel.getAttribute("data-top") + ")");
        var y = put_wrapped("Hover a cell for how the pairing did in each round, or click one to lock it. Click an archetype's name to remove it from the metagame and see everyone else's projected win rate.", 14, "head");
        if (removed.length) {
            y += 30;
            var open = fold("Removed from the metagame", "removed", y, "heading");
            button("Restore all", "restore", y);
            for (var index of removed) {
                if (!open) break;
                y += ROW + 2;
                put(names[index], 0, y);
            }
        }
    }
    function show_projection(cell) {
        while (panel.firstChild) panel.removeChild(panel.firstChild);
        var index = +cell.getAttribute("data-row"), y = 14;
        put(names[index] + " projected", 0, y, "heading");
        if (cell === locked) button("Unlock", "unlock", y);
        if (removed.indexOf(index) >= 0) {
            put_wrapped("Removed from the metagame.", y + 20, "summary");
            return;
        }
        var p = project(index);
        y += 20;
        put(rate_text(p.now) + " win rate · " + record_text(p.now), 0, y, "summary");
        y += 20;
        put("Now " + rate_text(p.was) + " · " + record_text(p.was) + (removed.length ? " · " + delta_text(p) + " points" : ""), 0, y, "summary");
        if (!removed.length) {
            put_wrapped("Click an archetype's name to remove it from the metagame.", y + 20, "head");
            return;
        }
        y += 30;
        var open = fold("Matches lost to the removed", "lost", y);
        if (!open) return;
        [[0, "Seen"], [2, "Record"], [3, "Win rate"]].forEach(function(column) { put(column[1], NUMBERS[column[0]], y, "head number"); });
        y += 6;
        rule(y);
        p.gone.forEach(function(each) {
            y += ROW;
            put(names[each.column], 0, y);
            put(played(each.record), NUMBERS[0], y, "number");
            put(record_text(each.record), NUMBERS[2], y, "number");
            put(rate_text(each.record), NUMBERS[3], y, "number");
        });
    }
    function show(cell) {
        if (cell.classList.contains("projected")) { show_projection(cell); return; }
        while (panel.firstChild) panel.removeChild(panel.firstChild);
        var y = 14;
        put(cell.getAttribute("data-title"), 0, y, "heading");
        if (cell === locked) button("Unlock", "unlock", y);
        for (var line of cell.getAttribute("data-summary").split("|")) {
            y += 20;
            y = put_wrapped(line, y, "summary");
        }
        var rounds = cell.getAttribute("data-rounds");
        if (rounds !== "") {
            var labels = panel.getAttribute("data-slots").split("|");
            y += 30;
            var open = fold("Round", "rounds", y);
            if (open) ["Seen", "Share", "Record", "Win rate"].forEach(function(name, i) { put(name, NUMBERS[i], y, "head number"); });
            if (open) { y += 6; rule(y); }
            if (open) rounds.split(";").forEach(function(entry, i) {
                var fields = entry.split(",");
                var classes = fields[0] === "0" ? "zero" : "";
                y += ROW;
                put(labels[i], 0, y, classes);
                fields.forEach(function(value, j) { put(value, NUMBERS[j], y, "number " + classes); });
            });
        }
        var brackets = cell.getAttribute("data-brackets");
        if (brackets !== "") {
            var bracket_names = panel.getAttribute("data-brackets").split("|");
            y += 30;
            var open = fold("Row's record going in", "brackets", y);
            if (open) [[0, "Seen"], [2, "Record"], [3, "Win rate"]].forEach(function(column) { put(column[1], NUMBERS[column[0]], y, "head number"); });
            if (open) { y += 6; rule(y); }
            if (open) brackets.split(";").forEach(function(entry, i) {
                var fields = entry.split(",");
                var classes = fields[0] === "0" ? "zero" : "";
                y += ROW;
                put(bracket_names[i], 0, y, classes);
                put(fields[0], NUMBERS[0], y, "number " + classes);
                put(fields[1], NUMBERS[2], y, "number " + classes);
                put(fields[2], NUMBERS[3], y, "number " + classes);
            });
        }
    }
    function lock(cell) {
        unlock();
        locked = cell;
        cell.classList.add("locked");
        root.classList.add("locked-view");
        light(cell.getAttribute("data-row"), cell.getAttribute("data-column"));
        show(cell);
    }
    function unlock() {
        if (locked) locked.classList.remove("locked");
        locked = null;
        root.classList.remove("locked-view");
        light(null, null);
        clear();
    }
    window.addEventListener("mouseover", function(e) {
        var cell = cell_of(e.target);
        if (!cell || locked) return;
        light(cell.getAttribute("data-row"), cell.getAttribute("data-column"));
        show(cell);
    });
    window.addEventListener("mouseout", function(e) {
        if (!cell_of(e.target) || locked) return;
        light(null, null);
        clear();
    });
    window.addEventListener("click", function(e) {
        var key = e.target.getAttribute && e.target.getAttribute("data-fold");
        if (key) {
            var at = folded.indexOf(key);
            if (at >= 0) folded.splice(at, 1); else folded.push(key);
            if (locked) show(locked); else clear();
            return;
        }
        var action = e.target.classList && e.target.classList.contains("button") && e.target.getAttribute("data-action");
        if (action === "restore") { removed = []; refresh(); return; }
        if (action === "unlock") { unlock(); return; }
        var label = label_of(e.target);
        if (label) {
            toggle(+(label.hasAttribute("data-row") ? label.getAttribute("data-row") : label.getAttribute("data-column")));
            return;
        }
        var cell = cell_of(e.target);
        if (!cell) return;
        if (cell === locked) unlock(); else lock(cell);
    });
    window.addEventListener("keydown", function(e) {
        if (e.key === "Escape") unlock();
    });
""";

# The word above the column of overall win rates.
let OVERALL = "Overall";

# The word above the column of win rates with the removed archetypes taken out.
let PROJECTED = "Projected";

# The gap between the overall column and the projected one, and between that and the matrix.
let PROJECTED_GAP: u64 = 4;

# The space between the headings and the matrix.
let HEADING_GAP: u64 = 4;

let GAP: u64 = 10;

# The page for `self`, of the metagame `name`.
pub fn winrate_svg(self: Matrix, name: str) -> str {
    let Matrix { names, counts, total as decks, slots, slot_matches, matches, brackets, rows, overall } = self;
    let summaries = counts.map(|count| deck_summary(count, decks));
    mut longest = PROJECTED.len();
    for (let each : names) {
        set longest = max(longest, each.len());
    }
    mut label_characters = longest;
    for (let each : summaries) {
        // The summary is set smaller than a name.
        set label_characters = max(label_characters, each.len() * 6 / CHARACTER_WIDTH);
    }
    // The slots some match fell in: the panel has a row for each.
    mut shown: u64[] = [];
    for (let slot, count : slot_matches) {
        if (0 < count) { set shown.push(slot); };
    }
    let shown_slots = shown.map(|slot| slots[slot].value_or("").xml_escape()).join(sep="|");
    let bracket_labels = brackets$bracket_text().join(sep="|");
    // A column heading runs up and to the right at 45 degrees.
    let label_width = label_characters * CHARACTER_WIDTH + MARGIN;
    let heading_height = longest * 5 + MARGIN;
    let grid_width = names.len() * CELL;
    let overall_left = MARGIN + label_width;
    let projected_left = overall_left + CELL + PROJECTED_GAP;
    let grid_left = projected_left + CELL + GAP;
    let grid_top = TITLE_HEIGHT + heading_height;
    // The last column's heading leans out over `rise` to the right of the matrix; the panel starts past it.
    let panel_left = grid_left + grid_width + longest * 5 + MARGIN * 2;
    let width = panel_left + PANEL_WIDTH + MARGIN;
    // The panel is at the top, and the page is as tall as the longest panel needs.
    let panel_height = PANEL_FIXED_HEIGHT + (shown.len() + brackets.len()) * PANEL_ROW;
    let height = max(grid_top + grid_width + MARGIN, TITLE_HEIGHT + panel_height + MARGIN);
    let middle = width / 2;
    mut parts: str[] = [];
    let rise = heading_height - HEADING_GAP;
    set parts.push(column_heading("", overall_left, grid_top - HEADING_GAP, rise, OVERALL));
    set parts.push(column_heading("", projected_left, grid_top - HEADING_GAP, rise, PROJECTED));
    for (let column, each : names) {
        set parts.push(column_heading(
            ` data-column="{column}"`,
            grid_left + column * CELL,
            grid_top - HEADING_GAP,
            rise,
            each,
        ));
    }
    for (let row, total : overall) {
        let y = grid_top + row * CELL;
        let row_name = names[row].value_or("");
        let summary = summaries[row].value_or("");
        set parts.push(
            `<g class="label row-label" data-row="{row}" data-name="{row_name.xml_escape()}"><rect class="hit" x="2" y="{y}" width="{overall_left - 6}" height="{CELL}"/><text x="{overall_left - 8}" y="{y + CELL / 2 - 7}">{row_name.xml_escape()}</text><text class="detail" x="{overall_left - 8}" y="{y + CELL / 2 + 9}">{summary}</text></g>`,
        );
        let overall_info = `{row_name} overall: {total.record.rate_text()} ({total.record.record_text()})`.xml_escape();
        let overall_panel = panel_attributes(
            `{row_name} overall`,
            total,
            shown,
            slot_matches,
            matches,
        );
        set parts.push(
            `<g class="cell overall" data-row="{row}" data-info="{overall_info}" {overall_panel}><title>{overall_info}</title><rect x="{overall_left}" y="{y}" width="{CELL}" height="{CELL}" fill="{total.record.colour()}"/>{cell_labels(overall_left + CELL / 2, y + CELL / 2, some(total.record))}</g>`,
        );
        set parts.push(
            `<g class="cell projected" data-row="{row}"><title>{row_name.xml_escape()} without the removed archetypes' matches</title><rect x="{projected_left}" y="{y}" width="{CELL}" height="{CELL}" fill="{total.record.colour()}"/>{cell_labels(projected_left + CELL / 2, y + CELL / 2, some(total.record))}</g>`,
        );
        for (let column, cell : rows[row].value_or([])) {
            let column_name = names[column].value_or("");
            let info = describe(row_name, column_name, cell).xml_escape();
            let x = grid_left + column * CELL;
            let fill = cell$record.value_or(Record {}).colour();
            let attributes = match (cell) {
                some(found) => panel_attributes(
                    `{row_name} vs {column_name}`,
                    found,
                    shown,
                    slot_matches,
                    matches,
                ),
                none => `data-title="{row_name.xml_escape()} against itself" data-summary="Not counted: every match between two decks of it is a win for one and a loss for the other." data-rounds="" data-brackets=""`,
            };
            let shown_cell = cell$record;
            set parts.push(
                `<g class="cell" data-row="{row}" data-column="{column}" data-info="{info}" {attributes}><title>{info}</title><rect x="{x}" y="{y}" width="{CELL}" height="{CELL}" fill="{if (cell == none) { "rgb(255,255,255)" } else { fill }}"/>{cell_labels(x + CELL / 2, y + CELL / 2, shown_cell)}</g>`,
            );
        }
    }
    `<?xml version="1.0" standalone="no"?>
<svg version="1.1" width="{width}" height="{height}" viewBox="0 0 {width} {height}" onload="init(evt)" xmlns="http://www.w3.org/2000/svg">
<style type="text/css">{STYLE}</style>
<script type="text/ecmascript"><![CDATA[{SCRIPT}]]></script>
<rect x="0" y="0" width="{width}" height="{height}" fill="#ffffff"/>
<text id="title" x="{middle}" y="26">Winrate Matrix from {name.xml_escape()}</text>
<text id="subtitle" x="{middle}" y="44">The row's archetype against the column's; a draw counts as half a win</text>
{parts.join(sep="\n")}
<g id="panel" data-left="{panel_left}" data-top="{TITLE_HEIGHT}" data-slots="{shown_slots}" data-brackets="{bracket_labels}"></g>
</svg>
`
}.test({
    let nothing = Record {};
    let won = Record { win: 1 };
    let lost = Record { loss: 1 };
    let matrix = Matrix {
        names: ["A", "B & C"],
        counts: [3, 1],
        total: 4,
        slots: ["Finals", "Semifinals"],
        slot_matches: [1, 0],
        matches: 2,
        brackets: [Bracket { win: 0, loss: 0 }],
        rows: [
            [none, some(Cell { record: won, rounds: [won, nothing], brackets: [won] })],
            [some(Cell { record: lost, rounds: [lost, nothing], brackets: [nothing] }), none],
        ],
        overall: [
            Cell { record: won, rounds: [won, nothing], brackets: [won] },
            Cell { record: lost, rounds: [lost, nothing], brackets: [nothing] },
        ],
    };
    let page = winrate_svg(matrix, "m");
    let lines = page.split("\n");
    assert(lines.first() == some(`<?xml version="1.0" standalone="no"?>`));
    assert(page.contains("Winrate Matrix from m"));
    // A cell says its pairing, and a name is escaped.
    assert(page.contains(`data-info="A vs B &amp; C: 100.0% (1-0-0)"`));
    assert(page.contains(`data-info="B &amp; C vs A: 0.0% (0-1-0)"`));
    assert(page.contains(`data-info="A against itself is not counted"`));
    // The panel has what a cell says of each round some match fell in.
    assert(page.contains(`data-title="A vs B &amp; C"`));
    assert(page.contains(`data-rounds="1,100.0%,1-0-0,100.0%"`));
    assert(page.contains(`data-slots="Finals"`));
    assert(page.contains(`data-brackets="0-0"`));
    assert(page.contains(`data-brackets="1,1-0-0,100.0%"`));
    assert(page.contains(`data-title="A against itself"`));
    // A row label has the archetype's deck count and share.
    assert(page.contains(">3 decks · 75.0%</text>"));
    assert(page.contains(">1 deck · 25.0%</text>"));
    // One cell for each pairing, and a heading for each archetype on both axes.
    assert(page.split(`class="cell"`).len() == 5);
    // The overall column: a cell for each archetype, and its own heading.
    assert(page.contains(`data-info="A overall: 100.0% (1-0-0)"`));
    assert(page.contains(`data-title="A overall"`));
    assert(page.split(`class="cell overall"`).len() == 3);
    assert(page.split(`class="label"`).len() == 5);

    // The projected column: a cell for each archetype, which the page fills in as archetypes are
    // removed, and the records it works from.
    assert(page.split(`class="cell projected"`).len() == 3);
    assert(page.contains(`data-record="1,0,0"`));
    assert(page.contains(`data-name="B &amp; C"`));
    assert(page.split(`class="label row-label"`).len() == 3);
})
