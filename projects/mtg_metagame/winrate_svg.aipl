# The winrate matrix as an SVG page: a heat map with a row and a column for each archetype, green
# where the row's archetype wins, red where it loses. Hovering a cell lights up its row and column
# and fills a panel beside the matrix with the pairing's record and how it did in each round,
# counted
# back from the end of the tournament.

import {
    any,
    contains,
    equal as ==,
    first,
    join,
    len,
    less_than as <,
    logical_not as !,
    map,
    max,
    push,
    saturating_divide as /,
    split,
    value_or,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
} from builtins;
import { Hull, HullCard, Tally } from "./hull.aipl";
import { percent } from "./meta_share.aipl";
import { Record, played } from "./metagame.aipl";
import { Bracket, bracket_text } from "./rounds.aipl";
import { Cell, DeckLink, Matrix, SubArchetype, rate_text, share_text } from "./winrate_matrix.aipl";

# The size of a cell, and the space around the matrix, in pixels.
let CELL: u64 = 64;

let MARGIN: u64 = 24;

let TITLE_HEIGHT: u64 = 56;

# The height of a panel's headings, summary and table headers, and of each row of its tables.
let PANEL_FIXED_HEIGHT: u64 = 220;

let PANEL_ROW: u64 = 18;

# The width of the panel beside the matrix.
let PANEL_WIDTH: u64 = 440;

# The width in pixels one character of a label takes, for sizing the room it needs.
let CHARACTER_WIDTH: u64 = 7;

# `self` as text safe inside an XML attribute or element.
fn xml_escape(self: str) -> str {
    self
        .split("&")
        .join(sep="&amp;")
        .split("<")
        .join(sep="&lt;")
        .split(">")
        .join(sep="&gt;")
        .split(`"`)
        .join(sep="&quot;")
}.test({
    assert(xml_escape("plain") == "plain");
    assert(xml_escape("a & b <c>") == "a &amp; b &lt;c&gt;");
    assert(xml_escape(`say "hi"`) == "say &quot;hi&quot;");
})

# One colour channel.
fn channel(
    # The value at a rate of none.
    low: i64,
    # The value at an even record.
    middle: i64,
    # The value at all.
    high: i64,
    # The share won, in thousandths.
    rate: i64,
) -> i64 {
    if (rate < 500) {
        low + (middle - low) * rate / 500
    } else {
        middle + (high - middle) * (rate - 500) / 500
    }
}.test({
    assert(channel(200, 250, 100, 0) == 200);
    assert(channel(200, 250, 100, 250) == 225);
    assert(channel(200, 250, 100, 500) == 250);
    assert(channel(200, 250, 100, 750) == 175);
    assert(channel(200, 250, 100, 1000) == 100);
})

# The colour of a cell holding `self`: red for losing, white for even, green for winning, and grey
# when it has no match. Its rate is the one `win_rate` gives, in thousandths.
fn colour(self: Record) -> str {
    let played = self.played();
    if (played == 0) { return "rgb(232,232,232)"; };
    let rate = (self.win * 2 + self.draw) * 500 / played;
    let red = channel(215, 247, 26, rate);
    let green = channel(48, 247, 152, rate);
    let blue = channel(39, 247, 80, rate);
    `rgb({red},{green},{blue})`
}.test({
    assert(Record {}.colour() == "rgb(232,232,232)");
    // A draw is half a win, so draws alone are an even record.
    assert(Record { draw: 3 }.colour() == "rgb(247,247,247)");
    assert(Record { loss: 2 }.colour() == "rgb(215,48,39)");
    assert(Record { win: 1, loss: 1 }.colour() == "rgb(247,247,247)");
    assert(Record { win: 2 }.colour() == "rgb(26,152,80)");
})

# `self` as wins, losses and draws: `3-0-1`.
fn record_text(self: Record) -> str {
    let Record { win, loss, draw } = self;
    `{win}-{loss}-{draw}`
}.test({
    assert(Record { win: 3, draw: 1 }.record_text() == "3-0-1");
})

# What a cell centred on (`x`, `y`) shows of `self`: its win rate and, smaller beneath, its record.
# An archetype against itself (`none`) and a pairing that never met show only a `-`.
fn cell_labels(
    # The cell's centre across.
    x: u64,
    # The cell's centre down.
    y: u64,
    self: Record?,
) -> str {
    let some(record) = self else { return `<text x="{x}" y="{y}">-</text>`; };
    if (record.win + record.loss + record.draw == 0) { return `<text x="{x}" y="{y}">-</text>`; };
    `<text x="{x}" y="{y - 7}">{record.rate_text()}</text><text class="detail" x="{x}" y="{y + 9}">{record.record_text()}</text>`
}.test({
    assert(cell_labels(10, 20, none) == `<text x="10" y="20">-</text>`);
    assert(cell_labels(10, 20, some(Record {})) == `<text x="10" y="20">-</text>`);
    assert(
        cell_labels(
            10,
            20,
            some(Record { win: 3, draw: 1 }),
        ) == `<text x="10" y="13">88%</text><text class="detail" x="10" y="29">3-0-1</text>`,
    );
})

# What hovering a cell says, as the tooltip: the win rate and the record of `row` against `column`.
fn describe(
    # The row's archetype.
    row: str,
    # The column's.
    column: str,
    cell: Cell?,
) -> str {
    match (cell) {
        some(found) => `{row} vs {column}: {found.record.rate_text()} ({found.record.record_text()})`,
        none => `{row} against itself is not counted`,
    }
}.test({
    assert(
        describe(
            "A",
            "B",
            some(Cell { record: Record { win: 2, loss: 1 }, rounds: [], brackets: [] }),
        ) == "A vs B: 67% (2-1-0)",
    );
    assert(
        describe(
            "A",
            "B",
            some(Cell { record: Record { draw: 1 }, rounds: [Record {}], brackets: [] }),
        ) == "A vs B: 50% (0-0-1)",
    );
    assert(describe("A", "A", none) == "A against itself is not counted");
})

# What the panel shows of the cell, as the attributes it carries: the `title`, a `summary` of
# two lines apart by `|`, and the `rounds`: for each slot in `shown`, apart by `;`, how many times
# the pairing met in it, its share of the metagame's matches in that slot, the record and the win
# rate, apart by `,`. The `brackets` are the same for each record the row's archetype had going in:
# how many times the pairing met, the record and the win rate. `slot_matches` is how many matches
# each slot has, out of `matches` in all.
fn panel_attributes(
    title: str,
    Cell { record, rounds, brackets },
    shown: u64[],
    slot_matches: u64[],
    matches: u64,
) -> str {
    let summary = `{record.rate_text()} win rate · {record.record_text()}|Seen in {record.played()} of {matches} matches · {record.share_text(matches)}`;
    let entries = shown.map(|slot| {
        let round = rounds[slot].value_or(Record {});
        if (round.played() == 0) {
            "0,-,-,-"
        } else {
            `{round.played()},{round.share_text(slot_matches[slot].value_or(0))},{round.record_text()},{round.rate_text()}`
        }
    });
    let at_record = brackets.map(|each| {
        if (each.played() == 0) {
            "0,-,-"
        } else {
            `{each.played()},{each.record_text()},{each.rate_text()}`
        }
    });
    `data-title="{title.xml_escape()}" data-summary="{summary.xml_escape()}" data-rounds="{entries.join(sep=";")}" data-brackets="{at_record.join(sep=";")}" data-record="{record.win},{record.loss},{record.draw}"`
}.test({
    let cell = Cell {
        record: Record { win: 3, draw: 1 },
        rounds: [Record { win: 1 }, Record {}, Record { win: 2, draw: 1 }],
        brackets: [Record { win: 3 }, Record {}, Record { draw: 1 }],
    };
    assert(
        panel_attributes(
            "A vs B",
            cell,
            [0, 2],
            [2, 5, 4],
            10,
        ) == `data-title="A vs B" data-summary="88% win rate · 3-0-1|Seen in 4 of 10 matches · 40%" data-rounds="1,50%,1-0-0,100%;3,75%,2-0-1,83%" data-brackets="3,3-0-0,100%;0,-,-;1,0-0-1,50%" data-record="3,0,1"`,
    );
    // A slot the pairing never met in is a row of dashes.
    assert(
        panel_attributes(
            "A vs B",
            cell,
            [1],
            [2, 5, 4],
            10,
        ) == `data-title="A vs B" data-summary="88% win rate · 3-0-1|Seen in 4 of 10 matches · 40%" data-rounds="0,-,-,-" data-brackets="3,3-0-0,100%;0,-,-;1,0-0-1,50%" data-record="3,0,1"`,
    );
})

# How big an archetype is, as its row label says.
fn deck_summary(
    # How many decks the archetype has.
    count: u64,
    # How many decks there are.
    total: u64,
) -> str {
    let noun = if (count == 1) { "deck" } else { "decks" };
    `{count} {noun} · {percent(count, total)}`
}.test({
    assert(deck_summary(92, 353) == "92 decks · 26%");
    assert(deck_summary(1, 4) == "1 deck · 25%");
})

# The heading of a column: a tile the width of the column whose sides lean up and to the right at 45
# degrees, as the name written along its middle does, so the headings fit side by side the way the
# cells do and the whole tile is what a click lands on.
fn column_heading(
    # What the tile carries.
    attributes: str,
    # Where the column starts.
    left: u64,
    # What the tile sits on.
    bottom: u64,
    # How tall it is.
    rise: u64,
    # The name written along its middle.
    text: str,
) -> str {
    let top = bottom - rise;
    let corners = `{left},{bottom} {left + CELL},{bottom} {left + CELL + rise},{top} {left + rise},{top}`;
    `<g class="label"{attributes}><polygon class="hit" points="{corners}"/><text transform="translate({left + CELL / 2},{bottom}) rotate(-45)" x="14" y="0">{text.xml_escape()}</text></g>`
}.test({
    assert(
        column_heading(
            ` data-column="2"`,
            100,
            50,
            20,
            "A & B",
        ) == `<g class="label" data-column="2"><polygon class="hit" points="100,50 164,50 184,30 120,30"/><text transform="translate(132,50) rotate(-45)" x="14" y="0">A &amp; B</text></g>`,
    );
})

# The styles of the page. A hovered cell sets `hot` on every cell and label sharing its row or
# column, and those are deepened in colour, the hovered cell most of all.
let STYLE = """
    text { font-family: Verdana, sans-serif; font-size: 12px; fill: #222; user-select: none; -webkit-user-select: none; }
    #panel text, #hull text { user-select: text; -webkit-user-select: text; }
    #hull text { cursor: text; }
    #title { text-anchor: middle; font-size: 17px; }
    #subtitle { text-anchor: middle; fill: #888; }
    .cell rect { stroke: #fff; stroke-width: 1; }
    .cell text { text-anchor: middle; dominant-baseline: central; pointer-events: none; }
    .cell .detail { font-size: 10px; fill: #222; opacity: 0.85; }
    .row-label { text-anchor: end; dominant-baseline: central; }
    .row-label .detail { font-size: 11px; font-weight: normal; fill: #888; }
    .row-label .expander { text-anchor: start; dominant-baseline: central; font-size: 18px; fill: #1a6fb5; cursor: pointer; }
    .row-label .checkbox { cursor: pointer; }
    .row-label .checkbox rect { fill: #fff; stroke: #888; stroke-width: 1.5; }
    .row-label .checkbox path { fill: none; stroke: #1a6fb5; stroke-width: 2.2; }
    .row-label.removed .checkbox path { display: none; }
    .row-label .checkbox:hover rect { stroke: #1a6fb5; }
    .row-label.sub .hit { fill: #fafafa; }
    #hull text { font-size: 11px; }
    #hull .head { font-weight: bold; fill: #444; }
    #hull .num { text-anchor: end; }
    #hull .title { font-size: 14px; font-weight: bold; }
    #hull .note { fill: #666; }
    #hull .up { fill: #1a7f37; }
    #hull .down { fill: #c0392b; }
    #hull line { stroke: #ccc; }
    #hull .stripe { fill: #f1f4f8; }
    #hull .link { fill: #1a6fb5; cursor: pointer; }
    #hull .link:hover { text-decoration: underline; }
    #panel .link { fill: #1a6fb5; cursor: pointer; pointer-events: all; }
    #panel .sortable { pointer-events: all; cursor: pointer; }
    #panel .sortable:hover { fill: #1a6fb5; }
    #panel .sortable.active { fill: #1a6fb5; text-decoration: underline; }
    #panel .link:hover { text-decoration: underline; }
    .row-label.sub { cursor: default; }
    .cell.hot rect { filter: saturate(1.3) brightness(0.94); }
    .cell { cursor: pointer; }
    .label[data-row], .label[data-column] { cursor: pointer; }
    .label .hit { fill: #f3f3f3; stroke: #fff; stroke-width: 1; }
    .label[data-row]:hover .hit, .label[data-column]:hover .hit { fill: #e2e2e2; }
    .label.hot .hit { fill: #e9e9e9; }
    .label:not(.row-label) text { dominant-baseline: central; }
    .label.removed { text-decoration: line-through; opacity: 0.4; }
    .cell.removed { opacity: 0.25; }
    svg:not(.locked-view) .cell:hover rect, .cell.locked rect { filter: saturate(1.6) brightness(0.84); }
    .label.hot { font-weight: bold; }
    #sorts { fill: #888; }
    .sort { fill: #1a6fb5; cursor: pointer; }
    .sort:hover { text-decoration: underline; }
    .sort.active { fill: #222; font-weight: bold; cursor: default; text-decoration: none; }
    #panel { pointer-events: none; }
    #panel .button { pointer-events: all; cursor: pointer; text-anchor: end; font-weight: bold; fill: #1a6fb5; }
    #panel .fold { pointer-events: all; cursor: pointer; }
    #panel .fold:hover { fill: #1a6fb5; }
    #panel .button:hover { text-decoration: underline; }
    #panel .heading { font-size: 14px; font-weight: bold; }
    #panel .summary { fill: #444; }
    #panel .head { fill: #888; font-size: 11px; }
    #panel .number { text-anchor: end; }
    #panel .zero { opacity: 0.35; }
    #panel line { stroke: #ccc; }
""";

# What hovering does: light up the cell's row and column, and fill the panel, which stays at the
# top of the page, from the cell's attributes. A line wider than the panel is wrapped at a space.
# Clicking a cell locks the panel on it, whatever the mouse then passes over, until the Unlock
# button, the same cell or the Escape key is clicked or pressed. Unticking an
# archetype's checkbox (or clicking its column heading) removes it from the metagame: its row and
# column fade, and the Projected column is what every
# other archetype's overall record would be without its matches against the removed ones. The
# removed archetypes are kept in the page's address, so a reload or a shared link has them.
let SCRIPT = """
    var root, panel, locked = null, removed = [], expanded = [], names = [], folded = [], sorting = "share";
    var rows_height = 0, panel_bottom = 0, hull, hull_bottom = 0;
    var ROW = 18, NUMBERS = [200, 270, 355, 430], DECK_COLUMNS = [158, 272, 392, 430], deck_sorting = "win";
    function init(evt) {
        root = evt.target;
        panel = document.getElementById("panel");
        hull = document.getElementById("hull");
        for (var each of root.querySelectorAll(".row-label")) names[+each.getAttribute("data-row")] = each.getAttribute("data-name");
        var saved = /removed=([\d,]+)/.exec(location.hash);
        var parents = +panel.getAttribute("data-parents");
        if (saved) removed = saved[1].split(",").map(Number).filter(function(i) { return i < parents; });
        var opened = /expanded=([\d,]+)/.exec(location.hash);
        if (opened) expanded = opened[1].split(",").map(Number).filter(function(i) { return i < parents; });
        var sort = /sort=(share|winrate|projected|change)/.exec(location.hash);
        if (sort) sorting = sort[1];
        refresh();
    }
    // Lay the rows and columns out in the order `sorting` names, by moving them from where the page
    // drew them (meta share order): a row or column keeps its index, which the cells' attributes use.
    // The archetypes are the first `data-parents` rows and every column; a sub-archetype's row follows
    // its archetype's when that is expanded, and is hidden otherwise.
    function apply_sort() {
        var parents = +panel.getAttribute("data-parents");
        var records = [], order = [];
        for (var i = 0; i < parents; i++) order.push(i);
        for (var cell of root.querySelectorAll(".cell.overall")) records[+cell.getAttribute("data-row")] = record_of(cell);
        if (sorting !== "share") {
            // Projected and change order put the removed archetypes last, below those with no matches.
            // Change order is by how far the projection moves the win rate, either way.
            var key = function(i) {
                if (sorting !== "winrate" && removed.indexOf(i) >= 0) return -2;
                var p = project(i);
                if (sorting === "change") {
                    return played(p.now) === 0 || played(p.was) === 0 ? -1 : Math.abs(rate_of(p.now) - rate_of(p.was));
                }
                var record = sorting === "projected" ? p.now : records[i];
                return played(record) === 0 ? -1 : rate_of(record);
            };
            order.sort(function(a, b) { return key(b) - key(a) || a - b; });
        }
        var position = [], size = +root.querySelector(".cell.overall rect").getAttribute("height");
        order.forEach(function(index, at) { position[index] = at; });
        var subs = {}, slot = [], rows = 0;
        for (var sub of root.querySelectorAll(".row-label.sub")) {
            (subs[sub.getAttribute("data-parent")] = subs[sub.getAttribute("data-parent")] || []).push(+sub.getAttribute("data-row"));
        }
        order.forEach(function(index) {
            slot[index] = rows++;
            if (expanded.indexOf(index) >= 0) (subs[index] || []).forEach(function(row) { slot[row] = rows++; });
        });
        for (var each of root.querySelectorAll("[data-row], [data-column]")) {
            if (!each.classList.contains("label") && !each.classList.contains("cell")) continue;
            var row = each.getAttribute("data-row"), column = each.getAttribute("data-column");
            if (row !== null && slot[+row] === undefined) { each.setAttribute("display", "none"); continue; }
            each.removeAttribute("display");
            var dx = column === null ? 0 : (position[+column] - column) * size, dy = row === null ? 0 : (slot[+row] - row) * size;
            each.setAttribute("transform", dx || dy ? "translate(" + dx + "," + dy + ")" : "");
        }
        for (var mark of root.querySelectorAll(".expander")) mark.textContent = expanded.indexOf(+mark.getAttribute("data-expand")) >= 0 ? "\u25be" : "\u25b8";
        rows_height = +panel.getAttribute("data-grid-top") + rows * size + +panel.getAttribute("data-margin");
        fit_height();
        for (var option of root.querySelectorAll(".sort")) option.classList.toggle("active", option.getAttribute("data-sort") === sorting);
    }
    // The page is as tall as its visible rows need, and no shorter than the panel needs; and as wide
    // as the hull needs while it is drawn, and no narrower than the matrix and its panel.
    var page_width = 0;
    function fit_height() {
        var height = Math.max(+panel.getAttribute("data-height"), rows_height + hull_bottom, +panel.getAttribute("data-top") + panel_bottom + +panel.getAttribute("data-margin"));
        if (!page_width) page_width = +root.getAttribute("width");
        var width = hull_bottom > 0 ? Math.max(page_width, HULL_WIDTH + 2 * +panel.getAttribute("data-margin")) : page_width;
        root.setAttribute("width", width);
        root.setAttribute("height", height);
        root.setAttribute("viewBox", "0 0 " + width + " " + height);
        document.getElementById("background").setAttribute("width", width);
        document.getElementById("background").setAttribute("height", height);
    }
    // The convex hull of the archetype whose overall panel is locked, below the matrix: every card
    // its decks played, by type and then the sideboard. A card the decks all play the same number of
    // copies of is listed with the others of its part in one line. A card they disagree about has a
    // row after its name and the fewest and most copies played, each number of copies side by side as
    // a group of five columns: the copies, how many decks played that many, their share of the decks,
    // their win rate and its change (Δ) from the archetype's baseline. The headings are on the row of
    // the part's name, repeated over each group; more numbers of copies than groups wrap onto the next
    // line, and the page is widened to hold the groups. Win rates are wins over wins and losses, draws left out.
    var HULL_NAME = 200, HULL_ROW = 16, HULL_GROUPS = 5, HULL_GROUP = 226, HULL_WIDTH = HULL_NAME + HULL_GROUPS * HULL_GROUP;
    // The columns of a group, each as its heading and the x of its right edge within the group.
    var HULL_COLUMNS = [["Copies", 44], ["Decks", 90], ["%", 126], ["WR", 168], ["Δ WR", 214]];
    function hull_put(text, x, y, classes) {
        var node = document.createElementNS("http://www.w3.org/2000/svg", "text");
        node.setAttribute("x", x);
        node.setAttribute("y", y);
        node.setAttribute("class", classes || "");
        node.textContent = text;
        hull.appendChild(node);
        hull_bottom = Math.max(hull_bottom, y + HULL_ROW);
        return node;
    }
    // The page of a card on Scryfall: a search for exactly its name, which opens the card itself.
    function scryfall(name) {
        return "https://scryfall.com/search?q=" + encodeURIComponent('!"' + name + '"');
    }
    // An anchor to `url`, opened in a new tab.
    function hull_anchor(url) {
        var anchor = document.createElementNS("http://www.w3.org/2000/svg", "a");
        anchor.setAttribute("href", url);
        anchor.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", url);
        anchor.setAttribute("target", "_blank");
        return anchor;
    }
    function draw_hull() {
        while (hull.firstChild) hull.removeChild(hull.firstChild);
        hull_bottom = 0;
        hull.setAttribute("transform", "translate(" + panel.getAttribute("data-margin") + "," + rows_height + ")");
        if (!locked || !locked.classList.contains("overall")) { fit_height(); return; }
        var row = locked.getAttribute("data-row");
        var label = root.querySelector('.row-label[data-row="' + row + '"]');
        var base = label.querySelector("desc.hull-baseline").getAttribute("data-record").split(",").map(Number);
        var baseline = base[0] === 0 ? 0 : base[0] / (base[0] + base[1]);
        var decks = label.querySelectorAll("desc.deck").length;
        var rate = function(tally) {
            var total = tally.win + tally.loss;
            return total === 0 ? null : Math.round(tally.win / total * 1000) / 1000;
        };
        var cards = Array.from(label.querySelectorAll("desc.hull")).map(function(each) {
            var tallies = each.getAttribute("data-tallies").split(";").map(function(entry) {
                var parts = entry.split(/[:,]/).map(Number);
                return { copies: parts[0], decks: parts[1], win: parts[2], loss: parts[3] };
            });
            return { section: each.getAttribute("data-section"), full: each.getAttribute("data-name"), name: each.getAttribute("data-name").split(" // ")[0], tallies: tallies };
        });
        // One number of copies as the cells of its row: the copies, the decks, their share, their
        // win rate, and its change from the baseline, coloured as it is up or down.
        var cells_of = function(tally) {
            var value = rate(tally), winrate = "n/a", change_text = "n/a", kind = "flat";
            if (value !== null) {
                var change = value - baseline;
                if (Math.abs(change) < 0.0005) change = 0;
                winrate = percent(value * 100) + "%";
                change_text = change === 0 ? "0%" : (change < 0 ? "-" : "+") + percent(Math.abs(change) * 100) + "%";
                kind = change === 0 ? "flat" : change < 0 ? "down" : "up";
            }
            return [
                [String(tally.copies), ""],
                [String(tally.decks), ""],
                [percent(tally.decks / decks * 100) + "%", ""],
                [winrate, ""],
                [change_text, kind]
            ];
        };
        var y = 20;
        hull_put(names[row] + ": every card played in the archetype, " + decks + " decks", 0, y, "title");
        y += HULL_ROW + 2;
        hull_put("Baseline win rate (WR): " + percent(baseline * 100) + "%. A card the decks disagree about is listed as: card (fewest-most copies played), then each number of copies side by side:", 0, y, "note");
        y += HULL_ROW;
        hull_put("how many decks played that many, % their share of the archetype's decks, WR those decks' win rate, and Δ WR its difference from the baseline, under the headings on the part's row. A card every deck plays the same number of copies of is listed once, with its copies.", 0, y, "note");
        var sections = [];
        cards.forEach(function(card) { if (sections.indexOf(card.section) < 0) sections.push(card.section); });
        sections.forEach(function(section) {
            var mine = cards.filter(function(card) { return card.section === section; });
            var agreed = mine.filter(function(card) { return card.tallies.length === 1; });
            var disputed = mine.filter(function(card) { return card.tallies.length > 1; });
            y += HULL_ROW + 14;
            hull_put(section, 0, y, "head");
            if (disputed.length) {
                for (var group = 0; group < HULL_GROUPS; group++) {
                    HULL_COLUMNS.forEach(function(column) { hull_put(column[0], HULL_NAME + group * HULL_GROUP + column[1], y, "head num"); });
                }
            }
            var line = document.createElementNS("http://www.w3.org/2000/svg", "line");
            line.setAttribute("x1", 0); line.setAttribute("x2", HULL_WIDTH); line.setAttribute("y1", y + 5); line.setAttribute("y2", y + 5);
            hull.appendChild(line);
            y += 5;
            disputed.forEach(function(card, index) {
                y += HULL_ROW;
                // Every other card's rows are on a tinted band, drawn first so the text is over it.
                var top = y, stripe = null;
                if (index % 2 === 1) {
                    stripe = document.createElementNS("http://www.w3.org/2000/svg", "rect");
                    stripe.setAttribute("class", "stripe");
                    stripe.setAttribute("x", -4);
                    stripe.setAttribute("width", HULL_WIDTH + 8);
                    stripe.setAttribute("y", top - 12);
                    hull.appendChild(stripe);
                }
                var least = card.tallies[0].copies, most = card.tallies[card.tallies.length - 1].copies;
                var name_node = fit_text(hull_put(card.name + " (" + least + "-" + most + ")", 0, y, "link"), HULL_NAME - 14);
                var anchor = hull_anchor(scryfall(card.full));
                hull.replaceChild(anchor, name_node);
                anchor.appendChild(name_node);
                card.tallies.forEach(function(tally, at) {
                    var group = at % HULL_GROUPS;
                    if (at > 0 && group === 0) y += HULL_ROW;
                    cells_of(tally).forEach(function(cell, column) {
                        hull_put(cell[0], HULL_NAME + group * HULL_GROUP + HULL_COLUMNS[column][1], y, "num " + cell[1]);
                    });
                });
                if (stripe) stripe.setAttribute("height", y - top + HULL_ROW);
            });
            if (agreed.length) {
                y += HULL_ROW;
                // The cards every deck plays alike, each a link, as many to a line as fit.
                var node = hull_put("Same in every deck:", 0, y, "note"), on_line = 0;
                var item_parts = function(card, at, indent) {
                    var link = hull_anchor(scryfall(card.full)), name = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
                    name.setAttribute("class", "link");
                    if (indent) name.setAttribute("dx", 6);
                    name.textContent = card.name + " (" + card.tallies[0].copies + ")";
                    link.appendChild(name);
                    var parts = [link];
                    if (at < agreed.length - 1) {
                        var comma = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
                        comma.textContent = ",";
                        parts.push(comma);
                    }
                    return parts;
                };
                agreed.forEach(function(card, at) {
                    var parts = item_parts(card, at, true);
                    parts.forEach(function(part) { node.appendChild(part); });
                    if (node.getComputedTextLength() > HULL_WIDTH && on_line > 0) {
                        parts.forEach(function(part) { node.removeChild(part); });
                        y += HULL_ROW;
                        node = hull_put("", 0, y, "note");
                        parts = item_parts(card, at, false);
                        parts.forEach(function(part) { node.appendChild(part); });
                        on_line = 1;
                    } else {
                        on_line++;
                    }
                });
            }
        });
        fit_height();
    }
    function reset_panel() {
        while (panel.firstChild) panel.removeChild(panel.firstChild);
        panel_bottom = 0;
    }
    function ancestor(node, test) {
        while (node && !(node.classList && test(node))) node = node.parentNode;
        return node;
    }
    function cell_of(node) {
        return ancestor(node, function(n) { return n.classList.contains("cell"); });
    }
    // The overall cell of the row `label` is the name of.
    function overall_of(label) {
        return root.querySelector('.cell.overall[data-row="' + label.getAttribute("data-row") + '"]');
    }
    // What the pointer is over that the panel can show: a cell, or a row's name, which shows what
    // the row's overall cell does.
    function pointed(node) {
        var cell = cell_of(node);
        if (cell) return cell;
        var label = label_of(node);
        return label && label.hasAttribute("data-row") ? overall_of(label) : null;
    }
    function label_of(node) {
        return ancestor(node, function(n) {
            return n.classList.contains("label") && (n.hasAttribute("data-row") || n.hasAttribute("data-column"));
        });
    }
    function light(row, column) {
        for (var each of root.querySelectorAll(".cell, .label")) {
            var hot = (row !== null && each.getAttribute("data-row") === row)
                || (column !== null && each.getAttribute("data-column") === column);
            each.classList.toggle("hot", hot);
        }
    }
    function put(text, x, y, classes) {
        var node = document.createElementNS("http://www.w3.org/2000/svg", "text");
        node.setAttribute("x", x);
        node.setAttribute("y", y);
        if (classes) node.setAttribute("class", classes);
        node.textContent = text;
        panel.appendChild(node);
