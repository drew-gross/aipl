        if (at >= 0) removed.splice(at, 1); else removed.push(index);
        refresh();
    }
    function clear() {
        reset_panel();
        panel.setAttribute("transform", "translate(" + panel.getAttribute("data-left") + "," + panel.getAttribute("data-top") + ")");
        var y = put_wrapped("Hover a cell for how the pairing did in each round, or click one to lock it. Untick an archetype to remove it from the metagame and see everyone else's projected win rate.", 14, "head");
        if (removed.length) {
            y += 30;
            var open = fold("Removed from the metagame", "removed", y, "heading");
            button("Restore all", "restore", y);
            for (var index of removed) {
                if (!open) break;
                y += ROW + 2;
                put(names[index], 0, y);
            }
        }
    }
    function show_projection(cell) {
        reset_panel();
        var index = +cell.getAttribute("data-row"), y = 14;
        put(names[index] + " projected", 0, y, "heading");
        if (cell === locked) button("Unlock", "unlock", y);
        if (removed.indexOf(index) >= 0) {
            put_wrapped("Removed from the metagame.", y + 20, "summary");
            return;
        }
        var p = project(index);
        y += 20;
        put(rate_text(p.now) + " win rate · " + record_text(p.now), 0, y, "summary");
        y += 20;
        put("Now " + rate_text(p.was) + " · " + record_text(p.was) + (removed.length ? " · " + delta_text(p) : ""), 0, y, "summary");
        if (!removed.length) {
            put_wrapped("Untick an archetype to remove it from the metagame.", y + 20, "head");
            return;
        }
        y += 30;
        var open = fold("Matches lost to the removed", "lost", y);
        if (!open) return;
        [[0, "Seen"], [2, "Record"], [3, "Win rate"]].forEach(function(column) { put(column[1], NUMBERS[column[0]], y, "head number"); });
        y += 6;
        rule(y);
        p.gone.forEach(function(each) {
            y += ROW;
            put(names[each.column], 0, y);
            put(played(each.record), NUMBERS[0], y, "number");
            put(record_text(each.record), NUMBERS[2], y, "number");
            put(rate_text(each.record), NUMBERS[3], y, "number");
        });
    }
    function show(cell) {
        if (cell.classList.contains("projected")) { show_projection(cell); return; }
        reset_panel();
        var y = 14;
        put(cell.getAttribute("data-title"), 0, y, "heading");
        if (cell === locked) button("Unlock", "unlock", y);
        for (var line of cell.getAttribute("data-summary").split("|")) {
            y += 20;
            y = put_wrapped(line, y, "summary");
        }
        var rounds = cell.getAttribute("data-rounds");
        if (rounds !== "") {
            var labels = panel.getAttribute("data-slots").split("|");
            y += 30;
            var open = fold("Round", "rounds", y);
            if (open) ["Seen", "Share", "Record", "Win rate"].forEach(function(name, i) { put(name, NUMBERS[i], y, "head number"); });
            if (open) { y += 6; rule(y); }
            if (open) rounds.split(";").forEach(function(entry, i) {
                var fields = entry.split(",");
                var classes = fields[0] === "0" ? "zero" : "";
                y += ROW;
                put(labels[i], 0, y, classes);
                fields.forEach(function(value, j) { put(value, NUMBERS[j], y, "number " + classes); });
            });
        }
        var brackets = cell.getAttribute("data-brackets");
        if (brackets !== "") {
            var bracket_names = panel.getAttribute("data-brackets").split("|");
            y += 30;
            var open = fold("Row's record going in", "brackets", y);
            if (open) [[0, "Seen"], [2, "Record"], [3, "Win rate"]].forEach(function(column) { put(column[1], NUMBERS[column[0]], y, "head number"); });
            if (open) { y += 6; rule(y); }
            if (open) brackets.split(";").forEach(function(entry, i) {
                var fields = entry.split(",");
                var classes = fields[0] === "0" ? "zero" : "";
                y += ROW;
                put(bracket_names[i], 0, y, classes);
                put(fields[0], NUMBERS[0], y, "number " + classes);
                put(fields[1], NUMBERS[2], y, "number " + classes);
                put(fields[2], NUMBERS[3], y, "number " + classes);
            });
        }
        // The overall panel also lists the row's decks, each a link to its decklist when it has one.
        if (cell.classList.contains("overall")) {
            var label = root.querySelector('.row-label[data-row="' + cell.getAttribute("data-row") + '"]');
            var listed = label ? label.querySelectorAll("desc.deck") : [];
            if (listed.length) {
                y += 30;
                if (fold("Decklists (" + listed.length + ")", "decks", y)) {
                    y += ROW + 2;
                    [["pilot", "Pilot", 0, "head"], ["list", "List", DECK_COLUMNS[0], "head"], ["event", "Event", DECK_COLUMNS[1], "head"],
                     ["record", "Record", DECK_COLUMNS[2], "head number"], ["win", "Win %", DECK_COLUMNS[3], "head number"]].forEach(function(column) {
                        var heading = put(column[1], column[2], y, column[3] + " sortable" + (column[0] === deck_sorting ? " active" : ""));
                        heading.setAttribute("data-deck-sort", column[0]);
                    });
                    y += 6;
                    rule(y);
                    var entries = Array.from(listed).map(function(deck) {
                        var counts = deck.getAttribute("data-record").split(",").map(Number);
                        var record = { win: counts[0], loss: counts[1], draw: counts[2] };
                        return { pilot: deck.textContent || "(no pilot)", url: deck.getAttribute("data-url"), list: deck.getAttribute("data-name"),
                                 event: deck.getAttribute("data-event"), record: record, rate: played(record) === 0 ? -1 : rate_of(record) };
                    });
                    // Win rate and record put the best first; the words go in alphabetical order.
                    var text = { pilot: "pilot", list: "list", event: "event" };
                    entries.sort(function(a, b) {
                        if (text[deck_sorting]) return a[text[deck_sorting]].localeCompare(b[text[deck_sorting]]) || b.rate - a.rate;
                        return deck_sorting === "record" ? b.record.win - a.record.win || b.rate - a.rate : b.rate - a.rate || b.record.win - a.record.win;
                    });
                    for (var entry of entries) {
                        y += ROW;
                        // Each column has the room up to the next, and a longer text is cut short.
                        var room = [DECK_COLUMNS[0] - 10, DECK_COLUMNS[1] - DECK_COLUMNS[0] - 8, DECK_COLUMNS[2] - DECK_COLUMNS[1] - 50];
                        if (entry.url) put_link(entry.pilot, entry.url, 0, y, room[0]); else fit_text(put(entry.pilot, 0, y), room[0]);
                        fit_text(put(entry.list, DECK_COLUMNS[0], y, "summary"), room[1]);
                        fit_text(put(entry.event, DECK_COLUMNS[1], y, "summary"), room[2]);
                        put(record_text(entry.record), DECK_COLUMNS[2], y, "number");
                        put(entry.rate < 0 ? "-" : percent(entry.rate) + "%", DECK_COLUMNS[3], y, "number");
                    }
                }
            }
        }
    }
    function lock(cell) {
        unlock();
        locked = cell;
        cell.classList.add("locked");
        root.classList.add("locked-view");
        light(cell.getAttribute("data-row"), cell.getAttribute("data-column"));
        show(cell);
        draw_hull();
    }
    function unlock() {
        if (locked) locked.classList.remove("locked");
        locked = null;
        root.classList.remove("locked-view");
        light(null, null);
        clear();
        draw_hull();
    }
    window.addEventListener("mouseover", function(e) {
        var cell = pointed(e.target);
        if (!cell || locked) return;
        light(cell.getAttribute("data-row"), cell.getAttribute("data-column"));
        show(cell);
    });
    window.addEventListener("mouseout", function(e) {
        if (!pointed(e.target) || locked) return;
        light(null, null);
        clear();
    });
    window.addEventListener("click", function(e) {
        var order = e.target.getAttribute && e.target.getAttribute("data-sort");
        if (order) { sorting = order; refresh(); return; }
        var include = e.target.closest && e.target.closest("[data-include]");
        if (include) { toggle(+include.getAttribute("data-include")); return; }
        var expand = e.target.getAttribute && e.target.getAttribute("data-expand");
        if (expand !== null && expand !== undefined && expand !== false) {
            var open_at = expanded.indexOf(+expand);
            if (open_at >= 0) expanded.splice(open_at, 1); else expanded.push(+expand);
            refresh();
            return;
        }
        var deck_sort = e.target.getAttribute && e.target.getAttribute("data-deck-sort");
        if (deck_sort) {
            deck_sorting = deck_sort;
            if (locked) show(locked); else clear();
            return;
        }
        var key = e.target.getAttribute && e.target.getAttribute("data-fold");
        if (key) {
            var at = folded.indexOf(key);
            if (at >= 0) folded.splice(at, 1); else folded.push(key);
            if (locked) show(locked); else clear();
            return;
        }
        var action = e.target.classList && e.target.classList.contains("button") && e.target.getAttribute("data-action");
        if (action === "restore") { removed = []; refresh(); return; }
        if (action === "unlock") { unlock(); return; }
        var label = label_of(e.target);
        // A row is taken out of the metagame by its checkbox; a column heading does it too. A row's
        // name stands for its overall cell: clicking it locks the panel on that.
        if (label && label.hasAttribute("data-row")) {
            var overall = overall_of(label);
            if (overall === locked) unlock(); else lock(overall);
            return;
        }
        if (label) {
            toggle(+(label.hasAttribute("data-row") ? label.getAttribute("data-row") : label.getAttribute("data-column")));
            return;
        }
        var cell = cell_of(e.target);
        if (!cell) return;
        if (cell === locked) unlock(); else lock(cell);
    });
    window.addEventListener("keydown", function(e) {
        if (e.key === "Escape") unlock();
    });
""";

# The word above the column of overall win rates.
let OVERALL = "Overall";

# The word above the column of win rates with the removed archetypes taken out.
let PROJECTED = "Projected";

# The gap between the overall column and the projected one, and between that and the matrix.
let PROJECTED_GAP: u64 = 4;

# The space between the headings and the matrix.
let HEADING_GAP: u64 = 4;

let GAP: u64 = 10;

# The decks that played `copies` copies of a card, and their wins and losses, as the page reads
# them.
fn tally_text(self: Tally) -> str {
    `{self.copies}:{self.decks},{self.record.win},{self.record.loss}`
}.test({
    assert(
        Tally {
            copies: 3,
            decks: 4,
            record: Record { win: 5, loss: 2, draw: 1 },
        }.tally_text() == "3:4,5,2",
    );
})

# A card of a hull as an element a row's label carries, for the page to draw the hull from: its
# section and name, and a tally for each number of copies played.
fn hull_card_markup(self: HullCard) -> str {
    let tallies = self.tallies$tally_text().join(sep=";");
    `<desc class="hull" data-section="{self.section.xml_escape()}" data-name="{self.name.xml_escape()}" data-tallies="{tallies}"/>`
}.test({
    let card = HullCard {
        section: "Land",
        name: "Fire & Ice",
        tallies: [
            Tally { copies: 0, decks: 1, record: Record { loss: 1 } },
            Tally { copies: 4, decks: 2, record: Record { win: 2 } },
        ],
    };
    assert(
        card.hull_card_markup() == `<desc class="hull" data-section="Land" data-name="Fire &amp; Ice" data-tallies="0:1,0,1;4:2,2,0"/>`,
    );
})

# The page for `self`, of the metagame `name`.
pub fn winrate_svg(self: Matrix, name: str) -> str {
    let Matrix { names, definitions, counts, total as decks, slots, slot_matches, matches, brackets, rows, overall, sub_archetypes, decklists, hulls } = self;
    let summaries = counts.map(|count| deck_summary(count, decks));

    // The rows of the page: each archetype, then every sub-archetype, which the page shows under its
    // archetype when that is expanded.
    let parent_count = names.len();
    let row_labels = [..names, ..sub_archetypes.map(|sub| `↳ {sub.name}`)];
    let row_names = [
        ..names,
        ..sub_archetypes.map(|sub| `{names[sub.parent].value_or("")}: {sub.name}`),
    ];
    let row_definitions = [..definitions, ..sub_archetypes$definition];
    let row_summaries = [..summaries, ..sub_archetypes.map(|sub| deck_summary(sub.count, decks))];
    let row_decks = [..decklists, ..sub_archetypes$decks];
    let row_hulls = [..hulls, ..sub_archetypes$hull];
    let row_totals = [..overall, ..sub_archetypes$overall];
    let row_cells = [..rows, ..sub_archetypes$cells];
    mut longest = PROJECTED.len();
    for (let each : names) {
        set longest = max(longest, each.len());
    }
    mut label_characters = longest;
    for (let each : row_labels) {
        set label_characters = max(label_characters, each.len());
    }
    for (let each : [..row_summaries, ..row_definitions]) {
        // The summary and the definition are set smaller than a name.
        set label_characters = max(label_characters, each.len() * 6 / CHARACTER_WIDTH);
    }
    // The slots some match fell in: the panel has a row for each.
    mut shown: u64[] = [];
    for (let slot, count : slot_matches) {
        if (0 < count) { set shown.push(slot); };
    }
    let shown_slots = shown.map(|slot| slots[slot].value_or("").xml_escape()).join(sep="|");
    let bracket_labels = brackets$bracket_text().join(sep="|");
    // A column heading runs up and to the right at 45 degrees.
    let label_width = label_characters * CHARACTER_WIDTH + MARGIN;
    let heading_height = longest * 5 + MARGIN;
    let grid_width = names.len() * CELL;
    let overall_left = MARGIN + label_width;
    let projected_left = overall_left + CELL + PROJECTED_GAP;
    let grid_left = projected_left + CELL + GAP;
    let grid_top = TITLE_HEIGHT + heading_height;
    // The last column's heading leans out over `rise` to the right of the matrix; the panel starts past it.
    let panel_left = grid_left + grid_width + longest * 5 + MARGIN * 2;
    let width = panel_left + PANEL_WIDTH + MARGIN;
    // The panel is at the top, and the page is as tall as the longest panel needs.
    let panel_height = PANEL_FIXED_HEIGHT + (shown.len() + brackets.len()) * PANEL_ROW;
    let height = max(grid_top + grid_width + MARGIN, TITLE_HEIGHT + panel_height + MARGIN);
    let middle = width / 2;
    mut parts: str[] = [];
    let rise = heading_height - HEADING_GAP;
    set parts.push(column_heading("", overall_left, grid_top - HEADING_GAP, rise, OVERALL));
    set parts.push(column_heading("", projected_left, grid_top - HEADING_GAP, rise, PROJECTED));
    for (let column, each : names) {
        set parts.push(column_heading(
            ` data-column="{column}"`,
            grid_left + column * CELL,
            grid_top - HEADING_GAP,
            rise,
            each,
        ));
    }
    for (let row, total : row_totals) {
        let y = grid_top + row * CELL;
        let row_name = row_names[row].value_or("");
        let summary = row_summaries[row].value_or("");
        let definition = row_definitions[row].value_or("");

        // A sub-archetype's elements start out hidden; the page shows them when its archetype is
        // expanded.
        let hidden = if (row < parent_count) {
            ""
        } else {
            ` display="none" data-parent="{sub_archetypes[row - parent_count]$parent.value_or(0)}"`
        };

        // An archetype has a checkbox, ticked while it is in the metagame, and an arrow when it has
        // sub-archetypes to show.
        let listed = row_decks[row]
            .value_or([])
            .map(
                |deck| `<desc class="deck" data-url="{deck.url.xml_escape()}" data-name="{deck.name.xml_escape()}" data-event="{deck.event.xml_escape()}" data-record="{deck.record.win},{deck.record.loss},{deck.record.draw}">{deck.pilot.xml_escape()}</desc>`,
            )
            .join();
        let Hull { baseline, cards } = row_hulls[row].value_or(Hull {
            baseline: Record {},
            cards: [],
        });
        let hull_markup = `<desc class="hull-baseline" data-record="{baseline.win},{baseline.loss},{baseline.draw}"/>{cards$hull_card_markup().join()}`;
        let line = y + CELL / 2 - 17;
        let expander = if (sub_archetypes.any(|each| each.parent == row)) {
            `<text class="expander" data-expand="{row}" x="6" y="{line}">▸</text>`
        } else {
            ""
        };
        let checkbox = if (row < parent_count) {
            `<g class="checkbox" data-include="{row}"><rect x="28" y="{line - 7}" width="14" height="14" rx="2"/><path d="M31,{line} l3,3 l6,-7"/></g>`
        } else {
            ""
        };
        set parts.push(
            `<g class="label row-label{if (row < parent_count) { "" } else { " sub" }}"{hidden} data-row="{row}" data-name="{row_name.xml_escape()}"><rect class="hit" x="2" y="{y}" width="{overall_left - 6}" height="{CELL}"/>{listed}{hull_markup}{expander}{checkbox}<text x="{overall_left - 8}" y="{y + CELL / 2 - 17}">{row_labels[row].value_or("").xml_escape()}</text><text class="detail" x="{overall_left - 8}" y="{y + CELL / 2 - 1}">{definition.xml_escape()}</text><text class="detail" x="{overall_left - 8}" y="{y + CELL / 2 + 15}">{summary}</text></g>`,
        );
        let overall_info = `{row_name} overall: {total.record.rate_text()} ({total.record.record_text()})`.xml_escape();
        let overall_panel = panel_attributes(
            `{row_name} overall`,
            total,
            shown,
            slot_matches,
            matches,
        );
        set parts.push(
            `<g class="cell overall"{hidden} data-row="{row}" data-info="{overall_info}" {overall_panel}><title>{overall_info}</title><rect x="{overall_left}" y="{y}" width="{CELL}" height="{CELL}" fill="{total.record.colour()}"/>{cell_labels(overall_left + CELL / 2, y + CELL / 2, some(total.record))}</g>`,
        );
        set parts.push(
            `<g class="cell projected"{hidden} data-row="{row}"><title>{row_name.xml_escape()} without the removed archetypes' matches</title><rect x="{projected_left}" y="{y}" width="{CELL}" height="{CELL}" fill="{total.record.colour()}"/>{cell_labels(projected_left + CELL / 2, y + CELL / 2, some(total.record))}</g>`,
        );
        for (let column, cell : row_cells[row].value_or([])) {
            let column_name = names[column].value_or("");
            let info = describe(row_name, column_name, cell).xml_escape();
            let x = grid_left + column * CELL;
            let fill = cell$record.value_or(Record {}).colour();
            let attributes = match (cell) {
                some(found) => panel_attributes(
                    `{row_name} vs {column_name}`,
                    found,
                    shown,
                    slot_matches,
                    matches,
                ),
                none => `data-title="{row_name.xml_escape()} against itself" data-summary="Not counted: every match between two decks of it is a win for one and a loss for the other." data-rounds="" data-brackets=""`,
            };
            let shown_cell = cell$record;
            set parts.push(
                `<g class="cell"{hidden} data-row="{row}" data-column="{column}" data-info="{info}" {attributes}><title>{info}</title><rect x="{x}" y="{y}" width="{CELL}" height="{CELL}" fill="{if (cell == none) { "rgb(255,255,255)" } else { fill }}"/>{cell_labels(x + CELL / 2, y + CELL / 2, shown_cell)}</g>`,
            );
        }
    }
    `<?xml version="1.0" standalone="no"?>
<svg version="1.1" width="{width}" height="{height}" viewBox="0 0 {width} {height}" onload="init(evt)" xmlns="http://www.w3.org/2000/svg">
<style type="text/css">{STYLE}</style>
<script type="text/ecmascript"><![CDATA[{SCRIPT}]]></script>
<rect id="background" x="0" y="0" width="{width}" height="{height}" fill="#ffffff"/>
<text id="title" x="{middle}" y="26">Winrate Matrix from {name.xml_escape()}</text>
<text id="subtitle" x="{middle}" y="44">The row's archetype against the column's; a draw counts as half a win</text>
<text id="sorts" x="{MARGIN}" y="44">Sort by <tspan class="sort" data-sort="share">meta share</tspan> · <tspan class="sort" data-sort="winrate">win rate</tspan> · <tspan class="sort" data-sort="projected">projected</tspan> · <tspan class="sort" data-sort="change">change</tspan></text>
{parts.join(sep="\n")}
<g id="hull"></g>
<g id="panel" data-parents="{parent_count}" data-grid-top="{grid_top}" data-height="{height}" data-margin="{MARGIN}" data-left="{panel_left}" data-top="{TITLE_HEIGHT}" data-slots="{shown_slots}" data-brackets="{bracket_labels}"></g>
</svg>
`
}.test({
    let matrix = Matrix {
        names: ["A", "B & C"],
        definitions: ["X, Y", "one of Z & W"],
        counts: [3, 1],
        total: 4,
        slots: ["Finals", "Semifinals"],
        slot_matches: [1, 0],
        matches: 2,
        brackets: [Bracket { win: 0, loss: 0 }],
        rows: [
            [
                none,
                some(Cell {
                    record: Record { win: 1 },
                    rounds: [Record { win: 1 }, Record {}],
                    brackets: [Record { win: 1 }],
                }),
            ],
            [
                some(Cell {
                    record: Record { loss: 1 },
                    rounds: [Record { loss: 1 }, Record {}],
                    brackets: [Record {}],
                }),
                none,
            ],
        ],
        overall: [
            Cell {
                record: Record { win: 1 },
                rounds: [Record { win: 1 }, Record {}],
                brackets: [Record { win: 1 }],
            },
            Cell {
                record: Record { loss: 1 },
                rounds: [Record { loss: 1 }, Record {}],
                brackets: [Record {}],
            },
        ],
    };
    let page = winrate_svg(matrix, "m");
    let lines = page.split("\n");
    assert(lines.first() == some(`<?xml version="1.0" standalone="no"?>`));
    assert(page.contains("Winrate Matrix from m"));
    // A cell says its pairing, and a name is escaped.
    assert(page.contains(`data-info="A vs B &amp; C: 100% (1-0-0)"`));
    assert(page.contains(`data-info="B &amp; C vs A: 0% (0-1-0)"`));
    assert(page.contains(`data-info="A against itself is not counted"`));
    // The panel has what a cell says of each round some match fell in.
    assert(page.contains(`data-title="A vs B &amp; C"`));
    assert(page.contains(`data-rounds="1,100%,1-0-0,100%"`));
    assert(page.contains(`data-slots="Finals"`));
    assert(page.contains(`data-brackets="0-0"`));
    assert(page.contains(`data-brackets="1,1-0-0,100%"`));
    assert(page.contains(`data-title="A against itself"`));
    // A row label has the archetype's definition, escaped, under its name.
    assert(page.contains(">X, Y</text>"));
    assert(page.contains(">one of Z &amp; W</text>"));
    // A row label has the archetype's deck count and share.
    assert(page.contains(">3 decks · 75%</text>"));
    assert(page.contains(">1 deck · 25%</text>"));
    // The sort options are there to click.
    assert(page.contains(`data-sort="winrate">win rate</tspan>`));
    assert(page.contains(`data-sort="projected">projected</tspan>`));
    assert(page.contains(`data-sort="change">change</tspan>`));
    // One cell for each pairing, and a heading for each archetype on both axes.
    assert(page.split(`class="cell"`).len() == 5);
    // The overall column: a cell for each archetype, and its own heading.
    assert(page.contains(`data-info="A overall: 100% (1-0-0)"`));
    assert(page.contains(`data-title="A overall"`));
    assert(page.split(`class="cell overall"`).len() == 3);
    assert(page.split(`class="label"`).len() == 5);

    // The projected column: a cell for each archetype, which the page fills in as archetypes are
    // removed, and the records it works from.
    assert(page.split(`class="cell projected"`).len() == 3);
    assert(page.contains(`data-record="1,0,0"`));
    assert(page.contains(`data-name="B &amp; C"`));
    assert(page.split(`class="label row-label"`).len() == 3);

    // A row label carries its decks, for the panel to list with a link to each.
    let listed = winrate_svg(
        Matrix {
            ..matrix,
            decklists: [
                [
                    DeckLink {
                        pilot: "Ana & Bo",
                        name: "Deck",
                        event: "Worlds",
                        url: "https://x/d?a=1&b=2",
                        record: Record { win: 5, loss: 3, draw: 1 },
                    },
                ],
                [],
            ],
        },
        "m",
    );
    assert(listed.contains(
        `<desc class="deck" data-url="https://x/d?a=1&amp;b=2" data-name="Deck" data-event="Worlds" data-record="5,3,1">Ana &amp; Bo</desc>`,
    ));
    assert(listed.split(`<desc class="deck"`).len() == 2);

    // Nothing is expandable without sub-archetypes, and every archetype has a checkbox.
    assert(!page.contains(`class="expander"`));
    assert(page.split(`class="checkbox"`).len() == 3);
    assert(page.contains(`data-include="1"`));

    // A sub-archetype has a row of its own, hidden until its archetype is expanded: a label that
    // names it under its archetype, and its cells, all marked with the archetype's row.
    let sub = SubArchetype {
        parent: 0,
        name: "X & Y",
        definition: "Z",
        count: 2,
        cells: [some(Cell { record: Record { win: 1 }, rounds: [], brackets: [] }), none],
        overall: Cell { record: Record { win: 1 }, rounds: [], brackets: [] },
    };
    let expandable = winrate_svg(Matrix { ..matrix, sub_archetypes: [sub] }, "m");
    assert(expandable.contains(`data-parents="2"`));
    assert(expandable.contains(`class="expander" data-expand="0"`));
    assert(expandable.split(`class="expander"`).len() == 2);
    // A sub-archetype has no checkbox: it leaves with its archetype.
    assert(expandable.split(`class="checkbox"`).len() == 3);
    assert(expandable.contains(
        `class="label row-label sub" display="none" data-parent="0" data-row="2" data-name="A: X &amp; Y"`,
    ));
    assert(expandable.contains(`>↳ X &amp; Y</text>`));
    assert(expandable.contains(`>2 decks · 50%</text>`));
    assert(expandable.contains(`class="cell overall" display="none" data-parent="0" data-row="2"`));
    assert(expandable.contains(
        `class="cell projected" display="none" data-parent="0" data-row="2"`,
    ));
    assert(expandable.contains(
        `class="cell" display="none" data-parent="0" data-row="2" data-column="0"`,
    ));
    assert(expandable.contains(`data-info="A: X &amp; Y vs A: 100%`));
})
