        return node;
    }
    // `node` cut short with an ellipsis until it is no wider than `limit`, its whole text on hover.
    function fit_text(node, limit) {
        var whole = node.textContent;
        if (node.getComputedTextLength() <= limit) return node;
        var cut = whole;
        while (cut.length > 1 && node.getComputedTextLength() > limit) {
            cut = cut.slice(0, -1);
            node.textContent = cut + "\u2026";
        }
        var title = document.createElementNS("http://www.w3.org/2000/svg", "title");
        title.textContent = whole;
        node.appendChild(title);
        return node;
    }
    // Text that is a link to `url`, opened in a new tab; `limit`, if given, is as wide as it may be.
    function put_link(text, url, x, y, limit) {
