# The convex hull of an archetype, as the original's `convex_hull` command works it out: every card
# any of its decks played, by the part of the deck it was in (its type for the main deck, and
# `Sideboard`), and for each card how many of the decks played each number of copies of it, and how
# those did.

import {
    distinct,
    equal as ==,
    filter,
    find_if,
    join,
    map,
    push,
    sort,
    value_or,
    wrapping_add as +,
} from builtins;
import { Card, Deck, Record, add_records } from "./metagame.aipl";

# The decks that played one number of copies of a card: `copies` of it, how many `decks` there were,
# and their `record` added up.
struct Tally { copies: u64, decks: u64, record: Record }

# One card of the hull: the `section` it is listed under, its `name`, and a tally for each number of
# copies the decks played, fewest first (none of it among them, when some deck did not play it). A
# card of the main deck is counted by its main-deck copies, and one of the sideboard by its sideboard
# copies.
struct HullCard { section: str, name: str, tallies: Tally[] }

# The hull of an archetype: its cards, and the `baseline` record of all its decks.
struct Hull { baseline: Record, cards: HullCard[] }

# The name of the part of a deck that its cards are listed under when they are in the sideboard.
let SIDEBOARD = "Sideboard";

# How many copies `self` has of the card named `name`.
fn copies_of(self: Card[], name: str) -> u64 {
    self.find_if(|card| card.name == name)$count.value_or(0)
}.test({
    let cards = [Card { name: "Island", count: 4 }, Card { name: "Bolt", count: 2 }];
    assert(cards.copies_of("Island") == 4);
    assert(cards.copies_of("Duress") == 0);
})

# The tally of the decks that played `wanted` copies, given how many copies each deck played
# (`copies`) and the deck's records, as listed in `records`.
fn tally_of(copies: u64[], records: Record[], wanted: u64) -> Tally {
    mut found = Tally { copies: wanted, decks: 0, record: Record {} };
    for (let at, count : copies) {
        if (count == wanted) {
            set found = Tally {
                copies: wanted,
                decks: found.decks + 1,
                record: add_records(found.record, records[at].value_or(Record {})),
            };
        };
    }
    found
}.test({
    let records = [
        Record { win: 2 },
        Record { loss: 1 },
        Record { win: 1, loss: 1 },
        Record { win: 1 },
    ];
    let copies = [4, 0, 4, 2];
    assert(tally_of(copies, records, 4) == Tally {
        copies: 4,
        decks: 2,
        record: Record { win: 3, loss: 1 },
    });
    assert(tally_of(copies, records, 0) == Tally {
        copies: 0,
        decks: 1,
        record: Record { loss: 1 },
    });
    assert(tally_of(copies, records, 3) == Tally { copies: 3, decks: 0, record: Record {} });
})

# The card `name`, listed under `section`, given how many copies each deck had and how each did.
fn hull_card(section: str, name: str, copies: u64[], records: Record[]) -> HullCard {
    section,
    name,
    tallies: copies.distinct().sort().map(|wanted| tally_of(copies, records, wanted)),
}.test({
    let tallies = hull_card(
        "Land",
        "Island",
        [4, 0, 2, 4],
        [Record { win: 1 }, Record {}, Record {}, Record { loss: 1 }],
    ).tallies;
    assert(tallies$copies == [0, 2, 4]);
    assert(tallies$decks == [1, 1, 2]);
    assert(tallies[2]?.record == Record { win: 1, loss: 1 });
})

# The hull of `decks`: the main deck's cards by type in alphabetical order, then the sideboard's,
# each part's cards in name order.
pub fn hull_of(decks: Deck[]) -> Hull {
    let records = decks$record;
    mut cards: HullCard[] = [];
    let types = decks.map(|deck| deck.maindeck$card_type).join().distinct().sort();
    for (let type : types) {
        let names = decks
            .map(|deck| deck.maindeck.filter(|card| card.card_type == type)$name)
            .join()
            .distinct()
            .sort();
        for (let name : names) {
            set cards.push(hull_card(type, name, decks$maindeck$copies_of(name), records));
        }
    }
    let sideboard = decks.map(|deck| deck.sideboard$name).join().distinct().sort();
    for (let name : sideboard) {
        set cards.push(hull_card(SIDEBOARD, name, decks$sideboard$copies_of(name), records));
    }
    mut baseline = Record {};
    for (let record : records) {
        set baseline = add_records(baseline, record);
    }
    Hull { baseline, cards }
}.test({
    let island = Card { name: "Island", count: 4, card_type: "Land" };
    let bolt = Card { name: "Bolt", count: 2, card_type: "Instant" };
    let decks = [
        Deck {
            deck_id: "a",
            maindeck: [island, bolt],
            sideboard: [Card { name: "Negate", count: 2, card_type: "Sideboard" }],
            record: Record { win: 3, loss: 1 },
        },
        Deck {
            deck_id: "b",
            maindeck: [Card { ..island, count: 3 }],
            record: Record { win: 1, loss: 2 },
        },
    ];
    let Hull { baseline, cards } = hull_of(decks);
    assert(baseline == Record { win: 4, loss: 3 });
    // Types in order, the sideboard last, and each card's tallies by number of copies.
    assert(cards$section == ["Instant", "Land", "Sideboard"]);
    assert(cards$name == ["Bolt", "Island", "Negate"]);
    // Island: three copies in deck b, four in deck a.
    assert(cards[1]?.tallies$copies == [3, 4]);
    assert(cards[1]?.tallies$record == [Record { win: 1, loss: 2 }, Record { win: 3, loss: 1 }]);
    // Deck b has no Bolt or Negate: it is a deck with none of it, as the original counts one.
    assert(cards[0]?.tallies$copies == [0, 2]);
    assert(cards[0]?.tallies$decks == [1, 1]);
    assert(cards[2]?.tallies$copies == [0, 2]);
})
