# What the data directory holds: a metagame is the decks played at some
# tournaments, each with its cards, and the matches those decks played against each other.
# `load_metagame`
# reads one of the gzipped JSON files `tools/pkl_to_json.py` wrote.

import {
    ExecResult,
    IEEE754Float64 as Float,
    collect_ok,
    equal as ==,
    execute_program,
    extend,
    filter,
    float_div as /,
    greater_than as >,
    has,
    less_than as <,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    to_float,
    to_set,
    to_str,
    try_map,
    value_or,
    value_or_err,
    wrapping_add as +,
} from builtins;
import {
    field,
    integer_field,
    list_field,
    optional_text_field,
    scalar_text,
    text_field,
    unsigned_field,
} from "./json.aipl";
import { Json, parse } from json;

# How one match ended, from the point of view of the first deck in it.
variant Result = Win | Loss | Draw

# Matches (or games) won, lost and drawn.
struct Record { win: i64, loss: i64, draw: i64 }

# One line of a decklist: a card, how many copies, and its type line category.
struct Card { name: str, count: u64, card_type: str }

# One round played between two decks. `result` and `record` are the first deck's: the second
# deck's are the other way round.
struct Match { first_deck_id: str, second_deck_id: str, result: Result, record: Record, round: str }

# A decklist. The id is text: the sources number decks with
# integers and with strings.
struct Deck {
    deck_id: str,
    name: str,
    pilot: str,
    tournament: str,
    maindeck: Card[],
    sideboard: Card[],
}

# The cards of `self`'s main deck followed by its sideboard.
pub fn all_cards(self: Deck) -> Card[] { [..self.maindeck, ..self.sideboard] }.test({
    let island = Card { name: "Island", count: 4, card_type: "Land" };
    let bolt = Card { name: "Bolt", count: 2, card_type: "Instant" };
    let deck = Deck {
        deck_id: "1",
        name: "",
        pilot: "",
        tournament: "",
        maindeck: [island],
        sideboard: [bolt],
    };
    assert(deck.all_cards() == [island, bolt]);
    assert(Deck { ..deck, maindeck: [], sideboard: [] }.all_cards() == []);
})

# The decks of one or more tournaments and the matches they played. A match is held once, whichever
# deck's history it came from; one whose opponent is not named (a bye) is not held. `name` is the
# file it was loaded from.
struct Metagame { name: str, tournament_ids: str[], decks: Deck[], matches: Match[] }

# `a` and `b` counted together.
pub fn add_records(a: Record, b: Record) -> Record {
    win: a.win + b.win,
    loss: a.loss + b.loss,
    draw: a.draw + b.draw,
}.test({
    assert(add_records(
        Record { win: 1, loss: 2, draw: 3 },
        Record { win: 10, loss: 20, draw: 30 },
    ) == Record { win: 11, loss: 22, draw: 33 });
})

# The share of the decided matches `self` won, as a fraction of 1 (an even record is
# 0.5), or `none` when there is no decided match. Draws are left out of the denominator.
pub fn win_rate(self: Record) -> Float? {
    let decided = self.win + self.loss;
    if (decided > 0) { some(self.win.to_float() / decided.to_float()) } else { none }
}.test({
    // Floats have no `==` of their own beside this file's, so the rate is rendered.
    fn rendered(record: Record) -> str? { record.win_rate()$to_str() }
    assert(rendered(Record { win: 0, loss: 0, draw: 4 }) == none);
    assert(rendered(Record { win: 1, loss: 1, draw: 0 }) == some("0.5"));
    assert(rendered(Record { win: 2, loss: 1, draw: 9 }) == some("0.6666666666666666"));
    assert(rendered(Record { win: 0, loss: 3, draw: 0 }) == some("0.0"));
})

# `self` as a `Result`: `win`, `loss` or `draw`.
fn decode_result(self: str) -> Result!str {
    if (self == "win") {
        ok(Win)
    } else if (self == "loss") {
        ok(Loss)
    } else if (self == "draw") {
        ok(Draw)
    } else {
        err(`unknown match result "{self}"`)
    }
}.test({
    assert(decode_result("win") == ok(Win));
    assert(decode_result("loss") == ok(Loss));
    assert(decode_result("draw") == ok(Draw));
    assert(decode_result("bye") == err(`unknown match result "bye"`));
})

# A card line: `{"name": .., "count": .., "card_type": ..}`.
fn decode_card(self: Json) -> Card!str {
    ok(Card {
        name: self.text_field("name")?,
        count: self.unsigned_field("count")?,
        card_type: self.text_field("card_type")?,
    })
}.test({
    let json = parse("""{"name":"Island","count":4,"card_type":"Land"}""")?;
    assert(decode_card(json) == ok(Card { name: "Island", count: 4, card_type: "Land" }));
    let bad = parse("""{"name":"Island"}""")?;
    assert(decode_card(bad) == err(`missing "count"`));
})

# A game record: `{"win": .., "loss": .., "draw": ..}`.
fn decode_record(self: Json) -> Record!str {
    ok(Record {
        win: self.integer_field("win")?,
        loss: self.integer_field("loss")?,
        draw: self.integer_field("draw")?,
    })
}.test({
    let json = parse("""{"win":2,"loss":1,"draw":0}""")?;
    assert(decode_record(json) == ok(Record { win: 2, loss: 1, draw: 0 }));
})

# One round of the match history of the deck `owner`: a match against the opponent it names, or
# `none` for a round with no opponent.
fn decode_match(self: Json, owner: str) -> Match?!str {
    let record = self.field("record").value_or_err(`missing "record"`)?;
    let result = self.text_field("result")?.decode_result()?;
    let decoded = decode_record(record)?;
    // A round is a label, or a list of them when the source split it.
    let round = self.optional_text_field("round").value_or("");
    ok(
        self
            .optional_text_field("opponent_deck_id")
            .map(|opponent| Match {
                first_deck_id: owner,
                second_deck_id: opponent,
                result,
                record: decoded,
                round,
            }),
    )
}.test({
    let json = parse(
        """{"opponent_deck_id":7,"result":"win","record":{"win":2,"loss":0,"draw":0},"round":"Round 1"}""",
    )?;
    assert(decode_match(json, "3") == ok(some(Match {
        first_deck_id: "3",
        second_deck_id: "7",
        result: Win,
        record: Record { win: 2, loss: 0, draw: 0 },
        round: "Round 1",
    })));
    let bye = parse(
        """{"opponent_deck_id":null,"result":"win","record":{"win":2,"loss":0,"draw":0}}""",
    )?;
    assert(decode_match(bye, "3") == ok(none));
})

# A deck, with its cards.
fn decode_deck(self: Json) -> Deck!str {
    ok(Deck {
        deck_id: self.text_field("deck_id")?,
        name: self.optional_text_field("name").value_or(""),
        pilot: self.optional_text_field("pilot").value_or(""),
        tournament: self.optional_text_field("tournament").value_or(""),
        maindeck: self.list_field("maindeck")?.try_map(decode_card)?,
        sideboard: self.list_field("sideboard")?.try_map(decode_card)?,
    })
}.test({
    let json = parse("""
        {"deck_id":"d1","name":null,"pilot":"Ana","tournament":5,
         "maindeck":[{"name":"Island","count":4,"card_type":"Land"}],
         "sideboard":[],"match_history":[]}
    """)?;
    assert(decode_deck(json) == ok(Deck {
        deck_id: "d1",
        name: "",
        pilot: "Ana",
        tournament: "5",
        maindeck: [Card { name: "Island", count: 4, card_type: "Land" }],
        sideboard: [],
    }));
})

# The rounds in the match history of the deck `self`, each against the opponent it names.
fn decode_history(self: Json) -> Match[]!str {
    let owner = self.text_field("deck_id")?;
    let rounds = self.list_field("match_history")?;
    ok(rounds.try_map(|round| round.decode_match(owner))?.collect_ok())
}.test({
    let json = parse("""
        {"deck_id":"a","match_history":[
          {"opponent_deck_id":"b","result":"loss","record":{"win":0,"loss":2,"draw":0},"round":"R1"},
          {"opponent_deck_id":null,"result":"win","record":{"win":2,"loss":0,"draw":0},"round":"R2"}]}
    """)?;
    assert(decode_history(json) == ok([
        Match {
            first_deck_id: "a",
            second_deck_id: "b",
            result: Loss,
            record: Record { win: 0, loss: 2, draw: 0 },
            round: "R1",
        },
    ]));
})

# `self` with each match held once. Every deck's history lists its matches, so a match between two
# decks that both have one is there twice, from each side: the copy the lower deck id has is the
# one kept. A match whose opponent has no copy of it is kept.
fn without_mirrors(self: Match[]) -> Match[] {
    let listed = self
        .map(|each| `{each.first_deck_id}|{each.second_deck_id}|{each.round}`)
        .to_set();
    self.filter(|each| {
        each.first_deck_id < each.second_deck_id || !listed.has(
            `{each.second_deck_id}|{each.first_deck_id}|{each.round}`,
        )
    })
}.test({
    let win = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        result: Win,
        record: Record { win: 2, loss: 0, draw: 0 },
        round: "R1",
    };
    let loss = Match {
        first_deck_id: "b",
        second_deck_id: "a",
        result: Loss,
        record: Record { win: 0, loss: 2, draw: 0 },
        round: "R1",
    };
    assert([win, loss].without_mirrors() == [win]);
    assert([loss, win].without_mirrors() == [win]);
    // Only one deck's history has the match.
    assert([loss].without_mirrors() == [loss]);
    // A rematch in another round is another match.
    let rematch = Match { ..win, round: "R2" };
    assert([win, rematch, loss].without_mirrors() == [win, rematch]);
})

# The complaint about a match naming the deck `id`, which the metagame has none of.
pub fn unknown_deck(id: str) -> str {
    `a match names deck "{id}", which is not in the metagame`
}.test({
    assert(unknown_deck("7") == `a match names deck "7", which is not in the metagame`);
})

# `ok` when both decks of every match in `self` are among `decks`, and the complaint about the first
# match that names one that is not otherwise.
fn check_decks_exist(self: Match[], decks: Deck[]) -> !str {
    let known: #{str} = decks$deck_id.to_set();
    for (let each : self) {
        if (!known.has(each.first_deck_id)) { return err(unknown_deck(each.first_deck_id)); };
        if (!known.has(each.second_deck_id)) { return err(unknown_deck(each.second_deck_id)); };
    }
    ok()
}.test({
    let deck = Deck {
        deck_id: "a",
        name: "",
        pilot: "",
        tournament: "",
        maindeck: [],
        sideboard: [],
    };
    let other = Deck { ..deck, deck_id: "b" };
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        result: Win,
        record: Record { win: 0, loss: 0, draw: 0 },
        round: "",
    };
    assert([match_played].check_decks_exist([deck, other]) == ok());
    assert([match_played].check_decks_exist([deck]) == err(unknown_deck("b")));
    assert([match_played].check_decks_exist([other]) == err(unknown_deck("a")));
    assert([].check_decks_exist([]) == ok());
})

# A whole metagame document, as `tools/pkl_to_json.py` writes it.
pub fn decode_metagame(self: Json) -> Metagame!str {
    let decks = self.list_field("decks")?;
    mut histories: Match[] = [];
    for (let deck : decks) {
        set histories.extend(deck.decode_history()?);
    }
    let decoded = decks.try_map(decode_deck)?;
    let matches = histories.without_mirrors();
    matches.check_decks_exist(decoded)?;
    ok(Metagame {
        name: self.text_field("name")?,
        tournament_ids: self.list_field("tournament_ids")?$scalar_text().collect_ok(),
        decks: decoded,
        matches,
    })
}.test({
    let json = parse("""{"name":"m","tournament_ids":[1,"b"],"decks":[]}""")?;
    assert(decode_metagame(json) == ok(Metagame {
        name: "m",
        tournament_ids: ["1", "b"],
        decks: [],
        matches: [],
    }));
    // A match against a deck the document does not have is bad data.
    let dangling = parse("""
        {"name":"m","tournament_ids":[],"decks":[
          {"deck_id":"a","maindeck":[],"sideboard":[],"match_history":[
            {"opponent_deck_id":"zz","result":"win","record":{"win":2,"loss":0,"draw":0},"round":"R1"}]}]}
    """)?;
    assert(decode_metagame(dangling) == err(unknown_deck("zz")));
})

# The metagame in the gzipped JSON file at `path`. The file is unpacked by
# `gzip`, since nothing here reads binary files or decompresses yet.
pub fn load_metagame(path: str) !execute_program -> Metagame!str {
    let ExecResult { stdout, stderr, exit_code } = "gzip".execute_program(args=["-dc", path])?;
    if (exit_code != 0) { return err(`gzip {path}: {stderr}`); };
    parse(stdout)?.decode_metagame()
}
