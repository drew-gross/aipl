# What the data directory holds: a metagame is the decks played at some
# tournaments, each with its cards, and the matches those decks played against each other.
# `load_metagame`
# reads one of the gzipped JSON files `tools/pkl_to_json.py` wrote.

import {
    ExecResult,
    IEEE754Float64 as Float,
    collect_ok,
    equal as ==,
    execute_program,
    extend,
    filter,
    first,
    float_div as /,
    get,
    greater_than as >,
    has,
    less_than as <,
    logical_not as !,
    logical_or as ||,
    map,
    not_equal as !=,
    push,
    to_dict,
    to_float,
    to_set,
    to_str,
    try_map,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;
import {
    elements,
    field,
    integer_field,
    list_field,
    optional_text_field,
    scalar_text,
    text_field,
    unsigned_field,
} from "./json.aipl";
import { Json, parse } from json;

# How one match ended, from the point of view of the first deck in it.
variant Result = Win | Loss | Draw

# Matches (or games) won, lost and drawn.
struct Record { win: i64 = 0, loss: i64 = 0, draw: i64 = 0 }

# One line of a decklist: a card, how many copies, and its type line category.
struct Card { name: str, count: u64 = 1, card_type: str = "" }

# One round played between two decks, at the tournament named `tournament`. `result` and `record`
# are the first deck's: the second deck's are the other way round. `round` is the round's label,
# `Round 3` or `Quarterfinals`. `first_before` and `second_before` are what each deck's matches
# came to before this round, byes included, or `none` for a second deck whose own history does not
# have the round.
struct Match {
    first_deck_id: str,
    second_deck_id: str,
    tournament: str = "",
    first_before: Record,
    second_before: Record? = none,
    result: Result,
    record: Record,
    round: str = "",
}

# A decklist. The id is text: the sources number decks with
# integers and with strings.
struct Deck {
    deck_id: str,
    name: str = "",
    pilot: str = "",
    tournament: str = "",
    maindeck: Card[] = [],
    sideboard: Card[] = [],
}

# The cards of `self`'s main deck followed by its sideboard.
pub fn all_cards(self: Deck) -> Card[] { [..self.maindeck, ..self.sideboard] }.test({
    let island = Card { name: "Island", count: 4, card_type: "Land" };
    let bolt = Card { name: "Bolt", count: 2, card_type: "Instant" };
    let deck = Deck { deck_id: "1", maindeck: [island], sideboard: [bolt] };
    assert(deck.all_cards() == [island, bolt]);
    assert(Deck { ..deck, maindeck: [], sideboard: [] }.all_cards() == []);
})

# The decks of one or more tournaments and the matches they played. A match is held once, whichever
# deck's history it came from; one whose opponent is not named (a bye) is not held. `name` is the
# file it was loaded from.
struct Metagame { name: str, tournament_ids: str[], decks: Deck[], matches: Match[] }

# `a` and `b` counted together.
pub fn add_records(a: Record, b: Record) -> Record {
    win: a.win + b.win,
    loss: a.loss + b.loss,
    draw: a.draw + b.draw,
}.test({
    assert(add_records(
        Record { win: 1, loss: 2, draw: 3 },
        Record { win: 10, loss: 20, draw: 30 },
    ) == Record { win: 11, loss: 22, draw: 33 });
})

# How many matches `self` counts.
pub fn played(self: Record) -> i64 { self.win + self.loss + self.draw }.test({
    assert(Record { win: 2, loss: 1, draw: 4 }.played() == 7);
    assert(Record {}.played() == 0);
})

# The share of its matches `self` won, as a fraction of 1 (an even record is 0.5), or `none` when
# it has no match. A draw counts as half a win.
pub fn win_rate(self: Record) -> Float? {
    let played = self.played();
    let points = self.win * 2 + self.draw;
    if (played > 0) { some(points.to_float() / (played * 2).to_float()) } else { none }
}.test({
    // Floats have no `==` of their own beside this file's, so the rate is rendered.
    fn rendered(record: Record) -> str? { record.win_rate()$to_str() }
    assert(rendered(Record {}) == none);
    assert(rendered(Record { draw: 4 }) == some("0.5"));
    assert(rendered(Record { win: 3, draw: 1 }) == some("0.875"));
    assert(rendered(Record { win: 1, loss: 1 }) == some("0.5"));
    assert(rendered(Record { win: 2, loss: 1, draw: 9 }) == some("0.5416666666666666"));
    assert(rendered(Record { loss: 3 }) == some("0.0"));
})

# `self` as a `Result`: `win`, `loss` or `draw`.
fn decode_result(self: str) -> Result!str {
    if (self == "win") {
        ok(Win)
    } else if (self == "loss") {
        ok(Loss)
    } else if (self == "draw") {
        ok(Draw)
    } else {
        err(`unknown match result "{self}"`)
    }
}.test({
    assert(decode_result("win") == ok(Win));
    assert(decode_result("loss") == ok(Loss));
    assert(decode_result("draw") == ok(Draw));
    assert(decode_result("bye") == err(`unknown match result "bye"`));
})

# A card line: `{"name": .., "count": .., "card_type": ..}`.
fn decode_card(self: Json) -> Card!str {
    ok(Card {
        name: self.text_field("name")?,
        count: self.unsigned_field("count")?,
        card_type: self.text_field("card_type")?,
    })
}.test({
    let json = parse("""{"name":"Island","count":4,"card_type":"Land"}""")?;
    assert(decode_card(json) == ok(Card { name: "Island", count: 4, card_type: "Land" }));
    let bad = parse("""{"name":"Island"}""")?;
    assert(decode_card(bad) == err(`missing "count"`));
})

# A game record: `{"win": .., "loss": .., "draw": ..}`.
fn decode_record(self: Json) -> Record!str {
    ok(Record {
        win: self.integer_field("win")?,
        loss: self.integer_field("loss")?,
        draw: self.integer_field("draw")?,
    })
}.test({
    let json = parse("""{"win":2,"loss":1,"draw":0}""")?;
    assert(decode_record(json) == ok(Record { win: 2, loss: 1 }));
})

# The label of the round `self` records: the text it holds, or the first of a list of them when the
# source split it, or nothing if it has none.
fn round_label(self: Json) -> str {
    let some(round) = self.field("round") else { return ""; };
    if (let some(text) = round.scalar_text()) { return text; };
    if (let some(first) = round.elements().value_or([]).first()) {
        return first.scalar_text().value_or("");
    };
    ""
}.test({
    assert(round_label(parse("""{"round":"Round 1"}""")?) == "Round 1");
    assert(round_label(parse("""{"round":["Semifinals"]}""")?) == "Semifinals");
    assert(round_label(parse("""{"round":[]}""")?) == "");
    assert(round_label(parse("""{"round":null}""")?) == "");
    assert(round_label(parse("{}")?) == "");
})

# `self` as the record of a single match.
pub fn as_record(self: Result) -> Record {
    match (self) {
        Win => Record { win: 1 },
        Loss => Record { loss: 1 },
        Draw => Record { draw: 1 },
    }
}.test({
    assert(Win.as_record() == Record { win: 1 });
    assert(Loss.as_record() == Record { loss: 1 });
    assert(Draw.as_record() == Record { draw: 1 });
})

# One round of the match history of the deck `owner`, at the tournament `tournament`, when the
# deck's matches came to `before`: how it ended, and the match against the opponent it names, or
# `none` for a round with no opponent.
fn decode_match(self: Json, owner: str, tournament: str, before: Record) -> (Result, Match?)!str {
    let record = self.field("record").value_or_err(`missing "record"`)?;
    let result = self.text_field("result")?.decode_result()?;
    let decoded = decode_record(record)?;
    let round = self.round_label();
    ok((
        result,
        self
            .optional_text_field("opponent_deck_id")
            .map(|opponent| Match {
                first_deck_id: owner,
                second_deck_id: opponent,
                tournament,
                first_before: before,
                result,
                record: decoded,
                round,
            }),
    ))
}.test({
    let json = parse(
        """{"opponent_deck_id":7,"result":"win","record":{"win":2,"loss":0,"draw":0},"round":"Round 1"}""",
    )?;
    let before = Record { win: 1, loss: 2 };
    assert(decode_match(json, "3", "t", before) == ok((
        Win,
        some(Match {
            first_deck_id: "3",
            second_deck_id: "7",
            tournament: "t",
            first_before: before,
            result: Win,
            record: Record { win: 2 },
            round: "Round 1",
        }),
    )));
    let bye = parse(
        """{"opponent_deck_id":null,"result":"win","record":{"win":2,"loss":0,"draw":0}}""",
    )?;
    let no_match: Match? = none;
    assert(decode_match(bye, "3", "t", before) == ok((Win, no_match)));
})

# A deck, with its cards.
fn decode_deck(self: Json) -> Deck!str {
    ok(Deck {
        deck_id: self.text_field("deck_id")?,
        name: self.optional_text_field("name").value_or(""),
        pilot: self.optional_text_field("pilot").value_or(""),
        tournament: self.optional_text_field("tournament").value_or(""),
        maindeck: self.list_field("maindeck")?.try_map(decode_card)?,
        sideboard: self.list_field("sideboard")?.try_map(decode_card)?,
    })
}.test({
    let json = parse("""
        {"deck_id":"d1","name":null,"pilot":"Ana","tournament":5,
         "maindeck":[{"name":"Island","count":4,"card_type":"Land"}],
         "sideboard":[],"match_history":[]}
    """)?;
    assert(decode_deck(json) == ok(Deck {
        deck_id: "d1",
        name: "",
        pilot: "Ana",
        tournament: "5",
        maindeck: [Card { name: "Island", count: 4, card_type: "Land" }],
        sideboard: [],
    }));
})

# The rounds in the match history of the deck `self`, each against the opponent it names. The
# history is in the order played, and a round with no opponent (a bye) counts toward the record
# the next round starts from.
fn decode_history(self: Json) -> Match[]!str {
    let owner = self.text_field("deck_id")?;
    let tournament = self.optional_text_field("tournament").value_or("");
    mut standing = Record {};
    mut found: Match[] = [];
    for (let round : self.list_field("match_history")?) {
        let (result, played) = round.decode_match(owner, tournament, standing)?;
        if (let some(each) = played) { set found.push(each); };
        set standing = add_records(standing, result.as_record());
    }
    ok(found)
}.test({
    let json = parse("""
        {"deck_id":"a","tournament":"t","match_history":[
          {"opponent_deck_id":"b","result":"loss","record":{"win":0,"loss":2,"draw":0},"round":"R1"},
          {"opponent_deck_id":null,"result":"win","record":{"win":2,"loss":0,"draw":0},"round":"R2"},
          {"opponent_deck_id":"c","result":"win","record":{"win":2,"loss":1,"draw":0},"round":"R3"}]}
    """)?;
    assert(decode_history(json) == ok([
        Match {
            first_deck_id: "a",
            second_deck_id: "b",
            tournament: "t",
            result: Loss,
            record: Record { loss: 2 },
            round: "R1",
            first_before: Record {},
        },
        // The bye in round 2 counts as a win toward the record the next round starts from.
        Match {
            first_deck_id: "a",
            second_deck_id: "c",
            tournament: "t",
            first_before: Record { win: 1, loss: 1 },
            result: Win,
            record: Record { win: 2, loss: 1 },
            round: "R3",
        },
    ]));
})

# `self` with each match held once. Every deck's history lists its matches, so a match between two
# decks that both have one is there twice, from each side: the copy the lower deck id has is the
# one kept. A match whose opponent has no copy of it is kept.
fn without_mirrors(self: Match[]) -> Match[] {
    let listed = self
        .map(|each| `{each.first_deck_id}|{each.second_deck_id}|{each.round}`)
        .to_set();
    self.filter(|each| {
        each.first_deck_id < each.second_deck_id || !listed.has(
            `{each.second_deck_id}|{each.first_deck_id}|{each.round}`,
        )
    })
}.test({
    let win = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "t",
        result: Win,
        record: Record { win: 2 },
        round: "R1",
        first_before: Record {},
    };
    let loss = Match {
        first_deck_id: "b",
        second_deck_id: "a",
        tournament: "t",
        result: Loss,
        record: Record { loss: 2 },
        round: "R1",
        first_before: Record {},
    };
    assert([win, loss].without_mirrors() == [win]);
    assert([loss, win].without_mirrors() == [win]);
    // Only one deck's history has the match.
    assert([loss].without_mirrors() == [loss]);
    // A rematch in another round is another match.
    let rematch = Match { ..win, round: "R2" };
    assert([win, rematch, loss].without_mirrors() == [win, rematch]);
})

# What names the round `round` of the deck `deck`'s history.
fn standing_key(deck: str, round: str) -> str { `{deck}|{round}` }.test({
    assert(standing_key("a", "Round 1") == "a|Round 1");
})

# The complaint about a match naming the deck `id`, which the metagame has none of.
pub fn unknown_deck(id: str) -> str {
    `a match names deck "{id}", which is not in the metagame`
}.test({
    assert(unknown_deck("7") == `a match names deck "7", which is not in the metagame`);
})

# `ok` when both decks of every match in `self` are among `decks`, and the complaint about the first
# match that names one that is not otherwise.
fn check_decks_exist(self: Match[], decks: Deck[]) -> !str {
    let known: #{str} = decks$deck_id.to_set();
    for (let each : self) {
        if (!known.has(each.first_deck_id)) { return err(unknown_deck(each.first_deck_id)); };
        if (!known.has(each.second_deck_id)) { return err(unknown_deck(each.second_deck_id)); };
    }
    ok()
}.test({
    let deck = Deck {
        deck_id: "a",
        name: "",
        pilot: "",
        tournament: "",
        maindeck: [],
        sideboard: [],
    };
    let other = Deck { ..deck, deck_id: "b" };
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "t",
        result: Win,
        first_before: Record {},
        record: Record {},
    };
    assert([match_played].check_decks_exist([deck, other]) == ok());
    assert([match_played].check_decks_exist([deck]) == err(unknown_deck("b")));
    assert([match_played].check_decks_exist([other]) == err(unknown_deck("a")));
    assert([].check_decks_exist([]) == ok());
})

# A whole metagame document, as `tools/pkl_to_json.py` writes it.
pub fn decode_metagame(self: Json) -> Metagame!str {
    let decks = self.list_field("decks")?;
    mut histories: Match[] = [];
    for (let deck : decks) {
        set histories.extend(deck.decode_history()?);
    }
    let decoded = decks.try_map(decode_deck)?;
    let standings: #{str: Record} = histories
        .map(|each| (standing_key(each.first_deck_id, each.round), each.first_before))
        .to_dict();
    let matches = histories
        .without_mirrors()
        .map(|each| Match {
            ..each,
            second_before: standings.get(standing_key(each.second_deck_id, each.round)),
        });
    matches.check_decks_exist(decoded)?;
    ok(Metagame {
        name: self.text_field("name")?,
        tournament_ids: self.list_field("tournament_ids")?$scalar_text().collect_ok(),
        decks: decoded,
        matches,
    })
}.test({
    let json = parse("""{"name":"m","tournament_ids":[1,"b"],"decks":[]}""")?;
    assert(decode_metagame(json) == ok(Metagame {
        name: "m",
        tournament_ids: ["1", "b"],
        decks: [],
        matches: [],
    }));
    // Each deck's record going into the round is its own: a lost bye and a won one differ.
    let met = parse("""
        {"name":"m","tournament_ids":[],"decks":[
          {"deck_id":"a","maindeck":[],"sideboard":[],"match_history":[
            {"opponent_deck_id":null,"result":"loss","record":{"win":0,"loss":0,"draw":0},"round":"Round 1"},
            {"opponent_deck_id":"b","result":"win","record":{"win":2,"loss":0,"draw":0},"round":"Round 2"}]},
          {"deck_id":"b","maindeck":[],"sideboard":[],"match_history":[
            {"opponent_deck_id":null,"result":"win","record":{"win":0,"loss":0,"draw":0},"round":"Round 1"},
            {"opponent_deck_id":"a","result":"loss","record":{"win":0,"loss":2,"draw":0},"round":"Round 2"}]}]}
    """)?;
    let Metagame { matches } = decode_metagame(met)?;
    assert(matches$first_before == [Record { loss: 1 }]);
    assert(matches$second_before == [some(Record { win: 1 })]);
    // A match against a deck the document does not have is bad data.
    let dangling = parse("""
        {"name":"m","tournament_ids":[],"decks":[
          {"deck_id":"a","maindeck":[],"sideboard":[],"match_history":[
            {"opponent_deck_id":"zz","result":"win","record":{"win":2,"loss":0,"draw":0},"round":"R1"}]}]}
    """)?;
    assert(decode_metagame(dangling) == err(unknown_deck("zz")));
})

# The metagame in the gzipped JSON file at `path`. The file is unpacked by
# `gzip`, since nothing here reads binary files or decompresses yet.
pub fn load_metagame(path: str) !execute_program -> Metagame!str {
    let ExecResult { stdout, stderr, exit_code } = "gzip".execute_program(args=["-dc", path])?;
    if (exit_code != 0) { return err(`gzip {path}: {stderr}`); };
    parse(stdout)?.decode_metagame()
}
