# A Magic: The Gathering metagame analyzer: how much of a tournament field each
# archetype is, and how well it does. A port of `mtg_metagame_stats`, grown one
# piece at a time.

import {
    drop_first,
    equal as ==,
    first,
    len,
    less_than as <,
    logical_and as &&,
    not_equal as !=,
    print,
    read_file_to_string,
    starts_with,
    value_or,
    value_or_err,
    wrapping_increment as ++,
    write_string_to_file,
} from builtins;
import { load_identifiers } from "./archetypes.aipl";
import { card_counts } from "./card_stats.aipl";
import { Counted } from "./counted.aipl";
import { optional_text_field } from "./json.aipl";
import { share_report } from "./meta_share.aipl";
import { Metagame, load_metagame } from "./metagame.aipl";
import { winrate_matrix } from "./winrate_matrix.aipl";
import { winrate_svg } from "./winrate_svg.aipl";
import { Json, parse } from json;

let USAGE = """
    usage: mtg_metagame cards <metagame>
           mtg_metagame share <metagame> [--archetypes <config>]
           mtg_metagame winrate <metagame> [--archetypes <config>] [--output <file.svg>]
""";

# The archetype list `share` uses when `--archetypes` is not given.
let DEFAULT_ARCHETYPES = "Standard2026Q4RC";

# The file in `data/` that `name` stands for: the file `index` maps it to, or
# `name` itself when the index does not know it.
fn data_path(index: Json, name: str) -> str {
    let target = index.optional_text_field(name).value_or(name);
    `data/{target}.json.gz`
}.test({
    let index = parse("""{"standard_26Q2_rc_japan": "metagame_410903"}""")?;
    assert(data_path(index, "standard_26Q2_rc_japan") == "data/metagame_410903.json.gz");
    assert(data_path(index, "metagame_1") == "data/metagame_1.json.gz");
})

# A card's line in the listing: its copies, then its name.
fn card_line(self: Counted) -> str { `{self.count} {self.name}` }.test({
    assert(Counted { name: "Island", count: 12 }.card_line() == "12 Island");
})

# The metagame `name` stands for, with `data/index.json` read to find it.
fn load_named(name: str) !read_files !execute_program -> Metagame!str {
    let index = parse(read_file_to_string("data/index.json")?)?;
    load_metagame(data_path(index, name))
}

# One line per card played in the metagame named by `args`, most played first.
fn cards_listing(args: str[]) !read_files !execute_program -> str[]!str {
    let [name] = args else { return err(USAGE); };
    let Metagame { decks } = load_named(name)?;
    ok(card_counts(decks)$card_line())
}

# What `share` or `winrate` was asked: the metagame, the archetype list to classify its decks with,
# and where `winrate` writes its page (`none` for the default, named after the metagame).
struct DeckOptions { metagame: str, archetypes: str, output: str? }

# The options of the command `command` in `args`: one metagame, `--archetypes <config>`, and for
# `winrate` `--output <file>`, in any order.
fn parse_deck_options(command: str, args: str[]) -> DeckOptions!str {
    mut metagame = "";
    mut archetypes = DEFAULT_ARCHETYPES;
    mut output: str? = none;
    mut i: u64 = 0;
    while (i < args.len()) {
        let arg = args[i].value_or("");
        if (arg == "--archetypes") {
            set i++;
            set archetypes = args[i].value_or_err("--archetypes needs the name of a list")?;
        } else if (arg == "--output" && command == "winrate") {
            set i++;
            set output = some(args[i].value_or_err("--output needs the name of a file")?);
        } else {
            if (arg.starts_with("--")) { return err(`unknown option "{arg}"`); };
            if (metagame != "") { return err(`unexpected argument "{arg}"`); };
            set metagame = arg;
        };
        set i++;
    }
    if (metagame == "") { return err(`{command} needs a metagame`); };
    ok(DeckOptions { metagame, archetypes, output })
}.test({
    assert(parse_deck_options("share", ["m"]) == ok(DeckOptions {
        metagame: "m",
        archetypes: "Standard2026Q4RC",
        output: none,
    }));
    assert(parse_deck_options("share", ["--archetypes", "Modern2026Q3RC", "m"]) == ok(DeckOptions {
        metagame: "m",
        archetypes: "Modern2026Q3RC",
        output: none,
    }));
    assert(parse_deck_options("winrate", ["m", "--output", "out.svg"]) == ok(DeckOptions {
        metagame: "m",
        archetypes: "Standard2026Q4RC",
        output: some("out.svg"),
    }));
    assert(parse_deck_options("winrate", ["m", "--output"]) == err(
        "--output needs the name of a file",
    ));
    assert(parse_deck_options("share", ["m", "--output", "x"]) == err(`unknown option "--output"`));
    assert(parse_deck_options("share", []) == err("share needs a metagame"));
    assert(parse_deck_options("winrate", []) == err("winrate needs a metagame"));
    assert(parse_deck_options("share", ["m", "n"]) == err(`unexpected argument "n"`));
    assert(parse_deck_options("share", ["m", "--jank"]) == err(`unknown option "--jank"`));
    assert(parse_deck_options("share", ["m", "--archetypes"]) == err(
        "--archetypes needs the name of a list",
    ));
})

# The share report for the metagame named by `args`, one line each.
fn share_listing(args: str[]) !read_files !execute_program -> str[]!str {
    let DeckOptions { metagame, archetypes } = parse_deck_options("share", args)?;
    let identifiers = load_identifiers("data/archetypes.json", archetypes)?;
    let Metagame { decks } = load_named(metagame)?;
    ok(share_report(metagame, decks, identifiers))
}

# Write the winrate matrix for the metagame named by `args` as an SVG page, to the file `--output`
# names or `winrate_<metagame>.svg`, and say where it went.
fn winrate_listing(args: str[]) !read_files !execute_program !write_files -> str[]!str {
    let DeckOptions { metagame, archetypes, output } = parse_deck_options("winrate", args)?;
    let identifiers = load_identifiers("data/archetypes.json", archetypes)?;
    let Metagame { decks, matches } = load_named(metagame)?;
    let path = output.value_or(`winrate_{metagame}.svg`);
    write_string_to_file(path, winrate_matrix(decks, matches, identifiers).winrate_svg(metagame))?;
    ok([`wrote {path}`])
}

# The lines a command line asks for, or why it asks for none.
fn run(args: str[]) !read_files !execute_program !write_files -> str[]!str {
    let some(command) = args.first() else { return err(USAGE); };
    let rest = args.drop_first();
    match (command) {
        "cards" => cards_listing(rest),
        "share" => share_listing(rest),
        "winrate" => winrate_listing(rest),
        _ => err(USAGE),
    }
}

# Run a command: `cards <metagame>` lists every card played, `share <metagame>` the share of
# the field each archetype is, `winrate <metagame>` writes an SVG page of how each archetype does against each other. The metagame is a file in `data/` (without its `.json.gz`), or
# one of the names in `data/index.json`.
fn main(args: str[]) !prints !read_files !execute_program !write_files -> i64 {
    match (run(args)) {
        ok(lines) => {
            for (let line : lines) {
                print(line);
            }
            0
        },
        err(message) => {
            print(`mtg_metagame: {message}`);
            1
        },
    }
}
