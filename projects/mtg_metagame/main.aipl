# A Magic: The Gathering metagame analyzer: how much of a tournament field each
# archetype is, and how well it does. A port of `mtg_metagame_stats`, grown one
# piece at a time.

import { Json, equal as ==, parse_json, print, read_file_to_string, value_or } from builtins;
import { CardCount, card_counts } from "./card_stats.aipl";
import { optional_text_field } from "./json.aipl";
import { Metagame, load_metagame } from "./metagame.aipl";

# The file in `data/` that `name` stands for: the file `index` maps it to, or
# `name` itself when the index does not know it.
fn data_path(index: Json, name: str) -> str {
    let target = index.optional_text_field(name).value_or(name);
    `data/{target}.json.gz`
}.test({
    let index = parse_json("""{"standard_26Q2_rc_japan": "metagame_410903"}""")?;
    assert(data_path(index, "standard_26Q2_rc_japan") == "data/metagame_410903.json.gz");
    assert(data_path(index, "metagame_1") == "data/metagame_1.json.gz");
})

# A card's line in the listing: its copies, then its name.
fn card_line(self: CardCount) -> str { `{self.count} {self.name}` }.test({
    assert(CardCount { name: "Island", count: 12 }.card_line() == "12 Island");
})

# One line per card played in the metagame `name` stands for, most played first.
fn listing(name: str) !read_files !execute_program -> str[]!str {
    let index = parse_json(read_file_to_string("data/index.json")?)?;
    let Metagame { decks } = load_metagame(data_path(index, name))?;
    ok(card_counts(decks)$card_line())
}

# Print every card played in the metagame named on the command line, with how
# many copies, most played first. The name is a file in `data/` (without its
# `.json.gz`), or one of the names in `data/index.json`.
fn main(args: str[]) !prints !read_files !execute_program -> i64 {
    let [name] = args else {
        print("usage: mtg_metagame <metagame>");
        return 1;
    };
    match (listing(name)) {
        ok(lines) => {
            for (let line : lines) {
                print(line);
            }
            0
        },
        err(message) => {
            print(`mtg_metagame: {message}`);
            1
        },
    }
}
