# A Magic: The Gathering metagame analyzer: how much of a tournament field each
# archetype is, and how well it does. A port of `mtg_metagame_stats`, grown one
# piece at a time.

import {
    equal as ==,
    greater_than as >,
    print,
    saturating_divide as /,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

# How one match ended, from a deck's point of view.
variant Result = Win | Loss | Draw

# Matches won, lost and drawn.
struct Record { win: u64, loss: u64, draw: u64 }

# `a` and `b` counted together.
fn add_records(a: Record, b: Record) -> Record {
    win: a.win + b.win,
    loss: a.loss + b.loss,
    draw: a.draw + b.draw,
}.test({
    assert(add_records(
        Record { win: 1, loss: 2, draw: 3 },
        Record { win: 10, loss: 20, draw: 30 },
    ) == Record { win: 11, loss: 22, draw: 33 });
})

# The record a single match result is worth.
fn record_of(self: Result) -> Record {
    match (self) {
        Win => Record { win: 1, loss: 0, draw: 0 },
        Loss => Record { win: 0, loss: 1, draw: 0 },
        Draw => Record { win: 0, loss: 0, draw: 1 },
    }
}.test({
    assert(Win.record_of() == Record { win: 1, loss: 0, draw: 0 });
    assert(Draw.record_of() == Record { win: 0, loss: 0, draw: 1 });
})

# The win rate of `self` in tenths of a percent (so 0.5 is 500), or `none` when
# there is no decided match. Draws are left out of the denominator. Whole numbers
# stand in for the original's floats until the language has them.
fn winrate_permille(self: Record) -> u64? {
    let decided = self.win + self.loss;
    if (decided > 0) { some(self.win * 1000 / decided) } else { none }
}.test({
    assert(Record { win: 0, loss: 0, draw: 4 }.winrate_permille() == none);
    assert(Record { win: 1, loss: 1, draw: 0 }.winrate_permille() == some(500));
    assert(Record { win: 2, loss: 1, draw: 9 }.winrate_permille() == some(666));
})

fn main() !prints {
    print("mtg_metagame: nothing to analyze yet\n");
}
