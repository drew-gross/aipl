# Where a round falls in its tournament, counted back from the end. A tournament of nine rounds and
# one of fifteen differ in their first rounds but not in their last, so rounds are compared by how
# far they are from the finals: the finals, the semifinals and the quarterfinals first, then the last
# round of the main event, the one before it, and so on. A round's *slot* is that place, counted
# from 0 for the finals.

import {
    distinct,
    equal as ==,
    get,
    greater_than as >,
    int_parse,
    less_than as <,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    max,
    saturating_remainder as %,
    split,
    to_dict,
    wrapping_add as +,
    wrapping_sub as -,
} from builtins;
import { Match, Record, Win } from "./metagame.aipl";

# The slots of the playoff rounds, finals first.
let FINALS: u64 = 0;

let SEMIFINALS: u64 = 1;

let QUARTERFINALS: u64 = 2;

# The slot of the last round of the main event, which the rounds before it follow.
let LAST_ROUND: u64 = 3;

# The number in a round labelled `Round 7`, or `none` for any other label.
pub fn round_number(self: str) -> u64? {
    let [word, number] = self.split(" ") else { return none; };
    if (word == "Round") { number.int_parse() } else { none }
}.test({
    assert(round_number("Round 7") == some(7));
    assert(round_number("Round 12") == some(12));
    assert(round_number("Finals") == none);
    assert(round_number("Round x") == none);
    assert(round_number("Round 1 2") == none);
    assert(round_number("") == none);
})

# The number of the last round of the main event of the tournament `tournament`: the highest
# `Round N` any match of it has, or 0 when none has.
fn last_round(self: Match[], tournament: str) -> u64 {
    mut last: u64 = 0;
    for (let each : self) {
        if (each.tournament == tournament) {
            if (let some(number) = each.round.round_number()) { set last = max(last, number); };
        };
    }
    last
}.test({
    let played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        first_before: Record {},
        record: Record {},
        result: Win,
    };
    let matches = [
        Match { ..played, tournament: "x", round: "Round 1" },
        Match { ..played, tournament: "x", round: "Round 9" },
        Match { ..played, tournament: "x", round: "Finals" },
        Match { ..played, tournament: "y", round: "Round 3" },
    ];
    assert(matches.last_round("x") == 9);
    assert(matches.last_round("y") == 3);
    assert(matches.last_round("z") == 0);
})

# The number of the last round of the main event, for each tournament of `self`.
pub fn last_rounds(self: Match[]) -> #{str: u64} {
    let tournaments = self$tournament.distinct();
    tournaments.map(|tournament| (tournament, self.last_round(tournament))).to_dict()
}.test({
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "x",
        result: Win,
        round: "Round 4",
        first_before: Record {},
        record: Record {},
    };
    let other = Match { ..match_played, tournament: "y", round: "Round 2" };
    let last = last_rounds([match_played, other, Match { ..match_played, round: "Round 1" }]);
    assert(last.get("x") == some(4));
    assert(last.get("y") == some(2));
    assert(last.get("z") == none);
})

# How many slots a metagame whose tournaments' last rounds are `last_rounds` has: the three playoff
# rounds and as many rounds before them as its longest tournament had.
pub fn slot_count(last_rounds: #{str: u64}) -> u64 {
    mut longest: u64 = 0;
    for (let tournament, last : last_rounds) {
        set longest = max(longest, last);
    }
    LAST_ROUND + longest
}.test({
    assert(slot_count(#{"x": 9, "y": 7}) == 12);
    assert(slot_count(#{"x": 0}) == 3);
})

# The slot of `self`, given the last round of each tournament, or `none` for a round that is neither
# a playoff round nor a numbered one of a tournament that has them.
pub fn slot_of(self: Match, last_rounds: #{str: u64}) -> u64? {
    if (self.round == "Finals") { return some(FINALS); };
    if (self.round == "Semifinals") { return some(SEMIFINALS); };
    if (self.round == "Quarterfinals") { return some(QUARTERFINALS); };
    let some(number) = self.round.round_number() else { return none; };
    let some(last) = last_rounds.get(self.tournament) else { return none; };
    if (last < number) { return none; };
    some(LAST_ROUND + last - number)
}.test({
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "x",
        result: Win,
        round: "Finals",
        first_before: Record {},
        record: Record {},
    };
    let last: #{str: u64} = #{"x": 9};
    assert(match_played.slot_of(last) == some(0));
    assert(Match { ..match_played, round: "Semifinals" }.slot_of(last) == some(1));
    assert(Match { ..match_played, round: "Quarterfinals" }.slot_of(last) == some(2));
    // The last round of the main event, and the ones before it.
    assert(Match { ..match_played, round: "Round 9" }.slot_of(last) == some(3));
    assert(Match { ..match_played, round: "Round 8" }.slot_of(last) == some(4));
    assert(Match { ..match_played, round: "Round 1" }.slot_of(last) == some(11));
    // A tournament of fifteen rounds has its round 9 further from the end.
    assert(Match { ..match_played, tournament: "y", round: "Round 9" }.slot_of(#{"y": 15}) == some(
        9,
    ));
    assert(Match { ..match_played, round: "Round 10" }.slot_of(last) == none);
    assert(Match { ..match_played, round: "Top 8" }.slot_of(last) == none);
    assert(Match { ..match_played, tournament: "z", round: "Round 1" }.slot_of(last) == none);
})

# `n` with its ordinal suffix: `2nd`, `11th`, `23rd`.
fn ordinal(n: u64) -> str {
    let suffix = if (n % 100 > 10 && n % 100 < 14) {
        "th"
    } else if (n % 10 == 1) {
        "st"
    } else if (n % 10 == 2) {
        "nd"
    } else if (n % 10 == 3) {
        "rd"
    } else {
        "th"
    };
    `{n}{suffix}`
}.test({
    assert(ordinal(1) == "1st");
    assert(ordinal(2) == "2nd");
    assert(ordinal(3) == "3rd");
    assert(ordinal(4) == "4th");
    assert(ordinal(11) == "11th");
    assert(ordinal(12) == "12th");
    assert(ordinal(13) == "13th");
    assert(ordinal(21) == "21st");
    assert(ordinal(112) == "112th");
})

# What a table calls the slot `self`: `Finals`, `Semifinals`, `Quarterfinals`, `Last round`,
# `2nd last round` and so on.
pub fn slot_label(self: u64) -> str {
    if (self == FINALS) { return "Finals"; };
    if (self == SEMIFINALS) { return "Semifinals"; };
    if (self == QUARTERFINALS) { return "Quarterfinals"; };
    let before = self - LAST_ROUND;
    if (before == 0) { "Last round" } else { `{ordinal(before + 1)} last round` }
}.test({
    assert(slot_label(0) == "Finals");
    assert(slot_label(1) == "Semifinals");
    assert(slot_label(2) == "Quarterfinals");
    assert(slot_label(3) == "Last round");
    assert(slot_label(4) == "2nd last round");
    assert(slot_label(5) == "3rd last round");
    assert(slot_label(13) == "11th last round");
})

# The wins and losses a player had going into a round of the main event, draws left out: `7-1`.
struct Bracket { win: i64, loss: i64 }

# `self` as written: `7-1`.
pub fn bracket_text(self: Bracket) -> str { `{self.win}-{self.loss}` }.test({
    assert(Bracket { win: 7, loss: 1 }.bracket_text() == "7-1");
})

# Whether a table lists `self` above `other`: the bracket with more wins, and of two with as many
# the one with fewer losses.
pub fn is_above(self: Bracket, other: Bracket) -> bool {
    self.win > other.win || (self.win == other.win && self.loss < other.loss)
}.test({
    assert(Bracket { win: 7, loss: 1 }.is_above(Bracket { win: 0, loss: 3 }));
    assert(!Bracket { win: 0, loss: 3 }.is_above(Bracket { win: 7, loss: 1 }));
    assert(Bracket { win: 3, loss: 0 }.is_above(Bracket { win: 3, loss: 1 }));
    assert(!Bracket { win: 3, loss: 1 }.is_above(Bracket { win: 3, loss: 1 }));
})

# The bracket of a player who had `before` going into `self`, or `none` when `self` is not a
# numbered round of the main event: a playoff round has no bracket.
fn bracket_in(self: Match, Record { win, loss }) -> Bracket? {
    if (self.round.round_number() == none) { return none; };
    some(Bracket { win, loss })
}.test({
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "x",
        result: Win,
        round: "Round 4",
        first_before: Record {},
        record: Record {},
    };
    let before = Record { win: 2, loss: 1, draw: 1 };
    assert(match_played.bracket_in(before) == some(Bracket { win: 2, loss: 1 }));
    assert(Match { ..match_played, round: "Finals" }.bracket_in(before) == none);
})

# The bracket of the first deck of `self`, going into it.
pub fn first_bracket(self: Match) -> Bracket? { self.bracket_in(self.first_before) }.test({
    let match_played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "x",
        first_before: Record { win: 3, loss: 1 },
        second_before: some(Record { win: 1, loss: 3, draw: 2 }),
        result: Win,
        round: "Round 5",
        record: Record {},
    };
    assert(match_played.first_bracket() == some(Bracket { win: 3, loss: 1 }));
    assert(match_played.second_bracket() == some(Bracket { win: 1, loss: 3 }));
    assert(Match { ..match_played, second_before: none }.second_bracket() == none);
})

# The bracket of the second deck of `self`, going into it, if its own history has the round.
pub fn second_bracket(self: Match) -> Bracket? {
    let some(before) = self.second_before else { return none; };
    self.bracket_in(before)
}
