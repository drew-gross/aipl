# Which archetypes a deck is. The original decides it from a list of identifiers per
# format and season, each naming cards the deck must hold, must not hold, or must hold
# one of; `data/archetypes.json` has those lists (see `tools/archetypes_to_json.py`).
# A deck matches the identifiers of at most one name, and is that archetype.

import {
    all,
    any,
    equal as ==,
    filter,
    is_empty,
    join,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    read_file_to_string,
    try_map,
    value_or,
    value_or_err,
} from builtins;
import { keys, list_field, scalar_text, text_field } from "./json.aipl";
import { Card, Deck } from "./metagame.aipl";
import { Json, parse } from json;
import { has, to_array, to_set, union } from sets;

# What it takes for a deck to be an archetype, as its identifier in the original wrote it.
# `cards` must all be in the main deck or the sideboard, none of `not_cards` may be, one of
# `any_cards` must be if there are any, and `maindeck_cards` must all be in the main deck. An
# identifier that asks for nothing matches every deck, as it does there.
struct Identifier {
    name: str,
    cards: str[],
    not_cards: str[] = [],
    any_cards: str[] = [],
    maindeck_cards: str[] = [],
}

# The names of the cards a deck holds: in its main deck, and in its main deck or sideboard.
struct Holdings { main: #{str}, held: #{str} }

# The cards `self` holds, by name.
fn holdings(self: Deck) -> Holdings {
    let main = self.maindeck$name.to_set();
    let side = self.sideboard$name.to_set();
    Holdings { main, held: main.union(side) }
}.test({
    let deck = Deck {
        deck_id: "d",
        maindeck: [Card { name: "Island" }],
        sideboard: [Card { name: "Swamp" }],
    };
    let Holdings { main, held } = deck.holdings();
    assert(main.has("Island"));
    assert(!main.has("Swamp"));
    assert(held.has("Island") && held.has("Swamp"));
})

# Whether a deck with `Holdings { main, held }` is the archetype `self`.
fn matches(self: Identifier, Holdings { main, held }) -> bool {
    self.cards.all(|c| held.has(c)) && !self.not_cards.any(|c| held.has(
        c,
    )) && self.maindeck_cards.all(|c| main.has(
        c,
    )) && (self.any_cards.is_empty() || self.any_cards.any(|c| held.has(c)))
}.test({
    let deck = Deck {
        deck_id: "d",
        maindeck: [Card { name: "Island" }, Card { name: "Bolt" }],
        sideboard: [Card { name: "Negate" }],
    }.holdings();

    // `cards` may be in either part; `maindeck_cards` only in the main deck.
    assert(Identifier { name: "x", cards: ["Island", "Negate"] }.matches(deck));
    assert(!Identifier { name: "x", cards: ["Island", "Duress"] }.matches(deck));
    assert(Identifier { name: "x", cards: [], maindeck_cards: ["Bolt"] }.matches(deck));
    assert(!Identifier { name: "x", cards: [], maindeck_cards: ["Negate"] }.matches(deck));

    // A card named in `not_cards` rules the deck out, wherever it is.
    assert(!Identifier { name: "x", cards: ["Island"], not_cards: ["Negate"] }.matches(deck));
    assert(Identifier { name: "x", cards: ["Island"], not_cards: ["Duress"] }.matches(deck));

    // One of `any_cards`, when there are some.
    assert(Identifier { name: "x", cards: [], any_cards: ["Duress", "Bolt"] }.matches(deck));
    assert(!Identifier { name: "x", cards: [], any_cards: ["Duress", "Thoughtseize"] }.matches(
        deck,
    ));

    // Asking for nothing matches everything.
    assert(Identifier { name: "x", cards: [] }.matches(deck));
})

# An archetype a deck is: one an identifier names (`Meta`), or, when none did, `Other`, carrying
# the deck's own name. Every `Other` deck is one category of the format's decks that are none
# of its archetypes; the name is what the deck was called.
variant Archetype = Meta(name: str) | Other(name: str)

# How `self` reads in a report.
pub fn label(self: Archetype) -> str {
    match (self) {
        Meta(name) => name,
        Other(..) => "Other",
    }
}.test({
    assert(Meta("Landfall").label() == "Landfall");
    // However the deck was called, it is `Other` in a report.
    assert(Other("Some Deck").label() == "Other");
})

# The archetype `self` is: the one identifier in `identifiers` it matches, by name. A deck that
# matches none is `Other`, under its own name, and one that matches identifiers of more than one
# name is an error naming them, since a deck is one archetype.
pub fn archetype_of(self: Deck, identifiers: Identifier[]) -> Archetype!str {
    let deck_holdings = self.holdings();
    let found: #<{str} = identifiers.filter(|i| i.matches(deck_holdings))$name.to_set();
    let names = found.to_array();
    match (names) {
        [] => ok(Other(self.name)),
        [name] => ok(Meta(name)),
        _ => err(
            `deck {self.deck_id} ({self.name}) is more than one archetype: {names.join(sep=", ")}`,
        ),
    }
}.test({
    let landfall = Identifier { name: "Landfall", cards: ["Forest"], not_cards: ["Island"] };
    let control = Identifier { name: "Control", cards: ["Island"] };
    let identifiers = [landfall, control];

    assert(Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] }.archetype_of(
        identifiers,
    ) == ok(Meta("Landfall")));
    assert(Deck { deck_id: "d", maindeck: [Card { name: "Island" }] }.archetype_of(
        identifiers,
    ) == ok(Meta("Control")));

    // Matching twice under one name is still one archetype.
    assert(Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] }.archetype_of([
        landfall,
        landfall,
    ]) == ok(Meta("Landfall")));

    // None: `Other`, with the deck's own name.
    assert(Deck {
        deck_id: "d",
        name: "Some Deck",
        maindeck: [Card { name: "Swamp" }],
    }.archetype_of(identifiers) == ok(Other("Some Deck")));

    // More than one name is an error, naming the deck and the archetypes in name order.
    assert(Deck {
        deck_id: "d1",
        name: "Ramp",
        maindeck: [Card { name: "Forest" }, Card { name: "Island" }],
    }.archetype_of([
        landfall,
        control,
        Identifier { name: "Both", cards: ["Forest", "Island"] },
    ]) == err("deck d1 (Ramp) is more than one archetype: Both, Control"));
})

# `self` as an identifier.
fn decode_identifier(self: Json) -> Identifier!str {
    ok(Identifier {
        name: self.text_field("name")?,
        cards: self.string_list("cards")?,
        not_cards: self.string_list("not_cards")?,
        any_cards: self.string_list("any_cards")?,
        maindeck_cards: self.string_list("maindeck_cards")?,
    })
}.test({
    let json = parse("""
        {"name":"Landfall","cards":["Forest"],"not_cards":[],"any_cards":["A","B"],
         "maindeck_cards":["Earthbender Ascension"]}
    """)?;
    assert(decode_identifier(json) == ok(Identifier {
        name: "Landfall",
        cards: ["Forest"],
        any_cards: ["A", "B"],
        maindeck_cards: ["Earthbender Ascension"],
    }));
    let bad = parse("""{"name":"X","cards":[null]}""")?;
    assert(decode_identifier(bad) == err(`"cards" holds something that is not text`));
})

# The text of each element of the list under `key`, or why there is none.
fn string_list(self: Json, key: str) -> str[]!str {
    self
        .list_field(key)?
        .try_map(|item| {
            item.scalar_text().value_or_err(`"{key}" holds something that is not text`)
        })
}.test({
    let json = parse("""{"names":["a","b"],"mixed":["a",null],"n":3}""")?;
    assert(json.string_list("names") == ok(["a", "b"]));
    assert(json.string_list("mixed") == err(`"mixed" holds something that is not text`));
    assert(json.string_list("n") == err(`"n" is not a list`));
    assert(json.string_list("q") == err(`missing "q"`));
})

# The identifiers `config` names in the file `path` of them, or why there are none.
pub fn load_identifiers(path: str, config: str) !read_files -> Identifier[]!str {
    let all_configs = parse(read_file_to_string(path)?)?;
    let found = all_configs.list_field(config);
    if (let err(..) = found) {
        let names = all_configs.keys().value_or([]);
        return err(
            `no archetype config named "{config}"; the ones there are: {names.join(sep=", ")}`,
        );
    };
    found?.try_map(decode_identifier)
}.test({
    let file = """
        {"First":[{"name":"A","cards":["X"],"not_cards":[],"any_cards":[],"maindeck_cards":[]}],
         "Second":[]}
    """;
    shim read_files { read_file_to_string = |path| { ok(file) } } {
        let first = load_identifiers("archetypes.json", "First")?;
        assert(first$name == ["A"]);
        assert(load_identifiers("archetypes.json", "Second")? == []);
        assert(load_identifiers("archetypes.json", "Third") == err(
            `no archetype config named "Third"; the ones there are: First, Second`,
        ));
    };
})
