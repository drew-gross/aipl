# How much of a tournament field each archetype is. A deck is one archetype, so the shares add up
# to the whole field.

import {
    count_if,
    distinct,
    equal as ==,
    filter,
    float_div as /,
    float_mul as *,
    is_case,
    less_than as <,
    map,
    render,
    to_float,
    try_map,
} from builtins;
import { Identifier, Meta, Other, archetype_of, label } from "./archetypes.aipl";
import { Counted, ranked } from "./counted.aipl";
import { Card, Deck } from "./metagame.aipl";

# The decks of each archetype, most decks first, then the decks that are none of `identifiers`
# as one `Other` row at the end, whatever its count (and not at all when there are none).
# The `Other` decks are counted together whatever they are called.
pub fn shares(decks: Deck[], identifiers: Identifier[]) -> Counted[]!str {
    let found = decks.try_map(|deck| deck.archetype_of(identifiers))?;
    let named = found
        .distinct()
        .filter(|archetype| archetype.is_case::<Meta>())
        .map(|archetype| {
            Counted { name: archetype.label(), count: found.count_if(|each| each == archetype) }
        })
        .ranked();
    let others = found.count_if(|each| each.is_case::<Other>());
    ok(if (0 < others) { [..named, Counted { name: "Other", count: others }] } else { named })
}.test({
    let landfall = Identifier { name: "Landfall", cards: ["Forest"], not_cards: ["Island"] };
    let mono = Identifier { name: "Mono-G", cards: ["Forest", "Island"] };
    let decks = [
        Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Forest" }, Card { name: "Island" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Swamp" }] },
    ];

    // Each archetype once per deck, most decks first, and the decks that are none of them as
    // one `Other` row last.
    assert(shares(decks, [landfall, mono]) == ok([
        Counted { name: "Landfall", count: 2 },
        Counted { name: "Mono-G", count: 1 },
        Counted { name: "Other", count: 1 },
    ]));

    // `Other` stays last when it is the largest, and decks with different names are one row.
    let many = [
        Deck { deck_id: "d", name: "Dredge", maindeck: [Card { name: "Swamp" }] },
        Deck { deck_id: "d", name: "Elves", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "d", name: "Burn", maindeck: [Card { name: "Mountain" }] },
        Deck { deck_id: "d", name: "Control", maindeck: [Card { name: "Island" }] },
    ];
    assert(shares(many, [landfall]) == ok([
        Counted { name: "Landfall", count: 1 },
        Counted { name: "Other", count: 3 },
    ]));

    // No decks, or no deck that is none of them: no `Other` row.
    assert(shares([], [landfall]) == ok([]));
    assert(shares([Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] }], [landfall]) == ok([
        Counted { name: "Landfall", count: 1 },
    ]));

    // A deck that is two archetypes is an error, not a count in each.
    assert(shares(decks, [landfall, Identifier { name: "Forest", cards: ["Forest"] }]) == err(
        "deck d () is more than one archetype: Forest, Landfall",
    ));

    // `Other` is told from an archetype by its case, not by what it is called: an archetype
    // an identifier names "Other" is a `Meta` one, ranked with the rest, and the two stay two.
    let named_other = Identifier { ..landfall, name: "Other" };
    let both = [
        Deck { deck_id: "d", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Swamp" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Swamp" }] },
    ];
    assert(shares(both, [named_other]) == ok([
        Counted { name: "Other", count: 1 },
        Counted { name: "Other", count: 2 },
    ]));
})

# `count` out of `total` as a percentage of two significant digits: `33%`, `6.2%`,
# `0.50%`. Rounded half to even on the float's exact value.
pub fn percent(count: u64, total: u64) -> str {
    let share = count.to_float() / total.to_float();
    `{(share * 100.0).render(significant=2)}%`
}.test({
    assert(percent(1, 3) == "33%");
    assert(percent(2, 3) == "67%");
    assert(percent(1, 2) == "50%");
    assert(percent(0, 7) == "0%");
    assert(percent(7, 7) == "100%");
    // An exact half goes to the even digit.
    assert(percent(1, 8) == "12%");
    assert(percent(7, 8) == "88%");
    assert(percent(1, 16) == "6.2%");
    assert(percent(3, 16) == "19%");
    // Two significant digits however small.
    assert(percent(1, 200) == "0.50%");
    assert(percent(3, 2000) == "0.15%");
})
