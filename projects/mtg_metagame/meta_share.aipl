# The metagame share report: how much of a tournament field each archetype is. A deck
# counts toward every archetype it matches, so the shares can add up to more than all.

import {
    any,
    count_if,
    equal as ==,
    float_div as /,
    float_mul as *,
    join,
    len,
    logical_not as !,
    map,
    max,
    push,
    render,
    repeat,
    saturating_sub as -,
    to_float,
    value_or,
    wrapping_add as +,
} from builtins;
import {
    Archetype,
    Identifier,
    Meta,
    Other,
    archetypes_of,
    deck_of,
    label,
} from "./archetypes.aipl";
import { Counted, ranked } from "./counted.aipl";
import { Deck } from "./metagame.aipl";

# The decks of each archetype, most decks first. A deck that is none of `identifiers` is an
# `Other` archetype of its own, and counts like the rest.
pub fn shares(decks: Deck[], identifiers: Identifier[]) -> Counted[] {
    let found = decks$archetypes_of(identifiers).join();
    found
        .distinct()
        .map(|archetype| {
            Counted { name: archetype.label(), count: found.count_if(|each| each == archetype) }
        })
        .ranked()
}.test({
    let nothing: str[] = [];
    let landfall = Identifier {
        name: "Landfall",
        cards: ["Forest"],
        not_cards: nothing,
        any_cards: nothing,
        maindeck_cards: nothing,
    };
    let mono = Identifier { ..landfall, name: "Mono-G", not_cards: ["Island"] };
    let decks = [
        deck_of(["Forest"], []),
        deck_of(["Forest", "Island"], []),
        deck_of(["Forest"], []),
        deck_of(["Swamp"], []),
    ];

    // Each archetype once per deck, most decks first. The deck that is neither is its own
    // archetype, an `Other`, and is listed with the rest.
    assert(shares(decks, [landfall, mono]) == [
        Counted { name: "Landfall", count: 3 },
        Counted { name: "Mono-G", count: 2 },
        Counted { name: "Some Deck (self-titled)", count: 1 },
    ]);
    assert(shares([], [landfall]) == []);

    // An `Other` is told from an archetype by its case, not by what it is called: an
    // archetype an identifier names "(self-titled)" is still a `Meta` one, and the two stay two.
    let odd = Identifier { ..landfall, name: "Some Deck (self-titled)" };
    let both = [deck_of(["Forest"], []), deck_of(["Swamp"], [])];
    assert(shares(both, [odd]) == [
        Counted { name: "Some Deck (self-titled)", count: 1 },
        Counted { name: "Some Deck (self-titled)", count: 1 },
    ]);
})

# `self` without its repeats, in the order each first appears.
fn distinct(self: Archetype[]) -> Archetype[] {
    mut seen: Archetype[] = [];
    for (let archetype : self) {
        if (!seen.any(|each| each == archetype)) { set seen.push(archetype); };
    }
    seen
}.test({
    assert([Meta("a"), Other("a"), Meta("a"), Meta("b"), Other("a")].distinct() == [
        Meta("a"),
        Other("a"),
        Meta("b"),
    ]);
    let nothing: Archetype[] = [];
    assert(nothing.distinct() == []);
})

# `count` out of `total` as a percentage with one decimal: `33.3%`. Rounded as the
# original's formatting is, half to even on the float's exact value.
fn percent(count: u64, total: u64) -> str {
    let share = count.to_float() / total.to_float();
    `{(share * 100.0).render(digits=1)}%`
}.test({
    assert(percent(1, 3) == "33.3%");
    assert(percent(2, 3) == "66.7%");
    assert(percent(1, 2) == "50.0%");
    assert(percent(0, 7) == "0.0%");
    assert(percent(7, 7) == "100.0%");
    assert(percent(1, 8) == "12.5%");
    // An exact half goes to the even digit, as it does there.
    assert(percent(1, 16) == "6.2%");
    assert(percent(3, 16) == "18.8%");
    // Under a percent, and 0.15 is a little under what it reads as.
    assert(percent(1, 200) == "0.5%");
    assert(percent(3, 2000) == "0.1%");
})

# `text` padded with spaces to `width`: on the left when `right`, else on the right.
fn padded(text: str, width: u64, right: bool) -> str {
    let gap = " ".repeat(width - text.len());
    if (right) { `{gap}{text}` } else { `{text}{gap}` }
}.test({
    assert(padded("ab", 5, false) == "ab   ");
    assert(padded("ab", 5, true) == "   ab");
    assert(padded("abcdef", 3, false) == "abcdef");
    assert(padded("", 2, true) == "  ");
})

# A table as lines, in the grid style `tabulate` draws: a rule above, between the header
# and the rows, and below, each cell padded to its column, the columns in `right` aligned
# to the right.
pub fn grid(headers: str[], rows: str[][], right: bool[]) -> str[] {
    mut widths: u64[] = [];
    for (let i, header : headers) {
        mut width = header.len();
        for (let row : rows) {
            set width = max(width, row[i].value_or("").len());
        }
        set widths.push(width);
    }
    mut lines = [rule(widths, "-"), cells_line(headers, widths, right), rule(widths, "=")];
    for (let row : rows) {
        set lines.push(cells_line(row, widths, right));
    }
    set lines.push(rule(widths, "-"));
    lines
}.test({
    assert(grid(["Name", "N"], [["ab", "1"], ["c", "10"]], [false, true]) == [
        "+------+----+",
        "| Name |  N |",
        "+======+====+",
        "| ab   |  1 |",
        "| c    | 10 |",
        "+------+----+",
    ]);
    // No rows: just the header.
    assert(grid(["X"], [], [false]) == ["+---+", "| X |", "+===+", "+---+"]);
})

# The line of `fill` characters over each column of `widths`, joined by `+`.
fn rule(widths: u64[], fill: str) -> str {
    let spans = widths.map(|w| { fill.repeat(w + 2) });
    `+{spans.join(sep="+")}+`
}

# One row's line: each cell padded to its column's width, between `|`s.
fn cells_line(cells: str[], widths: u64[], right: bool[]) -> str {
    mut parts: str[] = [];
    for (let i, cell : cells) {
        set parts.push(padded(cell, widths[i].value_or(0), right[i].value_or(false)));
    }
    `| {parts.join(sep=" | ")} |`
}

# The report on `decks`, loaded from the metagame `name`, as lines.
pub fn share_report(name: str, decks: Deck[], identifiers: Identifier[]) -> str[] {
    let total = decks.len();
    let rows = shares(decks, identifiers).map(|share| {
        [share.name, percent(share.count, total), `{share.count}`]
    });
    [
        `Metagame Breakdown from {name}`,
        "Order by Metagame %",
        ..grid(["Deck Name", "Metagame %", "Count"], rows, [false, true, true]),
    ]
}.test({
    let nothing: str[] = [];
    let landfall = Identifier {
        name: "Landfall",
        cards: ["Forest"],
        not_cards: nothing,
        any_cards: nothing,
        maindeck_cards: nothing,
    };
    let decks = [deck_of(["Forest"], []), deck_of(["Swamp"], []), deck_of(["Forest"], [])];
    // Shares are of all the decks, the `Other` ones listed too.
    assert(share_report("a_meta", decks, [landfall]) == [
        "Metagame Breakdown from a_meta",
        "Order by Metagame %",
        "+-------------------------+------------+-------+",
        "| Deck Name               | Metagame % | Count |",
        "+=========================+============+=======+",
        "| Landfall                |      66.7% |     2 |",
        "| Some Deck (self-titled) |      33.3% |     1 |",
        "+-------------------------+------------+-------+",
    ]);
})
