# The metagame share report: how much of a tournament field each archetype is. A deck
# counts toward every archetype it matches, so the shares can add up to more than all.

import {
    count_if,
    distinct,
    equal as ==,
    filter,
    float_div as /,
    float_mul as *,
    is_case,
    join,
    len,
    less_than as <,
    map,
    render,
    tabulate,
    to_float,
} from builtins;
import { Identifier, Meta, Other, archetypes_of, deck_of, label } from "./archetypes.aipl";
import { Counted, ranked } from "./counted.aipl";
import { Deck } from "./metagame.aipl";

# The decks of each archetype, most decks first, then the decks that are none of `identifiers`
# as one `Other` row at the end, whatever its count (and not at all when there are none).
# The `Other` decks are counted together whatever they are called.
pub fn shares(decks: Deck[], identifiers: Identifier[]) -> Counted[] {
    let found = decks$archetypes_of(identifiers).join();
    let named = found
        .distinct()
        .filter(|archetype| archetype.is_case(Meta))
        .map(|archetype| {
            Counted { name: archetype.label(), count: found.count_if(|each| each == archetype) }
        })
        .ranked();
    let others = found.count_if(|each| each.is_case(Other));
    if (0 < others) { [..named, Counted { name: "Other", count: others }] } else { named }
}.test({
    let nothing: str[] = [];
    let landfall = Identifier {
        name: "Landfall",
        cards: ["Forest"],
        not_cards: nothing,
        any_cards: nothing,
        maindeck_cards: nothing,
    };
    let mono = Identifier { ..landfall, name: "Mono-G", not_cards: ["Island"] };
    let decks = [
        deck_of(["Forest"], []),
        deck_of(["Forest", "Island"], []),
        deck_of(["Forest"], []),
        deck_of(["Swamp"], []),
    ];

    // Each archetype once per deck, most decks first, and the decks that are none of them as
    // one `Other` row last.
    assert(shares(decks, [landfall, mono]) == [
        Counted { name: "Landfall", count: 3 },
        Counted { name: "Mono-G", count: 2 },
        Counted { name: "Other", count: 1 },
    ]);

    // `Other` stays last when it is the largest, and decks with different names are one row.
    let many = [
        deck_of(["Swamp"], []),
        deck_of(["Forest"], []),
        deck_of(["Mountain"], []),
        deck_of(["Island"], []),
    ];
    assert(shares(many, [landfall]) == [
        Counted { name: "Landfall", count: 1 },
        Counted { name: "Other", count: 3 },
    ]);

    // No decks, or no deck that is none of them: no `Other` row.
    assert(shares([], [landfall]) == []);
    assert(shares([deck_of(["Forest"], [])], [landfall]) == [
        Counted { name: "Landfall", count: 1 },
    ]);

    // `Other` is told from an archetype by its case, not by what it is called: an archetype
    // an identifier names "Other" is a `Meta` one, ranked with the rest, and the two stay two.
    let named_other = Identifier { ..landfall, name: "Other" };
    let both = [deck_of(["Forest"], []), deck_of(["Swamp"], []), deck_of(["Swamp"], [])];
    assert(shares(both, [named_other]) == [
        Counted { name: "Other", count: 1 },
        Counted { name: "Other", count: 2 },
    ]);
})

# `count` out of `total` as a percentage with one decimal: `33.3%`. Rounded as the
# original's formatting is, half to even on the float's exact value.
fn percent(count: u64, total: u64) -> str {
    let share = count.to_float() / total.to_float();
    `{(share * 100.0).render(digits=1)}%`
}.test({
    assert(percent(1, 3) == "33.3%");
    assert(percent(2, 3) == "66.7%");
    assert(percent(1, 2) == "50.0%");
    assert(percent(0, 7) == "0.0%");
    assert(percent(7, 7) == "100.0%");
    assert(percent(1, 8) == "12.5%");
    // An exact half goes to the even digit, as it does there.
    assert(percent(1, 16) == "6.2%");
    assert(percent(3, 16) == "18.8%");
    // Under a percent, and 0.15 is a little under what it reads as.
    assert(percent(1, 200) == "0.5%");
    assert(percent(3, 2000) == "0.1%");
})

# The report on `decks`, loaded from the metagame `name`, as lines.
pub fn share_report(name: str, decks: Deck[], identifiers: Identifier[]) -> str[] {
    let total = decks.len();
    let rows = shares(decks, identifiers).map(|share| {
        [share.name, percent(share.count, total), `{share.count}`]
    });
    [
        `Metagame Breakdown from {name}`,
        "Order by Metagame %",
        ..rows.tabulate(["Deck Name", "Metagame %", "Count"], right_aligned=[false, true, true]),
    ]
}.test({
    let nothing: str[] = [];
    let landfall = Identifier {
        name: "Landfall",
        cards: ["Forest"],
        not_cards: nothing,
        any_cards: nothing,
        maindeck_cards: nothing,
    };
    let decks = [deck_of(["Forest"], []), deck_of(["Swamp"], []), deck_of(["Forest"], [])];
    // Shares are of all the decks, and the `Other` decks are one row at the end.
    assert(share_report("a_meta", decks, [landfall]) == [
        "Metagame Breakdown from a_meta",
        "Order by Metagame %",
        "+-----------+------------+-------+",
        "| Deck Name | Metagame % | Count |",
        "+===========+============+=======+",
        "| Landfall  |      66.7% |     2 |",
        "| Other     |      33.3% |     1 |",
        "+-----------+------------+-------+",
    ]);
})
