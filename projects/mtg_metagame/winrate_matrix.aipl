# The winrate matrix: how each archetype fares against each other one. A deck counts in every
# archetype it matches, so a match is held against every pairing of one deck's archetypes and
# the other's, from each deck's side.

import {
    IEEE754Float64 as Float,
    distinct,
    equal as ==,
    filter,
    float_div as /,
    float_mul as *,
    get,
    map,
    push,
    render,
    to_dict,
} from builtins;
import { Identifier, archetypes_of, deck_of, label } from "./archetypes.aipl";
import { shares } from "./meta_share.aipl";
import {
    Deck,
    Draw,
    Loss,
    Match,
    Record,
    Result,
    Win,
    add_records,
    win_rate,
} from "./metagame.aipl";

# One match, from the point of view of an archetype the player's deck is, against an archetype
# the opponent's deck is.
struct Observation { player: str, opponent: str, result: Result }

# How the same match ended for the other side.
fn flipped(self: Result) -> Result {
    match (self) {
        Win => Loss,
        Loss => Win,
        Draw => Draw,
    }
}.test({
    assert(Win.flipped() == Loss);
    assert(Loss.flipped() == Win);
    assert(Draw.flipped() == Draw);
})

# `self` as the record of a single match.
fn as_record(self: Result) -> Record {
    match (self) {
        Win => Record { win: 1, loss: 0, draw: 0 },
        Loss => Record { win: 0, loss: 1, draw: 0 },
        Draw => Record { win: 0, loss: 0, draw: 1 },
    }
}.test({
    assert(Win.as_record() == Record { win: 1, loss: 0, draw: 0 });
    assert(Loss.as_record() == Record { win: 0, loss: 1, draw: 0 });
    assert(Draw.as_record() == Record { win: 0, loss: 0, draw: 1 });
})

# The names of the archetypes `self` is, each once, as a report reads them.
fn labels_of(self: Deck, identifiers: Identifier[]) -> str[] {
    self.archetypes_of(identifiers)$label().distinct()
}.test({
    let landfall = Identifier {
        name: "Landfall",
        cards: ["Forest"],
        not_cards: [],
        any_cards: [],
        maindeck_cards: [],
    };
    assert(deck_of(["Forest"], []).labels_of([landfall]) == ["Landfall"]);
    assert(deck_of(["Swamp"], []).labels_of([landfall]) == ["Other"]);
})

# A deck with the id `id` and the cards `cards`, for tests.
fn deck_with(id: str, cards: str[]) -> Deck { ..deck_of(cards, []), deck_id: id }

# The match between the decks `first` and `second` that `result` says how `first` did in, for
# tests.
fn between(first: str, second: str, result: Result) -> Match {
    first_deck_id: first,
    second_deck_id: second,
    result,
    record: Record { win: 0, loss: 0, draw: 0 },
    round: "",
}

# Every match of `matches` between two of `decks`, once for each pairing of an archetype of the
# one deck and an archetype of the other, from each side. A match with a deck not in `decks` is
# left out.
fn observations(decks: Deck[], matches: Match[], identifiers: Identifier[]) -> Observation[] {
    let labelled: #{str: str[]} = decks
        .map(|deck| (deck.deck_id, deck.labels_of(identifiers)))
        .to_dict();
    mut out: Observation[] = [];
    for (let each : matches) {
        if (let some(firsts) = labelled.get(each.first_deck_id)) {
            if (let some(seconds) = labelled.get(each.second_deck_id)) {
                for (let first : firsts) {
                    for (let second : seconds) {
                        set out.push(Observation {
                            player: first,
                            opponent: second,
                            result: each.result,
                        });
                        set out.push(Observation {
                            player: second,
                            opponent: first,
                            result: each.result.flipped(),
                        });
                    }
                }
            };
        };
    }
    out
}.test({
    let forest = Identifier {
        name: "Forest",
        cards: ["Forest"],
        not_cards: [],
        any_cards: [],
        maindeck_cards: [],
    };
    let decks = [deck_with("a", ["Forest"]), deck_with("b", ["Swamp"])];
    let matches = [between("a", "b", Win), between("a", "zz", Loss)];
    assert(observations(decks, matches, [forest]) == [
        Observation { player: "Forest", opponent: "Other", result: Win },
        Observation { player: "Other", opponent: "Forest", result: Loss },
    ]);
})

# The win rate as a percentage with one decimal: `55.6%`.
fn percent_text(self: Float) -> str { `{(self * 100.0).render(digits=1)}%` }.test({
    assert(percent_text(0.5) == "50.0%");
    assert(percent_text(2.0 / 3.0) == "66.7%");
})

# What a cell says about `self`: the win rate, or `-` when none of the matches was decided.
pub fn rate_text(self: Record) -> str {
    if (let some(rate) = self.win_rate()) { rate.percent_text() } else { "-" }
}.test({
    assert(Record { win: 0, loss: 0, draw: 0 }.rate_text() == "-");
    assert(Record { win: 0, loss: 0, draw: 4 }.rate_text() == "-");
    assert(Record { win: 1, loss: 1, draw: 1 }.rate_text() == "50.0%");
    assert(Record { win: 2, loss: 1, draw: 0 }.rate_text() == "66.7%");
})

# The total of what `self` says about how its row's archetype did against its column's.
fn record_of(self: Observation[]) -> Record {
    mut total = Record { win: 0, loss: 0, draw: 0 };
    for (let each : self) {
        set total = add_records(total, each.result.as_record());
    }
    total
}.test({
    let nothing: Observation[] = [];
    assert(nothing.record_of() == Record { win: 0, loss: 0, draw: 0 });
    let draw = Observation { player: "a", opponent: "b", result: Draw };
    let win = Observation { ..draw, result: Win };
    let loss = Observation { ..draw, result: Loss };
    assert([win, loss, draw, win].record_of() == Record { win: 2, loss: 1, draw: 1 });
})

# How each archetype did against each other one. `names` are the archetypes, most decks first, and
# `rows` has a row for each, each with a cell for each of `names`: the record of the row's
# archetype against the column's, or `none` where they are the same archetype. Such a pairing
# holds every match between two decks of it from both sides, so it says nothing. `overall` has the
# record of each of `names` against every archetype, its own included: a mirror match is one win
# and one loss, which pulls the archetype's overall rate toward even as it does at an event.
struct Matrix { names: str[], rows: Record?[][], overall: Record[] }

# The matrix of `matches` between `decks`, by the archetypes `identifiers` give them.
pub fn winrate_matrix(decks: Deck[], matches: Match[], identifiers: Identifier[]) -> Matrix {
    let names = shares(decks, identifiers)$name;
    let seen = observations(decks, matches, identifiers);
    let rows = names.map(|player| {
        let mine = seen.filter(|each| each.player == player);
        names.map(|opponent| {
            let cell: Record? = if (opponent == player) {
                none
            } else {
                some(mine.filter(|each| each.opponent == opponent).record_of())
            };
            cell
        })
    });
    let overall = names.map(|player| seen.filter(|each| each.player == player).record_of());
    Matrix { names, rows, overall }
}.test({
    let forest = Identifier {
        name: "Forest",
        cards: ["Forest"],
        not_cards: [],
        any_cards: [],
        maindeck_cards: [],
    };
    let decks = [deck_with("a", ["Forest"]), deck_with("b", ["Swamp"]), deck_with("c", ["Forest"])];
    let matches = [between("a", "b", Win), between("a", "c", Win)];
    assert(winrate_matrix(decks, matches, [forest]) == Matrix {
        names: ["Forest", "Other"],
        rows: [
            [none, some(Record { win: 1, loss: 0, draw: 0 })],
            [some(Record { win: 0, loss: 1, draw: 0 }), none],
        ],
        overall: [Record { win: 2, loss: 1, draw: 0 }, Record { win: 0, loss: 1, draw: 0 }],
    });
})
