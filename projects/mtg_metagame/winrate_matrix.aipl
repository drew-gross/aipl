# The winrate matrix: how each archetype fares against each other one. A deck is one
# archetype, so a match is held against the pairing of the two decks' archetypes, from each
# deck's side.

import {
    IEEE754Float64 as Float,
    collect_ok,
    count_if,
    distinct,
    equal as ==,
    filter,
    float_div as /,
    float_mul as *,
    get,
    is_some,
    join,
    len,
    logical_and as &&,
    logical_not as !,
    map,
    push,
    render,
    sort_by,
    to_dict,
    to_float,
    try_map,
} from builtins;
import {
    Identifier,
    Meta,
    Other,
    archetype_of,
    definition,
    label,
    sub_archetype_of,
} from "./archetypes.aipl";
import { Counted, ranked } from "./counted.aipl";
import { shares } from "./meta_share.aipl";
import {
    Card,
    Deck,
    Draw,
    Loss,
    Match,
    Record,
    Result,
    Win,
    add_records,
    as_record,
    played,
    unknown_deck,
    win_rate,
} from "./metagame.aipl";
import {
    Bracket,
    first_bracket,
    is_above,
    last_rounds,
    second_bracket,
    slot_count,
    slot_label,
    slot_of,
} from "./rounds.aipl";

# One match, from the point of view of an archetype the player's deck is, against an archetype
# the opponent's deck is. `slot` is where the match's round falls counting back from the end of its
# tournament, if it does, and `bracket` the player's record going into it, if it is a numbered round
# and the player's history says (see `rounds.aipl`). `player_sub` is the sub-archetype of `player`
# the player's deck is, if it has one.
struct Observation {
    player: str,
    opponent: str,
    result: Result,
    slot: u64?,
    bracket: Bracket?,
    player_sub: str? = none,
}

# How the same match ended for the other side.
fn flipped(self: Result) -> Result {
    match (self) {
        Win => Loss,
        Loss => Win,
        Draw => Draw,
    }
}.test({
    assert(Win.flipped() == Loss);
    assert(Loss.flipped() == Win);
    assert(Draw.flipped() == Draw);
})

# Where a deck sits in the matrix: its archetype as a report reads it, and the sub-archetype of that
# archetype it is, if the archetype has any.
struct Placement { archetype: str, sub: str? }

# The placement of `self`.
fn placement_of(self: Deck, identifiers: Identifier[]) -> Placement!str {
    let archetype = self.archetype_of(identifiers)?;
    let sub = match (archetype) {
        Meta(name) => self.sub_archetype_of(name, identifiers)?,
        Other(..) => none,
    };
    ok(Placement { archetype: archetype.label(), sub })
}.test({
    let landfall = Identifier { name: "Landfall", cards: ["Forest"] };
    let plains = Identifier { name: "Selesnya", cards: ["Plains"], parent: some("Landfall") };
    let forest = Card { name: "Forest" };
    assert(Deck { deck_id: "d", maindeck: [forest] }.placement_of([landfall]) == ok(Placement {
        archetype: "Landfall",
        sub: none,
    }));
    assert(Deck { deck_id: "d", maindeck: [Card { name: "Swamp" }] }.placement_of([
        landfall,
    ]) == ok(Placement { archetype: "Other", sub: none }));

    // A sub-archetype is read for the decks of its archetype only.
    assert(Deck { deck_id: "d", maindeck: [forest, Card { name: "Plains" }] }.placement_of([
        landfall,
        plains,
    ]) == ok(Placement { archetype: "Landfall", sub: some("Selesnya") }));
    assert(Deck { deck_id: "d", maindeck: [forest] }.placement_of([
        landfall,
        plains,
    ]) == ok(Placement { archetype: "Landfall", sub: some("Other") }));
})

# Every match of `matches`, once from each side. A match with a deck not in `decks` is an error. `last_rounds` is
# the last round of each tournament, which a match's slot is counted back from.
fn observations(
    decks: Deck[],
    matches: Match[],
    identifiers: Identifier[],
    last_rounds: #{str: u64},
) -> Observation[]!str {
    let placed: #{str: Placement} = decks
        .try_map(|deck| {
            let placement = deck.placement_of(identifiers)?;
            ok((deck.deck_id, placement))
        })?
        .to_dict();
    mut out: Observation[] = [];
    for (let each : matches) {
        let some(first) = placed.get(each.first_deck_id) else {
            return err(unknown_deck(each.first_deck_id));
        };
        let some(second) = placed.get(each.second_deck_id) else {
            return err(unknown_deck(each.second_deck_id));
        };
        let slot = each.slot_of(last_rounds);
        let first_bracket = each.first_bracket();
        let second_bracket = each.second_bracket();
        set out.push(Observation {
            player: first.archetype,
            opponent: second.archetype,
            result: each.result,
            slot,
            bracket: first_bracket,
            player_sub: first.sub,
        });
        set out.push(Observation {
            player: second.archetype,
            opponent: first.archetype,
            result: each.result.flipped(),
            slot,
            bracket: second_bracket,
            player_sub: second.sub,
        });
    }
    ok(out)
}.test({
    let forest = Identifier { name: "Forest", cards: ["Forest"] };
    let decks = [
        Deck { deck_id: "a", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "b", maindeck: [Card { name: "Swamp" }] },
    ];
    let played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "t",
        first_before: Record {},
        record: Record {},
        result: Win,
    };
    let last: #{str: u64} = #{"t": 5};
    assert(observations(decks, [played], [forest], last) == ok([
        Observation { player: "Forest", opponent: "Other", result: Win, slot: none, bracket: none },
        Observation {
            player: "Other",
            opponent: "Forest",
            result: Loss,
            slot: none,
            bracket: none,
        },
    ]));
    // A match is in the slot its round falls in, from both sides.
    let semifinal = Match { ..played, result: Loss, round: "Semifinals" };
    assert(observations(decks, [semifinal], [forest], last) == ok([
        Observation {
            player: "Forest",
            opponent: "Other",
            result: Loss,
            slot: some(1),
            bracket: none,
        },
        Observation {
            player: "Other",
            opponent: "Forest",
            result: Win,
            slot: some(1),
            bracket: none,
        },
    ]));
    let round_four = Match { ..played, round: "Round 4" };
    assert(observations(decks, [round_four], [forest], last) == ok([
        Observation {
            player: "Forest",
            opponent: "Other",
            result: Win,
            slot: some(4),
            bracket: some(Bracket { win: 0, loss: 0 }),
        },
        Observation {
            player: "Other",
            opponent: "Forest",
            result: Loss,
            slot: some(4),
            bracket: none,
        },
    ]));
    assert(observations(
        decks,
        [Match { ..played, second_deck_id: "zz", result: Loss }],
        [forest],
        last,
    ) == err(unknown_deck("zz")));
})

# The win rate as a percentage of two significant digits: `56%`.
fn percent_text(self: Float) -> str { `{(self * 100.0).render(significant=2)}%` }.test({
    assert(percent_text(0.5) == "50%");
    assert(percent_text(2.0 / 3.0) == "67%");
})

# What a cell says about `self`: the win rate, or `-` when it has no match.
pub fn rate_text(self: Record) -> str {
    if (let some(rate) = self.win_rate()) { rate.percent_text() } else { "-" }
}.test({
    assert(Record {}.rate_text() == "-");
    assert(Record {}.rate_text() == "-");
    assert(Record { draw: 4 }.rate_text() == "50%");
    assert(Record { win: 3, draw: 1 }.rate_text() == "88%");
    assert(Record { win: 1, loss: 1, draw: 1 }.rate_text() == "50%");
    assert(Record { win: 2, loss: 1 }.rate_text() == "67%");
})

# What share of `total` matches `self` counts, as a percentage: `12%`, or `-` when there are none.
pub fn share_text(self: Record, total: u64) -> str {
    if (total == 0) { "-" } else { (self.played().to_float() / total.to_float()).percent_text() }
}.test({
    assert(Record { win: 1 }.share_text(0) == "-");
    assert(Record { win: 1, loss: 1 }.share_text(8) == "25%");
    assert(Record {}.share_text(8) == "0%");
})

# The total of what `self` says about how its row's archetype did against its column's.
fn record_of(self: Observation[]) -> Record {
    mut total = Record {};
    for (let each : self) {
        set total = add_records(total, each.result.as_record());
    }
    total
}.test({
    assert([].record_of() == Record {});
    let draw = Observation { player: "a", opponent: "b", result: Draw, slot: none, bracket: none };
    let win = Observation { ..draw, result: Win };
    let loss = Observation { ..draw, result: Loss };
    assert([win, loss, draw, win].record_of() == Record { win: 2, loss: 1, draw: 1 });
})

# How one archetype did against another, or against all: `record` is overall, `rounds` has the
# record in each slot (see `rounds.aipl`), indexed by slot, and `brackets` the record at each
# bracket of the metagame, indexed alike.
struct Cell { record: Record, rounds: Record[], brackets: Record[] }

# The cell of `self`, for a metagame of `slot_count` slots and the brackets `brackets`.
fn cell_of(self: Observation[], slot_count: u64, brackets: Bracket[]) -> Cell {
    record: self.record_of(),
    rounds: (0..slot_count).map(|slot| self.filter(|each| each.slot == some(slot)).record_of()),
    brackets: brackets.map(|bracket| self.filter(|each| each.bracket == some(bracket)).record_of()),
}.test({
    let upper = Bracket { win: 7, loss: 1 };
    let lower = Bracket { win: 0, loss: 3 };
    let win = Observation {
        player: "a",
        opponent: "b",
        result: Win,
        slot: some(1),
        bracket: some(lower),
    };
    let loss = Observation { ..win, result: Loss, slot: some(0), bracket: some(upper) };
    let again = Observation { ..win, result: Win, bracket: some(upper) };
    let unplaced = Observation { ..win, slot: none, bracket: none };
    let middle = Bracket { win: 3, loss: 3 };
    assert([win, loss, unplaced, again].cell_of(3, [upper, middle, lower]) == Cell {
        record: Record { win: 3, loss: 1 },
        rounds: [Record { loss: 1 }, Record { win: 2 }, Record {}],
        brackets: [Record { win: 1, loss: 1 }, Record {}, Record { win: 1 }],
    });
})

# How each archetype did against each other one. `names` are the archetypes, most decks first, and
# `rows` has a row for each, each with a cell for each of `names`: how the row's archetype did
# against the column's, or `none` where they are the same archetype. Such a pairing holds every
# match between two decks of it from both sides, so it says nothing. `overall` has how each of
# `names` did against every archetype, its own included: a mirror match is one win and one loss,
# which pulls the archetype's overall rate toward even as it does at an event.
#
# `definitions` says in a line what makes a deck each of `names` (empty for `Other`). `counts` is how many decks each of `names` has, out of `total` decks. `slots` names the slots
# rounds fall in, finals first, `slot_matches` is how many of the metagame's `matches` fall in each,
# and each cell's `rounds` is indexed alike. `brackets` are the records going into a round that
# some archetype had, highest first, and each cell's `brackets` is indexed alike.
struct Matrix {
    names: str[],
    definitions: str[],
    counts: u64[],
    total: u64,
    slots: str[],
    slot_matches: u64[],
    matches: u64,
    brackets: Bracket[],
    rows: Cell?[][],
    overall: Cell[],
    sub_archetypes: SubArchetype[] = [],
    decklists: DeckLink[][] = [],
}

# A deck the page links to: who played it, what its list was called, and where to read it.
struct DeckLink { pilot: str, name: str, url: str }

# How one sub-archetype did: of the archetype `parent` (an index into the matrix's `names`) it is
# named `name`, said in a line by `definition`, and has `count` decks. `cells` has the cell against
# each of the matrix's archetypes, in order, and `overall` the one against all of them.
struct SubArchetype {
    parent: u64,
    name: str,
    definition: str,
    count: u64,
    cells: Cell?[],
    overall: Cell,
    decks: DeckLink[] = [],
}

# The matrix of `matches` between `decks`, by the archetypes `identifiers` give them.
pub fn winrate_matrix(decks: Deck[], matches: Match[], identifiers: Identifier[]) -> Matrix!str {
    let found = shares(decks, identifiers)?;
    let names = found$name;
    let last_rounds = matches.last_rounds();
    let slot_count = slot_count(last_rounds);
    let seen = observations(decks, matches, identifiers, last_rounds)?;
    let placed = matches$slot_of(last_rounds);
    let brackets = seen$bracket.collect_ok().distinct().sort_by(is_above);
    // Every deck with where it sits and where its list is, to group by archetype and sub-archetype.
    let listed = decks.try_map(|deck| {
        let placement = deck.placement_of(identifiers)?;
        ok((placement, DeckLink { pilot: deck.pilot, name: deck.name, url: deck.url }))
    })?;
    let placements = listed$0;
    // Each archetype's sub-archetypes, most decks first, in the order of the archetypes.
    mut sub_archetypes: SubArchetype[] = [];
    for (let parent, archetype : names) {
        let subs = placements.filter(|each| each.archetype == archetype)$sub.collect_ok();
        let counted = subs
            .distinct()
            .map(|sub| Counted { name: sub, count: subs.count_if(|each| each == sub) })
            .ranked();
        for (let sub : counted) {
            let mine = seen.filter(|each| each.player == archetype && each.player_sub == some(
                sub.name,
            ));
            set sub_archetypes.push(SubArchetype {
                parent,
                name: sub.name,
                definition: identifiers
                    .filter(|i| i.parent == some(archetype) && i.name == sub.name)
                    $definition()
                    .join(sep=" | "),
                count: sub.count,
                decks: listed.filter(|each| each.0.archetype == archetype && each.0.sub == some(
                    sub.name,
                ))$1,
                cells: names.map(|opponent| {
                    some(
                        mine.filter(|each| each.opponent == opponent).cell_of(slot_count, brackets),
                    )
                }),
                overall: mine.cell_of(slot_count, brackets),
            });
        }
    }
    let rows = names.map(|player| {
        let mine = seen.filter(|each| each.player == player);
        names.map(|opponent| {
            let cell: Cell? = if (opponent == player) {
                none
            } else {
                some(mine.filter(|each| each.opponent == opponent).cell_of(slot_count, brackets))
            };
            cell
        })
    });
    ok(Matrix {
        names,
        definitions: names.map(|name| {
            identifiers
                .filter(|i| i.name == name && !i.parent.is_some())
                $definition()
                .join(sep=" | ")
        }),
        counts: found$count,
        total: decks.len(),
        slots: (0..slot_count)$slot_label(),
        slot_matches: (0..slot_count).map(|slot| placed.count_if(|each| each == some(slot))),
        matches: matches.len(),
        brackets,
        rows,
        overall: names.map(
            |player| seen.filter(|each| each.player == player).cell_of(slot_count, brackets),
        ),
        sub_archetypes,
        decklists: names.map(|archetype| { listed.filter(|each| each.0.archetype == archetype)$1 }),
    })
}.test({
    let forest = Identifier { name: "Forest", cards: ["Forest"] };
    let decks = [
        Deck { deck_id: "a", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "b", maindeck: [Card { name: "Swamp" }] },
        Deck { deck_id: "c", maindeck: [Card { name: "Forest" }] },
    ];

    // A tournament of two rounds and a final: Forest beat Other in the final and in round 2, and
    // beat another Forest in round 1.
    let played = Match {
        first_deck_id: "a",
        second_deck_id: "b",
        tournament: "t",
        first_before: Record {},
        record: Record {},
        result: Win,
    };
    let matches = [
        Match { ..played, second_deck_id: "c", round: "Round 1" },
        Match { ..played, round: "Round 2" },
        Match { ..played, round: "Finals" },
    ];
    assert(winrate_matrix(decks, matches, [forest]) == ok(Matrix {
        names: ["Forest", "Other"],
        definitions: ["Forest", ""],
        decklists: [
            [DeckLink { pilot: "", name: "", url: "" }, DeckLink { pilot: "", name: "", url: "" }],
            [DeckLink { pilot: "", name: "", url: "" }],
        ],
        counts: [2, 1],
        total: 3,
        slots: ["Finals", "Semifinals", "Quarterfinals", "Last round", "2nd last round"],
        slot_matches: [1, 0, 0, 1, 1],
        matches: 3,
        // Only the first deck of a match has a record going in here.
        brackets: [Bracket { win: 0, loss: 0 }],
        rows: [
            [
                none,
                some(Cell {
                    record: Record { win: 2 },
                    rounds: [Record { win: 1 }, Record {}, Record {}, Record { win: 1 }, Record {}],
                    brackets: [Record { win: 1 }],
                }),
            ],
            [
                some(Cell {
                    record: Record { loss: 2 },
                    rounds: [
                        Record { loss: 1 },
                        Record {},
                        Record {},
                        Record { loss: 1 },
                        Record {},
                    ],
                    brackets: [Record {}],
                }),
                none,
            ],
        ],
        overall: [
            Cell {
                record: Record { win: 3, loss: 1 },
                rounds: [
                    Record { win: 1 },
                    Record {},
                    Record {},
                    Record { win: 1 },
                    Record { win: 1, loss: 1 },
                ],
                brackets: [Record { win: 2 }],
            },
            Cell {
                record: Record { loss: 2 },
                rounds: [Record { loss: 1 }, Record {}, Record {}, Record { loss: 1 }, Record {}],
                brackets: [Record {}],
            },
        ],
    }));

    // A sub-archetype has a row of its own: the decks of its archetype that it claims, with their
    // record against each archetype, and the rest of the archetype's decks as `Other`.
    let plains = Identifier { name: "Plains", cards: ["Plains"], parent: some("Forest") };
    let with_plains = [
        Deck { deck_id: "a", maindeck: [Card { name: "Forest" }, Card { name: "Plains" }] },
        Deck { deck_id: "b", maindeck: [Card { name: "Swamp" }] },
        Deck { deck_id: "c", maindeck: [Card { name: "Forest" }] },
        Deck { deck_id: "d", maindeck: [Card { name: "Forest" }, Card { name: "Plains" }] },
    ];
    let subs = winrate_matrix(
        with_plains,
        [Match { ..played, round: "Round 1" }],
        [forest, plains],
    )?.sub_archetypes;
    assert(subs$name == ["Plains", "Other"]);
    assert(subs$parent == [0, 0]);
    assert(subs$count == [2, 1]);
    assert(subs$decks$len() == [2, 1]);
    assert(subs$definition == ["Plains", ""]);
    assert(subs$overall$record == [Record { win: 1 }, Record {}]);
    // Against the archetype `Other` (column 1) the Plains decks won once; against Forest, never met.
    assert(subs[0]?.cells.map(|cell| cell$record) == [some(Record {}), some(Record { win: 1 })]);

    // A match with a deck the metagame does not have is an error.
    assert(winrate_matrix(
        decks,
        [Match { ..played, second_deck_id: "zz" }],
        [forest],
    ) == err(unknown_deck("zz")));
    assert(winrate_matrix(
        decks,
        [Match { ..played, first_deck_id: "zz" }],
        [forest],
    ) == err(unknown_deck("zz")));
})
