# Minesweeper for the terminal.
#
# The mines are placed at random (`place_mines`) by the first reveal, seeded in `main`.

import {
    Down,
    Key,
    Left,
    Other,
    Right,
    Up,
    all,
    any,
    cartesian_product,
    count_if,
    drop_first,
    enter_alternate_screen,
    equal as ==,
    extend,
    filter,
    first,
    grid_of,
    height,
    int_parse,
    is_in_bounds_of,
    is_nonempty,
    is_some,
    join,
    leave_alternate_screen,
    len,
    less_than as <,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    map,
    min,
    move_to,
    not_equal as !=,
    print,
    push,
    put,
    random_u64,
    read_key,
    saturating_remainder as %,
    seeded_with_clock,
    seeded_with_int,
    split,
    value_or,
    value_or_err,
    width,
    wrapping_add as +,
    wrapping_increment as ++,
    wrapping_sub as -,
} from builtins;

# What the player has done to a cell, and whether it holds a mine. A board is a
# `Mark[,]`: one `Mark` for each cell.
variant Mark = Hidden(bool) | Flagged(bool) | Revealed(bool)

# Where a game stands.
variant Status = Playing | Won | Lost

# How many mines a game has.
let MINE_COUNT: u64 = 10;

# A board `width` cells wide and `height` high, every cell hidden and mine-free: the
# mines come later, from `place_mines`.
fn new_game(width: u64, height: u64) -> Mark[,] { grid_of(width, height, Hidden(false)) }.test({
    let expected: Mark[,] = [
        [Hidden(false), Hidden(false), Hidden(false)],
        [Hidden(false), Hidden(false), Hidden(false)],
    ];
    assert(new_game(3, 2) == expected);
})

# Whether `cell` holds a mine, whatever the player has done to it.
fn is_mine(self: Mark[,], cell: (u64, u64)) -> bool {
    match (self[cell]) {
        some(Hidden(mine)) | some(Flagged(mine)) | some(Revealed(mine)) => mine,
        none => false,
    }
}.test({
    let game = new_game(2, 2).add_mines([(1, 1)]).toggle_flag((1, 1)).reveal((0, 0));
    assert(game.is_mine((1, 1)));
    assert(!game.is_mine((0, 0)));
    assert(!game.is_mine((4, 4)));
})

# `self` with a mine under `cell`, whatever the player has done there. Off the board
# nothing happens.
fn add_mine(mut self: Mark[,], cell: (u64, u64)) {
    match (self[cell]) {
        some(Hidden(..)) => {
            set self[cell] = Hidden(true) else {};
        },
        some(Flagged(..)) => {
            set self[cell] = Flagged(true) else {};
        },
        some(Revealed(..)) => {
            set self[cell] = Revealed(true) else {};
        },
        none => {},
    };
}.test({
    let game = new_game(2, 2).toggle_flag((0, 0)).reveal((1, 1));
    assert(game.add_mine((0, 1)).is_mine((0, 1)));
    // A flag, or a reveal, stays as it is.
    let flag: (u64, u64) = (0, 0);
    let revealed: (u64, u64) = (1, 1);
    assert(game.add_mine(flag)[flag] == some(Flagged(true)));
    assert(game.add_mine(revealed)[revealed] == some(Revealed(true)));
    // Off the board, nothing.
    assert(game.add_mine((5, 5)) == game);
})

# `self` with a mine under each of `mines`.
fn add_mines(mut self: Mark[,], mines: (u64, u64)[]) {
    for (let cell : mines) {
        set self.add_mine(cell);
    }
}.test({
    let game = new_game(3, 2).add_mines([(0, 1), (1, 2)]);
    assert(game.mine_count() == 2);
    assert(game.is_mine((0, 1)) && game.is_mine((1, 2)));
    assert(new_game(3, 2).add_mines([]) == new_game(3, 2));
})

# How many cells hold a mine, whatever the player has done to them.
fn mine_count(self: Mark[,]) -> u64 {
    (0..self.height()).cartesian_product(0..self.width()).count_if(|cell| self.is_mine(cell))
}.test({
    assert(new_game(3, 2).mine_count() == 0);
    assert(new_game(3, 2).add_mines([(0, 0), (1, 1)]).mine_count() == 2);
})

# Place `count` mines at random cells that hold none yet, none of them on `away_from`
# or a cell touching it (fewer, if there is no room for that many). A flag, or a reveal,
# on a cell it mines stays.
fn place_mines(mut self: Mark[,], count: u64, away_from: (u64, u64)) !random {
    let cells: (u64, u64)[] = (0..self.height()).cartesian_product(0..self.width());
    let clear = [away_from, ..self.neighbors(away_from)];
    let candidates = cells.filter(|cell| !self.is_mine(cell) && !clear.any(|near| near == cell));
    let wanted = min(count, candidates.len());
    mut placed: u64 = 0;
    while (placed < wanted) {
        let cell = candidates[random_u64() % candidates.len()].value_or(away_from);
        if (!self.is_mine(cell)) {
            set self.add_mine(cell);
            set placed++;
        };
    }
}.test({
    let board = new_game(8, 8);
    for (let seed : 0..8) {
        let middle: (u64, u64) = (3, 3);
        mut placed = board;
        shim random seeded_with_int(seed) {
            set placed.place_mines(10, middle);
        };
        assert(placed.mine_count() == 10);
        // None among the cell and its neighbours.
        assert(![middle, ..placed.neighbors(middle)].any(|cell| placed.is_mine(cell)));
    }
    // The same seed, the same mines.
    mut once = board;
    mut again = board;
    let corner: (u64, u64) = (0, 0);
    shim random seeded_with_int(1) {
        set once.place_mines(10, corner);
    };
    shim random seeded_with_int(1) {
        set again.place_mines(10, corner);
    };
    assert(once == again);

    // Mines go only where there is room: a 3 by 3 board, away from its corner, has
    // five cells left.
    mut small = new_game(3, 3);
    shim random seeded_with_int(1) {
        set small.place_mines(10, corner);
    };
    assert(small.mine_count() == 5);
    assert(!small.is_mine(corner) && !small.is_mine((1, 1)));
    // And a flag on a cell that gets a mine stays a flag: the only room is the far end.
    let far: (u64, u64) = (0, 2);
    mut flagged: Mark[,] = new_game(3, 1).toggle_flag(far);
    shim random seeded_with_int(1) {
        set flagged.place_mines(1, corner);
    };
    assert(flagged[far] == some(Flagged(true)));
})

# The cells touching `cell`, including diagonally, that are on the board.
#
# Offsets run 0 to 2 for -1 to +1. A neighbour above or to the left of the board
# wraps around to a huge number, which is off the board like any other.
fn neighbors(self: Mark[,], cell: (u64, u64)) -> (u64, u64)[] {
    mut out: (u64, u64)[] = [];
    for (let offset : (0..3).cartesian_product(0..3)) {
        let neighbor = (cell.0 + offset.0 - 1, cell.1 + offset.1 - 1);
        if (neighbor.is_in_bounds_of(self) && neighbor != cell) {
            set out.push(neighbor);
        };
    }
    out
}.test({
    let game = new_game(3, 3);
    assert(game.neighbors((0, 0)) == [(0, 1), (1, 0), (1, 1)]);
    assert(game.neighbors((1, 1)) == [
        (0, 0),
        (0, 1),
        (0, 2),
        (1, 0),
        (1, 2),
        (2, 0),
        (2, 1),
        (2, 2),
    ]);
    assert(game.neighbors((2, 2)) == [(1, 1), (1, 2), (2, 1)]);
})

# How many of the cells touching `cell` hold a mine.
fn adjacent_mines(self: Mark[,], cell: (u64, u64)) -> u64 {
    self.neighbors(cell).count_if(|n| self.is_mine(n))
}.test({
    let game = new_game(3, 3).add_mines([(0, 0), (0, 2), (1, 2)]);
    assert(game.adjacent_mines((0, 1)) == 3);
    assert(game.adjacent_mines((1, 1)) == 3);
    assert(game.adjacent_mines((2, 0)) == 0);
})

# Reveal each cell of `frontier` that is still hidden and holds no mine, and
# whenever nothing around a revealed cell is a mine, the cells around it too: a
# click on an empty region opens the whole region and its border.
fn flood(mut self: Mark[,], frontier: (u64, u64)[]) {
    mut pending = frontier;
    while (pending.is_nonempty()) {
        let cell = pending[0].value_or((0, 0));
        set pending = pending.drop_first();
        if (self[cell] == some(Hidden(false))) {
            set self[cell] = Revealed(false) else {};
            if (self.adjacent_mines(cell) == 0) {
                set pending.extend(self.neighbors(cell));
            };
        };
    }
}

# `self` after the player reveals `cell`. A flagged or already revealed cell is
# left alone.
fn reveal(mut self: Mark[,], cell: (u64, u64)) {
    match (self[cell]) {
        some(Hidden(mine)) => {
            if (mine) {
                set self[cell] = Revealed(true) else {};
            } else {
                set self.flood([cell]);
            };
        },
        some(Flagged(..)) | some(Revealed(..)) | none => {},
    };
}.test({
    // A number stops at itself.
    let game = new_game(3, 3).add_mines([(2, 2)]);
    assert(game.reveal((2, 1))[(2, 1)] == some(Revealed(false)));
    assert(game.reveal((2, 1))[(2, 0)] == some(Hidden(false)));

    // A region with no mines around it opens, border and all: here that is
    // every cell but the mine, so it wins.
    assert(game.reveal((0, 0)).status() == Won);
})

# `self` after the player flags `cell`, or takes the flag off it. A revealed cell
# cannot be flagged.
fn toggle_flag(mut self: Mark[,], cell: (u64, u64)) {
    match (self[cell]) {
        some(Hidden(mine)) => {
            set self[cell] = Flagged(mine) else {};
        },
        some(Flagged(mine)) => {
            set self[cell] = Hidden(mine) else {};
        },
        some(Revealed(..)) | none => {},
    };
}.test({
    let game = new_game(2, 2).add_mines([(1, 1)]);
    let corner: (u64, u64) = (0, 0);
    assert(game.toggle_flag(corner)[corner] == some(Flagged(false)));
    // Flagging twice takes the flag off again.
    assert(game.toggle_flag(corner).toggle_flag(corner)[corner] == some(Hidden(false)));
    // A flag protects its cell from a reveal.
    assert(game.toggle_flag(corner).reveal(corner)[corner] == some(Flagged(false)));
    // A revealed cell takes no flag.
    assert(game.reveal(corner).toggle_flag(corner)[corner] == some(Revealed(false)));
    // Off the board: nothing happens.
    assert(game.toggle_flag((9, 9)) == game);
})

# Whether the game is still going: lost once a mine is revealed, won once every
# cell without a mine is.
fn status(self: Mark[,]) -> Status {
    if (self.any(|mark| mark == Revealed(true))) {
        Lost
    } else if (self.any(|mark| mark == Hidden(false) || mark == Flagged(false))) {
        Playing
    } else {
        Won
    }
}.test({
    let game = new_game(2, 2).add_mines([(1, 1)]);
    assert(game.status() == Playing);
    assert(game.reveal((1, 1)).status() == Lost);
    assert(game.reveal((0, 0)).reveal((0, 1)).reveal((1, 0)).status() == Won);
})

# What is drawn for `cell`: `#` hidden, `F` flagged, `.` revealed with nothing
# around it, a digit counting the mines around it, `*` a mine (shown once
# revealed, or when `show_mines`).
fn symbol(self: Mark[,], cell: (u64, u64), show_mines: bool) -> str {
    match (self[cell]) {
        some(Revealed(mine)) => if (mine) {
            "*"
        } else if (self.adjacent_mines(cell) == 0) {
            "."
        } else {
            `{self.adjacent_mines(cell)}`
        },
        some(Flagged(..)) => "F",
        some(Hidden(mine)) => if (show_mines && mine) { "*" } else { "#" },
        none => "#",
    }
}

# The board as text: a row of column numbers, then each row led by its number,
# with a space before every cell. The cell at `cursor` is bracketed, `[#]`, by
# taking the spaces either side of it; `none` marks no cell.
fn render(self: Mark[,], show_mines: bool, cursor: (u64, u64)?) -> str {
    let heads = (0..self.width()).map(|column| `{column}`);
    let rows = (0..self.height()).map(|row| {
        let cells = (0..self.width()).map(|column| {
            let before = if (cursor == some((row, column))) {
                "["
            } else if (column != 0 && cursor == some((row, column - 1))) {
                "]"
            } else {
                " "
            };
            `{before}{self.symbol((row, column), show_mines)}`
        });

        // The closing bracket of a cursor on the last cell goes after it, and a space
        // goes there otherwise, so that every row is as wide as the one it replaces
        // when the board is drawn over itself.
        let last = if (cursor == some((row, self.width() - 1))) {
            "]"
        } else if (cursor.is_some()) {
            " "
        } else {
            ""
        };
        `{row}{cells.join(sep="")}{last}`
    });
    [`  {heads.join(sep=" ")}`, ..rows].join(sep="\n")
}.test({
    let game = new_game(3, 2).add_mines([(1, 2)]).reveal((0, 0));
    assert(game.render(false, none) == """
          0 1 2
        0 . 1 #
        1 . 1 #
    """);

    // The cursor takes the spaces either side of its cell, and every row keeps its
    // width, so a row drawn over a longer one leaves nothing of it.
    let middle: (u64, u64) = (1, 1);
    assert(game.render(false, some(middle)) == ["  0 1 2", "0 . 1 # ", "1 .[1]# "].join(sep="\n"));
    let first: (u64, u64) = (0, 0);
    let last: (u64, u64) = (0, 2);
    assert(game.render(false, some(first)).split("\n")[1] == some("0[.]1 # "));
    assert(game.render(false, some(last)).split("\n")[1] == some("0 . 1[#]"));
})

# One step toward the start of a board's side, stopping at the first cell.
fn before(self: u64) -> u64 { if (self == 0) { self } else { self - 1 } }.test({
    assert(0.before() == 0);
    assert(3.before() == 2);
})

# One step toward the end of a side `length` cells long, stopping at the last.
fn after(self: u64, length: u64) -> u64 { if (self + 1 < length) { self + 1 } else { self } }.test({
    assert(0.after(3) == 1);
    assert(2.after(3) == 2);
    assert(0.after(0) == 0);
})

# A game, the cell the player's cursor is on, and whether the mines are placed yet.
# They are placed by the first reveal, so that a game cannot be lost on its first
# move.
struct Session { game: Mark[,], cursor: (u64, u64), mined: bool }

# Whether play goes on, and if so from where. The first reveal of a game is its own case,
# because it is what places the mines, which needs the random numbers that `press`
# does not.
variant Turn = Continue(Session) | FirstReveal(Session) | Quit

# The keys that are not arrows, as the bytes `read_key` reports for them.
let REVEAL_KEY: u8 = 114;

let FLAG_KEY: u8 = 102;

let QUIT_KEY: u8 = 113;

# What a key press does: an arrow key moves the cursor, but not off the board;
# `r` reveals the cell under it, `f` flags or unflags it, `q` quits, and any other
# key does nothing.
fn press(self: Session, key: Key) -> Turn {
    let game = self.game;
    let row = self.cursor.0;
    let column = self.cursor.1;
    match (key) {
        Up => Continue(Session { ..self, cursor: (row.before(), column) }),
        Down => Continue(Session { ..self, cursor: (row.after(game.height()), column) }),
        Left => Continue(Session { ..self, cursor: (row, column.before()) }),
        Right => Continue(Session { ..self, cursor: (row, column.after(game.width())) }),
        Other(byte) => if (byte == REVEAL_KEY) {
            if (!self.mined) {
                // A flagged cell is not revealed, so it is not a first reveal either.
                if (game[self.cursor] == some(Hidden(false))) {
                    FirstReveal(self)
                } else {
                    Continue(self)
                }
            } else {
                Continue(Session { ..self, game: game.reveal(self.cursor) })
            }
        } else if (byte == FLAG_KEY) {
            Continue(Session { ..self, game: game.toggle_flag(self.cursor) })
        } else if (byte == QUIT_KEY) {
            Quit
        } else {
            Continue(self)
        },
    }
}.test({
    let origin: (u64, u64) = (0, 0);
    let start = Session { game: new_game(2, 2).add_mines([(1, 1)]), cursor: origin, mined: true };
    let corner: (u64, u64) = (1, 1);
    // Arrows move the cursor and stop at the edges.
    assert(start.press(Up) == Continue(start));
    assert(start.press(Left) == Continue(start));
    let down: (u64, u64) = (1, 0);
    assert(start.press(Down) == Continue(Session { ..start, cursor: down }));
    assert(
        start
            .press(Down)
            .press_continuing(Right)
            .press_continuing(Down)
            .press_continuing(Right) == Continue(Session { ..start, cursor: corner }),
    );
    // `r` reveals under the cursor, `f` flags, `q` quits, other keys are ignored.
    assert(start.press(Other(114)) == Continue(Session {
        ..start,
        game: start.game.reveal(origin),
    }));
    assert(start.press(Other(102)) == Continue(Session {
        ..start,
        game: start.game.toggle_flag(origin),
    }));
    assert(start.press(Other(113)) == Quit);
    assert(start.press(Other(120)) == Continue(start));

    // Before the mines are placed, the first `r` asks for them to be, unless the cell
    // is flagged and so cannot be revealed at all.
    let empty = Session { game: new_game(2, 2), cursor: origin, mined: false };
    assert(empty.press(Other(114)) == FirstReveal(empty));
    let flagged = Session { ..empty, game: empty.game.toggle_flag(origin) };
    assert(flagged.press(Other(114)) == Continue(flagged));
})

# `self` after `key`, when `self` is a turn that goes on; a turn that has quit stays so.
fn press_continuing(self: Turn, key: Key) -> Turn {
    match (self) {
        Continue(session) => session.press(key),
        FirstReveal(..) | Quit => self,
    }
}.test({
    let origin: (u64, u64) = (0, 0);
    let session = Session { game: new_game(2, 2), cursor: origin, mined: true };
    assert(Quit.press_continuing(Right) == Quit);
    assert(Continue(session).press_continuing(Other(113)) == Quit);
})

# Place the mines at random and reveal the cell under the cursor. No mine goes on that
# cell or any cell touching it, so the reveal opens at least the cell and the cells
# around it: a game is not lost on its first move, and starts with an area to work
# from.
fn start_mining(self: Session) !random -> Session {
    mut game = self.game;
    set game.place_mines(MINE_COUNT, self.cursor);
    Session { ..self, game: game.reveal(self.cursor), mined: true }
}.test({
    // Wherever the first reveal is, on an edge, in a corner or in the middle, it opens the
    // cell and everything around it, and no seed puts a mine among them.
    let cursors: (u64, u64)[] = [(0, 0), (0, 4), (4, 0), (7, 7), (3, 3), (6, 1)];
    for (let cursor : cursors) {
        for (let seed : 0..8) {
            let session = Session { game: new_game(8, 8), cursor, mined: false };
            let started = shim random seeded_with_int(seed) { session.start_mining() };
            let game = started.game;
            assert(started.mined);
            assert(game.mine_count() == MINE_COUNT);
            let opened = [cursor, ..game.neighbors(cursor)];
            assert(opened.all(|cell| game[cell] == some(Revealed(false))));
        }
    }
})

# Draw the board from the top left of the terminal, in place, and the keys below it.
fn draw(self: Session) !prints !terminal {
    put(self.game.render(false, some(self.cursor)));
    move_to(self.game.height() + 2, 0);
    put("arrows move, r reveals, f flags, q quits");
    move_to(0, 0);
}

# Say how `self` ended, and show it with its mines. Prints nothing for a game
# that is still going: the player quit.
fn report(self: Mark[,]) !prints {
    match (self.status()) {
        Won => {
            print(self.render(true, none));
            print("You win!");
        },
        Lost => {
            print(self.render(true, none));
            print("Boom! You hit a mine.");
        },
        Playing => {},
    };
}

# Play from `self` until it is won or lost, or the player quits or input ends, and
# answer the game as it stood then.
fn play(self: Session) !prints !random !read_stdin_raw !terminal -> Mark[,] {
    match (self.game.status()) {
        Won | Lost => self.game,
        Playing => {
            self.draw();
            read_key()
                .map(|key| match (self.press(key)) {
                    Quit => self.game,
                    Continue(next) => play(next),
                    FirstReveal(first) => play(first.start_mining()),
                })
                .value_or(self.game)
        },
    }
}.test({
    let origin: (u64, u64) = (0, 0);
    let mined = Session { game: new_game(2, 2).add_mines([(0, 0)]), cursor: origin, mined: true };
    let safe = Session { game: new_game(2, 2), cursor: origin, mined: true };
    let board_moves = ["move 4,0", "move 0,0"];

    // Input that ends at once: one frame drawn, and the game as it was.
    let nothing = mined.play_typed([]);
    assert(nothing.game == mined.game);
    assert(nothing.moves == board_moves);
    assert(nothing.written == [
        mined.game.render(false, some(origin)),
        "arrows move, r reveals, f flags, q quits",
    ]);

    // `q` quits after the first frame, and keys past it are never read.
    assert(mined.play_typed([QUIT_KEY, REVEAL_KEY]) == nothing);

    // An arrow key is three bytes; this one moves the cursor down, and the next
    // frame shows it there.
    let down: (u64, u64) = (1, 0);
    let moved = mined.play_typed([27, 91, 66]);
    assert(moved.game == mined.game);
    assert(moved.moves == [..board_moves, ..board_moves]);
    assert(moved.written[2] == some(mined.game.render(false, some(down))));

    // `r` on a mine ends the game, and on the one safe cell of a board wins it; a
    // finished game is not drawn again.
    assert(mined.play_typed([REVEAL_KEY]).game.status() == Lost);
    assert(safe.play_typed([REVEAL_KEY]).game.status() == Won);
    assert(mined.play_typed([REVEAL_KEY]).moves == board_moves);

    // `f` flags the cell, and the next frame shows the flag under the cursor.
    let flagged = mined.play_typed([FLAG_KEY]);
    assert(flagged.game == mined.game.toggle_flag(origin));
    assert(flagged.written[2] == some(flagged.game.render(false, some(origin))));

    // The first `r` of a game places the mines, away from the cursor, and opens the
    // cells around it; it is never a loss, and a flag put down before it stays.
    let middle: (u64, u64) = (3, 3);
    let fresh = Session { game: new_game(8, 8), cursor: middle, mined: false };
    let first = fresh.play_typed([REVEAL_KEY]);
    assert(first.game.status() == Playing);
    assert(first.game[middle] == some(Revealed(false)));
    assert([middle, ..first.game.neighbors(middle)].all(|cell| first.game[cell] == some(Revealed(
        false,
    ))));
    let flag_first = Session { ..fresh, game: fresh.game.toggle_flag((0, 0)) };
    let kept = flag_first.play_typed([REVEAL_KEY]);
    assert(kept.game[(0, 0)] == some(Flagged(kept.game.is_mine((0, 0)))));
    // On a flagged cell nothing is revealed, so no mines are placed yet either.
    let guarded = Session { ..fresh, cursor: origin, game: fresh.game.toggle_flag(origin) };
    assert(guarded.play_typed([REVEAL_KEY]).game == guarded.game);
})

# What a game made of `typed` keys, pressed one after another, left behind: the game
# at the end, the terminal operations that moved its cursor, and what was written to
# it.
struct Played { game: Mark[,], moves: str[], written: str[] }

# `play` from `self`, with `typed` as the keys pressed and nothing reaching the real
# terminal.
fn play_typed(self: Session, typed: u8[]) -> Played {
    mut remaining = typed;
    mut moves: str[] = [];
    mut written: str[] = [];
    mut game = self.game;
    shim read_stdin_raw {
        read_byte = || {
            let next = remaining.first();
            set remaining = remaining.drop_first();
            next
        },
    } {
        shim terminal {
            clear_terminal = || {
                set moves.push("clear");
            },
            move_to = |row, column| {
                set moves.push(`move {row},{column}`);
            },
            enter_alternate_screen = || {
                set moves.push("enter");
            },
            leave_alternate_screen = || {
                set moves.push("leave");
            },
        } {
            shim prints {
                print = |text| {
                    set written.push(text);
                },
                put = |text| {
                    set written.push(text);
                },
            } {
                shim random seeded_with_int(1) {
                    set game = play(self);
                };
            };
        };
    };
    Played { game, moves, written }
}

# Play on the standard 8 by 8 board with 10 mines, which the first reveal places. The mines are different every
# game; `./aipl run -- SEED` plays the same game again for the same number. The
# board is drawn on the terminal's second screen, which is put away when play
# ends, so the shell's screen and prompt are as they were; the result is then
# printed on the first.
fn main(args: str[]) !prints !read_stdin_raw !terminal !clock -> !Error {
    let size: u64 = 8;
    let origin: (u64, u64) = (0, 0);
    shim random {
        match (args) {
            [] => seeded_with_clock(),
            [text] => seeded_with_int(text.int_parse().value_or_err(`not a seed: {text}`)?),
            _ => err("usage: minesweeper [SEED]")?,
        }
    } {
        enter_alternate_screen();
        let game = play(Session { game: new_game(size, size), cursor: origin, mined: false });
        leave_alternate_screen();
        game.report();
    };
    ok()
}
