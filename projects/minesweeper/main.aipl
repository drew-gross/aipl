# Minesweeper for the terminal.
#
# The mines are placed at random (`place_mines`), seeded in `main`.

import {
    all,
    any,
    count_if,
    drop_first,
    equal as ==,
    extend,
    filter,
    first,
    greater_than_or_equal as >=,
    grid_from,
    has,
    int_parse,
    is_nonempty,
    join,
    len,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    not_equal as !=,
    print,
    push,
    random_u64,
    read_line,
    saturating_remainder as %,
    split,
    to_set,
    trim,
    value_or,
    value_or_err,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
} from builtins;

# A board and what the player has done to it: one `Mark` for each cell.
struct Game { width: u64, height: u64, marks: Mark[,] }

# A place on the board, counted from 0 at the top left.
struct Cell { row: u64, column: u64 }

# What the player has done to a cell, and whether it holds a mine.
variant Mark = Hidden(bool) | Flagged(bool) | Revealed(bool)

# What the player asked for.
variant Command = Reveal(Cell) | Flag(Cell) | Quit

# Where a game stands.
variant Status = Playing | Won | Lost

# `count` distinct cell numbers below `cells`, drawn at random. A cell's number
# counts row by row, so the cell at `row`, `column` of a board `width` wide is
# `row * width + column`.
fn place_mines(count: u64, cells: u64) !random -> u64[] {
    mut mines: u64[] = [];
    while (mines.len() < count) {
        let cell = random_u64() % cells;
        if (!mines.any(|mine| mine == cell)) {
            set mines.push(cell);
        };
    }
    mines
}.test({
    let mines = shim random seeded_with_int(1) { place_mines(10, 64) };
    assert(mines.len() == 10);
    assert(mines.all(|mine| mine < 64));
    // No cell twice.
    assert(mines.to_set().len() == 10);
    // The same seed, the same mines; every cell can be a mine.
    assert(mines == shim random seeded_with_int(1) { place_mines(10, 64) });
    assert(shim random seeded_with_int(1) { place_mines(4, 4) }.to_set().len() == 4);
})

# The cell at `row`, `column`.
fn cell_at(row: u64, column: u64) -> Cell { row, column }

# A game on a `width` by `height` board with mines at the cell numbers `mines`,
# every cell hidden.
fn new_game(width: u64, height: u64, mines: u64[]) -> Game {
    let mined = mines.to_set();
    mut marks: Mark[] = [];
    for (let number : 0..width * height) {
        set marks.push(Hidden(mined.has(number)));
    }
    Game { width, height, marks: grid_from(width, marks) }
}.test({
    let expected: Mark[,] = [
        [Hidden(false), Hidden(true), Hidden(false)],
        [Hidden(false), Hidden(true), Hidden(false)],
    ];
    assert(new_game(3, 2, [1, 4]).marks == expected);
})

# What the player has done to `cell`, or `none` when it is off the board.
fn mark(self: Game, Cell { row, column }) -> Mark? { self.marks[row, column] }

# Whether `cell` holds a mine, whatever the player has done to it.
fn is_mine(self: Game, cell: Cell) -> bool {
    match (self.mark(cell)) {
        some(Hidden(mine)) | some(Flagged(mine)) | some(Revealed(mine)) => mine,
        none => false, #[allow]
    }
}.test({
    let game = new_game(2, 2, [3]).toggle_flag(cell_at(1, 1)).reveal(cell_at(0, 0));
    assert(game.is_mine(cell_at(1, 1)));
    assert(!game.is_mine(cell_at(0, 0)));
    assert(!game.is_mine(cell_at(4, 4)));
})

# The cells touching `cell`, including diagonally, that are on the board.
#
# Offsets run 0 to 2 for -1 to +1 so that no row or column is ever negative: a
# neighbour in row `r` and column `c` has `r` and `c` one more than its real
# position, and is on the board when both are between 1 and the size.
fn neighbors(self: Game, cell: Cell) -> Cell[] {
    let row = cell.row + 1;
    let column = cell.column + 1;
    mut out: Cell[] = [];
    for (let up : 0..3) {
        for (let left : 0..3) {
            let r = row + up - 1;
            let c = column + left - 1;
            let on_board = r >= 1 && r <= self.height && c >= 1 && c <= self.width;
            if (on_board && (up != 1 || left != 1)) {
                set out.push(cell_at(r - 1, c - 1));
            };
        }
    }
    out
}.test({
    let game = new_game(3, 3, []);
    assert(game.neighbors(cell_at(0, 0)) == [cell_at(0, 1), cell_at(1, 0), cell_at(1, 1)]);
    assert(game.neighbors(cell_at(1, 1)) == [
        cell_at(0, 0),
        cell_at(0, 1),
        cell_at(0, 2),
        cell_at(1, 0),
        cell_at(1, 2),
        cell_at(2, 0),
        cell_at(2, 1),
        cell_at(2, 2),
    ]);
    assert(game.neighbors(cell_at(2, 2)) == [cell_at(1, 1), cell_at(1, 2), cell_at(2, 1)]);
})

# How many of the cells touching `cell` hold a mine.
fn adjacent_mines(self: Game, cell: Cell) -> u64 {
    self.neighbors(cell).count_if(|n| self.is_mine(n))
}.test({
    let game = new_game(3, 3, [0, 2, 5]);
    assert(game.adjacent_mines(cell_at(0, 1)) == 3);
    assert(game.adjacent_mines(cell_at(1, 1)) == 3);
    assert(game.adjacent_mines(cell_at(2, 0)) == 0);
})

# Reveal each cell of `frontier` that is still hidden and holds no mine, and
# whenever nothing around a revealed cell is a mine, the cells around it too: a
# click on an empty region opens the whole region and its border.
fn flood(mut self: Game, frontier: Cell[]) {
    mut pending = frontier;
    while (pending.is_nonempty()) {
        let cell = pending[0].value_or(cell_at(0, 0));
        set pending = pending.drop_first();
        match (self.mark(cell)) {
            some(Hidden(mine)) => {
                if (!mine) {
                    set self.marks[cell.row, cell.column] = Revealed(false) else {};
                    if (self.adjacent_mines(cell) == 0) {
                        set pending.extend(self.neighbors(cell));
                    };
                };
            },
            some(Flagged(..)) | some(Revealed(..)) | none => {},
        };
    }
}

# `self` after the player reveals `cell`. A flagged or already revealed cell is
# left alone.
fn reveal(mut self: Game, cell: Cell) {
    match (self.mark(cell)) {
        some(Hidden(mine)) => {
            if (mine) {
                set self.marks[cell.row, cell.column] = Revealed(true) else {};
            } else {
                set self.flood([cell]);
            };
        },
        some(Flagged(..)) | some(Revealed(..)) | none => {},
    };
}.test({
    // A number stops at itself.
    let game = new_game(3, 3, [8]);
    assert(game.reveal(cell_at(2, 1)).mark(cell_at(2, 1)) == some(Revealed(false)));
    assert(game.reveal(cell_at(2, 1)).mark(cell_at(2, 0)) == some(Hidden(false)));

    // A region with no mines around it opens, border and all: here that is
    // every cell but the mine, so it wins.
    assert(game.reveal(cell_at(0, 0)).status() == Won);
})

# `self` after the player flags `cell`, or takes the flag off it. A revealed cell
# cannot be flagged.
fn toggle_flag(mut self: Game, cell: Cell) {
    match (self.mark(cell)) {
        some(Hidden(mine)) => {
            set self.marks[cell.row, cell.column] = Flagged(mine) else {};
        },
        some(Flagged(mine)) => {
            set self.marks[cell.row, cell.column] = Hidden(mine) else {};
        },
        some(Revealed(..)) | none => {},
    };
}.test({
    let game = new_game(2, 2, [3]);
    let corner = cell_at(0, 0);
    assert(game.toggle_flag(corner).mark(corner) == some(Flagged(false)));
    // Flagging twice takes the flag off again.
    assert(game.toggle_flag(corner).toggle_flag(corner).mark(corner) == some(Hidden(false)));
    // A flag protects its cell from a reveal.
    assert(game.toggle_flag(corner).reveal(corner).mark(corner) == some(Flagged(false)));
    // A revealed cell takes no flag.
    assert(game.reveal(corner).toggle_flag(corner).mark(corner) == some(Revealed(false)));
    // Off the board: nothing happens.
    assert(game.toggle_flag(cell_at(9, 9)) == game);
})

# Whether the game is still going: lost once a mine is revealed, won once every
# cell without a mine is.
fn status(self: Game) -> Status {
    if (self.marks.any(|mark| mark == Revealed(true))) {
        Lost
    } else if (self.marks.any(|mark| mark == Hidden(false) || mark == Flagged(false))) {
        Playing
    } else {
        Won
    }
}.test({
    let game = new_game(2, 2, [3]);
    assert(game.status() == Playing);
    assert(game.reveal(cell_at(1, 1)).status() == Lost);
    assert(game.reveal(cell_at(0, 0)).reveal(cell_at(0, 1)).reveal(cell_at(1, 0)).status() == Won);
})

# What is drawn for `cell`: `#` hidden, `F` flagged, `.` revealed with nothing
# around it, a digit counting the mines around it, `*` a mine (shown once
# revealed, or when `show_mines`).
fn symbol(self: Game, cell: Cell, show_mines: bool) -> str {
    match (self.mark(cell)) {
        some(Revealed(mine)) => if (mine) {
            "*"
        } else if (self.adjacent_mines(cell) == 0) {
            "."
        } else {
            `{self.adjacent_mines(cell)}`
        },
        some(Flagged(..)) => "F",
        some(Hidden(mine)) => if (show_mines && mine) { "*" } else { "#" },
        none => "#", #[allow]
    }
}

# The board as text: a row of column numbers, then each row led by its number.
fn render(self: Game, show_mines: bool) -> str {
    mut heads: str[] = [];
    for (let column : 0..self.width) {
        set heads.push(`{column}`);
    }
    mut lines: str[] = [`  {heads.join(sep=" ")}`];
    for (let row : 0..self.height) {
        mut symbols: str[] = [];
        for (let column : 0..self.width) {
            set symbols.push(self.symbol(cell_at(row, column), show_mines));
        }
        set lines.push(`{row} {symbols.join(sep=" ")}`);
    }
    lines.join(sep="\n")
}.test({
    let game = new_game(3, 2, [5]).reveal(cell_at(0, 0));
    assert(game.render(false) == """
          0 1 2
        0 . 1 #
        1 . 1 #
    """);
})

# The number `self` holds at `at`.
fn number(self: str[], at: u64) -> u64!str {
    let word = self[at].value_or_err("missing a number")?;
    let parsed = word.int_parse().value_or_err(`not a number: {word}`)?;
    // A negative number wraps to a huge one, which no board is as big as.
    let unsigned: u64 = parsed;
    ok(unsigned)
}.test({
    assert(["r", "4"].number(1) == ok(4));
    assert(["r"].number(1) == err("missing a number"));
    assert(["r", "x"].number(1) == err("not a number: x"));
})

# What the player typed: `r ROW COLUMN` to reveal, `f ROW COLUMN` to flag or
# unflag, `q` to quit.
fn parse_command(self: Game, line: str) -> Command!str {
    let words = line.trim().split(" ").filter(is_nonempty);
    let verb = words.first().value_or_err("type r ROW COLUMN, f ROW COLUMN or q")?;
    if (verb == "q") {
        ok(Quit)
    } else if (verb == "r" || verb == "f") {
        let row = words.number(1)?;
        let column = words.number(2)?;
        if (row < self.height && column < self.width) {
            let cell = cell_at(row, column);
            ok(if (verb == "r") { Reveal(cell) } else { Flag(cell) })
        } else {
            err("that is off the board")
        }
    } else {
        err(`unknown command: {verb}`)
    }
}.test({
    let game = new_game(3, 2, []);
    assert(game.parse_command("r 1 2") == ok(Reveal(cell_at(1, 2))));
    assert(game.parse_command("  f   0 1 ") == ok(Flag(cell_at(0, 1))));
    assert(game.parse_command("q") == ok(Quit));
    assert(game.parse_command("") == err("type r ROW COLUMN, f ROW COLUMN or q"));
    assert(game.parse_command("r 2 0") == err("that is off the board"));
    assert(game.parse_command("r -1 0") == err("that is off the board"));
    assert(game.parse_command("r 1") == err("missing a number"));
    assert(game.parse_command("x") == err("unknown command: x"));
})

# Play from `game` until it is won or lost, or the player quits or input ends.
# Returns the exit code: 0 for a win or a quit, 1 for a loss.
fn play(game: Game) !prints !read_stdin -> i64 {
    match (game.status()) {
        Won => {
            print(game.render(true));
            print("You win!");
            0
        },
        Lost => {
            print(game.render(true));
            print("Boom! You hit a mine.");
            1
        },
        Playing => {
            print(game.render(false));
            print("r ROW COLUMN to reveal, f ROW COLUMN to flag, q to quit");
            match (read_line()) {
                none => 0, #[allow]
                some(line) => match (game.parse_command(line)) {
                    err(message) => {
                        print(message);
                        play(game)
                    },
                    ok(command) => match (command) {
                        Quit => 0,
                        Reveal(cell) => play(game.reveal(cell)),
                        Flag(cell) => play(game.toggle_flag(cell)),
                    },
                },
            }
        },
    }
}

# Play on the standard 8 by 8 board with 10 mines. The mines are different every
# game; `./aipl run -- SEED` plays the same game again for the same number.
fn main(args: str[]) !prints !read_stdin !clock -> i64 {
    match (args.first()) {
        none => shim random seeded_with_clock() { play(new_game(8, 8, place_mines(10, 64))) },
        some(text) => match (text.int_parse()) {
            none => {
                print(`not a seed: {text}`);
                1
            },
            some(number) => {
                let seed: u64 = number;
                shim random seeded_with_int(seed) { play(new_game(8, 8, place_mines(10, 64))) }
            },
        },
    }
}
