/target

# Claude Code: share project config and skills; keep personal overrides and
# local worktrees out.
/.claude/settings.local.json
/.claude/worktrees/

# The dogfood IR is a working-tree intermediate: what is checked in is the
# compiled `dogfood.o` beside its manifest. Regenerating or staging the IR
# leaves these behind, and neither belongs in a commit.
/crates/aipl-codegen/src/*.clif
/crates/aipl-codegen/src/*.clif.staged

# The VS Code extension's npm dependencies: `package-lock.json` pins them,
# and `npm install` in `editors/vscode` restores them.
/editors/vscode/node_modules
/editors/vscode/out
/editors/vscode/*.vsix
