# A dict is iterable, and **a dict is indexed by its key**: the two-binder form
# binds the key and the value, exactly as it binds the position and the element
# over an array. One binder is the value, the way one binder over an array is the
# element.
#
#   for (let k, v : d)   key and value      for (let i, x : xs)  position, element
#   for (let v : d)      values             for (let x : xs)     elements
#
# No order is promised, for the same reason a set's iteration order is not: a
# `#{K: V}` says nothing about order, and the representation that gives it one
# today is not a guarantee to write code against. (Ordered dicts, like ordered
# sets, are a separate thing.)
#
# Underneath, the loop is the counted walk over the dict's `[key][value]` pairs
# that mono writes (`__dict_key_at` / `__dict_value_at`). The position stays the
# compiler's: it is meaningless to write code against an order nothing promised,
# so only the key is handed to the program.

import {
    extend,
    len,
    print,
    to_str,
    wrapping_add_assign as +=,
    wrapping_increment as ++,
} from builtins;

fn counts() -> #{str: i64} { #{"a": 1, "b": 2, "c": 3} }

fn main() !prints {
    // Both binders.
    mut pairs = "";
    for (let k, v : counts()) {
        set pairs.extend(`{k}={v};`);
    }
    print(pairs);

    // One binder: the values.
    mut sum = 0;
    for (let v : counts()) {
        set sum += v;
    }
    print(sum.to_str());

    // Heap keys *and* heap values: each read is a fresh reference the binding
    // owns, so both outlive the dict they were read from — `label` returns one.
    print(label(#{"ab": "xy"}));

    // An integer-keyed dict with array values: an element read per iteration.
    mut cells = 0;
    mut keys_seen: u64 = 0;
    for (let n, xs : #{1: [1, 2], 2: [3]}) {
        set cells += n;
        set keys_seen += xs.len();
    }
    print(`{cells} {keys_seen}`);

    // An empty dict iterates nothing — the walk is bounded by `len`.
    let empty: #{str: i64} = #{};
    mut ran = 0;
    for (let k, v : empty) {
        print(`{k}{v}`);
        set ran++;
    }
    print(ran.to_str());

    // Nested, over the same dict: the inner loop's own position is declared per
    // entry, so it restarts rather than carrying over.
    mut grid = "";
    for (let a : counts()) {
        for (let b : counts()) {
            set grid.extend(`{a}{b} `);
        }
    }
    print(grid);

    // The binders are ordinary immutable bindings, so they shadow and a `mut`
    // outside is written as usual.
    let v = 99;
    mut last = 0;
    for (let v : counts()) {
        set last = v;
    }
    print(`{v} {last}`);
}

# The key read out of `d` is the binding's own reference, so it is still good
# after `d` is gone.
fn label(d: #{str: str}) -> str {
    mut out = "";
    for (let k, v : d) {
        set out = `{k}->{v}`;
    }
    out
}
