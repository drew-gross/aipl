# A set or a dict may be an *array* element — both are heap blocks addressed by
# an 8-byte pointer, the same shape a nested array element has, so the element
# retain/drop helpers carry them (see `tests/cases/arrays/of_sets_and_dicts`).
#
# An optional core and a dict value are different: those store their payload
# inline rather than behind those helpers. An optional takes a set (see
# `tests/cases/options/optional_of_set`) but not yet a dict, and a dict value takes
# neither. This fixture pins that boundary — the positions that are still refused,
# and the reason the message gives.

import { wrapping_add as + } from builtins;

fn opt_core() -> i64 {
    let d: #{i64: i64}? = none;
    0
}

fn dict_value() -> i64 {
    let d: #{str: #{i64}} = #{};
    0
}

fn main() -> i64 { opt_core() + dict_value() }
--- errors ---
error: fn "opt_core": a dict can be an array element but not an optional or dict element
  --> ./tests/cases/dicts/err_container_nesting.aipl:14:27
   |
14 |     let d: #{i64: i64}? = none;
   |                           ^^^^

error: fn "dict_value": a set can be an array or optional element but not a dict value
  --> ./tests/cases/dicts/err_container_nesting.aipl:19:29
   |
19 |     let d: #{str: #{i64}} = #{};
   |                             ^^^
