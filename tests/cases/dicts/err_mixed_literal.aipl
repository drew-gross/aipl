# A `#{ .. }` literal must be all set elements or all `key: value` pairs.

import { print } from builtins;

fn main() -> i64 {
    let d = #{1, 2: "a"};
    0
}
--- errors ---
error: a "#{ .. }" literal can't mix set elements and "key: value" pairs — use either all bare elements (a set) or all pairs (a dict)
