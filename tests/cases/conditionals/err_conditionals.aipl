// Every *check-phase* conditional error, in one file, reported in one run.
// `err_if_without_parens` is a parse error and stays separate.

// Branches of different types.
fn if_branch_type_mismatch() -> i64 { if (true) { 1 } else { "two" } }

// A condition that isn't a bool.
fn if_cond_not_bool() -> i64 { if (5) { 1 } else { 2 } }

// No `else`, so the `then` branch must produce nothing.
fn if_no_else_non_unit_then() { if (true) { 2 } }

fn main() {}
