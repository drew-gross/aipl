# A report of a program that imports a companion file. The `--- file: ---` section
# is staged beside the source (the file is loaded from there, rooted at its own
# directory), so the import resolves exactly as it does under `check`; the
# report is of the importing program, with the companion's function in it.

import { print, to_str } from builtins;
import { answer } from "./helper.aipl";

fn main() !prints {
    print(to_str(answer()));
}
--- file: helper.aipl ---
pub fn answer() -> i64 { 42 }
