# A `..` is only allowed at the top of an arm or `let`, not in an array pattern inside another pattern.

variant Shape = Pair(i64[])

fn first_of(shape: Shape) -> i64? {
    let Pair([first, ..]) = shape else { return none; };
    some(first)
}

