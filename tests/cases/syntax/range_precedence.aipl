import { Span, print, to_str, wrapping_add as +, wrapping_mul as *, !, &&, == } from builtins;

// Where `..` sits in the precedence table. Loosest to tightest:
//
//     ||   &&   == !=   ..   < > <= >=   + +++ -   * / %
//
// The two ends are what matter. `..` binds *tighter* than equality, so a range
// on the right of `==` is one operand rather than the comparison being swallowed
// into the range's start — `span == 1..2` means `span == (1..2)`, not
// `(span == 1)..2`. And it binds *looser* than arithmetic, so the bounds of a
// range can be computed inline without parentheses.

// Equality against a range literal needs no parentheses.
fn is_one_two(s: Span) -> bool { s == 1..2 }.test({
    assert(is_one_two(1..2));
    assert(!is_one_two(3..4));
    // Explicit parens mean the same thing — the sugar and the struct agree.
    assert(is_one_two(Span { start: 1, end: 2 }));
})

// Arithmetic binds tighter, so each bound is computed first.
fn shifted(a: i64, b: i64) -> Span { a + 1..b * 2 }.test({
    assert(shifted(1, 3) == 2..6);

    // i.e. exactly `(a + 1)..(b * 2)` — both bounds computed independently, so
    // they can even cross over.
    assert(shifted(0, 0) == 1..0);
})

// `&&` is looser than both, so the comparison is its right operand.
fn both(flag: bool, s: Span) -> bool { flag && s == 1..2 }.test({
    assert(both(true, 1..2));
    assert(!both(false, 1..2));
    assert(!both(true, 9..9));
})

// A range used where it started life: slicing, with computed bounds.
fn middle(s: str, at: i64) -> str { s[at..at + 3] }.test({
    assert(middle("hello world", 0) == "hel");
    assert(middle("hello world", 6) == "wor");
})

fn main() !prints {
    print(is_one_two(1..2).to_str());
    print(to_str(shifted(1, 3)));
    print(middle("abcdef", 2));
}
