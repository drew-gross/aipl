# `set xs.push(x);` writes a mutating method's result back to its receiver. A bare `set f(x);` calls
# a closure held in a `mut` variable and writes it back, so what is named has to be that: `print` is
# a function, not a variable.

import { print } from builtins;

fn subject() !prints {
    set print("x");
}
--- check --compile ---
error: set: undeclared variable "print"
 --> ./tests/cases/syntax/err_set_call_no_receiver.aipl:8:9
  |
8 |     set print("x");
  |         ^^^^^
