# A statement's `;` is committed to, so a missing one is reported where it is and
# the parse reads on: every slip in the file comes back from one run, across
# statements and across functions.

fn main() {
    let a = 1
    let b = 2
    let c = a
}

fn other() {
    let d = 4
}
--- errors ---
error: expected `;`, found `let`
 --> ./tests/cases/syntax/err_multiple_missing_semicolons.aipl:7:5
  |
7 |     let b = 2
  |     ^^^

error: expected `;`, found `let`
 --> ./tests/cases/syntax/err_multiple_missing_semicolons.aipl:8:5
  |
8 |     let c = a
  |     ^^^

error: expected `;`, found `}`
 --> ./tests/cases/syntax/err_multiple_missing_semicolons.aipl:9:1
  |
9 | }
  | ^

error: expected `;`, found `}`
  --> ./tests/cases/syntax/err_multiple_missing_semicolons.aipl:13:1
   |
13 | }
   | ^
