# An `int_parse` whose result is passed along by `value_or` or `value_or_err`
# (and a `?` after the latter) takes the integer the whole expression is
# declared to be: those two are generic in their payload, so the position the
# expression sits in is the only thing that can say which integer it is. A
# `u64` still parses past `i64::MAX` this way.

import { int_parse, print, value_or, value_or_err } from builtins;

fn takes_u64(n: u64) -> u64 { n }

fn takes_u8(n: u8) -> u8 { n }

fn seed(text: str) -> u64!str {
    ok(takes_u64(text.int_parse().value_or_err(`not a seed: {text}`)?))
}

fn main() !prints {
    print(`{seed("18446744073709551615")} {seed("x")}`);
    print(`{takes_u64("18446744073709551615".int_parse().value_or(0))}`);
    print(`{takes_u8("255".int_parse().value_or(0))} {takes_u8("256".int_parse().value_or(7))}`);
}
--- stdout ---
ok(18446744073709551615) err("not a seed: x")
18446744073709551615
255 7
