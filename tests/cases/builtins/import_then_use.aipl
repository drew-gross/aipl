# Builtins are usable once imported, with the same `import { .. }`
# syntax as files — just `from builtins` instead of a path.

import { equal as ==, len, push } from builtins;

fn pushed_len() -> u64 {
    mut xs = [1, 2];
    set xs.push(3);
    len(xs)
}.test({
    assert(pushed_len() == 3);
})
