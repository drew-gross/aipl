// The import is deliberately never used — the conflict with the local `len`
// below is the whole point — so `#[allow]` squelches the unused-import lint,
// leaving the conflict as the only error.
import { len } from builtins; #[allow]

fn len(x: i64) -> i64 { x }

fn main() -> i64 { 0 }
--- errors ---
