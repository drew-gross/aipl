# `xs.range()` is `0..xs.len()` as a `Span`: every index the receiver's elements
# sit in. A `Span` rather than a type of its own because the language already has
# one for a half-open range — which is what makes `xs[xs.range()]` the identity
# slice, and `xs.range().map(..)` the index-wise counterpart of `xs.map(..)`.

import { equal as ==, map, print, range, to_str } from builtins;

fn main() !prints {
    print([10, 20, 30].range().to_str());
    // Empty in, empty out — not an error, and not a one-element range.
    print([1, 2][..0].range().to_str());
    // Only the length is read, so the element type never reaches the result.
    print(range(["a", "b"]).to_str()); // free-call form
    // The whole receiver, by the span that names it.
    let xs = ["a", "b", "c"];
    print((xs[xs.range()] == xs).to_str());
    // What it is for: the positions, mapped.
    print(xs.range().map(|i| `_{i}`).to_str());
}
