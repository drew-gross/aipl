# A constant is importable exactly as a `pub fn` is — it rides the same
# per-file view — and a private one is not.

import { print } from builtins;
import { SHARED } from "./scopes.aipl";

fn main() !prints {
    print(SHARED);
}
--- file: scopes.aipl ---
import { len } from builtins;

pub let SHARED = "shared";

// Private to this file, and used here — so the export check has something to
// distinguish from `SHARED` rather than an unused declaration.
let PRIVATE = "private";

pub fn private_len() -> u64 { PRIVATE.len() }
--- stdout ---
shared

