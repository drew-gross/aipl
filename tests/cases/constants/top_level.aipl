# A top-level `let NAME = <literal>;` names a literal. The loader substitutes
# each use with that literal and drops the declaration, so nothing past the
# loader knows constants exist — which is why the value must *be* a literal
# (there is no point at which a computation would run) and why there is no
# `mut` form (a mutable one would need storage).
#
# The ALL_CAPS rule is what keeps a substituted use readable at the site that
# reads it: the name says "not a binding from around here".

import { print } from builtins;

# The TextMate scope a keyword is painted with.
pub let S_KEYWORD: str = "keyword.control.aipl";

let GREETING = "hello";

// The annotation is optional, and narrows: a bare literal would be `i64`.
let PORT: u16 = 8080;

// A signed literal is a literal.
let OFFSET = -1;

let ENABLED = true;

let TAB = '\t';

fn shown(port: u16) -> str { `{port}` }

fn main() !prints {
    print(S_KEYWORD);
    print(GREETING);
    print(`{shown(PORT)} {OFFSET} {ENABLED} [{TAB}]`);
}
--- stdout ---
keyword.control.aipl
hello
8080 -1 true [	]

