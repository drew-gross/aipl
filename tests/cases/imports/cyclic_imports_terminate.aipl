# a and b form a cycle (a imports from b, b imports back from a).
# The entry only imports from a; the cycle is internal. The loader
# must terminate rather than walking the cycle forever.

import { equal as ==, print, to_str } from builtins;
import { a_fn } from "./a.aipl";

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(to_str(a_fn()));
    };
    assert(out == "42\n");
})
--- file: a.aipl ---
import { b_fn } from "./b.aipl";
import { wrapping_add as + } from builtins;
pub fn a_fn() -> i64 { 10 + b_fn() }
--- file: b.aipl ---
// Never referenced — importing back from `a` is what closes the cycle, which is
// the whole point here — so `#[allow]` squelches the unused-import lint.
import { a_fn } from "./a.aipl"; #[allow]
pub fn b_fn() -> i64 { 32 }
