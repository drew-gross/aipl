# Operators are imported individually by spelling, like any other builtin.

import {
    equal as ==,
    less_than as <,
    print,
    to_str,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

fn compute(a: i64, b: i64) -> i64 { a * b + a }.test({
    assert(compute(3, 4) == 15);
    assert(2 < 3);
})

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(to_str(compute(3, 4))); // 15
    };
    assert(out == "15\n");
})
