# A constructor must be brought into scope: using `A` bare without importing it
# (or writing `Color.A`) is an error, even though the variant `Color` itself is
# imported.

import { Color } from "./color.aipl";

fn take(c: Color) -> i64 { 0 }

fn main() -> i64 { take(A(5)) }
--- file: color.aipl ---
variant Color = A(i64) | B
--- check --compile ---
error: call to undefined fn "A"
 --> ./tests/cases/imports/err_constructor_not_imported.aipl:9:25
  |
9 | fn main() -> i64 { take(A(5)) }
  |                         ^^^^
