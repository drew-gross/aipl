# A constructor referenced only as an `if (let ..)` pattern is a use of its
# import: the unused-import lint reads the pattern of an `if let` exactly as
# it reads a `match` arm's, so `Circle` below is not reported as dead.

import { equal as ==, print } from builtins;
import { Circle, Shape } from "./shapes.aipl";

fn radius(s: Shape) -> i64 {
    if (let Circle(r) = s) { return r; };
    0
}

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(`{radius(Shape.Circle(5))}`);
        print(`{radius(Shape.Empty)}`);
    };
    assert(out == """
        5
        0

    """);
})
--- file: shapes.aipl ---
variant Shape = Circle(i64) | Empty
