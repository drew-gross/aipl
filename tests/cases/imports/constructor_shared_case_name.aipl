# Two different variants, defined in different files, may reuse the same
# constructor name (`A`): every in-scope reference is variant-qualified
# internally, so there is no collision. `import { A as ColorA }` disambiguates at
# the use site, and `Size.A` names the other one directly.

import { equal as ==, print, to_str, wrapping_add as + } from builtins;
import { A as ColorA, hue } from "./color.aipl";
import { Size, size_rank } from "./size.aipl";

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let c = ColorA; // Color's A, via import alias
        let s = Size.A; // Size's A, qualified
        print((c.hue() + s.size_rank()).to_str()); // 1 + 10 == 11
    };
    assert(out == "11\n");
})
--- file: color.aipl ---
variant Color = A | B

pub fn hue(self: Color) -> i64 { match (self) { A => 1, B => 2 } }
--- file: size.aipl ---
variant Size = A | C

pub fn size_rank(self: Size) -> i64 { match (self) { A => 10, C => 20 } }
