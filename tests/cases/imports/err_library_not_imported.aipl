# Calling a library's function without importing it says which library to import it from.

import { len } from builtins;

fn main() -> u64 { [["1"]].tabulate(["N"]).len() }
--- check --compile ---
error: call to undefined fn "tabulate" — "tabulate" is a builtin; import it with `import { tabulate } from tabulate;`
