# A bare operator builtin is called with the operator's arity: the loader
# lowers the call to a one- or two-operand primitive node, so a miscount is
# rejected at that point rather than surfacing later as a call to a function
# that does not exist.

import { equal } from builtins;

fn f() -> bool { equal("a") }
--- check --compile ---
error: "equal" takes 2 arguments, got 1
 --> ./tests/cases/imports/err_operator_builtin_bare_arity.aipl:8:18
  |
8 | fn f() -> bool { equal("a") }
  |                  ^^^^^^^^^^
