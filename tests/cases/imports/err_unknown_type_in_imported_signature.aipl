# A signature error inside an imported file points into that file, under its
# own path, not at a position in this one.

import { area } from "./shapes.aipl";

fn main() {
    let a = area(1);
}
--- file: shapes.aipl ---
pub fn area(side: i64) -> Measure { 0 }
--- check --compile ---
error: unknown type "Measure"
 --> ./tests/cases/imports/err_unknown_type_in_imported_signature.aipl:7:13
  |
7 |     let a = area(1);
  |             ^^^^^^^

error: unknown type "Measure"
 --> ./tests/cases/imports/shapes.aipl:1:8
  |
1 | pub fn area(side: i64) -> Measure { 0 }
  |        ^^^^
