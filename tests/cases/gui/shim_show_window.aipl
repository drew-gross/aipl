# `show_window` is the `gui` effect's one operation: it opens a window and waits until it is
# closed. A test shims it, so the window is never opened and the program under test learns what
# it would have shown.

import { equal as ==, push } from builtins;
import { show_window } from gui;

# Greets the person in a window.
fn greet(name: str) !gui { show_window("Greeting", `Hello, {name}!`) }.test({
    mut shown: str[] = [];
    shim gui {
        show_window = |title, text| {
            set shown.push(`{title}|{text}`);
        },
    } {
        greet("World");
        greet("again");
    };
    assert(shown == ["Greeting|Hello, World!", "Greeting|Hello, again!"]);
})
