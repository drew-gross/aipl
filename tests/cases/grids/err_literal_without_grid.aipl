# A nested literal is an array of arrays unless a grid is expected, so reading
# it with two indexes is an error.

fn subject() {
    let rows = [[1, 2], [3, 4]];
    let cell = rows[0, 1];
}
--- check --compile ---
error: fn "grid_get" arg 0: expected i64[,], got i64[][]
 --> ./tests/cases/grids/err_literal_without_grid.aipl:6:16
  |
6 |     let cell = rows[0, 1];
  |                ^^^^
