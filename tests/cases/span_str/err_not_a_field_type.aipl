// Like `Error`, `SpanStr` is a named type with no layout of its own, so it is
// not (yet) a struct field, array element, or dict value — only a parameter,
// return, or local. Storing one in a `Token` is the follow-on `SPAN_STR.md`
// records, not part of introducing the type.
import { SpanStr } from builtins;

struct Tok { text: SpanStr, kind: u64 }

fn kind_of(t: Tok) -> u64 { t.kind }

fn main() {}
--- errors ---
error: struct Tok: field text has type SpanStr, but struct fields must be an integer (i8..i64, u8..u64), bool, char, str, a function, a struct, a variant, an array, or an optional of (an integer, bool, char, str, an array, or a recursive type)
