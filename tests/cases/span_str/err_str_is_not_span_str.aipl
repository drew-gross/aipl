// Assignability is one-way. A `str` is not a `SpanStr`: only the `span_str`
// builtin, which anchors its source so `data - base` is an offset into it,
// makes one — which is what keeps `.span()` total.
import { SpanStr } from builtins;

fn widen(s: str) -> SpanStr { s }

fn main() {}
