// A named str-repr type is not (yet) an array or optional element, exactly as
// `Error` has never been. The diagnostic names it as written, not by its
// canonical `__builtin_SpanStr`.
import { SpanStr, len } from builtins;

fn total(xs: SpanStr[]) -> u64 { len(xs) }

fn main() {}
