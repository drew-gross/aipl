// `SpanStr` is `str` under the hood (`is_str_repr`), so every `str` operation
// accepts one and hands back an ordinary `str`. Nothing here *calls* these
// functions: until the `span_str` builtin lands there is no way to make a
// `SpanStr` value at all, so this case pins what the checker accepts rather
// than what the runtime does.
import { SpanStr, equal as ==, len, print } from builtins;

// Assignability is one-way, and this is the direction that holds: a `SpanStr`
// is usable everywhere a `str` is.
fn narrow(s: SpanStr) -> str { s }

fn size(s: SpanStr) -> u64 { len(s) }

fn is_x(s: SpanStr) -> bool { s == "x" }

fn passthrough(s: SpanStr) -> SpanStr { s }

fn main() !prints {
    print("checked");
}
