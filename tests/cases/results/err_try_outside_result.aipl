// `?` can only appear where a propagated err has somewhere to go: a
// result-returning function, an `!Error` main, or a `.test` body. In a plain
// (non-result) function like this there's nowhere to propagate an err.
fn bad(x: i64!str) -> i64 { x? }

fn main() {
    bad(ok(1));
}
