import { equal as ==, print, to_str } from builtins;

fn scenario() !prints {
    'X'.to_str().print();
}.test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        scenario();
    };
    assert(out == "X\n");
})
