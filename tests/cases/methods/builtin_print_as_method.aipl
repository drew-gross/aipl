import { equal as ==, print } from builtins;

fn scenario() !prints {
    "hello".print();
}.test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        scenario();
    };
    assert(out == "hello\n");
})
