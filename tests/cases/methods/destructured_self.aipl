# A receiver may be destructured and still be the receiver:
# `self: Span { start, end }` binds the fields at the top of the body, as
# `Span { start, end }` does, and keeps `self` bound to the whole value — so the
# function is still a method, and its body can still use `self` itself.

import { print, wrapping_add as +, wrapping_sub as - } from builtins;

struct Span { start: i64, end: i64 }

fn len(self: Span { start, end }) -> i64 { end - start }

// `self` is still the whole value: a spread can start from it.
fn widened(self: Span { end }, by: i64) -> Span { ..self, end: end + by }

// A field may be bound under another name, as in any pattern.
fn describe(self: Span { start as lo, end as hi }) -> str { `{lo}..{hi} ({self.len()})` }

fn main() !prints {
    let s = Span { start: 3, end: 10 };
    print(`{s.len()}`);
    print(s.widened(5).describe());
    print(s.describe());
}
--- stdout ---
7
3..15 (12)
3..10 (7)
