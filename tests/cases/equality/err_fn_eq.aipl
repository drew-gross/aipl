# Function values have no runtime identity — equality on them is rejected.

import { equal as ==, print } from builtins;

fn apply(f: (i64) -> i64) -> bool { f == f }

fn main() {
    print("unreachable");
}
--- errors ---
error: "==" is not supported for function values
 --> ./tests/cases/equality/err_fn_eq.aipl:5:37
  |
5 | fn apply(f: (i64) -> i64) -> bool { f == f }
  |                                     ^^^^^^

error: fn "print" has effect "!prints" but the calling function does not declare it
 --> ./tests/cases/equality/err_fn_eq.aipl:8:5
  |
8 |     print("unreachable");
  |     ^^^^^^^^^^^^^^^^^^^^
