# `read_file_to_string` has the `!read_files` effect; a caller that doesn't
# declare it is rejected.

import { print, read_file_to_string, to_str } from builtins;

fn main() !prints {
    print(to_str(read_file_to_string("x.txt")));
}
--- errors ---
error: fn "read_file_to_string" has effect "!read_files" but the calling function does not declare it
 --> ./tests/cases/files/err_missing_effect.aipl:7:18
  |
7 |     print(to_str(read_file_to_string("x.txt")));
  |                  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
