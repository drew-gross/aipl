import {
    equal as ==,
    saturating_divide as /,
    saturating_remainder as %,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
} from builtins;

// `%` is total, the remainder half of `saturating_divide`. It answers the same
// two pairs a machine remainder cannot, and the answers are chosen so the two
// operators stay coherent with each other:
//
//   - a **zero divisor** answers the dividend. That is the only answer that
//     keeps the division identity intact beside a saturating `/`:
//     `(a / 0) * 0 + (a % 0)` is `MAX * 0 + a`, which is `a`. Answering 0 would
//     break it.
//   - **`MIN % -1`** answers 0, the true remainder — `MIN` is divisible by `-1`.
//     No choice can keep the identity here, because the real quotient is not
//     representable; that is exactly what `MIN / -1` saturating to `MAX` already
//     conceded, so the remainder is simply correct instead.
//
// Both operands come through parameters throughout, so constant folding can't
// answer these before codegen does — and the folder is held to the same rule
// (see `fold_constants`), so the two agree either way.
fn r(x: i64, y: i64) -> i64 { x % y }

fn d(x: i64, y: i64) -> i64 { x / y }

// Unsigned takes its own codegen path (`urem`, and no `MIN % -1` pair to
// answer), so the zero divisor is checked there too.
fn ru(x: u64, y: u64) -> u64 { x % y }

// The identity the zero-divisor answer exists to preserve.
fn identity(x: i64, y: i64) -> bool { d(x, y) * y + r(x, y) == x }.test({
    // Ordinary remainders, truncating toward zero like the division.
    assert(r(20, 4) == 0);
    assert(r(23, 4) == 3);
    assert(r(-10, 3) == -1);

    // A zero divisor answers the dividend rather than dying.
    assert(r(10, 0) == 10);
    assert(r(-10, 0) == -10);
    assert(r(0, 0) == 0);

    // `MIN % -1` is the other unanswerable pair: the true remainder, 0.
    assert(r(-9223372036854775807 - 1, -1) == 0);

    // `MIN % 1` is not an overflow — 0, exactly representable.
    assert(r(-9223372036854775807 - 1, 1) == 0);

    // Unsigned: same rule, one fewer special pair.
    assert(ru(23, 4) == 3);
    assert(ru(10, 0) == 10);
    assert(ru(0, 0) == 0);

    // The identity holds for ordinary pairs *and* across a zero divisor, which
    // is the whole reason the dividend is the answer there.
    assert(identity(23, 4));
    assert(identity(-10, 3));
    assert(identity(10, 0));
    assert(identity(-10, 0));
    assert(identity(0, 0));
})
