# `*` has no bare form; importing it bare is a parse error whose message says
# to import the builtin aliased (`wrapping_mul as *`).

import { * } from builtins;

fn main() -> i64 { 6 * 7 }
--- errors ---
error: the "*" operator has no bare form; import it aliased: `wrapping_mul as *` from builtins
 --> ./tests/cases/arithmetic/err_bare_star.aipl:4:10
  |
4 | import { * } from builtins;
  |          ^
