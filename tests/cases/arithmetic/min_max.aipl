import { concat as +++, equal as ==, len, max, min, wrapping_add as + } from builtins;

// `min`/`max` return the smaller / larger of two comparable values. They carry
// the `ord` bound — the same one `minimum`/`maximum` use — so they work at any
// integer width, on `char`, and on `str`, not just `i64`. Callable free
// (`min(a, b)`, the form to prefer) or as a method (`a.max(b)`); a bare literal
// operand flexes to the other side's type. Equal operands return that value.
//
// Signedness comes from the operand type, which is the whole point of the
// bound: a `u64` above `i64::MAX` compares as the large number it is, where a
// signed compare would read it as negative and pick the wrong side.
fn clamp_low(x: i64, lo: i64) -> i64 { x.max(lo) }.test({
    assert(min(3, 7) == 3);
    assert(max(3, 7) == 7);
    assert(min(7, 3) == 3); // order-independent
    assert(max(7, 3) == 7);
    assert(min(4, 4) == 4); // equal operands
    assert(min(-5, 2) == -5); // negatives compare by value, not magnitude
    assert(max(-9, -2) == -2);
    assert((10).min(3) == 3); // method form
    assert((-5).max(0) == 0);
    assert(clamp_low(-3, 0) == 0); // used inside a function body
    assert(clamp_low(8, 0) == 8);

    // Unsigned: `len()` is `u64`, and this value has the top bit set.
    let huge: u64 = "".len() + 9223372036854775807 + 9223372036854775807;
    let one: u64 = "x".len();
    assert(min(huge, one) == one);
    assert(max(huge, one) == huge);

    // `char` compares by code point.
    assert(min('a', 'z') == 'a');
    assert(max('a', 'z') == 'z');

    // `str` orders lexicographically by bytes, as `<`/`>` and `sort` do. The
    // result aliases whichever operand won, so it is retained and released like
    // any other owned str — the balanced allocation counts below cover it.
    assert(min("pear", "apple") == "apple");
    assert(max("pear", "apple") == "pear");
    assert(min("ab", "abc") == "ab"); // a prefix orders first

    // Freshly allocated (non-static) strings, so the losing operand is freed and
    // the winner is retained — the balanced counts below are what proves it.
    let a = "x" +++ "yz";
    let b = "x" +++ "ya";
    assert(min(a, b) == "xya");
    assert(max(a, b) == "xyz");
})
