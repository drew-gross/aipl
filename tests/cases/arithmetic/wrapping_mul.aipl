# `*` has no bare form — like `+`/`-`, you import a multiply semantics:
# `wrapping_mul as *` (the counterpart of `wrapping_add as +`). It wraps on
# overflow like the other wrapping operators.

import { equal as ==, print, to_str, wrapping_mul as * } from builtins;

fn main() !prints {
    print((6 * 7).to_str()); // 42
    print((2 * 3 * 4).to_str()); // 24
}.test({
    assert(6 * 7 == 42);
    assert(2 * 3 * 4 == 24);
    assert(9223372036854775807 * 2 == -2); // i64::MAX * 2 wraps to -2
})
--- stdout ---
42
24
