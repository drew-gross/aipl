# A `trace` makes `aipl check` fail — *after* running the tests, so a trace a
# test hit has already printed by the time the diagnostic explains itself.
#
# The two sections below are the two halves of that, and they are why
# `--- check exit code ---` exists: `--- check ---` pins the report and says
# nothing about the status, so on its own it cannot tell "the tests ran and
# passed" apart from "and the run failed anyway". Here the test *passes* — the
# report says so — and `check` still exits 1. Nothing but the trace stands
# between this file and a green run.
#
# The diagnostic itself goes to stderr, which `--- check ---` does not capture;
# its wording is covered in `tests/suites/check.rs`.

import { equal as ==, wrapping_add as + } from builtins;

fn bump(v: i64) -> i64 { trace(v + 2) }.test({
    assert(bump(5) == 7);
})
--- check ---
tests/cases/debug/trace_fails_check.aipl:16 v + 2 = 7
1 tests: 1 passed, 0 failed
--- check exit code ---
1
