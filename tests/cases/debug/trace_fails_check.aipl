# A `trace` makes `aipl check` fail — *after* running the tests, so a trace a
# test hit has already printed by the time the diagnostic explains itself.
#
# The section below is the whole of it, and the status follows from what it says:
# the test *passes* — the report says so — and the refusal after the rows is
# why `check` still exits 1. Nothing but the trace stands between this file and a
# green run.
#
# The diagnostic is part of the report, after the rows, so it is pinned below as
# well; its wording is also covered in `tests/suites/check.rs`.
#
# (The count of comment lines is kept, so the line numbers pinned below stay put.)

import { equal as ==, wrapping_add as + } from builtins;

fn bump(v: i64) -> i64 { trace(v + 2) }.test({
    assert(bump(5) == 7);
})
--- check --tests ---
./tests/cases/debug/trace_fails_check.aipl:16 v + 2 = 7
./tests/cases/debug/trace_fails_check.aipl:
    bump: 1 assertion passed
error: `trace(..)` prints for debugging and declares no effect, so `check` refuses a program that still contains one; remove it
  --> ./tests/cases/debug/trace_fails_check.aipl:16:32
   |
16 | fn bump(v: i64) -> i64 { trace(v + 2) }.test({
   |                                ^^^^^
1 tests: 1 passed, 0 failed
