# `trace(expr)` prints where it is, what was written there, and what it came out
# as — `subdir/file.aipl:2 v + 2 = 7`. The file is named relative to the project
# root, so a trace locates itself in a tree rather than just in a file.
#
# It then evaluates to `expr`, so a trace can be wrapped around a subexpression
# in place rather than restructuring the code around it: `trace(w) * trace(h)`
# prints both operands and still multiplies them.
#
# No import, and no effect: it is the one call that prints without one, which is
# what makes it usable the moment you want it. `aipl check` is what keeps that
# from being a hole — it fails on a program that still contains a trace, after
# running the tests, so a trace a test hit has printed before it is reported.
# That is what the section below records: the values first, then the refusal for
# each trace in the program and in the file it imports.

import { equal as ==, wrapping_mul as * } from builtins;
import { bump } from "./subdir/file.aipl";

fn area(w: i64, h: i64) -> i64 { trace(w) * trace(h) }.test({
    assert(bump(5) == 7);
    assert(area(3, 4) == 12);
})
--- file: subdir/file.aipl ---
import { wrapping_add as + } from builtins;
pub fn bump(v: i64) -> i64 { trace(v + 2) }
--- check --tests ---
./tests/cases/debug/subdir/file.aipl:2 v + 2 = 7
./tests/cases/debug/trace.aipl:19 w = 3
./tests/cases/debug/trace.aipl:19 h = 4
./tests/cases/debug/trace.aipl:
    area: 2 assertions passed
error: `trace(..)` prints for debugging and declares no effect, so `check` refuses a program that still contains one; remove it
 --> ./tests/cases/debug/subdir/file.aipl:2:36
  |
2 | pub fn bump(v: i64) -> i64 { trace(v + 2) }
  |                                    ^^^^^

