import { print, to_str, += } from builtins;

// `+=` has no bare form, exactly as `+` and `++` have none: the alias is what
// picks the semantics, so the refusal names both flavors to choose between.
fn main() !prints {
    mut n = 1;
    set n += 2;
    print(n.to_str());
}
