# `+=` has no bare form, exactly as `+` and `++` have none: the alias is what
# picks the semantics, and the grammar refuses the bare spelling with a message
# saying so.

import { +=, print, to_str } from builtins;

fn main() !prints {
    mut n = 1;
    set n += 2;
    print(n.to_str());
}
--- errors ---
error: the "+=" operator has no bare form; pick a semantics and import it aliased, e.g. `wrapping_add_assign as +=` or `saturating_add_assign as +=` from builtins
 --> ./tests/cases/compound_assign/err_bare_import.aipl:5:10
  |
5 | import { +=, print, to_str } from builtins;
  |          ^^
