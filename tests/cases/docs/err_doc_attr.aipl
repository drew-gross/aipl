import { wrapping_add as + } from builtins;

// `.doc("..")` was the old documentation form. It still parses, so that it can
// be refused by name with the migration in the message.
pub fn add(a: i64, b: i64) -> i64 {
    a + b
}.doc("Adds two integers.")
