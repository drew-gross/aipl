import { equal as ==, print, wrapping_add as + } from builtins;

// A `# ..` block in front of a declaration is its documentation. It is ignored
// by run/check/build (only `aipl doc` and `aipl docs` surface it) and attaches
// to any declaration, not just a function — which is what `.doc("..")`, the
// form it replaced, could not do.
# Adds two integers and returns the sum.
#
# A bare `#` is a blank line, so a doc block can have paragraphs.
pub fn add(a: i64, b: i64) -> i64 { a + b }.test({
    assert(add(2, 3) == 5);
    assert(add(-1, 1) == 0);
})

# A point in the plane.
struct Point { x: i64, y: i64 }

# Something or nothing. A variant's cases take `# ..` lines of their own,
# written above the case's `|`; a documented case always breaks the variant
# onto one case per line.
variant Maybe =
    # The something.
    | Yes
    | No

# A case's payload slots take `# ..` lines too, inside the parentheses above
# each slot — for a case with many keyword slots, what each one means is the
# slot's business rather than the case's. A documented slot breaks the payload
# onto one slot per line, and the list takes no trailing comma.
variant Shape =
    | Circle(
        # The radius.
        r: i64
    )
    | Rect(
        # The width.
        w: i64,
        # The height, `w` again when omitted.
        h?: i64 = none
    )

// `//` comments are untouched: only `#` documents, so the banner style below
// still means nothing to the parser.
fn undocumented(n: i64) -> i64 {
    ////////////
    // part 1 //
    ////////////
    n + n
}

fn main() !prints {
    let p = Point { x: 1, y: 2 };
    print(`sum {add(p.x, p.y)}`);
    print(`doubled {undocumented(2)}`);
    print(`yes {Yes == Maybe.Yes}`);
    print(`square {Rect(3) == Rect(3, h=3)}`);
}
--- stdout ---
sum 3
doubled 4
yes true
