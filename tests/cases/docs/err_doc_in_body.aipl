import { wrapping_add as + } from builtins;

// A `#` line is documentation only in front of a declaration. Anywhere else it
// is an error — which is what keeps `////////` section banners working, since
// they stay ordinary `//` comments.
fn f(n: i64) -> i64 {
    # not documentation
    n + 1
}
