# Module documentation, which is what a detached `# ..` block at the top of a
# file is.

import { print } from builtins;

fn main() !prints { print("hi"); }

# A blank line under this block detaches it from `later` below, and there is no
# file to document from here — the top of the file is taken.

fn later() -> i64 { 1 }
