# Exercises the "instructions executed" performance counter. The metric is the
# sum, over every basic-block entry at runtime, of that block's (compile-time
# fixed) CLIF instruction count — so it reflects *executed* instructions (a
# loop body counts once per iteration), and it's deterministic for a fixed
# program. That determinism is what lets the count be asserted — here by the
# `.performance` block on `triangle`.

import {
    equal as ==,
    measure,
    print,
    to_str,
    wrapping_add_assign as +=,
    wrapping_increment as ++,
} from builtins;

fn triangle() -> i64 {
    mut sum = 0;
    mut i = 1;
    // Ten iterations (one per byte of the string).
    for (let _c : "0123456789") {
        set sum += i;
        set i++;
    }
    sum
}.performance({
    fn sum_over(digits: str) -> i64 {
        mut sum = 0;
        mut i = 1;
        for (let _c : digits) {
            set sum += i;
            set i++;
        }
        sum
    }

    // Deterministic: the same call counts the same, every time.
    let first = measure("first", 0, |_| triangle());
    let again = measure("again", 0, |_| triangle());
    assert(first.instructions == again.instructions);
    assert(first.instructions == 620);

    // *Executed* instructions: a loop body counts once per iteration, so more
    // iterations cost more, from nothing at all up.
    let empty = measure("no iterations", "", sum_over);
    let ten = measure("ten iterations", "0123456789", sum_over);
    let twenty = measure("twenty iterations", "01234567890123456789", sum_over);
    assert(empty.instructions == 56);
    assert(ten.instructions == 611);
    assert(twenty.instructions == 1171);
})

fn main() !prints {
    print(to_str(triangle())); // 1+2+...+10 = 55
}
--- stdout ---
55
