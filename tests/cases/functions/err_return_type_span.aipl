import { print } from builtins;

// A return-type mismatch points at the expression that produced the type — not
// at the body as a whole. Each function here is a different shape of "where is
// the value", and the four spans below are the whole point of the fixture.
//
// The body's own span deliberately covers the whole body, which is right for an
// error *about the body* and wrong for one about its **value**: reporting it
// underlined whichever statement came first. So the parser records the value's
// span when it builds the block (`Expr::value_span`), and this diagnostic reads
// that. A body with no trailing expression at all has nothing to underline and
// gets its block's `{` — which is why `{` carries a span, like `[` and `#`.
//
// Before the fix, `leading_statements` pointed at its `let`, and both
// `no_tail_expression` and `empty_body` pointed at line 1, underlining the
// import at the top of the file.

fn one_statement() -> str { 5 }

fn leading_statements() -> str {
    let a = 1;
    a
}

fn no_tail_expression() !prints -> i64 {
    print("no value");
}

fn empty_body() -> i64 {}

fn main() !prints {
    print(one_statement());
    print(leading_statements());
}
--- errors ---
error: fn "one_statement": body returns i64, but the declared return type is str
  --> ./tests/cases/functions/err_return_type_span.aipl:18:29
   |
18 | fn one_statement() -> str { 5 }
   |                             ^

error: fn "leading_statements": body returns i64, but the declared return type is str
  --> ./tests/cases/functions/err_return_type_span.aipl:22:5
   |
22 |     a
   |     ^

error: fn "no_tail_expression": body returns (), but the declared return type is i64
  --> ./tests/cases/functions/err_return_type_span.aipl:25:40
   |
25 | fn no_tail_expression() !prints -> i64 {
   |                                        ^

error: fn "empty_body": body returns (), but the declared return type is i64
  --> ./tests/cases/functions/err_return_type_span.aipl:29:24
   |
29 | fn empty_body() -> i64 {}
   |                        ^
