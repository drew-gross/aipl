# What a `T+` refuses: the shapes that may be empty — an optional, a plain
# array (whatever its value), the empty literal — on a concrete and on a
# generic signature.

import { filter, greater_than as >, len, wrapping_add as + } from builtins;

fn count(self: i64+) -> u64 { self.len() }

fn total<T: any>(self: T[], more: T+) -> u64 { self.len() + more.len() }

fn optional() -> u64 { count(some(1)) }

fn plain_array(xs: i64[]) -> u64 { count(xs) }

fn plain_result() -> u64 { count([1, 2].filter(|x| x > 5)) }

fn empty_literal() -> u64 { count([]) }

fn generic_optional() -> u64 { total([1], none) }

fn generic_plain_array(xs: i64[]) -> u64 { total([1], xs) }

fn main() {}
