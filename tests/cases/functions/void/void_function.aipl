# A function with no `-> ty` returns nothing (unit). Its body can be a pure
# list of statements with no trailing expression — there's no value to yield.
# Such a function is called for its effects alone.

import { equal as ==, print } from builtins;

fn banner(title: str) !prints {
    print(`== {title} ==`);
    print("ready");
}

fn scenario() !prints {
    banner("start");
    banner("again");
}.test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        scenario();
    };
    assert(out == """
        == start ==
        ready
        == again ==
        ready

    """);
})
