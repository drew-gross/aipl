import { equal as ==, print, to_str } from builtins;

fn scenario() !prints {
    print(to_str(42));
}.test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        scenario();
    };
    assert(out == "42\n");
})
