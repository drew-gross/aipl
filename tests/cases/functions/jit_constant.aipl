import { equal as ==, print, to_str } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(to_str(42));
    };
    assert(out == "42\n");
})
