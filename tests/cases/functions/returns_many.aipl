# A parameter written `(A) -> T*` takes a function that returns `T[]`, `T?` or a single `T`, the way
# a `T*` parameter takes a sequence, an optional or one element. The body sees one that returns
# `T[]`.

import { equal as ==, join, map, wrapping_mul as * } from builtins;

fn gather(items: i64[], f: (i64) -> i64*) -> i64[] { items.map(f).join() }.test({
    // A lambda returning the sequence, an optional, and one element.
    assert(gather([1, 2, 3], |n| [n, n]) == [1, 1, 2, 2, 3, 3]);
    assert(gather([1, 2, 3], |n| if (n == 2) { none } else { some(n) }) == [1, 3]);
    assert(gather([1, 2, 3], |n| n * 10) == [10, 20, 30]);

    // The same, written as the name of a function.
    fn doubled(n: i64) -> i64 { n * 2 }
    fn maybe(n: i64) -> i64? { if (n == 1) { some(n) } else { none } }
    fn pair(n: i64) -> i64[] { [n, n] }
    assert(gather([1, 2], doubled) == [2, 4]);
    assert(gather([1, 2], maybe) == [1]);
    assert(gather([1, 2], pair) == [1, 1, 2, 2]);

    // A `return` in the lambda leaves the lambda, with the value its own result is of.
    assert(gather(
        [1, 2],
        |n| {
            if (n == 1) { return none; };
            some(n)
        },
    ) == [2]);
})
