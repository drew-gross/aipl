# A variadic parameter on a *generic* function, without a default. Each call
# specializes on the argument's shape — sequence, single element, or optional —
# the same way a concrete variadic does; before, only concrete ones did, and a
# bare element reached codegen still typed as the sequence.

import { print, to_str, wrapping_increment as ++ } from builtins;

fn total<T: any>(self: T[], extra: T*) -> u64 {
    mut n: u64 = 0;
    for (let _ : self) {
        set n++;
    }
    for (let _ : extra) {
        set n++;
    }
    n
}

fn main() !prints {
    print(to_str(total([1, 2], 3)));
    print(to_str(total([1, 2], [3, 4])));
    print(to_str(total([1, 2], some(3))));
    print(to_str(total([1, 2], none)));
    print(to_str(total(["a"], "b")));
}
--- stdout ---
3
4
3
2
2
