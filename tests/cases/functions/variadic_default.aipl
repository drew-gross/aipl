import { len, print, to_str } from builtins;

// A variadic parameter may carry a default: `T* = []`.
//
// The two halves compose without conflicting. It stays *variadic* in what it
// accepts — the sequence, a single element, or an optional element — and the
// default makes it a *keyword* parameter in how it's passed, exactly as a
// default does anywhere else. So it is omitted or named, never positional.
fn count<T: any>(self: T[], sep: T* = []) -> u64 { sep.len() }

// `char*`'s sequence type is `str` (an AIPL string *is* the char sequence), so
// its default is a string rather than an array.
fn chars(self: char[], sep: char* = "") -> u64 { sep.len() }

fn main() !prints {
    // Omitted: the default applies.
    print(to_str(count([1, 2])));
    // Named: every variadic argument shape still works.
    print(to_str(count([1, 2], sep=5)));
    print(to_str(count([1, 2], sep=[5, 6])));
    print(to_str(count([1, 2], sep=some(7))));
    print(to_str(count([1, 2], sep=none)));

    // The `str`/`char` ambiguity resolves from the *other* arguments, which are
    // bound first precisely because a variadic's own argument can't settle it:
    // with `T = str` a string is one element, with `T = char` it is the whole
    // sequence.
    print(to_str(count(["a"], sep="xy")));
    print(to_str(chars(['a'], sep="xy")));
    print(to_str(chars(['a'], sep='z')));
    print(to_str(chars(['a'])));
}
