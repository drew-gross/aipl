# A string-literal pattern only matches a `str` scrutinee, not an optional.

import { print } from builtins;

fn label(x: i64?) -> str {
    match (x) {
        "a" => "x",
        _ => "y",
    }
}

fn main() !prints {
    print(label(some(1)));
}
--- errors ---
