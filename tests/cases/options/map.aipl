import { equal as ==, map, print, to_str, value_or, wrapping_add as + } from builtins;

// `map` over an optional: the one value there may be is mapped, and `none`
// stays `none` — `some(v)` becomes `some(f(v))`, with the result an optional of
// the lambda's type. The same `map` as an array's, dispatched on the receiver.
fn double(n: i64) -> i64 { n + n }

fn describe(o: i64?) -> str {
    match (o) {
        some(v) => `some({v})`,
        none => "none",
    }
}

fn main() !prints {
    let three: i64? = some(3);
    let absent: i64? = none;

    // A lambda, and a named function.
    print(describe(three.map(|n| n + 1)));
    print(describe(absent.map(|n| n + 1)));
    print(describe(three.map(double)));

    // The result type follows the lambda: an `i64?` mapped to a `str?`.
    print(three.map(|n| `n={n}`).value_or("nothing"));
    print(absent.map(|n| `n={n}`).value_or("nothing"));

    // A capture is threaded through like any lambda's.
    let k = 10;
    print(describe(three.map(|n| n + k)));

    // Chains: the result is an optional, so it maps again and unwraps as one.
    print(three.map(double).map(double).value_or(0).to_str());
    print((absent.map(double) == none).to_str());
}
