# `is_some_and` folds an optional and a predicate into a bool: true only when
# the value is present and satisfies the predicate. `none` short-circuits to
# false without calling the predicate.

import { equal as ==, is_some_and, less_than_or_equal as <=, logical_not as ! } from builtins;

test({
    assert(some(7).is_some_and(|x| x == 7));
    assert(!some(7).is_some_and(|x| x == 8));
    assert(!""[0].is_some_and(|c| c == 'a')); // none -> false
    let cap = 5;
    assert(some(3).is_some_and(|x| x <= cap)); // captured bound
})
