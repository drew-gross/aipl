import { equal as ==, map, value_or } from builtins;

fn code(c: char?) -> i64 { c.map(|v| if (v == 'A') { 65 } else { 0 }).value_or(0) }.test({
    assert(code(some('A')) == 65);
    assert(code(some('B')) == 0);
    assert(code(none) == 0);
})
