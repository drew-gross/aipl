import { equal as ==, map, value_or } from builtins;

fn flag(b: bool?) -> i64 { b.map(|v| if (v) { 1 } else { 0 }).value_or(0) }.test({
    assert(flag(some(true)) == 1);
    assert(flag(some(false)) == 0);
    assert(flag(none) == 0);
})
