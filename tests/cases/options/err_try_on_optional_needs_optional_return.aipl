import { wrapping_add as + } from builtins;

// `?` on an optional early-returns `none`, so the enclosing function must return
// an optional to receive it. Using it in an `i64`-returning function is an error.
fn bad(o: i64?) -> i64 { o? + 1 }

fn main() -> i64 { bad(some(5)) }
--- errors ---
error: "?" on an optional can only be used in a function that returns an optional
 --> ./tests/cases/options/err_try_on_optional_needs_optional_return.aipl:5:26
  |
5 | fn bad(o: i64?) -> i64 { o? + 1 }
  |                          ^
