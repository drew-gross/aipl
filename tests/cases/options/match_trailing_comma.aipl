import { == } from builtins;

fn unwrap(x: i64?) -> i64 {
    match (x) {
        some(v) => v, #[allow]
        none => 0,
    }
}.test({
    assert(unwrap(some(42)) == 42);
    assert(unwrap(none) == 0);
})
