import { print, to_str, wrapping_add as + } from builtins;

// An array-pattern element must be a binder (a bare name) or a literal — not a
// computed expression like `k + 1`.
fn code(xs: i64[]) -> i64 {
    let k = 2;
    match (xs) {
        [1, k + 1] => 1,
        _ => 0,
    }
}

fn main() !prints {
    print(to_str(code([1, 2])));
}
