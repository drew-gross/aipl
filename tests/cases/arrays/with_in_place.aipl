# `with` writes into the array it is given when nothing else holds it, so updates
# that hand the array over cost no allocation. Two shapes hand it over: a fresh
# array (`repeat`'s result here), and a binding at its last use — `set xs =
# xs.with(..)` ends the old `xs` as it replaces it. The pinned report is the claim:
# a hundred updates of a 64-element array allocate the array once, plus the
# program's own bookkeeping, not a hundred more.
#
# A `value_or` default that mentions the receiver (`.value_or(xs)`) reads `xs`
# after `with`, so that call copies; `[]` is the fallback here because an index
# `i % 64` is never past the end.

import {
    equal as ==,
    len,
    repeat,
    saturating_remainder as %,
    to_str,
    value_or,
    with,
    wrapping_add as +,
} from builtins;

test({
    mut cells: i64[] = [0].repeat(64);
    for (let i : 0..100) {
        set cells = cells.with(i % 64, 7).value_or([]);
    }
    let fresh = [0].repeat(64).with(1, 2).value_or([]);
    assert(to_str(cells.len() + fresh.len()) == "128");
})
