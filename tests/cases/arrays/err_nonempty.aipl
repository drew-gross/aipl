# The ways into `T[] without []` that the checker refuses: an empty literal, a
# plain array (which may be empty, whatever its value), a function's plain
# result, and a `without []` on something that is not an array at all.

import { filter, greater_than as >, nonempty_first, nonempty_last } from builtins;

fn empty_literal() -> i64 {
    let xs: i64[] without [] = [];
    xs.nonempty_first()
}

fn plain_array(xs: i64[]) -> i64 { xs.nonempty_first() }

fn plain_result() -> i64 {
    let xs: i64[] without [] = [1, 2].filter(|x| x > 5);
    xs.nonempty_last()
}

fn not_an_array() -> i64 {
    let n: i64 without [] = 5;
    n
}
