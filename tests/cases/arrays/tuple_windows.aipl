import {
    equal as ==,
    is_empty,
    len,
    print,
    to_str,
    tuple_windows,
    wrapping_increment as ++,
} from builtins;

// `tuple_windows` pairs each element with the one after it, overlapping:
// `[1, 2, 3]` gives `(1, 2)` and `(2, 3)`. Fewer than two elements give no
// pairs. A `str` receiver pairs its chars.
fn main() !prints {
    for (let (a, b) : [1, 2, 3, 4].tuple_windows()) {
        print(`{a} -> {b}`);
    }
    // The array itself, when it is wanted rather than looped over.
    let ws = ["x", "y", "z"].tuple_windows();
    print(ws.len().to_str());
    print(`{ws[0]}`);
    print(`{[7].tuple_windows().is_empty()}`);
    print(`{tuple_windows([1, 2][..0]).is_empty()}`);
    // Chars of a str.
    mut doubled = 0;
    for (let (c, d) : "aabcc".tuple_windows()) {
        if (c == d) {
            set doubled++;
        };
    }
    print(doubled.to_str());
}
