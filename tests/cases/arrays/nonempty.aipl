import {
    ensure_nonempty,
    equal as ==,
    first,
    len,
    map,
    nonempty_first,
    nonempty_last,
    print,
    to_str,
    value_or,
} from builtins;

// `T[] without []` — an array the type system knows is not empty.
//
// At runtime it is a `T[]`: the same block, so a refined array goes anywhere
// an array does. The refinement buys `nonempty_first`/`nonempty_last`, which
// hand back the element rather than a `T?`. There are two ways in: a literal
// with an element in it takes the refined type on sight, and
// `ensure_nonempty` tests any other array at runtime.
fn main() !prints {
    let xs: i64[] without [] = [3, 1, 2];
    print(xs.nonempty_first().to_str());
    print(xs.nonempty_last().to_str());
    print(head(xs).to_str());
    print(one().nonempty_last().to_str());

    // A refined array is an ordinary array everywhere one is wanted: passed
    // to a `T[]` parameter, indexed, walked, measured, compared.
    print(describe(xs));
    print(xs.first().to_str());
    print(xs[1].to_str());
    print(xs.len().to_str());
    for (let x : xs) {
        print(x.to_str());
    }
    print((xs == [3, 1, 2]).to_str());

    // `ensure_nonempty` is the runtime road in.
    print(last_or(["b", "a"], "empty"));
    let none_of_them: str[] = [];
    print(last_or(none_of_them, "empty"));
}

fn head(ne: i64[] without []) -> i64 { ne.nonempty_first() }

// A literal with an element in it is visibly not `[]`, so it returns as the
// refined type without any test.
fn one() -> i64[] without [] { [1] }

fn describe(ys: i64[]) -> str { `{ys.len()} elements` }

fn last_or(names: str[], fallback: str) -> str {
    names.ensure_nonempty().map(nonempty_last).value_or(fallback)
}
