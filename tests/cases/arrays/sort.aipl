import { len, print, sort, to_str, &&, == } from builtins;

// `xs.sort()` returns a *fresh* array with the same elements in ascending order.
// It does not mutate the receiver (like `reverse`, and unlike `push`).
//
// The element type must satisfy the `ord` bound — an integer, a `char`, or a
// `str`. Ordering is by value: integers numerically (respecting signedness),
// chars and strings by byte. Unlike `reverse`, the result cannot be a lazy view
// — the order isn't a function of the index — so it is materialized.
//
// Every integer width is an `ord` array element, and the runtime picks the
// signed or unsigned comparison from the element type — see
// `integers/narrow_int_elements` for the width-by-width coverage.

fn sorted_ints() -> i64[] { [3, 1, 2].sort() }.test({
    assert(sorted_ints() == [1, 2, 3]);
    // Already sorted, reverse sorted, duplicates, single, empty.
    assert([1, 2, 3].sort() == [1, 2, 3]);
    assert([3, 2, 1].sort() == [1, 2, 3]);
    assert([2, 1, 2, 1].sort() == [1, 1, 2, 2]);
    assert([7].sort() == [7]);
    assert([].sort().len() == 0);
})

// Signed integers order numerically, not by their bit pattern.
fn negatives() -> i64[] { [3, -5, 0, -1].sort() }.test({
    assert(negatives() == [-5, -1, 0, 3]);
})

// Strings order lexicographically by byte.
fn names() -> str[] { ["pear", "apple", "fig"].sort() }.test({
    assert(names() == ["apple", "fig", "pear"]);
    // A prefix sorts before the longer string that extends it.
    assert(["ab", "a", "abc"].sort() == ["a", "ab", "abc"]);
    // Uppercase sorts before lowercase (byte order, not locale).
    assert(["b", "A", "a"].sort() == ["A", "a", "b"]);
})

// `char[]` and `str` share a representation, so both sort their bytes and each
// keeps its own type.
fn chars() -> char[] { ['c', 'a', 'b'].sort() }.test({
    assert(chars() == ['a', 'b', 'c']);
    assert("cba".sort() == "abc");
    assert("".sort() == "");
})

// The receiver is untouched — `sort` builds a new array.
fn does_not_mutate() -> bool {
    let xs = [3, 1, 2];
    let ys = xs.sort();
    xs == [3, 1, 2] && ys == [1, 2, 3]
}.test({
    assert(does_not_mutate());
})

fn main() !prints {
    print(to_str(sorted_ints()));
    print(to_str(names()));
    print(to_str(chars()));
}
