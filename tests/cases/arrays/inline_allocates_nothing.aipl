# A short integer array is *inline*: its elements live in the array value's own
# 22 bytes, the way a short `str`'s do, and there is no block to allocate,
# refcount or free (see "inline" in `crates/aipl-codegen/src/arr24.rs`). That is
# 22 `u8`s, 11 `i16`s, 5 `i32`s or 2 `i64`s — narrow integers are packed at their
# own width.
#
# An array becomes inline wherever it is built small: a literal whose elements
# are not all constants (a constant one is a static block, already free), a
# `push` onto an empty array, and a `map` or `filter` over an inline input,
# which writes its result into the same bytes. The `.performance` block on `ones`
# is the proof: each of those allocates nothing, up to the capacity and one past it
# exactly once. (`main` returns its answer as the exit code because rendering an
# array would allocate a buffer.)

import {
    equal as ==,
    filter,
    len,
    less_than as <,
    logical_and as &&,
    map,
    measure,
    push,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;

fn ones(n: u64) -> i64[] {
    // The loop is the subject: its pushes are what grow the array.
    mut out: i64[] = []; #[allow]
    for (let i : 0..n) {
        set out.push(1);
    }
    out
}.performance({
    let two: u64 = 2;
    let three: u64 = 3;
    // The most an `i64[]` holds inline is two; a third needs a block.
    assert(measure("two i64s", two, ones).allocations == 0);
    assert(measure("three i64s", three, ones).allocations == 1);
    // A `map` or `filter` over an inline input writes into the same bytes.
    assert(measure("map over inline", two, |n| ones(n).map(|x| x + 10)).allocations == 0);
    assert(measure("filter over inline", two, |n| ones(n).filter(|x| x < 5)).allocations == 0);
    // Narrow integers pack at their own width: 22 `u8`s fit, a 23rd does not.
    let most: u64 = 22;
    let past: u64 = 23;
    assert(measure("22 bytes", most, bytes).allocations == 0);
    assert(measure("23 bytes", past, bytes).allocations == 1);
})

fn bytes(n: u64) -> u8[] {
    // As in `ones`, the pushes are what is measured.
    mut out: u8[] = []; #[allow]
    for (let i : 0..n) {
        set out.push(1);
    }
    out
}

fn total(xs: i64[]) -> i64 {
    mut n = 0;
    for (let x : xs) {
        set n += x;
    }
    n
}

fn main() -> i64 {
    let p = ones(2); // the most an i64[] holds inline
    let bumped = ones(2).map(|x| x + 10); // 11, 11
    let small = ones(2).filter(|x| x < 5); // 1, 1
    let b = bytes(22); // the most a u8[] holds inline
    let lens = [b.len(), p.len()]; // not constants, so built inline
    let full = if (lens[0] == some(22) && b[21] == some(1)) { 100 } else { 0 };
    total(p) + total(bumped) + total(small) + full // 2 + 22 + 2 + 100
}
--- exit code ---
126
