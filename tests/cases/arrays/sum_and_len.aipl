# Array literal, passing an array to a function, for-each iteration,
# and len().

import {
    equal as ==,
    len,
    narrow,
    value_or,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;

fn sum(xs: i64[]) -> i64 {
    mut total = 0;
    for (let x : xs) {
        set total += x;
    }
    total
}.test({
    let xs = [10, 20, 30];
    assert(sum(xs) == 60);
    assert(len(xs) == 3);
    let n: i64 = len(xs).narrow().value_or(0);
    assert(sum(xs) + n == 63);
})
