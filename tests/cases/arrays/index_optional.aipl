# Indexing yields an optional: some(elem) in bounds, none out of bounds.

import { equal as ==, value_or } from builtins;

fn at(xs: i64[], i: i64) -> i64 { xs[i].value_or(-1) }.test({
    let xs = [5, 6, 7];
    // in-bounds element
    assert(at(xs, 1) == 6);
    // out-of-bounds -> -1
    assert(at(xs, 10) == -1);
    // negative index -> -1
    assert(at(xs, -1) == -1);
    // indexing directly yields an optional
    assert(xs[0] == some(5));
    assert(xs[9] == none);
})
