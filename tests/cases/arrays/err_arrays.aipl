import { push, value_or } from builtins;

// Every *check-phase* array error, in one file, reported in one run. The
// checker recovers at each item, so each failing function below is recorded and
// the next is still checked.
//
// Three array errors are not here, because they belong to other phases and so
// can't be reported alongside these:
//   - the two `..` spread errors — spread desugaring runs in the *loader*, so
//     either one aborts the file before the checker sees it;
//   - `err_push_char_from_empty` — a *codegen* error (pushing a char would
//     change the array's representation), and codegen only runs once checking
//     has passed, so it can never appear next to a check error;
//   - `err_array_pattern_non_literal` — an array pattern's elements are
//     patterns, so an expression among them is a *parse* error, which aborts
//     the file before any of these are reached.

// Indexing something that isn't an array.
fn index_non_array() -> i64 {
    let x = 5;
    x[0].value_or(0)
}

// Array-pattern `match`: a repeated arm, an element of the wrong type, a
// non-literal element, a missing `_`, and a `_` that isn't last.
fn match_duplicate(xs: i64[]) -> i64 {
    match (xs) {
        [1, 2] => 1,
        [1, 2] => 2,
        _ => 0,
    }
}

fn match_elem_type(xs: i64[]) -> i64 {
    match (xs) {
        ["a", "b"] => 1,
        _ => 0,
    }
}

fn match_non_exhaustive(xs: i64[]) -> i64 {
    match (xs) {
        [1, 2] => 1,
        [3, 4] => 2,
    }
}

fn match_wildcard_not_last(xs: i64[]) -> i64 {
    match (xs) {
        [1, 2] => 1,
        _ => 0,
        [3, 4] => 2,
    }
}

// `push` needs a `mut` receiver.
fn push_immutable() -> i64 {
    let xs = [1];
    set xs.push(2);
    0
}

fn main() {}
