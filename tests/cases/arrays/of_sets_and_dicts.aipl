# A set and a dict are heap blocks addressed by an 8-byte pointer — the same
# shape a nested array element already has — so they can be array elements, and
# the element retain/drop helpers a `T[][]` already uses carry them unchanged.
#
# The `--- performance ---` section below is the real assertion: balanced
# allocations are what says the element blocks are retained and released exactly
# once each.

import {
    equal as ==,
    get,
    has,
    is_empty,
    len,
    print,
    push,
    to_str,
    wrapping_add_assign as +=,
} from builtins;

fn tag_sets() -> #{str}[] { [#{"a", "b"}, #{}, #{"c"}] }

fn counts() -> #{str: i64}[] { [#{"a": 1, "b": 2}, #{}] }

fn has_a(s: #{str}) -> bool { s.has("a") }

fn set_size(s: #{str}) -> u64 { s.len() }

// Handing one to a callee and getting one back: the array is retained on the way
// in and released on the way out, elements included.
fn total_size(xs: #{str}[]) -> u64 {
    mut n: u64 = 0;
    for (let s : xs) {
        set n += s.len();
    }
    n
}

fn grown() -> #{str}[] {
    mut out: #{str}[] = []; #[allow]
    for (let s : tag_sets()) {
        set out.push(s);
    }
    out
}

fn main() !prints {
    let sets = tag_sets();
    print(sets.len().to_str());
    print(total_size(sets).to_str());

    // Elements come back out intact, not as freed blocks.
    match (sets[0]) {
        some(s) => print(`{has_a(s)} {set_size(s)}`),
        none => print("missing"),
    };

    let ds = counts();
    print(ds.len().to_str());
    match (ds[0]) {
        some(d) => print(d.get("b").to_str()),
        none => print("missing"),
    };
    match (ds[1]) {
        some(d) => print(d.is_empty().to_str()),
        none => print("missing"),
    };

    // Copied element by element into a second array — both arrays co-own the
    // same element blocks until each is released.
    print(total_size(grown()).to_str());

    // Equality compares element blocks, not pointers.
    print((tag_sets() == tag_sets()).to_str());

    // Nested one level further: an array of arrays of sets.
    let nested: #{str}[][] = [tag_sets(), []];
    print(nested.len().to_str());
}
--- stdout ---
3
3
true 2
2
some(2)
true
3
true
2
