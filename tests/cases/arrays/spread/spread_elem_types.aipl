# Spread works for every element representation, not just `i64`. `char[]` is
# the interesting one: it is str-shaped, so the build has to start from a
# typed array rather than an untyped empty literal.

import { equal as ==, join } from builtins;

struct P { x: i64 }

fn chars() -> char[] { [..['a', 'b'], 'c'] }.test({
    fn empty() -> i64[] { [] }

    assert(chars() == ['a', 'b', 'c']);
    assert([..["x", "y"], "z"].join(sep="-") == "x-y-z");
    assert([..[true], false] == [true, false]);
    assert([..[P { x: 1 }], P { x: 2 }] == [P { x: 1 }, P { x: 2 }]);

    // An empty operand contributes nothing.
    assert([..empty(), 1] == [1]);
    assert([1, ..empty()] == [1]);
    assert([..empty()] == empty());
})
