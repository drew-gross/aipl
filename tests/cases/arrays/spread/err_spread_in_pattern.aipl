// An array *pattern* has no rest form. Its elements are patterns, and no
// pattern is led by `..`, so the parser is what refuses one — where a `..` in a
// call argument list parses and is refused later.
import { equal as ==} from builtins;

fn main() -> i64 {
    let a = [1];
    match (a) {
        [..a] => 1,
        _ => 0,
    }
}
