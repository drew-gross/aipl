import { extend, join, print, to_str, wrapping_add as + } from builtins;

// `extend` is `push` for a whole array: `set dst.extend(src)` appends every
// element of `src` to `dst` in place, leaving `src` untouched.
//
// It is a builtin rather than an AIPL loop over `push` so it can size the
// destination once — see `extend_reserves_once`, where that is the assertion.
variant Tree = Leaf(i64) | Node(Tree, Tree)

fn total(self: Tree) -> i64 {
    match (self) {
        Leaf(v) => v,
        Node(l, r) => l.total() + r.total(),
    }
}

fn sum(ts: Tree[]) -> i64 {
    mut acc = 0;
    for (let t : ts) {
        set acc = acc + t.total();
    }
    acc
}

fn main() !prints {
    // The ordinary case, and an empty source, which is a no-op.
    mut a = [1, 2];
    set a.extend([3, 4]);
    let empty: i64[] = [];
    set a.extend(empty);
    print(to_str(a));

    // The source aliases the destination. Retaining the source is what makes
    // the block shared, which forces the copy before anything is written — so
    // the elements read are the original six, not a half-written array.
    mut b = [1, 2, 3];
    set b.extend(b);
    print(to_str(b));

    // Value semantics, as for `push`: a shared destination is copied first and
    // the other holder sees nothing.
    mut c = [1, 2];
    let alias = c;
    set c.extend([9]);
    print(`{to_str(c)} {to_str(alias)}`);

    // Heap elements are retained, not moved: the source is still usable.
    mut s = ["a"];
    let more = ["b", "c"];
    set s.extend(more);
    print(`{s.join(sep=",")} {more.join(sep=",")}`);

    // Boxed recursive elements, through the same retain pass.
    mut ts = [Leaf(1)];
    let src = [Node(Leaf(2), Leaf(3)), Leaf(4)];
    set ts.extend(src);
    print(`{sum(ts).to_str()} {sum(src).to_str()}`);

    // `bool[]` is bit-packed, so it has no pre-sized form and appends bit by
    // bit — the answer is the same either way.
    mut flags = [true, false];
    set flags.extend([true, true]);
    print(to_str(flags));

    // Nested arrays, and a destination that starts as the untyped empty
    // literal and takes its element type from the source.
    mut nest = [];
    set nest.extend([[1], [2]]);
    set nest.extend([[3, 4]]);
    print(to_str(nest));

    // Growing repeatedly in a loop — the shape this builtin exists to replace.
    mut loops = [];
    for (let i : [1, 2, 3]) {
        set loops.extend([i, i]);
    }
    print(to_str(loops));
}
--- stdout ---
[1, 2, 3, 4]
[1, 2, 3, 1, 2, 3]
[1, 2, 9] [1, 2]
a,b,c b,c
10 9
[true, false, true, true]
[[1], [2], [3, 4]]
[1, 1, 2, 2, 3, 3]
