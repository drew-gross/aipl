# `extend` is a mutating method, so — like `push` — only the `set` writeback
# form mutates. Used as a *value*, in either the free-call or the method form,
# it is copy-and-modify: a fresh array with the elements appended, receiver
# untouched.

import { equal as ==, extend, logical_and as && } from builtins;

fn probe() -> bool {
    mut xs = [1];
    let a = extend(xs, [2, 3]); // free form: a == [1, 2, 3]
    let b = xs.extend([4]); // method form: b == [1, 4]
    xs == [1] && a == [1, 2, 3] && b == [1, 4]
}.test({
    assert(probe());
})
