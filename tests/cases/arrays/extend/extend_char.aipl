import { extend, print } from builtins;

// `extend` on a *shared* `char[]` builds one fresh buffer of the combined
// length and copies both sides in, exactly as `push` does for a single char, so
// value semantics hold for the aliases. `extend_char_in_place.aipl` covers the
// unaliased receiver, which appends into its own storage instead.
fn main() !prints {
    mut cs = ['a'];
    let more = ['b', 'c'];
    set cs.extend(more);
    print(cs);
    print(more);

    // A shared receiver is copied, so the alias keeps the old bytes.
    mut d = ['x'];
    let alias = d;
    set d.extend(['y']);
    print(d);
    print(alias);
}
