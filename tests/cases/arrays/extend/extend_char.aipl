import { extend, print } from builtins;

// A `char[]` is str-shaped, so it has no in-place growable block: `extend`
// builds one fresh buffer of the combined length and copies both sides in,
// exactly as `push` does for a single char. Value semantics still hold.
fn main() !prints {
    mut cs = ['a'];
    let more = ['b', 'c'];
    set cs.extend(more);
    print(cs);
    print(more);

    // A shared receiver is copied, so the alias keeps the old bytes.
    mut d = ['x'];
    let alias = d;
    set d.extend(['y']);
    print(d);
    print(alias);
}
--- stdout ---
abc
bc
xy
x
