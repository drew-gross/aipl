import { equal as ==, len, push } from builtins;

// `push` on a never-aliased `char[]` appends into the value's own storage
// rather than rebuilding the whole string per element — the `char[]` half of
// `strings/concat_in_place_grows.aipl`, and the reason `push_char.aipl` (which
// takes a snapshot, and so is *not* exclusive) still copies.
fn build(src: str) -> char[] {
    mut cs = ['a'];
    for (let c : src) {
        set cs.push(c);
    }
    cs
}.test({
    assert(build("bc") == ['a', 'b', 'c']);
    assert(build("") == ['a']);
    // 27 chars: past the inline capacity, so the block is grown under itself.
    assert(build("bcdefghijklmnopqrstuvwxyz").len() == 26);
})
