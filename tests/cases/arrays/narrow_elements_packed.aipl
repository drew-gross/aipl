# An array of a narrow integer packs each element at its own width: a `u8[]` is
# a byte per element, an `i16[]` two, an `i32[]` four. The `.performance` block on
# `bytes` is the proof — it grows a `u8[]` to a thousand elements, whose peak is
# about a thousand bytes, where a word apiece would be eight thousand.
#
# Everything that moves elements has to agree on the width: growing and
# extending, a window and a slice of it, `join`, the in-place `map`/`filter`
# that reuse their input's buffer, `sort`, and `to_array` out of a set, which
# keeps a word per element and so is copied rather than shared. A literal is
# built at the type it lands in, however it gets there — through a block's tail,
# an `if`, a `some`, or nested in another literal.

import {
    Measurement,
    equal as ==,
    extend,
    filter,
    join,
    len,
    map,
    measure,
    print,
    push,
    reverse,
    sort,
    to_array,
    to_str,
    value_or,
    wrapping_add as +,
} from builtins;

fn bytes(n: u64) -> u8[] {
    mut out: u8[] = []; #[allow]
    for (let i : 0..n) {
        set out.push(7);
    }
    out
}.performance({
    let n: u64 = 1000;

    // One allocation that grows in place to 1,488 bytes: a thousand elements and
    // the growth slack, not the 8,000+ of a word per element.
    let Measurement { allocations, peak_live_bytes } = measure("a thousand bytes", n, bytes);
    assert(allocations == 1);
    assert(peak_live_bytes == 1488);
})

fn halves(flag: bool) -> i16[] { if (flag) { [-1, 300] } else { [2] } }

fn main() !prints {
    print(bytes(1000).len().to_str());

    mut xs: i32[] = [5, -70000, 3];
    let more: i32[] = [100000, -1];
    set xs.extend(more);
    print(`{xs} {xs.sort()} {xs.reverse()}`);

    let w = xs[1..4];
    print(`{w} {w[1..]} {w == [-70000, 3, 100000]} {w[2].value_or(0)}`);

    print(`{halves(true)} {halves(false)}`);
    let wrapped: u8[]? = some([200, 1]);
    print(`{wrapped.value_or([])}`);

    let nested: u8[][] = [[1, 255], [], [9]];
    print(`{nested} {nested.join(sep=[0])}`);

    let small: u8[] = [1, 2, 3, 250];
    print(`{small.map(|b| b + 1)} {small.filter(|b| b == 2)}`);

    let s: #<{u16} = #<{500, 3, 40};
    print(`{s.to_array()}`);
}
--- stdout ---
1000
[5, -70000, 3, 100000, -1] [-70000, -1, 3, 5, 100000] [-1, 100000, 3, -70000, 5]
[-70000, 3, 100000] [3, 100000] true 100000
[-1, 300] [2]
[200, 1]
[[1, 255], [], [9]] [1, 255, 0, 0, 9]
[2, 3, 4, 251] [2]
[3, 40, 500]
