# Reversing an array allocates nothing: the result is a value over the same
# block's run, walked from its far end (see "reversed" in
# `crates/aipl-codegen/src/arr24.rs`). So is everything done to one here —
# reading it, slicing it (a reversed window), and reversing it again, which is
# the forward array it came from. Only a bit-packed `bool[]`, with no byte run
# to walk, is copied.
#
# The `.performance` block on `main` is the proof: the source is a constant
# literal, which lives in the data section, so nothing here allocates unless a
# reversal does. (`main` returns its answer as the exit code because rendering
# would allocate a buffer.)

import {
    Measurement,
    equal as ==,
    logical_and as &&,
    measure,
    reverse,
    value_or,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;

fn total(xs: i64[]) -> i64 {
    mut n = 0;
    for (let x : xs) {
        set n += x;
    }
    n
}

fn main() -> i64 {
    let xs = [1, 2, 3, 4, 5, 6];
    let r = xs.reverse(); // 6, 5, 4, 3, 2, 1
    let mid = r[1..4]; // 5, 4, 3 — still reversed, still over `xs`
    let back = r.reverse(); // `xs` again
    let same = if (back == xs && mid.reverse() == [3, 4, 5]) { 100 } else { 0 };
    r[0].value_or(0) + mid[0].value_or(0) + total(mid) + same // 6 + 5 + 12 + 100
}.performance({
    let xs = [1, 2, 3, 4, 5, 6];
    let r = xs.reverse();
    assert(measure("reverse", xs, reverse).allocations == 0);
    assert(measure("reverse twice", xs, |a| a.reverse().reverse()).allocations == 0);
    assert(measure("slice of a reversed array", r, |v| v[1..4]).allocations == 0);
    assert(measure("walk a reversed array", r, total).allocations == 0);

    // A bit-packed `bool[]` has no byte run to walk backwards, so it is copied.
    let flags = [true, false, true];
    let Measurement { allocations, bytes_allocated } = measure("reverse bools", flags, reverse);
    assert(allocations == 1);
    assert(bytes_allocated == 17);
})
--- exit code ---
123
