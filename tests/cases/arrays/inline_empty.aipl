# An array has a fourth runtime representation: **inline**, the counterpart of an
# inline `str` — a value that owns no allocation, so there is nothing to refcount
# and nothing to free. Only the empty array is inline so far, which is the case
# worth having first: a zero-length slice, an empty `filter` result and a `map`
# over nothing all produce one, and each used to allocate a block to hold no
# elements.
#
# The `.performance` block on `main` is the proof: **no array allocates** — `xs` is
# a literal (a static block), and each zero-length slice, empty `filter` result and
# `map` over nothing is inline. Before this, every one of them was a freshly
# allocated block.

import {
    equal as ==,
    filter,
    greater_than as >,
    is_empty,
    len,
    logical_not as !,
    map,
    measure,
    print,
    to_str,
    wrapping_add as +,
} from builtins;

fn main() !prints {
    let xs = [1, 2, 3];

    // A zero-length slice of a non-empty array.
    let mid = xs[1..1];
    print(to_str(len(mid))); // 0
    print(to_str(mid.is_empty())); // true

    // It compares and reads like any other empty array — the representation is not
    // visible to the program, exactly as an inline `str` is not.
    print(to_str(mid == [])); // true
    print(to_str(!(mid == xs))); // true

    // A slice past the end clamps to empty, and so does a backwards one.
    print(to_str(len(xs[3..3]))); // 0
    print(to_str(len(xs[2..1]))); // 0
}.performance({
    let xs = [1, 2, 3];

    // A zero-length slice, one past the end, and a backwards one: each is an
    // inline empty array, not a block holding no elements.
    assert(measure("zero-length slice", xs, |a| a[1..1]).allocations == 0);
    assert(measure("slice at the end", xs, |a| a[3..3]).allocations == 0);
    assert(measure("backwards slice", xs, |a| a[2..1]).allocations == 0);
    // And so are a `filter` over nothing and a `map` over nothing.
    assert(measure("filter over nothing", xs, |a| a[1..1].filter(|x| x > 9)).allocations == 0);
    assert(measure("map over nothing", xs, |a| a[1..1].map(|x| x + 1)).allocations == 0);
})
--- stdout ---
0
true
true
true
0
0
