# `try_with` replaces one element of an array, as a new array, and does nothing
# when the index is past the end: `xs.try_with(i, v)` is `xs` with element `i` set
# to `v`, or `xs` itself when there is no element `i`. `with` is the form that says
# which happened (`some(copy)` or `none`); this is the one for when a miss is not
# worth a branch — and the one that writes in place, because it reads `xs` once
# (`xs.with(i, v).value_or(xs)` reads it again for the fallback). The pinned report
# is that claim: a hundred updates of a 64-element array allocate the array once.

import {
    equal as ==,
    print,
    repeat,
    reverse,
    saturating_remainder as %,
    to_str,
    try_with,
    wrapping_add_assign as +=,
} from builtins;

variant Cell = Mark(i64) | Blank

fn basics() {}.test({
    assert([1, 2, 3].try_with(1, 9) == [1, 9, 3]);
    // The ends.
    assert([1, 2, 3].try_with(0, 9) == [9, 2, 3]);
    assert([1, 2, 3].try_with(2, 9) == [1, 2, 9]);
    // Past the end, and an empty receiver: the array, as it was.
    assert([1, 2, 3].try_with(3, 9) == [1, 2, 3]);
    assert([1, 2, 3].try_with(100, 9) == [1, 2, 3]);
    assert([1, 2][..0].try_with(0, 9) == []);
    assert(try_with([1, 2], 0, 7) == [7, 2]); // free-call form
    // The receiver is not changed.
    let xs = [1, 2, 3];
    let ys = xs.try_with(0, 9);
    assert(ys == [9, 2, 3]);
    assert(xs == [1, 2, 3]);
})

// Elements that own something, and ones that don't take a whole word.
fn other_elements() {}.test({
    assert(["a", "b"].try_with(1, "z") == ["a", "z"]);
    assert([[1], [2, 3]].try_with(0, [7, 8]) == [[7, 8], [2, 3]]);
    assert([true, false, true].try_with(1, true) == [true, true, true]);
    assert([true, true, true].try_with(2, false) == [true, true, false]);
    assert([true, false].try_with(2, true) == [true, false]);
    let narrow: u8[] = [1, 2, 3];
    assert(narrow.try_with(1, 200) == [1, 200, 3]);
    assert([Mark(1), Blank].try_with(1, Mark(2)) == [Mark(1), Mark(2)]);
})

// A view of another array: the write must not reach the array it looks into.
fn views() {}.test({
    let xs = [1, 2, 3, 4];
    let tail = xs[1..];
    assert(tail.try_with(0, 9) == [9, 3, 4]);
    assert(xs == [1, 2, 3, 4]);
    let backwards = xs.reverse();
    assert(backwards.try_with(0, 9) == [9, 3, 2, 1]);
    assert(xs == [1, 2, 3, 4]);
})

fn sum(xs: i64[]) -> i64 {
    mut total = 0;
    for (let x : xs) {
        set total += x;
    }
    total
}

fn main() !prints {
    mut cells: i64[] = [0].repeat(64);
    for (let i : 0..100) {
        set cells = cells.try_with(i % 64, 7);
    }
    // A miss changes nothing.
    set cells = cells.try_with(64, 1);
    print(to_str(sum(cells)));
}
