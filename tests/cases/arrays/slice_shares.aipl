# An array slice is a window onto its source, the way a `str`'s slice is a
# window onto its bytes: `xs[a..b]` is the source's block with the window's
# bounds carried in the value, never a copy of the elements. So its cost does not
# grow with the window — the `.performance` block on `numbers` measures no
# allocation for any of these, where a copy of a thousand elements would be
# thousands of bytes — and slicing a slice is a window of the same block rather
# than a view stacked on a view. A reversal is a value of the same kind — the
# run walked from its far end — so slicing a reversed array, or reversing a
# slice, shares the block too.
#
# A window is read-only in the sense that matters: writing into it would write
# into the source, so the first mutation (`push`, `extend`, an in-place `map`)
# materializes the window into a block of its own. The source never changes.

import {
    Measurement,
    equal as ==,
    len,
    measure,
    print,
    push,
    reverse,
    to_str,
    value_or,
} from builtins;

fn numbers(n: u64) -> u64[] {
    mut out: u64[] = [];
    for (let i : 0..n) {
        set out.push(i);
    }
    out
}.performance({
    let big = numbers(1000);
    assert(measure("head of 1000", big, |b| b[..500]).allocations == 0);
    assert(measure("tail of 1000", big, |b| b[500..]).allocations == 0);
    assert(measure("slice of a slice", big, |b| b[100..900][300..500]).allocations == 0);
    assert(measure("slice of a reversed array", big, |b| b.reverse()[..3]).allocations == 0);
    assert(measure("reversed slice", big, |b| b[..3].reverse()).allocations == 0);
    assert(measure("empty window", big, |b| b[7..7]).allocations == 0);

    // Writing into a window materializes it first, into a block of its own: the
    // only allocations are the copy of three elements and the push that grows it.
    let Measurement { allocations, bytes_allocated } = measure(
        "push onto a slice",
        big,
        |b| {
            mut grown = b[..3];
            set grown.push(99);
            grown.len()
        },
    );
    assert(allocations == 2);
    assert(bytes_allocated == 88);
})

fn main() !prints {
    let big = numbers(1000);
    let head = big[..500];
    let tail = big[500..];
    print(`{head.len()} {tail.len()} {head[499].value_or(0)} {tail[0].value_or(0)}`);

    // A slice of a slice: one view, over the original block.
    let middle = big[100..900][300..500];
    print(`{middle.len()} {middle[0].value_or(0)} {middle[199].value_or(0)}`);

    // The whole array is the array itself; an empty window is nothing at all.
    let all = big[0..big.len()]; #[allow]
    print((all == big).to_str());
    print(big[7..7].len().to_str());

    // Mutating a slice copies it out first: the source is untouched.
    mut grown = big[..3];
    set grown.push(99);
    print(`{grown} {big[..4]}`);

    // A slice composes with a reversal: a slice of a reversed array, and a
    // reversed slice — each still a value over `big`'s block.
    print(big.reverse()[..3].to_str());
    print(big[..3].reverse().to_str());

    // Heap elements are shared, not copied, and released exactly once: the leak
    // gate (every run must free what it allocates) is the proof.
    let words = ["alpha", "beta", "gamma", "delta"];
    let some_words = words[1..3];
    print(some_words.to_str());
}
--- stdout ---
500 500 499 500
200 400 599
true
0
[0, 1, 2, 99] [0, 1, 2, 3]
[999, 998, 997]
[2, 1, 0]
["beta", "gamma"]
