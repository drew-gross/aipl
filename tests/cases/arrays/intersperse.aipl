# `intersperse(xs, sep)` inserts `sep` *between* consecutive elements, never
# leading or trailing — the array counterpart of `join`.
#
# `join` is this followed by concatenation, which only `str` can do; every
# element type can be interleaved, so that is where the generic version stops.
# Callable free (`intersperse(xs, sep)`) or as a method (`xs.intersperse(sep)`).

import { equal as ==, intersperse, join, len, print, to_str } from builtins;

fn main() !prints {
    // Between, not around: three elements give five slots.
    print(["a", "b", "c"].intersperse("-").len().to_str());
    print(["a", "b", "c"].intersperse("-").join());

    // Fewer than two elements: nothing to separate, so the array is unchanged.
    print(["a"].intersperse("-").len().to_str());
    print([].intersperse("-").len().to_str());

    // Generic over the element type — the separator is an ordinary element.
    print([1, 2, 3].intersperse(0).len().to_str());
    print(([1, 2, 3].intersperse(0)[1] == some(0)).to_str());

    // Free-call form.
    print(intersperse([7, 8], 9).len().to_str());
}
--- stdout ---
5
a-b-c
1
0
5
true
3

