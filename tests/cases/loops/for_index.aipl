# `for (let i, x : xs)` binds the iteration index alongside the element. The
# index counts iterations, so it is the element's position for an array and the
# byte offset for a `str`.

import { print, to_str } from builtins;

fn main() !prints {
    let words = ["zero", "one", "two"];
    for (let i, w : words) {
        print(to_str(i));
        print(w);
    }
    // Nested: the inner index restarts each time the inner loop is entered.
    for (let outer, w : ["ab", "c"]) {
        for (let inner, c : w) {
            print(`{outer}{inner}{c}`);
        }
    }
}
--- stdout ---
0
zero
1
one
2
two
00a
01b
10c
