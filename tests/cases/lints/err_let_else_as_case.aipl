# `let K(a, b) = x else { return none; };` — a variant taken apart, giving up with
# `none` when it is another case. `let K(a, b) = x.as_case(K)?;` says the same
# without the block.

import { print } from builtins;

variant Shape = Circle(i64) | Rect(i64, i64) | Empty

// A payload the `let` takes apart.
fn radius(s: Shape) -> i64? {
    let Circle(r) = s else { return none; };
    some(r * 2)
}

// Written as an `if let`, which is the same tree.
fn width(s: Shape) -> i64? {
    if (let Rect(w, h) = s) { some(w + h) } else { return none; }
}

// A case with no payload to bind has no pattern for a `let`, so it is asked of
// the value alone.
fn only_empty(s: Shape, n: i64) -> i64? {
    if (let Empty = s) { some(n) } else { return none; }
}

fn main() !prints {
    print(`{radius(Circle(1))} {width(Rect(1, 2))} {only_empty(Empty, 3)}`);
}
