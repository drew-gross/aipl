# `#[allow]` keeps the spread form — the escape hatch every lint carries. The
# marker goes on the line holding the `..self` spread, which is where this lint
# points; it is always one line, so it takes a trailing marker and keeps it
# through `aipl fmt`.

import { equal as ==, print, to_str } from builtins;

struct Point { x: i64, y: i64 }

fn rebuilt(mut self: Point) {
    set self = Point { ..self, x: 1 }; #[allow]
}

// The rewrite the lint asks for, so the two spellings are checked side by
// side and proven to agree.
fn stored(mut self: Point) {
    set self.x = 1;
}

fn main() !prints {
    mut a = Point { x: 0, y: 2 };
    mut b = a;
    set a.rebuilt();
    set b.stored();
    print(to_str(a == b));
    print(to_str(a));
}
--- stdout ---
true
Point { x: 1, y: 2 }
