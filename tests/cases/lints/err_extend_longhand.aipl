import { concat, concat as +++, print } from builtins;

// Every append-by-rebuild the lint flags, and what it advises for each. The
// hits name the import to add (this file has no `extend`); the chain's hit says
// to append each operand on its own, since `set s.extend(a +++ b);` would build
// `a +++ b` first.
fn main() !prints {
    mut s = "start";
    set s = s +++ "-a";
    set s = s +++ "-b" +++ "-c"; // a left-leaning chain, so still an append
    set s = concat(s, "-d"); // the bare call is the same call
    mut xs = [1];
    set xs = xs +++ [2, 3]; // an array appends the same way
    print(s);
    print(`{xs}`);
}
--- errors ---
