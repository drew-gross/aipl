# `-` need not be a builtin at all: bound to one of your own functions, no `--`
# flavor can match it, so the decrement lint stays quiet rather than
# recommending a form that would call something else.

import { print, to_str } from builtins;
import { my_custom_sub as - } from "./mymath_sub.aipl";

fn main() !prints {
    mut n = 0;
    set n = n - 1; // == my_custom_sub(n, 1), not a decrement
    print(n.to_str());
}
--- file: mymath_sub.aipl ---
import { wrapping_sub as - } from builtins;
pub fn my_custom_sub(a: i64, b: i64) -> i64 { a - b - 1000 }
--- stdout ---
-1001
