// `value_or` is imported but never referenced — the unused-import lint. Every
// other name here is used by a case below.
import {
    greater_than as >,
    len,
    less_than as <,
    map,
    print,
    to_str,
    wrapping_add as +,
    wrapping_sub as -,
} from builtins;

// Every lint, in one file, reported in one run.
//
// Lints are ordinary errors — they fail the compile — but unlike a type error
// they are *independent findings*: nothing has to be recovered from to keep
// looking, so the pass collects them all and reports the set. That is what
// makes this file possible, and it is the point of it: the expected output
// below is the whole lint surface at once, so adding a lint or changing a
// message shows up here rather than in a file of its own.
//
// Each lint has its own `#[allow]` companion case proving the marker squelches
// it (`allow_squelch`, `eta_lambda_allow`, `field_init_shorthand_allow`,
// `slice_from_zero_allow`, `incr_by_one_allow`, `fn_body_type_stutter_allow`,
// `len_gt_zero_allow`, `is_empty_longhand_allow`, `push_loop_pipeline_allow`,
// `return_loop_find_if_allow`, `return_loop_find_index_allow`,
// `return_loop_any_all_allow`, `union_loop_union_all_allow`), and its own
// passing case
// for the shapes it must *not* flag (`slice_whole_allow`,
// `slice_from_zero_open_end`, `field_init_range_value`,
// `incr_shapes_not_flagged`, `incr_custom_plus`,
// `fn_body_type_stutter_not_flagged`, `len_gt_zero_not_flagged`,
// `len_gt_zero_user_lt`, `is_empty_longhand_not_flagged`,
// `is_empty_longhand_user_len`, `push_loop_pipeline_not_flagged`,
// `return_loop_find_if_not_flagged`, `return_loop_find_index_not_flagged`,
// `return_loop_any_all_not_flagged`, `union_loop_union_all_not_flagged`).

struct Point { x: i64, y: i64 }

// `x: x` — a field initialized with the identifier of the same name has the
// shorthand spelling `Point { x }`. The body also names `Point` twice, so this
// one line trips two lints at once.
fn make(x: i64, y: i64) -> Point { Point { x: x, y: y } }

struct Tag { id: i64 }

// `fn f() -> T { T { .. } }` — a body that is a literal of the function's own
// return type spells that type twice; the body shorthand drops the repeat.
fn tag(id: i64) -> Tag { Tag { id: id + 0 } }

// The lone-*shorthand*-field case earns its own message, since the replacement
// is `{ id, }` and that trailing comma is what keeps the body a struct literal
// instead of a block whose value is `id`.
fn tag_short(id: i64) -> Tag { Tag { id } }

// `|x| to_str(x)` — a lambda that only forwards its argument to a single call
// is redundant; pass `to_str` itself. The method form `|x| x.to_str()` is
// stored as the same free call, so it is covered too.
fn stringify(xs: i64[]) -> str[] { xs.map(|x| to_str(x)) }

// `set x = x + 1;` — an increment written the long way; `set x++;` is the form
// for it (either operand order counts, so `1 + n` is flagged too).
fn bump(start: i64) -> i64 {
    mut n = start;
    set n = n + 1;
    n
}

// The same lint the other way round: `set x--;` is the form for `set x = x - 1;`.
// Only the receiver-on-the-left order counts here — `1 - n` subtracts `n` from
// one, which is no decrement at all.
fn drop_one(start: i64) -> i64 {
    mut n = start;
    set n = n - 1;
    n
}

// `0 < xs.len()` / `xs.len() > 0` — a length computed only to be compared
// against zero. `is_nonempty` is that test named after what it means, and both
// operand orders are the same idiom.
fn any_items(xs: i64[]) -> bool { 0 < xs.len() }

// The free-call spelling can't be spliced into the advice (a call-shaped span
// stops before its parens), so it names the builtin instead of the receiver.
fn also_any(xs: i64[]) -> bool { len(xs) > 0 }

fn slices() !prints {
    let s = "hello, world";

    // `x[y..x.len()]` — the end bound is the receiver's own length, which the
    // open-ended form already means.
    print(s[3..s.len()]);

    // The three whole-receiver spellings. Each is `s` already, so each gets the
    // same one-step advice rather than a rewrite into another slice: the
    // open-end form with a zero start, the open-start form (whose `0` is
    // synthesized), and the fully-written one.
    print(s[0..]);
    print(s[..s.len()]);
    print(s[0..s.len()]);

    // `x[0..y]` — the mirror: a literal `0` start is what the open-ended form
    // already means.
    print(s[0..2]);

    // `#[allow]` is line-scoped, so a marker on the *neighbouring* line
    // squelches nothing.
    #[allow]
    print(s[4..s.len()]);
}

fn main() !prints {
    print(make(1, 2).x.to_str());
    print(tag(1).id.to_str());
    print(tag_short(2).id.to_str());
    print(stringify([1]).len().to_str());
    print(bump(1).to_str());
    print(any_items([1]).to_str());
    print(also_any([1]).to_str());
    slices();
}
