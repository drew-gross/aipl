import { equal as ==, is_nonempty, len, logical_not as ! } from builtins;

// Every spelling that asks emptiness the long way. `is_empty` asks it directly.
fn negated(xs: i64[]) -> bool { !xs.is_nonempty() }

fn len_zero(xs: i64[]) -> bool { xs.len() == 0 }

fn zero_len(xs: i64[]) -> bool { 0 == xs.len() }

// The free-call spelling of `len` is the same AST, so it is the same hit — the
// advice names the receiver rather than splicing it, since a call's span stops
// before its closing paren.
fn free_call(xs: i64[]) -> bool { len(xs) == 0 }

// A `str` receiver counts too: `len` takes it, so `is_empty` does.
fn empty_str(s: str) -> bool { s.len() == 0 }
