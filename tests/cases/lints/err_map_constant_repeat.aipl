# `xs.map(|x| c)` with a constant `c` builds the same value once per element and
# spells the count as a walk over `xs`. `[c].repeat(xs.len())` says "this many
# copies" directly, and builds `c` once. Every kind of constant body is flagged:
# a literal, a name read as it is, and a construction of constants. The file
# imports neither `repeat` nor `len`, so the advice names both.

import { map, print } from builtins;

struct Cell { filled: bool, label: str }

fn zeros(xs: i64[]) -> i64[] { xs.map(|x| 0) }

fn blanks(names: str[]) -> str[] { names.map(|_| "") }

fn defaults(xs: i64[], fallback: i64) -> i64[] { xs.map(|x| fallback) }

fn cells(xs: i64[]) -> Cell[] { xs.map(|x| Cell { filled: false, label: "empty" }) }

fn main() !prints {
    print(`{zeros([1, 2])} {blanks(["a"])} {defaults([1], 9)} {cells([1]).len()}`);
}
