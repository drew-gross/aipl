import { print, to_str, wrapping_add as + } from builtins;

// `#[allow]` on the line squelches the increment lint, like any other — the
// long-hand `set n = n + 1;` compiles and runs as written.
fn main() !prints {
    mut n = 0;
    set n = n + 1; #[allow]
    print(n.to_str());
}
