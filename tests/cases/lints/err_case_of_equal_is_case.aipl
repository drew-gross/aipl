# Reading which case a value is, only to compare it with one: `is_case` asks the
# same question without the `case_of()` call.

import { case_of, equal as == } from builtins;

variant Shape = Circle(i64) | Square(i64) | Dot

fn is_circle(shape: Shape) -> bool { shape.case_of() == Circle }

// The case on the left, and the call form.
fn is_dot(shape: Shape) -> bool { Dot == case_of(shape) }
--- errors ---
