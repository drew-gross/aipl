import { equal as == } from builtins;

// `#[allow]` squelches the body-shorthand lint on its line, so this function
// keeps naming `Point` twice (see err_lints.aipl for the lint itself).
struct Point { x: i64, y: i64 }

fn make(a: i64, b: i64) -> Point {
    Point { x: a, y: b } #[allow]
}.test({
    assert(make(1, 2).x == 1);
})

fn main() {}
