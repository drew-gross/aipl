# The shapes the increment lint must leave alone: adding something other than
# one, adding one to a *different* binding, and a field store fed from a
# different binding — a field path is a target like any other, so only the
# same path on both sides is a step.
#
# The first of those is still an accumulate, so the *compound* lint owns it and
# is squelched here: this case is about what `incr_by_one` does, and it can only
# show that by keeping the long-hand spelling.

import { print, to_str, wrapping_add as +, wrapping_increment as ++ } from builtins;

struct Counter { n: i64 }

fn main() !prints {
    mut n = 0;
    set n = n + 2; #[allow]
    // not one, so not the increment lint's
    mut m = 0;
    set m = n + 1; // one, but added to another binding
    mut c = Counter { n: 0 };
    set c.n = m + 1; // a field store fed from a different binding
    set n++; // the recommended form itself never trips its own lint
    print(n.to_str());
    print(m.to_str());
    print(c.n.to_str());
}
--- stdout ---
3
3
4
