import { equal as ==, extend, print, push, to_str } from builtins;

// `#[allow]` keeps the rebuild form — the escape hatch every lint carries. The
// marker goes on the line holding the `..self` spread, which is where this lint
// points; it is always one line, so it takes a trailing marker and keeps it
// through `aipl fmt`.
fn rebuilt(mut self: i64[]) {
    set self = [..self, 3]; #[allow]
}

fn joined(mut self: i64[], more: i64[]) {
    set self = [..self, ..more]; #[allow]
}

// The rewrites the lint asks for, so each pair of spellings is checked side by
// side and proven to agree.
fn appended(mut self: i64[]) {
    set self.push(3);
}

fn extended(mut self: i64[], more: i64[]) {
    set self.extend(more);
}

fn main() !prints {
    mut a = [1, 2];
    mut b = [1, 2];
    set a.rebuilt();
    set b.appended();
    print(to_str(a == b));
    mut c = [1, 2];
    mut d = [1, 2];
    set c.joined([8, 9]);
    set d.extended([8, 9]);
    print(to_str(c == d));
    print(to_str(a));
    print(to_str(c));
}
