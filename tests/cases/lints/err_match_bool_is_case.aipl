# A `match` whose arms are all `true` or `false`, with exactly one `true` and that
# arm a variant case: the whole thing asks which case the value is, which
# `is_case` says directly.

variant Shape = Circle(i64) | Square(i64) | Dot

// The other cases spelled out.
fn is_circle(shape: Shape) -> bool {
    match (shape) {
        Circle(..) => true,
        Square(..) => false,
        Dot => false,
    }
}

// A catch-all `false`, with the payload bound and ignored.
fn is_square(shape: Shape) -> bool {
    match (shape) {
        Square(side) => true,
        _ => false,
    }
}

// A nullary case, and the `false` arm first.
fn is_dot(shape: Shape) -> bool {
    match (shape) {
        Circle(..) | Square(..) => false,
        Dot => true,
    }
}
