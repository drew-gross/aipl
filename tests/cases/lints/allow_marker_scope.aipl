# `#[allow]` is line-scoped: it squelches the hits that start on its own line. A
# marker on a neighbouring line squelches nothing, and a marker on a line where
# nothing fires is stale; both are reported, and the hit stays.
fn subject(s: str) -> str {
    #[allow]
    let neighbour = s[0..2];
    let stale = s[1..3]; #[allow]
    `{neighbour}{stale}`
}
