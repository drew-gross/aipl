# `#[allow]` keeps the chain; beside it, the `find_map` it is advised to be.
# The chain's answer is wrapped twice and needs peeling; `find_map`'s is not.

import { equal as ==, find_if, find_map, is_some, map, print, value_or } from builtins;

fn nonzero(x: i64) -> i64? { if (x == 0) { none } else { some(x) } }

fn chained(xs: i64[]) -> i64? { xs.map(nonzero).find_if(is_some).value_or(none) } #[allow]

fn direct(xs: i64[]) -> i64? { xs.find_map(nonzero) }

fn main() !prints {
    print(`{chained([0, 2, 3])} {direct([0, 2, 3])}`);
    print(`{chained([0])} {direct([0])}`);
}
--- stdout ---
some(2) some(2)
none none
