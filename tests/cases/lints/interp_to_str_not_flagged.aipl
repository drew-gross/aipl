import { concat as +++, print, to_str } from builtins;

// The shapes the interpolated-`to_str` lint must leave alone: a `to_str`
// outside any interpolation, one that is only part of the interpolated
// expression, and a call to some other function.
fn main() !prints {
    let n = 42;
    // Not in a template at all.
    print(to_str(n));
    print("n = " +++ to_str(n));
    // The call is an operand, not the whole interpolation.
    print(`n = {to_str(n) +++ "!"}`);
    // A different function.
    print(`n = {shown(n)}`);
}

fn shown(n: i64) -> str { to_str(n) }
