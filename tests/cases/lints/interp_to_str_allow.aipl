# `#[allow]` at the end of the line keeps a `to_str` inside an interpolation
# as written; the plain interpolation beside it renders the same text.

import { print, to_str } from builtins;

fn main() !prints {
    let n = 42;
    print(`n = {to_str(n)}`); #[allow]
    print(`n = {n}`);
}
--- stdout ---
n = 42
n = 42
