import {
    greater_than as >,
    greater_than_or_equal as >=,
    is_nonempty,
    len,
    less_than as <,
    not_equal as !=,
    print,
    to_str,
} from builtins;

// The shapes the length-against-zero lint must leave alone. It flags exactly
// two idioms — `0 < x.len()` and `x.len() > 0` — so everything here compiles.

// A different bound is a different question.
fn at_least_two(xs: i64[]) -> bool { 1 < xs.len() }

fn more_than_one(xs: i64[]) -> bool { xs.len() > 1 }

// `>= 1` means the same thing, but it is not one of the two idioms the lint
// rewrites, and inventing a third spelling to flag would make the rule harder
// to state than to follow.
fn at_least_one(xs: i64[]) -> bool { xs.len() >= 1 }

// So does `!= 0`, and it is left alone for the same reason.
fn not_zero(xs: i64[]) -> bool { xs.len() != 0 }

// Zero compared against anything that isn't a length.
fn positive(n: u64) -> bool { 0 < n }

// The spelling the lint asks for, which must not then flag itself.
fn any_items(xs: i64[]) -> bool { xs.is_nonempty() }

fn main() !prints {
    let xs = [1, 2];
    print(to_str(at_least_two(xs)));
    print(to_str(more_than_one(xs)));
    print(to_str(at_least_one(xs)));
    print(to_str(not_zero(xs)));
    print(to_str(positive(1)));
    print(to_str(any_items(xs)));
}
