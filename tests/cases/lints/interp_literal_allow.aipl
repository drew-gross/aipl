# `#[allow]` at the end of the line keeps a literal interpolation as written;
# the template beside it says the same thing in place.

import { print } from builtins;

fn main() !prints {
    print(`a: {'a'}, aa: {"aa"}`); #[allow]
    print(`a: a, aa: aa`);
}
--- stdout ---
a: a, aa: aa
a: a, aa: aa
