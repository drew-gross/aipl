# `xs.map(|x| x.name)` — a lambda whose whole body is its argument taken through a
# chain of member reads and calls — is `xs$name`, `xs$0`, `xs$f(args)` and
# `xs$a$f(b)$c`. A call written as a plain function, `|x| to_str(x)`, is the same
# step when `$` can make it: the function is a builtin, or declared here with a
# `self` receiver. And a bare function name, `xs.map(f)`, is `xs$f()`.

import { len, map, print, to_str, wrapping_add as + } from builtins;

struct Point { x: i64, y: i64 }

struct Line { origin: Point }

fn scale(self: i64, by: i64) -> i64 { self + by }

fn twice(self: i64) -> i64 { self + self }

fn xs_of(ps: Point[]) -> i64[] { ps.map(|p| p.x) }

fn firsts(pairs: (i64, str)[]) -> i64[] { pairs.map(|p| p.0) }

fn texts(xs: i64[]) -> str[] { xs.map(|x| x.to_str()) }

fn scaled(xs: i64[], by: i64) -> i64[] { xs.map(|x| x.scale(by)) }

fn originals(lines: Line[]) -> i64[] { lines.map(|l| l.origin.x) }

fn scaled_xs(ps: Point[], by: i64) -> i64[] { ps.map(|p| p.x.scale(by)) }

fn shown(ps: Point[]) -> str[] { ps.map(|p| to_str(p.x)) }

fn doubled(xs: i64[]) -> i64[] { xs.map(twice) }

fn main() !prints {
    print(xs_of([Point { x: 1, y: 2 }]).len().to_str());
}
