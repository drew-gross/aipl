import {
    greater_than as >,
    is_empty,
    len,
    less_than as <,
    logical_not as !,
    print,
    to_str,
} from builtins;

// The emptiness lints: a length compared against zero, or an emptiness test
// negated, is `is_nonempty` — the test named after what it means.

// `0 < xs.len()` / `xs.len() > 0` — a length computed only to be compared
// against zero; both operand orders are the same idiom.
fn any_items(xs: i64[]) -> bool { 0 < xs.len() }

// The free-call spelling can't be spliced into the advice (a call-shaped span
// stops before its parens), so it names the builtin instead of the receiver.
fn also_any(xs: i64[]) -> bool { len(xs) > 0 }

// `!xs.is_empty()` is the same question through a negation, and goes to the
// same `is_nonempty`.
fn not_empty(xs: i64[]) -> bool { !xs.is_empty() }

fn main() !prints {
    print(any_items([1]).to_str());
    print(also_any([1]).to_str());
    print(not_empty([1]).to_str());
}
