import { print, to_str, wrapping_add as + } from builtins;

// `A => { expr }` — a block that holds nothing but the arm's value. The braces
// add nesting and say nothing; `A => expr` is the same arm.
//
// A block that does something else keeps its braces: one with a statement in
// it (`let`, a `;`), or one holding a comment, which would have nowhere to go.
// An alternation shares one body, so it is reported once, at the `=>` arm.
fn f(x: i64) -> i64 {
    match (x) {
        0 => { 1 },
        1 => { x + 1 },
        2 => {
            let y = x;
            y
        },
        3 => {
            // kept
            x
        },
        4 | 5 => { x },
        6 => {
            x;
        },
        _ => x,
    }
}

fn main() !prints {
    print(f(0).to_str());
}
