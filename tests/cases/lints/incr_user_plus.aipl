# `+` need not be a builtin at all: bound to one of your own functions, no `++`
# flavor can match it, so the increment lint stays quiet rather than
# recommending a form that would call something else.

import { equal as ==, print, to_str } from builtins;
import { my_custom_add as + } from "./mymath.aipl";

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        mut n = 0;
        set n = n + 1; // == my_custom_add(n, 1), not an increment
        print(n.to_str());
    };
    assert(out == "1001\n");
})
--- file: mymath.aipl ---
import { wrapping_add as + } from builtins;
pub fn my_custom_add(a: i64, b: i64) -> i64 { a + b + 1000 }
