import { equal as ==, logical_and as &&, print, value_or_err } from builtins;

// `#[allow]` keeps the long form — the escape hatch every lint carries.
// `value_or_err`'s own definition needs exactly this, since it cannot be
// rewritten in terms of itself.
//
// The marker goes on the `none => err(..)` arm, which is where this lint
// points. That is deliberate: `#[allow]` is line-scoped, so a lint spanning the
// whole multi-line `match` could never be squelched — the only line able to
// carry the marker would be the `match (..) {` header, and the formatter moves
// a marker written there onto its own line, where it squelches nothing. The
// `err` call always starts on its arm's own line, so it always takes a trailing
// marker and keeps it through `aipl fmt`.
fn need(o: i64?) -> i64!str {
    match (o) {
        some(v) => ok(v),
        none => err("missing"), #[allow]
    }
}

// The rewrite the lint asks for, so the two spellings are checked side by side
// and proven to agree.
fn need_short(o: i64?) -> i64!str { o.value_or_err("missing") }

// The statement form points at the `return` itself, not the arm's `{`: a marker
// after the brace would not survive `aipl fmt`, while the `return` line takes
// one like any other statement.
fn need_returning(o: i64?) -> i64!str {
    match (o) {
        some(v) => {
            if (v == 0) {
                return err("zero");
            };
        },
        none => {
            return err("missing"); #[allow]
        },
    };
    ok(1)
}

fn unwrap(r: i64!str) -> i64 {
    match (r) {
        ok(v) => v,
        err(e) => -1,
    }
}

fn main() !prints {
    if (unwrap(need(some(5))) == unwrap(need_short(some(5)))) {
        print("agree on some");
    };
    if (unwrap(need(none)) == unwrap(need_short(none))) {
        print("agree on none");
    };
    if (unwrap(need_returning(some(0))) == -1 && unwrap(need_returning(some(2))) == 1) {
        print("returning form kept");
    };
}
--- stdout ---
agree on some
agree on none
returning form kept
