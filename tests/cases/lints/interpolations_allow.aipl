# `#[allow]` keeps either interpolation lint's spelling, and the shorter spelling
# prints the same.

import { equal as ==, print, to_str } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let n = 7;
        print(`n = {to_str(n)}`); #[allow]
        print(`n = {n}`);
        print(`a: {'a'}`); #[allow]
        print(`a: a`);
    };
    assert(out == """
        n = 7
        n = 7
        a: a
        a: a

    """);
})
