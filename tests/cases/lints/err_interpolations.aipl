import { print, to_str } from builtins;

// The two interpolation lints: what a template's `{..}` renders is already
// text, so wrapping a value in `to_str` or writing a literal there says
// nothing the template could not say itself.

// `{to_str(n)}` — a `to_str` inside an interpolation, which already renders
// its value the same way; `{n}` says the same thing. The method spelling is
// the same call.
fn labelled(n: i64) -> str { `n = {to_str(n)} ({n.to_str()})` }

// `{'a'}` / `{"aa"}` — a literal as the whole interpolation renders as its
// text, which the template could have said in place: `` `a: a, aa: aa` ``.
fn spelled() -> str { `a: {'a'}, aa: {"aa"}` }

fn main() !prints {
    print(labelled(1));
    print(spelled());
}
--- errors ---
