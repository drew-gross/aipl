# What `$` cannot say stays as it is.

import { equal as ==, filter, len, map, print, to_str, wrapping_add as + } from builtins;

struct Point { x: i64, y: i64 }

fn double(self: i64, other: i64) -> i64 { self + other }

# Not a method: its first parameter is not `self`, so `xs$plain()` would not compile.
fn plain(x: i64) -> i64 { x }

# The parameter is used again, so it needs its name.
fn both(xs: i64[]) -> i64[] { xs.map(|x| x.double(x)) }

# More than the chain: the lambda does something with it.
fn shifted(ps: Point[]) -> i64[] { ps.map(|p| p.x + 1) }

# A typed parameter has nowhere to write its type under `$`.
fn typed(ps: Point[]) -> i64[] { ps.map(|p: Point| p.x) }

# A lambda that is not a `map`'s.
fn xs_filtered(ps: Point[]) -> u64 { ps.filter(|p| p.x == 1).len() }

# A function that is not a method, by name.
fn named(xs: i64[]) -> i64[] { xs.map(plain) }

# A name that is a value rather than a function of this file.
fn passed(xs: i64[], f: (i64) -> i64) -> i64[] { xs.map(f) }

fn main() !prints {
    print(both([1]).len().to_str());
}
--- stdout ---
1
