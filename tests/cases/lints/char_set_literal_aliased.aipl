# The advice names the file's own spelling of `to_set`, and drops the
# import clause once the file has it: this one imports it aliased, so the
# rewrite it suggests is `.to_char_set()`.

import { has, print, to_set as to_char_set } from builtins;

fn main() !prints {
    let vowels: #{char} = #{'a', 'e', 'i', 'o', 'u'};
    let digits: #{char} = "0123456789".to_char_set();
    print(`{vowels.has('e')} {digits.has('7')}`);
}
