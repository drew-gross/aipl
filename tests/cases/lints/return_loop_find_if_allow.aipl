# `#[allow]` keeps the loop — the escape hatch every lint carries.
#
# The marker goes on the `return some(x);`, which is where this lint points.
# That is deliberate: `#[allow]` is line-scoped, so a hit spanning the loop
# could never be squelched — the marker would have to go on the `for (..) {`
# header, and the formatter moves one written there onto a line of its own, where
# it squelches nothing. The early return is a short statement that always
# occupies one line, and it is the line that makes this loop a search for the
# first match.

import { equal as ==, find_if, less_than as <, print, to_str } from builtins;

fn first_big(xs: i64[], lo: i64) -> i64? {
    for (let x : xs) {
        if (lo < x) {
            return some(x); #[allow]
        };
    }
    none
}

// The rewrite the lint asks for, so the two spellings are checked side by side
// and proven to agree.
fn first_big_short(xs: i64[], lo: i64) -> i64? { xs.find_if(|x| lo < x) }

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(first_big([1, 5, 9], 2).to_str());
        print(first_big_short([1, 5, 9], 2).to_str());
        print(first_big([1, 2], 5).to_str());
        print(first_big_short([1, 2], 5).to_str());
    };
    assert(out == """
        some(5)
        some(5)
        none
        none

    """);
})
