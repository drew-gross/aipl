import { wrapping_add as + } from builtins;

struct Pos { line: i64, col: i64 }

fn make() -> Pos { line: 3, col: 7 }

// Every mention of `p` is a field read, so the binding can be a pattern — and
// then it says up front what it holds, instead of leaving a reader to scan the
// block for whether `p` is also passed, compared or returned.
fn f() -> i64 {
    let p = make();
    p.line
}

// `line` is read off two values here, so `head` stays quiet — but `step` does
// not, because the competing read is inside `step`'s *own value*, evaluated
// before the pattern binds anything. By the time a bare `line` means the field,
// `head.line` is spent. Threading a cursor writes this shape constantly.
fn threaded() -> i64 {
    let head = make();
    let step = shift(head.line);
    step.line + step.col
}

// The binding sharing a name with one of its own fields is the same story: the
// name the pattern takes over belongs to the binding that is going away.
fn self_named() -> i64 {
    let col = make();
    col.col + col.line
}

fn shift(n: i64) -> Pos { line: n, col: n }
