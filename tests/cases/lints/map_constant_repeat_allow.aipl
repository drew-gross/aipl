# `#[allow]` keeps the `map`; beside it, the `repeat` it is advised to be. They
# build the same result, which is what lets the lint offer the second in place of
# the first.

import { equal as ==, len, map, print, repeat } from builtins;

fn mapped(xs: i64[]) -> i64[] { xs.map(|x| 7) } #[allow]

fn repeated(xs: i64[]) -> i64[] { [7].repeat(xs.len()) }

fn main() !prints {
    let xs = [1, 2, 3];
    print(`{mapped(xs)} {repeated(xs)} {mapped(xs) == repeated(xs)}`);
    print(`{mapped([])} {repeated([])}`);
}
--- stdout ---
[7, 7, 7] [7, 7, 7] true
[] []
