# `|x| to_str(x)` — a lambda that only forwards its argument to a single call
# is redundant; pass `to_str` itself. The method form of a `map`'s lambda,
# `|x| x.to_str()`, is `xs$to_str()` instead (`err_map_lambda_member_dollar`).

import { len, map, print, to_str } from builtins;

fn stringify(xs: i64[]) -> str[] { xs.map(|x| to_str(x)) }

fn main() !prints {
    print(stringify([1]).len().to_str());
}
--- errors ---
error: lambda only forwards its argument(s) to "to_str" — pass "to_str" directly (or append #[allow] to this line to keep it)
 --> ./tests/cases/lints/err_eta_lambda.aipl:7:43
  |
