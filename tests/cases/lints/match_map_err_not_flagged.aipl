import { equal as ==, map_err, print, to_str, wrapping_add as + } from builtins;

// Shapes that look close but are deliberately left alone.

struct Wrapped { message: str }

fn parse(s: str) -> i64!str { if (s == "1") { ok(1) } else { err("not a one") } }

// The `ok` arm transforms the value, so this rewrites both sides — more than
// `map_err` can express.
fn wrap_and_bump(r: i64!str) -> i64!Wrapped {
    match (r) {
        ok(v) => ok(v + 1),
        err(e) => err(Wrapped { message: e }),
    }
}

// The `ok` arm ignores its binding, so the value does not pass through.
fn wrap_and_replace(r: i64!str) -> i64!Wrapped {
    match (r) {
        ok(v) => ok(0),
        err(e) => err(Wrapped { message: e }),
    }
}

// `err(e) => err(e)` rebuilds the result unchanged, so the whole `match` is its
// own scrutinee. `map_err(|e| e)` would be a longer way to write that nothing,
// so the lint stays quiet rather than advising it — and so does `map_ok`'s, from
// the other side (see `match_map_ok_not_flagged.aipl`).
fn passthrough(r: i64!str) -> i64!str {
    match (r) {
        ok(v) => ok(v),
        err(e) => err(e),
    }
}

// The `err` arm leaves the result world entirely — this is an unwrap, not a
// conversion.
fn or_zero(r: i64!str) -> i64 {
    match (r) {
        ok(v) => v,
        err(e) => 0,
    }
}

fn main() !prints {
    print(code_of(wrap_and_bump(parse("1"))).to_str());
    print(code_of(wrap_and_replace(parse("1"))).to_str());
    print(or_zero(passthrough(parse("x"))).to_str());
    print(or_zero(parse("1")).to_str());
    // The rewrite itself must not flag.
    print(code_of(parse("x").map_err(|e| Wrapped { message: e })).to_str());
}

fn code_of(r: i64!Wrapped) -> i64 {
    match (r) {
        ok(v) => v,
        err(e) => -1,
    }
}
