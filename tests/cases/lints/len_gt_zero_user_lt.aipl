// `<` need not be a builtin either: bound to one of your own functions,
// `0 < xs.len()` is a call to that function and not a length test at all, so
// the length-against-zero lint stays quiet rather than recommending a rewrite
// that would mean something else.
import { len, print, to_str } from builtins;
import { my_custom_lt as < } from "./myord.aipl";

fn main() !prints {
    let xs = [1, 2, 3];
    print(to_str(0 < xs.len())); // == my_custom_lt(0, 3), which negates
}
--- file: myord.aipl ---
import { less_than as <, logical_not as ! } from builtins;
pub fn my_custom_lt(a: u64, b: u64) -> bool { !(a < b) }
