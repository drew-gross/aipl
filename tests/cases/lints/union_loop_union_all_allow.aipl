import { join, map, print, push, sort, to_str, union, union_all } from builtins;

// `#[allow]` keeps the loop — the escape hatch every lint carries.
//
// The marker goes on the `mut out = #{};` seed, which is where this lint points.
// That is deliberate: `#[allow]` is line-scoped, so a hit spanning the loop
// could never be squelched — the marker would have to go on the `for (..) {`
// header, and `aipl fmt` moves one written there onto a line of its own, where
// it squelches nothing. The seed is a short statement that always occupies one
// line, so it always takes a trailing marker and keeps it through `aipl fmt`.
//
// `map` and `union_all` are both imported here, so the advice names no import —
// the branch the `err_union_loop_union_all` companion cannot reach, since it
// imports neither.
fn merged(xs: #{i64}[]) -> #{i64} {
    mut out: #{i64} = #{}; #[allow]
    for (let s : xs) {
        set out = out.union(s);
    }
    out
}

// The rewrite the lint asks for, so the two spellings are checked side by side
// and proven to agree.
fn merged_short(xs: #{i64}[]) -> #{i64} { xs.union_all() }

fn ends(n: i64) -> #{i64} { #{n, n} }

// The same pair for the mapped form.
fn all_ends(ns: i64[]) -> #{i64} {
    mut out: #{i64} = #{}; #[allow]
    for (let n : ns) {
        set out = out.union(ends(n));
    }
    out
}

fn all_ends_short(ns: i64[]) -> #{i64} { ns.map(ends).union_all() }

// A set is unordered, so every comparison here sorts first.
fn show(s: #{i64}) -> str {
    mut out: i64[] = []; #[allow]
    for (let x : s) {
        set out.push(x);
    }
    out.sort().map(to_str).join(sep=",")
}

fn main() !prints {
    print(show(merged([#{1, 2}, #{2, 3}])));
    print(show(merged_short([#{1, 2}, #{2, 3}])));
    print(show(all_ends([4, 5])));
    print(show(all_ends_short([4, 5])));

    // An empty list of sets, both ways.
    let none_at_all: #{i64}[] = [];
    print(`[{show(merged(none_at_all))}]`);
    print(`[{show(merged_short(none_at_all))}]`);
}
