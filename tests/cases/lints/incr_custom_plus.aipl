import { print, saturating_add as +, to_str } from builtins;

// `+` is bound by import and need not be the wrapping add: here it is
// `saturating_add`, so `set n = n + 1;` and `set n++;` are *different*
// operations (the second wraps). The increment lint stays quiet rather than
// recommending a rewrite that would change what runs.
fn main() !prints {
    mut n: u8 = 254;
    set n = n + 1;
    set n = n + 1; // saturates at 255 instead of wrapping to 0
    print(n.to_str());
}
