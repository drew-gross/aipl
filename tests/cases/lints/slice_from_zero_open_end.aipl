import { print, to_str } from builtins;

// The partial ranges, which no slice lint touches. Each drops exactly one bound
// already, so there is nothing left to recommend:
//
//   - `x[1..]` — an open end with a start worth keeping. (`x[0..]` *is* flagged,
//     by `slice_whole`, because a zero start makes it the whole receiver; an
//     omitted start is synthesized as a zero with an empty span, which is how a
//     written `0` is told apart from an elided one.)
//   - `x[..2]` — an open start with a real end. Only a `len` end would make this
//     the whole receiver.
fn main() !prints {
    let xs = [10, 20, 30];
    print(xs[1..].to_str());
    print(xs[..2].to_str());
}
