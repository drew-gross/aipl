import { print, to_str } from builtins;

// `x[0..]` is *not* flagged, even though the `0` is just as redundant: the
// recommendation would have to be `x[..]`, which is not a form. So the lint
// only fires when there is an end bound to keep. (An omitted start is
// synthesized as a zero with an empty span, which is how a written `0` is told
// apart from an elided one in the first place.)
fn main() !prints {
    let xs = [10, 20, 30];
    print(xs[0..].to_str());
    print(xs[..2].to_str());
}
