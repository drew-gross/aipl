import {
    filter,
    join,
    less_than_or_equal as <=,
    map,
    print,
    push,
    to_str,
    wrapping_mul as *,
} from builtins;

// `#[allow]` keeps the loop — the escape hatch every lint carries. It is the
// answer for the one thing this lint cannot check: `map` and `filter` take
// arrays, but a `for` also walks a `str`'s bytes, and which one an iterable is
// only becomes known two passes later.
//
// The marker goes on the `mut out = [];` seed, which is where this lint points.
// That is deliberate: `#[allow]` is line-scoped, so a hit spanning the loop
// could never be squelched — the marker would have to go on the `for (..) {`
// header, and `aipl fmt` moves one written there onto a line of its own, where
// it squelches nothing. The seed is a short statement that always occupies one
// line, so it always takes a trailing marker and keeps it through `aipl fmt`.
fn scaled_above(xs: i64[], lo: i64) -> i64[] {
    mut out: i64[] = []; #[allow]
    for (let x : xs) {
        if (lo <= x) {
            set out.push(x * 2);
        };
    }
    out
}

// The rewrite the lint asks for, so the two spellings are checked side by side
// and proven to agree.
fn scaled_above_short(xs: i64[], lo: i64) -> i64[] { xs.filter(|x| lo <= x).map(|x| x * 2) }

fn show(xs: i64[]) -> str { xs.map(to_str).join(sep=",") }

fn main() !prints {
    print(show(scaled_above([1, 5, 3], 2)));
    print(show(scaled_above_short([1, 5, 3], 2)));
    print(show(scaled_above([], 2)));
    print(show(scaled_above_short([], 2)));
}
