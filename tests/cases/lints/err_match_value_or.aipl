import { print, saturating_divide as /, to_str } from builtins;

// `match (o) { some(v) => v, none => d }` unwraps an optional to its payload
// with a fallback, which is exactly what `value_or` does — in one line, without
// naming either case.
//
// The `some` arm handing back its own binding unchanged is what makes this a
// `value_or` rather than a `map`. Arm order does not matter, so the second
// function below is flagged too.
fn or_zero(o: i64?) -> i64 {
    match (o) {
        some(v) => v,
        none => 0,
    }
}

fn none_first(o: i64?) -> i64 {
    match (o) {
        none => 0,
        some(v) => v,
    }
}

struct Pt { x: i64, y: i64 }

// An inline *struct* default is flagged too. It used not to be — not for
// formatting reasons, but because `value_or` was emitted natively as a tag
// select over one i64 payload and genuinely could not unwrap such an optional.
// It is AIPL-implemented now and generic over every payload, so the rewrite the
// lint advises is one that compiles.
//
// The message names the default rather than quoting it: a construction's span
// stops at its last token, before the closing brace, so quoting it would print
// advice that doesn't parse.
fn or_origin(o: Pt?) -> Pt {
    match (o) {
        some(v) => v,
        none => Pt { x: 0, y: 0 },
    }
}

// Arithmetic in the `none` arm is flagged. It used to be exempt: `/` and `%`
// trapped on a zero divisor, so evaluating one eagerly could turn a program that
// returns into one that dies. Both are total now — `/` saturates and `%` answers
// the dividend — so a division costs the same computed eagerly as lazily, like
// any other constant.
fn or_divided(o: i64?) -> i64 {
    match (o) {
        some(v) => v,
        none => 100 / 4,
    }
}

fn main() !prints {
    print(or_zero(some(5)).to_str());
    print(none_first(none).to_str());
    print(or_origin(none).x.to_str());
    print(or_divided(none).to_str());
}
