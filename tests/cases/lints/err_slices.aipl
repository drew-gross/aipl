# The three slice lints — a bound that says only what the open-ended form
# already means — and the marker's scope.

import { len, print } from builtins;

fn main() !prints {
    let s = "hello, world";

    // `x[y..x.len()]` — the end bound is the receiver's own length, which the
    // open-ended form already means.
    print(s[3..s.len()]);

    // The three whole-receiver spellings. Each is `s` already, so each gets the
    // same one-step advice rather than a rewrite into another slice: the
    // open-end form with a zero start, the open-start form (whose `0` is
    // synthesized), and the fully-written one.
    print(s[0..]);
    print(s[..s.len()]);
    print(s[0..s.len()]);

    // `x[0..y]` — the mirror: a literal `0` start is what the open-ended form
    // already means.
    print(s[0..2]);

    // `#[allow]` is line-scoped, so a marker on the *neighbouring* line
    // squelches nothing.
    #[allow]
    print(s[4..s.len()]);
}
