# The shapes the compound lint must leave alone. Subtraction and division are
# not commutative, so a receiver on the *right* is not an accumulate at all:
# `set n = 20 - n;` is not `set n -= 20;`, and rewriting it that way would
# silently change the program.

import {
    print,
    saturating_divide as /,
    to_str,
    wrapping_add as +,
    wrapping_sub as -,
} from builtins;

struct Counter { n: i64 }

fn main() !prints {
    mut n = 10;
    set n = 20 - n; // the receiver is the subtrahend, not the accumulator
    set n = 100 / n; // likewise the divisor
    mut m = 0;
    set m = n + 1; // an accumulate onto a *different* binding
    mut c = Counter { n: 0 };
    set c.n = m + 1; // a field store fed from a different binding
    print(n.to_str());
    print(m.to_str());
    print(c.n.to_str());
}
--- stdout ---
10
11
12
