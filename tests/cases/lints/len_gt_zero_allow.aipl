import { greater_than as >, len, less_than as <, print, to_str } from builtins;

// `#[allow]` at the end of the line keeps a length comparison as written — the
// program compiles and runs. Both operand orders are squelched the same way,
// since the marker matches on the line the hit's span starts on.
fn main() !prints {
    let xs = [1, 2, 3];
    print(to_str(0 < xs.len())); #[allow]
    print(to_str(xs.len() > 0)); #[allow]
}
