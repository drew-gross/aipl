# `#[allow]` at the end of the line keeps a length comparison, or a negated
# emptiness test, as written — the program compiles and runs. Both operand
# orders are squelched the same way, since the marker matches on the line the
# hit's span starts on. The rewrite sits beside them, so the two spellings are
# proven to agree.

import {
    greater_than as >,
    is_empty,
    is_nonempty,
    len,
    less_than as <,
    logical_not as !,
    print,
    to_str,
} from builtins;

fn main() !prints {
    let xs = [1, 2, 3];
    print(to_str(0 < xs.len())); #[allow]
    print(to_str(xs.len() > 0)); #[allow]
    print(to_str(!xs.is_empty())); #[allow]
    print(to_str(xs.is_nonempty()));
}
