# `#[allow]` on the `return` line squelches `return_loop_find_index`, like any
# other lint — the long-hand loop compiles and runs as written.
#
# Both spellings are here side by side and asserted to agree, so the rewrite the
# lint advises is proven equivalent rather than merely plausible.

import { equal as ==, find_index, less_than as <, print, to_str } from builtins;

fn index_of_big_loop(xs: i64[], lo: i64) -> u64? {
    for (let i, x : xs) {
        if (lo < x) {
            return some(i); #[allow]
        };
    }
    none
}

fn index_of_big(xs: i64[], lo: i64) -> u64? { xs.find_index(|x| lo < x) }

fn main() !prints {
    let xs = [1, 5, 9];
    print(index_of_big_loop(xs, 2).to_str());
    print(index_of_big(xs, 2).to_str());

    // Found at the front, and not found at all — the two answers a sentinel
    // would conflate.
    print(index_of_big_loop(xs, 0).to_str());
    print(index_of_big(xs, 0).to_str());
    print(index_of_big_loop(xs, 99).to_str());
    print(index_of_big(xs, 99).to_str());
    print((index_of_big_loop(xs, 2) == index_of_big(xs, 2)).to_str());
}
--- stdout ---
some(1)
some(1)
some(0)
some(0)
none
none
true
