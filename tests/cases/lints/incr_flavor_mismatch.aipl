import { print, saturating_increment as ++, to_str, wrapping_add as + } from builtins;

// `+` and `++` here are *different* flavors — a wrapping add beside a saturating
// increment — so `set n = n + 1;` and `set n++;` genuinely differ and the lint
// stays quiet. It fires only when the file's two spellings resolve to the same
// implementation.
fn main() !prints {
    mut n: u8 = 255;
    set n = n + 1; // wraps to 0
    print(n.to_str());
    mut m: u8 = 255;
    set m++; // saturates at 255
    print(m.to_str());
}
