# `match (x) { K(a, b) => rest, _ => none }` as the last thing a function does —
# a variant taken apart when it is one case and given up on otherwise.
# `let K(a, b) = x.as_case(K)?;` says the early exit first and keeps the rest of
# the function at one level, instead of inside an arm.

import { print } from builtins;

variant Shape = Circle(i64) | Rect(i64, i64) | Empty

// The arm takes the payload apart.
fn radius(s: Shape) -> i64? {
    match (s) {
        Circle(r) => some(r * 2),
        _ => none,
    }
}

// Nested: the inner `match` is also the function's last act.
fn wide(s: Shape) -> i64? {
    match (s) {
        Rect(w, h) => match (Circle(w)) {
            Circle(r) => some(r + h),
            _ => none,
        },
        _ => none,
    }
}

// A case with no payload to bind.
fn only_empty(s: Shape, n: i64) -> i64? {
    match (s) {
        Empty => some(n),
        _ => none,
    }
}

fn main() !prints {
    print(`{radius(Circle(1))} {wide(Rect(1, 2))} {only_empty(Empty, 3)}`);
}
