# `-` and `--` here are *different* flavors — a wrapping subtract beside a
# saturating decrement — so `set n = n - 1;` and `set n--;` genuinely differ and
# the lint stays quiet. It fires only when the file's two spellings resolve to
# the same implementation.
#
# With the step lint quiet, the compound lint is what still has advice for that
# line (`wrapping_sub_assign as -=` does match this file's `-`), so it is
# squelched: the long-hand spelling is what this case is here to show.

import { equal as ==, print, saturating_decrement as --, to_str, wrapping_sub as - } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        mut n: u8 = 0;
        set n = n - 1; #[allow]
        // wraps to 255
        print(n.to_str());
        mut m: u8 = 0;
        set m--; // saturates at 0
        print(m.to_str());
    };
    assert(out == """
        255
        0

    """);
})
