# `#[allow]` keeps the `mut`, as every lint's escape hatch does. The marker
# goes on the seed, which is where this lint points: `#[allow]` is line-scoped,
# so the hit has to name a line that survives the formatter, and `mut out = xs;`
# is a short statement that always occupies one.

import { join, print, push, to_str } from builtins;

fn appended(xs: i64[], x: i64) -> i64[] {
    mut out = xs; #[allow]
    set out.push(x);
    out
}

// The rewrite the lint asks for, so the two spellings are checked side by side
// and proven to agree.
fn appended_short(xs: i64[], x: i64) -> i64[] { [..xs, x] }

fn show(xs: i64[]) -> str { xs$to_str().join(sep=",") }

fn main() !prints {
    print(show(appended([1, 2], 3)));
    print(show(appended_short([1, 2], 3)));
    print(show(appended([], 3)));
    print(show(appended_short([], 3)));
}
--- stdout ---
1,2,3
1,2,3
3
3
