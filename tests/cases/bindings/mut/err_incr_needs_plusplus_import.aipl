import { < } from builtins;

// `set n++;` uses the `++` operator, which must be imported on its own spelling
// — importing `+` does not enable it, even though the two share an
// implementation. Here `++` is not imported, so the operator gate rejects it,
// pointing at the `++` and naming the wrapping flavor to import.
fn bump(limit: i64) -> i64 {
    mut n = 0;
    while (n < limit) {
        set n++;
    }
    n
}
