# `set n++;` increments a mut binding by one. `++` is its own operator with its
# own flavors, imported separately from `+`: `wrapping_increment as ++` here,
# `saturating_increment as ++` for the clamping one (see
# `bindings/mut/incr_saturating`). Each shares its `+` counterpart's
# implementation, since incrementing is adding 1.

import { equal as ==, less_than as <, wrapping_increment as ++ } from builtins;

fn count_to(limit: i64) -> i64 {
    mut n = 0;
    while (n < limit) {
        set n++;
    }
    n
}.test({
    assert(count_to(5) == 5);
    assert(count_to(0) == 0);
    assert(count_to(1) == 1);
})
