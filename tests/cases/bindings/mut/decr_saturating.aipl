import { print, saturating_decrement as --, to_str } from builtins;

// `--` has the same flavors `-` does: `saturating_decrement as --` clamps at the
// type's bound where `wrapping_decrement as --` (see `decr`) wraps around it.
// Both lower to the same builtin their `-` counterpart does — decrementing is
// subtracting 1 — so the flavor is chosen entirely by which one the file imports.
fn main() !prints {
    mut n: u8 = 2;
    set n--;
    print(n.to_str()); // 1
    set n--;
    print(n.to_str()); // 0 — at the bound
    set n--;
    print(n.to_str()); // 0 — clamped, where wrapping would give 255
}
