// Every *check-phase* binding error, in one file, reported in one run. The
// checker recovers at each item, so each failing function below is recorded and
// the next is still checked.
//
// `err_incr_needs_plusplus_import` is not here: the operator-import gate is a
// *loader* check, so it aborts the file before the checker runs.

// A name nothing declares — read, and assigned to.
fn undefined_ident() -> i64 { bogus }

fn set_undeclared() -> i64 {
    set ghost = 1;
    0
}

// `set` to an immutable binding, and with a value of the wrong type.
fn set_immutable() -> i64 {
    let x = 1;
    set x = 2;
    x
}

fn set_type_mismatch() -> i64 {
    mut s = "hello";
    set s = 42;
    0
}

// A `let`/`mut` annotation: a value of the wrong type, a literal that doesn't
// fit the declared width, and a type name nothing declares.
fn annotation_mismatch() {
    let n: u8 = "hi";
}

fn annotation_literal_too_big() {
    let n: u8 = 300;
}

fn annotation_unknown_type() {
    let n: Nope = 1;
}

fn main() {}
