# `else` goes after a pattern that can fail. A name, a tuple or a struct pattern
# always matches, so its `else` could never run.

import { print } from builtins;

fn first(t: (i64, i64)) -> i64 {
    let (a, b) = t else {
        return 0;
    };
    a
}

fn main() !prints {
    print(`{first((1, 2))}`);
}
