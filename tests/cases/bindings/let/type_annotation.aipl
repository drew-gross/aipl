import {
    equal as ==,
    get,
    len,
    print,
    to_str,
    value_or,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;

// A `let` or `mut` binding may carry an explicit type: `let x: T = value;`.
// Without one a binding simply takes its initializer's type, which is the right
// default nearly always — but it leaves no way to *say* what a binding is when
// the initializer alone would infer something else. The motivating case is a
// narrow integer: `mut n = 0;` infers `i64`, and there is no context anywhere in
// the block to bend it, so a `u8` counter has to say `mut n: u8 = 0;`.
//
// With an annotation the declared type wins and the initializer is checked
// *against* it, so a bare integer literal flexes to it exactly as it would
// flowing into a parameter or a declared return type — and that reaches into
// container literals too (`let xs: u8[] = [200];`).
//
// The annotation is also the only place a value *changes* integer type: `let n:
// u8 = some_i64;` wraps to 8 bits and `let n: i64 = some_u8;` widens. That is
// deliberate — there is no conversion form, so a lossy narrowing is always
// written down as a declaration rather than buried in an expression.
//
// One limit: only the plain `let name`/`mut name` forms take an annotation, not
// the `let (a, b) = ..` / `let P { x, y } = ..` destructuring forms.

struct P { x: i64, y: i64 }

// The annotation pins the width, and every later `set` is checked (and flexes)
// against it — so the arithmetic wraps at 8 bits, not 64.
fn wrapped() -> u8 {
    mut c: u8 = 250;
    set c += 10;
    c
}.test({
    assert(wrapped() == 4); // 260 wraps to 4 in 8 bits
})

// A literal initializer flexes to the annotation, at every width.
fn widths() -> str {
    let a: i8 = -128;
    let b: u8 = 255;
    let c: i16 = -32768;
    let d: u16 = 65535;
    let e: i32 = -2147483648;
    let f: u32 = 4294967295;
    let g: u64 = 5;
    `{a} {b} {c} {d} {e} {f} {g}`
}.test({
    assert(widths() == "-128 255 -32768 65535 -2147483648 4294967295 5");
})

// It is not integer-only: any type an annotation can name works, including
// containers and user types.
fn shapes() -> str {
    let s: str = "hi";
    let xs: i64[] = [1, 2, 3];
    let o: u8? = some(9);
    let d: #{str: u8} = #{"a": 1};
    let p: P = P { x: 1, y: 2 };
    `{s} {xs.len()} {o.value_or(0)} {d.get("a").value_or(0)} {p.x + p.y}`
}.test({
    assert(shapes() == "hi 3 9 1 3");
})

// An annotated binding is still an ordinary binding: it shadows, and the
// annotation applies only to the one it introduces.
fn shadowed() -> i64 {
    let n: u8 = 200;
    let n: i64 = 7;
    n
}.test({
    assert(shadowed() == 7);
})

fn main() !prints {
    print(wrapped().to_str());
    print(widths());
    print(shapes());
    print(shadowed().to_str());
}
--- stdout ---
4
-128 255 -32768 65535 -2147483648 4294967295 5
hi 3 9 1 3
7
