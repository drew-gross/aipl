import { print, to_str, wrapping_add as +, wrapping_mul as * } from builtins;

fn tick(label: str, n: i64) !prints -> i64 {
    print(label);
    n
}

// An argument a default reads is mentioned twice in the expanded call, so the
// loader binds it to a temporary first: `noisy` runs once, not twice.
fn scaled(n: i64, by: i64 = n * 10) -> i64 { n + by }

// And the arguments *before* it are bound too, so hoisting doesn't reorder the
// side effects between them: "a" still runs before "b".
fn sum(a: i64, b: i64, c: i64 = b + 1) -> i64 { a + b + c }

fn main() !prints {
    print(to_str(scaled(tick("noisy", 3))));
    print(to_str(sum(tick("a", 1), tick("b", 2))));
}
