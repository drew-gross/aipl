# A function with keyword parameters cannot be passed as a function value:
# there is no call site to fill its defaults at, and a function type has no
# keyword parameters.

import { len, map } from builtins;

fn double(x: i64, k: i64 = 0) -> i64 { x }

fn subject() -> i64 { [1].map(double).len() }
--- check --compile ---
error: fn "double" has keyword parameters, so it cannot be passed as a function value
 --> ./tests/cases/kwargs/err_fn_value.aipl:9:31
  |
9 | fn subject() -> i64 { [1].map(double).len() }
  |                               ^^^^^^
