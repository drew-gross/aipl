# A generic function may declare a keyword parameter of concrete type.
# One typed by the function's own type variable works too, and defers its
# check to the call site — see `generic_default`.

import { len, print, to_str, wrapping_add as + } from builtins;

fn padded_len<T: any>(xs: T[], extra: i64 = 10) -> i64 {
    let n: i64 = xs.len();
    n + extra
}

fn main() !prints {
    print(to_str(padded_len([1, 2, 3])));
    print(to_str(padded_len(["a"], extra=1)));
}
--- stdout ---
13
2
