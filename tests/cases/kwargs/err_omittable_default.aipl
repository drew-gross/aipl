import { print, value_or } from builtins;

// A `k?: T` parameter's default is not a free choice: the form's whole meaning
// is "leaving the argument out yields `none`", so any other default would be a
// value of `T?` that no call site can spell — supplying the parameter passes a
// bare `T`. A parameter whose default a caller can also pass is the ordinary
// `k: T = <default>`.
fn bad_default(hi?: u64 = 0) -> u64 { hi.value_or(0) }

fn main() !prints {
    print(bad_default(hi=1));
}
--- errors ---
error: fn "bad_default": parameter "hi" is declared "hi?: T", so its default must be "none" — that is what leaving the argument out yields; write "hi: T = <default>" for a parameter whose default a caller can also pass
 --> ./tests/cases/kwargs/err_omittable_default.aipl:8:27
  |
8 | fn bad_default(hi?: u64 = 0) -> u64 { hi.value_or(0) }
  |                           ^
