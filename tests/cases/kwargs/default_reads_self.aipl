# The receiver is just the first parameter, so a default reads it like any
# other — which is what lets a width, a limit, or a separator default to
# something derived from the value the method was called on.

import { equal as ==, heap_str, len, print } from builtins;

fn head(self: str, n: u64 = self.len()) -> str { self[..n] }.test({
    assert("hello".head() == "hello");
    assert("hello".head(n=2) == "he");
})

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print("hello".head());
        print("hello".head(n=2));

        // A receiver that isn't already a name is evaluated once, into the binding
        // the default reads.
        print(heap_str("hello").head());
    };
    assert(out == """
        hello
        he
        hello

    """);
})
