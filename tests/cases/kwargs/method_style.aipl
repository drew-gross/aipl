import { equal as ==, print, to_str, wrapping_add as + } from builtins;

fn bumped(self: i64, by: i64 = 7) -> i64 { self + by }.test({
    assert(1.bumped() == 8);
    assert(1.bumped(by=2) == 3);
})

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(to_str(1.bumped()));
        print(to_str(10.bumped(by=2)));
    };
    assert(out == """
        8
        12

    """);
})
