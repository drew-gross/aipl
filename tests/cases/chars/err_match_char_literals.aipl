// Every char-match error, in one run: the domain is open so a `_` is required
// and must come last, duplicate arms are dead code, and a char literal only
// matches a `char`.

// No `_`: the arms can't cover every char.
fn missing_wildcard(c: char) -> i64 {
    match (c) {
        'a' => 1,
    }
}

// `_` before another arm makes that arm unreachable.
fn wildcard_not_last(c: char) -> i64 {
    match (c) {
        _ => 0,
        'a' => 1,
    }
}

// The same literal twice — the second can never be taken.
fn duplicate_arm(c: char) -> i64 {
    match (c) {
        'a' => 1,
        'a' => 2,
        _ => 0,
    }
}

// A char literal against a non-char scrutinee.
fn wrong_scrutinee(n: i64) -> i64 {
    match (n) {
        'a' => 1,
        _ => 0,
    }
}

// ...and against a str, whose arms are string literals.
fn char_arm_on_str(s: str) -> i64 {
    match (s) {
        'a' => 1,
        _ => 0,
    }
}

fn main() {}
