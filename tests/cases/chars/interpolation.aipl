import { print, to_str } from builtins;

// A `char` interpolates as the bare character, mirroring how a `str` does —
// `to_str` renders a text scalar Debug-style (`'c'`, `"s"`), and an
// interpolation wants the text, not its literal form. The quoting is unchanged
// everywhere else: `to_str` on the char itself, and a char nested inside a
// rendered container, both still show the literal.
fn main() !prints {
    let c = 'b';
    print(`bare: {c}`); // bare: b
    print(`built: {'x'}{'y'}{'z'}`); // built: xyz

    // `to_str` is untouched — still the quoted literal, at every nesting level.
    print(`to_str: {to_str(c)}`); // to_str: 'b'
    print(`nested: {['a', 'b']}`); // nested: ['a', 'b']

    // Indexing a `str` yields a `char?`, not a `char`, so it gets neither
    // treatment — it renders as the optional it is.
    let s = "hi";
    print(`opt: {s[0]}`); // opt: some('h')

    // A `str` interpolation is still passed through unquoted, as before.
    print(`str: {s}`); // str: hi
}
--- stdout ---
bare: b
built: xyz
to_str: 'b'
nested: ['a', 'b']
opt: some('h')
str: hi
