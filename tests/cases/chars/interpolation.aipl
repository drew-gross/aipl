import { print, to_str } from builtins;

// A `char` interpolates as the bare character, mirroring how a `str` does —
// and `to_str` is the same rendering, so `to_str(c)` is the bare character
// too. Only a char nested inside a rendered container still shows its literal
// form, where the quotes tell it apart from the structure around it.
fn main() !prints {
    let c = 'b';
    print(`bare: {c}`); // bare: b
    print(`built: {'x'}{'y'}{'z'}`); // built: xyz
    print(`to_str: {to_str(c)}`); // to_str: b
    print(`nested: {['a', 'b']}`); // nested: ['a', 'b']

    // Indexing a `str` yields a `char?`, not a `char`, so it gets neither
    // treatment — it renders as the optional it is.
    let s = "hi";
    print(`opt: {s[0]}`); // opt: some('h')

    // A `str` interpolation is still passed through unquoted, as before.
    print(`str: {s}`); // str: hi
}
--- stdout ---
bare: b
built: xyz
to_str: b
nested: ['a', 'b']
opt: some('h')
str: hi
