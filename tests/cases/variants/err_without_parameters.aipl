variant Kind = Num(i64) | Stub | Pair(Node, Node)

struct Node { kind: Kind, label: str }

// An arm builds a case the parameter may name.
fn builds_stub<X: cases>(kind: Kind without X) -> Kind without X throughout {
    match (kind) {
        Num(..) => Stub,
        Stub => Stub,
        Pair(a, b) => Pair(a, b),
    }
}

// A child is handed on as it came, not as `f` made it.
fn keeps_child<X: cases>(
    kind: Kind without X,
    f: (Node) -> Node without X throughout,
) -> Kind without X throughout {
    match (kind) {
        Num(n) => Num(n),
        Stub => Stub,
        Pair(a, b) => Pair(a, f(b)),
    }
}

fn identity<X: cases>(
    kind: Kind without X,
    f: (Node) -> Node without X throughout,
) -> Kind without X throughout {
    match (kind) {
        Num(n) => Num(n),
        Stub => Stub,
        Pair(a, b) => Pair(f(a), f(b)),
    }
}

// Nothing is known about this node's own case, so nothing is left out of the result.
fn unaware(Node { kind, label }, f: (Node) -> Node) -> Node without Stub throughout {
    Node { kind: identity(kind, f), label }
}

// `f` does not leave `Stub` out of what it returns.
fn loose(Node { kind, label }, f: (Node) -> Node) -> Node without Stub throughout {
    match (kind) {
        Stub => Node { kind: Num(0), label },
        _ => Node { kind: identity(kind, f), label },
    }
}

// A parameter that names no variant to take its cases from.
fn nowhere<X: cases>(n: Node) -> Node { n }
