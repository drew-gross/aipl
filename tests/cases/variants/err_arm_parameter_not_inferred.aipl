# A parameter only the result names has nothing to say which case it stands for: write it.

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

fn none_of<V: variant, A: arm of V>(self: V[]) -> A[] { [] }

pub fn some_of(shapes: Shape[]) -> Shape[] { shapes.none_of() }
