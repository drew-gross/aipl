# The case has to be written as a constructor name: a `Case<..>` held in a variable
# says which variant but not which case, so the result could not be typed by it.

import { as_case, case_of, print } from builtins;

variant Shape = Circle(i64) | Empty

fn main() !prints {
    let s = Circle(1);
    print(`{s.as_case(s.case_of())}`);
}
--- errors ---
error: "as_case" needs the case written as a constructor name, as in `x.as_case(Circle)` — a value of type `Case<..>` does not say which case it holds until run time, so the result could not be typed by it
  --> ./tests/cases/variants/err_as_case_value.aipl:10:23
   |
10 |     print(`{s.as_case(s.case_of())}`);
   |                       ^^^^^^^^^^^
