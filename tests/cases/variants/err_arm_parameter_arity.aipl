# The list names every type parameter and arm parameter, or all but the ones a case determines.

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

fn none_of<V: variant, A: arm of V>(self: V[]) -> A[] { [] }

pub fn circles(shapes: Shape[]) -> Circle[] { shapes.none_of::<Shape, Circle, Dot>() }
