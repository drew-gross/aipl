# An `A[]` parameter where `A` is a boxed recursive variant.
#
# Each element is a refcounted pointer, so passing the array borrows every one
# of them: the callee must not release elements it did not take, and building a
# new array from them has to retain. This is the parser library's node list —
# a rule's children arrive as exactly this shape.

import { len, print, push, to_str, wrapping_add as +, wrapping_add_assign as += } from builtins;

variant Tree = Leaf(i64) | Node(Tree, Tree)

fn total(self: Tree) -> i64 {
    match (self) {
        Leaf(v) => v,
        Node(l, r) => l.total() + r.total(),
    }
}

// Borrows: reads every element, keeps none.
fn sum_all(ts: Tree[]) -> i64 {
    mut acc = 0;
    for (let t : ts) {
        set acc += t.total();
    }
    acc
}

// Retains: each element ends up owned by the returned array as well.
fn wrap_each(ts: Tree[]) -> Tree[] {
    // The explicit push loop is the shape under test — it is what has to
    // retain each borrowed element.
    mut out: Tree[] = []; #[allow]
    for (let t : ts) {
        set out.push(Node(t, Leaf(0)));
    }
    out
}

fn main() !prints {
    let ts = [Leaf(1), Node(Leaf(2), Leaf(3)), Leaf(4)];
    print(sum_all(ts).to_str());
    let wrapped = wrap_each(ts);
    print(wrapped.len().to_str());
    // The originals survive being wrapped — the wrap retained rather than moved.
    print(sum_all(ts).to_str());
    print(sum_all(wrapped).to_str());
}
--- stdout ---
10
3
10
10

