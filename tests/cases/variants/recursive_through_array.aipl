import { equal as ==, not_equal as !=, print, to_str, wrapping_add_assign as += } from builtins;

// A variant that reaches itself only *through an array*: `CTree` carries
// `Cst[]`, and no case has a direct `Cst` payload. That is still a containment
// cycle — rendering, dropping and comparing a `Cst` each have to recurse into
// the array's elements, which are `Cst`s again — so `Cst` is boxed (a
// refcounted heap block) exactly like a directly recursive type. The array
// itself holds *external* (strong) references to its element nodes.
variant Cst = CLeaf(i64) | CTree(str, Cst[])

fn sum_kids(kids: Cst[]) -> i64 {
    mut total = 1;
    for (let k : kids) {
        set total += k.size();
    }
    total
}

fn size(self: Cst) -> i64 {
    match (self) {
        CLeaf(_) => 1,
        CTree(_, kids) => sum_kids(kids),
    }
}

fn main() !prints {
    let t = CTree("a", [CLeaf(1), CTree("b", [CLeaf(2), CLeaf(3)]), CLeaf(4)]);
    print(to_str(t));
    print(to_str(t.size()));
}.test({
    assert(CLeaf(1).size() == 1);

    // An empty child array is the other base case.
    assert(CTree("leafless", []).size() == 1);

    let t = CTree("a", [CLeaf(1), CTree("b", [CLeaf(2)])]);
    assert(t.size() == 4);

    // Structural equality recurses through the array payload.
    assert(t == CTree("a", [CLeaf(1), CTree("b", [CLeaf(2)])]));
    assert(t != CTree("a", [CLeaf(1), CTree("b", [CLeaf(9)])]));
    assert(t != CTree("a", [CLeaf(1)]));
})
