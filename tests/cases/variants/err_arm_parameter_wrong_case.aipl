# `A` is the case written, so a result declared as another case does not match it.

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

fn none_of<V: variant, A: arm of V>(self: V[]) -> A[] { [] }

pub fn squares(shapes: Shape[]) -> Square[] { shapes.none_of::<Circle>() }
