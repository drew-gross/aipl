# An arm type is its variant less every other case, so a value of one is refused
# where it is not — and a pattern for the case is refused for a value that could
# be another, which would leave the `match` it stands for incomplete.

variant Shape = Circle(i64) | Square(i64) | Dot

// A `Shape` could be a `Square` or a `Dot`.
fn from_shape(s: Shape) -> i64 {
    let Circle(r) = s;
    r
}

// A `Square` is not a `Circle`.
fn square_as_circle(s: Square) -> Circle { s }

// A pattern names a case of the value's variant, and no other.
fn wrong_case(s: Square) -> i64 {
    let Circle(r) = s;
    r
}

// A parameter's pattern is held to the same rule: a `Circle` has one slot.
fn too_many(Circle(a, b)) -> i64 { a }

fn main() {}
