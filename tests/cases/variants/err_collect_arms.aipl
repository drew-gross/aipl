# What `collect_arms` types depends on the case written in its second argument,
# so the result admits only that arm, and the argument has to be a constructor
# name rather than a `Case<..>` held in a variable.

import { collect_arms, print } from builtins;

variant Shape = Circle(i64) | Square(i64) | Dot

fn other_arm(shapes: Shape[]) -> i64 {
    mut sum = 0;
    for (let c : shapes.collect_arms(Circle)) {
        set sum = match (c) {
            Circle(r) => r,
            Square(w) => w,
        };
    }
    sum
}

fn held_case(shapes: Shape[]) {
    let held: Case<Shape> = Dot;
    print(`{shapes.collect_arms(held)}`);
}

fn main() {}
