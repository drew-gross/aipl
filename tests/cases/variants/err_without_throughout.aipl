# The ways `V without C throughout` is refused: a plain `V` where it is wanted, a
# construction with a `C` somewhere inside, an arm for the excluded case (at the top or in a
# part), a case nothing in the base can hold, and a base that holds nothing to refine.

variant Shape = Dot | Circle(i64) | Group(Shape[])

variant Solid = Shape without Dot throughout

fn takes(s: Solid) -> i64 { 1 }

fn plain(s: Shape) -> i64 { takes(s) }

fn dot_inside() -> i64 { takes(Group([Circle(1), Dot])) }

fn arm_for_excluded(s: Solid) -> str {
    match (s) {
        Dot => "dot",
        Circle(..) => "circle",
        Group(..) => "group",
    }
}

fn arm_in_a_part(s: Solid) -> i64 {
    match (s) {
        Circle(..) => 0,
        Group(parts) => {
            for (let part : parts) {
                match (part) {
                    Dot => takes(part),
                    Circle(..) => 0,
                    Group(..) => 0,
                };
            }
            1
        },
    }
}

fn no_such_case(s: Shape without Nope throughout) -> i64 { 1 }

fn nothing_to_hold(n: i64 without Dot throughout) -> i64 { 1 }
