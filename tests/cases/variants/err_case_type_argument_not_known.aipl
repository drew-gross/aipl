# The type argument is held to: a `Shape` may be a `Square`, so it does not fit a `Circle`.

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

fn same<T: any>(x: T) -> T { x }

pub fn circle_of(s: Shape) -> Circle { same::<Circle>(s) }
