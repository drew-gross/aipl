# The case written for an arm parameter has to be one case of the variant.

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

fn none_of<V: variant, A: arm of V>(self: V[]) -> A[] { [] }

pub fn all_of(shapes: Shape[]) -> Shape[] { shapes.none_of::<Shape>() }
