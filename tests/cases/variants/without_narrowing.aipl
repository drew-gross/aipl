# A `match` narrows what is left of its scrutinee: once an arm names a case, a later `_`
# stands for the value less that case. When the scrutinee is a plain local, that arm sees the
# name as the refined type (`Shape without Dot`), so it can be handed on with no arm
# restating the cases that were already sorted out.

import { equal as ==, wrapping_mul as * } from builtins;

variant Shape = Dot | Circle(i64) | Square(i64)

variant Solid = Shape without Dot

fn area(s: Solid) -> i64 {
    match (s) {
        Circle(r) => 3 * r * r,
        Square(w) => w * w,
    }
}.test({
    assert(area(Circle(2)) == 12);
    assert(area(Square(3)) == 9);
})

// The scrutinee, named in the arm of a `_`, is a `Solid`.
fn area_of_rest(s: Shape) -> i64 {
    match (s) {
        Dot => 0,
        _ => area(s),
    }
}.test({
    assert(area_of_rest(Dot) == 0);
    assert(area_of_rest(Square(2)) == 4);
})

// A later arm is narrowed by every earlier one.
fn only_squares(s: Shape) -> i64 {
    match (s) {
        Dot => 0,
        Circle(r) => r,
        _ => area(s),
    }
}.test({
    assert(only_squares(Circle(5)) == 5);
    assert(only_squares(Square(5)) == 25);
})
