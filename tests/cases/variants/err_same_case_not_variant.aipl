# `same_case` carries a `variant` bound, so a scalar is rejected at the call
# site — "do these share a constructor" has no meaning for a type that has no
# constructors, and answering `==` instead would be a different question.

import { same_case } from builtins;

fn main() -> i64 { if (same_case(1, 2)) { 1 } else { 0 } }
--- errors ---
error: fn "same_case": type parameter "T" requires "variant", but was inferred as i64
 --> ./tests/cases/variants/err_same_case_not_variant.aipl:7:24
  |
7 | fn main() -> i64 { if (same_case(1, 2)) { 1 } else { 0 } }
  |                        ^^^^^^^^^^^^^^^
