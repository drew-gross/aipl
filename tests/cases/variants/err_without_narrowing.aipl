variant Shape = Dot | Circle(i64) | Square(i64)

variant Solid = Shape without Dot

fn area(s: Solid) -> i64 {
    match (s) {
        Circle(r) => r,
        Square(w) => w,
    }
}

// `Dot` is not matched above the `_`, so it is still a `Shape`.
fn unsorted(s: Shape) -> i64 {
    match (s) {
        Circle(r) => r,
        _ => area(s),
    }
}

// A nested pattern covers no case.
fn partial(s: Shape) -> i64 {
    match (s) {
        Square(1) => 1,
        _ => area(s),
    }
}

// The branch that hands on a plain `Shape` is blamed, and both missing refinements are named.
variant Round = Solid without Square

fn takes_round(r: Round) -> i64 { 1 }

fn blame_the_arm(s: Shape, flag: bool) -> i64 { takes_round(if (flag) { Circle(1) } else { s }) }
