variant Shape = Dot | Circle(i64) | Square(i64)

variant Solid = Shape without Dot

fn area(s: Solid) -> i64 {
    match (s) {
        Circle(r) => r,
        Square(w) => w,
    }
}

// `Dot` is not matched above the `_`, so it is still a `Shape`.
fn unsorted(s: Shape) -> i64 {
    match (s) {
        Circle(r) => r,
        _ => area(s),
    }
}

// A nested pattern covers no case.
fn partial(s: Shape) -> i64 {
    match (s) {
        Square(1) => 1,
        _ => area(s),
    }
}
