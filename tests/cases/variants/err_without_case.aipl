# The ways `V without C` is refused: an arm for the excluded case, a plain `V`
# (or the excluded case itself) where the refinement is wanted, a case that does
# not exist, a base that is not a variant, and a refinement that refines itself.

variant V = A | B(i64) | C

variant VMinus = V without C

fn arm_for_excluded(v: VMinus) -> str {
    match (v) {
        A => "a",
        B(..) => "b",
        C => "c",
    }
}

fn takes(v: VMinus) -> i64 { 1 }

fn plain(v: V) -> i64 { takes(v) }

fn excluded_literal() -> i64 {
    let w: VMinus = C;
    1
}

fn missing(v: VMinus) -> str {
    match (v) {
        A => "a",
    }
}

fn dead_wildcard(v: VMinus) -> str {
    match (v) {
        A => "a",
        B(..) => "b",
        _ => "never",
    }
}

fn no_such_case(v: V without Nope) -> i64 { 1 }

fn not_a_variant(n: i64 without C) -> i64 { 1 }

fn main() {}
