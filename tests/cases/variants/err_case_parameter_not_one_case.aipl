# The case written for a `Case<T>` parameter has to be one case of a variant.

import { filter, is_case } from builtins;

variant Shape = Circle(r: i64) | Square(side: i64) | Dot

pub fn of_kind(self: Shape[], arm: Case<Shape>) -> Shape[] {
    self.filter(|shape| shape.is_case(arm))
}

pub fn all_of(shapes: Shape[]) -> Shape[] { shapes.of_kind::<Shape>() }
