import { print, to_str } from builtins;

// Two shapes the desugar has to get right beyond the simple one.
struct Inner { a: i64, b: i64 }

struct Outer { inner: Inner, n: i64 }

fn main() !prints {
    let o = Outer { inner: Inner { a: 1, b: 2 }, n: 5 };

    // The base is a field path, not a bare name — so it is bound to a synthetic
    // `let` and read once, the same as any other non-name operand.
    let i2 = Inner { ..o.inner, b: 9 };
    print(i2.a.to_str());
    print(i2.b.to_str());

    // A spread inside another spread's override value. The outer expansion
    // produces the inner literal as a field value, and expansion recurses into
    // it, so both layers resolve.
    let o2 = Outer { ..o, inner: Inner { ..o.inner, a: 7 } };
    print(o2.inner.a.to_str());
    print(o2.inner.b.to_str());
    print(o2.n.to_str());
}
