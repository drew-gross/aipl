# A range expression needs no `Span` import — no name is spelled, matching
# `..` in slice position (which has always worked unimported).

import { equal as ==, print } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let r = 2..6;
        print("hello, world"[r]);
    };
    assert(out == "llo,\n");
})
