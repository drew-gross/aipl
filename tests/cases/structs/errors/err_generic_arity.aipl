# A generic type used with the wrong number of type arguments is an error.

struct Pair<A, B> { first: A, second: B }

fn take(p: Pair<i64>) -> i64 { p.first }

fn main() -> i64 { 0 }
--- errors ---
error: generic type "Pair" expects 2 type argument(s), got 1
