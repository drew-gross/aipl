# A `for` pattern names the struct it takes apart, as a `let` pattern does
# (`err_destructure_wrong_struct.aipl`): `Q` shares the field `x` with `P`, but
# sharing a field name is a coincidence rather than a contract.

struct P { x: i64, y: i64 }

struct Q { x: i64 }

fn f(ps: P[]) -> i64 {
    for (let Q { x } : ps) {
        return x;
    }
    0
}
--- errors ---
error: cannot destructure P as Q — the pattern names the struct it takes apart, and two structs that merely share field names are not interchangeable
  --> ./tests/cases/structs/err_for_destructure_wrong_struct.aipl:10:24
   |
10 |     for (let Q { x } : ps) {
   |                        ^^
