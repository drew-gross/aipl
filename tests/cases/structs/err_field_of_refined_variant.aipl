# A field read off a variant that can still be more than one case names none of them: `r`
# belongs to `Circle`, but a `Shape without Dot` may be a `Square`. The caret lands on the
# `$r` that read it.

variant Shape = Circle(r: i64) | Square(s: i64) | Dot

fn radii(shapes: (Shape without Dot)[]) -> i64[] { shapes$r }
