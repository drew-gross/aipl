import { equal as ==, len, push, value_or, wrapping_add as +, wrapping_mul as * } from builtins;

// A struct field may be an array (`str[]`), an 8-byte heap pointer. The
// field is retained on construction and released when the struct drops.
struct Tags { id: i64, names: str[] }

fn make() -> Tags {
    mut ns = ["a"];
    set ns.push("b");
    Tags { id: 7, names: ns }
}.test({
    let Tags { names, id } = make();
    assert(names[0].value_or("?") == "a");
    assert(names[1].value_or("?") == "b");
    let n: i64 = len(names);
    assert(id * 10 + n == 72);
})
