# A struct field may be an array (`str[]`) — a 24-byte value under the wide array
# layout, the block pointer in its first word. The field is retained on
# construction and released when the struct drops.

import { equal as ==, len, push, wrapping_add as +, wrapping_mul as * } from builtins;

struct Tags { id: i64, names: str[] }

fn make() -> Tags {
    mut ns = ["a"];
    set ns.push("b");
    Tags { id: 7, names: ns }
}.test({
    let Tags { names, id } = make();
    assert(names[0] == some("a"));
    assert(names[1] == some("b"));
    let n: i64 = len(names);
    assert(id * 10 + n == 72);
})
