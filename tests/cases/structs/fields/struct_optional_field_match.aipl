# `match` on an optional struct field reads the inline {tag, value} storage
# directly — here through a struct passed by reference as a parameter.
#
# `value_or` would say the same thing more briefly, and the lint says so; the
# `#[allow]` keeps the long form because exercising *this* codegen path is the
# whole point of the case.

import { equal as ==, wrapping_add as +, wrapping_sub as - } from builtins;

struct Cell { v: i64? }

fn describe(Cell { v }) -> i64 {
    match (v) {
        some(x) => x, #[allow]
        none => 0 - 1,
    }
}.test({
    let full = Cell { v: some(99) };
    let empty = Cell { v: none };
    assert(describe(full) == 99);
    assert(describe(empty) == 0 - 1);
    assert(describe(full) + describe(empty) == 98);
})
