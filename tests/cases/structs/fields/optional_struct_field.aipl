# A struct field may be an optional of another *struct* or *variant*, not only
# of a scalar, a `str` or an array. Like every optional it is stored inline and
# flat — `{ tag, Core }` — so `Inner?` is a tag plus `Inner`'s own layout, and
# `Inner??` is no wider than `Inner?`.

import { equal as ==, heap_str, map, not_equal as !=, value_or } from builtins;

struct Inner { a: i64, b: str }

variant Tag = Red | Blue(i64)

// `none` is a literal, which is all a struct-field default may be.
struct Holder { lead: i64, mid: Inner?, tag: Tag? = none, deep: Inner?? = none }

fn absent(n: i64) -> Holder { lead: n, mid: none }

fn present(n: i64) -> Holder {
    lead: n,
    mid: some(Inner { a: n, b: heap_str("here") }),
    tag: some(Blue(n)),
}.test({
    let p = present(7);
    let e = absent(7);

    // Read the field back, whole and by its own fields.
    assert(p.mid == some(Inner { a: 7, b: "here" }));
    assert(e.mid == none);
    assert(p.mid.value_or(Inner { a: 0, b: "" }).b == "here");

    // An optional of a variant is a field the same way.
    assert(p.tag == some(Blue(7)));
    assert(e.tag == none);

    // A doubly-nested optional shares the one value field, so `some(none)` and
    // `none` stay distinct.
    assert(Holder { ..e, deep: some(none) }.deep == some(none));
    assert(e.deep == none);

    // Whole-struct equality compares the optional field like any other.
    assert(p == present(7));
    assert(p != e);

    // The fields around it are untouched — a mis-sized optional slot would
    // place `tag` and `deep` on top of `mid`'s payload.
    assert(p.lead == 7);

    // Mutation through `set`, in both directions.
    mut m = e;
    set m.mid = some(Inner { a: 1, b: "x" });
    assert(m.mid == some(Inner { a: 1, b: "x" }));
    set m.mid = none;
    assert(m.mid == none);

    // A spread copies the optional field along with the rest.
    assert(Holder { ..p, lead: 9 }.mid == p.mid);

    // Unwrapping reaches the inner struct's own fields.
    assert(p.mid.map(|i| i.a) == some(7));
    assert(e.mid.map(|i| i.a) == none);

    // A statement `match` sees the payload as an ordinary inline struct.
    match (p.mid) {
        some(i) => assert(i == Inner { a: 7, b: "here" }),
        none => assert(false),
    };
})
