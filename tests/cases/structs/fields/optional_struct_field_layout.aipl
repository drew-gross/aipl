# An optional-of-struct field is sized `8 (tag) + sizeof(Core)`, so every field
# *after* it depends on the nested type's layout already being known. Layouts
# resolve in alphabetical order, so `Aaa` is laid out before the `Zzz` it holds
# — the order in which a missing resolution goes unnoticed, because the size
# falls back to one word and the next field is then placed on top of the
# payload rather than after it.

import {
    equal as ==,
    greater_than as >,
    heap_str,
    len,
    push,
    wrapping_add_assign as +=,
} from builtins;

struct Zzz { p: i64, q: i64, r: str }

struct Aaa { lead: i64, mid: Zzz?, tail: str, last: i64 }

// The opaque `n` keeps the constructor out of reach of known-constructor
// elimination, so the value really does round-trip through the field's storage.
fn build(n: i64) -> Aaa {
    lead: 11,
    mid: if (n > 0) { some(Zzz { p: 22, q: 33, r: heap_str("inner") }) } else { none },
    tail: heap_str("tail"),
    last: 44,
}.test({
    let full = build(1);
    let empty = build(0);

    // Every field around the optional reads back as written.
    assert(full.lead == 11);
    assert(full.tail == "tail");
    assert(full.last == 44);
    assert(full.mid == some(Zzz { p: 22, q: 33, r: "inner" }));

    assert(empty.lead == 11);
    assert(empty.tail == "tail");
    assert(empty.last == 44);
    assert(empty.mid == none);

    // The inner struct's own trailing field is intact too — an undersized slot
    // truncates the payload rather than the fields after it.
    match (full.mid) {
        some(z) => assert(z.r == "inner"),
        none => assert(false),
    };

    // Held in an array, so the whole struct is copied element-wise.
    mut xs = [full];
    set xs.push(empty);
    set xs.push(build(1));
    assert(xs.len() == 3);
    assert(xs[2] == some(full));

    // Built and dropped repeatedly: the `str` inside the optional payload is
    // retained and released through the optional's tag, so the case's
    // `allocations`/`deallocations` counts below are what prove it balances.
    mut seen = 0;
    for (let i : [0, 1, 0, 1, 1]) {
        let h = build(i);
        set seen += h.last;
    }
    assert(seen == 220);
})
