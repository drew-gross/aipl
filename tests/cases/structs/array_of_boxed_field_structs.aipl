# An array of structs that each hold a boxed recursive field.
#
# The struct itself is an inline composite, but one of its fields is a
# refcounted pointer — so copying a `Holder` out of the array is a *retain* of
# that field, not a byte-wise copy of a value that owns heap. That distinction
# is what `tests/cases/structs/boxed_field_with_array.aipl` locks in for a
# single struct; this is the same shape one level up, held in an array.

import { len, print, to_str, value_or, wrapping_add as + } from builtins;

variant Tree = Leaf(i64) | Node(Tree, Tree)

struct Holder { tag: i64, tree: Tree }

fn total(self: Tree) -> i64 {
    match (self) {
        Leaf(v) => v,
        Node(l, r) => l.total() + r.total(),
    }
}

fn sum_holders(hs: Holder[]) -> i64 {
    mut acc = 0;
    for (let h : hs) {
        set acc = acc + h.tag + h.tree.total();
    }
    acc
}

fn main() !prints {
    let hs = [Holder { tag: 1, tree: Leaf(10) }, Holder { tag: 2, tree: Node(Leaf(20), Leaf(30)) }];
    print(sum_holders(hs).to_str());
    print(hs.len().to_str());
    // Copying one out and reading it must not disturb the array's own reference.
    let first = hs[0];
    print(first$tree$total().value_or(0).to_str());
    print(sum_holders(hs).to_str());
}
--- stdout ---
63
2
10
63

