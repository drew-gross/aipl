// Alternatives may not bind. Every branch would have to bind the same names at
// the same types for the body to be well-typed, and nothing downstream checks
// that — so the grammar admits only binding-free patterns in an alternation,
// and a binding one is rejected outright rather than silently mis-bound.
variant V = A(i64) | B(i64)

fn first(v: V) -> i64 {
    match (v) {
        A(x) | B(x) => x,
    }
}

fn main() -> i64 { first(A(1)) }
