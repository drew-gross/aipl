# A `..` array pattern is compiled by its length, and a nested array pattern is
# compiled by a decision tree over exact lengths, so one `match` cannot hold both.

fn f(xs: i64?[]) -> i64 {
    match (xs) {
        [some(a), none] => a,
        [_, ..] => 1,
        _ => 0,
    }
}

fn main() {}
