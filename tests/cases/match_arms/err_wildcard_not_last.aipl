// Arms are tried top to bottom, so anything after a `_` can never run.
variant Shape = Circle(i64) | Square(i64) | Point

fn size(s: Shape) -> i64 {
    match (s) {
        _ => 0,
        Circle(r) => r,
    }
}

fn main() {
    let n = size(Point);
}
