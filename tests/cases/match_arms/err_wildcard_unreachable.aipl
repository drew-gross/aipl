// A `_` with nothing left to cover is dead code — and the shape that would go
// quiet the moment the last case it stood for is removed.
variant Shape = Circle(i64) | Square(i64) | Point

fn size(s: Shape) -> i64 {
    match (s) {
        Circle(r) => r,
        Square(w) => w,
        Point => 0,
        _ => 1,
    }
}

fn main() {
    let n = size(Point);
}
