import { print } from builtins;

// An arm every value of which an earlier arm already takes is dead code, and
// refused: `(x, y)` matches everything, so `(0, none)` can never run.
fn f(a: i64, b: i64?) -> str {
    match (a, b) {
        (x, y) => "b",
        (0, none) => "c",
    }
}

fn main() !prints {
    print(f(1, none));
}
--- errors ---
