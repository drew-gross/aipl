import { print, to_str, wrapping_increment as ++ } from builtins;

// An expression `match` produces a value, so it may not *also* mutate: reading
// `let v = match (..) {..}` should tell you the whole effect. This arm assigns
// to `n`, declared outside the `match`. Either make every arm a statement (and
// end the `match` with `;`), or lift the assignment out.
variant Ev = Tick | Tock

fn main() !prints {
    mut n = 0;
    let v = match (Tick) {
        Tick => {
            set n++;
            1
        },
        Tock => 2,
    };
    print(v.to_str());
    print(n.to_str());
}
--- errors ---
