import { print } from builtins;

// Integer literals never cover their type: a match on them needs a `_` or a
// binder arm to be exhaustive.
fn f(a: i64) -> str {
    match (a) {
        1 => "one",
        2 => "two",
    }
}

fn main() !prints {
    print(f(1));
}
