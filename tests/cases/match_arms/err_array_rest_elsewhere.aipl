# `..` belongs to array patterns. A constructor pattern already has its own `Ctor(..)`.

variant Pair = Both(i64, i64)

fn f(p: Pair) -> i64 {
    match (p) {
        Both(a, ..) => a,
    }
}

fn main() {}
