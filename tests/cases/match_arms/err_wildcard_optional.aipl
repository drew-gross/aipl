import { first } from builtins;

// An optional has two cases and a name for each, so a `_` hides which one was
// meant and saves nothing. Same for a result's `ok`/`err`.
fn head_or_zero(xs: i64[]) -> i64 {
    match (xs.first()) {
        some(v) => v,
        _ => 0,
    }
}

fn main() {
    let n = head_or_zero([1]);
}
--- errors ---
