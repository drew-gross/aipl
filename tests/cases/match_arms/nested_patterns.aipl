import { print, to_str, wrapping_add as + } from builtins;

// Patterns nest. A tuple pattern matches a tuple element by element, a
// constructor's slots are patterns themselves, an integer literal matches by
// value, and a bare name in a nested slot binds what it matched. Arms are tried
// top to bottom, and the whole match is checked exhaustive — the last arm here
// is `(lo, none)`, not `_`, and it is enough together with `(lo, some(hi))`.
//
// `match (a, b)` is a tuple scrutinee without its own parentheses, and its
// elements are matched directly: no tuple is built.
fn rep_suffix(min: u64, max: u64?) -> str {
    match (min, max) {
        (1, some(1)) => "",
        (0, some(1)) => "?",
        (lo, some(hi)) => `\{{lo},{hi}\}`,
        (0, none) => "*",
        (1, none) => "+",
        (lo, none) => `\{{lo},\}`,
    }
}

variant Shape = Circle(i64) | Rect(i64, i64) | Dot

// A variant's cases and a string literal in the same tuple; a nested slot that
// is a capitalised name (`Dot`) is a case, a lowercase one (`t`) a binder.
fn describe(s: Shape, tag: str) -> str {
    match (s, tag) {
        (Circle(0), _) => "point-circle",
        (Circle(r), "big") => `big circle {r}`,
        (Circle(r), _) => `circle {r}`,
        (Rect(w, h), t) => `rect {w}x{h} {t}`,
        (Dot, _) => "dot",
    }
}

// Two levels down, and a nested result.
fn depth(o: i64??) -> str {
    match (o) {
        some(some(0)) => "zero",
        some(some(n)) => `n={n}`,
        some(none) => "inner none",
        none => "none",
    }
}

fn pair_ok(r: (i64, i64)!str) -> i64 {
    match (r) {
        ok((0, b)) => b,
        ok((a, b)) => a + b,
        err(_) => -1,
    }
}

fn main() !prints {
    print(`{rep_suffix(1, some(1))}|{rep_suffix(0, some(1))}`);
    print(rep_suffix(2, some(5)));
    print(`{rep_suffix(0, none)}{rep_suffix(1, none)}{rep_suffix(3, none)}`);
    print(describe(Circle(0), "x"));
    print(describe(Circle(4), "big"));
    print(describe(Circle(4), "small"));
    print(describe(Rect(2, 3), "t"));
    print(describe(Dot, "t"));
    print(depth(some(some(0))));
    print(depth(some(some(7))));
    print(depth(some(none)));
    print(depth(none));
    print(to_str(pair_ok(ok((0, 5)))));
    print(to_str(pair_ok(ok((2, 5)))));
    print(to_str(pair_ok(err("no"))));
    // `if let` takes a nested pattern too.
    if (let (1, some(x)) = (1, some(9))) {
        print(`x={x}`);
    };
}
