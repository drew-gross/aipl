import { print } from builtins;

// The mirror image: every arm produces a value, so this is an expression
// `match` — and throwing that value away is the mistake the rule catches. Bind
// it, return it, or make the arms statements.
variant Ev = Tick | Tock

fn main() !prints {
    match (Tick) {
        Tick => 1,
        Tock => 2,
    };
    print("done");
}
