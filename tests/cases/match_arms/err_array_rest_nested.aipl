# The elements before the `..` are plain: names, `_` and literals. A pattern
# inside one belongs in an array pattern of an exact length.

fn f(xs: i64?[]) -> i64 {
    match (xs) {
        [some(a), ..] => a,
        _ => 0,
    }
}

fn main() {}
