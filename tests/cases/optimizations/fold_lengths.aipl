# The length folder's own table: `len(e)` answered from `e`'s shape, with `e`
# never built. Every row here is a local rewrite — no counting variant is
# involved except in the `map(..).join()` one, where the mapping function is a
# producer of its own and `aipl_mono::counting_variants` picks it up.
#
# ```text
# len([])                       →  0
# len([a, b, c])                →  3
# len([a, ..xs, ..ys])          →  1 + len(xs) + len(ys)
# len(xs.sort())                →  len(xs)
# len(xs.reverse())             →  len(xs)
# len(xs.filter(p))             →  xs.count_if(p)
# len(xs.filter_map(p, f))      →  xs.count_if(p)
# len(xs.map(f).join())         →  Σ len(f(x)) for x in xs
# len(if (c) { a } else { b })  →  if (c) { len(a) } else { len(b) }
# ```
#
# `sort` and `reverse` answer with their receiver's own length, each promising
# one element out per element in.
#
# `map` promises that too, and is deliberately *not* in the table — the one row
# a reader would expect and not find. Whether a `map` is legal depends on its
# receiver: a set's `map` is refused, because that is exactly the case where the
# result can be shorter, and `set_map` is the name for it. Nothing before
# monomorphization knows the receiver's type, and monomorphization is where that
# refusal happens — so a `map` folded away here is a `map` it never sees, and
# `#{1, 2}.map(f).len()` would quietly answer 2 instead of being the error it is
# (`tests/cases/sets/err_map_on_set.aipl`). For the same reason no subtree
# holding a `map` is dropped, which is why the `..xs.map(..)` spread below keeps
# its array. The last two lines are here to show they still compute the right
# answer, not that they fold.
#
# The counters are the evidence. `pair` is gone entirely — folded through its
# counting variant and then inlined away — and `is_big` survives only as
# `count_if`'s predicate, the one folded row that still has to walk the
# elements. What the two unfolded lines cost shows up beside it: the
# `aipl_array_with_cap` and `aipl_array_push_mut` calls are the two mapped
# arrays being built, and the `aipl_arr_reserve`/`aipl_arr_extend` pair is the
# spread that holds one. Nothing above those lines allocates an array at all.

import {
    filter,
    filter_map,
    greater_than as >,
    join,
    len,
    map,
    print,
    reverse,
    sort,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

fn double(n: i64) -> i64 { n * 2 }

fn is_big(self: i64) -> bool { self > 2 }

// A producer, so the `map(..).join()` row reaches across a function boundary.
fn pair(n: i64) -> i64[] { [n, n] }

fn source() -> i64[] { [1, 2, 3, 4] }

fn main() !prints {
    let xs = source();
    print(`{[].len()} {[7, 8, 9].len()} {[0, ..xs, ..xs].len()}`);
    print(`{xs.sort().len()} {xs.reverse().len()}`);
    print(`{xs.filter(is_big).len()} {xs.filter_map(is_big, double).len()}`);
    print(`{xs.map(pair).join().len()}`);

    // Not folded, and right anyway: a `map` is left where it is, and so is the
    // spread holding one.
    print(`{xs.map(double).len()} {[0, ..xs.map(|n| n + 1)].len()}`);
}
