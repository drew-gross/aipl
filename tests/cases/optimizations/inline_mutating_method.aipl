import { len, print, push, to_str, wrapping_add as + } from builtins;

// Inlining a mutating method (`fn f(mut self: T, ..)`).
//
// The inliner used to refuse these outright. Binding a `mut self` receiver with
// a plain `let` and taking the body's value would have been nonsense twice over:
// the body is a run of assignments to that binding, and what a call *produces*
// is the mutated receiver, not the body's (void) value. The inliner now binds
// the receiver `mut` and names it after the body, which is what such a call
// means in either position it can appear:
//
//   * `set v.f(a)` parses to `set v = v.f(a)`, so the enclosing assignment
//     writes the result straight back into `v`.
//   * In value position it is copy-and-modify: the receiver was copied into the
//     inlined binding, so the caller's own binding is left alone.
//
// Both are exercised below, on a struct receiver and on an array one, and the
// `functions:` block records the point: neither method survives as a function —
// both bodies ended up in `main`.
struct Counter { n: i64 }

fn bump(mut self: Counter, by: i64) {
    set self.n = self.n + by;
}

fn append_twice(mut self: i64[], x: i64) {
    set self.push(x);
    set self.push(x);
}

// Called exactly once and too big for the small-body threshold, so this one
// reaches the *single-use* inliner rather than `inline_small` — the two select
// candidates separately and share the substitution.
fn stagger(mut self: Counter) {
    set self.n = self.n + 1;
    set self.n = self.n + 2;
    set self.n = self.n + 3;
    set self.n = self.n + 4;
    set self.n = self.n + 5;
}

fn main() !prints {
    mut c = Counter { n: 1 };
    set c.bump(5); // in place: 1 + 5
    print(c.n.to_str());

    // Value position: `c` must be untouched by the copy that `d` gets.
    let d = bump(c, 100);
    print(d.n.to_str());
    print(c.n.to_str());

    mut v = [1];
    set v.append_twice(7); // in place: one element becomes three
    print(v.len().to_str());

    let w = append_twice(v, 9);
    print(w.len().to_str());
    print(v.len().to_str());

    mut s = Counter { n: 0 };
    set s.stagger(); // 1 + 2 + 3 + 4 + 5
    print(s.n.to_str());
}
