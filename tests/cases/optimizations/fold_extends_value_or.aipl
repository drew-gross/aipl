# The extend folder's `opt.map(f).value_or([])` row: the default is what says
# the result is a sequence, the `map` is reached *through*, and `f`'s result is
# appended where it is produced.
#
# ```text
# set v.extend(opt.map(f).value_or([]));  →  match (opt) { some(x) => set v.extend(f(x)), none => () }
# ```
#
# It has its own file because it is the row that found a codegen bug, and the
# conditions were nothing like what the symptom suggested. The fold itself is
# local and obviously correct; what it *also* did was shrink the `$into` variant
# `aipl_mono::appending_variants` mints for the producer until `inline_small`
# would fold it into its caller. An inlined `mut self` method binds its receiver
# `mut` in the caller, and codegen read that binding's initializer — an owned
# parameter — as a transfer whose own drop was suppressed. True of an owned
# *value* parameter; false of an owned `mut` **receiver**, whose reference is
# released by the slot the entry tracks. Two slots owned one reference, and the
# second release freed a block still named — a wrong length, then a crash.
#
# So the shapes below are the ones that say so, and they are specific: the
# producer is **generic**, its payload is **boxed** (a recursive variant, so the
# optional's payload is refcounted), and the two producers are **mutually
# recursive**, which is what makes both of their minted variants own their
# receivers at once. Drop any one of the three and the fold compiled correctly
# while never reaching the path.
#
# What the fold saves is the array between `f` and the receiver. The `.performance`
# block on `appended` measures it: the same row costs what the `match` it is
# rewritten to costs, one allocation (the receiver growing), where a version that
# has to keep the optional's result builds a second.
#
# Each case prints the receiver's whole *contents* rather than its length: a
# mis-accounted reference reads back as a plausible-looking array, and a count
# was exactly what made the first failure look like an arithmetic bug.

import {
    equal as ==,
    extend,
    join,
    map,
    measure,
    not_equal as !=,
    print,
    push,
    value_or,
    wrapping_add as +,
    wrapping_increment as ++,
} from builtins;

variant Rule<K: variant> = Then(Rule<K>[]) | Many(Rule<K>, Rule<K>?) | Leaf(Case<K>)

variant Tok = A | B

fn styles<K: variant>(r: Rule<K>) -> i64[] {
    match (r) {
        Then(rs) => rs.map(styles).join(),
        Many(sub, sep) => [1, ..styles(sub), ..opt_styles(sep)],
        Leaf(..) => [2],
    }
}

# The row under test, and half of a mutually recursive pair with `styles`.
fn opt_styles<K: variant>(r: Rule<K>?) -> i64[] { r.map(styles).value_or([]) }

fn gather<K: variant>(r: Rule<K>) -> i64[] {
    mut v: i64[] = [];
    set v.extend(styles(r));
    v
}

# The same row where the optional is empty, so the `none` arm is what runs and
# `f` is never called.
fn gather_two<K: variant>(rs: Rule<K>[]) -> i64[] {
    mut v: i64[] = []; #[allow]
    for (let r : rs) {
        set v.extend(styles(r));
    }
    v
}

# Non-boxed, non-generic, non-recursive: the row on its own, with nothing
# refcounted in the optional at all.
fn pair(n: i64) -> i64[] { [n, n + 1] }

fn plain(o: i64?) -> i64[] {
    mut v: i64[] = [9];
    set v.extend(o.map(pair).value_or([]));
    v
}

# Purity is not required of the mapping function — the fold moves where the
# elements land, not when `f` runs — so a printing `f` prints exactly once per
# element it would have produced, and not at all on the `none` arm.
fn loud(n: i64) !prints -> i64[] {
    print(`f{n}`);
    [n]
}

// The mapping the measured functions use. `pair` is `plain`'s alone, and stays
// so: a second caller would stop it being inlined there, and move the case's own
// code for no reason that has to do with the fold.
fn twin(n: i64) -> i64[] { [n, n + 1] }

// A receiver with room to spare, built outside the measured window.
fn roomy() -> i64[] {
    mut v: i64[] = [];
    mut i: i64 = 0;
    while (i != 5) {
        set v.push(9);
        set i++;
    }
    v
}

// The row, on a receiver handed in.
fn appended(v: i64[], o: i64?) -> i64[] {
    mut out = v;
    set out.extend(o.map(twin).value_or([]));
    out
}.performance({
    // What the fold rewrites it to, written out.
    let folded = measure("folded", roomy(), |v| appended(v, some(3)));
    let by_hand = measure("by hand", roomy(), |v| matched(v, some(3)));
    assert(folded.allocations == 1);
    assert(folded.allocations == by_hand.allocations);
    assert(folded.bytes_allocated == by_hand.bytes_allocated);

    // The optional's result is read twice, so it cannot be appended where it is
    // produced: it exists, and so does an array for it.
    let kept = measure("kept", roomy(), |v| keeping(v, some(3)));
    assert(kept.allocations == 2);

    // `none` builds nothing and calls nothing.
    let nothing = measure("none", roomy(), |v| appended(v, none));
    assert(nothing.allocations == 0);
    assert(
        nothing.instructions == measure("none by hand", roomy(), |v| matched(v, none)).instructions,
    );
})

fn matched(v: i64[], o: i64?) -> i64[] {
    mut out = v;
    match (o) {
        some(x) => {
            set out.extend(twin(x));
        },
        none => {},
    };
    out
}

fn keeping(v: i64[], o: i64?) -> i64[] {
    mut out = v;
    let extra = o.map(twin).value_or([]);
    set out.extend(extra);
    set out.extend(extra);
    out
}

fn effects(o: i64?) !prints -> i64[] {
    mut v: i64[] = [];
    set v.extend(o.map(loud).value_or([]));
    v
}

fn main() !prints {
    let leaf: Rule<Tok> = Leaf(A);

    // `Leaf` alone: the recursion never reaches the row.
    print(`{gather(leaf)}`);

    // `some` payload, one level: `[1, ..styles(leaf), ..opt_styles(some(leaf))]`.
    print(`{gather(Many(leaf, some(leaf)))}`);

    // `none` payload: the row's other arm, under the same minted variant.
    print(`{gather(Many(leaf, none))}`);

    // Two levels, so a minted variant appends into a receiver another level of
    // itself has already grown.
    print(`{gather(Many(Many(leaf, some(leaf)), none))}`);

    // Reached through `map(..).join()`, which is its own folder row, so the
    // `value_or` row runs inside a loop body appending to the same receiver.
    print(`{gather(Then([Many(leaf, none), leaf]))}`);

    // The receiver crosses the loop *and* the recursion.
    print(`{gather_two([Many(leaf, some(leaf)), leaf])}`);

    print(`{plain(some(3))} {plain(none)}`);

    print(`{effects(some(7))}`);
    print(`{effects(none)}`);
}
--- stdout ---
[2]
[1, 2, 2]
[1, 2]
[1, 1, 2, 2]
[1, 2, 2]
[1, 2, 2, 2]
[9, 3, 4] [9]
f7
[7]
[]
