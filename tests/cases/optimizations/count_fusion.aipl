# Operation fusion: `xs.count(x)` compared against a bound collapses into one
# builtin that stops as soon as the answer is settled, instead of counting the
# whole collection and then comparing.
#
# All six comparisons fuse, in both operand orders — `n > xs.count(x)` is the
# same claim as `xs.count(x) < n`, so one rule covers the mirrored form.
#
# The saving is in the instructions, which the `.performance` block on `many`
# measures: it holds 201 matches, and every answer below is decided within the
# first few elements — a fraction of what counting them all costs.

import {
    Measurement,
    count,
    equal as ==,
    greater_than as >,
    greater_than_or_equal as >=,
    less_than as <,
    less_than_or_equal as <=,
    measure,
    not_equal as !=,
    print,
    repeat,
    to_str,
} from builtins;

fn many() -> i64[] { [2].repeat(201) }.performance({
    let xs = many();

    // Each comparison is decided at the second or third match, and stops there:
    // about a hundred instructions.
    assert(measure("count < 3", xs, |v| v.count(2) < 3).instructions == 133);
    assert(measure("count > 2", xs, |v| v.count(2) > 2).instructions == 127);
    assert(measure("count >= 2", xs, |v| v.count(2) >= 2).instructions == 102);
    assert(measure("count != 2", xs, |v| v.count(2) != 2).instructions == 127);
    // The bound on the left is the same claim, and costs the same.
    assert(measure("3 > count", xs, |v| 3 > v.count(2)).instructions == 133);

    // Counting them all is what they avoid: a bound the count never reaches cannot
    // stop early, and walking all 201 elements costs sixty times as much.
    let Measurement { instructions } = measure("count < 500", xs, |v| v.count(2) < 500);
    assert(instructions == 6286);
})

fn small() -> i64[] { [1, 2, 2, 3, 2] }

fn main() !prints {
    // Decided after 3 matches, not 201.
    print((many().count(2) < 3).to_str());
    print((many().count(2) > 2).to_str());
    print((many().count(2) >= 2).to_str());
    print((many().count(2) != 2).to_str());

    // Every comparison, against a count of 3.
    print((small().count(2) < 4).to_str());
    print((small().count(2) <= 2).to_str());
    print((small().count(2) > 2).to_str());
    print((small().count(2) >= 3).to_str());
    print((small().count(2) == 3).to_str());
    print((small().count(2) != 3).to_str());

    // Mirrored: the bound on the left.
    print((4 > small().count(2)).to_str());
    print((2 >= small().count(2)).to_str());
    print((3 == small().count(2)).to_str());
    print((3 != small().count(2)).to_str());

    // Zero bounds, where the early exit has to not fire too eagerly.
    print((small().count(9) < 1).to_str());
    print((small().count(9) >= 0).to_str());
    print((small().count(2) < 0).to_str());
}
