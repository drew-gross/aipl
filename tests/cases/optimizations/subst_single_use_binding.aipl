import {
    filter,
    greater_than as >,
    join,
    map,
    print,
    to_str,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

// A binding read exactly once is substituted into its use site. That removes no
// work by itself — codegen emits the same instructions for `let a = f(x); g(a)`
// as for `g(f(x))` — so what this pass is for is the *shape*: the passes that
// rewrite an expression match on its form, and a binding hides the form from
// them.
//
// `kept` is the motivating case. Written with the binding, `filter` and `map`
// are two passes over the elements with an intermediate array between them,
// because the fusion pass looks for a call whose receiver is another call and
// finds a call on a *name*. Substituted, it is `xs.filter(..).map(..)`, which
// fuses — the `functions:` block below has a `__filter_map` instance and no
// separate `map` over an intermediate.
fn big_doubled(xs: i64[]) -> i64[] {
    let kept = xs.filter(|x| x > 2);
    kept.map(|x| x * 2)
}

fn show(xs: i64[]) -> str { xs.map(to_str).join(sep=",") }

// The three shapes that keep their binding.

fn scale(x: i64) -> i64 { x * 10 }

// One use, but inside a loop body: substituting would recompute it per element
// instead of once, which is a pessimization rather than an optimization.
fn in_loop(xs: i64[]) -> i64 {
    let base = scale(2);
    mut total = 0;
    for (let x : xs) {
        set total = total + base + x;
    }
    total
}

// The value reads `w`, and `w` is written between the binding and the use — so
// moving the value to the use would compute it from the new value. It still
// sees 1, not 100.
fn write_between() -> i64 {
    mut w = 1;
    let a = scale(w);
    set w = 100;
    a + w
}

// An effectful value keeps its place: moving it past the `print` below would
// reorder the two lines.
fn announce(x: i64) !prints -> i64 {
    print("computing");
    x + 1
}

fn effect_order() !prints -> i64 {
    let a = announce(1);
    print("after");
    a
}

fn main() !prints {
    print(show(big_doubled([1, 5, 3])));
    print(in_loop([1, 2]).to_str());
    print(write_between().to_str());
    print(effect_order().to_str());
}
