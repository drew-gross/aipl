# A struct parameter can be owned too. Where an array parameter is owned when
# the body consumes it as `mut y = p`, a struct one is owned when the body
# reads it only through its fields, each heap-owning field at most once and
# never in a loop: every such read is then a *move* of that field — its
# reference goes to the value read, nothing is retained — and what the body
# never read is released at exit. A fresh argument (a literal, a call
# result) moves in whole; a binding at its last use moves in through
# `__move`; anything else is retained field by field and released by the
# callee, as any borrowed argument is.
#
# The payoff is `merge`: `self.kinds` taken out of an owned `self` is a set
# this scope owns outright, and `union` on such a receiver grows it in place
# (`aipl_set_union_mut`, behind an `aipl_arr_reserve` that copies a block
# anyone else still holds) instead of building a fresh set.

import { equal as ==, len, logical_or as ||, union } from builtins;

struct First { kinds: #{i64} = #{}, texts: #{str} = #{}, nullable: bool = false }

fn merge(self: First, other: First) -> First {
    kinds: self.kinds.union(other.kinds),
    texts: self.texts.union(other.texts),
    nullable: self.nullable || other.nullable,
}

fn fold(parts: First[]) -> First {
    mut acc: First = First { nullable: true };
    for (let sub : parts) {
        if (acc.nullable) { set acc = First { ..acc.merge(sub), nullable: sub.nullable }; };
    }
    acc
}

struct Named { name: str, tags: str[] }

fn rename(self: Named, suffix: str) -> Named { name: `{self.name}{suffix}`, tags: self.tags }

fn width(n: Named) -> u64 { n.name.len() } #[allow]

test({
    let f = fold([
        First { kinds: #{1}, nullable: true },
        First { texts: #{"a"}, nullable: true },
        First { kinds: #{2}, texts: #{"b"} },
    ]);
    assert(`{f}` == """First { kinds: {1, 2}, texts: {"a", "b"}, nullable: false }""");
    let g = fold([First { kinds: #{5}, nullable: true }, First { kinds: #{6} }]);
    assert(`{g}` == "First { kinds: {5, 6}, texts: {}, nullable: false }");
    // Two fresh receivers: both move in whole.
    assert(
        `{First { kinds: #{9} }.merge(First { texts: #{"z"} })}` == """First { kinds: {9}, texts: {"z"}, nullable: false }""",
    );

    // A borrowed struct is retained field by field and stays intact; a fresh
    // one moves; a chain of fresh results moves at every step.
    let n = Named { name: "x", tags: ["p", "q"] };
    assert(
        `{n.rename("!")} {n}` == """Named { name: "x!", tags: ["p", "q"] } Named { name: "x", tags: ["p", "q"] }""",
    );
    assert(`{Named { name: "y", tags: [] }.rename("?")}` == """Named { name: "y?", tags: [] }""");
    assert(
        `{width(n.rename("."))} {width(n)} {n}` == """2 1 Named { name: "x", tags: ["p", "q"] }""",
    );
    let m = Named { name: "z", tags: ["r"] };
    assert(`{m.rename("+").rename("-")}` == """Named { name: "z+-", tags: ["r"] }""");
    // A binding at its last use moves in whole.
    let k = Named { name: "k", tags: ["s", "t", "u"] };
    assert(`{k.rename("=")}` == """Named { name: "k=", tags: ["s", "t", "u"] }""");
})
