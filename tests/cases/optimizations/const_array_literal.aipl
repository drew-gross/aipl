# A constant array literal — every element a scalar literal, or no elements at
# all — is laid out in the binary's data section, exactly as a string literal
# is. Reading one costs no allocation: the `.performance` blocks below measure
# none for `digits()`, `flags()` or `letters()` (a `char[]` literal *is* a static
# `str`, the same object `"abc"` is).
#
# A static block is shared by every evaluation of the literal, so nothing may
# write into it. Every path that would — `push`/`extend` on an exclusive
# `mut`, the in-place buffer reuse behind `map`/`filter` on a fresh value —
# copies the block first, which is why `digits()` still reads `[0, 3, 5]` after
# each of them has had a turn: the one allocation each of them is measured to
# make is exactly that copy. The same guard is what makes `xs.reverse().map(f)` correct — a
# reversed *view* isn't a writable block either, and the in-place `map` used to
# store straight through it.

import {
    Measurement,
    equal as ==,
    extend,
    filter,
    len,
    map,
    measure,
    print,
    push,
    reverse,
    wrapping_add as +,
    wrapping_mul as *,
} from builtins;

fn digits() -> i64[] { [0, 3, 5] }.performance({
    // Reading the literal costs nothing but the call.
    assert(measure("read", 0, |_| digits()).allocations == 0);

    // Every way of writing into it copies the block first, once.
    assert(measure("map", 0, |_| digits().map(|x| x + 1)).allocations == 1);
    assert(measure("filter", 0, |_| digits().filter(|x| x == 3)).allocations == 1);
    assert(measure("reverse then map", 0, |_| [1, 2, 3].reverse().map(|x| x * 2)).allocations == 1);

    // A `mut` seeded from the constant: the first append copies, and the later
    // ones grow the copy in place — still one allocation for all three.
    let Measurement { allocations, bytes_allocated, peak_live_bytes } = measure(
        "seeded mut",
        0,
        |_| {
            mut xs = [0, 3, 5];
            set xs.push(7);
            set xs.push(8);
            set xs.extend([1, 2]);
            xs.len()
        },
    );
    assert(allocations == 1);
    assert(bytes_allocated == 48);
    assert(peak_live_bytes == 80);
})

fn flags() -> bool[] { [true, false, true, true, true, true, true, true, false] }.performance({
    assert(measure("read", 0, |_| flags()).allocations == 0);
})

fn letters() -> char[] { ['a', 'b', 'c'] }.performance({
    assert(measure("read", 0, |_| letters()).allocations == 0);
})

fn main() !prints {
    print(`{digits()} {flags()} {letters()} {[-1, -2]} {[]}`);

    // A function's own literal is a constant too, and the caller may treat the
    // result as fresh: the in-place `map` copies before it writes.
    print(`{digits().map(|x| x + 1)}`);
    print(`{digits().filter(|x| x == 3)}`);
    print(`{digits()}`);

    // An exclusive `mut` seeded from a constant: the first append copies, the
    // rest grow the copy in place.
    mut xs = [0, 3, 5];
    set xs.push(7);
    set xs.push(8);
    set xs.extend([1, 2]);
    print(`{xs} {digits()}`);

    // A reversed view over a constant is neither static nor a heap block of
    // its own; `map` in place copies it too.
    print(`{[1, 2, 3].reverse().map(|x| x * 2)}`);
    print(`{[1, 2, 3].reverse().filter(|x| x == 2)}`);
    // The same literal anywhere is one data object.
    print(`{[0, 3, 5] == digits()} {letters() == ['a', 'b', 'c']} {flags().len()}`);
}
--- stdout ---
[0, 3, 5] [true, false, true, true, true, true, true, true, false] ['a', 'b', 'c'] [-1, -2] []
[1, 4, 6]
[3]
[0, 3, 5]
[0, 3, 5, 7, 8, 1, 2] [0, 3, 5]
[6, 4, 2]
[2]
true true 9
