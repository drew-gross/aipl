import {
    concat as +++,
    equal as ==,
    extend,
    len,
    print,
    push,
    union,
    wrapping_add as +,
    wrapping_add_assign as +=,
} from builtins;

// A heap binding passed to a user function at its last use is *moved* — the
// caller hands over the reference it holds instead of retaining a second one
// for the callee and releasing its own at scope exit. Mono marks such
// arguments (`move_last_use`), and what this case pins is that every one of
// the shapes below still computes the right answer: the moves are invisible
// except in the `--- performance ---` counts, and the borrows that must
// survive — an alias, a later read, a use inside a loop — do.
fn consume(xs: i64[]) -> u64 { xs.len() }

fn grow(xs: i64[]) -> i64[] {
    mut ys = xs;
    for (let i : "ab") {
        set ys.push(9);
    }
    ys
}

# The same shape as a method: a `self` receiver is a parameter like any
# other, so the receiver of `xs.extended()` moves in the same way — fresh, or
# a binding at its last use.
fn extended(self: i64[]) -> i64[] {
    mut ys = self;
    for (let i : "ab") {
        set ys.push(8);
    }
    ys
}

# Two heap parameters, each consumed into its own `mut`: a call moves in
# whichever of them it has a fresh (or last-use) argument for, and gets the
# instance owning exactly those — `merge$own0$own1`, `merge$own0`, or the
# borrowing `merge`.
fn merge(a: i64[], b: i64[]) -> i64[] {
    mut xs = a;
    mut ys = b;
    set ys.push(0);
    set xs.extend(ys);
    xs
}

fn stretch(s: str) -> str { s +++ "!" }

fn widen(s: #{i64}) -> #{i64} { s.union(#{7}) }

fn build(n: i64) -> i64[] { [n, n + 1, n + 2] }

fn main() !prints {
    // An immutable binding, read once and then handed over.
    let a = build(1);
    print(`{a.len()} {consume(a)}`);

    // A `mut` array reassigned from a call on itself: the old value moves into
    // the call, the new one lands in the slot.
    mut b = build(1);
    set b = grow(b);
    set b = grow(b);
    print(`{b}`);

    // The same for a `mut` str — a wide value that lives in its slot.
    mut s = "ab";
    set s = stretch(s);
    set s = stretch(s);
    print(s);

    // And a `mut` set.
    mut t = #{1};
    set t = widen(t);
    print(`{t}`);

    // An alias holds no reference of its own, so the binding it reads through
    // is never moved: `c` stays valid after `d` is handed over.
    let c = build(4);
    let d = c;
    print(`{consume(d)} {c}`);

    // A later read keeps the earlier call a borrow.
    let e = build(7);
    let n = consume(e);
    print(`{n} {e}`);

    // A use inside a loop is followed by the next iteration, so it borrows;
    // the use after the loop is the last one.
    let f = build(2);
    mut total: u64 = 0;
    for (let i : "abc") {
        set total += consume(f);
    }
    print(`{total} {consume(f)}`);

    // Each branch has its own last use.
    let g = build(3);
    let h = if (total == 9) { consume(g) } else { grow(g).len() };
    print(`{h}`);

    // A binding moved from inside a branch it was declared in.
    if (total == 9) {
        let k = build(5);
        print(`{consume(k)}`);
    };

    // Both fresh; fresh and borrowed; a last-use binding and a fresh one.
    print(`{merge(build(1), build(2))}`);
    let q = build(3);
    print(`{merge(build(1), q)} {q}`);
    let r = build(4);
    print(`{merge(r, build(5))}`);

    // Receivers: a fresh one and a last-use binding move into `extended`'s
    // owned instance; one read again afterwards is borrowed, and unchanged.
    print(`{build(1).extended()}`);
    let m = build(2);
    print(`{m.extended()}`);
    let p = build(3);
    print(`{p.extended()} {p}`);
}
