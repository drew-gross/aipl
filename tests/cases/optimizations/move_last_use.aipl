[1, 2, 3, 3, 4, 5, 0] [3, 4, 5]
[4, 5, 6, 5, 6, 7, 0]
[1, 2, 3, 8, 8]
[2, 3, 4, 8, 8]
[3, 4, 5, 8, 8] [3, 4, 5]
