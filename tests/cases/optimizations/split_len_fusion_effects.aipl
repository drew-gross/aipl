# Fusion is refused when it would change what the program does: an effect
# anywhere in the expression means the pass declines, and the ordinary
# split-then-count runs. The separator here is computed by something that
# prints, so `split(..).len()` cannot be fused; the `functions:` list shows the
# array `split` still builds (`aipl_array_new`), and the output shows the print
# landing where the source put it.

import { equal as ==, len, print, split } from builtins;

fn noisy_sep() !prints -> str {
    print("sep");
    "\n"
}

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(`{"a\nb\nc".split(noisy_sep()).len()}`);
    };
    assert(out == """
        sep
        3

    """);
})
