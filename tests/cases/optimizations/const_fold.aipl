# All-constant expressions are folded at compile time: each costs exactly what
# returning the literal it folds to costs (the `.performance` block on `arith`),
# where the same expression over a variable costs more. The asserts pin the folded
# values to the run-time semantics they must match.

import {
    equal as ==,
    greater_than as >,
    greater_than_or_equal as >=,
    less_than as <,
    less_than_or_equal as <=,
    logical_and as &&,
    logical_not as !,
    logical_or as ||,
    measure,
    not_equal as !=,
    saturating_divide as /,
    saturating_remainder as %,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
} from builtins;

fn arith() -> i64 { ((2 + 3) * 10) - ((7 / 2) + (7 % 2)) }.test({
    assert(arith() == 46);
}).performance({
    let literal = measure("literal", 0, |_| 46);
    let arithmetic = measure("arith", 0, |_| arith());
    let wrapping = measure("wraps", 0, |_| wraps());
    let logic = measure("bools", 0, |_| bools());
    assert(arithmetic.instructions == literal.instructions);
    assert(wrapping.instructions == literal.instructions);
    assert(logic.instructions == literal.instructions);

    // With a variable in it, nothing folds.
    let unfolded = measure("unfolded", 5, |n| ((n + 3) * 10) - ((7 / 2) + (7 % 2)));
    assert(literal.instructions < unfolded.instructions);
})

// i64 wrapping at the boundaries: `+`/`-` here are the wrapping flavors, and
// codegen's `*` wraps too.
fn wraps() -> bool { (9223372036854775807 + 1) < 0 }.test({
    assert(wraps());
    assert(((0 - 9223372036854775807) - 2) > 0); // wraps past MIN back to MAX
    assert((3037000500 * 3037000500) < 0); // multiply wraps
})

// Comparisons fold to bools; boolean ops and unary ops over literals fold too.
fn bools() -> bool { (1 < 2) && (2 <= 2) && (3 > 2) && (2 >= 2) && (1 == 1) && (1 != 2) }.test({
    assert(bools());
    assert(!(false || (true && false)));
    assert((0 - (0 - 5)) == 5);
})

fn main() -> i64 { (6 * 7) % 100 }
--- exit code ---
42
