# Operation fusion: `xs.map(f).to_dict()` collapses into `map_to_dict`, which
# binds each `(key, value)` pair as `f` produces it — instead of mapping every
# element into a fresh array of pairs for `to_dict` to walk once and drop.
#
# The `--- report ---` is the evidence: the one `aipl_array_with_cap` is the
# pairs array of `by_square_twice`, which binds the pairs and reads them twice, so
# it has to exist. `by_square` never builds one.

import { get, len, map, print, to_dict, wrapping_add as +, wrapping_mul as * } from builtins;

fn by_square(xs: i64[]) -> #{i64: i64} { xs.map(|x| (x * x, x)).to_dict() }

fn by_square_twice(xs: i64[]) -> u64 {
    let pairs = xs.map(|x| (x * x, x));
    pairs.to_dict().len() + pairs.len()
}

fn main() !prints {
    let d = by_square([1, 2, 3, 2]);
    print(`{d.get(4)} {d.get(9)} {d.get(5)} {d.len()}`);
    print(`{by_square_twice([1, 2, 3])}`);
}
