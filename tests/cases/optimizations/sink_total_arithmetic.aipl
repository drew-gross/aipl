# Arithmetic sinks, because none of it can abort.
#
# This file used to assert the opposite. `%` trapped on a zero divisor, so
# deferring it into a branch could turn a program that dies into one that
# quietly returns — and the sinker pinned any binding whose value could reach
# one, transitively through calls. `/` had been the example before that, until
# it started saturating.
#
# Both are total now (`saturating_rem` in codegen: a zero divisor answers the
# dividend, `MIN % -1` answers 0), and `assert` — the one remaining aborting
# construct — exists only inside `.test` blocks. So no ordinary expression can
# abort, and arithmetic pins nothing.
#
# `q` is read by one arm only, so the shape is the one the pass looks for. The
# instruction counts (the `.performance` block on `pick`) are the assertion: the
# three remainders sink into the arm, so a call that does not take it executes
# none of them. Before, they ran on the discarded path and showed up in the count.
#
# The divisor comes from `len` and the flag from `is_nonempty` so constant
# folding can't collapse either away before the pass sees them.

import {
    equal as ==,
    is_nonempty,
    len,
    measure,
    print,
    saturating_remainder as %,
    to_str,
    wrapping_add as +,
} from builtins;

fn ratio(n: u64, d: u64) -> u64 { n % d }

fn scaled(n: u64, d: u64) -> u64 { ratio(n, d) + ratio(n + 1, d) + ratio(n + 2, d) }

fn pick(flag: bool, d: u64) -> u64 {
    let q = scaled(10, d);
    if (flag) { q } else { 0 }
}.performance({
    // Not taking the arm costs the branch and nothing else...
    assert(measure("arm not taken", false, |f| pick(f, 2)).instructions == 11);
    // ...where taking it pays for the three remainders.
    assert(measure("arm taken", true, |f| pick(f, 2)).instructions == 35);
})

fn main() !prints {
    print(pick("".is_nonempty(), "ab".len()).to_str());
}
