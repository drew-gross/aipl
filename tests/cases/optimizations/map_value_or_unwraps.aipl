# `sp.map(|s| src[s]).value_or("")` compiles to what the `match` it replaces
# compiled to. Inlining leaves the shape as `let self: str? = <map's match>;
# match (self) { some(v) => v, none => "" }` — a `match` on a *name* — and
# known-constructor elimination sees through the binding to the constructors
# behind it, so no optional is ever built and `v` is never bound: the `some`
# arm is the slice and the `none` arm the literal, exactly as written below.
#
# The instruction counts are the assertion (the `.performance` block on `edge`):
# the two spellings are called the same way, and each costs what the other does.

import { Span, equal as ==, map, measure, print, value_or } from builtins;

fn edge(src: str, sp: Span?) -> str { sp.map(|s| src[s]).value_or("") }.performance({
    let found: Span? = some(1..3);
    let missing: Span? = none;
    let hit = measure("map/value_or hit", found, |sp| edge("hello", sp));
    let long_hit = measure("match hit", found, |sp| edge_long("hello", sp));
    let miss = measure("map/value_or miss", missing, |sp| edge("hello", sp));
    let long_miss = measure("match miss", missing, |sp| edge_long("hello", sp));
    assert(hit.instructions == long_hit.instructions);
    assert(miss.instructions == long_miss.instructions);
})

fn edge_long(src: str, sp: Span?) -> str {
    match (sp) {
        some(s) => src[s],
        none => "", #[allow]
    }
}

fn main() !prints {
    print(edge("hello", some(1..3)));
    print(edge("hello", none));
    print(edge_long("hello", some(1..3)));
    print(edge_long("hello", none));
}
