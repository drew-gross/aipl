# The extend folder's own table: `set v.extend(src)` answered from `src`'s
# shape, with `src` never built. Every row here is a *local* rewrite; crossing
# into another function is `aipl_mono::appending_variants`' half, which
# `optimizations/appending_variant` covers.
#
# ```text
# set v.extend([]);                      →  (nothing)
# set v.extend([a, b]);                  →  set v.push(a); set v.push(b);
# set v.extend([a, ..xs, b]);            →  push a; extend xs; push b;
# set v.extend(xs.map(f).join());        →  for (let x : xs) { set v.extend(f(x)); }
# set v.extend(if (c) { a } else { b });  →  if (c) { extend a; } else { extend b; }
# ```
#
# Nothing here has to be pure, which is what sets this pass apart from the
# length folder: it drops nothing and reorders nothing. Every element the source
# would have produced is still produced by the same expression in the same
# order; it just lands in `v` directly instead of in a buffer that is then
# copied into `v`. `loud` below prints per element and prints exactly as often,
# in exactly the same order, which is what the `stdout` pins down.
#
# The one thing that does change is that the source is no longer *fully*
# evaluated before `v` grows. Only an expression reading `v` could tell, and
# `reads_receiver` is that case left alone.
#
# A `str` receiver takes `extend` but not `push` ("push requires an array"), and
# this pass runs before the types are known — so it asks the *declaration*, and
# `into_str` below keeps its `extend` rather than becoming a push.

import { equal as ==, extend, join, len, map, print, value_or, wrapping_add as + } from builtins;

fn loud(n: i64) !prints -> i64 {
    print(`e{n}`);
    n
}

fn pair(n: i64) -> i64[] { [n, n + 1] }

fn rows(xs: i64[]) !prints -> u64 {
    mut v: i64[] = [];
    set v.extend([]);
    set v.extend([loud(1), loud(2)]);
    set v.extend([loud(3), ..xs, loud(4)]);
    set v.extend(if (xs.len() == 2) { xs } else { [] });
    v.len()
}

# The rows that reach through a mapping: each piece is appended where it is
# produced, so `pair` runs once per element and nothing collects its results.
fn mapped(xs: i64[], opt: i64[]?) -> u64 {
    mut v: i64[] = [];
    set v.extend(xs.map(pair).join());
    set v.extend(opt.map(pair_all).value_or([]));
    v.len()
}

fn pair_all(ys: i64[]) -> i64[] { ys.map(pair).join() }

# Not folded: the source reads the receiver, so the appends may not interleave
# with evaluating it.
fn reads_receiver() -> u64 {
    mut v: i64[] = [1];
    set v.extend([..v, 0]);
    v.len()
}

# Not pushed: a `str` receiver takes `extend` and not `push`, so the literal
# keeps its array.
fn into_str() -> u64 {
    mut s = "ab";
    set s.extend(['c', 'd']);
    s.len()
}

fn main() !prints {
    print(`{rows([7, 8])}`);
    print(`{mapped([1, 2, 3], some([4, 5]))} {mapped([1], none)}`);
    print(`{reads_receiver()} {into_str()}`);
}
