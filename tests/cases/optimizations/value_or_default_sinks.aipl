# `value_or`'s default is an ordinary argument, so on the face of it a caller
# pays for it whether or not the optional is empty. It doesn't, and the reason
# is three passes meeting: monomorphization instantiates `value_or`, post-mono
# inlining folds the instance into its caller, and the binding holding the
# default then sits directly ahead of a `match` that only the `none` arm reads
# — which is exactly the shape the sinking pass moves into that arm.
#
# So the two calls below build one string between them, not two. The allocations
# (the `.benchmark` block on `text`) are the assertion: the call whose optional
# is present builds no default at all.

import { equal as ==, len, measure, print, to_str, value_or } from builtins;

fn fallback(n: u64) -> str { `fallback {n} padded out well past the inline limit` }

fn text(o: str?, n: u64) -> u64 { o.value_or(fallback(n)).len() }.benchmark({
    assert(measure("present", some("found"), |o| text(o, 1)).allocations == 0);
    // The default is built when it is needed: three allocations to render it.
    assert(measure("absent", none, |o| text(o, 2)).allocations == 3);
})

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(text(some("found"), 1).to_str());
        print(text(none, 2).to_str());
    };
    assert(out == """
        5
        48

    """);
})
