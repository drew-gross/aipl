# Loop fusion: `for (let pair : xs.cartesian_product(ys))` walks the pairs with two
# nested loops instead of building the array of every pairing first.
#
# The `--- report ---` is the evidence: `weighted_sum` never builds the pairs, so
# the one `aipl_array_with_cap` in the program is the array of `numbered`, whose
# index binder numbers the pairs and so keeps the loop as written.

import {
    cartesian_product,
    print,
    wrapping_add as +,
    wrapping_add_assign as +=,
    wrapping_mul as *,
} from builtins;

fn weighted_sum(n: u64) -> u64 {
    mut total: u64 = 0;
    for (let pair : (0..n).cartesian_product(0..n)) {
        set total += pair.0 * pair.1;
    }
    total
}

fn numbered(n: u64) -> u64 {
    mut total: u64 = 0;
    for (let index, pair : (0..n).cartesian_product(0..n)) {
        set total += index + pair.0;
    }
    total
}

fn main() !prints {
    print(`{weighted_sum(3)}`);
    print(`{numbered(3)}`);
}
