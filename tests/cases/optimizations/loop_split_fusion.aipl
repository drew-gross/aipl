# Operation fusion: a `for` over `s.split(sep)` walks a cursor instead of an
# array of parts.
#
# `split` on its own allocates a block and fills it with one retained view per
# part; a loop that only walks it needs neither. The fusion pass relabels the
# iterable and codegen drives a split cursor — the same cuts, in the same
# order, with the part handed straight to the body.
#
# `for (let l : src.lines())` is the shape this exists for: `lines` is
# `split("\n")` and reaches the pass inlined, with its parameter bound ahead of
# the body (`let self: str = src; split(self, "\n")`), so the fusion looks
# under that binding — which is what `numbered` below proves.
#
# The saving is in allocations, which the `.performance` block on `count_parts`
# measures: a walked split costs none, where the same split built as an array is
# one block holding a view of the source per part. With the fusion switched off
# the walked loops below each allocated that block, and ran 3,085 instructions
# where they now run 2,411.

import {
    equal as ==,
    extend,
    len,
    measure,
    print,
    rope_str,
    split,
    to_str,
    wrapping_increment as ++,
} from builtins;

fn lines(self: str) -> str[] { self.split("\n") }

// Fused through the inlined `lines`.
fn numbered(src: str) -> str {
    mut out = "";
    mut n = 0;
    for (let line : src.lines()) {
        set n++;
        set out.extend(`{n}:{line} `);
    }
    out
}

// Fused, spelled directly, with a multi-byte separator.
fn widths(s: str, sep: str) -> str {
    mut out = "";
    for (let part : s.split(sep)) {
        set out.extend(`{part.len()} `);
    }
    out
}

// The loop leaves early: the cursor owns nothing, so an abandoned walk needs no
// unwinding.
fn first_blank(s: str) -> i64 {
    mut at = 0;
    for (let line : s.lines()) {
        if (line == "") { return at; };
        set at++;
    }
    -1
}

// Not fused: the array is bound and read twice, so it has to exist.
fn materialized(s: str) -> str { `{s.lines()[1]} of {s.lines().len()}` }

// Not fused either, and this one is a correctness guard rather than a missed
// chance: the array of parts held a retained view of the source, where the
// cursor holds it without a reference of its own — so a body that writes what
// the source is read from keeps the loop as written.
fn rewriting(src: str) -> str {
    mut s = src;
    mut out = "";
    for (let p : s.split(",")) {
        set out.extend(`[{p}]`);
        set s = "";
    }
    out
}

// The walk on its own, with nothing else to allocate: the cases above build a
// string as they go, which would hide whether the split itself cost anything.
fn count_parts(s: str, sep: str) -> u64 {
    mut n: u64 = 0;
    for (let part : s.split(sep)) {
        set n++;
    }
    n
}.performance({
    let src = "the first long piece\nthe second long piece\nthe third long piece";

    // Walked, the three parts cost no allocation: the cursor hands each one to
    // the body as it cuts it.
    let walked = measure("walked", src, |s| count_parts(s, "\n"));
    assert(walked.allocations == 0);
    assert(walked.bytes_allocated == 0);

    // Built, the same split is one block holding the three parts.
    let built = measure("built", src, |s| s.split("\n"));
    assert(built.allocations == 1);
    assert(built.bytes_allocated == 104);

    // `lines` reaches the pass inlined, with its parameter bound ahead of the
    // body, and walks all the same.
    assert(measure("lines", src, count_lines).allocations == 0);

    // A loop that leaves early abandons a cursor that owns nothing.
    assert(
        measure(
            "abandoned",
            "x\ny\n\nz\nand a good deal more after that",
            first_blank,
        ).allocations == 0,
    );
})

fn count_lines(s: str) -> u64 {
    mut n: u64 = 0;
    for (let line : s.lines()) {
        set n++;
    }
    n
}

fn main() !prints {
    print(numbered("alpha\nbeta\n\ngamma"));
    print(widths("aa--b--cccc", "--"));
    // An empty separator never matches: the whole string is the one part.
    print(widths("abcd", ""));
    print(to_str(first_blank("x\ny\n\nz")));
    print(to_str(first_blank("none here")));

    // A rope source, so the cursor's walk crosses a representation it cannot
    // index directly.
    print(numbered(rope_str("one\ntw", "o\nthree")));
    // Long enough that every part is a heap window rather than an inline value.
    print(widths("first long piece\nsecond long piece", "\n"));
    print(materialized("alpha\nbeta\ngamma"));
    print(rewriting("alpha,beta,gamma"));

    // An indexed loop desugars to a counter around the same `for`, so it fuses
    // like any other.
    for (let i, part : "x--y".split("--")) {
        print(`{i}:{part}`);
    }
}
