# Operation fusion: `s.split(sep).len()` collapses into `split_len`, which runs
# `split`'s counting pass and stops there — instead of building an array of
# every part (a retained view each) only for it to be counted and dropped.
#
# The site that matters is `src.lines().len()`: `lines` is `split("\n")`, and
# it reaches the pass inlined, with its parameter bound ahead of the body
# (`let self: str = src; split(self, "\n")`). The pass looks under that binding
# for the chain, which is what `line_of` below proves — a user function of the
# same shape fuses exactly as the direct spelling does.
#
# The `functions:` list is the evidence: six strings counted, but one
# `aipl_array_new` — the array `first_and_count` binds and reads twice, which
# therefore has to exist — and no array for the other five.

import { equal as ==, join, len, split, split_len } from builtins;

fn lines(self: str) -> str[] { self.split("\n") }

// Fused, through the inlined `lines`: the shape the compiler's own `source_loc`
// computes an assertion's line number with.
fn line_of(src: str, at: u64) -> u64 { src[..at].lines().len() }

// Fused, spelled directly.
fn parts(s: str, sep: str) -> u64 { s.split(sep).len() }

// Not fused: the array is bound in between and read twice, so it has to exist.
fn first_and_count(s: str) -> str {
    let ps = s.split("\n");
    `{ps.join(sep="|")} {ps.len()}`
}

test({
    let src = "let a = 1;\nlet b = 2;\nassert(a + b == 3);\n";
    assert(`{line_of(src, 22)}` == "3");
    assert(`{parts("a--b--c", "--")}` == "3");
    // An empty separator never matches: the whole string is the one part.
    assert(`{parts("abc", "")}` == "1");
    assert(first_and_count("first\nsecond") == "first|second 2");
    // The fused builtin is importable too, and answers the same as the chain.
    assert(`{"x\ny\n".split_len("\n")} {"x\ny\n".split("\n").len()}` == "3 3");
})
