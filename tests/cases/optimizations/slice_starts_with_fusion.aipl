# Operation fusion: `xs[i..].starts_with(p)` collapses into `starts_with_at`,
# which compares in place from `i` rather than building the tail first and then
# looking at its first few elements.
#
# The slice is the expensive half. An array slice allocates a fresh block and
# copies every remaining element; a str slice allocates a view that has to be
# refcounted and dropped. Neither is ever read past `p`'s length.
#
# Measured on this case with the fusion switched off: 16 allocations totalling
# 3,880 bytes become 8 totalling 360 — mostly the 200-element copy `many()[1..]`
# makes, twice over. `instructions executed` barely moves (12,127 -> 12,082),
# because it counts a call into the runtime as one instruction however much work
# it does, and `aipl_arr_slice` is where the copying happens. The `--- report ---`
# below is the readable evidence: no slice call survives. The `.performance` block
# on `many` holds the cost: nothing allocated, and the same instructions however
# much of the array is left after the offset.

import {
    Measurement,
    equal as ==,
    less_than as <,
    measure,
    print,
    push,
    starts_with,
    to_str,
    wrapping_increment as ++,
} from builtins;

fn many() -> i64[] {
    mut xs = [7];
    mut i: u64 = 0;
    while (i < 200) {
        set xs.push(7);
        set i++;
    }
    xs
}.performance({
    let long = many();
    let short = [7, 7, 7];

    // Testing the tail copies nothing, and looks only at the pattern's length: 200
    // elements left cost the same as two.
    let long_tail = measure("200 elements left", long, |v| v[1..].starts_with([7, 7]));
    let short_tail = measure("two elements left", short, |v| v[1..].starts_with([7, 7]));
    assert(long_tail.allocations == 0);
    assert(short_tail.allocations == 0);
    assert(long_tail.instructions == short_tail.instructions);
    assert(long_tail.instructions == 128);

    // A `str` receiver builds no view for the tail either.
    let s = "hello, world!";
    let Measurement { allocations, instructions } = measure(
        "a str tail",
        s,
        |t| t[7..].starts_with("wor"),
    );
    assert(allocations == 0);
    assert(instructions == 14);
})

fn main() !prints {
    // Decided by two elements, not by copying the other 200.
    print(many()[1..].starts_with([7, 7]).to_str());
    print(many()[1..].starts_with([1, 2]).to_str());

    // A str receiver: no view is built for the tail.
    let s = "hello, world!";
    print(s[7..].starts_with("wor").to_str());
    print(s[7..].starts_with("hello").to_str());

    // Every pattern shape fuses — the sequence, a single element, an optional.
    print(s[7..].starts_with('w').to_str());
    print(s[7..].starts_with(some('w')).to_str());
    print(s[7..].starts_with(none).to_str());
    let xs = [1, 2, 3, 4];
    print(xs[2..].starts_with([3, 4]).to_str());
    print(xs[2..].starts_with(3).to_str());
    print(xs[2..].starts_with(some(3)).to_str());
    print(xs[2..].starts_with(none).to_str());

    // An offset past the end clamps exactly as the slice does: nothing is left
    // there, so only the empty pattern matches.
    print(xs[9..].starts_with([1]).to_str());
    print(xs[9..].starts_with([]).to_str());
}
