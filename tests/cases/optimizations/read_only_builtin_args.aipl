# A `mut` binding stays *exclusive* — its `push` mutates in place — as long as
# nothing else can hold a reference to its buffer. Handing it to a call used
# to count against that, whatever the call: a user function may store its
# argument anywhere. A builtin's contract is known, though, and `extend`'s
# source and `union`'s second operand are only read: the elements are copied
# out one by one, and no reference to the buffer survives the call. So `ys`
# here is still exclusive after `set xs.extend(ys)`, which is what lets both
# its pushes and `merge`'s second parameter (`mut ys = b`) go in place —
# `aipl_array_push_mut`, not the copying `aipl_array_push`, in the counts.

import { equal as ==, extend, push, union } from builtins;

fn merge(a: i64[], b: i64[]) -> i64[] {
    mut xs = a;
    mut ys = b;
    for (let i : "abc") {
        set ys.push(0);
    }
    set xs.extend(ys);
    xs
}

fn join(a: #{i64}, b: #{i64}) -> #{i64} {
    mut xs = a;
    mut ys = b;
    set ys = ys.union(#{9});
    set xs = xs.union(ys);
    xs
}

fn build(n: i64) -> i64[] { [n, n] }

test({
    assert(`{merge(build(1), build(2))}` == "[1, 1, 2, 2, 0, 0, 0]");
    assert(`{merge(build(3), build(4))}` == "[3, 3, 4, 4, 0, 0, 0]");
    assert(`{join(#{1}, #{2})}` == "{1, 2, 9}");
    assert(`{join(#{3}, #{4})}` == "{3, 4, 9}");
})
