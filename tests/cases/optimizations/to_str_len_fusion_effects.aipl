# Fusion is refused when it would change what the program does: an effect
# anywhere in the expression means the pass declines, and the ordinary
# render-then-measure runs. The value measured here is produced by something
# that prints, so `to_str(..).len()` cannot be fused; the `functions:` list
# shows the `__to_str_i64` helper still generated and called, and the output
# shows the print landing where the source put it.

import { len, print, to_str } from builtins;

fn noisy_value() !prints -> i64 {
    print("value");
    12345
}

fn main() !prints {
    print(`{noisy_value().to_str().len()}`);
}
--- stdout ---
value
5
