import { equal as ==, is_err_and, map, print, to_str, try_map } from builtins;

// A lambda that can fail *only* through a `?` still names its error type.
//
// `ok(v)` mentions no error, so it types as `v!__none__`. That is right for a
// value but wrong for a lambda, whose failures leave through the `?` in its
// body rather than through an `err(..)` the literal spells out. So a callback
// like `|x| ok(W { n: f(x)? })` used to carry a placeholder error side — and a
// higher-order function whose error type appears *nowhere but the callback*
// (`E` in `(T) -> U!E`) then had nothing anywhere to pin `E` from, and the call
// was rejected as uninferrable.
//
// The `?` is what names it: propagating an `i64!str` out of the lambda makes
// the lambda's own type `W!str`.
struct Wrapped { n: i64, tag: str }

fn checked(n: i64) -> i64!str { if (n == 0) { err("zero") } else { ok(n) } }

// A user-defined higher-order function of the same shape as the `try_map`
// builtin: `E` is mentioned by the callback and by nothing else.
fn apply_to<T: any, U: any, E: any>(self: T, f: (T) -> U!E) -> U!E { f(self) }

fn main() !prints {
    // Through a user-defined generic, both ways.
    let one = apply_to(3, |n| ok(Wrapped { n: checked(n)?, tag: "keep" }));
    print(if (one.is_err_and(|e| e == "zero")) { "err" } else { "ok" });
    let zero = apply_to(0, |n| ok(Wrapped { n: checked(n)?, tag: "keep" }));
    print(if (zero.is_err_and(|e| e == "zero")) { "err" } else { "ok" });

    // Through `try_map` — the call shape this inference was needed for. Every
    // element is wrapped, and the first failure comes back whole.
    let ws = [3, 4].try_map(|n| ok(Wrapped { n: checked(n)?, tag: "keep" }));
    print(
        match (ws) {
            ok(list) => list.map(|w| w.n).to_str(),
            err(e) => e,
        },
    );
    let bad = [3, 0, 5].try_map(|n| ok(Wrapped { n: checked(n)?, tag: "keep" }));
    print(if (bad.is_err_and(|e| e == "zero")) { "err" } else { "ok" });

    // An explicit `err(..)` still wins: a lambda that names its own error type
    // keeps it, and this inference only fills a side nothing else named.
    let named = [3].try_map(|n| if (n == 3) { err("three") } else { ok(checked(n)?) });
    print(if (named.is_err_and(|e| e == "three")) { "three" } else { "ok" });
}
