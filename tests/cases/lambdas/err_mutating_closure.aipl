# A closure that mutates what it captures names the variables it takes in `[mut ..]`, sets each of
# them in its body, and returns nothing. A variable it takes is the closure's from there on. Calling
# one is `set f(x);` on a `mut` binding, and what it is stored as says it mutates (`mut` in the
# function type), which a function type without it does not accept. The functions that are not
# marked below are accepted.

import { print, wrapping_increment as ++ } from builtins;

struct Plain { run: () -> () }

struct Mutating { run: () mut -> () }

# The variable has to be `mut`.
fn not_mut() -> () mut -> () {
    let x = 0;
    [mut x] || {
        set x++;
    }
}

# It has to be set in the body.
fn never_set() -> () mut !prints -> () {
    mut x = 0;
    [mut x] || {
        print("hi");
    }
}

# What the body sets has to be named, and what is named has to exist.
fn unlisted() -> () mut -> () {
    mut x = 0;
    mut y = 0;
    [mut x] || {
        set x++;
        set y++;
    }
}

fn nothing_to_take() -> () mut -> () {
    [mut missing] || {
        set missing++;
    }
}

fn twice() -> () mut -> () {
    mut x = 0;
    [mut x, mut x] || {
        set x++;
    }
}

# A closure that mutates returns nothing.
fn returns_a_value() -> () mut -> i64 {
    mut x = 0;
    [mut x] || {
        set x++;
        x
    }
}

# The state is written back when the body ends, which an early `return` would skip.
fn returns_early() -> () mut !prints -> () {
    mut x = 0;
    [mut x] || {
        set x++;
        return print("early");
    }
}

# The variable is the closure's once it is taken.
fn used_after() -> () mut -> () {
    mut x = 0;
    let f = [mut x] || {
        set x++;
    };
    set x++;
    f
}

# A loop that makes a closure takes a new variable each time round, not one from outside it.
fn in_a_loop() {
    mut x = 0;
    for (let i : [1, 2]) {
        let f = [mut x] || {
            set x++;
        };
        set f();
    }
}

# State the closure starts with is its own.
fn owned_state() -> () mut !prints -> () {
    [mut n = 0] || {
        set n++;
        print("tick");
    }
}

# A function that mutates is not accepted where one that does not is expected, and the other way
# round it is.
fn stored_as_plain() -> Plain {
    mut x = 0;
    Plain {
        run: [mut x] || {
            set x++;
        },
    }
}

fn stored_as_mutating() -> Mutating { run: || {} }

fn mutating_stored() -> Mutating {
    mut x = 0;
    Mutating {
        run: [mut x] || {
            set x++;
        },
    }
}

# `set f();` calls it and keeps it; `f();` would lose what it did.
fn calls() !prints {
    mut tick = owned_state();
    set tick();
    set tick();
    tick();
}

# A `let` binding cannot be set, and neither can a closure that is not a mutating one.
fn called_through_let() !prints {
    let tick = owned_state();
    set tick();
}
