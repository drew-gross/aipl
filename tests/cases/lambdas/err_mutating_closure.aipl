# A closure that mutates what it captures names the variables it takes in `[mut ..]`, sets each of
# them in its body, and returns nothing. A variable it takes is a local `mut` variable of the
# function that makes the closure, which shares it. What a closure's type says it does (`mut` in the
# function type) is not accepted where a function type without it is expected. The functions that
# are
# not marked below are accepted.

import { print, wrapping_increment as ++ } from builtins;

struct Plain { run: () -> () }

struct Mutating { run: () mut -> () }

# The variable has to be `mut`.
fn not_mut() -> () mut -> () {
    let x = 0;
    [mut x] || {
        set x++;
    }
}

# It has to be set in the body.
fn never_set() -> () mut !prints -> () {
    mut x = 0;
    [mut x] || {
        print("hi");
    }
}

# What the body sets has to be named, and what is named has to exist.
fn unlisted() -> () mut -> () {
    mut x = 0;
    mut y = 0;
    [mut x] || {
        set x++;
        set y++;
    }
}

fn nothing_to_take() -> () mut -> () {
    [mut missing] || {
        set missing++;
    }
}

fn twice() -> () mut -> () {
    mut x = 0;
    [mut x, mut x] || {
        set x++;
    }
}

# A closure that mutates returns nothing.
fn returns_a_value() -> () mut -> i64 {
    mut x = 0;
    [mut x] || {
        set x++;
        x
    }
}

# The receiver of a mutating method is a parameter, not a place to share: take a local that starts
# from it.
fn bump(mut self: i64) {
    let tick = [mut self] || {
        set self++;
    };
    tick();
}

# State the closure starts with is its own.
fn owned_state() -> () mut !prints -> () {
    [mut n = 0] || {
        set n++;
        print("tick");
    }
}

# A function that mutates is not accepted where one that does not is expected, and the other way
# round it is.
fn stored_as_plain() -> Plain {
    mut x = 0;
    Plain {
        run: [mut x] || {
            set x++;
        },
    }
}

fn stored_as_mutating() -> Mutating { run: || {} }

fn mutating_stored() -> Mutating {
    mut x = 0;
    Mutating {
        run: [mut x] || {
            set x++;
        },
    }
}

# A closure is called as any function is, and keeps what it did.
fn calls() !prints {
    let tick = owned_state();
    tick();
    tick();
}

# The old way of calling one, `set f();`, assigns what the call answers, which is nothing.
fn set_call() !prints {
    mut tick = owned_state();
    set tick();
}
