# A closure that is only ever called, `mut add = [mut sum] |x| { set sum += x; };` and `set add(x);`,
# lends the variables it takes for as long as it is called. They are the closure's until its last
# call, and the function's again after it, with what the calls made of them. The closure itself
# is never made: each call is its body, where the call is.

import {
    equal as ==,
    wrapping_add as +,
    wrapping_add_assign as +=,
    wrapping_mul as *,
} from builtins;

# A closure called in a loop, and the variable read after it.
pub fn total(xs: i64[]) -> i64 {
    mut sum = 0;
    mut add = [mut sum] |x: i64| {
        set sum += x;
    };
    for (let x : xs) {
        set add(x);
    }
    sum
}.test({
    assert(total([1, 2, 3]) == 6);
    assert(total([]) == 0);
})

# What the body reads of the function around it, and an argument that is not a variable.
pub fn scaled(xs: i64[], step: i64) -> i64 {
    mut sum = 0;
    mut add = [mut sum] |x: i64| {
        set sum += x * step;
    };
    for (let x : xs) {
        set add(x);
    }
    set add(1000);
    sum
}.test({
    assert(scaled([1, 2, 3], 10) == 10060);
})

# Two variables, and calls in the branches of an `if`.
pub fn branches(flag: bool) -> i64 {
    mut a = 0;
    mut b = 0;
    mut bump = [mut a, mut b] |by: i64| {
        set a += by;
        set b += 2 * by;
    };
    if (flag) {
        set bump(1);
    } else {
        set bump(10);
        set bump(10);
    };
    a + b
}.test({
    assert(branches(true) == 3);
    assert(branches(false) == 60);
})
