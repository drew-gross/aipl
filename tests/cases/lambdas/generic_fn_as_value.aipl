import { equal as ==, filter, len, map, print, try_map, wrapping_add as +, zip_with } from builtins;

// A generic function can be passed by name wherever a function value is
// expected: its type variables are pinned from the parameter types the
// position calls it with, exactly as a call with such arguments would pin them.
fn boxed<T: any>(x: T) -> T[] { [x] }

fn is_lone<T: any>(xs: T[]) -> bool { xs.len() == 1 }

fn pair<A: any, B: any>(a: A, b: B) -> (A, B) { (a, b) }

fn checked<T: any>(x: T) -> T!str { ok(x) }

// A user-defined higher-order function takes one the same way.
fn twice<T: any>(x: T, f: (T) -> T) -> T { f(f(x)) }

fn add_one(n: i64) -> i64 { n + 1 }

fn plus<T: any>(x: T, f: (T) -> T) -> T { f(x) }

fn main() !prints {
    // `boxed` at `T = i64`, then at `T = str` — two instances of one function.
    print(`{[1, 2].map(boxed)}`);
    print(`{["a"].map(boxed)}`);
    print(`{[[1], [2, 3], [4]].filter(is_lone)}`);
    print(`{zip_with([1, 2], ["x", "y"], pair)}`);
    match ([1, 2].try_map(checked)) {
        ok(xs) => print(`{xs}`),
        err(e) => print(e),
    };
    print(`{twice(1, add_one)}`);
    // A generic function forwarded to a generic parameter.
    print(`{plus("s", boxed_first)}`);
}

fn boxed_first<T: any>(x: T) -> T { x }
