# A higher-order *method*: its first parameter is `self`, so it's callable as
# `xs.tag(..)`. Method-call form is specialized for the lambda just like the
# function-call form (the receiver becomes the leading `self` argument).

import { equal as ==, push, to_str, wrapping_add as + } from builtins;

fn tag(self: i64[], f: (i64) -> str) -> str[] {
    // The hand-written loop is what makes this a higher-order *method*.
    mut out = []; #[allow]
    for (let x : self) {
        set out.push(f(x));
    }
    out
}.test({
    let xs = [1, 2, 3];

    // function-call form (the forwarding lambda is kept deliberately, hence
    // #[allow]; see the eta-lambda lint)
    assert(tag(xs, |x| to_str(x)) == ["1", "2", "3"]); #[allow]
    // method-call form
    assert(xs.tag(|x| to_str(x)) == ["1", "2", "3"]); #[allow]
    // A capture works in method form too.
    let suffix = 100;
    assert(xs.tag(|x| to_str(x + suffix)) == ["101", "102", "103"]);
})
