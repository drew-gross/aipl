# `map`'s third receiver is a `Span`, so a range of positions maps to one element
# per position, with the lambda handed the index — a `u64`, like every other bound
# and length. (The other two are an array and an optional.)
#
# This is what `range` was added for: `xs.range().map(|i| ..)` replaces a `mut acc`
# plus a counted `for`. A bare `a..b` works the same way, with no array in sight.

import { map, print, to_str, wrapping_add as +, wrapping_mul as * } from builtins;

fn label(i: u64) -> str { `_{i}` }

fn main() !prints {
    print((0..4).map(|i| i * i).to_str());
    // A non-zero start maps the positions it names, not `0..count`.
    print((2..5).map(|i| i).to_str());

    // Empty, and backwards — both map to nothing rather than erroring, matching
    // what `for (let i : 5..2)` iterates and what `s[5..2]` slices.
    print((0..0).map(|i| i).to_str());
    print((5..2).map(|i| i).to_str());
    // A named function, and a captured binding, exactly as over an array.
    print((0..3).map(label).to_str());
    let base: u64 = 100;
    print((0..3).map(|i| i + base).to_str());
}
