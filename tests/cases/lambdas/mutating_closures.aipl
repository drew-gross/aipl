# A closure that names a variable in its capture list, `[mut total]`, and the code that made it see
# one variable: what the closure sets is what the function reads next, and what the function sets is
# what the closure reads. A copy of the closure shares it too. State the closure starts with,
# `[mut seen = []]`, is a variable of its own that only closures made by it can reach. Calling one
# is
# an ordinary call, `f(x);`, and what a `mut` type accepts includes a function that mutates nothing.

import {
    equal as ==,
    print,
    push,
    wrapping_add_assign as +=,
    wrapping_increment as ++,
} from builtins;

# The variable read after the calls.
pub fn counted() -> i64 {
    mut n = 0;
    let tick = [mut n] || {
        set n++;
    };
    tick();
    tick();
    n
}.test({
    assert(counted() == 2);
})

# What the function sets between calls is seen by the closure, and a copy of the closure shares
# the variable.
pub fn interleaved() -> i64 {
    mut n = 0;
    let tick = [mut n] || {
        set n += 10;
    };
    let twin = tick;
    tick();
    set n++;
    twin();
    n
}.test({
    assert(interleaved() == 21);
})

# Two closures over one variable, and a heap value in it.
pub fn recorded() -> i64[] {
    mut seen: i64[] = [];
    let one = [mut seen] || {
        set seen.push(1);
    };
    let two = [mut seen] || {
        set seen.push(2);
    };
    one();
    two();
    one();
    seen
}.test({
    assert(recorded() == [1, 2, 1]);
})

# A closure that counts how often it has been called, and says so: the variable outlives the
# function that made it, in the closure.
pub fn counter() -> () mut !prints -> () {
    mut calls = 0;
    [mut calls] || {
        set calls++;
        print(`call {calls}`);
    }
}.test({
    mut lines: str[] = [];
    shim prints {
        print = |text| {
            set lines.push(text);
        },
        put = |text| {
            set lines.push(text);
        },
    } {
        let first = counter();
        let second = counter();
        first();
        first();
        second();
        first();
    };
    assert(lines == ["call 1", "call 2", "call 1", "call 3"]);
})

# A closure made over a parameter's value, and a copy that goes on from there.
pub fn adder(start: i64) -> (i64) mut !prints -> () {
    mut total = start;
    [mut total] |x: i64| {
        set total += x;
        print(`total {total}`);
    }
}.test({
    mut lines: str[] = [];
    shim prints {
        print = |text| {
            set lines.push(text);
        },
        put = |text| {
            set lines.push(text);
        },
    } {
        let a = adder(10);
        a(5);
        let twin = a;
        a(1);
        twin(100);
    };
    assert(lines == ["total 15", "total 16", "total 116"]);
})

# State the closure starts with, and a heap value in it.
pub fn recorder() -> () mut !prints -> () {
    [mut seen = []] || {
        set seen.push(7);
        print(`{seen}`);
    }
}.test({
    mut lines: str[] = [];
    shim prints {
        print = |text| {
            set lines.push(text);
        },
        put = |text| {
            set lines.push(text);
        },
    } {
        let notes = recorder();
        notes();
        notes();
    };
    assert(lines == ["[7]", "[7, 7]"]);
})

# A function that mutates nothing is accepted where one that does is expected.
pub fn plain(x: i64) !prints {
    print(`plain {x}`);
}

fn main() !prints {
    let tick = counter();
    tick();
    tick();
    let add = adder(1);
    add(2);
    let notes = recorder();
    notes();
    let quiet: (i64) mut !prints -> () = plain;
    quiet(3);
}
--- stdout ---
call 1
call 2
total 3
[7]
plain 3
