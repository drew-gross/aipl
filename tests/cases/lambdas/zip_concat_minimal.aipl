import { equal as ==, print, zip } from builtins;

fn show_strs(label: str, xs: str[]) !prints {
    print(label);
    for (let x : xs) {
        print(x);
    }
}

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        show_strs("concat", zip(["a", "b", "c"], ["x", "y"], with=|s, t| { `{s}{t}` }));
    };
    assert(out == """
        concat
        ax
        by

    """);
})
