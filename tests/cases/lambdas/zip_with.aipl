# `zip(a, b, with=f)` pairs two arrays positionally and applies `f`, like
# Haskell's zipWith / Python's `map(f, zip(a, b))`. The pairing function can be
# a lambda or a named function. The
# result runs to the shorter input (Python `zip` semantics).

import { equal as ==, print, to_str, wrapping_add as +, wrapping_mul as *, zip } from builtins;

fn tagged(x: i64, y: i64) -> i64 { x + y + 1000 }

fn show(label: str, xs: i64[]) !prints {
    print(label);
    for (let x : xs) {
        print(to_str(x));
    }
}

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let a = [1, 2, 3];
        let b = [10, 20, 30];
        show("plus", zip(a, b, with=|x, y| { x + y })); // [11, 22, 33]
        show("times", zip(a, b, with=|x, y| { x * y })); // [10, 40, 90]
        show("lambda", zip(a, b, with=|x, y| { x * y + y })); // [20, 60, 120]
        show("named", zip(a, b, with=tagged)); // [1011, 1022, 1033]
        show("shorter", zip([1, 2, 3, 4], [100, 200], with=|x, y| { x + y })); // [101, 202]
    };
    assert(out == """
        plus
        11
        22
        33
        times
        10
        40
        90
        lambda
        20
        60
        120
        named
        1011
        1022
        1033
        shorter
        101
        202

    """);
})
