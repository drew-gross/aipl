# `int` is narrower than `ord`: `char` and `str` are ordered but not integers,
# and a variable bound `ord` does not satisfy a callee that wants `int`.

fn identity<T: int>(x: T) -> T { x }

fn needs_int<T: ord>(x: T) -> T { identity(x) }

fn main() {
    identity('a');
    identity("text");
}
