# Both arguments constrain the single type parameter `T`, so they must agree.
# Here the optional's inner type (i64) and the default (char) disagree.

fn value_or<T: any>(self: T?, default: T) -> T {
    match (self) {
        some(v) => v, #[allow]
        none => default,
    }
}

fn main() -> i64 { value_or(some(7), 'z') }
--- check --compile ---
error: fn "value_or" arg 1: expected i64, got char
  --> ./tests/cases/generics/errors/err_type_param_conflict.aipl:11:38
   |
11 | fn main() -> i64 { value_or(some(7), 'z') }
   |                                      ^^^
