# The propagation is not a free pass: the enclosing variable's bound must
# actually satisfy the one the callee declares. `any` promises nothing, so
# neither call below is allowed, and the message names the enclosing variable
# rather than repeating the callee's parameter name.

import { minimum, same_case } from builtins;

variant Tok = Space | Name(str)

fn wrong_ord<T: any>(xs: T[]) -> T? { xs.minimum() }

fn wrong_variant<T: any>(a: T, b: T) -> bool { a.same_case(b) }

// `ord` and `variant` are unrelated -- neither implies the other.
fn ord_is_not_variant<T: ord>(a: T, b: T) -> bool { a.same_case(b) }

fn main() -> i64 { 0 }
