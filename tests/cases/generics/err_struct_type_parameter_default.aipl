# A struct's or variant's type parameters with a default come last: a use may leave out
# only a tail of them, so a parameter without a default cannot follow one with a default.

struct Pair<A: any = i64, B: any> { first: A, second: B }
--- check --compile ---
error: struct "Pair": a type parameter without a default follows one with a default; a use may leave out only the last ones
 --> ./tests/cases/generics/err_struct_type_parameter_default.aipl:4:8
  |
4 | struct Pair<A: any = i64, B: any> { first: A, second: B }
  |        ^^^^
