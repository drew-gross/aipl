import { len, print, to_str, wrapping_add as + } from builtins;

// An integer literal passed to a generic parameter that nothing else pins
// carries a *value*, not a width. Rather than pinning the type variable to
// `i64` — fixing the literal at 64 bits for good — the function is
// monomorphized once per literal value, with the literal inlined into the body
// in place of the parameter. That is the same bow-out an empty `[]` or a bare
// `none` argument takes (see `empty_array_arg` / `none_literal_arg`), for the
// same reason: the argument names no type the instance can't supply itself.
//
// The instance names are not observable from a case file — post-mono inlining
// folds single-call-site instances away — so this asserts behavior. The naming
// is pinned in `tests/suites/mono.rs`.
fn identity<T: any>(x: T) -> T { x }

fn wrap<T: any>(x: T) -> T[] { [x] }

fn main() !prints {
    // Once the literal is inlined, `identity`'s body *is* the literal, so the
    // call folds to it — and the folded literal then flexes to the annotation,
    // exactly as a written `let narrow: u8 = 200` would. Before, the call
    // returned `i64` and the annotation silently converted it.
    let narrow: u8 = identity(200);
    print(to_str(narrow)); // 200

    // The same call in an `i64` context is still an `i64`.
    let wide: i64 = identity(200);
    print(to_str(wide)); // 200

    // A body that isn't just the literal keeps its instance — one per value,
    // since two values are two different bodies.
    let a = wrap(5);
    let b = wrap(7);
    print(to_str(a.len() + b.len())); // 2
    print(to_str(a)); // [5]
    print(to_str(b)); // [7]
}
--- stdout ---
200
200
2
[5]
[7]
