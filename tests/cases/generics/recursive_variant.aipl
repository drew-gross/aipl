import { equal as ==, print, push, to_str, wrapping_add as + } from builtins;

// A *generic* variant that reaches itself — the parser library's `Rule<K>`.
//
// Both halves were attested separately: a recursive variant (`variants/
// recursive_list`), and a generic one (`generics/variant_infer_from_expected`).
// Together they were not, and the combination hung the compiler: recovering an
// instance's type arguments unifies the template against the instance's cases,
// so a case whose payload *is* that instance (`Then(Rule<K>[])` in `Rule$Tok`)
// asked for the arguments already being recovered, and the two calls recursed
// until the stack ran out. The guard is in `instance_args` (`aipl-mono`'s
// `check.rs` and `lib.rs` both carry a copy): a re-entrant lookup bows out, and
// the type's other cases — `Term(K)` here — do the pinning.
variant Tok = Space | Name(str)

variant Rule<K: variant> = Term(K) | Then(Rule<K>[]) | Repeat(Rule<K>) | Idx(u64)

// Recursion through an array *and* through a direct payload, so both boxing
// paths are walked on a generic instance.
fn size<K: variant>(self: Rule<K>) -> u64 {
    match (self) {
        Term(..) | Idx(..) => 1,
        Repeat(inner) => 1 + inner.size(),
        Then(rs) => {
            mut n: u64 = 1;
            for (let r : rs) {
                set n = n + r.size();
            }
            n
        },
    }
}

// Rebuilding a generic recursive variant from *inside* a generic body. Two
// things broke here, both because the constructor's type argument is still
// abstract at this point: the construction resolved to an instance named after
// the type variable that nothing else agreed with, and the payload bound by
// `Then(rs)` was read from the wrong map — typing `rs` as `i64` and so failing
// to pin `K` for the `shift_all` call below.
fn shift<K: variant>(self: Rule<K>, by: u64) -> Rule<K> {
    match (self) {
        Term(k) => Term(k),
        Idx(i) => Idx(i + by),
        Repeat(inner) => Repeat(inner.shift(by)),
        Then(rs) => Then(shift_all(rs, by)),
    }
}

fn shift_all<K: variant>(rs: Rule<K>[], by: u64) -> Rule<K>[] {
    // Kept as a loop: the point is the generic recursive payload, not how the
    // array is built.
    mut out: Rule<K>[] = []; #[allow]
    for (let r : rs) {
        set out.push(r.shift(by));
    }
    out
}

// An array literal whose elements are a *concrete* instance (`Rule<Tok>`), which
// is a different lookup again from the abstract one above.
fn grammar() -> Rule<Tok> { Then([Term(Name("")), Repeat(Idx(1))]) }

fn main() !prints {
    print(grammar().size().to_str());
    // Structural equality recurses through the boxed payloads.
    print((grammar() == grammar()).to_str());
    print(to_str(Repeat(Term(Space))));
    print(to_str(grammar().shift(2)));
}
