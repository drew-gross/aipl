# What a type parameter's default is held to: a type that parameter could be, naming
# no other parameter, and nothing without a default after one that has it. And how
# many type arguments a call may write.

fn not_the_bound<T: int = str>(x: T[]) -> u64 { 0 }

fn not_a_type<T: any = Nope>(x: T[]) -> u64 { 0 }

fn names_a_parameter<T: any, U: any = T>(x: T[], y: U[]) -> u64 { 0 }

fn out_of_order<T: any = i64, U: any>(x: T[], y: U[]) -> u64 { 0 }

fn two<T: any, U: any = u8>(x: T[], y: U[]) -> u64 { 0 }

fn three<T: any, U: any, V: any = u8>(x: T[], y: U[]) -> u64 { 0 }

fn too_few() -> u64 { three::<str>([], []) }

fn too_many() -> u64 { two::<str, u8, bool>([], []) }

fn a_type_to_hold_it() -> u64 { two::<str, str>(["a"], [1]) }
