import { minimum, print, same_case, to_str } from builtins;

// A bound is satisfiable from inside another generic body: when a call's type
// parameter resolves to one of the *enclosing* function's variables, the
// enclosing variable's declared bound is what has to satisfy it.
//
// Without this, a bounded builtin could not be called from generic code at all
// — every type variable looked alike to the checker, so there was no bound left
// to consult and `xs.minimum()` below was a compile error.
variant Tok = Space | Name(str) | IntLit(i64)

// A grammar rule, generic over the token kind -- the parser-library shape.
variant Rule<K: variant> = Term(K)

// `ord` propagates: `minimum` needs `ord`, and `T` has it.
fn smallest<T: ord>(xs: T[]) -> T? { xs.minimum() }

// `variant` propagates: `same_case` needs `variant`, and `K` has it. This is
// what makes a generic driver possible — it cannot name K's cases, and `==`
// would compare payloads, so "any Name, whatever its text" needs `same_case`.
fn matches<K: variant>(rule: Rule<K>, tok: K) -> bool {
    match (rule) {
        Term(want) => tok.same_case(want),
    }
}

fn main() !prints {
    print(smallest([3, 1, 2]).to_str());
    print(smallest(['c', 'a']).to_str());

    // The payload is ignored, so one rule matches every identifier.
    print(matches(Term(Name("")), Name("ident")).to_str());
    print(matches(Term(Name("")), Name("other")).to_str());
    // and still discriminates between cases.
    print(matches(Term(Name("")), Space).to_str());
    print(matches(Term(IntLit(0)), IntLit(42)).to_str());
}
