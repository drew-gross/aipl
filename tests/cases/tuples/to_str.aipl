import { print, to_str } from builtins;

// A tuple renders as it is written — `(1, "a")` — through `to_str` and
// interpolation alike, and nested inside anything else that renders. It lowers
// to a synthetic struct, but that struct's name and field names are the
// compiler's, and never appear in output.
fn main() !prints {
    let t = (1, "a");
    print(t.to_str());
    print(`{t}`);
    print(`{(1, (2, 3), [4])}`);
    print(`{[(1, 'x'), (2, 'y')]}`);
    print(`{some((true, "yes"))}`);
}
--- stdout ---
(1, "a")
(1, "a")
(1, (2, 3), [4])
[(1, 'x'), (2, 'y')]
some((true, "yes"))
