import { equal as ==, print, to_str } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let t = (42, "hello");
        print(to_str(t.0));
        print(t.1);
    };
    assert(out == """
        42
        hello

    """);
})
