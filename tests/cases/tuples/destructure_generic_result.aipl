# A tuple destructured from a `?` on a result a generic function returned, inside
# another generic function: the value's type is the tuple template applied to a
# type variable (`__tuple2<Parts, A[]>`), which is still a tuple.

import { equal as ==, wrapping_add as + } from builtins;

struct Parts { n: i64 }

fn split<A: any>(xs: A[]) -> (Parts, A[])!str { ok((Parts { n: 1 }, xs)) }

fn rest_of<A: any>(xs: A[]) -> (i64, A[])!str {
    let (parts, rest) = split(xs)?; #[allow]
    ok((parts.n + 1, rest))
}

test({
    assert(rest_of([1, 2])? == (2, [1, 2]));
    assert(rest_of(["a"])? == (2, ["a"]));
})
