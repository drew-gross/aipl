import { print, to_str, tuple_windows, wrapping_add as + } from builtins;

// `for (let i, (a, b) : xs)` — the indexed loop and the tuple pattern
// composed: `i` counts iterations from 0, and each element is destructured
// as `for (let (a, b) : xs)` would. The pattern needs at least two names.
fn main() !prints {
    let pairs = [(1, "one"), (2, "two"), (3, "three")];
    for (let i, (n, s) : pairs) {
        print(`{i}: {n} {s}`);
    }
    // The shape it was added for: an indexed walk over adjacent pairs.
    for (let i, (c, next) : "abcd".tuple_windows()) {
        print(`{i}: {c}{next}`);
    }
    // Nested: each loop has its own counter.
    for (let i, (a, b) : [(1, 2), (3, 4)]) {
        for (let j, (c, d) : [(5, 6)]) {
            print(`{i}{j} {to_str(a + b + c + d)}`);
        }
    }
}
