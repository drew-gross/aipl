import { print, push } from builtins;

// A bare `none` (or `[]`) takes its type from context, and a tuple slot gives
// it none: the tuple lowers to a struct named after its element types, so an
// element with no type yet has nowhere to go. This used to panic the compiler.
fn main() !prints {
    let t = (none, 1);
    print(`{t.1}`);

    // The shape that finds it in practice: a `mut` seeded with `none` and read
    // back through a pattern before anything pinned its type.
    mut prev = none;
    mut pairs = [];
    for (let x : [1, 2, 3]) {
        if (let some(p) = prev) {
            set pairs.push((p, x));
        };
        set prev = some(x);
    }
    print(`{pairs}`);
}
--- errors ---
