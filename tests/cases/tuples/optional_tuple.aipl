# `(A, B)?` — an optional tuple. A tuple type is not a `base_ty`, so it does not
# inherit `base_ty`'s chained `?`/`[]` suffixes; each `(`-led form is its own
# production, and this is the `?` one alongside `(A, B)[]` and `(A, B)!E`.

import { equal as ==, map, print, to_str, value_or } from builtins;

fn lookup(want: bool) -> (i64, str)? { if (want) { some((7, "seven")) } else { none } }

// It works as a parameter too. It does *not* chain into further suffixes:
// `(A, B)?[]` is a parse error, because the `?` production yields a whole type
// rather than a `base_ty` that more suffixes could attach to.
fn describe(p: (i64, str)?) -> str { p.map(|pair| `{pair.0}={pair.1}`).value_or("nothing") }

fn main() !prints {
    print(describe(lookup(true)));
    print(describe(lookup(false)));
    print((lookup(true) == some((7, "seven"))).to_str());
    print((lookup(false) == none).to_str());
}
--- stdout ---
7=seven
nothing
true
true
