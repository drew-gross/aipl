# Small String Optimization (SSO): a string of <= 22 bytes is stored *inline* in
# the 24-byte str value itself — no heap allocation, no refcount. 23 bytes or more
# needs a buffer; see the other string cases.
#
# SSO is invisible to program semantics: everything below prints exactly as a
# buffer-backed string would. What it is *not* is a promise that a short result
# never allocates, which this case used to claim ("ZERO heap activity", against
# counters that have long read 2). Of the four operations here the literal and
# `trim` stay inline, while the two that *build* a value allocate whatever their
# own representation needs, short result or not — which is the `allocations: 2`
# below: an 88-byte rope node for the `+++`, and an 18-byte buffer for `to_str`.

import { concat as +++, inline_str, print, to_str, trim, value_or } from builtins;

fn main() !prints {
    // `inline_str` rather than a bare `"hi"`: it names the representation the case
    // is about, and it keeps `greeting` a run-time value, so the `+++` below is a
    // run-time concat (two string literals would be constant-folded).
    let greeting = inline_str("hi").value_or(""); // inline (2 bytes), no allocation
    let banged = greeting +++ "!"; // a rope node over two inline leaves
    print(banged);
    print(trim("  ok  ")); // repacked inline -> "ok" (2 bytes), no allocation
    print(to_str(42)); // a fresh buffer -> "42" (2 bytes)
    print(""); // the empty string is inline too (a blank line)
}
--- stdout ---
hi!
ok
42

--- performance ---
allocations: 2
deallocations: 2
reallocations: 0
bytes allocated: 106
instructions executed: 89
binary size: 1888
  code: 692
  data: 1
  metadata: 1195
functions:
  __to_str_i64:
    calls: 1
    bytes: 204
  aipl_i64_len:
    calls: 2
    bytes: (external)
  aipl_write_i64:
    calls: 1
    bytes: (external)
  main:
    calls: 1
    bytes: 488
