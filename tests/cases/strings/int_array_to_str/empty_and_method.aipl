import { print, push, to_str } from builtins;

// An empty array renders as "[]". Like the other `_to_str` builtins it can
// also be called as a method, and it reflects elements added via `push`.
fn empty() -> i64[] { [] }

fn main() !prints {
    print(empty().to_str());
    mut xs = [10];
    set xs.push(20);
    set xs.push(30);
    print(xs.to_str());
}
--- stdout ---
