# An empty array renders as "[]". Like the other `_to_str` builtins it can
# also be called as a method, and it reflects elements added via `push`.

import { equal as ==, print, push, to_str } from builtins;

fn empty() -> i64[] { [] }

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(empty().to_str());
        mut xs = [10];
        set xs.push(20);
        set xs.push(30);
        print(xs.to_str());
    };
    assert(out == """
        []
        [10, 20, 30]

    """);
})
