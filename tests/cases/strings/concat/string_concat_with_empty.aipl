# An empty leaf on either side of a run-time concat. `+++` on two string literals
# is constant-folded, so the non-empty leaf is bound with a type annotation: that
# is what keeps the concat a run-time one (the binding inliner substitutes an
# unannotated single-use binding straight back).

import { concat as +++, equal as == } from builtins;

fn lead_empty() -> str {
    let s: str = "lone";
    "" +++ s
}.test({
    assert(lead_empty() == "lone");
})

fn trail_empty() -> str {
    let s: str = "lone";
    s +++ ""
}.test({
    assert(trail_empty() == "lone");
})
