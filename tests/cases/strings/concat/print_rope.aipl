# Printing a rope streams its leaves straight to stdout without materializing,
# so no flattened buffer is allocated even when the result exceeds the inline
# (<= 7 byte) limit. The only heap here is the concat node itself: `allocations`
# stays at 1 (the node), not 2 (node + a materialized buffer). A nested rope
# streams its sub-ropes the same way, still without flattening.

import { concat as +++, print } from builtins;

fn main() !prints {
    // The leaves are bound with a type annotation because `+++` on two string
    // literals is constant-folded; the annotation is what keeps the concat a
    // run-time one (the binding inliner substitutes an unannotated single-use
    // binding straight back).
    // 18 bytes: materializing would heap-allocate a flattened buffer.
    let head: str = "Hello, ";
    let tail: str = "rope world!";
    let greeting = head +++ tail;
    print(greeting); // Hello, rope world!

    // A rope of ropes — printed leaf-by-leaf, no node flattened.
    let a: str = "aaaa";
    let b: str = "bbbb";
    let c: str = "cccc";
    let d: str = "dddd";
    print((a +++ b) +++ (c +++ d)); // aaaabbbbccccdddd
}
--- stdout ---
Hello, rope world!
aaaabbbbccccdddd
--- performance ---
allocations: 4
deallocations: 4
reallocations: 0
bytes allocated: 352
instructions executed: 61
binary size: 1184
  code: 464
  data: 1
  metadata: 719
functions:
  main:
    calls: 1
    bytes: 464
