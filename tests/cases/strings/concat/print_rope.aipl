# Printing a rope streams its leaves straight to stdout without materializing, so
# no flattened buffer is allocated. Materializing would allocate one at any
# length — `rope_materialize` caches its result as a buffer even when the content
# would have fit inline, because the cache has to have an address to read from.
#
# So the only heap here is the rope nodes: `allocations` is 4, one per `rope_str`
# below (one for `greeting`, three for the nested rope), with nothing flattened.
# A nested rope streams its sub-ropes the same way.

import { print, rope_str } from builtins;

fn main() !prints {
    // 18 bytes: materializing would heap-allocate a flattened buffer.
    let greeting = rope_str("Hello, ", "rope world!");
    print(greeting); // Hello, rope world!

    // A rope of ropes — printed leaf-by-leaf, no node flattened.
    print(rope_str(rope_str("aaaa", "bbbb"), rope_str("cccc", "dddd"))); // aaaabbbbccccdddd
}
--- stdout ---
Hello, rope world!
aaaabbbbccccdddd
--- performance ---
allocations: 4
deallocations: 4
reallocations: 0
bytes allocated: 352
instructions executed: 61
binary size: 1176
  code: 456
  data: 1
  metadata: 719
functions:
  main:
    calls: 1
    bytes: 456
