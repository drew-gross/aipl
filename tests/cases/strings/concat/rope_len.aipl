# A rope stores its total length at its root (summed once at construction from
# its children's stored lengths), so `len` is O(1) and never materializes the
# rope. Building an 18-byte rope and only measuring it allocates just the concat
# node (1 allocation) — not a flattened 18-byte buffer (which would be a 2nd).

import { concat as +++, len, print, to_str } from builtins;

fn main() !prints {
    // The leaves are bound with a type annotation because `+++` on two string
    // literals is constant-folded; the annotation is what keeps the concat a
    // run-time one (the binding inliner substitutes an unannotated single-use
    // binding straight back).
    let head: str = "Hello, ";
    let tail: str = "rope world!";
    let r = head +++ tail; // 18 bytes; never read as bytes
    print(to_str(len(r))); // 18
}
--- stdout ---
18
