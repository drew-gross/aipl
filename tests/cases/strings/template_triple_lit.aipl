import { print } from builtins;

fn main() !prints {
    let name = "world";
    let n = 42;
    print(```hello {name}```);
    print(```value is {n}```);
    print(```no interpolation```);
    print(
        ```
            indented {name}
            and {n}
        ```,
    );
    print(```prefix {name} middle {n} suffix```);
}
