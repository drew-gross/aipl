import { equal as ==, join, split } from builtins;

// `join(parts, sep=sep)` concatenates the parts with `sep` *between* consecutive
// elements — none before the first or after the last. `[]` -> `""`, `[x]` -> `x`.
// Callable free (`join(xs, sep=sep)`) or as a method (`xs.join(sep=sep)`).
fn rejoin(s: str, sep: str) -> str { s.split(sep).join(sep=sep) }.test({
    assert(["a", "b", "c"].join(sep="hi") == "ahibhic");
    assert(["a", "b", "c"].join(sep="") == "abc"); // empty separator
    assert(["solo"].join(sep=", ") == "solo"); // single element: no separator
    assert(join([], sep=", ") == ""); // empty array
    assert(["", "x", ""].join(sep="-") == "-x-"); // empty parts are kept
    assert(["one", "two"].join(sep=" big sep ") == "one big sep two"); // heap result
    assert(rejoin("a,bb,ccc", ",") == "a,bb,ccc"); // split then join round-trips
})
