import { concat as +++, equal as ==, extend } from builtins;

// Building a string by repeated `set s.extend(..)` on a never-aliased binding:
// each append writes into `s`'s own storage. The result is four bytes, so it
// never leaves the inline form and the whole function allocates *nothing* —
// see `concat_in_place_grows.aipl` for the same loop past the 22-byte inline
// capacity, where the buffer is grown under itself instead. Without the
// optimization each of the four appends builds a fresh string.
fn build() -> str {
    mut s = "";
    set s.extend("a");
    set s.extend("b");
    set s.extend("c");
    set s.extend("d");
    s
}.test({
    assert(build() == "abcd");
})

// The rebuild spelling, `set s = s +++ ..`, reaches the same in-place append
// when the binding is exclusive — it is what `extend` on a `str` is compiled
// as. The `extend_longhand` lint steers to `extend` (which also appends when the
// binding *is* aliased, where this form copies), so the shape is kept here under
// `#[allow]` only to show the two still agree.
fn rebuilt() -> str {
    mut s = "";
    set s = s +++ "a"; #[allow]
    set s = s +++ "b"; #[allow]
    s
}.test({
    assert(rebuilt() == "ab");
})
