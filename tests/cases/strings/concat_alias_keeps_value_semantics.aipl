# Aliasing disables the in-place append: once `s` is captured by `t`, the
# static analysis marks `s` non-exclusive, so further `set s.extend(..)` build
# fresh strings (copy) and the snapshot `t` is never mutated underneath us.

import { equal as ==, extend } from builtins;

fn grown() -> str {
    mut s = "ab";
    set s.extend("c");
    let t = s; // snapshot "abc"
    set s.extend("d");
    set s.extend("e");
    s // abcde
}.test({
    assert(grown() == "abcde");
})

fn snapshot() -> str {
    mut s = "ab";
    set s.extend("c");
    let t = s; // snapshot "abc"
    set s.extend("d");
    set s.extend("e");
    t // abc — unchanged
}.test({
    assert(snapshot() == "abc");
})
