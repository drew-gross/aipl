# Interior blank lines are preserved (and don't affect the common indent).

import { equal as ==, print } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print("""
            first

            second
        """);
    };
    assert(out == """
        first

        second

    """);
})
