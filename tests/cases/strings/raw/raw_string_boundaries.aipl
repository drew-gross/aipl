# Brackets make the exact boundaries visible. These were written as `"""`
# blocks — an empty one, one holding only the trimmed surrounding newline,
# and one with trailing spaces — and the formatter respells a block whose
# value is one line as the single-line literal, which is the value each of
# them has: "", "", and "kept  " with its spaces verbatim.

import { equal as ==, join, print } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(["[", "", "]"].join());
        print(["[", "", "]"].join());
        print(["[", "kept  ", "]"].join());
    };
    assert(out == """
        []
        []
        [kept  ]

    """);
})
