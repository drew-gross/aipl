# De-denting removes the *common* leading whitespace of the non-blank lines,
# so a more-indented line keeps its extra indent, while a line flush at
# column 0 makes the common indent empty (nothing is stripped).

import { equal as ==, print } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print("""
              four spaces
            two spaces
        """);
        print("----");
        print("""
            flush left
                indented under it
        """);
    };
    assert(out == """
          four spaces
        two spaces
        ----
        flush left
            indented under it

    """);
})
