import {
    greater_than as >,
    greater_than_or_equal as >=,
    less_than as <,
    less_than_or_equal as <=,
    logical_not as !,
} from builtins;

// `str` compares lexicographically by bytes — the same order the `sort` builtin
// imposes on a `str[]`, so a sort by a derived `str` key agrees with `<`.
fn main() {}.test({
    assert("a" < "b");
    assert(!("b" < "a"));
    assert(!("a" < "a"));
    assert("a" <= "a");
    assert("b" > "a");
    assert("a" >= "a");

    // A prefix precedes the longer string it prefixes.
    assert("ab" < "b");
    assert("a" < "ab");
    assert("" < "a");
    assert(!("" < ""));

    // Byte order, not case-insensitive: uppercase sorts ahead of lowercase.
    assert("Z" < "a");

    // Long enough to be heap-allocated rather than inline, so both `str`
    // representations are covered.
    assert("longstring_here_x" < "longstring_here_y");
    assert(!("longstring_here_y" < "longstring_here_x"));
})
