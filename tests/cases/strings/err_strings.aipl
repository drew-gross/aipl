import { Span, len, print, wrapping_add as +, == } from builtins;

// Every *check-phase* string error, in one file, reported in one run. The
// checker recovers at each item, so each failing function below is recorded and
// the next is still checked.
//
// The string errors that aren't here belong to earlier phases and would abort
// the file before the checker ran:
//   - `err_unterminated_string`, `err_raw_string_unterminated`,
//     `err_unknown_escape`, and the three unclosed-interpolation cases — all
//     *lexer* errors;
//   - `err_char_at_removed` — a *loader* error (an unknown builtin name is
//     rejected while resolving the import list).

// Comparing a str to an integer.
fn str_eq_with_i64() -> i64 { if ("hi" == 5) { 1 } else { 2 } }

// `+` is integer addition; string concatenation is `+++`.
fn str_plus_i64() -> i64 { "hi" + 5 }

// `match` on a str takes string literals and `_` — not a constructor pattern —
// and the usual arm rules apply: no duplicate, no missing `_`, `_` last.
fn match_ctor_arm(s: str) -> str {
    match (s) {
        some(v) => v,
        _ => "default",
    }
}

fn match_duplicate(s: str) -> str {
    match (s) {
        "a" => "x",
        "a" => "y",
        _ => "z",
    }
}

fn match_non_exhaustive(s: str) -> str {
    match (s) {
        "a" => "x",
        "b" => "y",
    }
}

fn match_wildcard_not_last(s: str) -> str {
    match (s) {
        _ => "default",
        "a" => "x",
    }
}

// `print` takes a str.
fn print_wrong_arg_type() !prints -> i64 {
    let _ = print(42);
    0
}

// Slicing something that isn't sliceable, and a bound that isn't an integer.
fn slice_non_str() -> i64 {
    let n = 5;
    let s = n[..2];
    0
}

fn slice_bound_not_int() {
    let s = "hello";
    let x = s[..'z'];
}

// Slicing by a `Span` value has the same requirement on its receiver.
fn slice_span_unsliceable() -> i64 {
    let n = 5;
    let sp = Span { start: 0, end: 2 };
    n[sp].len()
}

fn main() {}
