import { equal as ==, extend, len, measure, trim } from builtins;

fn trimmed() -> u64 {
    mut u = "  z  ";
    set u = trim(u);
    u.len()
}.test({
    // `trim` on a uniquely-owned (never-aliased) string costs nothing at all: the
    // result is a window into the same bytes — `{base, data + lo, hi - lo}` — so
    // there is no shifting, no copy and no allocation, whatever the length.
    //
    // `trimmed` is the shape that used to crash: with no other statement in the
    // body, the binding is exclusive, and the in-place arm then read a single word
    // out of the slot and dereferenced it as a `Str`. For an inline value that word
    // is the first eight *content* bytes, so `"  z  "` became a wild pointer.
    fn build() -> str {
        mut s = "";
        set s.extend("  padded  ");
        set s = trim(s);
        s
    }

    assert(build() == "padded");
    assert(trimmed() == 1);
}).performance({
    assert(measure("trim an inline string", 0, |_| trimmed()).allocations == 0);

    // A string long enough to need a buffer pays for that buffer, and trimming it
    // adds nothing to it: the result is a window into the same bytes.
    let with_trim = measure(
        "long string, trimmed",
        0,
        |_| {
            mut s = "";
            set s.extend("   a string of padding, long enough to leave the inline form   ");
            set s = trim(s);
            s.len()
        },
    );
    let untrimmed = measure(
        "long string, not trimmed",
        0,
        |_| {
            mut s = "";
            set s.extend("   a string of padding, long enough to leave the inline form   ");
            s.len()
        },
    );
    assert(with_trim.allocations == untrimmed.allocations);
    assert(with_trim.bytes_allocated == untrimmed.bytes_allocated);
})
