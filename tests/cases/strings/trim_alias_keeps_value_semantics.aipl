# Aliasing disables the in-place trim: once `s` is captured by `t`, `s` is
# non-exclusive, so `set s = trim(s)` builds a fresh string and the snapshot
# `t` keeps its original (untrimmed) value.

import { equal as ==, trim } from builtins;

fn trimmed() -> str {
    mut s = "  hi  ";
    let t = s; // snapshot "  hi  "
    set s = trim(s); // copy (s is aliased) -> s = "hi"
    `{s}/{t}` // the snapshot is read afterwards, so it must be a live alias
}.test({
    assert(trimmed() == "hi/  hi  ");
})

fn snapshot() -> str {
    mut s = "  hi  ";
    let t = s; // snapshot "  hi  "
    set s = trim(s); // copy (s is aliased)
    t // unchanged
}.test({
    assert(snapshot() == "  hi  ");
})
