# `to_str(n)` renders an i64 as its decimal string. It composes with
# a template, just like any other str.

import { equal as ==, print, to_str } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        print(to_str(0));
        print(to_str(42));
        print(`count: {7}`);
    };
    assert(out == """
        0
        42
        count: 7

    """);
})
