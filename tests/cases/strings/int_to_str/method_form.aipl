# Like the other `X_to_str` builtins, it can also be called as a method.

import { equal as ==, print, to_str } from builtins;

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        let s = (123).to_str();
        print(to_str(if (s == "123") { 1 } else { 0 }));
    };
    assert(out == "1\n");
})
