import { equal as ==, wrapping_add as + } from builtins;

// The `?` operator is allowed inside a `.test` body. On an `ok` it unwraps the
// value in place and the test proceeds; on an `err` it fails the current test
// with the error's rendered message and stops that test (later asserts don't
// run). The `--- check ---` section below pins that report.
//
// An optional operand behaves the same way — `some` unwraps, `none` fails the
// test — so a test needs no optional return type to use `?`, just as it needs no
// result return type. A `none` carries no payload, so its report names the
// propagation rather than rendering a message.

fn checked(n: i64) -> i64!str { if (n == 0) { err("zero is not allowed") } else { ok(n) } }

fn first(s: str) -> char? { s[0] }

// Every `?` hits an `ok`: they unwrap and the test passes (silent).
fn all_ok() -> i64 { 0 }.test({
    let x = checked(5)?;
    let y = checked(10)?;
    assert(x + y == 15);
})

// The second `?` hits an `err`: the test fails with the error message and stops,
// so the `assert(false)` after it never runs.
fn hits_err() -> i64 { 0 }.test({
    let x = checked(3)?;
    let bad = checked(0)?;
    assert(false);
})

// Every `?` hits a `some`: they unwrap and the test passes (silent).
fn all_some() -> i64 { 0 }.test({
    let c = first("hi")?;
    let d = first("xy")?;
    assert(c == 'h');
    assert(d == 'x');
})

// The second `?` hits a `none`: the test fails and stops, so the `assert(false)`
// after it never runs. No payload, so the report has no message to render.
fn hits_none() -> i64 { 0 }.test({
    let c = first("ok")?;
    let bad = first("")?;
    assert(false);
})

fn main() {}
--- check ---
test hits_err ... FAIL
  `?` propagated an error: "zero is not allowed"
test hits_none ... FAIL
  `?` propagated a `none`
4 tests: 2 passed, 2 failed
--- performance ---
allocations: 0
deallocations: 0
reallocations: 0
bytes allocated: 0
instructions executed: 3
binary size: 520
