# `--- check exit code ---` on its own: `check`'s status, with its report left
# unpinned. A failing test makes `check` exit 1 — that is the whole claim here,
# and leaving the report out means a change to its wording never has to be
# refilled into this file.
#
# `failing_test.aipl` is the fixture that pins the report instead, and
# `debug/trace_fails_check.aipl` pins both. Between the three, every combination
# of the two `check` sections appears in the corpus — and each is still one
# `aipl check` run, which `check_runs_at_most_once_whichever_sections_are_used`
# states directly.

import { equal as == } from builtins;

fn answer() -> i64 { 41 }.test({
    assert(answer() == 42);
})

// A `main`, so the harness measures it rather than the deliberately
// failing test driver (which exits non-zero before reporting its counters).
fn main() {}
--- check exit code ---
1
