# A function declared inside a `.test` block exists only for that block: the
# function under test cannot call it.

import { equal as ==, wrapping_add as + } from builtins;

fn double(n: i64) -> i64 { four() + n }.test({
    fn four() -> i64 { 4 }
    assert(double(2) == 6);
})
--- check --compile ---
error: unused function "__test$double$four": nothing in this file mentions it; delete it, or make it pub (or append #[allow] to this line to keep it)
 --> ./tests/cases/tests/err_fn_in_test_unreachable.aipl:7:8
  |
7 |     fn four() -> i64 { 4 }
  |        ^^^^
