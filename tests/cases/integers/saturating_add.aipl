import { saturating_add as +, wrapping_sub as -, == } from builtins;

// `import { saturating_add as + }` binds `+` to clamping integer add: instead of
// wrapping on overflow (`wrapping_add`), the result is pinned at the type's
// bound. The operator resolves to the `saturating_add` builtin, so the same
// `a + b` spelling means saturating here and wrapping in a file that imported
// `wrapping_add as +`.
fn probe() -> bool { true }.test({
    // In range: exact sum, same as any add.
    assert(10 + 20 == 30);
    assert(100 + 50 == 150);
    assert(5 + 3 == 8);

    // Signed narrow: clamp at the max (127/32767/2147483647) and min. The width
    // comes from the annotated binding — a bare literal pair would add at i64,
    // where none of these overflow and nothing would clamp.
    let a8: i8 = 100;
    assert(a8 + 100 == 127);
    let n8: i8 = -100;
    assert(n8 + -100 == -128);
    let a16: i16 = 30000;
    assert(a16 + 10000 == 32767);
    let n16: i16 = -30000;
    assert(n16 + -10000 == -32768);
    let a32: i32 = 2000000000;
    assert(a32 + 2000000000 == 2147483647);
    let n32: i32 = -2000000000;
    assert(n32 + -2000000000 == -2147483648);

    // Unsigned narrow: clamp at the max (0 is a natural floor).
    let u8a: u8 = 200;
    assert(u8a + 100 == 255);
    let u16a: u16 = 60000;
    assert(u16a + 10000 == 65535);
    let u32a: u32 = 4000000000;
    assert(u32a + 1000000000 == 4294967295);

    // 64-bit: i64::MAX + 1 saturates (a wrapping add would flip to i64::MIN).
    assert(9223372036854775807 + 1 == 9223372036854775807);
})
