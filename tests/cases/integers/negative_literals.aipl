import { <, == } from builtins;

// A negative integer literal lexes as a single token: a `-` immediately followed
// by digits binds them into one literal (a space after the `-` would make it the
// subtraction operator instead). So a negative constant needs no `-` operator
// import (this file imports none), and it reaches the full i64 range — including
// i64::MIN, whose magnitude exceeds i64::MAX and so can't be written as a positive
// literal and then negated.
fn probe() -> bool { true }.test({
    // A plain constant, not a unary-minus expression — no `-` imported.
    assert(-1234 == -1234);
    assert(-1 < 0);
    assert(-1 < 1);

    // i64::MIN, reachable only because the `-` and digits parse together. It sits
    // below MIN + 1, confirming it parsed to the real most-negative value.
    assert(-9223372036854775808 < -9223372036854775807);

    // Usable wherever a literal is: after `[`/`,`, as a call argument, as the
    // value of a `{ }` block / return.
    let xs = [-1, -2, -3];
    assert(xs[1] == some(-2));
    assert(id(-7) == -7);
    assert(neg_one() == -1);
})

fn id(x: i64) -> i64 { x }

fn neg_one() -> i64 { -1 }
