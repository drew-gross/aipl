# `narrow` takes the type it converts to from where its value goes, so it needs
# a position that declares an optional of an integer. These are settled once the
# rest of the program has checked, which is why they are a file of their own.

import { narrow, print, to_str } from builtins;

fn no_target(n: i64) !prints {
    let b = n.narrow();
    print(b.to_str());
}

fn not_an_integer(n: i64) -> str? { n.narrow() }

fn main() {}
--- errors ---
