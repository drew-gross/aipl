import {
    print,
    to_str,
    wrapping_add as +,
    wrapping_mul as *,
    wrapping_sub as -,
    /,
    ==,
    >,
} from builtins;

// Fixed-width integers: signed i8/i16/i32/i64 and unsigned u8/u16/u32/u64.
// Arithmetic and comparison happen at the type's width and signedness; results
// wrap.
//
// A value reaches a given width by *context*: a bare literal takes the type its
// position expects (a parameter, a return type, the other operand of a binop),
// and a binding says the type outright with `let n: u8 = ..`. There is no
// conversion form — the annotated binding is the only place a value changes
// integer type, and it is also how a *non*-literal is converted (`let n: i8 =
// some_i64;` wraps to 8 bits).
fn add8(a: i8, b: i8) -> i8 { a + b }.test({
    // Signed addition wraps two's-complement. The literals here take `i8` from
    // `add8`'s parameters.
    assert(add8(127, 1) == -128);
    assert(add8(100, 50) == -106);

    // Unsigned addition wraps mod 2^width. These operands are `u8` because the
    // bindings say so, and the arithmetic happens at that width.
    let big: u8 = 200;
    let small: u8 = 100;
    assert(big + small == 44);

    // Multiplication / division at the width; division is signedness-aware.
    let twenty: i8 = 20;
    assert(twenty * 7 == -116); // 140 wraps to -116
    let umax8: u8 = 255;
    assert(umax8 / 2 == 127);

    // Wider widths hold larger values.
    let wide: i32 = 70000;
    assert(wide == 70000);
    let uwide: u32 = 4000000000;
    assert(uwide > 1);

    // Unsigned comparison treats the top bit as magnitude (255 > 1, not -1 < 1).
    assert(umax8 > 1);
    // The same bit pattern read as `i8`: an annotation converts, so 255 wraps.
    let as_signed: i8 = umax8;
    assert(as_signed == -1);

    // Rendering: signed shows the sign; unsigned shows the magnitude.
    assert(to_str(add8(127, 1)) == "-128");
    assert(to_str(uwide) == "4000000000");
    assert(to_str(umax8) == "255");
})

fn main() !prints {
    let uwide: u32 = 4000000000;
    print(to_str(add8(100, 50))); // -106
    print(to_str(uwide)); // 4000000000
}
