import {
    equal as ==,
    len,
    print,
    push,
    sort,
    to_str,
    value_or,
    wrapping_add as +,
    wrapping_sub as -,
} from builtins;

// `u64` works as an array and optional element, not just as a scalar. An
// element slot is 8 bytes and a 64-bit value needs no re-canonicalization when
// loaded — only the *interpretation* differs, and everything that reads one
// (rendering, comparison, `sort`) dispatches on signedness. This file is the
// `u64`-specific half of that; `narrow_int_elements` covers the sub-64-bit
// widths, which round-trip the same way.

fn sum(xs: u64[]) -> u64 {
    mut total: u64 = 0;
    for (let x : xs) {
        set total = total + x;
    }
    total
}.test({
    assert(sum([1, 2, 3]) == 6);
    assert(sum([]) == 0);
})

fn first(xs: u64[]) -> u64? { xs[0] }.test({
    assert(first([7]) == some(7));
    assert(first([]) == none);
    assert(first([]).value_or(99) == 99);
})

fn grown() -> u64[] {
    mut xs: u64[] = [1];
    set xs.push(2);
    xs
}.test({
    assert(grown() == [1, 2]);
    assert(grown().len() == 2);
})

// The value that distinguishes unsigned from signed: `u64::MAX` shares its bit
// pattern with `-1`. It must *render* as a huge number and *sort* last.
fn u64_max() -> u64 {
    let m: u64 = 0 - 1; // -1's bit pattern, read unsigned
    m
}.test({
    assert(u64_max().to_str() == "18446744073709551615");

    // Named so both literals are `u64`: an array literal takes its element
    // type from its *first* element, which a later one cannot retype.
    let one: u64 = 1;
    assert([u64_max(), one].sort() == [one, u64_max()]);
    // The signed contrast: the same bit pattern as `i64` sorts first.
    assert([0 - 1, 1].sort() == [0 - 1, 1]);
})

fn main() !prints {
    print(to_str([3, 1, 2].sort()));
    print(to_str([u64_max()]));
    print(sum([1, 2]).to_str());
}
