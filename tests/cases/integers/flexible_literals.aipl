import { print, to_str, wrapping_add as +, wrapping_sub as -, ==, > } from builtins;

// A bare integer literal flexes to a narrow integer type by context — no
// explicit conversion needed — as long as it fits. It works against the other
// operand of a binop, a function parameter, and a return type.
fn inc(x: u8) -> u8 {
    x + 1 // literal `1` flexes to u8
}

fn make() -> i16 {
    1000 // literal return flexes to i16
}.test({
    // Compare a narrow int to a literal (either side). The narrow operand comes
    // from an annotated binding — the one place a type is stated outright.
    let five: i8 = 5;
    assert(five == 5);
    assert(5 == five);
    let umax8: u8 = 255;
    assert(umax8 > 1);
    let neg: i8 = -1;
    assert(neg == -1); // negative literal flexes to i8

    // Arithmetic with a literal operand stays at the narrow width (wraps).
    let imax8: i8 = 127;
    assert(imax8 + 1 == -128);
    let near: u8 = 250;
    assert(near + 10 == 4);
    assert(inc(9) == 10);

    // Literal flexes through a parameter and a return type.
    assert(inc(200) == 201);
    assert(make() == 1000);
})

fn main() !prints {
    let imax8: i8 = 127;
    print(to_str(imax8 + 1)); // -128
    print(to_str(inc(200))); // 201
    print(to_str(make())); // 1000
}
