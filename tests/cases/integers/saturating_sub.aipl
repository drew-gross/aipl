import { equal as ==, saturating_sub as - } from builtins;

// `import { saturating_sub as - }` binds `-` to clamping integer subtraction:
// instead of wrapping on overflow (`wrapping_sub`), the result is pinned at the
// type's bound. The operator resolves to the `saturating_sub` builtin, so the
// same `a - b` spelling means saturating here and wrapping in a file that
// imported `wrapping_sub as -`. Unary negation (`-x`) is unaffected.
fn probe() -> bool { true }.test({
    // In range: exact difference, same as any subtraction.
    assert(30 - 20 == 10);
    assert(150 - 50 == 100);
    assert(10 - 3 == 7);

    // Signed narrow: clamp at the min and max on over/underflow. The width comes
    // from the annotated binding — a bare literal pair would subtract at i64,
    // where none of these underflow and nothing would clamp.
    let n8: i8 = -100;
    assert(n8 - 100 == -128);
    let a8: i8 = 100;
    assert(a8 - -100 == 127);
    let n16: i16 = -30000;
    assert(n16 - 10000 == -32768);
    let a16: i16 = 30000;
    assert(a16 - -10000 == 32767);
    let n32: i32 = -2000000000;
    assert(n32 - 2000000000 == -2147483648);

    // Unsigned narrow: underflow floors at 0 (a smaller minus larger).
    let u8a: u8 = 50;
    assert(u8a - 100 == 0);
    let u16a: u16 = 10000;
    assert(u16a - 60000 == 0);
    let u32a: u32 = 1000000000;
    assert(u32a - 4000000000 == 0);

    // 64-bit signed: a large underflow saturates toward i64::MIN, which stays
    // very negative (a wrapping sub would flip it positive) — it pins at exactly
    // i64::MIN, now writable as a literal.
    assert(-9000000000000000000 - 9000000000000000000 == -9223372036854775808);
    // Unsigned 64-bit underflow floors at 0.
    let u64a: u64 = 3;
    assert(u64a - 9 == 0);
})
