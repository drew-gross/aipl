# A failing `.performance` block is a failing check, reported under the name of
# the function it is attached to followed by `.performance`, so it reads as the
# attribute it is. The `.test` block on the same function passes and stays silent.

import { equal as == } from builtins;

fn answer() -> i64 { 41 }.test({
    assert(answer() == 41);
}).performance({
    assert(answer() == 42);
})

fn main() {}
--- check ---
test answer.performance ... FAIL
  assert failed at tests/cases/performance/block_failure.aipl:10 answer() == 42
2 tests: 1 passed, 1 failed
--- check exit code ---
1
