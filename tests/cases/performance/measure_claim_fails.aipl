# A `.performance` claim that does not hold is a failing check, reported under the
# function it is attached to followed by `.performance`, with the location of the
# assertion — the same shape a failing `.test` has. The claim here is false: the
# closure builds an array, so it allocates.

import { equal as ==, measure, not_equal as !=, push, wrapping_increment as ++ } from builtins;

fn filled(n: i64) -> i64[] {
    mut xs: i64[] = [];
    mut i: i64 = 0;
    while (i != n) {
        set xs.push(i);
        set i++;
    }
    xs
}

fn main() {}

fn building() {}.performance({
    assert(measure("build", 10, filled).allocations == 0);
})
--- check ---
test building.performance ... FAIL
  assert failed at tests/cases/performance/measure_claim_fails.aipl:21 measure("build", 10, filled).allocations == 0
1 tests: 0 passed, 1 failed
--- check exit code ---
1
