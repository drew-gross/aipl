# Importing a file does not run its `.performance` blocks, any more than its
# `.test` blocks: they belong to the file that holds them, and `check` runs a
# file's own. `lib.aipl` below holds one that would fail; this file's check
# passes because it is never run from here.

import { equal as == } from builtins;
import { answer } from "./lib.aipl";

fn main() {}

fn use_answer() -> i64 { answer() }.test({
    assert(use_answer() == 42);
})
--- file: lib.aipl ---
import { equal as == } from builtins;

pub fn answer() -> i64 { 42 }.performance({
    assert(answer() == 0);
})
