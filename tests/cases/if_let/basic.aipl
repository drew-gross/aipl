# `if (let PATTERN = EXPR) { THEN }` binds `PATTERN`'s payload from `EXPR` and
# runs `THEN` if it matches — the one case this site cares about. Every other
# case (here, `none`) silently falls through with no arm to write, unlike a
# `match`, which would require one.

import { equal as ==, print } from builtins;

fn describe(x: i64?) -> str { if (let some(v) = x) { `got {v}` } else { "nothing" } }.test({
    assert(describe(some(5)) == "got 5");
    assert(describe(none) == "nothing");
})

fn main() !prints {
    print(describe(some(5)));
    print(describe(none));
}
--- stdout ---
got 5
nothing
