import {
    contains,
    ends_with,
    equal as ==,
    greater_than as >,
    len,
    print,
    saturating_sub as -,
    to_str,
} from builtins;

// A three-function cycle, none of whose edges is a self-call. This is the shape
// the compiler's own `doc.aipl` uses (`fits` / `fits_atom` / `fits_after`), and
// the reason rewriting self-calls as a jump — which needs no calling-convention
// change at all — is not a useful substitute: across the compiler's own IR, 128
// of 130 tail calls are cross-function.
//
// A cycle is bounded only when *every* edge in it is eliminated, so this is the
// case that would catch an implementation handling direct recursion and stopping
// there. Each function is deliberately a little wider than the inliner's
// four-expression budget, so the cycle survives to codegen as three functions
// rather than being folded into one self-recursive body.
variant Work = WNil | WCons(str, Work)

fn fits(budget: u64, work: Work) -> bool {
    match (work) {
        WNil => true,
        WCons(s, rest) => if (s.ends_with("!")) { budget > 0 } else { fits_atom(budget, s, rest) },
    }
}

fn fits_atom(budget: u64, s: str, rest: Work) -> bool {
    if (s.contains("\n")) {
        false
    } else if (s.len() == 0) { fits(budget, rest) } else { fits_after(budget, s.len(), rest) }
}

fn fits_after(budget: u64, n: u64, rest: Work) -> bool {
    if (n > budget) {
        false
    } else if (n == 0) { fits(budget, rest) } else { fits(budget - n, rest) }
}

fn work_of(n: u64, acc: Work) -> Work {
    if (n == 0) { acc } else { work_of(n - 1, WCons("ab", acc)) }
}

fn main() !prints {
    let work = work_of(150000, WNil);
    // 150,000 two-byte atoms need exactly 300,000 columns to fit.
    print(fits(300000, work).to_str());
    print(fits(299999, work).to_str());

    // Second call sites, so the cycle survives as three functions:
    // `inline_single_use` moves any body reached from exactly one place, which
    // would otherwise fold the whole cycle into `fits` and turn it into plain
    // self-recursion — the very thing this case exists to distinguish.
    print(fits_atom(4, "ab", WNil).to_str());
    print(fits_after(4, 2, WNil).to_str());
}
