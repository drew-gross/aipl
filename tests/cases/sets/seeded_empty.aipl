# A binding seeded with an empty literal takes its element type from the first
# concrete value stored into it — through `set` as well as through `push`. A
# plain `set` used to leave the binding typed by its placeholder, so a later
# read rendered the set (or array) as empty while it held elements.

import { print, push, union } from builtins;

fn main() !prints {
    mut s = #{};
    set s = s.union(#{2, 1});
    print(`{s}`);
    // Seeded empty, then given an ordered set: the binding takes its order too.
    mut o = #{};
    set o = o.union(#>{2, 1, 3});
    print(`{o}`);
    for (let x : o) {
        print(`{x}`);
    }
    mut a = [];
    set a = [1, 2];
    set a.push(3);
    print(`{a}`);
}
--- stdout ---
{2, 1}
{3, 2, 1}
3
2
1
[1, 2, 3]
