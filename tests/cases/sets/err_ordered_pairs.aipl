import { print } from builtins;

// An ordered `#>{ .. }` is a set: a `key: value` pair has no place in one.
fn main() !prints {
    let d = #>{"a": 1};
    print(`{d}`);
}
--- errors ---
error: an ordered "#>{ .. }" / "#<{ .. }" literal is a set, so it holds bare elements — a "key: value" pair belongs in a "#{ .. }" dict
