import {
    equal as ==,
    has,
    is_empty,
    len,
    print,
    to_array,
    to_str,
    union,
    wrapping_add as +,
} from builtins;

// An ordered set: `#>{T}` walks its elements largest first, `#<{T}` smallest
// first. Both are sets — deduplicated, `has`/`len`/`union`, `==` regardless of
// how they were built — and distinct types from each other and from the
// unordered `#{T}`, which promises no order at all. The block is kept sorted,
// so iteration is the array walk and `to_array` is the same block seen as an
// array. The element must be `ord`: an integer, char, or str (bytewise).
fn main() !prints {
    // Literals sort and dedup at construction.
    let d = #>{3, 1, 2, 3, 10};
    print(`{d}`);
    let a = #<{"pear", "apple", "fig", "apple"};
    print(`{a}`);
    print(`{#<{'z', 'a', 'm'}}`);
    print(`{#<{-5, 3, -20, 0}}`);

    // An empty `#{}` is any set, so it seeds an ordered binding; `union` keeps
    // the receiver's order, and takes any set of the element type for the other
    // side — a plain `#{x}` is the natural way to add one element. (The
    // `union_all` lint leaves this loop alone: its rewrite builds an unordered
    // set.)
    mut s: #>{i64} = #{};
    for (let x : [5, 9, 1, 9, 7]) {
        set s = s.union(#{x});
    }
    print(`{s}`);
    // Walking one visits the elements in its order.
    for (let x : s) {
        print(x.to_str());
    }
    // The set operations, and equality across orders of construction.
    print(`{s.has(9)} {s.has(2)} {s.len()} {s.is_empty()}`);
    print(`{#>{1, 2} == #>{2, 1}}`);
    // `to_array` is the elements in order — the array that a `map`/`join` wants.
    print(`{d.to_array()}`);
    print(`{a.to_array()}`);

    // Unsigned elements order as unsigned: the top bit is a big number, not a
    // sign.
    let half: u64 = 9223372036854775807;
    let u = #<{half + half + 1, half + 1, half};
    print(`{u}`);
}
