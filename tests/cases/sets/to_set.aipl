# `xs.to_set()` — an array's distinct elements as a set. *Which* set comes from
# the use site, the way an empty `#{}` takes its type from context: a return
# type, an annotation or a parameter of `#>{T}` / `#<{T}` gets an ordered set,
# built in that order; with nothing to say, it is a plain `#{T}`.

import { has, len, map, print, to_set, wrapping_mul as * } from builtins;

fn tightest_first(xs: i64[]) -> #>{i64} { xs.to_set() }

fn doubled_asc(xs: i64[]) -> #<{i64} { xs.map(|x| x * 2).to_set() }

fn count_distinct(s: #{str}) -> u64 { s.len() }

fn main() !prints {
    print(`{tightest_first([3, 1, 3, 2])}`);
    print(`{doubled_asc([3, 1, 3])}`);
    let names: #<{str} = ["pear", "fig", "pear"].to_set();
    print(`{names}`);
    // No context: an unordered set, with the usual set operations.
    let plain = [2, 2, 5].to_set();
    print(`{plain.len()} {plain.has(5)} {plain.has(3)}`);
    // As an argument, the parameter type is the context.
    print(`{count_distinct(["a", "b", "a"].to_set())}`);
}
--- stdout ---
{3, 2, 1}
{2, 6}
{"fig", "pear"}
2 true false
2
