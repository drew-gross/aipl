# Sets of bool and char (the other two scalar element types). A bool set holds
# at most {true, false}; chars behave like array char elements.
#
# The char sets stay spelled out (`#[allow]`, against `char_set_literal`) rather
# than becoming `"abac".to_set()`: this case is about what a set *literal* does
# per element type, and the char rows only say that beside the bool ones if both
# are written the same way.

import { equal as ==, has, len, logical_not as ! } from builtins;

fn bools() -> #{bool} {
    #{true, false, true, false} // -> {true, false}
}.test({
    let bs = bools();
    assert(bs == #{true, false});
    assert(len(bs) == 2);
    assert(bs.has(false));
})

fn chars() -> #{char} {
    // -> {'a', 'b', 'c'}
    #{'a', 'b', 'a', 'c'} #[allow]
}.test({
    let cs = chars();
    assert(cs == #{'a', 'b', 'c'}); #[allow]
    assert(len(cs) == 3);
    assert(cs.has('b'));
    assert(!cs.has('z'));
})
