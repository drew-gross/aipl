import { contains, print, to_str } from builtins;

// Every *check-phase* set error, in one file, reported in one run.

// `contains` is for arrays and strs; a set uses `has`.
fn contains_on_set(s: #{i64}) -> bool { s.contains(1) }

// Elements must share one type.
fn elem_mismatch() {
    let s = #{1, true};
}

// A set isn't indexable.
fn index_set() !prints {
    let s = #{1, 2, 3};
    print(to_str(s[0]));
}

fn main() {}
