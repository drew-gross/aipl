# A dict literal has no spread: `..` splices a set's elements into a set, and a
# `#{ .. }` holding a `key: value` pair is a dict.

fn main() {
    let a = #{1, 2};
    let d = #{1: 2, ..a};
}
--- errors ---
error: a `..` spread is only allowed in a set literal — a "#{ .. }" holding "key: value" pairs is a dict
 --> ./tests/cases/sets/spread/err_spread_in_dict.aipl:6:13
  |
6 |     let d = #{1: 2, ..a};
  |             ^^^^^^^^^^^^
