# `to_array` reads the elements *in order*, and a `#{..}` promises none — the
# order it happens to have is not one to write code against.

import { print, to_array } from builtins;

fn main() !prints {
    print(`{#{1, 2}.to_array()}`);
}
--- errors ---
error: "to_array" needs an ordered set (`#>{..}` or `#<{..}`) — a #{i64} promises no order for its elements to come out in
