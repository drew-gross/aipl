# `shim random` takes one of the providers `seeded_with_int(seed)` and
# `seeded_with_clock()`; any other name, or the wrong number of arguments, is a
# parse error that lists them.

import { random_u64 } from builtins;

fn main() {
    shim random seeded_with_clock(1) {
        random_u64();
    };
}
