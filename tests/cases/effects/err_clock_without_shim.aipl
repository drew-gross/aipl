import { now_nanos } from builtins;

// The discharge is what a shim buys: *without* one, `!clock` propagates to the
// caller like any other effect. This is the case `shim_clock` contrasts with.
fn reads() !clock -> u64 { now_nanos() }

fn main() -> u64 { reads() }
--- errors ---
