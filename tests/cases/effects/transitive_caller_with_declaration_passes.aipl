import { equal as ==, print } from builtins;

fn outer() !prints { inner() }

fn inner() !prints { print("hello") }

test({
    mut out = "";
    shim prints {
        print = |text| {
            set out = `{out}{text}\n`;
        },
        put = |text| {
            set out = `{out}{text}`;
        },
    } {
        outer();
    };
    assert(out == "hello\n");
})
