# `!random` has no default implementation, so `main` cannot declare it: nothing is
# left to discharge it. The program must install a provider with `shim random`.

import { print, random_u64, to_str } from builtins;

fn main() !prints !random {
    print(to_str(random_u64()));
}
--- errors ---
