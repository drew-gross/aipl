variant Doc =
       // A verbatim atom.
    Text(str)
    // Detached: the blank line after a comment marks it standalone.

    | Concat(Doc[])
    | Line   // rides on the case's own line
       // Two comments
       // stacked above one case.
    | HardLine
variant Flat = A | B(i64)
fn main() { }
