import { not_equal as !=, equal as == } from builtins;

fn block() -> str { "b" }

fn main() -> i64 {
    // A multi-line `"""` operand glues to its operator on the current line
    // (`lhs == """`) instead of pushing the operator onto its own
    // continuation line, and the closing delimiter sits at the statement
    // indent, not one level deeper.
    let eq = block()
        == """
            one
              two
        """;
    // Any operator, not just `==`.
    let differs = block()
        != """
            three
            four
        """;
    if (eq) { 1 } else if (differs) { 2 } else { 0 }
}
--- formatted ---
import { equal as ==, not_equal as != } from builtins;

fn block() -> str { "b" }

fn main() -> i64 {
    // A multi-line `"""` operand glues to its operator on the current line
    // (`lhs == """`) instead of pushing the operator onto its own
    // continuation line, and the closing delimiter sits at the statement
    // indent, not one level deeper.
    let eq = block() == """
        one
          two
    """;
    // Any operator, not just `==`.
    let differs = block() != """
        three
        four
    """;
    if (eq) { 1 } else if (differs) { 2 } else { 0 }
}
