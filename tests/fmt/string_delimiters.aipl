import { print } from builtins;
fn main() !prints {
    // A `"` literal whose only escapes are quotes is respelled with backticks,
    // where a quote is bare; a backtick literal whose only escapes are braces
    // or backticks is respelled with quotes, where those are bare.
    let quoted = "say \"hi\"";
    let braced = `a \{b\} c`;
    let ticked = `\`code\``;
    // The cheaper side wins when both kinds are present; a tie keeps the
    // delimiter the source has.
    let mostly_quotes = "\"\"{";
    let tie = "\"{";
    let other_tie = `\{"`;
    // Nothing to escape either way: unchanged, whichever delimiter it has.
    let plain = "plain";
    let plain_tick = `plain`;
    // Shared escapes (`\n`, `\\`) ride along; an escaped backslash is one char.
    let shared = "a\n\"b\"\\";
    // An interpolated template is not touched. A block whose value is one
    // line is respelled as a single-line literal, escapes and all — under
    // whichever delimiter needs fewer — while one spanning lines stays.
    let tpl = `x {1} "y"`;
    let raw = """
        "q" \{
    """;
    let block = """
        two
        lines
    """;
    // Fewest escapes wins over everything: a value every single-line form must
    // escape becomes a `"""` block, which escapes nothing — JSON, a path, a
    // regex — and a raw template whose segments need no escape becomes the
    // single-backtick template, while one that would need them — or whose
    // backslash would land against the interpolation's brace — stays as it is.
    let json = "{\"pi\": 3.14, \"n\": [1, true]}";
    let path = "C:\\dir\\new";
    let greet = ```hello {plain}```;
    let win = `C:\\{plain}`;
    // Literal patterns are respelled exactly like expression literals.
    match (quoted) {
        "\"" => print(`"`),
        _ => print("_"),
    };
}
--- formatted ---
import { print } from builtins;

fn main() !prints {
    // A `"` literal whose only escapes are quotes is respelled with backticks,
    // where a quote is bare; a backtick literal whose only escapes are braces
    // or backticks is respelled with quotes, where those are bare.
    let quoted = `say "hi"`;
    let braced = "a {b} c";
    let ticked = "`code`";

    // The cheaper side wins when both kinds are present; a tie keeps the
    // delimiter the source has.
    let mostly_quotes = `""\{`;
    let tie = "\"{";
    let other_tie = `\{"`;
    // Nothing to escape either way: unchanged, whichever delimiter it has.
    let plain = "plain";
    let plain_tick = `plain`;
    // Shared escapes (`\n`, `\\`) ride along; an escaped backslash is one char.
    let shared = `a\n"b"\\`;

    // An interpolated template is not touched. A block whose value is one
    // line is respelled as a single-line literal, escapes and all — under
    // whichever delimiter needs fewer — while one spanning lines stays.
    let tpl = `x {1} "y"`;
    let raw = `"q" \\\{`;
    let block = """
        two
        lines
    """;

    // Fewest escapes wins over everything: a value every single-line form must
    // escape becomes a `"""` block, which escapes nothing — JSON, a path, a
    // regex — and a raw template whose segments need no escape becomes the
    // single-backtick template, while one that would need them — or whose
    // backslash would land against the interpolation's brace — stays as it is.
    let json = """{"pi": 3.14, "n": [1, true]}""";
    let path = """C:\dir\new""";
    let greet = `hello {plain}`;
    let win = `C:\\{plain}`;
    // Literal patterns are respelled exactly like expression literals.
    match (quoted) {
        `"` => print(`"`),
        _ => print("_"),
    };
}
