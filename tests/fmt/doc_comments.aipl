# Adds `a` and `b`.
#
# A bare `#` is a blank line, which is what gives a doc block paragraphs.
#     an indented line keeps its indent
pub    fn add(a: i64, b: i64) -> i64 { a + b }
// An ordinary `//` note sits above the docs, where `lead` drains it.
# The origin.
struct   Point { x: i64, y: i64 }
# Either something or nothing.
variant Maybe   = Yes | No
# Documented and tested.
fn tested( x : i64 ) -> i64 { x }.test({ assert(tested(1) == 1); })
fn banners() -> i64 {
    ////////////
