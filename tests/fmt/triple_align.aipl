import { print } from builtins;
fn main() !prints {
    // A `"""` raw string: the closing triple aligns with the opening (both at
    // the statement indent), and the content is shifted one level deeper,
    // keeping each line's indentation relative to the common base.
    print(
        """
        four spaces
      two spaces
    """,
    );
    // A triple-backtick template formats the same way — content one level
    // deeper — with interpolations carried along on their lines.
    let name = "world";
    print(
        ```
        indented {name}
      two spaces
    ```,
    );
}
// A mid-line opening (`let s = """`): the block aligns to the *opening line's*
// indentation, not to its own column, so the closing triple lands under the
// `let` and the content one level deeper.
fn bound() -> str {
    let s = """
      Line one.
    Line two.
""";
    s
}
--- formatted ---
import { print } from builtins;

fn main() !prints {
    // A `"""` raw string: the closing triple aligns with the opening (both at
    // the statement indent), and the content is shifted one level deeper,
    // keeping each line's indentation relative to the common base.
    print(
        """
              four spaces
            two spaces
        """,
    );

    // A triple-backtick template formats the same way — content one level
    // deeper — with interpolations carried along on their lines.
    let name = "world";
    print(
        ```
              indented {name}
            two spaces
        ```,
    );
}

// A mid-line opening (`let s = """`): the block aligns to the *opening line's*
// indentation, not to its own column, so the closing triple lands under the
// `let` and the content one level deeper.
fn bound() -> str {
    let s = """
          Line one.
        Line two.
    """;
    s
}
